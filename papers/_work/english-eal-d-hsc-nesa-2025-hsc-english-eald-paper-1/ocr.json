[[{"text": "GOVERNMENT", "x0": 0.12197802197802197, "y0": 0.1592851592851593, "x1": 0.22527472527472528, "y1": 0.16705516705516704}, {"text": "NSW Education Standards Authority", "x0": 0.11978021978021978, "y0": 0.19114219114219114, "x1": 0.4725274725274725, "y1": 0.20512820512820512}, {"text": "2025 | HIGHER SCHOOL CERTIFICATE EXAMINATION", "x0": 0.12747252747252746, "y0": 0.30691530691530694, "x1": 0.5868131868131868, "y1": 0.331002331002331}, {"text": "English as an Additional", "x0": 0.12307692307692308, "y0": 0.351981351981352, "x1": 0.6934065934065934, "y1": 0.38694638694638694}, {"text": "Language or Dialect (EAL/D)", "x0": 0.12307692307692308, "y0": 0.3962703962703963, "x1": 0.8054945054945055, "y1": 0.432012432012432}, {"text": "Paper 1", "x0": 0.12197802197802197, "y0": 0.4662004662004662, "x1": 0.24285714285714285, "y1": 0.49106449106449107}, {"text": "General + Reading time - 10 minutes", "x0": 0.11978021978021978, "y0": 0.5353535353535354, "x1": 0.5241758241758242, "y1": 0.5547785547785548}, {"text": "Instructions Working time 1 hour and 30 minutes", "x0": 0.11978021978021978, "y0": 0.5563325563325563, "x1": 0.6285714285714286, "y1": 0.5726495726495726}, {"text": "+ Write using black pen", "x0": 0.2681318681318681, "y0": 0.5804195804195804, "x1": 0.47802197802197804, "y1": 0.5936285936285937}, {"text": "Total marks: Section | - 30 marks (pages 3-9)", "x0": 0.11868131868131868, "y0": 0.6348096348096348, "x1": 0.5714285714285714, "y1": 0.6480186480186481}, {"text": "45 This section has two parts, Part A and Part B", "x0": 0.11868131868131868, "y0": 0.6526806526806527, "x1": 0.6747252747252748, "y1": 0.6721056721056721}, {"text": "Part A- 15 marks", "x0": 0.2681318681318681, "y0": 0.6798756798756799, "x1": 0.42857142857142855, "y1": 0.6899766899766899}, {"text": "+ Attempt Questions 1-4", "x0": 0.2681318681318681, "y0": 0.7016317016317016, "x1": 0.4901098901098901, "y1": 0.7148407148407149}, {"text": "+ Allow about 30 minutes for this part", "x0": 0.2681318681318681, "y0": 0.7226107226107226, "x1": 0.6054945054945055, "y1": 0.7358197358197358}, {"text": "Part B - 15 marks", "x0": 0.2681318681318681, "y0": 0.7435897435897436, "x1": 0.42857142857142855, "y1": 0.7536907536907537}, {"text": "+ Attempt Question 5", "x0": 0.2681318681318681, "y0": 0.7645687645687645, "x1": 0.4582417582417582, "y1": 0.7777777777777778}, {"text": "+ Allow about 30 minutes for this part", "x0": 0.2681318681318681, "y0": 0.7863247863247863, "x1": 0.6054945054945055, "y1": 0.7995337995337995}, {"text": "Section II - 15 marks (page 10)", "x0": 0.26703296703296703, "y0": 0.818958818958819, "x1": 0.5571428571428572, "y1": 0.8321678321678322}, {"text": "+ Attempt Question 6", "x0": 0.2681318681318681, "y0": 0.8438228438228438, "x1": 0.4593406593406593, "y1": 0.857031857031857}, {"text": "+ Allow about 30 minutes for this section", "x0": 0.2681318681318681, "y0": 0.8648018648018648, "x1": 0.6351648351648351, "y1": 0.8749028749028749}, {"text": "2070", "x0": 0.08131868131868132, "y0": 0.9463869463869464, "x1": 0.11758241758241758, "y1": 0.9549339549339549}], [{"text": "BLANK PAGE", "x0": 0.43626373626373627, "y0": 0.3550893550893551, "x1": 0.5626373626373626, "y1": 0.3644133644133644}], [{"text": "Section I \u2014 Module A: Texts and Human Experiences", "x0": 0.11978021978021978, "y0": 0.08158508158508158, "x1": 0.667032967032967, "y1": 0.09712509712509712}, {"text": "30 marks", "x0": 0.11868131868131868, "y0": 0.10023310023310024, "x1": 0.1989010989010989, "y1": 0.11033411033411034}, {"text": "Part A - 15 marks", "x0": 0.11978021978021978, "y0": 0.13364413364413363, "x1": 0.27802197802197803, "y1": 0.14296814296814297}, {"text": "Attempt Questions 1-4", "x0": 0.11978021978021978, "y0": 0.14996114996114995, "x1": 0.31648351648351647, "y1": 0.16317016317016317}, {"text": "Allow about 30 minutes for this part", "x0": 0.11978021978021978, "y0": 0.16627816627816627, "x1": 0.4340659340659341, "y1": 0.1794871794871795}, {"text": "Examine Texts 1, 2,3, 4 and 5 carefully and then answer the questions in the Paper | Answer", "x0": 0.11978021978021978, "y0": 0.19968919968919968, "x1": 0.8802197802197802, "y1": 0.2128982128982129}, {"text": "Booklet.", "x0": 0.11978021978021978, "y0": 0.21678321678321677, "x1": 0.18681318681318682, "y1": 0.22688422688422688}, {"text": "Your answers will be assessed on how well you:", "x0": 0.14395604395604394, "y0": 0.2463092463092463, "x1": 0.5351648351648352, "y1": 0.2595182595182595}, {"text": "demonstrate understanding of human experiences in texts", "x0": 0.16703296703296702, "y0": 0.2665112665112665, "x1": 0.6318681318681318, "y1": 0.27972027972027974}, {"text": "\u00a9 demonstrate understanding of the ways language shapes and expresses perceptions", "x0": 0.14285714285714285, "y0": 0.2867132867132867, "x1": 0.8362637362637363, "y1": 0.2999222999222999}, {"text": "Text 1 \u2014 Prose fiction", "x0": 0.11868131868131868, "y0": 0.3341103341103341, "x1": 0.3120879120879121, "y1": 0.3442113442113442}, {"text": "eventually you start to see changes.", "x0": 0.3142857142857143, "y0": 0.3838383838383838, "x1": 0.6010989010989011, "y1": 0.39704739704739705}, {"text": "your mind becomes light, the trees look", "x0": 0.3142857142857143, "y0": 0.40015540015540013, "x1": 0.6362637362637362, "y1": 0.4133644133644134}, {"text": "bright, the air you breathe begins to feel", "x0": 0.3142857142857143, "y0": 0.4172494172494173, "x1": 0.6384615384615384, "y1": 0.43045843045843046}, {"text": "like food for new opportunity, and life", "x0": 0.3153846153846154, "y0": 0.43356643356643354, "x1": 0.6252747252747253, "y1": 0.4467754467754468}, {"text": "takes on a crisp color pattern. ups and", "x0": 0.3153846153846154, "y0": 0.44755244755244755, "x1": 0.6208791208791209, "y1": 0.466977466977467}, {"text": "downs will continue to come and there is", "x0": 0.3142857142857143, "y0": 0.466977466977467, "x1": 0.6472527472527473, "y1": 0.47707847707847706}, {"text": "still much to learn, but you are calm now", "x0": 0.3153846153846154, "y0": 0.48484848484848486, "x1": 0.6461538461538462, "y1": 0.4972804972804973}, {"text": "and do not fear the old storms, which seem", "x0": 0.3142857142857143, "y0": 0.5003885003885004, "x1": 0.6637362637362637, "y1": 0.5120435120435121}, {"text": "to pass more quickly. a new awareness arises", "x0": 0.3153846153846154, "y0": 0.5174825174825175, "x1": 0.6802197802197802, "y1": 0.5306915306915307}, {"text": "to gently remind you that your power is", "x0": 0.3153846153846154, "y0": 0.5337995337995338, "x1": 0.6362637362637362, "y1": 0.5470085470085471}, {"text": "yours to wield!!! and is ready to propel you", "x0": 0.3142857142857143, "y0": 0.5477855477855478, "x1": 0.6648351648351648, "y1": 0.5633255633255633}, {"text": "forward into peace and insight.", "x0": 0.3153846153846154, "y0": 0.5672105672105672, "x1": 0.6659340659340659, "y1": 0.5804195804195804}, {"text": "YUNG PUEBLO", "x0": 0.5714285714285714, "y0": 0.6013986013986014, "x1": 0.6846153846153846, "y1": 0.6107226107226107}, {"text": "clarity & connection", "x0": 0.5175824175824176, "y0": 0.6177156177156177, "x1": 0.6846153846153846, "y1": 0.6301476301476302}, {"text": "(\u00a9 Mr Diego Perez Lacera", "x0": 0.5340659340659341, "y0": 0.6379176379176379, "x1": 0.6857142857142857, "y1": 0.6472416472416472}, {"text": "Reprinted by permission", "x0": 0.5417582417582417, "y0": 0.6495726495726496, "x1": 0.6846153846153846, "y1": 0.6588966588966589}, {"text": "(1 wield control", "x0": 0.3142857142857143, "y0": 0.6705516705516705, "x1": 0.5054945054945055, "y1": 0.6806526806526807}, {"text": "(21 fiberating freeing", "x0": 0.3142857142857143, "y0": 0.6876456876456877, "x1": 0.5032967032967033, "y1": 0.7000777000777001}], [{"text": "Text 2 \u2014 Poem", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.25164835164835164, "y1": 0.09168609168609168}, {"text": "They'd been calling for days,", "x0": 0.3230769230769231, "y0": 0.13131313131313133, "x1": 0.5626373626373626, "y1": 0.1445221445221445}, {"text": "it was inevitable.", "x0": 0.3241758241758242, "y0": 0.14840714840714841, "x1": 0.46153846153846156, "y1": 0.1585081585081585}, {"text": "Out of the window I flew,", "x0": 0.3241758241758242, "y0": 0.16161616161616163, "x1": 0.5351648351648352, "y1": 0.18181818181818182}, {"text": "swapping skin for feathers.", "x0": 0.3241758241758242, "y0": 0.18104118104118105, "x1": 0.5428571428571428, "y1": 0.19425019425019424}, {"text": "Smaller and smaller", "x0": 0.3241758241758242, "y0": 0.1989121989121989, "x1": 0.4857142857142857, "y1": 0.20823620823620823}, {"text": "until I was light as air", "x0": 0.3241758241758242, "y0": 0.21445221445221446, "x1": 0.5010989010989011, "y1": 0.22766122766122765}, {"text": "and the flock claimed me.", "x0": 0.3241758241758242, "y0": 0.23154623154623155, "x1": 0.5340659340659341, "y1": 0.24164724164724163}, {"text": "I forgot everything I knew;", "x0": 0.3241758241758242, "y0": 0.24786324786324787, "x1": 0.5428571428571428, "y1": 0.26107226107226106}, {"text": "my children, the morning", "x0": 0.3241758241758242, "y0": 0.26495726495726496, "x1": 0.5285714285714286, "y1": 0.27816627816627815}, {"text": "commute, all the worries", "x0": 0.3241758241758242, "y0": 0.28205128205128205, "x1": 0.5241758241758242, "y1": 0.29215229215229216}, {"text": "that clipped my wings", "x0": 0.3241758241758242, "y0": 0.29836829836829837, "x1": 0.5021978021978022, "y1": 0.31157731157731156}, {"text": "and weighed me down.", "x0": 0.3241758241758242, "y0": 0.3146853146853147, "x1": 0.510989010989011, "y1": 0.3278943278943279}, {"text": "I can\u2019t begin to describe it \u2014", "x0": 0.3241758241758242, "y0": 0.3317793317793318, "x1": 0.5516483516483517, "y1": 0.34498834498834496}, {"text": "I was ash, I was ink, I was smoke.", "x0": 0.3241758241758242, "y0": 0.34887334887334887, "x1": 0.6010989010989011, "y1": 0.35975135975135974}, {"text": "It was like we'd stolen the sky,", "x0": 0.3241758241758242, "y0": 0.3644133644133644, "x1": 0.5769230769230769, "y1": 0.3776223776223776}, {"text": "and the sky kept trying to steal itself back.", "x0": 0.3241758241758242, "y0": 0.3815073815073815, "x1": 0.6681318681318681, "y1": 0.3947163947163947}, {"text": "CorINNA BOARD", "x0": 0.5417582417582417, "y0": 0.4156954156954157, "x1": 0.6747252747252748, "y1": 0.425019425019425}, {"text": "Of a feather", "x0": 0.578021978021978, "y0": 0.43123543123543123, "x1": 0.6758241758241759, "y1": 0.4444444444444444}, {"text": "With kind permission of Corinna Board", "x0": 0.44505494505494503, "y0": 0.45454545454545453, "x1": 0.6736263736263737, "y1": 0.46386946386946387}], [{"text": "Text 3 \u2014 Fiction extract", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.33076923076923076, "y1": 0.09168609168609168}, {"text": "As Margaret sat up and placed her feet upon the dirt floor, a family of", "x0": 0.2010989010989011, "y0": 0.12742812742812742, "x1": 0.8197802197802198, "y1": 0.14063714063714064}, {"text": "sulphur-crested cockatoos dived into the enormous red gum at the front of her", "x0": 0.1813186813186813, "y0": 0.1445221445221445, "x1": 0.8186813186813187, "y1": 0.15773115773115773}, {"text": "camp. She slipped her arms into her nightgown as the birds screeched, her", "x0": 0.1813186813186813, "y0": 0.16083916083916083, "x1": 0.8186813186813187, "y1": 0.17404817404817405}, {"text": "nightgown\u2019s hem floating like her own tail behind her as she walked out of her", "x0": 0.1813186813186813, "y0": 0.17793317793317792, "x1": 0.8186813186813187, "y1": 0.19114219114219114}, {"text": "room, pulled aside the heavy canvas that hung as her front door, and stepped", "x0": 0.1813186813186813, "y0": 0.19425019425019424, "x1": 0.8175824175824176, "y1": 0.20745920745920746}, {"text": "outside. Lifting the lid of the browning water drum and placing it silently down,", "x0": 0.1813186813186813, "y0": 0.21134421134421136, "x1": 0.8186813186813187, "y1": 0.22455322455322455}, {"text": "she cupped her hands then submerged them, allowing the water\u2019s icy pulse to", "x0": 0.1813186813186813, "y0": 0.22766122766122765, "x1": 0.8175824175824176, "y1": 0.24087024087024086}, {"text": "stream into her veins. To take her mind from the stinging cold, she began to", "x0": 0.1813186813186813, "y0": 0.24397824397824397, "x1": 0.8175824175824176, "y1": 0.2571872571872572}, {"text": "hum, careful to restrict the descending line so that only a series of squeaks and", "x0": 0.1813186813186813, "y0": 0.26107226107226106, "x1": 0.8175824175824176, "y1": 0.2742812742812743}, {"text": "gushes of air emitted from her body. While her hands floated, she swam in the", "x0": 0.1813186813186813, "y0": 0.2773892773892774, "x1": 0.8175824175824176, "y1": 0.2905982905982906}, {"text": "song. Margaret lifted her face towards the sky, its rising warmth pushing her", "x0": 0.1813186813186813, "y0": 0.29448329448329447, "x1": 0.8186813186813187, "y1": 0.3076923076923077}, {"text": "chin upwards, closing her eyes. Heat crept into the lines on her face; she felt it", "x0": 0.1813186813186813, "y0": 0.3108003108003108, "x1": 0.8175824175824176, "y1": 0.32400932400932403}, {"text": "drip into her brow and trickle towards her lips from the pathways at her temples", "x0": 0.1813186813186813, "y0": 0.3278943278943279, "x1": 0.8175824175824176, "y1": 0.3411033411033411}, {"text": "and her cheeks. With her hands in the water and her face to the sun, Margaret", "x0": 0.1813186813186813, "y0": 0.3442113442113442, "x1": 0.8175824175824176, "y1": 0.35742035742035744}, {"text": "Lightning continued her song. She hummed as she rubbed water into her face", "x0": 0.1813186813186813, "y0": 0.3613053613053613, "x1": 0.8175824175824176, "y1": 0.3745143745143745}, {"text": "and ran her wet hands through her hair, as she then twisted and pulled it into", "x0": 0.1813186813186813, "y0": 0.3776223776223776, "x1": 0.8175824175824176, "y1": 0.39083139083139085}, {"text": "her regular low bun. She even hummed as she prodded!'! at the wiry strands", "x0": 0.1813186813186813, "y0": 0.3916083916083916, "x1": 0.8175824175824176, "y1": 0.40792540792540793}, {"text": "of grey that had begun to spark at her forehead. The tune rolled on as she", "x0": 0.1813186813186813, "y0": 0.411033411033411, "x1": 0.8175824175824176, "y1": 0.42424242424242425}, {"text": "walked back inside ... Only when she took up her purse \u2014 a refashioned canvas", "x0": 0.1813186813186813, "y0": 0.42735042735042733, "x1": 0.8175824175824176, "y1": 0.4405594405594406}, {"text": "water bag \u2014 from the kitchen table and left her home did she bring the sound", "x0": 0.1813186813186813, "y0": 0.4444444444444444, "x1": 0.8175824175824176, "y1": 0.45765345765345766}, {"text": "forwards, daring to push it into the air in front of her. Her breath and words", "x0": 0.1813186813186813, "y0": 0.46076146076146074, "x1": 0.8175824175824176, "y1": 0.473970473970474}, {"text": "soon transformed timid tune into robust!?! phrase, footsteps keeping", "x0": 0.1813186813186813, "y0": 0.47474747474747475, "x1": 0.8175824175824176, "y1": 0.49106449106449107}, {"text": "time as she walked the first of the four miles into town along the edge.", "x0": 0.1813186813186813, "y0": 0.49417249417249415, "x1": 0.8131868131868132, "y1": 0.5073815073815073}, {"text": "NARDI SIMPSON", "x0": 0.6934065934065934, "y0": 0.5283605283605284, "x1": 0.8175824175824176, "y1": 0.5376845376845377}, {"text": "Song of the Crocodile", "x0": 0.6406593406593407, "y0": 0.5454545454545454, "x1": 0.8175824175824176, "y1": 0.5578865578865578}, {"text": "With kind permission of Nara Simpson", "x0": 0.5879120879120879, "y0": 0.5672105672105672, "x1": 0.8175824175824176, "y1": 0.5765345765345765}, {"text": "(prodded poked", "x0": 0.1813186813186813, "y0": 0.5982905982905983, "x1": 0.3395604395604396, "y1": 0.60994560994561}, {"text": "PI robust strong and healthy", "x0": 0.1813186813186813, "y0": 0.6153846153846154, "x1": 0.42637362637362636, "y1": 0.627039627039627}], [{"text": "Text 4 \u2014 Visual text", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.2978021978021978, "y1": 0.09168609168609168}, {"text": "EVERYONE IS BUSY IN THE GARDEN", "x0": 0.6791208791208792, "y0": 0.40559440559440557, "x1": 0.8626373626373627, "y1": 0.42735042735042733}, {"text": "DIGGING, PLANTING, SOWING", "x0": 0.6780219780219781, "y0": 0.4257964257964258, "x1": 0.8340659340659341, "y1": 0.43356643356643354}, {"text": "FELICITA SALA", "x0": 0.7626373626373626, "y0": 0.5011655011655012, "x1": 0.8791208791208791, "y1": 0.5112665112665112}, {"text": "A year in Fleurville", "x0": 0.7197802197802198, "y0": 0.5182595182595182, "x1": 0.8791208791208791, "y1": 0.5314685314685315}, {"text": "With kind permission of Felicita Sala", "x0": 0.6626373626373626, "y0": 0.5392385392385393, "x1": 0.878021978021978, "y1": 0.5477855477855478}], [{"text": "Text 5 \u2014 Nonfiction extract", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.36153846153846153, "y1": 0.09246309246309246}], [{"text": "Section I \u2014 Module A (continued)", "x0": 0.11978021978021978, "y0": 0.08158508158508158, "x1": 0.45274725274725275, "y1": 0.09557109557109557}, {"text": "Part B - 15 marks", "x0": 0.11978021978021978, "y0": 0.11655011655011654, "x1": 0.27692307692307694, "y1": 0.12665112665112666}, {"text": "Attempt Question 5", "x0": 0.11978021978021978, "y0": 0.13286713286713286, "x1": 0.2879120879120879, "y1": 0.14607614607614608}, {"text": "Allow about 30 minutes for this part", "x0": 0.11978021978021978, "y0": 0.14996114996114995, "x1": 0.4340659340659341, "y1": 0.16317016317016317}, {"text": "Answer the question on pages 6-12 of the Paper 1 Answer Booklet. Extra writing booklets are", "x0": 0.11978021978021978, "y0": 0.18337218337218336, "x1": 0.8791208791208791, "y1": 0.19658119658119658}, {"text": "available.", "x0": 0.11978021978021978, "y0": 0.20046620046620048, "x1": 0.1956043956043956, "y1": 0.2097902097902098}, {"text": "Your answer will be assessed on how well 