[[{"text": "Killara", "x0": 0.26593406593406593, "y0": 0.08547008547008547, "x1": 0.48131868131868133, "y1": 0.1258741258741259}, {"text": "HIGH SCHOOL", "x0": 0.2692307692307692, "y0": 0.13442113442113443, "x1": 0.48131868131868133, "y1": 0.14996114996114995}, {"text": "TRIAL HSC EXAMINATION 2021", "x0": 0.12087912087912088, "y0": 0.3045843045843046, "x1": 0.421978021978022, "y1": 0.31546231546231546}, {"text": "English Standard", "x0": 0.12637362637362637, "y0": 0.3418803418803419, "x1": 0.5703296703296703, "y1": 0.38306138306138304}, {"text": "Paper 2 \u2014 Modules", "x0": 0.12417582417582418, "y0": 0.4048174048174048, "x1": 0.43846153846153846, "y1": 0.43045843045843046}, {"text": "General Reading time \u2014 5 minutes", "x0": 0.13076923076923078, "y0": 0.4654234654234654, "x1": 0.49340659340659343, "y1": 0.48951048951048953}, {"text": "Working time \u2014 2 hours", "x0": 0.3032967032967033, "y0": 0.49184149184149184, "x1": 0.47802197802197804, "y1": 0.5027195027195027}, {"text": "Instructions", "x0": 0.13076923076923078, "y0": 0.49184149184149184, "x1": 0.21978021978021978, "y1": 0.5003885003885004}, {"text": "Write using black pen", "x0": 0.3032967032967033, "y0": 0.5097125097125097, "x1": 0.46373626373626375, "y1": 0.5213675213675214}, {"text": "Write your student number in all writing booklets used", "x0": 0.3032967032967033, "y0": 0.5275835275835276, "x1": 0.7131868131868132, "y1": 0.5392385392385393}, {"text": "Total Marks: Section |- 20 marks", "x0": 0.12967032967032968, "y0": 0.5928515928515928, "x1": 0.41318681318681316, "y1": 0.6021756021756022}, {"text": "60 \u00a9 Attempt Question 1", "x0": 0.13076923076923078, "y0": 0.6114996114996115, "x1": 0.45054945054945056, "y1": 0.6223776223776224}, {"text": "\u00a9 Allow about 40 minutes for this section", "x0": 0.27362637362637365, "y0": 0.6293706293706294, "x1": 0.5956043956043956, "y1": 0.6386946386946387}, {"text": "Section Il - 20 marks", "x0": 0.26043956043956046, "y0": 0.6658896658896659, "x1": 0.4175824175824176, "y1": 0.6752136752136753}, {"text": "\u00a9 Attempt Question 2", "x0": 0.27362637362637365, "y0": 0.6853146853146853, "x1": 0.45054945054945056, "y1": 0.6961926961926962}, {"text": "\u00a9 Allow about 40 minutes for this section", "x0": 0.27362637362637365, "y0": 0.7024087024087025, "x1": 0.5956043956043956, "y1": 0.7117327117327117}, {"text": "Section Ill - 20 marks", "x0": 0.26043956043956046, "y0": 0.7397047397047397, "x1": 0.4230769230769231, "y1": 0.749028749028749}, {"text": "\u00a9 Attempt Question 3", "x0": 0.27362637362637365, "y0": 0.7583527583527584, "x1": 0.45054945054945056, "y1": 0.7692307692307693}, {"text": "\u00a9 Allow about 40 minutes for this section", "x0": 0.27362637362637365, "y0": 0.7762237762237763, "x1": 0.5956043956043956, "y1": 0.7855477855477856}], [{"text": "Section I \u2014 Module A: Language, Identity and Culture", "x0": 0.06153846153846154, "y0": 0.06293706293706294, "x1": 0.7120879120879121, "y1": 0.08003108003108003}, {"text": "20 marks", "x0": 0.06153846153846154, "y0": 0.11033411033411034, "x1": 0.14725274725274726, "y1": 0.12043512043512043}, {"text": "Attempt Question 1", "x0": 0.06043956043956044, "y0": 0.12665112665112666, "x1": 0.23956043956043957, "y1": 0.13986013986013987}, {"text": "Allow about 40 minutes for this section", "x0": 0.06043956043956044, "y0": 0.14296814296814297, "x1": 0.421978021978022, "y1": 0.15306915306915306}, {"text": "Answer the question in the writing booklets provided. Extra writing booklets are available.", "x0": 0.06043956043956044, "y0": 0.17715617715617715, "x1": 0.8373626373626374, "y1": 0.19036519036519037}, {"text": "Your answer will be assessed on how well you:", "x0": 0.07032967032967033, "y0": 0.216006216006216, "x1": 0.46923076923076923, "y1": 0.22921522921522922}, {"text": "\u00a9 demonstrate understanding of how ideas about language, identity and culture are expressed", "x0": 0.1010989010989011, "y0": 0.2331002331002331, "x1": 0.9208791208791208, "y1": 0.2463092463092463}, {"text": "through texts", "x0": 0.13076923076923078, "y0": 0.2494172494172494, "x1": 0.24395604395604395, "y1": 0.26262626262626265}, {"text": "\u00a9 demonstrate understanding of how language is used to shape meaning about individuals", "x0": 0.1010989010989011, "y0": 0.2665112665112665, "x1": 0.889010989010989, "y1": 0.27972027972027974}, {"text": "and/or cultural groups", "x0": 0.13076923076923078, "y0": 0.2828282828282828, "x1": 0.3263736263736264, "y1": 0.29603729603729606}, {"text": "\u00a9 organise, develop and express ideas using language appropriate to audience, purpose and", "x0": 0.1010989010989011, "y0": 0.2999222999222999, "x1": 0.8978021978021978, "y1": 0.31313131313131315}, {"text": "form", "x0": 0.13076923076923078, "y0": 0.3162393162393162, "x1": 0.17032967032967034, "y1": 0.32634032634032634}, {"text": "Question 1 (20 marks)", "x0": 0.06153846153846154, "y0": 0.3745143745143745, "x1": 0.2681318681318681, "y1": 0.3877233877233877}, {"text": "\u201cLanguage brings with it an identity and a culture,", "x0": 0.256043956043956, "y0": 0.4219114219114219, "x1": 0.743956043956044, "y1": 0.44366744366744365}, {"text": "or at least the perception of it\u201d - Trevor Noah", "x0": 0.27692307692307694, "y0": 0.4444444444444444, "x1": 0.7230769230769231, "y1": 0.4662004662004662}, {"text": "Discuss how this statement aligns with your understanding of the relationships between language,", "x0": 0.06153846153846154, "y0": 0.4887334887334887, "x1": 0.9032967032967033, "y1": 0.5019425019425019}, {"text": "culture and identity. Make close reference to at least TWO of the poems set for study.", "x0": 0.06153846153846154, "y0": 0.4988344988344988, "x1": 0.7857142857142857, "y1": 0.5252525252525253}, {"text": "The prescribed poems are:", "x0": 0.06043956043956044, "y0": 0.5439005439005439, "x1": 0.2879120879120879, "y1": 0.5571095571095571}, {"text": "\u2014 Adam Aitken, Kim Cheng Boey and Michelle Cahill (eds), Contemporary Asian Australian Poets", "x0": 0.0912087912087912, "y0": 0.5703185703185704, "x1": 0.9208791208791208, "y1": 0.5951825951825952}, {"text": "* Merlinda Bobis, This is where it begins", "x0": 0.12197802197802197, "y0": 0.5936285936285937, "x1": 0.4582417582417582, "y1": 0.6068376068376068}, {"text": "* Miriam Wei Wei Lo, Home", "x0": 0.12197802197802197, "y0": 0.6107226107226107, "x1": 0.35714285714285715, "y1": 0.6223776223776224}, {"text": "* Ouyang Yu, New Accents", "x0": 0.12197802197802197, "y0": 0.627039627039627, "x1": 0.34065934065934067, "y1": 0.6402486402486403}, {"text": "* Vuong Pham, Mother", "x0": 0.12197802197802197, "y0": 0.6441336441336442, "x1": 0.3131868131868132, "y1": 0.6573426573426573}, {"text": "* Jaya Savige, Circular Breathing", "x0": 0.12197802197802197, "y0": 0.6604506604506605, "x1": 0.3945054945054945, "y1": 0.6736596736596736}, {"text": "* Maureen Ten (Ten Ch'in U), Translucent Jade", "x0": 0.12197802197802197, "y0": 0.675990675990676, "x1": 0.5164835164835165, "y1": 0.6907536907536908}], [{"text": "Section II \u2014 Module B: Close Study of Literature", "x0": 0.06153846153846154, "y0": 0.03885003885003885, "x1": 0.6461538461538462, "y1": 0.055944055944055944}, {"text": "20 marks", "x0": 0.06153846153846154, "y0": 0.08624708624708624, "x1": 0.14725274725274726, "y1": 0.09634809634809635}, {"text": "Attempt Question 2", "x0": 0.06043956043956044, "y0": 0.10256410256410256, "x1": 0.23846153846153847, "y1": 0.11577311577311578}, {"text": "Allow about 40 minutes for this section", "x0": 0.06043956043956044, "y0": 0.11965811965811966, "x1": 0.421978021978022, "y1": 0.12975912975912976}, {"text": "Answer the question in the writing booklets provided. Extra writing booklets are available.", "x0": 0.06043956043956044, "y0": 0.15306915306915306, "x1": 0.8373626373626374, "y1": 0.16627816627816627}, {"text": "Your answer will be assessed on how well you:", "x0": 0.07032967032967033, "y0": 0.18414918414918416, "x1": 0.46923076923076923, "y1": 0.21056721056721056}, {"text": "\u00a9 demonstrate understanding of a text\u2019s distinctive qualities and how these shape meaning", "x0": 0.1010989010989011, "y0": 0.20046620046620048, "x1": 0.8934065934065935, "y1": 0.22688422688422688}, {"text": "\u00a9 organise, develop and express ideas using language appropriate to audience, purpose and", "x0": 0.1010989010989011, "y0": 0.22533022533022534, "x1": 0.8978021978021978, "y1": 0.23853923853923853}, {"text": "form", "x0": 0.13076923076923078, "y0": 0.24242424242424243, "x1": 0.17032967032967034, "y1": 0.25252525252525254}, {"text": "Question 2 (20 marks)", "x0": 0.06153846153846154, "y0": 0.2999222999222999, "x1": 0.2681318681318681, "y1": 0.31313131313131315}, {"text": "How does Mark Haddon use characterisation to evoke significant ideas about the process of learning", "x0": 0.06153846153846154, "y0": 0.3504273504273504, "x1": 0.9208791208791208, "y1": 0.36363636363636365}, {"text": "in a distinctive manner?", "x0": 0.06153846153846154, "y0": 0.3752913752913753, "x1": 0.26593406593406593, "y1": 0.3853923853923854}, {"text": "In your response, you must make detailed reference to Mark Haddon\u2019s novel, The Curious Incident of", "x0": 0.06153846153846154, "y0": 0.4172494172494173, "x1": 0.9230769230769231, "y1": 0.44366744366744365}, {"text": "the Dog In the Night-time.", "x0": 0.06153846153846154, "y0": 0.4506604506604507, "x1": 0.27692307692307694, "y1": 0.46386946386946387}], [{"text": "Section III \u2014 Module C: The Craft of Writing", "x0": 0.06153846153846154, "y0": 0.03885003885003885, "x1": 0.5956043956043956, "y1": 0.055944055944055944}, {"text": "20 marks", "x0": 0.06153846153846154, "y0": 0.08624708624708624, "x1": 0.14725274725274726, "y1": 0.09634809634809635}, {"text": "Attempt Question 3", "x0": 0.06043956043956044, "y0": 0.10256410256410256, "x1": 0.23846153846153847, "y1": 0.11577311577311578}, {"text": "Allow about 40 minutes for this section", "x0": 0.06043956043956044, "y0": 0.11965811965811966, "x1": 0.421978021978022, "y1": 0.12975912975912976}, {"text": "Answer the question in the writing booklets provided. Extra writing booklets are available.", "x0": 0.06043956043956044, "y0": 0.15306915306915306, "x1": 0.8373626373626374, "y1": 0.16627816627816627}, {"text": "Your answer will be assessed on how well you:", "x0": 0.07032967032967033, "y0": 0.18414918414918416, "x1": 0.46923076923076923, "y1": 0.21056721056721056}, {"text": "\u00a9 craft language to address the demands of the question", "x0": 0.1010989010989011, "y0": 0.20901320901320902, "x1": 0.5934065934065934, "y1": 0.2222222222222222}, {"text": "\u00a9 use language appropriate to audience, purpose and form to shape meaning", "x0": 0.1010989010989011, "y0": 0.22533022533022534, "x1": 0.7703296703296704, "y1": 0.23853923853923853}, {"text": "Question 3 (20 marks)", "x0": 0.06153846153846154, "y0": 0.2836052836052836, "x1": 0.2681318681318681, "y1": 0.29681429681429683}, {"text": "a) Crafta piece of imaginative, persuasive or discursive writing that uses contrast to 12", "x0": 0.1, "y0": 0.317016317016317, "x1": 0.9285714285714286, "y1": 0.33022533022533024}, {"text": "explore the relationship between the past and the future.", "x0": 0.13076923076923078, "y0": 0.3418803418803419, "x1": 0.6175824175824176, "y1": 0.3550893550893551}, {"text": "b) Reflect on how one key element of your reading or writing experiences in Module C 8", "x0": 0.1, "y0": 0.3923853923853924, "x1": 0.9296703296703297, "y1": 0.40559440559440557}, {"text": "has influenced your choices in representing ideas in this piece.", "x0": 0.13076923076923078, "y0": 0.4172494172494173, "x1": 0.6648351648351648, "y1": 0.43045843045843046}, {"text": "The prescribed texts are:", "x0": 0.06043956043956044, "y0": 0.4926184926184926, "x1": 0.2725274725274725, "y1": 0.5058275058275058}, {"text": "* Prose fiction  - Bradbury, Ray, \u2018The Pedestrian\u2019", "x0": 0.06153846153846154, "y0": 0.5268065268065268, "x1": 0.5263736263736264, "y1": 0.54001554001554}, {"text": "~ Carey, Peter, \u2018