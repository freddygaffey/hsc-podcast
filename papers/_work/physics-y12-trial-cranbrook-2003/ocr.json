[[{"text": "Part A ~ 15 marks", "x0": 0.5447470817120622, "y0": 0.035164835164835165, "x1": 0.6256809338521401, "y1": 0.06593406593406594}, {"text": "Attempt Questions 1 - 15", "x0": 0.5478599221789884, "y0": 0.05714285714285714, "x1": 0.6552529182879377, "y1": 0.08791208791208792}, {"text": "Allow about 30 minutes for this part", "x0": 0.5478599221789884, "y0": 0.08351648351648351, "x1": 0.7035019455252919, "y1": 0.0989010989010989}, {"text": "Use the multiple choice answer sheet.", "x0": 0.5478599221789884, "y0": 0.12307692307692308, "x1": 0.6988326848249027, "y1": 0.13736263736263737}, {"text": "\u2018Select the alternative A, B, C or D that best answers the question. Fill in the response space.", "x0": 0.5478599221789884, "y0": 0.13296703296703297, "x1": 0.9206225680933852, "y1": 0.16483516483516483}, {"text": "1. A projectile is fired from point A on a horizontal plane and takes the path ABC as shown.", "x0": 0.5486381322957199, "y0": 0.17032967032967034, "x1": 0.9424124513618677, "y1": 0.2032967032967033}, {"text": "CRANBROOK SCHOOL", "x0": 0.19688715953307392, "y0": 0.22747252747252747, "x1": 0.32684824902723736, "y1": 0.24175824175824176}, {"text": "YEAR 12 TRIAL HSC EXAMINATION", "x0": 0.15953307392996108, "y0": 0.2692307692307692, "x1": 0.3642023346303502, "y1": 0.2846153846153846}, {"text": "2 UNIT HSC COURSE 4", "x0": 0.20389105058365758, "y0": 0.3131868131868132, "x1": 0.7175097276264591, "y1": 0.32857142857142857}, {"text": "2003", "x0": 0.25058365758754864, "y0": 0.3362637362637363, "x1": 0.2739299610894942, "y1": 0.34835164835164834}, {"text": "Physics Which statement is true about point B?", "x0": 0.052140077821011675, "y0": 0.3813186813186813, "x1": 0.7385214007782102, "y1": 0.4153846153846154}, {"text": "(A) Both the velocity and the acceleration of the projectile are zero.", "x0": 0.5782101167315176, "y0": 0.42747252747252745, "x1": 0.8669260700389105, "y1": 0.45274725274725275}, {"text": "General Instructions \u2018Total marks - 100 (B) The velocity of the projectile is not zero, but the acceleration is zero.", "x0": 0.05291828793774319, "y0": 0.44175824175824174, "x1": 0.8894941634241245, "y1": 0.4747252747252747}, {"text": "5 (\u00a9) The velocity of the projectile is zero, but the acceleration is not zero.", "x0": 0.31984435797665367, "y0": 0.46263736263736266, "x1": 0.890272373540856, "y1": 0.4978021978021978}, {"text": "\u00a9 Working time - 3 hours Part A ~ 15 marks (D) the velocity nor the acceleration of the projectile is zero.", "x0": 0.053696498054474705, "y0": 0.48021978021978023, "x1": 0.8708171206225681, "y1": 0.5087912087912088}, {"text": "'*  Board-approved calculators may be used Attempt Questions 1 - 15", "x0": 0.053696498054474705, "y0": 0.5065934065934066, "x1": 0.3953307392996109, "y1": 0.5274725274725275}, {"text": "\u00a9 Write using blue or black pen Allow about 30 minutes for this part", "x0": 0.054474708171206226, "y0": 0.5263736263736264, "x1": 0.4412451361867704, "y1": 0.5472527472527473}, {"text": "\u2018\u00a9 Draw diagrams using pencil Anobject is travelling around a circular track at a constant speed of 15 m/s as shown below.", "x0": 0.054474708171206226, "y0": 0.5384615384615384, "x1": 0.9556420233463035, "y1": 0.5681318681318681}, {"text": "A Data Sheet and Formulae Sheets are Part B~ 85 marks", "x0": 0.054474708171206226, "y0": 0.5593406593406594, "x1": 0.35175097276264594, "y1": 0.5956043956043956}, {"text": "provided atthe back ofthis paper Questions 16-31", "x0": 0.06926070038910506, "y0": 0.5857142857142857, "x1": 0.3961089494163424, "y1": 0.6087912087912087}, {"text": "Write your Student Number at the top of the '* Allow about 2 hours and 30 minutes for this", "x0": 0.07081712062256809, "y0": 0.5978021978021978, "x1": 0.47315175097276263, "y1": 0.6318681318681318}, {"text": "pages indicated Pet direction of motion", "x0": 0.07003891050583658, "y0": 0.6241758241758242, "x1": 0.8575875486381322, "y1": 0.656043956043956}, {"text": "W\\eF tect", "x0": 0.7501945525291829, "y0": 0.6285714285714286, "x1": 0.8124513618677043, "y1": 0.6593406593406593}, {"text": "object", "x0": 0.7626459143968871, "y0": 0.6901098901098901, "x1": 0.7929961089494163, "y1": 0.7065934065934066}, {"text": "\u2018The content and format of this paper do not necessarily reflect the content and format of the HSC", "x0": 0.05525291828793774, "y0": 0.7362637362637363, "x1": 0.4754863813229572, "y1": 0.7670329670329671}, {"text": "examination paper", "x0": 0.05603112840466926, "y0": 0.7692307692307693, "x1": 0.13618677042801555, "y1": 0.7824175824175824}, {"text": "\u2018Which isthe best set of vectors for describing the velocity and acceleration at the position", "x0": 0.5782101167315176, "y0": 0.7967032967032966, "x1": 0.9478599221789883, "y1": 0.8131868131868132}, {"text": "shown? w | \u00a9 |", "x0": 0.5789883268482491, "y0": 0.8087912087912088, "x1": 0.824124513618677, "y1": 0.878021978021978}], [{"text": "\u20184", "x0": 0.7322957198443579, "y0": 0.04835164835164835, "x1": 0.7369649805447471, "y1": 0.05714285714285714}, {"text": "3", "x0": 0.23346303501945526, "y0": 0.04945054945054945, "x1": 0.23657587548638132, "y1": 0.05824175824175824}, {"text": "A ball dropped from rest, on Earth, impacts on the ground at 20 On another planet, where", "x0": 0.058365758754863814, "y0": 0.05934065934065934, "x1": 0.43735408560311284, "y1": 0.09230769230769231}, {"text": "\u2018A positively charged particle enters the uniform magnetic field shown below.", "x0": 0.5556420233463035, "y0": 0.06813186813186813, "x1": 0.8684824902723736, "y1": 0.08681318681318681}, {"text": "the acceleration due to gravity is four times that on Earth, the same ball is dropped from rest. If", "x0": 0.058365758754863814, "y0": 0.08791208791208792, "x1": 0.4412451361867704, "y1": 0.1043956043956044}, {"text": "this ball falls through the same distance, what would be its velocity just before impact?", "x0": 0.058365758754863814, "y0": 0.1076923076923077, "x1": 0.4085603112840467, "y1": 0.12417582417582418}, {"text": "FIELD", "x0": 0.7626459143968871, "y0": 0.14835164835164835, "x1": 0.7914396887159533, "y1": 0.16043956043956045}, {"text": "(A) Sms", "x0": 0.058365758754863814, "y0": 0.14945054945054945, "x1": 0.11050583657587548, "y1": 0.16263736263736264}, {"text": "ouT", "x0": 0.7673151750972763, "y0": 0.16373626373626374, "x1": 0.7875486381322957, "y1": 0.17472527472527472}, {"text": "@\u00ae) 10ms", "x0": 0.058365758754863814, "y0": 0.16923076923076924, "x1": 0.11595330739299611, "y1": 0.1824175824175824}, {"text": "OF", "x0": 0.7712062256809339, "y0": 0.18021978021978022, "x1": 0.7844357976653696, "y1": 0.1901098901098901}, {"text": "\u00a9 40ms", "x0": 0.058365758754863814, "y0": 0.1879120879120879, "x1": 0.11595330739299611, "y1": 0.2021978021978022}, {"text": "PAGE", "x0": 0.7649805447470817, "y0": 0.1945054945054945, "x1": 0.7914396887159533, "y1": 0.20549450549450549}, {"text": "\u00a9) 80ms", "x0": 0.058365758754863814, "y0": 0.2076923076923077, "x1": 0.11595330739299611, "y1": 0.22087912087912087}, {"text": "Which diagram below best indicates the path of the particle through the region of the field?", "x0": 0.553307392996109, "y0": 0.23516483516483516, "x1": 0.9276264591439689, "y1": 0.26593406593406593}, {"text": "\u2018What centripetal force is needed to allow a.550 kg satellite to orbit a a speed of 7780 mvs, while", "x0": 0.05603112840466926, "y0": 0.25384615384615383, "x1": 0.45136186770428016, "y1": 0.2857142857142857}, {"text": "4.", "x0": 0.028793774319066146, "y0": 0.26703296703296703, "x1": 0.0357976653696498, "y1": 0.27802197802197803}, {"text": "at a distance of 6.58 x 10\u00b0 m from the centre of the Earth?", "x0": 0.05914396887159533, "y0": 0.27692307692307694, "x1": 0.2926070038910506, "y1": 0.3054945054945055}, {"text": "(A)", "x0": 0.05914396887159533, "y0": 0.3252747252747253, "x1": 0.07315175097276265, "y1": 0.3384615384615385}, {"text": "\u00a9 065N", "x0": 0.05914396887159533, "y0": 0.3626373626373626, "x1": 0.11673151750972763, "y1": 0.3758241758241758}, {"text": "Consider a satelite in orbit around the Earth. Which statement is true?", "x0": 0.05914396887159533, "y0": 0.42967032967032964, "x1": 0.34396887159533074, "y1": 0.4604395604395604}, {"text": "(A) The greater the satellite's mass, the greater its speed for a given altitude,", "x0": 0.05992217898832685, "y0": 0.46703296703296704, "x1": 0.38132295719844356, "y1": 0.4989010989010989}, {"text": "(B) The greater the satellite's mass, the smaller its speed fora given altitude.", "x0": 0.05992217898832685, "y0": 0.4857142857142857, "x1": 0.38132295719844356, "y1": 0.5186813186813187}, {"text": "(\u00a9) The greater a satellite's mass, the greater the centripetal force on it ata given altitude,", "x0": 0.05992217898832685, "y0": 0.5054945054945055, "x1": 0.4357976653696498, "y1": 0.5373626373626373}, {"text": "(D) The greater a satelite's mass, the lower the centripetal force on it ata given altitude.", "x0": 0.05992217898832685, "y0": 0.5241758241758242, "x1": 0.4311284046692607, "y1": 0.5571428571428572}, {"text": "Consider a geostationary satelite that orbits the Earth in a direction from west to east in the", "x0": 0.05992217898832685, "y0": 0.5901098901098901, "x1": 0.42957198443579764, "y1": 0.6087912087912087}, {"text": "plane. Which statement below describes its motion?", "x0": 0.10272373540856031, "y0": 0.6120879120879121, "x1": 0.31284046692607004, "y1": 0.6285714285714286}, {"text": "(A) twill hover over one spot on the Earth's surface.", "x0": 0.060700389105058365, "y0": 0.6417582417582418, "x1": 0.29027237354085605, "y1": 0.6736263736263737}, {"text": "(B) The satellite will have a period of 365 days.", "x0": 0.060700389105058365, "y0": 0.6604395604395604, "x1": 0.2669260700389105, "y1": 0.6923076923076923}, {"text": "(C) The satellite will continually move over different parts of the Earth's surface.", "x0": 0.060700389105058365, "y0": 0.6791208791208792, "x1": 0.40077821011673154, "y1": 0.710989010989011}, {"text": "(D) _ twill be orbiting in the opposite direction to the Earth's rotation.", "x0": 0.060700389105058365, "y0": 0.6989010989010989, "x1": 0.3556420233463035, "y1": 0.7307692307692307}, {"text": "\u2018What is a major problem if a spacecraft re-enters the Earth's atmosphere at too shallow an", "x0": 0.060700389105058365, "y0": 0.7571428571428571, "x1": 0.42490272373540855, "y1": 0.7879120879120879}, {"text": "angle?", "x0": 0.060700389105058365, "y0": 0.789010989010989, "x1": 0.08715953307392996, "y1": 0.8021978021978022}, {"text": "(A) Itmay become too hot for the astronauts to survive.", "x0": 0.060700389105058365, "y0": 0.8153846153846154, "x1": 0.29961089494163423, "y1": 0.8483516483516483}, {"text": "(B) Itmay decelerate too quickly, and cause excessive g forces on the astronauts.", "x0": 0.060700389105058365, "y0": 0.8340659340659341, "x1": 0.4031128404669261, "y1": 0.8670329670329671}, {"text": "(\u00a9) __ bounce off the atmosphere and back into space.", "x0": 0.060700389105058365, "y0": 0.8549450549450549, "x1": 0.311284046692607, "y1": 0.8868131868131868}, {"text": "(D) It may descend too fast and be unable to be controlled.", "x0": 0.060700389105058365, "y0": 0.8736263736263736, "x1": 0.3120622568093385, "y1": 0.9054945054945055}], [{"text": "\u2018", "x0": 0.7509727626459144, "y0": 0.03076923076923077, "x1": 0.7556420233463035, "y1": 0.03956043956043956}, {"text": "5", "x0": 0.25214007782101167, "y0": 0.03626373626373627, "x1": 0.25603112840466924, "y1": 0.045054945054945054}, {"text": "10, During a classroom experiment a student held a metal conductor attached to a micro-ammeter,", "x0": 0.5470817120622569, "y0": 0.041758241758241756, "x1": 0.9571984435797666, "y1": 0.07362637362637363}, {"text": "Consider the three parallel current carrying wires below.", "x0": 0.07626459143968872, "y0": 0.05714285714285714, "x1": 0.3035019455252918, "y1": 0.07362637362637363}, {"text": "between the poles of an electromagnet. He kept the conductor stationary, and ensured that it was", "x0": 0.5735408560311284, "y0": 0.06043956043956044, "x1": 0.9688715953307393, "y1": 0.09340659340659341}, {"text": "9.", "x0": 0.04669260700389105, "y0": 0.06153846153846154, "x1": 0.051361867704280154, "y1": 0.07252747252747253}, {"text": "notin contact with the electromagnet.", "x0": 0.5766536964980544, "y0": 0.09230769230769231, "x1": 0.7291828793774319, "y1": 0.1054945054945055}, {"text": "conto", "x0": 0.7050583657587549, "y0": 0.15604395604395604, "x1": 0.7330739299610894, "y1": 0.16373626373626374}, {"text": "x Mccann", "x0": 0.7221789883268482, "y0": 0.16373626373626374, "x1": 0.8653696498054475, "y1": 0.18021978021978022}, {"text": "20A", "x0": 0.23813229571984434, "y0": 0.26153846153846155, "x1": 0.2552529182879377, "y1": 0.2714285714285714}, {"text": "\u2018What is the direction of the resultant force on Y?", "x0": 0.07937743190661478, "y0": 0.35824175824175825, "x1": 0.27704280155642025, "y1": 0.389010989010989}, {"text": "\u2018At the moment thatthe electromagnet was switched on, which of the following would have been", "x0": 0.5789883268482491, "y0": 0.3956043956043956, "x1": 0.9704280155642023, "y1": 0.4142857142857143}, {"text": "To the left.", "x0": 0.11050583657587548, "y0": 0.4065934065934066, "x1": 0.154863813229572, "y1": 0.4186813186813187}, {"text": "@)", "x0": 0.08015564202334631, "y0": 0.4087912087912088, "x1": 0.0933852140077821, "y1": 0.421978021978022}, {"text": "observed?", "x0": 0.5789883268482491, "y0": 0.421978021978022, "x1": 0.6202334630350195, "y1": 0.432967032967033}, {"text": "right.", "x0": 0.13929961089494164, "y0": 0.42527472527472526, "x1": 0.16031128404669262, "y1": 0.43956043956043955}, {"text": "Into the plane of the page.", "x0": 0.11050583657587548, "y0": 0.44505494505494503, "x1": 0.21556420233463036, "y1": 0.4593406593406593}, {"text": "\u00a9", "x0": 0.08093385214007782, "y0": 0.4472527472527473, "x1": 0.0933852140077821, "y1": 0.4604395604395604}, {"text": "(A) Nocurrent was detected on the micro-ammeter.", "x0": 0.5797665369649806, "y0": 0.44835164835164837, "x1": 0.8015564202334631, "y1": 0.48021978021978023}, {"text": "Up the plane of the page.", "x0": 0.111284046692607, "y0": 0.46373626373626375, "x1": 0.21167315175097276, "y1": 0.47912087912087914}, {"text": "(B) A brief pulse of current was detected on the micro-ammeter when the electromagnet was", "x0": 0.5797665369649806, "y0": 0.46593406593406594, "x1": 0.9704280155642023, "y1": 0.4978021978021978}, {"text": "\u00a9)", "x0": 0.08093385214007782, "y0": 0.46703296703296704, "x1": 0.09416342412451362, "y1": 0.47912087912087914}, {"text": "switched on.", "x0": 0.6101167315175098, "y0": 0.4978021978021978, "x1": 0.6607003891050583, "y1": 0.5098901098901099}, {"text": "(\u00a9) _Nocurrent flowed because there was no relative movement between the conductor and", "x0": 0.5797665369649806, "y0": 0.5043956043956044, "x1": 0.9665369649805448, "y1": 0.5362637362637362}, {"text": "the magnetic field ofthe electromagnet.", "x0": 0.6108949416342413, "y0": 0.5351648351648352, "x1": 0.7712062256809339, "y1": 0.5505494505494506}, {"text": "(D) A current flowed through the micro-ammeter while the electromagnet was kept switched", "x0": 0.5805447470817121, "y0": 0.5428571428571428, "x1": 0.9743190661478599, "y1": 0.5758241758241758}, {"text": "on.", "x0": 0.6108949416342413, "y0": 0.5791208791208792, "x1": 0.622568093385214, "y1": 0.5868131868131868}], [{"text": "8", "x0": 0.7392996108949417, "y0": 0.031868131868131866, "x1": 0.7424124513618677, "y1": 0.04065934065934066}, {"text": "\u2018A transmission line delivers power ata potential difference of 220 000 V to a transformer", "x0": 0.5634241245136187, "y0": 0.05054945054945055, "x1": 0.9260700389105059, "y1": 0.06593406593406594}, {"text": "7 2", "x0": 0.22801556420233463, "y0": 0.05384615384615385, "x1": 0.5455252918287937, "y1": 0.06813186813186813}, {"text": "designed to step down to 2200 volts. Ifthe primary coil has 9000 tums, how many tums are in", "x0": 0.5634241245136187, "y0": 0.07032967032967033, "x1": 0.9455252918287937, "y1": 0.08571428571428572}, {"text": "11, A square metallic loop is moved at constant velocity through a uniform magnetic field. The", "x0": 0.023346303501945526, "y0": 0.07692307692307693, "x1": 0.4217898832684825, "y1": 0.0967032967032967}, {"text": "the secondary coil? (assume 100% efficiency).", "x0": 0.5642023346303502, "y0": 0.09010989010989011, "x1": 0.7517509727626459, "y1": 0.1043956043956044}, {"text": "Joop, which is at all times perpendicular to the magnetic field, is shown at positions Py, P2, and", "x0": 0.053696498054474705, "y0": 0.0967032967032967, "x1": 0.4350194552529183, "y1": 0.11648351648351649}, {"text": "Ps,", "x0": 0.053696498054474705, "y0": 0.12197802197802197, "x1": 0.06459143968871596, "y1": 0.13406593406593406}, {"text": "(a) 90", "x0": 0.5642023346303502, "y0": 0.13076923076923078, "x1": 0.6046692607003891, "y1": 0.14395604395604394}, {"text": "B) 900", "x0": 0.5642023346303502, "y0": 0.14945054945054945, "x1": 0.6093385214007782, "y1": 0.16263736263736264}, {"text": "(\u00a9 900000", "x0": 0.5642023346303502, "y0": 0.16923076923076924, "x1": 0.6272373540856031, "y1": 0.1824175824175824}, {"text": "@) 9000", "x0": 0.5642023346303502, "y0": 0.189010989010989, "x1": 0.6171206225680934, "y1": 0.2021978021978022}, {"text": "tlt", "x0": 0.09494163424124513, "y0": 0.22197802197802197, "x1": 0.11050583657587548, "y1": 0.25384615384615383}, {"text": "tne paper :", "x0": 0.06536964980544747, "y0": 0.24505494505494504, "x1": 0.5400778210116731, "y1": 0.2549450549450549}, {"text": "\u2018An atom of a hot object emits a quantum of red light of wavelength 6.6 x 10\u201d m. What is the", "x0": 0.5642023346303502, "y0": 0.2571428571428571, "x1": 0.9400778210116731, "y1": 0.2846153846153846}, {"text": "B.", "x0": 0.533852140077821, "y0": 0.26703296703296703, "x1": 0.5463035019455252, "y1": 0.27802197802197803}, {"text": "order of magnitude of the energy carried by this red photon.", "x0": 0.5610894941634241, "y0": 0.27472527472527475, "x1": 0.8054474708171206, "y1": 0.3076923076923077}, {"text": "(1085", "x0": 0.5642023346303502, "y0": 0.321978021978022, "x1": 0.6202334630350195, "y1": 0.3384615384615385}, {"text": "@) 10s", "x0": 0.5642023346303502, "y0": 0.34065934065934067, "x1": 0.6202334630350195, "y1": 0.35824175824175825}, {"text": "\u00a9 10%)", "x0": 0.5642023346303502, "y0": 0.36043956043956044, "x1": 0.6202334630350195, "y1": 0.378021978021978}, {"text": "@) 10s", "x0": 0.5642023346303502, "y0": 0.3802197802197802, "x1": 0.6147859922178989, "y1": 0.3978021978021978}, {"text": "Which statement is TRUE?", "x0": 0.05603112840466926, "y0": 0.4098901098901099, "x1": 0.16731517509727625, "y1": 0.4230769230769231}, {"text": "(A) The induced current at all three positions is clockwise.", "x0": 0.05603112840466926, "y0": 0.43846153846153846, "x1": 0.3058365758754864, "y1": 0.4703296703296703}, {"text": "(B) The only induced current occurs at position Pz 14,", "x0": 0.05603112840466926, "y0": 0.4582417582417582, "x1": 0.5463035019455252, "y1": 0.4901098901098901}, {"text": "Cathode rays were discovered around the middle of the nineteenth century. There was", "x0": 0.5649805447470817, "y0": 0.4593406593406593, "x1": 0.9136186770428015, "y1": 0.4747252747252747}, {"text": "\u2018considerable debate as to the true nature of these cathode rays. Which of the following was", "x0": 0.5642023346303502, "y0": 0.46923076923076923, "x1": 0.933852140077821, "y1": 0.5010989010989011}, {"text": "(\u00a9) The induced current is clockwise at Py, zero at P2, and anti-clockwise at Ps.", "x0": 0.05680933852140078, "y0": 0.4846153846153846, "x1": 0.3906614785992218, "y1": 0.5021978021978022}, {"text": "(D) The induced current is anti-clockwise at Pi, zero at P2, and clockwise at Ps.", "x0": 0.05680933852140078, "y0": 0.4956043956043956, "x1": 0.3906614785992218, "y1": 0.5274725274725275}, {"text": "evidence against the hypothesis that cathode rays were a form of light?", "x0": 0.5649805447470817, "y0": 0.4978021978021978, "x1": 0.8513618677042801, "y1": 0.5131868131868131}, {"text": "(A) They travelled in straight lines.", "x0": 0.5649805447470817, "y0": 0.5274725274725275, "x1": 0.7206225680933852, "y1": 0.5593406593406594}, {"text": "(B) They could initiate chemical reactions.", "x0": 0.5649805447470817, "y0": 0.5461538461538461, "x1": 0.7509727626459144, "y1": 0.5791208791208792}, {"text": "(\u00a9) They were affected by magnetic fields.", "x0": 0.5649805447470817, "y0": 0.5758241758241758, "x1": 0.7517509727626459, "y1": 0.5912087912087912}, {"text": "(D) They could travel through almost a complete vacuum.", "x0": 0.5649805447470817, "y0": 0.5857142857142857, "x1": 0.8132295719844358, "y1": 0.6175824175824176}, {"text": "In a DC generator, what is the fuiction of the split ring commutator?", "x0": 0.5649805447470817, "y0": 0.6626373626373626, "x1": 0.845136186770428, "y1": 0.6945054945054945}, {"text": "15.", "x0": 0.535408560311284, "y0": 0.6747252747252748, "x1": 0.5470817120622569, "y1": 0.6857142857142857}, {"text": "(A) that the generator tunis in one continuous direction.", "x0": 0.5649805447470817, "y0": 0.701098901098901, "x1": 0.846692607003891, "y1": 0.734065934065934}, {"text": "(B) away excess current that the motor generates due to back EMF.", "x0": 0.5649805447470817, "y0": 0.7208791208791209, "x1": 0.8894941634241245, "y1": 0.7527472527472527}, {"text": "Toprovide the magnetic field needed for the coil to experience a torque.", "x0": 0.5945525291828794, "y0": 0.7406593406593407, "x1": 0.888715953307393, "y1": 0.7725274725274726}, {"text": "{D) the current produced by the generator into direct current.", "x0": 0.5649805447470817, "y0": 0.7604395604395604, "x1": 0.9035019455252918, "y1": 0.7923076923076923}], [{"text": "Student Number Question 16 (continued)", "x0": 0.2389105058365759, "y0": 0.06593406593406594, "x1": 0.6482490272373541, "y1": 0.08681318681318681}, {"text": "(\u00a9 The manufacturer of the model cannon specifies thatthe charge used to fire the cannon", "x0": 0.5509727626459144, "y0": 0.08901098901098901, "x1": 0.932295719844358, "y1": 0.12087912087912088}, {"text": "Part B- 85 marks", "x0": 0.04357976653696498, "y0": 0.09010989010989011, "x1": 0.1245136186770428, "y1": 0.12197802197802197}, {"text": "Attempt Questions 16 - 31", "x0": 0.04669260700389105, "y0": 0.11208791208791209, "x1": 0.15875486381322956, "y1": 0.13846153846153847}, {"text": "balls has 16 J of explosive energy. How much of the energy stored in the charge is", "x0": 0.5805447470817121, "y0": 0.11648351648351649, "x1": 0.91284046692607, "y1": 0.13406593406593406}, {"text": "Allow about 2 hours and 30 minutes for this part", "x0": 0.04669260700389105, "y0": 0.12747252747252746, "x1": 0.25992217898832687, "y1": 0.15934065934065933}, {"text": "transferred to the cannon ball when fired? In your answer outline the basic Physics", "x0": 0.5805447470817121, "y0": 0.12747252747252746, "x1": 0.914396887159533, "y1": 0.15934065934065933}, {"text": "principles used.", "x0": 0.5805447470817121, "y0": 0.15934065934065933, "x1": 0.643579766536965, "y1": 0.17472527472527472}, {"text": "\u2018Answer the questions in the spaces provided", "x0": 0.0443579766536965, "y0": 0.16703296703296702, "x1": 0.22957198443579765, "y1": 0.1978021978021978}, {"text": "\u2018Show all relevant working in questions involving calculations. .", "x0": 0.047470817120622566, "y0": 0.21318681318681318, "x1": 0.5579766536964981, "y1": 0.22967032967032966}, {"text": "(Question 16 (6 marks)", "x0": 0.04824902723735409, "y0": 0.2934065934065934, "x1": 0.14085603112840467, "y1": 0.3076923076923077}, {"text": "\u2018A model cannon propels cannon balls of mass 100 g. The cannon is resting on a horizontal table", "x0": 0.045136186770428015, "y0": 0.31978021978021975, "x1": 0.4365758754863813, "y1": 0.3516483516483517}, {"text": "barrel horizontal. The barrel is 1.40 m vertically above the ground. When the cannon was", "x0": 0.08171206225680934, "y0": 0.3384615384615385, "x1": 0.4443579766536965, "y1": 0.37142857142857144}, {"text": "fired, the cannon ball travelled a horizontal distance of 8.60 m. \u2018Question 17 (7 marks)", "x0": 0.045914396887159536, "y0": 0.35604395604395606, "x1": 0.645136186770428, "y1": 0.3912087912087912}, {"text": "co \u2018A satellite of mass 1200 kg orbits the Earth in a polar orbit at an average distance of 480 km above the", "x0": 0.3229571984435798, "y0": 0.3912087912087912, "x1": 0.9688715953307393, "y1": 0.421978021978022}, {"text": "surface.", "x0": 0.5556420233463035, "y0": 0.42417582417582417, "x1": 0.5859922178988327, "y1": 0.4351648351648352}, {"text": "Ifthe average radius of the Earth is 6380 km, calculate the gravitational potential energy", "x0": 0.5828793774319067, "y0": 0.45714285714285713, "x1": 0.9424124513618677, "y1": 0.4758241758241758}, {"text": "aon of the satellite.", "x0": 0.15875486381322956, "y0": 0.4703296703296703, "x1": 0.642023346303502, "y1": 0.5054945054945055}, {"text": "(@) Sketch te trajectory of the canon ball on the diagram above and state the name of the", "x0": 0.05058365758754864, "y0": 0.5318681318681319, "x1": 0.43190661478599224, "y1": 0.5648351648351648}, {"text": "\u2018geometrical shape ofthis trajectory. 2", "x0": 0.08015564202334631, "y0": 0.5560439560439561, "x1": 0.4801556420233463, "y1": 0.578021978021978}, {"text": "barrel. 2", "x0": 0.07782101167315175, "y0": 0.6505494505494506, "x1": 0.48093385214007783, "y1": 0.6824175824175824}, {"text": "(b) Explain whether the magnitude of the work done required to lift this satellite into this", "x0": 0.554863813229572, "y0": 0.6692307692307692, "x1": 0.933852140077821, "y1": 0.689010989010989}, {"text": "orbit is equal to, less than or more than the value of the gravitational potential energy in", "x0": 0.5813229571984436, "y0": 0.6813186813186813, "x1": 0.9408560311284047, "y1": 0.7131868131868132}, {"text": "art (a).", "x0": 0.5844357976653697, "y0": 0.7142857142857143, "x1": 0.6140077821011674, "y1": 0.7285714285714285}, {"text": "Question 16 continued next page Question 17 continued next page", "x0": 0.052140077821011675, "y0": 0.9241758241758242, "x1": 0.6879377431906615, "y1": 0.945054945054945}], [{"text": "u 2", "x0": 0.24046692607003892, "y0": 0.04395604395604396, "x1": 0.7455252918287938, "y1": 0.05274725274725275}, {"text": "Marks Marks", "x0": 0.42412451361867703, "y0": 0.05384615384615385, "x1": 0.9556420233463035, "y1": 0.08461538461538462}, {"text": "Question 17 (continued) \u2018Question 19 (4 marks)", "x0": 0.03501945525291829, "y0": 0.08461538461538462, "x1": 0.6256809338521401, "y1": 0.0989010989010989}, {"text": "(\u00a9) Compare features ofthe orbit ofthis satellite to a satellite of similar mass in a (@) Show how Law of Universal Gravitation can be used to derive an equation for", "x0": 0.03501945525291829, "y0": 0.12197802197802197, "x1": 0.9214007782101167, "y1": 0.13736263736263737}, {"text": "\u2018geostationary orbit at an average distance of 36000 km above the surface of the surface of the orbital speed of a satellite at a given distance above the Earth. 2", "x0": 0.060700389105058365, "y0": 0.13076923076923078, "x1": 0.9634241245136187, "y1": 0.16373626373626374}, {"text": "the Earth. 3", "x0": 0.06459143968871596, "y0": 0.16153846153846155, "x1": 0.46381322957198445, "y1": 0.17362637362637362}, {"text": "(b) Find the period of a satellite orbiting the Earth at an altitude of 580 km above the Earth's", "x0": 0.532295719844358, "y0": 0.378021978021978, "x1": 0.9229571984435798, "y1": 0.4087912087912088}, {"text": "surface. (radius of Earth = 6380 km) 2", "x0": 0.5626459143968872, "y0": 0.4065934065934066, "x1": 0.9634241245136187, "y1": 0.4208791208791209}, {"text": "Question 18 (2 marks)", "x0": 0.0357976653696498, "y0": 0.45384615384615384, "x1": 0.12762645914396886, "y1": 0.46813186813186813}, {"text": "Einstein published his Special Theory of Relativity in 1905. Some years later he then published the", "x0": 0.0357976653696498, "y0": 0.4912087912087912, "x1": 0.4357976653696498, "y1": 0.5076923076923077}, {"text": "General Theory of Relativity.", "x0": 0.0357976653696498, "y0": 0.512087912087912, "x1": 0.15408560311284047, "y1": 0.5263736263736264}, {"text": "(2) Justify the use of the word \u2018special\u2019 in describing the Special Theory of Relativity. 1", "x0": 0.0357976653696498, "y0": 0.5395604395604395, "x1": 0.46381322957198445, "y1": 0.5714285714285714}, {"text": "Question 20 (3 marks)", "x0": 0.5330739299610895, "y0": 0.6153846153846154, "x1": 0.6249027237354086, "y1": 0.6296703296703297}, {"text": "ae (@ of rest mass 1.67 x 10\u201d kg, is accelerated to a speed of 2.0 x 10\u00b0 ms\"", "x0": 0.24980544747081712, "y0": 0.643956043956044, "x1": 0.8832684824902723, "y1": 0.6736263736263737}, {"text": "State an important assumption made in Special Theory of Relativity? 1 ihe the macs ofthe wile tie moving, 2", "x0": 0.06459143968871596, "y0": 0.6527472527472528, "x1": 0.9642023346303502, "y1": 0.6879120879120879}, {"text": "(b) Calculate the rest energy of the proton. 1", "x0": 0.5330739299610895, "y0": 0.8593406593406593, "x1": 0.9634241245136187, "y1": 0.8901098901098901}], [{"text": "3B", "x0": 0.2536964980544747, "y0": 0.04065934065934066, "x1": 0.2607003891050584, "y1": 0.04945054945054945}, {"text": "Marks", "x0": 0.9416342412451362, "y0": 0.05274725274725275, "x1": 0.9704280155642023, "y1": 0.06263736263736264}, {"text": "Question 23 (7 marks)", "x0": 0.5470817120622569, "y0": 0.07692307692307693, "x1": 0.6404669260700389, "y1": 0.09230769230769231}, {"text": "\u2018Question 21 (4 marks)", "x0": 0.047470817120622566, "y0": 0.08241758241758242, "x1": 0.14007782101167315, "y1": 0.0978021978021978}, {"text": "\u2018The diagram below is a simple diagram of the structural components of a direct current electric motor.", "x0": 0.5431906614785992, "y0": 0.10329670329670329, "x1": 0.9618677042801557, "y1": 0.13626373626373625}, {"text": "Cutline the reasons why the Special Theory of Relativity predicts that an object cannot move atthe", "x0": 0.04824902723735409, "y0": 0.10989010989010989, "x1": 0.4474708171206226, "y1": 0.14175824175824175}, {"text": "\u2018The motor coil, ABCD, has an area of 1.70 x 10\u00b0 m? and consists of 12 turns of wire. The magnetic", "x0": 0.5470817120622569, "y0": 0.12637362637362637, "x1": 0.9509727626459143, "y1": 0.15604395604395604}, {"text": "speed of light. 4", "x0": 0.04824902723735409, "y0": 0.13626373626373625, "x1": 0.46848249027237354, "y1": 0.15714285714285714}, {"text": "field on the coil is equal to 0.22 T. When the coil is connected to a power supply and the current", "x0": 0.5447470817120622, "y0": 0.14285714285714285, "x1": 0.9361867704280156, "y1": 0.17472527472527472}, {"text": "switched on, 3.10 A flow through the coil causing the col to experience a torque and start to spin.", "x0": 0.5478599221789884, "y0": 0.16153846153846155, "x1": 0.9431906614785992, "y1": 0.1945054945054945}, {"text": "\u2018Question 22 (5 marks)", "x0": 0.051361867704280154, "y0": 0.4604395604395604, "x1": 0.1431906614785992, "y1": 0.49230769230769234}, {"text": "\u2018The transformer is an essential component in utilising electricity in modern life. Describe the general", "x0": 0.051361867704280154, "y0": 0.5021978021978022, "x1": 0.4591439688715953, "y1": 0.5208791208791209}, {"text": "features of a transformer and the principles involved. Include the techniques developed to improve the", "x0": 0.052140077821011675, "y0": 0.521978021978022, "x1": 0.4669260700389105, "y1": 0.5406593406593406}, {"text": "efficiency of a transformer. 5", "x0": 0.052140077821011675, "y0": 0.5406593406593406, "x1": 0.4653696498054475, "y1": 0.5604395604395604}, {"text": "(\u00a9) When the current is first switched on the coil stats to spin. When the motor coil has", "x0": 0.5509727626459144, "y0": 0.5494505494505495, "x1": 0.9245136186770428, "y1": 0.5813186813186814}, {"text": "achieved full speed it revolves at a constant rate of Hz.", "x0": 0.5774319066147859, "y0": 0.5692307692307692, "x1": 0.8085603112840467, "y1": 0.6010989010989011}, {"text": "Explain how the torque acting on the coil would change as the motor is switched on,", "x0": 0.5774319066147859, "y0": 0.5879120879120879, "x1": 0.9229571984435798, "y1": 0.6197802197802198}, {"text": "begins to rotate, and then finally achieves a maximum rate of rotation. Assume thatthe", "x0": 0.5774319066147859, "y0": 0.6065934065934065, "x1": 0.935408560311284, "y1": 0.6395604395604395}, {"text": "coil starts from position of maximum torque.", "x0": 0.5774319066147859, "y0": 0.6274725274725275, "x1": 0.7642023346303501, "y1": 0.6593406593406593}, {"text": "Question 23 continued next page", "x0": 0.553307392996109, "y0": 0.9098901098901099, "x1": 0.6856031128404669, "y1": 0.9241758241758242}], [{"text": "1s 6", "x0": 0.23035019455252917, "y0": 0.051648351648351645, "x1": 0.7369649805447471, "y1": 0.07142857142857142}, {"text": "Marks", "x0": 0.9206225680933852, "y0": 0.06923076923076923, "x1": 0.9478599221789883, "y1": 0.08021978021978023}, {"text": "Question 23 (continued) Question 24 (6 marks)", "x0": 0.024124513618677044, "y0": 0.09340659340659341, "x1": 0.6147859922178989, "y1": 0.12197802197802197}, {"text": "(@ Sketch a graph of torque vs position of coil (angle) for the rotation of the coil from the In an experiment a current balance was used to determine the magnetic field inside a solenoid. The", "x0": 0.024902723735408562, "y0": 0.11978021978021978, "x1": 0.9291828793774319, "y1": 0.16483516483516483}, {"text": "start of its rotation to when itis rotating at a constant frequency. (Assume that the coil", "x0": 0.051361867704280154, "y0": 0.15054945054945054, "x1": 0.40155642023346305, "y1": 0.1824175824175824}, {"text": "apparatus is shown below.", "x0": 0.5237354085603113, "y0": 0.15164835164835164, "x1": 0.6287937743190661, "y1": 0.16703296703296702}, {"text": "starts from a position of maximum torque). 2", "x0": 0.052140077821011675, "y0": 0.17362637362637362, "x1": 0.45525291828793774, "y1": 0.2021978021978022}, {"text": "torque,", "x0": 0.025680933852140077, "y0": 0.2076923076923077, "x1": 0.05058365758754864, "y1": 0.21978021978021978}, {"text": "Postion of call >", "x0": 0.32684824902723736, "y0": 0.34395604395604396, "x1": 0.43346303501945527, "y1": 0.3659340659340659}, {"text": "__ Solenoid to create a known force. With both circuits on, the current flowing into circuit 1 was adjusted", "x0": 0.514396887159533, "y0": 0.3945054945054945, "x1": 0.9455252918287937, "y1": 0.42747252747252745}, {"text": "magnetic force on the see-saw, created on the current carrying metallic loop inside the solenoid,", "x0": 0.5540856031128405, "y0": 0.4186813186813187, "x1": 0.9455252918287937, "y1": 0.43846153846153846}, {"text": "\u2018balanced the force created by the mass at the other end. The current through the solenoid in circuit 2", "x0": 0.5221789883268483, "y0": 0.432967032967033, "x1": 0.9346303501945525, "y1": 0.46153846153846156}, {"text": "\u2018remained constant throughout the experiment. The following data was collected:", "x0": 0.5252918287937743, "y0": 0.4604395604395604, "x1": 0.8513618677042801, "y1": 0.47692307692307695}, {"text": "Question 24 next page a", "x0": 0.028793774319066146, "y0": 0.4956043956043956, "x1": 0.8926070038910506, "y1": 0.5098901098901099}, {"text": "length of metallic loop inside solenoid affected by the magnetic field of the solenoid = 0.032 m", "x0": 0.556420233463035, "y0": 0.4978021978021978, "x1": 0.9447470817120622, "y1": 0.5164835164835165}, {"text": "\u2018constant current in solenoid (circuit 2) = 4.20 A", "x0": 0.5556420233463035, "y0": 0.5197802197802198, "x1": 0.7486381322957198, "y1": 0.532967032967033}, {"text": "\u2018known force on see-saw created by | current in circuit I to balance see-saw", "x0": 0.5828793774319067, "y0": 0.5472527472527473, "x1": 0.8988326848249028, "y1": 0.5802197802197803}, {"text": "mass (10\u00b0N) a)", "x0": 0.6249027237354086, "y0": 0.5758241758241758, "x1": 0.8280155642023346, "y1": 0.5923076923076923}, {"text": "098 1.25", "x0": 0.645136186770428, "y0": 0.5967032967032967, "x1": 0.8295719844357977, "y1": 0.610989010989011}, {"text": "131", "x0": 0.8132295719844358, "y0": 0.6175824175824176, "x1": 0.8287937743190662, "y1": 0.6274725274725275}, {"text": "1.76 2.26", "x0": 0.6459143968871596, "y0": 0.6362637362637362, "x1": 0.8303501945525292, "y1": 0.6494505494505495}, {"text": "2.35 3.01", "x0": 0.645136186770428, "y0": 0.6538461538461539, "x1": 0.8287937743190662, "y1": 0.6780219780219781}, {"text": "2.84 3.76", "x0": 0.645136186770428, "y0": 0.6747252747252748, "x1": 0.8303501945525292, "y1": 0.6989010989010989}, {"text": "(@) Plot a graph of the results shown on the table in the grid below.", "x0": 0.5260700389105059, "y0": 0.7087912087912088, "x1": 0.8116731517509728, "y1": 0.7406593406593407}, {"text": "\u2018Question 24 continued next page", "x0": 0.5268482490272374, "y0": 0.9527472527472527, "x1": 0.6607003891050583, "y1": 0.967032967032967}], [{"text": "\u201d", "x0": 0.25058365758754864, "y0": 0.03076923076923077, "x1": 0.25758754863813227, "y1": 0.03956043956043956}, {"text": "Question 24 (continued)", "x0": 0.045136186770428015, "y0": 0.07252747252747253, "x1": 0.1431906614785992, "y1": 0.08791208791208792}, {"text": "Outline one important consideration in conducting this experiment ifthe results are to be", "x0": 0.0754863813229572, "y0": 0.10659340659340659, "x1": 0.43268482490272375, "y1": 0.12527472527472527}, {"text": "valid and reliable.", "x0": 0.0754863813229572, "y0": 0.13076923076923078, "x1": 0.14785992217898833, "y1": 0.14285714285714285}, {"text": "(\u00a9) Use the graph to calculate the magnetic field inside the solenoid. Show all working.", "x0": 0.047470817120622566, "y0": 0.23516483516483516, "x1": 0.4132295719844358, "y1": 0.26703296703296703}, {"text": "\u2018Question 25 next page", "x0": 0.049805447470817124, "y0": 0.4901098901098901, "x1": 0.14163424124513618, "y1": 0.5208791208791209}], [{"text": "9", "x0": 0.7501945525291829, "y0": 0.03626373626373627, "x1": 0.757976653696498, "y1": 0.045054945054945054}, {"text": "Marks", "x0": 0.9392996108949416, "y0": 0.05274725274725275, "x1": 0.9673151750972763, "y1": 0.06373626373626373}, {"text": "\u2018Question 26 (6 marks)", "x0": 0.5439688715953307, "y0": 0.06483516483516484, "x1": 0.6365758754863813, "y1": 0.0989010989010989}, {"text": "\u2018Student Number", "x0": 0.22957198443579765, "y0": 0.07582417582417582, "x1": 0.3019455252918288, "y1": 0.08681318681318681}, {"text": "Part B (continued)", "x0": 0.036575875486381325, "y0": 0.0978021978021978, "x1": 0.11673151750972763, "y1": 0.11098901098901098}, {"text": "\u2018Thomson attempted to measure the charge on the cathode ray particles but he did not get consistent", "x0": 0.5408560311284046, "y0": 0.1021978021978022, "x1": 0.9463035019455253, "y1": 0.13626373626373625}, {"text": "results. He was, however, successful in obtaining consistent results of the charge to mass ratio of", "x0": 0.5439688715953307, "y0": 0.13076923076923078, "x1": 0.9369649805447471, "y1": 0.14725274725274726}, {"text": "cathode ray particles.", "x0": 0.5439688715953307, "y0": 0.15274725274725276, "x1": 0.6295719844357976, "y1": 0.16703296703296702}, {"text": "Marks", "x0": 0.4311284046692607, "y0": 0.15824175824175823, "x1": 0.4591439688715953, "y1": 0.17032967032967034}, {"text": "Question 25 (6 marks)", "x0": 0.03735408560311284, "y0": 0.18021978021978022, "x1": 0.12996108949416343, "y1": 0.1934065934065934}, {"text": "(@) Outline the experimental method that Thomson carried out to measure the charge to mass", "x0": 0.5439688715953307, "y0": 0.1901098901098901, "x1": 0.9361867704280156, "y1": 0.20549450549450549}, {"text": "ratio of cathode ray particles. Your answer should include the measurements he had to", "x0": 0.5704280155642023, "y0": 0.2010989010989011, "x1": 0.9268482490272374, "y1": 0.23186813186813188}, {"text": "In your course, you observed the results of experimental demonstrations that identified the", "x0": 0.03735408560311284, "y0": 0.2175824175824176, "x1": 0.40233463035019457, "y1": 0.23296703296703297}, {"text": "obtain.", "x0": 0.5704280155642023, "y0": 0.22087912087912087, "x1": 0.6007782101167315, "y1": 0.25164835164835164}, {"text": "properties of cathode rays using gas discharge tubes. Outline the experiments and describe how", "x0": 0.03735408560311284, "y0": 0.22637362637362637, "x1": 0.422568093385214, "y1": 0.25934065934065936}, {"text": "the experimental results of these demonstrations showed that:", "x0": 0.03735408560311284, "y0": 0.2571428571428571, "x1": 0.2856031128404669, "y1": 0.2714285714285714}, {"text": "(2) cathode rays travel in straight lines.", "x0": 0.03813229571984436, "y0": 0.2956043956043956, "x1": 0.21011673151750973, "y1": 0.3098901098901099}, {"text": "(\u00a9) cathode rays transfer energy.", "x0": 0.03813229571984436, "y0": 0.489010989010989, "x1": 0.1821011673151751, "y1": 0.5032967032967033}, {"text": "\u2018State the conclusions that could be drawn from the value of the charge to mass ratio", "x0": 0.5735408560311284, "y0": 0.6065934065934065, "x1": 0.9136186770428015, "y1": 0.6373626373626373}, {"text": "obtained?", "x0": 0.5735408560311284, "y0": 0.6362637362637362, "x1": 0.6132295719844358, "y1": 0.6472527472527473}, {"text": "(\u00a9) cathode rays are negatively charged.", "x0": 0.038910505836575876, "y0": 0.6714285714285714, "x1": 0.21478599221789882, "y1": 0.7021978021978021}, {"text": "Question 27 next page", "x0": 0.5439688715953307, "y0": 0.7725274725274726, "x1": 0.6342412451361867, "y1": 0.7857142857142857}], [{"text": "Marks Marks", "x0": 0.4474708171206226, "y0": 0.01868131868131868, "x1": 0.977431906614786, "y1": 0.05054945054945055}, {"text": "Question 27 (4 marks) \u2018Question 28 (5 marks)", "x0": 0.054474708171206226, "y0": 0.03626373626373627, "x1": 0.6474708171206226, "y1": 0.07582417582417582}, {"text": "\u2018The electric plates in a cathode ray tube are 0.008 m apart and have a potential difference of \u2018The AC induction motor has proved very versatile and has been widely employed in many applications,", "x0": 0.054474708171206226, "y0": 0.07252747252747253, "x1": 0.9743190661478599, "y1": 0.11208791208791209}, {"text": "620 across them. Give reasons for the widespread use of AC induction motors and assess their impact on society and the", "x0": 0.058365758754863814, "y0": 0.09230769230769231, "x1": 0.9743190661478599, "y1": 0.13406593406593406}, {"text": "\u2018environment. 5", "x0": 0.5509727626459144, "y0": 0.11428571428571428, "x1": 0.9766536964980544, "y1": 0.14615384615384616}, {"text": "the strength of the uniform electric field between the two plates? 1", "x0": 0.12217898832684825, "y0": 0.13736263736263737, "x1": 0.48638132295719844, "y1": 0.17032967032967034}, {"text": "(\u00a9) Ifa magnetic field was applied (inthe appropriate direction), what magnetic field", "x0": 0.060700389105058365, "y0": 0.36813186813186816, "x1": 0.41867704280155643, "y1": 0.4010989010989011}, {"text": "strength would be required to balance the electri force on the electron ifthe electron is", "x0": 0.08715953307392996, "y0": 0.3868131868131868, "x1": 0.44280155642023344, "y1": 0.4197802197802198}, {"text": "travelling through the field at 2.2 x 10\u00b0 ms\"? 2", "x0": 0.08793774319066149, "y0": 0.4087912087912088, "x1": 0.4894941634241245, "y1": 0.43736263736263736}, {"text": "Question 29 next page", "x0": 0.5579766536964981, "y0": 0.5868131868131868, "x1": 0.6482490272373541, "y1": 0.6010989010989011}, {"text": "Question 28 next page", "x0": 0.06381322957198443, "y0": 0.6406593406593407, "x1": 0.1556420233463035, "y1": 0.6714285714285714}], [{"text": "Marks Marks", "x0": 0.031906614785992216, "y0": 0.05274725274725275, "x1": 0.9696498054474708, "y1": 0.08351648351648351}, {"text": "\u2018Question 29 (5 marks) (Question 30 (3 marks)", "x0": 0.03501945525291829, "y0": 0.06593406593406594, "x1": 0.6389105058365758, "y1": 0.0967032967032967}, {"text": "Statewhat is meant by a \u2018black body\"?", "x0": 0.5758754863813229, "y0": 0.10329670329670329, "x1": 0.7299610894941634, "y1": 0.13406593406593406}, {"text": "(@) Describe Hertz's observation of the effect of a radio wave on a receiver and the", "x0": 0.03501945525291829, "y0": 0.1076923076923077, "x1": 0.3852140077821012, "y1": 0.14065934065934066}, {"text": "photoelectric effect he produced but failed to investigate, 3", "x0": 0.0622568093385214, "y0": 0.12747252747252746, "x1": 0.46381322957198445, "y1": 0.15934065934065933}, {"text": "waves.", "x0": 0.06614785992217899, "y0": 0.4714285714285714, "x1": 0.09105058365758754, "y1": 0.47912087912087914}, {"text": "Wavelengths", "x0": 0.7252918287937743, "y0": 0.5978021978021978, "x1": 0.777431906614786, "y1": 0.6098901098901099}, {"text": "\u2018The above diagram shows the shape of the curve for the intensity of thermal radiation", "x0": 0.5750972762645914, "y0": 0.6736263736263737, "x1": 0.9221789883268483, "y1": 0.6879120879120879}, {"text": "from a black body plotted against the distribution of wavelengths at two different", "x0": 0.5758754863813229, "y0": 0.6934065934065934, "x1": 0.9050583657587549, "y1": 0.7076923076923077}, {"text": "temperatures. Outline the contribution that Planck made in his efforts to explain the shape", "x0": 0.5758754863813229, "y0": 0.7131868131868132, "x1": 0.9392996108949416, "y1": 0.7274725274725274}, {"text": "Question 30 next page", "x0": 0.036575875486381325, "y0": 0.7186813186813187, "x1": 0.12684824902723735, "y1": 0.7329670329670329}], [{"text": "\u2018Question 31 (continued)", "x0": 0.5626459143968872, "y0": 0.04725274725274725, "x1": 0.6599221789883268, "y1": 0.06153846153846154}, {"text": "(Question 31 (12 marks)", "x0": 0.0622568093385214, "y0": 0.06263736263736264, "x1": 0.16031128404669262, "y1": 0.07692307692307693}, {"text": "(a) State what is meant by the photoelectric effect?", "x0": 0.0622568093385214, "y0": 0.08901098901098901, "x1": 0.28249027237354085, "y1": 0.12197802197802197}, {"text": "(b) Classical Physics theories about the wave nature of light made several predictions about", "x0": 0.0622568093385214, "y0": 0.21318681318681318, "x1": 0.4466926070038911, "y1": 0.22967032967032966}, {"text": "the photoelectric effect which tumed out not to agree with experimental observations.", "x0": 0.09260700389105059, "y0": 0.23296703296703297, "x1": 0.43735408560311284, "y1": 0.24945054945054945}, {"text": "State ONE of these predictions and outline the actual experimental observation/s.", "x0": 0.09260700389105059, "y0": 0.25164835164835164, "x1": 0.41945525291828795, "y1": 0.2681318681318681}, {"text": "\u00a3\u2014 work function to describe the kinetic energy", "x0": 0.25680933852140075, "y0": 0.4351648351648352, "x1": 0.4482490272373541, "y1": 0.46593406593406594}, {"text": "(\u00a9) Einstein developed the equation KE.", "x0": 0.06303501945525292, "y0": 0.44505494505494503, "x1": 0.23813229571984434, "y1": 0.4604395604395604}, {"text": "(KE) given to electrons in the photoelectric effect. What does the \u2018work function\u2019 refer", "x0": 0.09027237354085603, "y0": 0.45494505494505494, "x1": 0.4466926070038911, "y1": 0.4857142857142857}, {"text": "to?", "x0": 0.0933852140077821, "y0": 0.4857142857142857, "x1": 0.10583657587548638, "y1": 0.4967032967032967}, {"text": "(\u00a9) Find the gradient of the line and state its units.", "x0": 0.5618677042801556, "y0": 0.5010989010989011, "x1": 0.7782101167315175, "y1": 0.5318681318681319}, {"text": "(4) The data below show the outcome of a photoelectric effect experiment from a given", "x0": 0.06381322957198443, "y0": 0.5978021978021978, "x1": 0.43190661478599224, "y1": 0.6142857142857143}, {"text": "\u2018metal surface. This data can be analysed using the equation in part (c) above.", "x0": 0.0933852140077821, "y0": 0.6087912087912087, "x1": 0.4038910505836576, "y1": 0.6406593406593407}, {"text": "(State the quantity the gradient represents?", "x0": 0.5618677042801556, "y0": 0.6142857142857143, "x1": 0.7603112840466926, "y1": 0.6461538461538462}, {"text": "Trequency of incident \u2018energy of photoelectrons", "x0": 0.1463035019455253, "y0": 0.6472527472527473, "x1": 0.38210116731517507, "y1": 0.6802197802197802}, {"text": "radiation (x Hz) 10\")", "x0": 0.14708171206225681, "y0": 0.6725274725274726, "x1": 0.35252918287937746, "y1": 0.6912087912087912}, {"text": "69 122", "x0": 0.18365758754863815, "y0": 0.6967032967032967, "x1": 0.3416342412451362, "y1": 0.7087912087912088}, {"text": "82 170", "x0": 0.18365758754863815, "y0": 0.7164835164835165, "x1": 0.3416342412451362, "y1": 0.7285714285714285}, {"text": "1 2.50", "x0": 0.18365758754863815, "y0": 0.7362637362637363, "x1": 0.3416342412451362, "y1": 0.7483516483516484}, {"text": "99 305", "x0": 0.18365758754863815, "y0": 0.756043956043956, "x1": 0.3408560311284047, "y1": 0.7681318681318682}, {"text": "106 338", "x0": 0.1821011673151751, "y0": 0.7758241758241758, "x1": 0.3416342412451362, "y1": 0.7879120879120879}, {"text": "118 391", "x0": 0.1821011673151751, "y0": 0.7956043956043956, "x1": 0.3408560311284047, "y1": 0.8076923076923077}, {"text": "(h) Determine the threshold frequency in this experiment,", "x0": 0.5610894941634241, "y0": 0.8065934065934066, "x1": 0.8101167315175097, "y1": 0.8208791208791208}, {"text": "Plot this data on the axis provided on the next page and draw the line of best fit.", "x0": 0.09416342412451362, "y0": 0.845054945054945, "x1": 0.4163424124513619, "y1": 0.8769230769230769}, {"text": "\u2018Question 31 continued next page", "x0": 0.06381322957198443, "y0": 0.8956043956043956, "x1": 0.19766536964980544, "y1": 0.9087912087912088}, {"text": "\u2018End of examination questions", "x0": 0.7120622568093385, "y0": 0.8989010989010989, "x1": 0.8334630350194553, "y1": 0.9131868131868132}]]