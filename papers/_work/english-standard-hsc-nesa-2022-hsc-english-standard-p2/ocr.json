[[{"text": "GOVERNMENT", "x0": 0.12197802197802197, "y0": 0.1592851592851593, "x1": 0.22527472527472528, "y1": 0.16705516705516704}, {"text": "NSW Education Standards Authority", "x0": 0.11978021978021978, "y0": 0.19036519036519037, "x1": 0.4714285714285714, "y1": 0.20512820512820512}, {"text": "2022", "x0": 0.12747252747252746, "y0": 0.31002331002331, "x1": 0.18571428571428572, "y1": 0.32323232323232326}, {"text": "HIGHER SCHOOL CERTIFICATE EXAMINATION", "x0": 0.2043956043956044, "y0": 0.3146853146853147, "x1": 0.5857142857142857, "y1": 0.32323232323232326}, {"text": "English Standard", "x0": 0.12307692307692308, "y0": 0.35120435120435123, "x1": 0.5263736263736264, "y1": 0.38694638694638694}, {"text": "Paper 2 \u2014 Modules", "x0": 0.12197802197802197, "y0": 0.4211344211344211, "x1": 0.45494505494505494, "y1": 0.445998445998446}, {"text": "General", "x0": 0.11978021978021978, "y0": 0.4933954933954934, "x1": 0.19230769230769232, "y1": 0.5034965034965035}, {"text": "+ Reading time - 5 minutes", "x0": 0.2681318681318681, "y0": 0.4933954933954934, "x1": 0.5131868131868131, "y1": 0.5066045066045066}, {"text": "Instructions Working time - 2 hours", "x0": 0.11978021978021978, "y0": 0.5112665112665112, "x1": 0.49230769230769234, "y1": 0.5275835275835276}, {"text": "+ Write using black pen", "x0": 0.2681318681318681, "y0": 0.5353535353535354, "x1": 0.47802197802197804, "y1": 0.5485625485625486}, {"text": "Total marks: Section | - 20 marks (pages 2-3)", "x0": 0.11868131868131868, "y0": 0.5897435897435898, "x1": 0.5714285714285714, "y1": 0.602952602952603}, {"text": "60", "x0": 0.11868131868131868, "y0": 0.6076146076146076, "x1": 0.14065934065934066, "y1": 0.6177156177156177}, {"text": "+ Attempt Question 1", "x0": 0.2681318681318681, "y0": 0.6138306138306139, "x1": 0.45604395604395603, "y1": 0.627039627039627}, {"text": "+ Allow about 40 minutes for this section", "x0": 0.2681318681318681, "y0": 0.6355866355866356, "x1": 0.6351648351648351, "y1": 0.6456876456876457}, {"text": "Section II - 20 marks (pages 4-11)", "x0": 0.26703296703296703, "y0": 0.6682206682206682, "x1": 0.589010989010989, "y1": 0.6814296814296814}, {"text": "+ Attempt ONE question from Questions 2 (a)-2(i)", "x0": 0.2681318681318681, "y0": 0.6923076923076923, "x1": 0.7208791208791209, "y1": 0.7055167055167055}, {"text": "+ Allow about 40 minutes for this section", "x0": 0.2681318681318681, "y0": 0.714063714063714, "x1": 0.6351648351648351, "y1": 0.7241647241647242}, {"text": "Section III - 20 marks (page 12)", "x0": 0.26703296703296703, "y0": 0.7466977466977467, "x1": 0.5637362637362637, "y1": 0.7599067599067599}, {"text": "+ Attempt Question 3", "x0": 0.2681318681318681, "y0": 0.7715617715617715, "x1": 0.4582417582417582, "y1": 0.7847707847707848}, {"text": "+ Allow about 40 minutes for this section", "x0": 0.2681318681318681, "y0": 0.7925407925407926, "x1": 0.6351648351648351, "y1": 0.8026418026418026}, {"text": "1035", "x0": 0.08241758241758242, "y0": 0.9463869463869464, "x1": 0.11758241758241758, "y1": 0.9549339549339549}], [{"text": "Section I \u2014 Module A: Language, Identity and Culture", "x0": 0.11978021978021978, "y0": 0.08236208236208237, "x1": 0.6780219780219781, "y1": 0.09712509712509712}, {"text": "20 marks", "x0": 0.11868131868131868, "y0": 0.11732711732711733, "x1": 0.1989010989010989, "y1": 0.12742812742812742}, {"text": "Attempt Question 1", "x0": 0.11868131868131868, "y0": 0.13364413364413363, "x1": 0.2868131868131868, "y1": 0.14685314685314685}, {"text": "Allow about 40 minutes for this section", "x0": 0.11868131868131868, "y0": 0.15073815073815075, "x1": 0.45604395604395603, "y1": 0.16083916083916083}, {"text": "Answer the question on pages 2-8 of the Paper 2 Writing Booklet. Extra writing booklets are", "x0": 0.11978021978021978, "y0": 0.18337218337218336, "x1": 0.8791208791208791, "y1": 0.19658119658119658}, {"text": "available.", "x0": 0.11978021978021978, "y0": 0.20046620046620048, "x1": 0.1956043956043956, "y1": 0.21056721056721056}, {"text": "Your answer will be assessed on how well you:", "x0": 0.14395604395604394, "y0": 0.23076923076923078, "x1": 0.5274725274725275, "y1": 0.24397824397824397}, {"text": "demonstrate understanding of how ideas about language, identity and culture are", "x0": 0.16703296703296702, "y0": 0.2501942501942502, "x1": 0.856043956043956, "y1": 0.2634032634032634}, {"text": "expressed through texts", "x0": 0.16703296703296702, "y0": 0.26728826728826727, "x1": 0.35714285714285715, "y1": 0.2804972804972805}, {"text": "\u00a9 demonstrate understanding of how language is used to shape meaning about", "x0": 0.14285714285714285, "y0": 0.2874902874902875, "x1": 0.856043956043956, "y1": 0.3006993006993007}, {"text": "individuals and/or cultural groups", "x0": 0.16703296703296702, "y0": 0.3038073038073038, "x1": 0.43956043956043955, "y1": 0.317016317016317}, {"text": "organise, develop and express ideas using language appropriate to audience, purpose", "x0": 0.16703296703296702, "y0": 0.32400932400932403, "x1": 0.856043956043956, "y1": 0.3372183372183372}, {"text": "and form", "x0": 0.16703296703296702, "y0": 0.34032634032634035, "x1": 0.23956043956043957, "y1": 0.3504273504273504}, {"text": "Question 1 (20 marks)", "x0": 0.11978021978021978, "y0": 0.3861693861693862, "x1": 0.30439560439560437, "y1": 0.3986013986013986}, {"text": "Explain how the language used in your prescribed text changed your perceptions about identity.", "x0": 0.11978021978021978, "y0": 0.4195804195804196, "x1": 0.8791208791208791, "y1": 0.43278943278943277}, {"text": "In your response, make detailed reference to your prescribed text.", "x0": 0.11978021978021978, "y0": 0.452991452991453, "x1": 0.6505494505494506, "y1": 0.4662004662004662}, {"text": "The prescribed texts are listed on page 3.", "x0": 0.11978021978021978, "y0": 0.5027195027195027, "x1": 0.45054945054945056, "y1": 0.515928515928516}, {"text": "Question 1 continues on page 3", "x0": 0.3659340659340659, "y0": 0.5695415695415695, "x1": 0.6329670329670329, "y1": 0.5827505827505828}], [{"text": "Question 1 (continued)", "x0": 0.11978021978021978, "y0": 0.08158508158508158, "x1": 0.30439560439560437, "y1": 0.0947940947940948}, {"text": "The prescribed texts are:", "x0": 0.11868131868131868, "y0": 0.11499611499611499, "x1": 0.31758241758241756, "y1": 0.1282051282051282}, {"text": "Prose Fiction", "x0": 0.14285714285714285, "y0": 0.14840714840714841, "x1": 0.256043956043956, "y1": 0.1585081585081585}, {"text": "Henry Lawson, The Penguin Henry Lawson Short Stories", "x0": 0.3098901098901099, "y0": 0.14840714840714841, "x1": 0.7769230769230769, "y1": 0.16161616161616163}, {"text": "* The Drover\u2019s Wife", "x0": 0.310989010989011, "y0": 0.1717171717171717, "x1": 0.4835164835164835, "y1": 0.18492618492618493}, {"text": "* The Union Buries Its Dead", "x0": 0.310989010989011, "y0": 0.1888111888111888, "x1": 0.5527472527472528, "y1": 0.1989121989121989}, {"text": "* Shooting the Moon", "x0": 0.310989010989011, "y0": 0.20512820512820512, "x1": 0.4868131868131868, "y1": 0.21833721833721834}, {"text": "* Our Pipes", "x0": 0.310989010989011, "y0": 0.222999222999223, "x1": 0.4153846153846154, "y1": 0.23543123543123542}, {"text": "* The Loaded Dog", "x0": 0.310989010989011, "y0": 0.23853923853923853, "x1": 0.46813186813186813, "y1": 0.2517482517482518}, {"text": "Andrea Levy, Small Island", "x0": 0.3098901098901099, "y0": 0.27195027195027194, "x1": 0.5285714285714286, "y1": 0.2851592851592852}, {"text": "Poetry", "x0": 0.14285714285714285, "y0": 0.30536130536130535, "x1": 0.1989010989010989, "y1": 0.3185703185703186}, {"text": "Adam Aitken, Kim Cheng Boey and Michelle Cahill (eds),", "x0": 0.3098901098901099, "y0": 0.30536130536130535, "x1": 0.7879120879120879, "y1": 0.3185703185703186}, {"text": "Contemporary Asian Australian Poets", "x0": 0.3098901098901099, "y0": 0.32245532245532244, "x1": 0.6186813186813187, "y1": 0.3356643356643357}, {"text": "The prescribed poems are:", "x0": 0.3098901098901099, "y0": 0.3457653457653458, "x1": 0.521978021978022, "y1": 0.358974358974359}, {"text": "* Merlinda Bobis, This is where it begins", "x0": 0.310989010989011, "y0": 0.3690753690753691, "x1": 0.6527472527472528, "y1": 0.3822843822843823}, {"text": "* Miriam Wei Wei Lo, Home", "x0": 0.310989010989011, "y0": 0.3861693861693862, "x1": 0.5571428571428572, "y1": 0.3986013986013986}, {"text": "* Ouyang Yu, New Accents", "x0": 0.310989010989011, "y0": 0.4024864024864025, "x1": 0.5406593406593406, "y1": 0.4156954156954157}, {"text": "* Vuong Pham, Mother", "x0": 0.310989010989011, "y0": 0.4188034188034188, "x1": 0.5098901098901099, "y1": 0.432012432012432}, {"text": "* Jaya Savige, Circular Breathing", "x0": 0.310989010989011, "y0": 0.4358974358974359, "x1": 0.5945054945054945, "y1": 0.4491064491064491}, {"text": "* Maureen Ten (Ten Ch\u2019in U), Translucent Jade", "x0": 0.310989010989011, "y0": 0.4506604506604507, "x1": 0.7131868131868132, "y1": 0.4654234654234654}, {"text": "Ali Cobby Eckermann, Inside my Mother", "x0": 0.3098901098901099, "y0": 0.48562548562548563, "x1": 0.6461538461538462, "y1": 0.4988344988344988}, {"text": "The prescribed poems are:", "x0": 0.3098901098901099, "y0": 0.5097125097125097, "x1": 0.521978021978022, "y1": 0.5229215229215229}, {"text": "Trance", "x0": 0.33406593406593404, "y0": 0.5337995337995338, "x1": 0.389010989010989, "y1": 0.5431235431235432}, {"text": "*", "x0": 0.310989010989011, "y0": 0.5337995337995338, "x1": 0.31758241758241756, "y1": 0.5392385392385393}, {"text": "Unearth", "x0": 0.33516483516483514, "y0": 0.5501165501165501, "x1": 0.3989010989010989, "y1": 0.5594405594405595}, {"text": "*", "x0": 0.310989010989011, "y0": 0.5501165501165501, "x1": 0.31758241758241756, "y1": 0.5555555555555556}, {"text": "Oombulgarri", "x0": 0.33406593406593404, "y0": 0.5664335664335665, "x1": 0.43846153846153846, "y1": 0.5796425796425796}, {"text": "*", "x0": 0.310989010989011, "y0": 0.5672105672105672, "x1": 0.31758241758241756, "y1": 0.5726495726495726}, {"text": "Eyes", "x0": 0.33296703296703295, "y0": 0.5835275835275835, "x1": 0.37032967032967035, "y1": 0.5936285936285937}, {"text": "*", "x0": 0.310989010989011, "y0": 0.5835275835275835, "x1": 0.31758241758241756, "y1": 0.5889665889665889}, {"text": "Leaves", "x0": 0.33296703296703295, "y0": 0.5998445998445998, "x1": 0.3879120879120879, "y1": 0.6091686091686092}, {"text": "*", "x0": 0.310989010989011, "y0": 0.5998445998445998, "x1": 0.31758241758241756, "y1": 0.6052836052836053}, {"text": "* Key", "x0": 0.310989010989011, "y0": 0.616938616938617, "x1": 0.3637362637362637, "y1": 0.6293706293706294}, {"text": "Drama", "x0": 0.14285714285714285, "y0": 0.6495726495726496, "x1": 0.2021978021978022, "y1": 0.6596736596736597}, {"text": "Ray Lawler, Summer of the Seventeenth Doll", "x0": 0.3098901098901099, "y0": 0.6495726495726496, "x1": 0.6747252747252748, "y1": 0.6627816627816627}, {"text": "Bernard Shaw, Pygmalion", "x0": 0.3098901098901099, "y0": 0.6728826728826729, "x1": 0.5208791208791209, "y1": 0.6860916860916861}, {"text": "Alana Valentine, Shafana and Aunt Sarrinah", "x0": 0.3098901098901099, "y0": 0.6961926961926962, "x1": 0.6736263736263737, "y1": 0.7094017094017094}, {"text": "Nonfiction", "x0": 0.14285714285714285, "y0": 0.7296037296037297, "x1": 0.23296703296703297, "y1": 0.7397047397047397}, {"text": "Alice Pung, Unpolished Gem", "x0": 0.3098901098901099, "y0": 0.7296037296037297, "x1": 0.5461538461538461, "y1": 0.7428127428127428}, {"text": "Film", "x0": 0.14285714285714285, "y0": 0.763014763014763, "x1": 0.1824175824175824, "y1": 0.7731157731157731}, {"text": "Rachel Perkins, One Night the Moon", "x0": 0.3098901098901099, "y0": 0.763014763014763, "x1": 0.6076923076923076, "y1": 0.7762237762237763}, {"text": "Rob Sitch, The Castle", "x0": 0.3098901098901099, "y0": 0.7863247863247863, "x1": 0.4868131868131868, "y1": 0.7987567987567987}, {"text": "Media", "x0": 0.14285714285714285, "y0": 0.8205128205128205, "x1": 0.1967032967032967, "y1": 0.8306138306138307}, {"text": "Janet Merewether, Reindeer in my Saami Heart", "x0": 0.3098901098901099, "y0": 0.8205128205128205, "x1": 0.6956043956043956, "y1": 0.8329448329448329}, {"text": "End of Section I", "x0": 0.42967032967032964, "y0": 0.8873348873348873, "x1": 0.5692307692307692, "y1": 0.8974358974358975}], [{"text": "Section II \u2014 Module B: Close Study of Literature", "x0": 0.11978021978021978, "y0": 0.08236208236208237, "x1": 0.6230769230769231, "y1": 0.09712509712509712}, {"text": "20 marks", "x0": 0.11868131868131868, "y0": 0.11732711732711733, "x1": 0.1989010989010989, "y1": 0.12742812742812742}, {"text": "Attempt ONE question from Questions 2(a)-2(i)", "x0": 0.11868131868131868, "y0": 0.13364413364413363, "x1": 0.5461538461538461, "y1": 0.14685314685314685}, {"text": "Allow about 40 minutes for this section", "x0": 0.11868131868131868, "y0": 0.15073815073815075, "x1": 0.45604395604395603, "y1": 0.16083916083916083}, {"text": "\u2018Answer the question on pages 10-16 of the Paper 2 Writing Booklet. Extra writing booklets", "x0": 0.11868131868131868, "y0": 0.18337218337218336, "x1": 0.8791208791208791, "y1": 0.19658119658119658}, {"text": "are available.", "x0": 0.11978021978021978, "y0": 0.20046620046620048, "x1": 0.22527472527472528, "y1": 0.21056721056721056}, {"text": "Your answer will be assessed on how well you:", "x0": 0.14395604395604394, "y0": 0.23076923076923078, "x1": 0.5274725274725275, "y1": 0.24397824397824397}, {"text": "* demonstrate understanding of a text\u2019s distinctive qualities and how these shape", "x0": 0.14285714285714285, "y0": 0.2501942501942502, "x1": 0.856043956043956, "y1": 0.2634032634032634}, {"text": "meaning", "x0": 0.16703296703296702, "y0": 0.2703962703962704, "x1": 0.23516483516483516, "y1": 0.2804972804972805}, {"text": "\u00a9 organise, develop and express ideas using language appropriate to audience, purpose", "x0": 0.14285714285714285, "y0": 0.2874902874902875, "x1": 0.856043956043956, "y1": 0.3006993006993007}, {"text": "and form", "x0": 0.16703296703296702, "y0": 0.3038073038073038, "x1": 0.23956043956043957, "y1": 0.3139083139083139}, {"text": "Question 2 (a) \u2014 Prose Fiction - M T Anderson, Feed (20 marks)", "x0": 0.11978021978021978, "y0": 0.34965034965034963, "x1": 0.6791208791208792, "y1": 0.3620823620823621}, {"text": "\u2018Analyse how the central ideas of Feed are explored through the distinctive qualities of the text.", "x0": 0.11868131868131868, "y0": 0.37373737373737376, "x1": 0.8791208791208791, "y1": 0.40015540015540013}, {"text": "In your response, make detailed reference to the extract below and your prescribed text.", "x0": 0.11978021978021978, "y0": 0.4156954156954157, "x1": 0.8307692307692308, "y1": 0.4289044289044289}, {"text": "The first thing I felt was no credit.", "x0": 0.3021978021978022, "y0": 0.445998445998446, "x1": 0.5802197802197803, "y1": 0.4592074592074592}, {"text": "I tried to touch my credit, but there was", "x0": 0.3274725274725275, "y0": 0.4731934731934732, "x1": 0.6967032967032967, "y1": 0.4864024864024864}, {"text": "nothing there.", "x0": 0.3021978021978022, "y0": 0.48951048951048953, "x1": 0.41318681318681316, "y1": 0.5027195027195027}, {"text": "It felt like I was in a little room.", "x0": 0.3274725274725275, "y0": 0.5135975135975136, "x1": 0.5857142857142857, "y1": 0.5337995337995338}, {"text": "My body \u20141 was in a bed, on top of my arm,", "x0": 0.3263736263736264, "y0": 0.5431235431235432, "x1": 0.6956043956043956, "y1": 0.5563325563325563}, {"text": "which was asleep, but I didn\u2019t know where, I", "x0": 0.3021978021978022, "y0": 0.5594405594405595, "x1": 0.6956043956043956, "y1": 0.5726495726495726}, {"text": "couldn\u2019t find the Lunar GPS to tell me.", "x0": 0.3021978021978022, "y0": 0.5765345765345765, "x1": 0.6197802197802198, "y1": 0.5866355866355867}, {"text": "Someone had left a message in my head,", "x0": 0.3274725274725275, "y0": 0.602952602952603, "x1": 0.6956043956043956, "y1": 0.6161616161616161}, {"text": "which I found, and then kept finding everywhere", "x0": 0.3021978021978022, "y0": 0.62004662004662, "x1": 0.6967032967032967, "y1": 0.6332556332556333}, {"text": "I went, which said that there was no transmission", "x0": 0.3032967032967033, "y0": 0.6363636363636364, "x1": 0.6967032967032967, "y1": 0.6487956487956488}, {"text": "signal, that I was currently disconnected from", "x0": 0.3032967032967033, "y0": 0.6534576534576535, "x1": 0.6967032967032967, "y1": 0.6666666666666666}, {"text": "feednet. I tried to chat Link and then Marty, but", "x0": 0.3032967032967033, "y0": 0.6697746697746698, "x1": 0.6967032967032967, "y1": 0.682983682983683}, {"text": "nothing, there was no transmission signal, I was", "x0": 0.3021978021978022, "y0": 0.6868686868686869, "x1": 0.6967032967032967, "y1": 0.7000777000777001}, {"text": "currently disconnected from feednet, of course,", "x0": 0.3021978021978022, "y0": 0.7031857031857032, "x1": 0.6956043956043956, "y1": 0.7163947163947164}, {"text": "and I was starting to get scared, so I tried to chat", "x0": 0.3021978021978022, "y0": 0.7171717171717171, "x1": 0.6967032967032967, "y1": 0.7365967365967366}, {"text": "my parents, I tried to chat them on Earth, but", "x0": 0.3021978021978022, "y0": 0.7365967365967366, "x1": 0.6967032967032967, "y1": 0.7498057498057498}, {"text": "there was no transmission etc., I was currently", "x0": 0.3021978021978022, "y0": 0.752913752913753, "x1": 0.6967032967032967, "y1": 0.7661227661227661}, {"text": "etc.", "x0": 0.3021978021978022, "y0": 0.7715617715617715, "x1": 0.32967032967032966, "y1": 0.7801087801087802}, {"text": "So I opened my eyes.", "x0": 0.3274725274725275, "y0": 0.7964257964257965, "x1": 0.4989010989010989, "y1": 0.8096348096348096}, {"text": "(\u00a9 2002 M. T. Anderson", "x0": 0.554945054945055, "y0": 0.8174048174048174, "x1": 0.6978021978021978, "y1": 0.8391608391608392}, {"text": "Reproduced by permission of Walker Books Australia Ply Ltd", "x0": 0.3373626373626374, "y0": 0.8368298368298368, "x1": 0.6978021978021978, "y1": 0.8461538461538461}, {"text": "OR", "x0": 0.4846153846153846, "y0": 0.8679098679098679, "x1": 0.5142857142857142, "y1": 0.878010878010878}], [{"text": "Question 2 (b) \u2014 Prose Fiction - Mark Haddon, The Curious Incident of the Dog in the", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.8703296703296703, "y1": 0.0947940947940948}, {"text": "Night-time (20 marks)", "x0": 0.2725274725274725, "y0": 0.09867909867909867, "x1": 0.45604395604395603, "y1": 0.11188811188811189}, {"text": "\u2018Analyse how the central ideas of The Curious Incident of the Dog in the Night-time are", "x0": 0.11868131868131868, "y0": 0.1320901320901321, "x1": 0.8802197802197802, "y1": 0.1452991452991453}, {"text": "explored through the distinctive qualities of the text.", "x0": 0.11868131868131868, "y0": 0.14840714840714841, "x1": 0.5428571428571428, "y1": 0.16161616161616163}, {"text": "In your response, make detailed reference to the extract below and your prescribed text.", "x0": 0.11868131868131868, "y0": 0.18181818181818182, "x1": 0.8307692307692308, "y1": 0.19502719502719504}, {"text": "Published by Random House UK in 2014 \u2014 ISBN: 9781782953463", "x0": 0.31868131868131866, "y0": 0.6752136752136753, "x1": 0.7615384615384615, "y1": 0.6853146853146853}, {"text": "[In the bus ... they had a good day or a bad day]", "x0": 0.43956043956043955, "y0": 0.6783216783216783, "x1": 0.7615384615384615, "y1": 0.7008547008547008}, {"text": "OR", "x0": 0.4846153846153846, "y0": 0.7319347319347319, "x1": 0.5142857142857142, "y1": 0.7428127428127428}], [{"text": "Question 2 (c) \u2014 Poetry - Robert Gray, Coast Road (20 marks)", "x0": 0.11978021978021978, "y0": 0.08158508158508158, "x1": 0.6593406593406593, "y1": 0.0947940947940948}, {"text": "\u2018Analyse how the central ideas of Gray's poetry are explored through the distinctive qualities", "x0": 0.11868131868131868, "y0": 0.11499611499611499, "x1": 0.8791208791208791, "y1": 0.1282051282051282}, {"text": "of the poems.", "x0": 0.11978021978021978, "y0": 0.1320901320901321, "x1": 0.22747252747252747, "y1": 0.1452991452991453}, {"text": "In your response, make detailed reference to the extract below and at least ONE other", "x0": 0.11978021978021978, "y0": 0.1655011655011655, "x1": 0.8802197802197802, "y1": 0.17871017871017872}, {"text": "prescribed poem.", "x0": 0.11868131868131868, "y0": 0.18181818181818182, "x1": 0.2571428571428571, "y1": 0.19502719502719504}, {"text": "She and I came wandering there through an empty park,", "x0": 0.2725274725274725, "y0": 0.21212121212121213, "x1": 0.7263736263736263, "y1": 0.22533022533022534}, {"text": "and we laid our hands on a stone parapet\u2019s", "x0": 0.2714285714285714, "y0": 0.23076923076923078, "x1": 0.6164835164835165, "y1": 0.24397824397824397}, {"text": "fading life, Before us, across the oily, aubergine dark", "x0": 0.2725274725274725, "y0": 0.2501942501942502, "x1": 0.7021978021978021, "y1": 0.2634032634032634}, {"text": "of the harbour, we could make out yachts \u2014", "x0": 0.26703296703296703, "y0": 0.2602952602952603, "x1": 0.634065934065934, "y1": 0.2867132867132867}, {"text": "beneath an overcast sky, that was mauve underlit,", "x0": 0.2714285714285714, "y0": 0.2999222999222999, "x1": 0.6736263736263737, "y1": 0.31313131313131315}, {"text": "against a far shore of dark, crumbling bush.", "x0": 0.2714285714285714, "y0": 0.3185703185703186, "x1": 0.6241758241758242, "y1": 0.3317793317793318}, {"text": "Part of the city, to our left, was fruit shop bright.", "x0": 0.2725274725274725, "y0": 0.3348873348873349, "x1": 0.6659340659340659, "y1": 0.3543123543123543}, {"text": "After the summer day, a huge, moist hush.", "x0": 0.2714285714285714, "y0": 0.35664335664335667, "x1": 0.6153846153846154, "y1": 0.36985236985236986}, {"text": "\u201cHarbour Dusk\u2019, Coast Road by Robert Gray (Black Ine. 2014)", "x0": 0.389010989010989, "y0": 0.38461538461538464, "x1": 0.7263736263736263, "y1": 0.39316239316239315}, {"text": "The prescribed poems are:", "x0": 0.11868131868131868, "y0": 0.4094794094794095, "x1": 0.33186813186813185, "y1": 0.4226884226884227}, {"text": "RE", "x0": 0.11978021978021978, "y0": 0.43278943278943277, "x1": 0.12747252747252746, "y1": 0.45454545454545453}, {"text": "Journey, the North Coast", "x0": 0.14285714285714285, "y0": 0.43356643356643354, "x1": 0.34725274725274724, "y1": 0.445998445998446}, {"text": "Flames and Dangling Wire", "x0": 0.14285714285714285, "y0": 0.4491064491064491, "x1": 0.3637362637362637, "y1": 0.46231546231546233}, {"text": "Harbour Dusk", "x0": 0.14285714285714285, "y0": 0.4662004662004662, "x1": 0.26043956043956046, "y1": 0.4763014763014763}, {"text": "Byron Bay: Winter", "x0": 0.14285714285714285, "y0": 0.48329448329448327, "x1": 0.2967032967032967, "y1": 0.4933954933954934}, {"text": "Description of a Walk", "x0": 0.14285714285714285, "y0": 0.4996114996114996, "x1": 0.3208791208791209, "y1": 0.5128205128205128}, {"text": "24 Poems", "x0": 0.14285714285714285, "y0": 0.5167055167055167, "x1": 0.22087912087912087, "y1": 0.526029526029526}, {"text": "OR", "x0": 0.4846153846153846, "y0": 0.5578865578865578, "x1": 0.5142857142857142, "y1": 0.567987567987568}], [{"text": "Question 2 (d) \u2014 Poetry - Oodgeroo Noonuccal (20 marks)", "x0": 0.11978021978021978, "y0": 0.08158508158508158, "x1": 0.6252747252747253, "y1": 0.0947940947940948}, {"text": "Analyse how the central ideas of Noonuccal\u2019s poetry are explored through the distinctive", "x0": 0.11978021978021978, "y0": 0.11499611499611499, "x1": 0.8791208791208791, "y1": 0.1282051282051282}, {"text": "qualities of the poems.", "x0": 0.11868131868131868, "y0": 0.1320901320901321, "x1": 0.3010989010989011, "y1": 0.1452991452991453}, {"text": "In your response, make detailed reference to the extract below and at least ONE other", "x0": 0.11978021978021978, "y0": 0.1655011655011655, "x1": 0.8802197802197802, "y1": 0.17871017871017872}, {"text": "prescribed poem.", "x0": 0.11868131868131868, "y0": 0.18181818181818182, "x1": 0.2571428571428571, "y1": 0.19502719502719504}, {"text": "For 2,000 years", "x0": 0.35714285714285715, "y0": 0.2128982128982129, "x1": 0.4824175824175824, "y1": 0.22533022533022534}, {"text": "The Earth Mother", "x0": 0.35714285714285715, "y0": 0.22921522921522922, "x1": 0.5021978021978022, "y1": 0.23853923853923853}, {"text": "Nursed her son,", "x0": 0.35714285714285715, "y0": 0.24553224553224554, "x1": 0.4835164835164835, "y1": 0.2564102564102564}, {"text": "Until", "x0": 0.35824175824175825, "y0": 0.2618492618492618, "x1": 0.3967032967032967, "y1": 0.27195027195027194}, {"text": "By chance,", "x0": 0.35714285714285715, "y0": 0.27972027972027974, "x1": 0.4461538461538462, "y1": 0.2905982905982906}, {"text": "A pick and shovel,", "x0": 0.35274725274725277, "y0": 0.28826728826728826, "x1": 0.5076923076923077, "y1": 0.31157731157731156}, {"text": "Revealed his secret.", "x0": 0.35714285714285715, "y0": 0.31157731157731156, "x1": 0.5164835164835165, "y1": 0.32167832167832167}, {"text": "The earth opened up", "x0": 0.35714285714285715, "y0": 0.32944832944832947, "x1": 0.5230769230769231, "y1": 0.3418803418803419}, {"text": "And exposed to the world,", "x0": 0.35714285714285715, "y0": 0.3457653457653458, "x1": 0.5703296703296703, "y1": 0.3581973581973582}, {"text": "His fear,", "x0": 0.35714285714285715, "y0": 0.3620823620823621, "x1": 0.421978021978022, "y1": 0.37218337218337216}, {"text": "His insecurity.", "x0": 0.35714285714285715, "y0": 0.37839937839937837, "x1": 0.4736263736263736, "y1": 0.3916083916083916}, {"text": "(from Entombed Warriors)", "x0": 0.42417582417582417, "y0": 0.4094794094794095, "x1": 0.6417582417582418, "y1": 0.4219114219114219}, {"text": "The prescribed poems are:", "x0": 0.11868131868131868, "y0": 0.432012432012432, "x1": 0.33186813186813185, "y1": 0.4444444444444444}, {"text": "* The Past", "x0": 0.11978021978021978, "y0": 0.45454545454545453, "x1": 0.21428571428571427, "y1": 0.46464646464646464}, {"text": "* China... Woman", "x0": 0.11978021978021978, "y0": 0.4716394716394716, "x1": 0.2835164835164835, "y1": 0.48174048174048173}, {"text": "* Reed Flute Cave", "x0": 0.11978021978021978, "y0": 0.48795648795648794, "x1": 0.27692307692307694, "y1": 0.49805749805749805}, {"text": "* Entombed Warriors", "x0": 0.11978021978021978, "y0": 0.5050505050505051, "x1": 0.3032967032967033, "y1": 0.5151515151515151}, {"text": "* Visit to Sun Yat-Sen Memorial Hall", "x0": 0.11978021978021978, "y0": 0.5213675213675214, "x1": 0.4307692307692308, "y1": 0.5314685314685315}, {"text": "x (\u00a9 Kath Walker ((A.K.A. Oodgeroo Noonuccal),", "x0": 0.11978021978021978, "y0": 0.5337995337995338, "x1": 0.7494505494505495, "y1": 0.5439005439005439}, {"text": "Sunrise on Huampu River The Entombed Warriors, Kath Walker in China,", "x0": 0.14285714285714285, "y0": 0.5384615384615384, "x1": 0.7494505494505495, "y1": 0.554001554001554}, {"text": "A Lake Within a Lake Press.", "x0": 0.14175824175824175, "y0": 0.5547785547785548, "x1": 0.7472527472527473, "y1": 0.5648795648795649}, {"text": "*", "x0": 0.11978021978021978, "y0": 0.5555555555555556, "x1": 0.12747252747252746, "y1": 0.560994560994561}, {"text": "OR", "x0": 0.4846153846153846, "y0": 0.5967365967365967, "x1": 0.5142857142857142, "y1": 0.6068376068376068}], [{"text": "Question 2 (e) \u2014 Drama Scott Rankin, Namatjira (20 marks)", "x0": 0.11978021978021978, "y0": 0.08158508158508158, "x1": 0.6538461538461539, "y1": 0.0947940947940948}, {"text": "\u2018Analyse how the central ideas of Namatjira are explored through the distinctive qualities of", "x0": 0.11868131868131868, "y0": 0.11499611499611499, "x1": 0.8824175824175824, "y1": 0.1282051282051282}, {"text": "the text.", "x0": 0.11978021978021978, "y0": 0.1320901320901321, "x1": 0.1824175824175824, "y1": 0.14219114219114218}, {"text": "In your response, make detailed reference to the extract below and your prescribed text.", "x0": 0.11978021978021978, "y0": 0.1655011655011655, "x1": 0.8307692307692308, "y1": 0.17871017871017872}, {"text": "Trevor: So there was Albert, between two worlds. Name changed.", "x0": 0.21868131868131868, "y0": 0.1958041958041958, "x1": 0.7791208791208791, "y1": 0.20901320901320902}, {"text": "Not a man, not a boy. Following his heart western way,", "x0": 0.3054945054945055, "y0": 0.21212121212121213, "x1": 0.7791208791208791, "y1": 0.22533022533022534}, {"text": "wrong-way marriage. Speaking Aranda, German, bit of", "x0": 0.3054945054945055, "y0": 0.22843822843822845, "x1": 0.7824175824175824, "y1": 0.24164724164724163}, {"text": "English. He\u2019s an evangelist, choir, bushman. Growing", "x0": 0.3054945054945055, "y0": 0.24553224553224554, "x1": 0.7802197802197802, "y1": 0.25874125874125875}, {"text": "family, poor, no house, nothing. My, hasn\u2019t the world", "x0": 0.3054945054945055, "y0": 0.2618492618492618, "x1": 0.7802197802197802, "y1": 0.27505827505827507}, {"text": "changed?", "x0": 0.3054945054945055, "y0": 0.2789432789432789, "x1": 0.3791208791208791, "y1": 0.29215229215229216}, {"text": "A Model T Ford arrives.", "x0": 0.3274725274725275, "y0": 0.30536130536130535, "x1": 0.5252747252747253, "y1": 0.31546231546231546}, {"text": "Then one day into the mission comes this angry mechanical", "x0": 0.30439560439560437, "y0": 0.33255633255633255, "x1": 0.7791208791208791, "y1": 0.3457653457653458}, {"text": "ant. And from its belly climbs this strange little man ... and", "x0": 0.3054945054945055, "y0": 0.34887334887334887, "x1": 0.7802197802197802, "y1": 0.3620823620823621}, {"text": "he walks funny, like a bird.", "x0": 0.3054945054945055, "y0": 0.36596736596736595, "x1": 0.5252747252747253, "y1": 0.3791763791763792}, {"text": "MISSION MEN gather, aroused, whispering.", "x0": 0.32857142857142857, "y0": 0.3923853923853924, "x1": 0.6978021978021978, "y1": 0.40559440559440557}, {"text": "Aiyua untjwarra era pitjika/", "x0": 0.3032967032967033, "y0": 0.4188034188034188, "x1": 0.5340659340659341, "y1": 0.432012432012432}, {"text": "MAN:", "x0": 0.21978021978021978, "y0": 0.4195804195804196, "x1": 0.26263736263736265, "y1": 0.4289044289044289}, {"text": "Alte reiher mann ist gekommen/", "x0": 0.30439560439560437, "y0": 0.445998445998446, "x1": 0.567032967032967, "y1": 0.4592074592074592}, {"text": "MAN:", "x0": 0.21978021978021978, "y0": 0.4467754467754468, "x1": 0.26263736263736265, "y1": 0.4560994560994561}, {"text": "Aiyua untjwarra era pitjika/", "x0": 0.3032967032967033, "y0": 0.47241647241647244, "x1": 0.5340659340659341, "y1": 0.48562548562548563}, {"text": "MAN:", "x0": 0.21978021978021978, "y0": 0.4731934731934732, "x1": 0.26263736263736265, "y1": 0.4825174825174825}, {"text": "Old Heron Man has come.", "x0": 0.3054945054945055, "y0": 0.4996114996114996, "x1": 0.5186813186813187, "y1": 0.5097125097125097}, {"text": "MAN:", "x0": 0.21978021978021978, "y0": 0.5003885003885004, "x1": 0.26263736263736265, "y1": 0.5097125097125097}, {"text": "REX steps from the car, moving like a heron.", "x0": 0.32857142857142857, "y0": 0.526029526029526, "x1": 0.6956043956043956, "y1": 0.5392385392385393}, {"text": "Extract from Namatjira \u00a9 Scott Rankin is reproduced", "x0": 0.46813186813186813, "y0": 0.5516705516705517, "x1": 0.7791208791208791, "y1": 0.560994560994561}, {"text": "with the permission of the publisher, Currency Press", "x0": 0.46923076923076923, "y0": 0.5633255633255633, "x1": 0.7791208791208791, "y1": 0.5726495726495726}, {"text": "OR", "x0": 0.4846153846153846, "y0": 0.5990675990675991, "x1": 0.5142857142857142, "y1": 0.6091686091686092}], [{"text": "Question 2 (f) \u2014 Drama - William Shakespeare, A Midsummer Night\u2019s Dream", "x0": 0.11978021978021978, "y0": 0.08158508158508158, "x1": 0.7934065934065934, "y1": 0.0947940947940948}, {"text": "(20 marks)", "x0": 0.2703296703296703, "y0": 0.09867909867909867, "x1": 0.35714285714285715, "y1": 0.11188811188811189}, {"text": "\u2018Analyse how the central ideas of A Midsummer Night\u2019s Dream are explored through the", "x0": 0.11868131868131868, "y0": 0.12354312354312354, "x1": 0.8791208791208791, "y1": 0.14996114996114995}, {"text": "distinctive qualities of the text.", "x0": 0.11978021978021978, "y0": 0.13986013986013987, "x1": 0.36813186813186816, "y1": 0.16627816627816627}, {"text": "In your response, make detailed reference to the extract below and your prescribed text.", "x0": 0.11978021978021978, "y0": 0.18181818181818182, "x1": 0.8307692307692308, "y1": 0.19502719502719504}, {"text": "Enter PUCK.", "x0": 0.4032967032967033, "y0": 0.216006216006216, "x1": 0.5142857142857142, "y1": 0.2261072261072261}, {"text": "PUCK What hempen homespuns have we swaggering here", "x0": 0.1912087912087912, "y0": 0.2463092463092463, "x1": 0.7395604395604396, "y1": 0.2595182595182595}, {"text": "So near the cradle of the Fairy Queen?", "x0": 0.3208791208791209, "y0": 0.2602952602952603, "x1": 0.6329670329670329, "y1": 0.28593628593628595}, {"text": "What, a play toward? I'll be an auditor,", "x0": 0.3208791208791209, "y0": 0.2867132867132867, "x1": 0.6395604395604395, "y1": 0.2999222999222999}, {"text": "An actor too perhaps, if I see cause.", "x0": 0.31978021978021975, "y0": 0.3061383061383061, "x1": 0.6098901098901099, "y1": 0.31934731934731936}, {"text": "QUINCE Pyramus! Thisbe, stand forth!", "x0": 0.1912087912087912, "y0": 0.3247863247863248, "x1": 0.5989010989010989, "y1": 0.337995337995338}, {"text": "BOTTOM (as Pyramus)", "x0": 0.1912087912087912, "y0": 0.3442113442113442, "x1": 0.3879120879120879, "y1": 0.35742035742035744}, {"text": "Thisbe, the flowers of odious savours sweet \u2014", "x0": 0.3, "y0": 0.3628593628593629, "x1": 0.6714285714285714, "y1": 0.3752913752913753}, {"text": "QUINCE \u2014Odours ~ \u2018odorous\u2019!", "x0": 0.1912087912087912, "y0": 0.3822843822843823, "x1": 0.46263736263736266, "y1": 0.3947163947163947}, {"text": "BOTTOM (as Pyramus) ss", "x0": 0.1912087912087912, "y0": 0.40093240093240096, "x1": 0.6296703296703297, "y1": 0.41414141414141414}, {"text": "So hath thy breath, my dearest Thisbe dear.", "x0": 0.3208791208791209, "y0": 0.4195804195804196, "x1": 0.6714285714285714, "y1": 0.43278943278943277}, {"text": "But hark, a voice! Stay thou but here awhile,", "x0": 0.3010989010989011, "y0": 0.439005439005439, "x1": 0.6626373626373626, "y1": 0.4522144522144522}, {"text": "And by and by I will to thee appear. Exit", "x0": 0.31978021978021975, "y0": 0.45765345765345766, "x1": 0.8087912087912088, "y1": 0.47086247086247085}, {"text": "PUCK A stranger Pyramus than e\u2019er played here. [Exit]", "x0": 0.1912087912087912, "y0": 0.47707847707847706, "x1": 0.8076923076923077, "y1": 0.4902874902874903}, {"text": "OR", "x0": 0.4846153846153846, "y0": 0.5167055167055167, "x1": 0.5142857142857142, "y1": 0.5268065268065268}, {"text": "Question 2 (g) \u2014 Nonfiction - Anna Funder, Stasiland (20 marks)", "x0": 0.11978021978021978, "y0": 0.5586635586635587, "x1": 0.6813186813186813, "y1": 0.5718725718725719}, {"text": "\u2018Analyse how the central ideas of Stasiland are explored through the distinctive qualities of the", "x0": 0.11868131868131868, "y0": 0.5920745920745921, "x1": 0.8791208791208791, "y1": 0.6052836052836053}, {"text": "text.", "x0": 0.11978021978021978, "y0": 0.6107226107226107, "x1": 0.15274725274725276, "y1": 0.6192696192696193}, {"text": "In your response, make detailed reference to the extract below and your prescribed text.", "x0": 0.11978021978021978, "y0": 0.6425796425796426, "x1": 0.8307692307692308, "y1": 0.6557886557886557}, {"text": "\u2018Just a moment,\u201d he says. \u2018It is hard for you to understand. Without", "x0": 0.2153846153846154, "y0": 0.6728826728826729, "x1": 0.8087912087912088, "y1": 0.6860916860916861}, {"text": "understanding my childhood, you can\u2019t see why anyone would want to join", "x0": 0.1912087912087912, "y0": 0.6891996891996892, "x1": 0.8076923076923077, "y1": 0.7024087024087025}, {"text": "the Stasi.\u201d", "x0": 0.1912087912087912, "y0": 0.7055167055167055, "x1": 0.2692307692307692, "y1": 0.7156177156177156}, {"text": "This isn\u2019t quite true. I have given a lot of thought to why people would", "x0": 0.21428571428571427, "y0": 0.7327117327117327, "x1": 0.8087912087912088, "y1": 0.745920745920746}, {"text": "want to join. In a society riven into \u2018us\u2019 and \u2018them\u2019, an ambitious young", "x0": 0.1912087912087912, "y0": 0.749028749028749, "x1": 0.8087912087912088, "y1": 0.7622377622377622}, {"text": "person might well want to be one of the group in the know, one of the", "x0": 0.1901098901098901, "y0": 0.7661227661227661, "x1": 0.8076923076923077, "y1": 0.7793317793317793}, {"text": "unmolested. If there was never going to be an end to your country, and you", "x0": 0.1912087912087912, "y0": 0.7824397824397824, "x1": 0.8076923076923077, "y1": 0.7956487956487956}, {"text": "could never leave, why wouldn\u2019t you opt for a peaceful life and a satisfying", "x0": 0.1912087912087912, "y0": 0.7995337995337995, "x1": 0.8087912087912088, "y1": 0.8127428127428128}, {"text": "career? What interests me is the process of dealing with that decision now", "x0": 0.1912087912087912, "y0": 0.8158508158508159, "x1": 0.8076923076923077, "y1": 0.8290598290598291}, {"text": "that it is all over. Can you rework your past, the grit that rubs in you, until it", "x0": 0.1912087912087912, "y0": 0.8329448329448329, "x1": 0.8087912087912088, "y1": 0.8461538461538461}, {"text": "is shiny and smooth as a pearl?", "x0": 0.1912087912087912, "y0": 0.8492618492618492, "x1": 0.44285714285714284, "y1": 0.8624708624708625}, {"text": "\u00a9 Stasiland, Anna Funder", "x0": 0.6527472527472528, "y0": 0.8663558663558664, "x1": 0.8065934065934066, "y1": 0.8749028749028749}], [{"text": "Question 2 (h) \u2014 Film - Peter Weir, The Truman Show (20 marks)", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.6912087912087912, "y1": 0.0947940947940948}, {"text": "Analyse how the central ideas of The Truman Show are explored through the distinctive", "x0": 0.11868131868131868, "y0": 0.11499611499611499, "x1": 0.8802197802197802, "y1": 0.1282051282051282}, {"text": "qualities of the text.", "x0": 0.11868131868131868, "y0": 0.1320901320901321, "x1": 0.27912087912087913, "y1": 0.1452991452991453}, {"text": "In your response, make detailed reference to the extracts below and your prescribed text.", "x0": 0.11868131868131868, "y0": 0.1655011655011655, "x1": 0.8384615384615385, "y1": 0.17871017871017872}, {"text": "OR", "x0": 0.4846153846153846, "y0": 0.8407148407148407, "x1": 0.5142857142857142, "y1": 0.8515928515928516}, {"text": "\u201410-", "x0": 0.4736263736263736, "y0": 0.9432789432789432, "x1": 0.5252747252747253, "y1": 0.9533799533799534}], [{"text": "Question 2 (i) \u2014 Media - Simon Nasht, Frank Hurley: The Man Who Made History", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.8340659340659341, "y1": 0.0947940947940948}, {"text": "(20 marks)", "x0": 0.2681318681318681, "y0": 0.09867909867909867, "x1": 0.35494505494505496, "y1": 0.11188811188811189}, {"text": "\u2018Analyse how the central ideas of Frank Hurley: The Man Who Made History are explored", "x0": 0.11868131868131868, "y0": 0.1320901320901321, "x1": 0.8802197802197802, "y1": 0.1452991452991453}, {"text": "through the distinctive qualities of the text.", "x0": 0.11868131868131868, "y0": 0.14840714840714841, "x1": 0.46703296703296704, "y1": 0.16161616161616163}, {"text": "In your response, make detailed reference to the extracts below and your prescribed text.", "x0": 0.11978021978021978, "y0": 0.18181818181818182, "x1": 0.8384615384615385, "y1": 0.19502719502719504}, {"text": "Voice over: Hurley\u2019s response was to use his darkroom skills to combine", "x0": 0.18571428571428572, "y0": 0.46076146076146074, "x1": 0.8131868131868132, "y1": 0.473970473970474}, {"text": "photos ina single dramatic picture. But this time his manipulations", "x0": 0.2978021978021978, "y0": 0.4693084693084693, "x1": 0.8131868131868132, "y1": 0.49572649572649574}, {"text": "would lead to bitter conflict.", "x0": 0.2978021978021978, "y0": 0.49417249417249415, "x1": 0.5274725274725275, "y1": 0.5042735042735043}, {"text": "Voice over: But others aren\u2019t so impressed. The curator of Australia\u2019s war", "x0": 0.189010989010989, "y0": 0.7777777777777778, "x1": 0.8, "y1": 0.790986790986791}, {"text": "time photo archives believes Hurley\u2019s manipulations have", "x0": 0.2989010989010989, "y0": 0.7948717948717948, "x1": 0.765934065934066, "y1": 0.8080808080808081}, {"text": "undermined their historic value.", "x0": 0.3, "y0": 0.811965811965812, "x1": 0.554945054945055, "y1": 0.822066822066822}, {"text": "End of Section II", "x0": 0.42637362637362636, "y0": 0.8756798756798757, "x1": 0.5725274725274725, "y1": 0.8865578865578866}, {"text": "Please turn over", "x0": 0.42967032967032964, "y0": 0.9098679098679099, "x1": 0.5703296703296703, "y1": 0.9199689199689199}], [{"text": "Section III \u2014 Module C: The Craft of Writing", "x0": 0.11978021978021978, "y0": 0.08236208236208237, "x1": 0.589010989010989, "y1": 0.0979020979020979}, {"text": "20 marks", "x0": 0.11868131868131868, "y0": 0.11732711732711733, "x1": 0.1989010989010989, "y1": 0.12742812742812742}, {"text": "Attempt Question 3", "x0": 0.11868131868131868, "y0": 0.13364413364413363, "x1": 0.2879120879120879, "y1": 0.14685314685314685}, {"text": "Allow about 40 minutes for this section", "x0": 0.11868131868131868, "y0": 0.15073815073815075, "x1": 0.45604395604395603, "y1": 0.16083916083916083}, {"text": "\u2018Answer the question on pages 18-24 of the Paper 2 Writing Booklet. Extra writing booklets", "x0": 0.11868131868131868, "y0": 0.18337218337218336, "x1": 0.8791208791208791, "y1": 0.19658119658119658}, {"text": "are available.", "x0": 0.11978021978021978, "y0": 0.20046620046620048, "x1": 0.22527472527472528, "y1": 0.21056721056721056}, {"text": "Your answer will be assessed on how well you:", "x0": 0.14395604395604394, "y0": 0.23076923076923078, "x1": 0.5274725274725275, "y1": 0.24397824397824397}, {"text": "craft language to address the demands of the question", "x0": 0.16703296703296702, "y0": 0.2501942501942502, "x1": 0.6021978021978022, "y1": 0.2634032634032634}, {"text": "use language appropriate to audience, purpose and form to shape meaning", "x0": 0.16703296703296702, "y0": 0.2703962703962704, "x1": 0.7681318681318682, "y1": 0.2836052836052836}, {"text": "Question 3 (20 marks)", "x0": 0.11978021978021978, "y0": 0.3162393162393162, "x1": 0.30439560439560437, "y1": 0.32944832944832947}, {"text": "There is something stubborn about taste, something homebound, almost", "x0": 0.1901098901098901, "y0": 0.3442113442113442, "x1": 0.8076923076923077, "y1": 0.35742035742035744}, {"text": "old-fashioned. It\u2019s like taste has not quite caught up with our modern world", "x0": 0.1901098901098901, "y0": 0.3613053613053613, "x1": 0.8076923076923077, "y1": 0.3745143745143745}, {"text": "where you Zoom into a city with one click. Taste is something you just can\u2019t", "x0": 0.1912087912087912, "y0": 0.3745143745143745, "x1": 0.8087912087912088, "y1": 0.3939393939393939}, {"text": "do at a distance. You almost have to be up close ... And taste, of course,", "x0": 0.1901098901098901, "y0": 0.3947163947163947, "x1": 0.8076923076923077, "y1": 0.40792540792540793}, {"text": "brings us close. So today on the show, we've got two stories about just how", "x0": 0.1901098901098901, "y0": 0.411033411033411, "x1": 0.8076923076923077, "y1": 0.42424242424242425}, {"text": "far our longing for taste can take us, from the snacks that transport us around", "x0": 0.1912087912087912, "y0": 0.4281274281274281, "x1": 0.8076923076923077, "y1": 0.44133644133644134}, {"text": "the world ... to the dishes that bring us back home.", "x0": 0.1912087912087912, "y0": 0.4444444444444444, "x1": 0.6054945054945055, "y1": 0.45765345765345766}, {"text": "Extract from podcast, Tasting at a Distance", "x0": 0.45494505494505494, "y0": 0.4716394716394716, "x1": 0.8076923076923077, "y1": 0.48484848484848486}, {"text": "(\u00a92021 National Public Radio, Inc. Excerpt from podcast episode titled \u201cTasting At A Distance\u201d", "x0": 0.25164835164835164, "y0": 0.48717948717948717, "x1": 0.8076923076923077, "y1": 0.508935508935509}, {"text": "\u2018was originally broadcast on NPR's Rough Translation on December 8, 2021,", "x0": 0.35384615384615387, "y0": 0.5058275058275058, "x1": 0.8065934065934066, "y1": 0.5151515151515151}, {"text": "and is used with the permission of NPR. Any unauthorized duplication is strictly prohibited", "x0": 0.2725274725274725, "y0": 0.5167055167055167, "x1": 0.8032967032967033, "y1": 0.526029526029526}, {"text": "Describe how ideas about the power of taste are conveyed in this podcast. In", "x0": 0.16703296703296702, "y0": 0.5501165501165501, "x1": 0.8076923076923077, "y1": 0.5633255633255633}, {"text": "w", "x0": 0.8703296703296703, "y0": 0.5501165501165501, "x1": 0.8791208791208791, "y1": 0.5602175602175602}, {"text": "(a)", "x0": 0.11978021978021978, "y0": 0.5508935508935509, "x1": 0.14065934065934066, "y1": 0.5625485625485626}, {"text": "your response, refer to at least ONE language device or stylistic feature in the", "x0": 0.16703296703296702, "y0": 0.5664335664335665, "x1": 0.8076923076923077, "y1": 0.5796425796425796}, {"text": "extract.", "x0": 0.16703296703296702, "y0": 0.5843045843045843, "x1": 0.22527472527472528, "y1": 0.5928515928515928}, {"text": "(b)", "x0": 0.11978021978021978, "y0": 0.6161616161616161, "x1": 0.14175824175824175, "y1": 0.6285936285936286}, {"text": "Craft an imaginative or discursive piece of writing that explores the power of", "x0": 0.16703296703296702, "y0": 0.6161616161616161, "x1": 0.810989010989011, "y1": 0.6293706293706294}, {"text": "15", "x0": 0.8615384615384616, "y0": 0.6161616161616161, "x1": 0.8791208791208791, "y1": 0.6262626262626263}, {"text": "the senses, In your composition, you should emphasise ONE of the five senses", "x0": 0.16703296703296702, "y0": 0.6332556332556333, "x1": 0.8076923076923077, "y1": 0.6464646464646465}, {"text": "(sight, smell, sound, taste OR touch).", "x0": 0.16703296703296702, "y0": 0.6495726495726496, "x1": 0.46703296703296704, "y1": 0.6627816627816627}, {"text": "End of paper", "x0": 0.44285714285714284, "y0": 0.7171717171717171, "x1": 0.5560439560439561, "y1": 0.7303807303807304}, {"text": "(\u00a9 2022 NSW Edueation Standards Authority", "x0": 0.3824175824175824, "y0": 0.9673659673659674, "x1": 0.6164835164835165, "y1": 0.9751359751359752}]]