[[{"text": "Physics Trial HSC Examination Cranbrook 2002 ERRATA", "x0": 0.054945054945054944, "y0": 0.058365758754863814, "x1": 0.5351648351648352, "y1": 0.07392996108949416}, {"text": "Page 3 Q 6 option (D) should read: electric currents cause interaction of two magnetic fields.", "x0": 0.054945054945054944, "y0": 0.08949416342412451, "x1": 0.8021978021978022, "y1": 0.1066147859922179}, {"text": "Page 7 Part B \u2014 85 marks not 75", "x0": 0.054945054945054944, "y0": 0.11673151750972763, "x1": 0.3131868131868132, "y1": 0.1431906614785992}, {"text": "Page 14 Q 23 (5 marks) part b is 2 marks Page 16 Q 25 (3 marks) part a is 2 marks", "x0": 0.051648351648351645, "y0": 0.14785992217898833, "x1": 0.8065934065934066, "y1": 0.17665369649805449}, {"text": "Page 20 Q 28 c Table first row for KE should be 0.80", "x0": 0.056043956043956046, "y0": 0.18988326848249026, "x1": 0.4835164835164835, "y1": 0.20389105058365758}, {"text": "CRANBROOK SCHOOL", "x0": 0.3813186813186813, "y0": 0.23735408560311283, "x1": 0.6395604395604395, "y1": 0.2529182879377432}, {"text": "YEAR 12 TRIAL HSC EXAMINATION", "x0": 0.3087912087912088, "y0": 0.2793774319066148, "x1": 0.7142857142857143, "y1": 0.29571984435797666}, {"text": "2. UNIT HSC COURSE", "x0": 0.3967032967032967, "y0": 0.31906614785992216, "x1": 0.6274725274725275, "y1": 0.3431906614785992}, {"text": "2002", "x0": 0.489010989010989, "y0": 0.34552529182879377, "x1": 0.5362637362637362, "y1": 0.35797665369649806}, {"text": ".", "x0": 0.1813186813186813, "y0": 0.39455252918287936, "x1": 0.189010989010989, "y1": 0.4}, {"text": "Physics", "x0": 0.0967032967032967, "y0": 0.3953307392996109, "x1": 0.22417582417582418, "y1": 0.421011673151751}, {"text": "General Instructions \u2018Total marks - 100", "x0": 0.09340659340659341, "y0": 0.45058365758754865, "x1": 0.7, "y1": 0.4801556420233463}, {"text": "\u00a9 time - 3 hours", "x0": 0.1, "y0": 0.49883268482490273, "x1": 0.31978021978021975, "y1": 0.5190661478599222}, {"text": "\u00a9 calculators may be used \u2018There are two parts, Part A and", "x0": 0.1, "y0": 0.5097276264591439, "x1": 0.798901098901099, "y1": 0.5408560311284046}, {"text": "\u00a9 Write using blue or black pen Part B", "x0": 0.1010989010989011, "y0": 0.5315175097276265, "x1": 0.5967032967032967, "y1": 0.5595330739299611}, {"text": "Draw diagrams using pencil", "x0": 0.12417582417582418, "y0": 0.5595330739299611, "x1": 0.35934065934065934, "y1": 0.5797665369649806}, {"text": "A Data Sheet and Formulae Sheets are Part A\u2014 15 marks", "x0": 0.1010989010989011, "y0": 0.5688715953307393, "x1": 0.6989010989010989, "y1": 0.6007782101167315}, {"text": "provided at the back of this paper : Attempt Questions 1 - 15", "x0": 0.12637362637362637, "y0": 0.5875486381322957, "x1": 0.7802197802197802, "y1": 0.6217898832684825}, {"text": "\u00a9 Write your Student Number at the top of the Allow about 30 minutes for this part", "x0": 0.1010989010989011, "y0": 0.6077821011673151, "x1": 0.8758241758241758, "y1": 0.6381322957198443}, {"text": "pages indicated", "x0": 0.12637362637362637, "y0": 0.6334630350194552, "x1": 0.2571428571428571, "y1": 0.6591439688715953}, {"text": "Part B \u2014 85 marks", "x0": 0.5439560439560439, "y0": 0.6474708171206226, "x1": 0.6934065934065934, "y1": 0.6684824902723735}, {"text": "\u2018\u00a9 Attempt Questions 16-30", "x0": 0.5483516483516484, "y0": 0.6638132295719844, "x1": 0.7824175824175824, "y1": 0.6879377431906615}, {"text": "\u00a9 Allow about 2 hours and 30 minutes for this", "x0": 0.5483516483516484, "y0": 0.6856031128404669, "x1": 0.9340659340659341, "y1": 0.7089494163424125}, {"text": "part", "x0": 0.5791208791208792, "y0": 0.7128404669260701, "x1": 0.6098901098901099, "y1": 0.7252918287937743}, {"text": "The content and format of this paper do not necessarily reflect the content and", "x0": 0.10329670329670329, "y0": 0.8085603112840467, "x1": 0.8857142857142857, "y1": 0.8287937743190662}, {"text": "format of the HSC examination paper.", "x0": 0.10329670329670329, "y0": 0.8350194552529183, "x1": 0.4857142857142857, "y1": 0.8505836575875486}], [{"text": "Part A - 15 marks", "x0": 0.0945054945054945, "y0": 0.05058365758754864, "x1": 0.25384615384615383, "y1": 0.0715953307392996}, {"text": "Attempt Questions 1 - 15", "x0": 0.1, "y0": 0.06536964980544747, "x1": 0.3142857142857143, "y1": 0.08949416342412451}, {"text": "Allow about 30 minutes for this part", "x0": 0.0956043956043956, "y0": 0.08793774319066149, "x1": 0.4153846153846154, "y1": 0.10894941634241245}, {"text": "Use the multiple choice answer sheet.", "x0": 0.1, "y0": 0.12996108949416343, "x1": 0.4010989010989011, "y1": 0.14396887159533073}, {"text": "Select the alternative A, B, C or D that best answers the question. Fill in the response space.", "x0": 0.0967032967032967, "y0": 0.14396887159533073, "x1": 0.8351648351648352, "y1": 0.16575875486381322}, {"text": "1 The slingshot effect is used to increase the speed of a spacecraft as it approaches, swings around", "x0": 0.1021978021978022, "y0": 0.20155642023346304, "x1": 0.9373626373626374, "y1": 0.22568093385214008}, {"text": "and leaves a planet. Which statement is correct?", "x0": 0.15604395604395604, "y0": 0.22334630350194554, "x1": 0.5439560439560439, "y1": 0.2443579766536965}, {"text": "The energy of the planet stays constant.", "x0": 0.2153846153846154, "y0": 0.2614785992217899, "x1": 0.5362637362637362, "y1": 0.28249027237354085}, {"text": "(A)", "x0": 0.16153846153846155, "y0": 0.26536964980544747, "x1": 0.1879120879120879, "y1": 0.2785992217898833}, {"text": "\u2018There is no energy loss or gain for the planet/spacecraft system.", "x0": 0.2153846153846154, "y0": 0.2793774319066148, "x1": 0.734065934065934, "y1": 0.30116731517509726}, {"text": "\u2018The momentum of the planet is constant.", "x0": 0.2153846153846154, "y0": 0.29961089494163423, "x1": 0.5472527472527473, "y1": 0.32062256809338524}, {"text": "\u00a9", "x0": 0.16153846153846155, "y0": 0.3042801556420233, "x1": 0.18681318681318682, "y1": 0.3167315175097276}, {"text": "\u2018The gravitational potential energy of the spacecraft is constant.", "x0": 0.2164835164835165, "y0": 0.31439688715953307, "x1": 0.7252747252747253, "y1": 0.34007782101167316}, {"text": "2 Which of the graphs below best represents the gravitational force as a function of distance?", "x0": 0.1021978021978022, "y0": 0.36964980544747084, "x1": 0.8934065934065935, "y1": 0.3922178988326848}, {"text": "(A)", "x0": 0.15604395604395604, "y0": 0.46926070038910506, "x1": 0.1835164835164835, "y1": 0.48093385214007783}, {"text": "(B)", "x0": 0.5054945054945055, "y0": 0.4708171206225681, "x1": 0.5318681318681319, "y1": 0.4840466926070039}, {"text": "Distance Distance", "x0": 0.4, "y0": 0.5836575875486382, "x1": 0.810989010989011, "y1": 0.6101167315175098}, {"text": "Force Force", "x0": 0.27582417582417584, "y0": 0.6054474708171206, "x1": 0.6582417582417582, "y1": 0.6319066147859922}, {"text": "ran)", "x0": 0.16593406593406593, "y0": 0.6373540856031128, "x1": 0.1912087912087912, "y1": 0.6466926070038911}, {"text": "* Distance Distance", "x0": 0.3945054945054945, "y0": 0.7478599221789883, "x1": 0.8186813186813187, "y1": 0.7618677042801556}], [{"text": "Which of the following conditions must hold in order for a satellite to remain in orbit around the", "x0": 0.15494505494505495, "y0": 0.07704280155642024, "x1": 0.9285714285714286, "y1": 0.09727626459143969}, {"text": "Earth?", "x0": 0.15604395604395604, "y0": 0.10505836575875487, "x1": 0.2087912087912088, "y1": 0.11595330739299611}, {"text": "(A) _ The period of the satellite must equal the period of the Earth\u2019s rotation.", "x0": 0.15714285714285714, "y0": 0.13540856031128404, "x1": 0.7868131868131868, "y1": 0.15953307392996108}, {"text": "(B) The centripetal and gravitational forces on the satellite must be equal in magnitude.", "x0": 0.15824175824175823, "y0": 0.15642023346303502, "x1": 0.8846153846153846, "y1": 0.17587548638132297}, {"text": "(C) There must not be any forces acting on the satellite.", "x0": 0.15824175824175823, "y0": 0.17821011673151751, "x1": 0.6307692307692307, "y1": 0.1953307392996109}, {"text": "(D) The satellite must remain outside the Earth\u2019s gravitational influence.", "x0": 0.15824175824175823, "y0": 0.1961089494163424, "x1": 0.7670329670329671, "y1": 0.2140077821011673}, {"text": "Kepler\u2019s Law of Periods T? = k R\u00ae shows the relationship between the period and the orbital", "x0": 0.15934065934065933, "y0": 0.25214007782101167, "x1": 0.8989010989010989, "y1": 0.2723735408560311}, {"text": "radius of the planet that revolves around the star. The value of k, a constant, can be changed by", "x0": 0.15934065934065933, "y0": 0.2715953307392996, "x1": 0.921978021978022, "y1": 0.29105058365758757}, {"text": "varying the: |", "x0": 0.16043956043956045, "y0": 0.2933852140077821, "x1": 0.2692307692307692, "y1": 0.311284046692607}, {"text": "(A) __ period of the planet.", "x0": 0.16153846153846155, "y0": 0.3276264591439689, "x1": 0.3824175824175824, "y1": 0.3540856031128405}, {"text": "(B) _ ombital radius of the planet.", "x0": 0.16153846153846155, "y0": 0.3463035019455253, "x1": 0.43736263736263736, "y1": 0.3727626459143969}, {"text": "(\u00a9) __ mass of the planet.", "x0": 0.16153846153846155, "y0": 0.3657587548638132, "x1": 0.37142857142857144, "y1": 0.3922178988326848}, {"text": "(D) mass of the star.", "x0": 0.16263736263736264, "y0": 0.38443579766536967, "x1": 0.35274725274725277, "y1": 0.41089494163424123}, {"text": "Satellite communication systems must be flexible to receive messages, respond with data and", "x0": 0.16373626373626374, "y0": 0.44591439688715956, "x1": 0.9120879120879121, "y1": 0.46303501945525294}, {"text": "deal with difficulties. Which of the following statements is false?", "x0": 0.16373626373626374, "y0": 0.4669260700389105, "x1": 0.6879120879120879, "y1": 0.48171206225680935}, {"text": "(A) Communication with satellites and other space probes rely on electromagnetic radiation.", "x0": 0.16483516483516483, "y0": 0.5042801556420233, "x1": 0.932967032967033, "y1": 0.5221789883268483}, {"text": "(B) Sunspot activity can affect the Earth\u2019s magnetic field, which in turn can cause", "x0": 0.16483516483516483, "y0": 0.5245136186770428, "x1": 0.8505494505494505, "y1": 0.5416342412451361}, {"text": "communication problems for satellites.", "x0": 0.22527472527472528, "y0": 0.5455252918287937, "x1": 0.5362637362637362, "y1": 0.5603112840466926}, {"text": "(C) Deep space telecommunications utilise very low radio frequencies to avoid", "x0": 0.16593406593406593, "y0": 0.5626459143968872, "x1": 0.8285714285714286, "y1": 0.5797665369649806}, {"text": "communication problems.", "x0": 0.22527472527472528, "y0": 0.5844357976653697, "x1": 0.4340659340659341, "y1": 0.598443579766537}, {"text": "() Microwaves are the major carriers of data between Earth-based stations and satellites.", "x0": 0.16593406593406593, "y0": 0.6007782101167315, "x1": 0.9142857142857143, "y1": 0.6178988326848249}, {"text": "Two parallel copper wires, carrying electric currents in opposite directions exert a force of", "x0": 0.16593406593406593, "y0": 0.6583657587548638, "x1": 0.8934065934065935, "y1": 0.6770428015564203}, {"text": "repulsion on each other. This is because", "x0": 0.16593406593406593, "y0": 0.6817120622568094, "x1": 0.4857142857142857, "y1": 0.6964980544747081}, {"text": "(A) __ electrons flow out of the wires leave them with net positive charges.", "x0": 0.16703296703296702, "y0": 0.7143968871595331, "x1": 0.7747252747252747, "y1": 0.7377431906614786}, {"text": "(B) __ electrons flow into the wires give them net negative charges.", "x0": 0.16703296703296702, "y0": 0.7315175097276264, "x1": 0.7142857142857143, "y1": 0.7571984435797665}, {"text": "(C) fields radiate at the speed of light.", "x0": 0.16703296703296702, "y0": 0.757976653696498, "x1": 0.5615384615384615, "y1": 0.7735408560311284}, {"text": "(D) currents cause copper to become magnetised.", "x0": 0.16813186813186815, "y0": 0.7766536964980545, "x1": 0.654945054945055, "y1": 0.7922178988326848}], [{"text": "\u2018The direction of the magnetic field at point P in the diagram below is Perpendicular to the wire.", "x0": 0.15164835164835164, "y0": 0.07392996108949416, "x1": 0.9186813186813186, "y1": 0.10583657587548638}, {"text": "7", "x0": 0.0912087912087912, "y0": 0.08326848249027237, "x1": 0.1010989010989011, "y1": 0.0933852140077821}, {"text": "A line of magnetic force passing through P would point", "x0": 0.14835164835164835, "y0": 0.09571984435797666, "x1": 0.5989010989010989, "y1": 0.11828793774319066}, {"text": "downwards into the page.", "x0": 0.2164835164835165, "y0": 0.31361867704280155, "x1": 0.4208791208791209, "y1": 0.32684824902723736}, {"text": "(A)", "x0": 0.15604395604395604, "y0": 0.31439688715953307, "x1": 0.1835164835164835, "y1": 0.32684824902723736}, {"text": "upwards out of the page.", "x0": 0.2164835164835165, "y0": 0.33229571984435796, "x1": 0.41318681318681316, "y1": 0.3463035019455253}, {"text": "@)", "x0": 0.15604395604395604, "y0": 0.333852140077821, "x1": 0.1824175824175824, "y1": 0.3463035019455253}, {"text": "towards the lamp.", "x0": 0.2164835164835165, "y0": 0.35175097276264594, "x1": 0.35934065934065934, "y1": 0.3649805447470817}, {"text": "\u00a9)", "x0": 0.15604395604395604, "y0": 0.35252918287937746, "x1": 0.1824175824175824, "y1": 0.3649805447470817}, {"text": "away from the lamp.", "x0": 0.22197802197802197, "y0": 0.37042801556420235, "x1": 0.3868131868131868, "y1": 0.38443579766536967}, {"text": "@)", "x0": 0.15604395604395604, "y0": 0.37120622568093387, "x1": 0.1835164835164835, "y1": 0.38443579766536967}, {"text": "The turning the ogil of a by, (1) the", "x0": 0.15164835164835164, "y0": 0.422568093385214, "x1": 0.9153846153846154, "y1": 0.4490272373540856}, {"text": "area of the number of gums of tHe -wirgin-the passing", "x0": 0.15714285714285714, "y0": 0.4396887159533074, "x1": 0.8857142857142857, "y1": 0.46926070038910506}, {"text": "through the coil;", "x0": 0.15714285714285714, "y0": 0.4599221789883268, "x1": 0.310989010989011, "y1": 0.4856031128404669}, {"text": "Which one of th\u00e9 fe", "x0": 0.15274725274725276, "y0": 0.5003891050583658, "x1": 0.3978021978021978, "y1": 0.5229571984435798}, {"text": "(A). 1&", "x0": 0.15824175824175823, "y0": 0.5439688715953307, "x1": 0.24395604395604395, "y1": 0.5571984435797666}, {"text": "\u00a9", "x0": 0.15824175824175823, "y0": 0.5836575875486382, "x1": 0.18461538461538463, "y1": 0.5961089494163424}, {"text": "@)", "x0": 0.15824175824175823, "y0": 0.603112840466926, "x1": 0.18571428571428572, "y1": 0.6155642023346304}, {"text": "\u2018The AC induction motors have many advantages over other types of AC motors. However, a", "x0": 0.15714285714285714, "y0": 0.6583657587548638, "x1": 0.9076923076923077, "y1": 0.6739299610894942}, {"text": "main disadvantage of the AC induction motors is that they", "x0": 0.15824175824175823, "y0": 0.6785992217898833, "x1": 0.6285714285714286, "y1": 0.6933852140077821}, {"text": "consume less electrical energy and perform more work.", "x0": 0.21868131868131868, "y0": 0.7167315175097276, "x1": 0.6659340659340659, "y1": 0.7315175097276264}, {"text": "(A)", "x0": 0.15824175824175823, "y0": 0.7182879377431907, "x1": 0.18571428571428572, "y1": 0.7315175097276264}, {"text": "produce high current and unsuitable for domestic use.", "x0": 0.2230769230769231, "y0": 0.7361867704280156, "x1": 0.656043956043956, "y1": 0.7517509727626459}, {"text": "@)", "x0": 0.15824175824175823, "y0": 0.7377431906614786, "x1": 0.18461538461538463, "y1": 0.7509727626459144}, {"text": "uneconomical to manufacture.", "x0": 0.21868131868131868, "y0": 0.756420233463035, "x1": 0.4604395604395604, "y1": 0.7680933852140078}, {"text": "\u00a9", "x0": 0.15824175824175823, "y0": 0.757976653696498, "x1": 0.18571428571428572, "y1": 0.7704280155642024}, {"text": "produce low power and unsuitable for heavy industry.", "x0": 0.21868131868131868, "y0": 0.7750972762645915, "x1": 0.6538461538461539, "y1": 0.7906614785992218}, {"text": "@)", "x0": 0.15824175824175823, "y0": 0.7766536964980545, "x1": 0.18571428571428572, "y1": 0.7898832684824902}, {"text": "A transformer operates according to the principle of", "x0": 0.15824175824175823, "y0": 0.8342412451361868, "x1": 0.578021978021978, "y1": 0.8482490272373541}, {"text": "10", "x0": 0.0989010989010989, "y0": 0.8350194552529183, "x1": 0.11758241758241758, "y1": 0.8459143968871595}, {"text": "Ohm's Law.", "x0": 0.21868131868131868, "y0": 0.8731517509727627, "x1": 0.31648351648351647, "y1": 0.8832684824902723}, {"text": "(A)", "x0": 0.15824175824175823, "y0": 0.8739299610894942, "x1": 0.18571428571428572, "y1": 0.8863813229571984}, {"text": "electromagnetic induction.", "x0": 0.21868131868131868, "y0": 0.8918287937743191, "x1": 0.4307692307692308, "y1": 0.9058365758754864}, {"text": "@)", "x0": 0.15824175824175823, "y0": 0.8926070038910506, "x1": 0.18461538461538463, "y1": 0.9050583657587549}, {"text": "\u00a9", "x0": 0.15824175824175823, "y0": 0.911284046692607, "x1": 0.18461538461538463, "y1": 0.9237354085603113}, {"text": "electrostatic transfer.", "x0": 0.21868131868131868, "y0": 0.911284046692607, "x1": 0.38461538461538464, "y1": 0.9221789883268483}, {"text": "electromagnetic radiation.", "x0": 0.21868131868131868, "y0": 0.9299610894941635, "x1": 0.42637362637362636, "y1": 0.9439688715953307}, {"text": "@)", "x0": 0.15824175824175823, "y0": 0.930739299610895, "x1": 0.18571428571428572, "y1": 0.9439688715953307}], [{"text": "5", "x0": 0.5010989010989011, "y0": 0.04046692607003891, "x1": 0.5076923076923077, "y1": 0.0490272373540856}, {"text": "11 The graph which best represents the magnetic field intensity [B] at various distances [r] from a", "x0": 0.09230769230769231, "y0": 0.05603112840466926, "x1": 0.9153846153846154, "y1": 0.07937743190661478}, {"text": "long, straight wire carrying a constant current is:", "x0": 0.15274725274725276, "y0": 0.08015564202334631, "x1": 0.5428571428571428, "y1": 0.09883268482490272}, {"text": "oN", "x0": 0.13296703296703297, "y0": 0.29105058365758757, "x1": 1.0, "y1": 0.4217898832684825}, {"text": "12 Broglie explained why an electron was limited to certain orbits by showing that electrons", "x0": 0.1076923076923077, "y0": 0.6287937743190661, "x1": 0.8901098901098901, "y1": 0.6482490272373541}, {"text": "(A) _ form standing-wave pattems about the nucleus.", "x0": 0.16703296703296702, "y0": 0.6645914396887159, "x1": 0.6054945054945055, "y1": 0.6894941634241245}, {"text": "(B) _ have elliptical orbits like the planets around the Sun.", "x0": 0.16813186813186815, "y0": 0.6832684824902724, "x1": 0.6472527472527473, "y1": 0.708171206225681}, {"text": "(C) _ occupy a continuum of orbits but only radiate from some.", "x0": 0.16813186813186815, "y0": 0.7050583657587549, "x1": 0.689010989010989, "y1": 0.7276264591439688}, {"text": "(D) obey Maxwell's equations.", "x0": 0.16813186813186815, "y0": 0.7291828793774319, "x1": 0.43956043956043955, "y1": 0.7439688715953308}, {"text": "13 A clean surface of potassium metal will emit electrons when exposed to blue light. If the intensity", "x0": 0.11098901098901098, "y0": 0.7782101167315175, "x1": 0.9362637362637363, "y1": 0.8046692607003891}, {"text": "of the blue light is increased, what property of the ejected electrons will also increase?", "x0": 0.16923076923076924, "y0": 0.8031128404669261, "x1": 0.8417582417582418, "y1": 0.8217898832684825}, {"text": "(A) kinetic energy", "x0": 0.16923076923076924, "y0": 0.846692607003891, "x1": 0.4230769230769231, "y1": 0.8607003891050584}, {"text": "(B) number", "x0": 0.17032967032967034, "y0": 0.866147859922179, "x1": 0.289010989010989, "y1": 0.8793774319066148}, {"text": "(C)__ average speed", "x0": 0.17032967032967034, "y0": 0.8848249027237354, "x1": 0.3384615384615385, "y1": 0.8988326848249028}, {"text": "@) mass", "x0": 0.17032967032967034, "y0": 0.9050583657587549, "x1": 0.2681318681318681, "y1": 0.9175097276264591}], [{"text": "6", "x0": 0.5021978021978022, "y0": 0.034241245136186774, "x1": 0.5098901098901099, "y1": 0.042801556420233464}, {"text": "An object is hot enough to emit a dull red glow. When this object is heated even more, it will", "x0": 0.15384615384615385, "y0": 0.053696498054474705, "x1": 0.9010989010989011, "y1": 0.06770428015564202}, {"text": "14", "x0": 0.0945054945054945, "y0": 0.05525291828793774, "x1": 0.11318681318681319, "y1": 0.06536964980544747}, {"text": "emit shorter-wavelength, higher-frequency radiation.", "x0": 0.21428571428571427, "y0": 0.09260700389105059, "x1": 0.6384615384615384, "y1": 0.1066147859922179}, {"text": "(A)", "x0": 0.15384615384615385, "y0": 0.0933852140077821, "x1": 0.1813186813186813, "y1": 0.1066147859922179}, {"text": "\u00ae)", "x0": 0.15494505494505495, "y0": 0.11284046692607004, "x1": 0.18021978021978022, "y1": 0.12607003891050583}, {"text": "emit longer-wavelength, lower-frequency radiation.", "x0": 0.21428571428571427, "y0": 0.11284046692607004, "x1": 0.6274725274725275, "y1": 0.12684824902723735}, {"text": "\u00a9", "x0": 0.15494505494505495, "y0": 0.13229571984435798, "x1": 0.18021978021978022, "y1": 0.14552529182879378}, {"text": "emit the same wavelengths as before, but with more energy.", "x0": 0.21428571428571427, "y0": 0.13229571984435798, "x1": 0.6956043956043956, "y1": 0.14552529182879378}, {"text": "@)", "x0": 0.15494505494505495, "y0": 0.1517509727626459, "x1": 0.1813186813186813, "y1": 0.1649805447470817}, {"text": "emit more of the same wavelengths with more energy", "x0": 0.21428571428571427, "y0": 0.1517509727626459, "x1": 0.6450549450549451, "y1": 0.1649805447470817}, {"text": "Which of the following would not change the drift velocity of electrons through a conductor?", "x0": 0.15494505494505495, "y0": 0.20933852140077822, "x1": 0.9065934065934066, "y1": 0.22334630350194554}, {"text": "15", "x0": 0.0956043956043956, "y0": 0.21011673151750973, "x1": 0.11428571428571428, "y1": 0.22023346303501945}, {"text": "increasing the thickness of the wire.", "x0": 0.2153846153846154, "y0": 0.24747081712062258, "x1": 0.5021978021978022, "y1": 0.2614785992217899}, {"text": "(A)", "x0": 0.15494505494505495, "y0": 0.2482490272373541, "x1": 0.1824175824175824, "y1": 0.2607003891050584}, {"text": "@\u00ae)", "x0": 0.15494505494505495, "y0": 0.2669260700389105, "x1": 0.18021978021978022, "y1": 0.2801556420233463}, {"text": "increasing the length of the wire.", "x0": 0.21428571428571427, "y0": 0.2669260700389105, "x1": 0.47802197802197804, "y1": 0.2809338521400778}, {"text": "\u00a9", "x0": 0.15494505494505495, "y0": 0.2863813229571984, "x1": 0.18021978021978022, "y1": 0.29961089494163423}, {"text": "increasing the potential difference across the wire.", "x0": 0.21428571428571427, "y0": 0.2863813229571984, "x1": 0.6175824175824176, "y1": 0.30038910505836575}, {"text": "@)", "x0": 0.15494505494505495, "y0": 0.3058365758754864, "x1": 0.1824175824175824, "y1": 0.31906614785992216}, {"text": "increasing the temperature of the wire.", "x0": 0.21428571428571427, "y0": 0.3058365758754864, "x1": 0.5230769230769231, "y1": 0.31984435797665367}], [{"text": "Student Number LJ", "x0": 0.48131868131868133, "y0": 0.0754863813229572, "x1": 0.8703296703296703, "y1": 0.09571984435797666}, {"text": "Part B - 75 marks", "x0": 0.0956043956043956, "y0": 0.12529182879377432, "x1": 0.25824175824175827, "y1": 0.14785992217898833}, {"text": "Attempt Questions 16 - 30", "x0": 0.1010989010989011, "y0": 0.1431906614785992, "x1": 0.33076923076923076, "y1": 0.16653696498054474}, {"text": "\u2018Allow about 2 hours and 30 minutes for this part", "x0": 0.0978021978021978, "y0": 0.15719844357976653, "x1": 0.5208791208791209, "y1": 0.18443579766536966}, {"text": "Answer the questions in the spaces provided", "x0": 0.10329670329670329, "y0": 0.20389105058365758, "x1": 0.4593406593406593, "y1": 0.22101167315175096}, {"text": "Show all relevant working in questions involving calculations.", "x0": 0.1043956043956044, "y0": 0.23813229571984434, "x1": 0.6021978021978022, "y1": 0.25836575875486384}, {"text": "Marks", "x0": 0.8868131868131868, "y0": 0.29416342412451363, "x1": 0.9428571428571428, "y1": 0.3050583657587549}, {"text": "Question 16 (5 marks)", "x0": 0.10659340659340659, "y0": 0.32062256809338524, "x1": 0.29120879120879123, "y1": 0.3369649805447471}, {"text": "\u2018The Saturn V rocket used in the Apollo Moon missions had a launch mass of approximately", "x0": 0.10659340659340659, "y0": 0.35330739299610897, "x1": 0.845054945054945, "y1": 0.3735408560311284}, {"text": "2.7x 10\u00b0 kg. At lift-off, the rocket engines produced a force of 33.5 x 10\u00b0 N vertically upwards.", "x0": 0.1087912087912088, "y0": 0.37042801556420235, "x1": 0.8747252747252747, "y1": 0.39455252918287936}, {"text": "[Assume g = 9.8 ms\u201d in all parts of the question]", "x0": 0.10989010989010989, "y0": 0.3953307392996109, "x1": 0.4989010989010989, "y1": 0.41478599221789886}, {"text": "(@) was the initial vertical acceleration of the rocket? 2", "x0": 0.10989010989010989, "y0": 0.4287937743190661, "x1": 0.9153846153846154, "y1": 0.45525291828793774}, {"text": "(b) net force acts on an astronaut of mass 90 kg in his space suit when the rocket is", "x0": 0.11428571428571428, "y0": 0.621011673151751, "x1": 0.8582417582417582, "y1": 0.6474708171206226}, {"text": "later accelerating vertically at 5 m/s\u201d? 1", "x0": 0.17362637362637362, "y0": 0.642023346303502, "x1": 0.9186813186813186, "y1": 0.6607003891050583}, {"text": "(c) is the force the seat exerts on the 90 kg astronaut when the rocket is accelerating", "x0": 0.11758241758241758, "y0": 0.7603112840466926, "x1": 0.8703296703296703, "y1": 0.7805447470817121}, {"text": "vertically at 5 m/s\u201d? 2", "x0": 0.17582417582417584, "y0": 0.778988326848249, "x1": 0.9230769230769231, "y1": 0.798443579766537}], [{"text": "Question 17 (5 marks)", "x0": 0.1021978021978022, "y0": 0.07818608287724785, "x1": 0.2879120879120879, "y1": 0.09304143862392494}, {"text": "Describe an experiment you conducted during the course to determine the acceleration due to", "x0": 0.1021978021978022, "y0": 0.11415168100078187, "x1": 0.8824175824175824, "y1": 0.1313526192337764}, {"text": "gravity, g. Your answer should outline the equipment and method used and how the measured", "x0": 0.10329670329670329, "y0": 0.13291634089132134, "x1": 0.8835164835164835, "y1": 0.15168100078186084}, {"text": "data is used in order to obtain the value of g. 5", "x0": 0.0989010989010989, "y0": 0.15168100078186084, "x1": 0.9065934065934066, "y1": 0.17357310398749023}], [{"text": "Question 18 (4 marks)", "x0": 0.1043956043956044, "y0": 0.07859922178988327, "x1": 0.29010989010989013, "y1": 0.09416342412451362}, {"text": "An aeroplane flying horizontally at an altitude of 490 m and a speed of 50 ms\u2019, releases a relief", "x0": 0.10659340659340659, "y0": 0.10972762645914397, "x1": 0.8846153846153846, "y1": 0.1330739299610895}, {"text": "package to a group of people isolated by flood waters. (Ignore air resistance on the package]", "x0": 0.10659340659340659, "y0": 0.13151750972762646, "x1": 0.8417582417582418, "y1": 0.15252918287937745}, {"text": "(2) long a time before the plane flies over the target area must the package be released\u201d", "x0": 0.1076923076923077, "y0": 0.16964980544747083, "x1": 0.878021978021978, "y1": 0.19066147859922178}, {"text": "1", "x0": 0.9, "y0": 0.18910505836575875, "x1": 0.9076923076923077, "y1": 0.2}, {"text": "(b) At what horizontal distance from the target area should the package be released? 1", "x0": 0.10989010989010989, "y0": 0.3245136186770428, "x1": 0.910989010989011, "y1": 0.34474708171206225}, {"text": "(c) the package is falling it is in \u201cfree fall\u201d. Explain what this means in terms of the", "x0": 0.11208791208791209, "y0": 0.4404669260700389, "x1": 0.8626373626373627, "y1": 0.4599221789883268}, {"text": "physics involved. 1", "x0": 0.17142857142857143, "y0": 0.4599221789883268, "x1": 0.9142857142857143, "y1": 0.4793774319066148}, {"text": "(d) why astronauts in a space shuttle orbiting Earth feel weightless even though the", "x0": 0.11758241758241758, "y0": 0.6140077821011674, "x1": 0.878021978021978, "y1": 0.6326848249027237}, {"text": "acceleration due to gravity at the orbital altitude is not zero. 1", "x0": 0.17362637362637362, "y0": 0.6334630350194552, "x1": 0.9175824175824175, "y1": 0.6505836575875487}], [{"text": "10", "x0": 0.5087912087912088, "y0": 0.0328381548084441, "x1": 0.5241758241758242, "y1": 0.04143862392494136}, {"text": "Question 19 (7 marks)", "x0": 0.1010989010989011, "y0": 0.07114933541829555, "x1": 0.2868131868131868, "y1": 0.09304143862392494}, {"text": "The Special Theory of Relativity discusses the physical consequences of the absence of a", "x0": 0.1010989010989011, "y0": 0.11180609851446442, "x1": 0.8824175824175824, "y1": 0.12822517591868648}, {"text": "universal frame of reference. The theory, published in 1905, is concerned with problems", "x0": 0.1010989010989011, "y0": 0.1313526192337764, "x1": 0.8824175824175824, "y1": 0.1462079749804535}, {"text": "involving inertial frames of reference. Its fundamental principles caused apparent discrepancies", "x0": 0.1021978021978022, "y0": 0.15089913995308835, "x1": 0.8824175824175824, "y1": 0.1673182173573104}, {"text": "in measurements.", "x0": 0.1021978021978022, "y0": 0.17357310398749023, "x1": 0.24175824175824176, "y1": 0.18451915559030493}, {"text": "(@) are inertial frames of reference? 1", "x0": 0.1021978021978022, "y0": 0.20875684128225175, "x1": 0.9054945054945055, "y1": 0.2251759186864738}, {"text": "(b) _ State TWO fundamental principles upon which the Special Theory of Relativity is based.", "x0": 0.10329670329670329, "y0": 0.3229085222830336, "x1": 0.878021978021978, "y1": 0.344800625488663}, {"text": "(c) State TWO pherromena caused by these fundamental principlesand eutlige how Einstein", "x0": 0.1043956043956044, "y0": 0.5168100078186083, "x1": 0.878021978021978, "y1": 0.5379202501954652}, {"text": "was able them:* 4", "x0": 0.16483516483516483, "y0": 0.5340109460516028, "x1": 0.910989010989011, "y1": 0.5582486317435497}], [{"text": "Question 20 (5 marks)", "x0": 0.0945054945054945, "y0": 0.08326848249027237, "x1": 0.2802197802197802, "y1": 0.09883268482490272}, {"text": "\u2018The diagram below shows a coil of wire carrying AC current wrapped around an iron core. The", "x0": 0.0945054945054945, "y0": 0.11439688715953307, "x1": 0.8769230769230769, "y1": 0.1369649805447471}, {"text": "iron core becomes hot after a short while.", "x0": 0.0967032967032967, "y0": 0.13929961089494164, "x1": 0.42857142857142855, "y1": 0.15408560311284047}, {"text": "(a) what caused this heat build-up in the iron core?", "x0": 0.1021978021978022, "y0": 0.3299610894941634, "x1": 0.6065934065934065, "y1": 0.3486381322957198}, {"text": "(b) State two processes by which the heat gained may be minimised in the case above and for", "x0": 0.1054945054945055, "y0": 0.4396887159533074, "x1": 0.8879120879120879, "y1": 0.467704280155642}, {"text": "4", "x0": 0.9021978021978022, "y0": 0.4622568093385214, "x1": 0.9120879120879121, "y1": 0.47315175097276263}, {"text": "each process explain the principles involved.", "x0": 0.16483516483516483, "y0": 0.466147859922179, "x1": 0.5230769230769231, "y1": 0.4832684824902724}], [{"text": "12", "x0": 0.5087912087912088, "y0": 0.04046692607003891, "x1": 0.5230769230769231, "y1": 0.049805447470817124}, {"text": "Student Number", "x0": 0.44505494505494503, "y0": 0.08015564202334631, "x1": 0.5857142857142857, "y1": 0.09260700389105059}, {"text": "Part B (continued)", "x0": 0.1, "y0": 0.10505836575875487, "x1": 0.25934065934065936, "y1": 0.11828793774319066}, {"text": "Question 21 (5 marks)", "x0": 0.1021978021978022, "y0": 0.1859922178988327, "x1": 0.2868131868131868, "y1": 0.20077821011673153}, {"text": "A transformer is used to power an appliance.", "x0": 0.10329670329670329, "y0": 0.22412451361867705, "x1": 0.46153846153846156, "y1": 0.23813229571984434}, {"text": "(@) _ If the primary voltage is 250 V and there are 500 turns on the primary, how many tums", "x0": 0.10329670329670329, "y0": 0.2536964980544747, "x1": 0.8615384615384616, "y1": 0.2801556420233463}, {"text": "are required on the secondary to obtain a voltage of 12.5 V? 1", "x0": 0.15934065934065933, "y0": 0.2731517509727626, "x1": 0.9076923076923077, "y1": 0.29961089494163423}, {"text": "(b) the primary consumes 2500 watts of power and the transformer is 100 % efficient,", "x0": 0.1054945054945055, "y0": 0.39455252918287936, "x1": 0.8428571428571429, "y1": 0.41245136186770426}, {"text": "what would be the current in the secondary coil? 1", "x0": 0.16593406593406593, "y0": 0.4140077821011673, "x1": 0.9087912087912088, "y1": 0.42957198443579764}, {"text": "(\u00a9) __If the alternating current used in the primary was replaced by a direct current, what would", "x0": 0.10659340659340659, "y0": 0.5299610894941634, "x1": 0.8879120879120879, "y1": 0.5463035019455252}, {"text": "be the effect on the secondary? Explain. 1", "x0": 0.16593406593406593, "y0": 0.5494163424124514, "x1": 0.910989010989011, "y1": 0.5649805447470817}, {"text": "Discuss one advantage and one disadvantage of not having an iron core in the", "x0": 0.16703296703296702, "y0": 0.6645914396887159, "x1": 0.7912087912087912, "y1": 0.6801556420233463}, {"text": "transformer. 2", "x0": 0.16263736263736264, "y0": 0.6809338521400778, "x1": 0.9131868131868132, "y1": 0.7050583657587549}], [{"text": "Question 22 (5 marks)", "x0": 0.0978021978021978, "y0": 0.07003891050583658, "x1": 0.2824175824175824, "y1": 0.09727626459143969}, {"text": "Compare and contrast the structure and function of a simple AC electric generator with that of a", "x0": 0.0978021978021978, "y0": 0.11595330739299611, "x1": 0.8670329670329671, "y1": 0.13151750972762646}, {"text": "DC motor. 5", "x0": 0.0978021978021978, "y0": 0.13463035019455252, "x1": 0.9032967032967033, "y1": 0.14785992217898833}], [{"text": "Question 23 (4 marks)", "x0": 0.09340659340659341, "y0": 0.08171206225680934, "x1": 0.27692307692307694, "y1": 0.09571984435797666}, {"text": "A coil of wire is suspended from a spring balance between the poles of two magnets. The coil is", "x0": 0.09340659340659341, "y0": 0.11595330739299611, "x1": 0.8758241758241758, "y1": 0.133852140077821}, {"text": "rectangular with dimensions of 8 cm high by 10 cm wide and has 100 tums of wire. In one", "x0": 0.09340659340659341, "y0": 0.13540856031128404, "x1": 0.8758241758241758, "y1": 0.15408560311284047}, {"text": "experiment, the spring balance readings were recorded for different currents. The apparatus and", "x0": 0.09340659340659341, "y0": 0.154863813229572, "x1": 0.8769230769230769, "y1": 0.1735408560311284}, {"text": "results are shown below.", "x0": 0.0945054945054945, "y0": 0.17821011673151751, "x1": 0.2923076923076923, "y1": 0.18988326848249026}, {"text": "(a) \u2018What was the weight of the coil of wire?", "x0": 0.0989010989010989, "y0": 0.4272373540856031, "x1": 0.4835164835164835, "y1": 0.44202334630350193}, {"text": "(b) Determine the magnetic field strength between the poles of the magnet.", "x0": 0.1, "y0": 0.5035019455252918, "x1": 0.7318681318681318, "y1": 0.5190661478599222}, {"text": "(\u00a9) direction of the current in the coil clockwise or anticlockwise?", "x0": 0.1010989010989011, "y0": 0.6186770428015564, "x1": 0.710989010989011, "y1": 0.6342412451361867}, {"text": "(@) The current is adjusted so that the balance reads 0.0N. What current flows in this case", "x0": 0.1010989010989011, "y0": 0.6964980544747081, "x1": 0.8483516483516483, "y1": 0.711284046692607}, {"text": "and in which direction?", "x0": 0.16043956043956045, "y0": 0.7167315175097276, "x1": 0.34835164835164834, "y1": 0.7276264591439688}], [{"text": "15", "x0": 0.5087912087912088, "y0": 0.03674745895230649, "x1": 0.5230769230769231, "y1": 0.04534792806880375}, {"text": "Question 24 (5 marks)", "x0": 0.0989010989010989, "y0": 0.07818608287724785, "x1": 0.2846153846153846, "y1": 0.09225957779515247}, {"text": "DC motor operates at 12 volts and the armature windings have a resistance of 1.6 ohms.", "x0": 0.16813186813186815, "y0": 0.1125879593432369, "x1": 0.8813186813186813, "y1": 0.13369820172009383}, {"text": "\u2018When the motor is running normally, the current drawn is 0.50 A.", "x0": 0.0989010989010989, "y0": 0.1352619233776388, "x1": 0.6252747252747253, "y1": 0.15011727912431588}, {"text": "(a) What back emf is developed in the coil?", "x0": 0.1, "y0": 0.1751368256450352, "x1": 0.4824175824175824, "y1": 0.1892103205629398}, {"text": "What current is drawn by the motor if the coil is held fast and prevented from tuming?", "x0": 0.16043956043956045, "y0": 0.3299452697419859, "x1": 0.856043956043956, "y1": 0.344800625488663}, {"text": "1", "x0": 0.8978021978021978, "y0": 0.3299452697419859, "x1": 0.9065934065934066, "y1": 0.3408913213448006}, {"text": "(\u00a9) DC motors haveve start-up sesistance.in seaies withthe", "x0": 0.1010989010989011, "y0": 0.44175136825645034, "x1": 0.6483516483516484, "y1": 0.46677091477716964}, {"text": "resistance is graduaily the motor", "x0": 0.16153846153846155, "y0": 0.46051602814698983, "x1": 0.510989010989011, "y1": 0.48631743549648165}], [{"text": "Question 25 (4 marks)", "x0": 0.0978021978021978, "y0": 0.08093385214007782, "x1": 0.2835164835164835, "y1": 0.09571984435797666}, {"text": "\u2018A metal ring lies in a magnetic field as shown below. As the ring is removed from the magnetic", "x0": 0.0989010989010989, "y0": 0.11284046692607004, "x1": 0.8791208791208791, "y1": 0.133852140077821}, {"text": "field a current flows in the ring. John is of the opinion that the direction of the current in the ring", "x0": 0.0989010989010989, "y0": 0.13229571984435798, "x1": 0.8802197802197802, "y1": 0.1517509727626459}, {"text": "is anti-clockwise whereas Bill is of the opinion that the current flows in a clockwise direction.", "x0": 0.1, "y0": 0.1517509727626459, "x1": 0.8802197802197802, "y1": 0.17120622568093385}, {"text": "\u2018The magnetic field is directed perpendicularly out of the plane of the paper.", "x0": 0.1, "y0": 0.16731517509727625, "x1": 0.7065934065934066, "y1": 0.1953307392996109}, {"text": "(@)", "x0": 0.10659340659340659, "y0": 0.467704280155642, "x1": 0.12747252747252746, "y1": 0.4801556420233463}, {"text": "_ Explain what happens to the current in the ring when it is completely outside the", "x0": 0.15054945054945054, "y0": 0.691828793774319, "x1": 0.8164835164835165, "y1": 0.7151750972762646}, {"text": "magnetic field", "x0": 0.16923076923076924, "y0": 0.7167315175097276, "x1": 0.2846153846153846, "y1": 0.7307392996108949}], [{"text": "Question 26 (6 marks)", "x0": 0.1010989010989011, "y0": 0.07081712062256809, "x1": 0.2857142857142857, "y1": 0.09416342412451362}, {"text": "Discuss how electrical energy is generated and transmitted from source to point of use. 6", "x0": 0.1010989010989011, "y0": 0.11284046692607004, "x1": 0.8835164835164835, "y1": 0.12684824902723735}], [{"text": "Student Number |", "x0": 0.43846153846153846, "y0": 0.07626459143968872, "x1": 0.789010989010989, "y1": 0.09649805447470818}, {"text": "Part B (continued)", "x0": 0.0945054945054945, "y0": 0.10505836575875487, "x1": 0.2549450549450549, "y1": 0.11828793774319066}, {"text": "Question 27 (11 marks)", "x0": 0.0967032967032967, "y0": 0.1859922178988327, "x1": 0.29120879120879123, "y1": 0.2}, {"text": "J. J. Thomson is attributed with discovering the electron in 1897. One possible method he might", "x0": 0.0967032967032967, "y0": 0.22023346303501945, "x1": 0.878021978021978, "y1": 0.23657587548638132}, {"text": "have used was to first send a stream of cathode rays simultaneously through an electric and", "x0": 0.0967032967032967, "y0": 0.2396887159533074, "x1": 0.878021978021978, "y1": 0.2552529182879377}, {"text": "magnetic field in order to measure their velocity. He then could have passed the beam through a", "x0": 0.0967032967032967, "y0": 0.25914396887159535, "x1": 0.8791208791208791, "y1": 0.27704280155642025}, {"text": "magnetic field only and measured the deflection of the beam.", "x0": 0.0978021978021978, "y0": 0.2801556420233463, "x1": 0.5868131868131868, "y1": 0.2964980544747082}, {"text": "(a) The electron (in the form of cathode rays) had been studied by scientists for almost 40 2", "x0": 0.0989010989010989, "y0": 0.3175097276264591, "x1": 0.9032967032967033, "y1": 0.3346303501945525}, {"text": "years before Thomson performed his famous experiment. Explain why Thomson has", "x0": 0.15934065934065933, "y0": 0.3369649805447471, "x1": 0.8373626373626374, "y1": 0.3540856031128405}, {"text": "been accredited with the discovery of the electron.", "x0": 0.15934065934065933, "y0": 0.3587548638132296, "x1": 0.5615384615384615, "y1": 0.3719844357976654}, {"text": "(b) passed the cathode ray beam through crossed electric and magnetic fields of 2", "x0": 0.1021978021978022, "y0": 0.5494163424124514, "x1": 0.9076923076923077, "y1": 0.5649805447470817}, {"text": "such strengths that the beam passed undeflected. Use mathematical formulae to help", "x0": 0.16263736263736264, "y0": 0.5688715953307393, "x1": 0.8373626373626374, "y1": 0.5836575875486382}, {"text": "demonstrate how the velocity of a cathode ray beam can be determined using this", "x0": 0.16153846153846155, "y0": 0.5875486381322957, "x1": 0.8153846153846154, "y1": 0.6023346303501945}, {"text": "method.", "x0": 0.16263736263736264, "y0": 0.6085603112840466, "x1": 0.22637362637362637, "y1": 0.619455252918288}, {"text": "(c) Thomson then switched off the electric field and the beam deflected through the magnetic 1", "x0": 0.10329670329670329, "y0": 0.8015564202334631, "x1": 0.9087912087912088, "y1": 0.8155642023346303}, {"text": "field. Describe the path of the cathode rays while in the magnetic field.", "x0": 0.16373626373626374, "y0": 0.8210116731517509, "x1": 0.7318681318681318, "y1": 0.8350194552529183}, {"text": "Question 27 continues next page", "x0": 0.35494505494505496, "y0": 0.9175097276264591, "x1": 0.6318681318681318, "y1": 0.9315175097276265}], [{"text": "Question 27 (continued)", "x0": 0.0978021978021978, "y0": 0.08600469116497264, "x1": 0.2945054945054945, "y1": 0.10007818608287725}, {"text": "\u2018Contrast the operation of a black and white television and a cathode ray oscilloscope.", "x0": 0.15824175824175823, "y0": 0.12275215011727912, "x1": 0.8417582417582418, "y1": 0.13917122752150118}, {"text": "@", "x0": 0.0978021978021978, "y0": 0.1266614542611415, "x1": 0.12087912087912088, "y1": 0.13917122752150118}, {"text": "Describe any differences in the images formed.", "x0": 0.15824175824175823, "y0": 0.14386239249413604, "x1": 0.5373626373626373, "y1": 0.15871774824081314}], [{"text": "Question 28 (11 marks)", "x0": 0.1, "y0": 0.0754863813229572, "x1": 0.2934065934065934, "y1": 0.09727626459143969}, {"text": "Heinrich Hertz was instrumental in the discovery of the photoelectric effect.", "x0": 0.1, "y0": 0.11439688715953307, "x1": 0.7087912087912088, "y1": 0.12918287937743192}, {"text": "(a) Hertz\u2019s observation of the effect of a radio wave on a receiver and the 2", "x0": 0.1010989010989011, "y0": 0.1509727626459144, "x1": 0.9043956043956044, "y1": 0.1688715953307393}, {"text": "photoelectric effect he produced.", "x0": 0.16153846153846155, "y0": 0.1735408560311284, "x1": 0.42417582417582417, "y1": 0.18910505836575875}, {"text": "(b) Define the term photoelectric effect as it applies to modem physics.", "x0": 0.1043956043956044, "y0": 0.3649805447470817, "x1": 0.7032967032967034, "y1": 0.38132295719844356}, {"text": "(\u00a9) Asstudent performs an experiment to measure the maximum kinetic energy of electrons", "x0": 0.1054945054945055, "y0": 0.4801556420233463, "x1": 0.865934065934066, "y1": 0.4964980544747082}, {"text": "(in J) released in the photoelectric effect and the frequency of light shone onto the sodium", "x0": 0.16593406593406593, "y0": 0.49961089494163424, "x1": 0.8868131868131868, "y1": 0.5151750972762645}, {"text": "metal target. Her data is as follows:", "x0": 0.16593406593406593, "y0": 0.5206225680933853, "x1": 0.44835164835164837, "y1": 0.5346303501945525}, {"text": "wavelength of | Kinetic Energy of Frequency of", "x0": 0.2714285714285714, "y0": 0.5556420233463035, "x1": 0.7384615384615385, "y1": 0.5766536964980544}, {"text": "light used released electrons light used", "x0": 0.289010989010989, "y0": 0.5774319066147859, "x1": 0.7241758241758242, "y1": 0.5929961089494163}, {"text": "(x 10\u201d m) x10\" J)", "x0": 0.289010989010989, "y0": 0.5953307392996109, "x1": 0.5263736263736264, "y1": 0.6116731517509728}, {"text": "5.5 8.01", "x0": 0.31648351648351647, "y0": 0.6256809338521401, "x1": 0.5021978021978022, "y1": 0.6365758754863813}, {"text": "43 1.60", "x0": 0.3153846153846154, "y0": 0.6599221789883268, "x1": 0.5043956043956044, "y1": 0.670817120622568}, {"text": "41 1,92", "x0": 0.3153846153846154, "y0": 0.6933852140077821, "x1": 0.5043956043956044, "y1": 0.7042801556420234}, {"text": "+", "x0": 0.3912087912087912, "y0": 0.7151750972762646, "x1": 0.4065934065934066, "y1": 0.7237354085603113}, {"text": "3.6 2.56", "x0": 0.31648351648351647, "y0": 0.7276264591439688, "x1": 0.5043956043956044, "y1": 0.7392996108949417}, {"text": "3.1 3.36", "x0": 0.31648351648351647, "y0": 0.7626459143968871, "x1": 0.5043956043956044, "y1": 0.7735408560311284}, {"text": "() Complete the above table, including correct units for frequency. 2", "x0": 0.14725274725274726, "y0": 0.8077821011673152, "x1": 0.9131868131868132, "y1": 0.8233463035019455}, {"text": "Question 28 continues next page", "x0": 0.35824175824175825, "y0": 0.8474708171206226, "x1": 0.6351648351648351, "y1": 0.8614785992217899}], [{"text": "2", "x0": 0.5065934065934066, "y0": 0.04357976653696498, "x1": 0.5208791208791209, "y1": 0.052140077821011675}, {"text": "Question 28 (continued)", "x0": 0.1, "y0": 0.0840466926070039, "x1": 0.2967032967032967, "y1": 0.09961089494163425}, {"text": "(i) On the following gri