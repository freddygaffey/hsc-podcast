384615384616, "y0": 0.7768273716951789, "x1": 0.4340659340659341, "y1": 0.7884914463452566}, {"text": "The figure shows the side view of a bridge", "x0": 0.12197802197802197, "y0": 0.7923794712286159, "x1": 0.45164835164835165, "y1": 0.8149300155520995}, {"text": "opened to let boats pass underneath. When", "x0": 0.12197802197802197, "y0": 0.8133748055987559, "x1": 0.46593406593406594, "y1": 0.8258164852255054}, {"text": "the equal arms of the bridge PA and QB are", "x0": 0.12307692307692308, "y0": 0.8273716951788491, "x1": 0.46813186813186813, "y1": 0.8398133748055988}, {"text": "lowered, they meet exactly to form the", "x0": 0.12307692307692308, "y0": 0.8421461897356143, "x1": 0.42417582417582417, "y1": 0.8538102643856921}, {"text": "straight roadway PQ, which is 50 m long.", "x0": 0.12307692307692308, "y0": 0.8561430793157077, "x1": 0.4461538461538462, "y1": 0.8678071539657853}, {"text": "When the arms PA and QB are raised through", "x0": 0.12197802197802197, "y0": 0.8701399688958009, "x1": 0.4868131868131868, "y1": 0.8825816485225505}, {"text": "an angle @ as shown, the \u2018corridor\u2019 AB is 12 m", "x0": 0.12307692307692308, "y0": 0.8794712286158631, "x1": 0.48021978021978023, "y1": 0.9020217729393468}, {"text": "(@\u00ae Copy this graph.", "x0": 0.554945054945055, "y0": 0.8849144634525661, "x1": 0.710989010989011, "y1": 0.8973561430793157}, {"text": "wide.", "x0": 0.12307692307692308, "y0": 0.8989113530326595, "x1": 0.16263736263736264, "y1": 0.9090202177293935}, {"text": "(ii) On the same set of axes, draw a sketch", "x0": 0.5494505494505495, "y0": 0.9051321928460342, "x1": 0.8857142857142857, "y1": 0.916796267496112}, {"text": "of the derivative f\u2019(x) of the function.", "x0": 0.5835164835164836, "y0": 0.9160186625194401, "x1": 0.8824175824175824, "y1": 0.9354587869362364}, {"text": "Calculate the size of angle 6", "x0": 0.12197802197802197, "y0": 0.9199066874027994, "x1": 0.34615384615384615, "y1": 0.932348367029549}, {"text": "1994 @ Page2", "x0": 0.4472527472527473, "y0": 0.9494556765163297, "x1": 0.5703296703296703, "y1": 0.9587869362363919}], [{"text": "2/3 Unit (COMMON)", "x0": 0.7153846153846154, "y0": 0.028771384136858476, "x1": 0.8395604395604396, "y1": 0.038102643856920686}, {"text": "(c) Consider the curve given by y= x\u00b0-6x+4.", "x0": 0.0989010989010989, "y0": 0.06376360808709176, "x1": 0.47802197802197804, "y1": 0.07776049766718507}, {"text": "(ii) It is also observed that, throughout the", "x0": 0.5604395604395604, "y0": 0.06376360808709176, "x1": 0.9065934065934066, "y1": 0.07542768273716952}, {"text": "(i) Find the coordinates of the stationary", "x0": 0.14285714285714285, "y0": 0.08709175738724728, "x1": 0.4725274725274725, "y1": 0.09875583203732503}, {"text": "period,", "x0": 0.5956043956043956, "y0": 0.08864696734059098, "x1": 0.6483516483516484, "y1": 0.1104199066874028}, {"text": "points and determine their nature.", "x0": 0.17142857142857143, "y0": 0.10186625194401244, "x1": 0.4472527472527473, "y1": 0.11353032659409021}, {"text": "Sketch the graph of u against \u00a2.", "x0": 0.5945054945054945, "y0": 0.1166407465007776, "x1": 0.845054945054945, "y1": 0.14152410575427682}, {"text": "(ii) Find the coordinates of any point of", "x0": 0.13626373626373625, "y0": 0.12130637636080871, "x1": 0.45604395604395603, "y1": 0.13297045101088648}, {"text": "inflexion.", "x0": 0.17142857142857143, "y0": 0.13608087091757387, "x1": 0.24395604395604395, "y1": 0.14541213063763608}, {"text": "(iii) Sketch the curve for the domain", "x0": 0.13076923076923078, "y0": 0.15552099533437014, "x1": 0.42527472527472526, "y1": 0.1656298600311042}, {"text": "-3<x<3.", "x0": 0.17362637362637362, "y0": 0.171850699844479, "x1": 0.25934065934065936, "y1": 0.18040435458786935}, {"text": "(iv) What is the maximum value of x\u00b0\u20146x+4", "x0": 0.13186813186813187, "y0": 0.18973561430793157, "x1": 0.4945054945054945, "y1": 0.20295489891135304}, {"text": "in the domain ~3 < x < 3?", "x0": 0.17032967032967034, "y0": 0.208398133748056, "x1": 0.378021978021978, "y1": 0.21850699844479005}, {"text": "QUESTION SEVEN", "x0": 0.0978021978021978, "y0": 0.24805598755832037, "x1": 0.2681318681318681, "y1": 0.25972006220839816}, {"text": "(a) A can of baked beans", "x0": 0.0967032967032967, "y0": 0.2682737169517885, "x1": 0.2923076923076923, "y1": 0.27838258164852253}, {"text": "is in the shape of a", "x0": 0.12527472527472527, "y0": 0.2744945567651633, "x1": 0.27912087912087913, "y1": 0.29937791601866254}, {"text": "closed cylinder with", "x0": 0.12527472527472527, "y0": 0.2962674961119751, "x1": 0.2824175824175824, "y1": 0.30793157076205285}, {"text": "height A cm and", "x0": 0.12417582417582418, "y0": 0.31026438569206843, "x1": 0.25384615384615383, "y1": 0.32192846034214617}, {"text": "radius r em, as shown", "x0": 0.12417582417582418, "y0": 0.3250388802488336, "x1": 0.2989010989010989, "y1": 0.33670295489891133}, {"text": "in the diagram.", "x0": 0.12417582417582418, "y0": 0.3390357698289269, "x1": 0.24615384615384617, "y1": 0.35069984447900465}, {"text": "(i) The volume of the can is 500 cm\u2019,", "x0": 0.13956043956043956, "y0": 0.36236391912908245, "x1": 0.432967032967033, "y1": 0.374805598755832}, {"text": "Find an expression for h in terms of r.", "x0": 0.16923076923076924, "y0": 0.3724727838258165, "x1": 0.46923076923076923, "y1": 0.3973561430793157}, {"text": "A regular hexagon is drawn inside a circle", "x0": 0.5472527472527473, "y0": 0.3864696734059098, "x1": 0.8824175824175824, "y1": 0.39813374805598756}, {"text": "(ii) Show that the surface area, S cm?, of the", "x0": 0.13406593406593406, "y0": 0.3965785381026439, "x1": 0.49230769230769234, "y1": 0.4191290824261275}, {"text": "with centre O so that its vertices lie on the", "x0": 0.5483516483516484, "y0": 0.401244167962675, "x1": 0.8857142857142857, "y1": 0.41135303265940903}, {"text": "circumference, as shown in the diagram.", "x0": 0.5472527472527473, "y0": 0.4152410575427683, "x1": 0.8681318681318682, "y1": 0.42690513219284604}, {"text": "can is given by", "x0": 0.16813186813186815, "y0": 0.416796267496112, "x1": 0.2857142857142857, "y1": 0.4284603421461897}, {"text": "The circle has radius 1 cm.", "x0": 0.5461538461538461, "y0": 0.43001555209953346, "x1": 0.7593406593406593, "y1": 0.4393468118195957}, {"text": "S = 1000,", "x0": 0.25164835164835164, "y0": 0.432348367029549, "x1": 0.3868131868131868, "y1": 0.4595645412130638}, {"text": "(i) Prove that AOAB is equilateral.", "x0": 0.5615384615384615, "y0": 0.45023328149300157, "x1": 0.8472527472527472, "y1": 0.4618973561430793}, {"text": "r", "x0": 0.35714285714285715, "y0": 0.45334370139968894, "x1": 0.3637362637362637, "y1": 0.4595645412130638}, {"text": "(iii) If the area of metal used to make the can", "x0": 0.12747252747252746, "y0": 0.4618973561430793, "x1": 0.49230769230769234, "y1": 0.4867807153965785}, {"text": "(ii) Find the area of AOAB and hence find", "x0": 0.5560439560439561, "y0": 0.46967340590979784, "x1": 0.8967032967032967, "y1": 0.4797822706065319}, {"text": "is to be minimized, find the radius of the", "x0": 0.16813186813186815, "y0": 0.47667185069984447, "x1": 0.49340659340659343, "y1": 0.5007776049766719}, {"text": "the area of this hexagon. Leave your", "x0": 0.5901098901098901, "y0": 0.484447900466563, "x1": 0.8835164835164835, "y1": 0.49611197511664074}, {"text": "answer in surd form.", "x0": 0.5901098901098901, "y0": 0.5, "x1": 0.7538461538461538, "y1": 0.5093312597200622}, {"text": "can,", "x0": 0.16813186813186815, "y0": 0.5007776049766719, "x1": 0.1989010989010989, "y1": 0.5069984447900466}, {"text": "(b) Solve 3 = log, x\u2014logs 6.", "x0": 0.0945054945054945, "y0": 0.5139968895800933, "x1": 0.37252747252747254, "y1": 0.5388802488335925}, {"text": "(e) A Geiger counter is taken into a region after a", "x0": 0.0945054945054945, "y0": 0.5458786936236392, "x1": 0.49230769230769234, "y1": 0.557542768273717}, {"text": "nuclear accident and gives a reading of 10000.", "x0": 0.12307692307692308, "y0": 0.5598755832037325, "x1": 0.4912087912087912, "y1": 0.5723172628304821}, {"text": "One year later, the same Geiger counter gives", "x0": 0.12307692307692308, "y0": 0.5746500777604977, "x1": 0.49230769230769234, "y1": 0.5863141524105754}, {"text": "areading of 9000. It is known that the reading", "x0": 0.12307692307692308, "y0": 0.5855365474339036, "x1": 0.49230769230769234, "y1": 0.604199066874028}, {"text": "T is given by the formula", "x0": 0.11868131868131868, "y0": 0.5956454121306376, "x1": 0.321978021978022, "y1": 0.6205287713841369}, {"text": "where Ty and & are constants and \u00a2 is the time", "x0": 0.12197802197802197, "y0": 0.6345256609642301, "x1": 0.4912087912087912, "y1": 0.6601866251944012}, {"text": "measured in years.", "x0": 0.12197802197802197, "y0": 0.6570762052877138, "x1": 0.2725274725274725, "y1": 0.6679626749611197}, {"text": "(i) Evaluate the constants 7, and k.", "x0": 0.13736263736263737, "y0": 0.6804043545878694, "x1": 0.42747252747252745, "y1": 0.6951788491446346}, {"text": "(ii) Itis known that the region will become", "x0": 0.13186813186813187, "y0": 0.7013996889580093, "x1": 0.47692307692307695, "y1": 0.7130637636080871}, {"text": "safe when the reading reaches 40. After", "x0": 0.16703296703296702, "y0": 0.7153965785381027, "x1": 0.4868131868131868, "y1": 0.7270606531881804}, {"text": "how many years will the region become", "x0": 0.16703296703296702, "y0": 0.7301710730948678, "x1": 0.47912087912087914, "y1": 0.7418351477449455}, {"text": "safe?", "x0": 0.16703296703296702, "y0": 0.744945567651633, "x1": 0.20549450549450549, "y1": 0.7542768273716952}, {"text": "Another regular hexagon is drawn outside the", "x0": 0.545054945054945, "y0": 0.7698289269051322, "x1": 0.9098901098901099, "y1": 0.78149300155521}, {"text": "QUESTION EIGHT", "x0": 0.0945054945054945, "y0": 0.7838258164852255, "x1": 0.26263736263736265, "y1": 0.7947122861586314}, {"text": "circle, as shown. The altitude of AOGH is", "x0": 0.545054945054945, "y0": 0.7846034214618973, "x1": 0.8813186813186813, "y1": 0.7962674961119751}, {"text": "lem.", "x0": 0.5461538461538461, "y0": 0.8001555209953344, "x1": 0.5846153846153846, "y1": 0.8087091757387247}, {"text": "(a) The number of unemployed people u at time t", "x0": 0.0945054945054945, "y0": 0.8048211508553654, "x1": 0.4835164835164835, "y1": 0.8164852255054432}, {"text": "was studied over a period of time. At the", "x0": 0.12307692307692308, "y0": 0.8188180404354588, "x1": 0.44945054945054946, "y1": 0.8312597200622084}, {"text": "(iii) Find the area of AOGH and hence find", "x0": 0.5483516483516484, "y0": 0.8219284603421462, "x1": 0.8978021978021978, "y1": 0.8328149300155521}, {"text": "start of this period, the number of", "x0": 0.12307692307692308, "y0": 0.833592534992224, "x1": 0.3934065934065934, "y1": 0.8452566096423018}, {"text": "the area of this outer hexagon. Leave", "x0": 0.5879120879120879, "y0": 0.838258164852255, "x1": 0.8868131868131868, "y1": 0.8499222395023328}, {"text": "unemployed was 800 000.", "x0": 0.12307692307692308, "y0": 0.8444790046656299, "x1": 0.3230769230769231, "y1": 0.8639191290824261}, {"text": "your answer in surd form.", "x0": 0.5868131868131868, "y0": 0.8522550544323484, "x1": 0.7923076923076923, "y1": 0.8639191290824261}, {"text": "(i) Throughout the period, a\u201c <0.", "x0": 0.13846153846153847, "y0": 0.8685847589424572, "x1": 0.4175824175824176, "y1": 0.8996889580093312}, {"text": "(iv) By considering the results in (ii) and (iii),", "x0": 0.5494505494505495, "y0": 0.8716951788491446, "x1": 0.910989010989011, "y1": 0.8833592534992224}, {"text": "show that 2B", "x0": 0.5879120879120879, "y0": 0.8864696734059098, "x1": 0.7065934065934066, "y1": 0.9222395023328149}, {"text": "What does this say about the number", "x0": 0.16703296703296702, "y0": 0.9012441679626749, "x1": 0.46263736263736266, "y1": 0.9129082426127527}, {"text": "of unemployed during the period?", "x0": 0.16703296703296702, "y0": 0.9152410575427683, "x1": 0.4318681318681319, "y1": 0.9276827