[[{"text": "| CRANBROOK", "x0": 0.19801980198019803, "y0": 0.0707070707070707, "x1": 0.4158415841584158, "y1": 0.09557109557109557}, {"text": "SCHOOL", "x0": 0.21892189218921893, "y0": 0.10101010101010101, "x1": 0.3179317931793179, "y1": 0.11188811188811189}, {"text": "2020", "x0": 0.823982398239824, "y0": 0.22377622377622378, "x1": 0.88998899889989, "y1": 0.23931623931623933}, {"text": "HSC Trial Examination", "x0": 0.5874587458745875, "y0": 0.24864024864024864, "x1": 0.8888888888888888, "y1": 0.2641802641802642}, {"text": "Assessment Task 3", "x0": 0.5874587458745875, "y0": 0.27350427350427353, "x1": 0.8492849284928493, "y1": 0.289044289044289}, {"text": "English Extension 1", "x0": 0.12321232123212321, "y0": 0.32634032634032634, "x1": 0.5896589658965896, "y1": 0.3620823620823621}, {"text": "General Instructions", "x0": 0.12981298129812982, "y0": 0.4933954933954934, "x1": 0.32453245324532454, "y1": 0.5034965034965035}, {"text": "Reading time \u2014 10 minutes", "x0": 0.12981298129812982, "y0": 0.5120435120435121, "x1": 0.3487348734873487, "y1": 0.5244755244755245}, {"text": "Writing time \u20142 hours", "x0": 0.12871287128712872, "y0": 0.5291375291375291, "x1": 0.31903190319031904, "y1": 0.5415695415695416}, {"text": "Write using black pen", "x0": 0.12871287128712872, "y0": 0.5470085470085471, "x1": 0.3047304730473047, "y1": 0.5594405594405595}, {"text": "Section | 25 marks (pages 2-3)", "x0": 0.11991199119911991, "y0": 0.581973581973582, "x1": 0.43014301430143015, "y1": 0.5959595959595959}, {"text": "+ Attempt Question 1", "x0": 0.12431243124312431, "y0": 0.6107226107226107, "x1": 0.3047304730473047, "y1": 0.6239316239316239}, {"text": "+ Allow about thour for this section", "x0": 0.12431243124312431, "y0": 0.6317016317016317, "x1": 0.4312431243124312, "y1": 0.6418026418026418}, {"text": "- Answer in a SEPARATE writing booklet", "x0": 0.12431243124312431, "y0": 0.6526806526806527, "x1": 0.5137513751375138, "y1": 0.6658896658896659}, {"text": "Section Il - 25 marks (pages 4-8)", "x0": 0.11991199119911991, "y0": 0.6961926961926962, "x1": 0.43564356435643564, "y1": 0.7101787101787101}, {"text": "- Attempt ONE question from Questions 2 - 6", "x0": 0.12431243124312431, "y0": 0.7241647241647242, "x1": 0.5247524752475248, "y1": 0.7373737373737373}, {"text": "+ Allow about thour for this section", "x0": 0.12431243124312431, "y0": 0.745920745920746, "x1": 0.4312431243124312, "y1": 0.756021756021756}, {"text": "- Answer in a SEPARATE writing booklet", "x0": 0.12431243124312431, "y0": 0.7668997668997669, "x1": 0.5137513751375138, "y1": 0.7801087801087802}, {"text": "Total marks: 50", "x0": 0.11001100110011001, "y0": 0.8088578088578089, "x1": 0.2563256325632563, "y1": 0.818958818958819}], [{"text": "Section I: Common Module \u2014 Literary Worlds", "x0": 0.11001100110011001, "y0": 0.05827505827505827, "x1": 0.5874587458745875, "y1": 0.07381507381507381}, {"text": "25 Marks", "x0": 0.11001100110011001, "y0": 0.08857808857808858, "x1": 0.19141914191419143, "y1": 0.0979020979020979}, {"text": "Attempt Question 1", "x0": 0.11001100110011001, "y0": 0.11577311577311578, "x1": 0.2761276127612761, "y1": 0.1282051282051282}, {"text": "Allow about 1 hour for this section", "x0": 0.11001100110011001, "y0": 0.14296814296814297, "x1": 0.40594059405940597, "y1": 0.1522921522921523}, {"text": "Your answer will be sed on how well you:", "x0": 0.11001100110011001, "y0": 0.16938616938616938, "x1": 0.49064906490649063, "y1": 0.1825951825951826}, {"text": "\u00a9 demonstrate an understanding of the ideas and values of Literary Worlds and how they", "x0": 0.14301430143014301, "y0": 0.18803418803418803, "x1": 0.8668866886688669, "y1": 0.21445221445221446}, {"text": "are shaped and reflected in texts", "x0": 0.16721672167216722, "y0": 0.21367521367521367, "x1": 0.42574257425742573, "y1": 0.22688422688422688}, {"text": "\u00a9 craft a sustained composition appropriate to the question demonstrating control of the use", "x0": 0.14301430143014301, "y0": 0.23232323232323232, "x1": 0.8888888888888888, "y1": 0.25874125874125875}, {"text": "of language", "x0": 0.1628162816281628, "y0": 0.2501942501942502, "x1": 0.2607260726072607, "y1": 0.2766122766122766}, {"text": "Question 1", "x0": 0.11001100110011001, "y0": 0.31546231546231546, "x1": 0.19911991199119913, "y1": 0.3271173271173271}, {"text": "Use Text 1 and Text 2 to answer Question 1.", "x0": 0.11001100110011001, "y0": 0.3418803418803419, "x1": 0.46864686468646866, "y1": 0.3543123543123543}, {"text": "Text 1 \u2014 Nonfiction extract", "x0": 0.11001100110011001, "y0": 0.36985236985236986, "x1": 0.33993399339933994, "y1": 0.3791763791763792}, {"text": "\u2018History isn\u2019t just a series of bygone eras, littered with a m\u00e9lange* of fascinating and", "x0": 0.13861386138613863, "y0": 0.425019425019425, "x1": 0.8228822882288229, "y1": 0.4382284382284382}, {"text": "horrific events and people. It\u2019s a detailed map of who we are and what we stand for both", "x0": 0.1331133113311331, "y0": 0.4421134421134421, "x1": 0.8448844884488449, "y1": 0.4553224553224553}, {"text": "as an individual, and as a society. History is also a window into our future. As creatures", "x0": 0.1331133113311331, "y0": 0.45998445998445997, "x1": 0.8382838283828383, "y1": 0.4731934731934732}, {"text": "of habit, we live our lives in a series of patterns and movements. Studying these patterns", "x0": 0.1331133113311331, "y0": 0.47785547785547783, "x1": 0.8437843784378438, "y1": 0.49106449106449107}, {"text": "can be useful in predicting what comes next, how we should prepare ourselves, or even", "x0": 0.1331133113311331, "y0": 0.494949494949495, "x1": 0.834983498349835, "y1": 0.5081585081585082}, {"text": "what we should speak out against in a meaningful way. In order to do these \u201cstudies\u201d or", "x0": 0.1331133113311331, "y0": 0.5128205128205128, "x1": 0.8382838283828383, "y1": 0.526029526029526}, {"text": "reach this higher level of understanding, we need a vehicle beyond textbooks and", "x0": 0.1331133113311331, "y0": 0.5306915306915307, "x1": 0.7876787678767877, "y1": 0.5439005439005439}, {"text": "documentaries and the ruins of old monuments. We need a way to relate to those of the", "x0": 0.1331133113311331, "y0": 0.5477855477855478, "x1": 0.834983498349835, "y1": 0.560994560994561}, {"text": "past, in the most human way possible. This is done through stories. It\u2019s how we make", "x0": 0.132013201320132, "y0": 0.5578865578865578, "x1": 0.8217821782178217, "y1": 0.581973581973582}, {"text": "sense of our lives and emotions. Historical fiction serves as that vehicle for story. It\u2019s", "x0": 0.1331133113311331, "y0": 0.5835275835275835, "x1": 0.8195819581958196, "y1": 0.5967365967365967}, {"text": "filled with characters that touch our hearts as well as challenges us to look deeply at our", "x0": 0.1331133113311331, "y0": 0.6006216006216006, "x1": 0.8415841584158416, "y1": 0.6138306138306139}, {"text": "patterns\u2014to see how evolved\u2014or haven\u2019t. So you see, historical fiction is always", "x0": 0.132013201320132, "y0": 0.6184926184926185, "x1": 0.847084708470847, "y1": 0.6317016317016317}, {"text": "relevant. It draws parallels from the past to our present, and teaches us to be empathetic", "x0": 0.1331133113311331, "y0": 0.6363636363636364, "x1": 0.8371837183718371, "y1": 0.6495726495726496}, {"text": "toward others. Finally, it demonstrates that though human nature doesn\u2019t change, how", "x0": 0.1331133113311331, "y0": 0.6534576534576535, "x1": 0.8250825082508251, "y1": 0.6666666666666666}, {"text": "we govern ourselves and treat others can.\u2019", "x0": 0.1331133113311331, "y0": 0.6713286713286714, "x1": 0.46974697469746973, "y1": 0.6845376845376845}, {"text": "Heather Webb, Rodin's Lover (Plume, 2015) extract from Historical Fiction is More", "x0": 0.1331133113311331, "y0": 0.7249417249417249, "x1": 0.8206820682068207, "y1": 0.7373737373737373}, {"text": "Important Than Ever: 10 Writers Weigh In Sometimes, the Best Way to Learn the", "x0": 0.132013201320132, "y0": 0.7435897435897436, "x1": 0.812981298129813, "y1": 0.756021756021756}, {"text": "Mistakes of the Past is to Feel Them, Crystal King (April 24, 2017).", "x0": 0.132013201320132, "y0": 0.7599067599067599, "x1": 0.6875687568756875, "y1": 0.7731157731157731}, {"text": "* m\u00e9lange: a mixture of different things", "x0": 0.1331133113311331, "y0": 0.8321678321678322, "x1": 0.45324532453245325, "y1": 0.8585858585858586}], [{"text": "Text 2 \u2014 Django Unchained written by Quentin Tarantino \u2014 script extract", "x0": 0.11001100110011001, "y0": 0.030303030303030304, "x1": 0.7491749174917491, "y1": 0.04351204351204351}, {"text": "EXT \u2014 Mountains - Night", "x0": 0.11001100110011001, "y0": 0.07459207459207459, "x1": 0.32893289328932895, "y1": 0.08702408702408702}, {"text": "The two men sit on a blanket with a nice picnic spread, spread out.", "x0": 0.1111111111111111, "y0": 0.10644910644910645, "x1": 0.6446644664466447, "y1": 0.11965811965811966}, {"text": "Django eats a cucumber sandwich with the crust cut off, and drinks a", "x0": 0.10891089108910891, "y0": 0.12276612276612277, "x1": 0.66996699669967, "y1": 0.13597513597513597}, {"text": "cup of tea around a campfire.", "x0": 0.11001100110011001, "y0": 0.13597513597513597, "x1": 0.3465346534653465, "y1": 0.1554001554001554}, {"text": "DJANGO", "x0": 0.46094609460946095, "y0": 0.1717171717171717, "x1": 0.5390539053905391, "y1": 0.18181818181818182}, {"text": "How did you know Broomhilda's first masters were German?", "x0": 0.11001100110011001, "y0": 0.20512820512820512, "x1": 0.6039603960396039, "y1": 0.21833721833721834}, {"text": "Dr. SCHULTZ", "x0": 0.44004400440044006, "y0": 0.23853923853923853, "x1": 0.55995599559956, "y1": 0.24786324786324787}, {"text": "Broomhilda is a German name. If they named her, it stands to reason they'd be German.", "x0": 0.11001100110011001, "y0": 0.2703962703962704, "x1": 0.8162816281628162, "y1": 0.2836052836052836}, {"text": "DJANGO", "x0": 0.46094609460946095, "y0": 0.30303030303030304, "x1": 0.5390539053905391, "y1": 0.31313131313131315}, {"text": "Lotsa gals where you from named Broomhilda?", "x0": 0.11001100110011001, "y0": 0.3356643356643357, "x1": 0.49394939493949397, "y1": 0.34887334887334887}, {"text": "Dr. SCHULTZ", "x0": 0.44004400440044006, "y0": 0.3690753690753691, "x1": 0.55995599559956, "y1": 0.37839937839937837}, {"text": "No, not so much. Broomhilda is the name of a character in one of the most popular of", "x0": 0.11001100110011001, "y0": 0.39316239316239315, "x1": 0.801980198019802, "y1": 0.4195804195804196}, {"text": "all the German legends.", "x0": 0.11001100110011001, "y0": 0.41802641802641805, "x1": 0.2992299229922992, "y1": 0.43123543123543123}, {"text": "DJANGO", "x0": 0.46094609460946095, "y0": 0.4506604506604507, "x1": 0.5390539053905391, "y1": 0.46076146076146074}, {"text": "Really? There's a story \u2018bout Broomhilda?", "x0": 0.11001100110011001, "y0": 0.47474747474747475, "x1": 0.44774477447744776, "y1": 0.5011655011655012}, {"text": "Dr. SCHULTZ", "x0": 0.44004400440044006, "y0": 0.5167055167055167, "x1": 0.55995599559956, "y1": 0.526029526029526}, {"text": "Yes there is.", "x0": 0.11001100110011001, "y0": 0.5322455322455323, "x1": 0.2079207920792079, "y1": 0.5423465423465423}, {"text": "DJANGO", "x0": 0.46094609460946095, "y0": 0.5648795648795649, "x1": 0.5390539053905391, "y1": 0.574980574980575}, {"text": "Do you know it?", "x0": 0.11001100110011001, "y0": 0.5982905982905983, "x1": 0.24312431243124313, "y1": 0.6114996114996115}, {"text": "Dr. SCHULTZ", "x0": 0.44004400440044006, "y0": 0.6317016317016317, "x1": 0.55995599559956, "y1": 0.6410256410256411}, {"text": "Every German knows that story. Would you like me to tell you?", "x0": 0.11001100110011001, "y0": 0.6635586635586636, "x1": 0.6259625962596259, "y1": 0.6767676767676768}, {"text": "Django nods his head, yes.", "x0": 0.10891089108910891, "y0": 0.6961926961926962, "x1": 0.32453245324532454, "y1": 0.7094017094017094}, {"text": "Dr. SCHULTZ", "x0": 0.44004400440044006, "y0": 0.7296037296037297, "x1": 0.55995599559956, "y1": 0.7389277389277389}, {"text": "Well Broomhilda was a princess. She was the daughter of Wotan, the god of all gods.", "x0": 0.11001100110011001, "y0": 0.752913752913753, "x1": 0.7986798679867987, "y1": 0.7793317793317793}, {"text": "Anyway, her father is really mad at her.", "x0": 0.11001100110011001, "y0": 0.7785547785547785, "x1": 0.429042904290429, "y1": 0.7917637917637917}, {"text": "(Text 2 continues on page 4)", "x0": 0.40374037403740376, "y0": 0.8275058275058275, "x1": 0.5962596259625963, "y1": 0.8376068376068376}], [{"text": "Text 2 (continued)", "x0": 0.43784378437843785, "y0": 0.018648018648018648, "x1": 0.5621562156215621, "y1": 0.029526029526029528}, {"text": "DJANGO", "x0": 0.46094609460946095, "y0": 0.04972804972804973, "x1": 0.5390539053905391, "y1": 0.05982905982905983}, {"text": "What she do?", "x0": 0.11001100110011001, "y0": 0.08236208236208237, "x1": 0.21782178217821782, "y1": 0.09246309246309246}, {"text": "Dr. SCHULTZ", "x0": 0.44004400440044006, "y0": 0.1320901320901321, "x1": 0.55995599559956, "y1": 0.1414141414141414}, {"text": "I don't exactly remember. I think she disobeys him in some way. So at first he's just going to", "x0": 0.11001100110011001, "y0": 0.16394716394716394, "x1": 0.8547854785478548, "y1": 0.17715617715617715}, {"text": "obliterate her -", "x0": 0.11001100110011001, "y0": 0.18026418026418026, "x1": 0.22662266226622663, "y1": 0.19036519036519037}, {"text": "DJANGO", "x0": 0.46094609460946095, "y0": 0.21367521367521367, "x1": 0.5390539053905391, "y1": 0.22377622377622378}, {"text": "Obliterate... what does that mean?", "x0": 0.11001100110011001, "y0": 0.2463092463092463, "x1": 0.38283828382838286, "y1": 0.2564102564102564}, {"text": "Dr. SCHULTZ", "x0": 0.44004400440044006, "y0": 0.27972027972027974, "x1": 0.55995599559956, "y1": 0.289044289044289}, {"text": "Like blow up.", "x0": 0.11001100110011001, "y0": 0.31157731157731156, "x1": 0.22002200220022003, "y1": 0.3247863247863248}, {"text": "He pantomimes an explosion.", "x0": 0.10891089108910891, "y0": 0.3442113442113442, "x1": 0.34543454345434543, "y1": 0.35742035742035744}, {"text": "DJANGO", "x0": 0.46094609460946095, "y0": 0.37684537684537683, "x1": 0.5390539053905391, "y1": 0.38694638694638694}, {"text": "Phew, that's pretty mad.", "x0": 0.11001100110011001, "y0": 0.41025641025641024, "x1": 0.30143014301430143, "y1": 0.4234654234654235}, {"text": "Dr. SCHULTZ", "x0": 0.44004400440044006, "y0": 0.44366744366744365, "x1": 0.55995599559956, "y1": 0.452991452991453}, {"text": "Yes, it is, and like most fathers, given a little time, he calms down a bit. He's still mad at her. He", "x0": 0.11001100110011001, "y0": 0.47241647241647244, "x1": 0.8855885588558856, "y1": 0.4926184926184926}, {"text": "still wants to punish her. Just not ... blow her up. So instead what he does, is he puts her high on", "x0": 0.11001100110011001, "y0": 0.49184149184149184, "x1": 0.8822882288228823, "y1": 0.5050505050505051}, {"text": "top of a mountain.", "x0": 0.11001100110011001, "y0": 0.5081585081585082, "x1": 0.2563256325632563, "y1": 0.5213675213675214}, {"text": "DJANGO", "x0": 0.46094609460946095, "y0": 0.5407925407925408, "x1": 0.5390539053905391, "y1": 0.5508935508935509}, {"text": "Broomhilda's on a mountain?", "x0": 0.11001100110011001, "y0": 0.5734265734265734, "x1": 0.34543454345434543, "y1": 0.5835275835275835}, {"text": "Dr. SCHULTZ", "x0": 0.44004400440044006, "y0": 0.6068376068376068, "x1": 0.55995599559956, "y1": 0.6161616161616161}, {"text": "It's a German legend, there's always going to be a mountain in there somewhere. So, he puts her", "x0": 0.11001100110011001, "y0": 0.6394716394716394, "x1": 0.8833883388338833, "y1": 0.6526806526806527}, {"text": "on top of the mountain and he puts a fire breathing dragon there to guard the mountain and then", "x0": 0.11001100110011001, "y0": 0.6480186480186481, "x1": 0.8800880088008801, "y1": 0.6721056721056721}, {"text": "he surrounds her in circle of hellfire. And there Broomhilda shall remain, unless a hero arises", "x0": 0.11001100110011001, "y0": 0.668997668997669, "x1": 0.8602860286028603, "y1": 0.6891996891996892}, {"text": "brave enough to save her.", "x0": 0.11001100110011001, "y0": 0.6884226884226884, "x1": 0.3146314631463146, "y1": 0.7016317016317016}, {"text": "DJANGO", "x0": 0.46094609460946095, "y0": 0.721056721056721, "x1": 0.5390539053905391, "y1": 0.7311577311577312}, {"text": "Does a fella arise?", "x0": 0.11001100110011001, "y0": 0.7536907536907537, "x1": 0.2563256325632563, "y1": 0.7637917637917638}, {"text": "From now on as Dr.Schultz talks, he's beginning to realize something he", "x0": 0.10891089108910891, "y0": 0.7863247863247863, "x1": 0.6941694169416942, "y1": 0.7995337995337995}, {"text": "wasn't aware of when the conversation started.", "x0": 0.11001100110011001, "y0": 0.8026418026418026, "x1": 0.48734873487348734, "y1": 0.8158508158508159}, {"text": "(Text 2 continues on page 5)", "x0": 0.40374037403740376, "y0": 0.8686868686868687, "x1": 0.5962596259625963, "y1": 0.8787878787878788}, {"text": "4", "x0": 0.4961496149614962, "y0": 0.9020979020979021, "x1": 0.5038503850385039, "y1": 0.9106449106449106}], [{"text": "Text 2 (continued)", "x0": 0.43784378437843785, "y0": 0.03496503496503497, "x1": 0.5621562156215621, "y1": 0.04584304584304584}, {"text": "Dr. SCHULTZ", "x0": 0.44004400440044006, "y0": 0.06604506604506605, "x1": 0.55995599559956, "y1": 0.07614607614607614}, {"text": "Yes Django,", "x0": 0.11001100110011001, "y0": 0.09867909867909867, "x1": 0.20902090209020902, "y1": 0.11188811188811189}, {"text": "matter he does. A fella named, Sigfried.", "x0": 0.25192519251925194, "y0": 0.09867909867909867, "x1": 0.5720572057205721, "y1": 0.11188811188811189}, {"text": "DJANGO", "x0": 0.46094609460946095, "y0": 0.16394716394716394, "x1": 0.5390539053905391, "y1": 0.17404817404817405}, {"text": "Does Sigfried save her?", "x0": 0.11001100110011001, "y0": 0.19735819735819735, "x1": 0.30033003300330036, "y1": 0.21056721056721056}, {"text": "Dr. SCHULTZ", "x0": 0.44004400440044006, "y0": 0.22999222999222999, "x1": 0.55995599559956, "y1": 0.2400932400932401}, {"text": "Yes, he does, and quite spectacularly, so. Now true, he is assisted in his triumph by a truly, truly,", "x0": 0.11001100110011001, "y0": 0.26262626262626265, "x1": 0.88998899889989, "y1": 0.27583527583527584}, {"text": "remarkable sword, still, having said that, Sigfried triumphs over all of his obstacles not just due", "x0": 0.11001100110011001, "y0": 0.27583527583527584, "x1": 0.8778877887788779, "y1": 0.29603729603729606}, {"text": "to his sword, but due to his courage. He scales the mountain, because he's not afraid of it. He", "x0": 0.11001100110011001, "y0": 0.29215229215229216, "x1": 0.856985698569857, "y1": 0.31157731157731156}, {"text": "defeats the dragon, because he's not afraid of him.", "x0": 0.11001100110011001, "y0": 0.31157731157731156, "x1": 0.5115511551155115, "y1": 0.3247863247863248}, {"text": "Dr. SCHULTZ", "x0": 0.44004400440044006, "y0": 0.3605283605283605, "x1": 0.55995599559956, "y1": 0.3706293706293706}, {"text": "He walks through hellfire because Broomhilda's worth it.", "x0": 0.11001100110011001, "y0": 0.3939393939393939, "x1": 0.5698569856985699, "y1": 0.40714840714840717}, {"text": "Afier that last line of dialogue...the two men just let a moment pass", "x0": 0.10891089108910891, "y0": 0.42657342657342656, "x1": 0.647964796479648, "y1": 0.4397824397824398}, {"text": "as they nibble on their sandwiches.", "x0": 0.11001100110011001, "y0": 0.4428904428904429, "x1": 0.39053905390539057, "y1": 0.4560994560994561}, {"text": "DJANGO", "x0": 0.46094609460946095, "y0": 0.4864024864024864, "x1": 0.5390539053905391, "y1": 0.4965034965034965}, {"text": "Why you care what happens to me? Why you care if I find my wife?", "x0": 0.11001100110011001, "y0": 0.5104895104895105, "x1": 0.6622662266226622, "y1": 0.5369075369075369}, {"text": "Dr. SCHULTZ", "x0": 0.44004400440044006, "y0": 0.5516705516705517, "x1": 0.55995599559956, "y1": 0.5617715617715617}, {"text": "Well frankly, I've never given anybody their freedom before. And now that I have", "x0": 0.11001100110011001, "y0": 0.5843045843045843, "x1": 0.77007700770077, "y1": 0.5975135975135976}, {"text": "I feel vaguely responsible for you. You're just not ready to go off on your own, it\u2019s that simple.", "x0": 0.11001100110011001, "y0": 0.6006216006216006, "x1": 0.8723872387238724, "y1": 0.6138306138306139}, {"text": "You're too green, you'll get hurt, Plus when a German meets a real life Sigfried, it's kind of a big", "x0": 0.11001100110011001, "y0": 0.6083916083916084, "x1": 0.8866886688668867, "y1": 0.6348096348096348}, {"text": "deal. As a German, I'm obliged to help you on your quest to rescue your beloved Broomhilda.", "x0": 0.11001100110011001, "y0": 0.6332556332556333, "x1": 0.8646864686468647, "y1": 0.6464646464646465}, {"text": "Django accepts that response.", "x0": 0.15951595159515952, "y0": 0.682983682983683, "x1": 0.40154015401540155, "y1": 0.6961926961926962}, {"text": "What follows is a MONTAGE covering the five months that Django and", "x0": 0.1628162816281628, "y0": 0.7156177156177156, "x1": 0.7403740374037404, "y1": 0.7288267288267288}, {"text": "Schultz partner up as bounty hunters. Schultz wears his normal", "x0": 0.15951595159515952, "y0": 0.7319347319347319, "x1": 0.671067106710671, "y1": 0.7451437451437452}, {"text": "ensemble. Django wears his cool looking Green Jacket, unless it's", "x0": 0.16061606160616063, "y0": 0.7482517482517482, "x1": 0.693069306930693, "y1": 0.7614607614607615}, {"text": "really cold, which a lot of this montage is. Then he still wears Ace", "x0": 0.16061606160616063, "y0": 0.7567987567987567, "x1": 0.6919691969196919, "y1": 0.7816627816627817}, {"text": "Specks raw hide winter coat over his cool clothes.", "x0": 0.15951595159515952, "y0": 0.7808857808857809, "x1": 0.5610561056105611, "y1": 0.7940947940947941}, {"text": "End of Text 2", "x0": 0.44224422442244227, "y0": 0.846930846930847, "x1": 0.5577557755775577, "y1": 0.857031857031857}], [{"text": "Question 1 (25 marks)", "x0": 0.11001100110011001, "y0": 0.08547008547008547, "x1": 0.32453245324532454, "y1": 0.10023310023310024}, {"text": "In your response to parts (a) and (b), draw on your understanding of the module Literary Worlds", "x0": 0.11001100110011001, "y0": 0.1452991452991453, "x1": 0.8866886688668867, "y1": 0.1585081585081585}, {"text": "and the extract(s) provided.", "x0": 0.11001100110011001, "y0": 0.16317016317016317, "x1": 0.33003300330033003, "y1": 0.17637917637917638}, {"text": "(a) Use Text | and Text 2 to answer this part. 10", "x0": 0.11001100110011001, "y0": 0.21756021756021757, "x1": 0.8547854785478548, "y1": 0.23076923076923078}, {"text": "To what extent do both extracts resonate with your understanding of why we compose literary", "x0": 0.11001100110011001, "y0": 0.24475524475524477, "x1": 0.8679867986798679, "y1": 0.257964257964258}, {"text": "worlds?", "x0": 0.11001100110011001, "y0": 0.2618492618492618, "x1": 0.17271727172717272, "y1": 0.27195027195027194}, {"text": "(b) Use Text 2 to answer this part. 15,", "x0": 0.11001100110011001, "y0": 0.3162393162393162, "x1": 0.8547854785478548, "y1": 0.32944832944832947}, {"text": "Drawing Inspiration from Text 2 and the characters\u2019 diversity, compose a moment of emotional", "x0": 0.11001100110011001, "y0": 0.3706293706293706, "x1": 0.8800880088008801, "y1": 0.3838383838383838}, {"text": "significance, where TWO characters, from diverse backgrounds, uncover a profound reality.", "x0": 0.11001100110011001, "y0": 0.3885003885003885, "x1": 0.8525852585258525, "y1": 0.4017094017094017}, {"text": "Extra writing booklets are available \u2014 Label clearly", "x0": 0.11001100110011001, "y0": 0.44366744366744365, "x1": 0.5489548954895489, "y1": 0.4560994560994561}, {"text": "End of Question 1", "x0": 0.4235423542354235, "y0": 0.7428127428127428, "x1": 0.5753575357535754, "y1": 0.7544677544677545}, {"text": "End of Section I", "x0": 0.43234323432343236, "y0": 0.77000777000777, "x1": 0.5687568756875687, "y1": 0.7793317793317793}], [{"text": "Section II \u2014 Electives", "x0": 0.11331133113311331, "y0": 0.10411810411810411, "x1": 0.3333333333333333, "y1": 0.11577311577311578}, {"text": "25 marks", "x0": 0.11331133113311331, "y0": 0.1452991452991453, "x1": 0.1925192519251925, "y1": 0.15462315462315462}, {"text": "Attempt ONE question from Questions 2-6", "x0": 0.11331133113311331, "y0": 0.18026418026418026, "x1": 0.4829482948294829, "y1": 0.1926961926961927}, {"text": "Allow about 1 hour for this section", "x0": 0.11331133113311331, "y0": 0.21445221445221446, "x1": 0.40924092409240925, "y1": 0.22377622377622378}, {"text": "Answer the question ina SEPARATE writing booklet. Extra writing booklets are available.", "x0": 0.11331133113311331, "y0": 0.2494172494172494, "x1": 0.8503850385038504, "y1": 0.26262626262626265}, {"text": "Your answer will be assessed on how well you:", "x0": 0.13751375137513752, "y0": 0.2789432789432789, "x1": 0.5181518151815182, "y1": 0.29215229215229216}, {"text": "\u00abdemonstrate an understanding of the ideas and values of Literary Worlds and how", "x0": 0.13751375137513752, "y0": 0.2905982905982906, "x1": 0.8206820682068207, "y1": 0.317016317016317}, {"text": "they are shaped and reflected in texts", "x0": 0.16061606160616063, "y0": 0.31546231546231546, "x1": 0.45874587458745875, "y1": 0.32867132867132864}, {"text": "craft a sustained composition appropriate to the question, demonstrating control of the", "x0": 0.16061606160616063, "y0": 0.3356643356643357, "x1": 0.8558855885588559, "y1": 0.34887334887334887}, {"text": "use of language", "x0": 0.1617161716171617, "y0": 0.35275835275835277, "x1": 0.28602860286028603, "y1": 0.36596736596736595}, {"text": "Question 2 \u2014 Elective 1: Literary Homelands (25 marks)", "x0": 0.11331133113311331, "y0": 0.41647241647241645, "x1": 0.5984598459845984, "y1": 0.4296814296814297}, {"text": "To what extent has your study of ideas and values in Literary Homelands enhanced your", "x0": 0.11331133113311331, "y0": 0.4467754467754468, "x1": 0.8261826182618262, "y1": 0.45998445998445997}, {"text": "understanding of the relationship between marginalisation and empowerment?", "x0": 0.11331133113311331, "y0": 0.4553224553224553, "x1": 0.7447744774477447, "y1": 0.48174048174048173}, {"text": "In your response, refer to TWO of your prescribed texts and at least ONE related text of your", "x0": 0.11441144114411442, "y0": 0.49184149184149184, "x1": 0.8646864686468647, "y1": 0.5112665112665112}, {"text": "own choosing.", "x0": 0.11331133113311331, "y0": 0.5112665112665112, "x1": 0.22882288228822883, "y1": 0.5244755244755245}, {"text": "The prescribed texts are:", "x0": 0.11331133113311331, "y0": 0.5718725718725719, "x1": 0.3102310231023102, "y1": 0.585081585081585}, {"text": "+ Prose Fiction \u2014 Aravind Adiga, The White Tiger", "x0": 0.11331133113311331, "y0": 0.6052836052836053, "x1": 0.5379537953795379, "y1": 0.6184926184926185}, {"text": "\u2014 EM Forster, A Passage to India", "x0": 0.2794279427942794, "y0": 0.6285936285936286, "x1": 0.5698569856985699, "y1": 0.6418026418026418}, {"text": "\u2014 Colm T\u00e9ibin, Brooklyn", "x0": 0.2794279427942794, "y0": 0.6519036519036518, "x1": 0.4961496149614962, "y1": 0.6651126651126651}, {"text": "+ Poetry \u2014 Eileen Chong, Burning Rice", "x0": 0.11331133113311331, "y0": 0.6822066822066822, "x1": 0.44664466446644663, "y1": 0.6954156954156954}, {"text": "The prescribed poems are:", "x0": 0.11331133113311331, "y0": 0.7008547008547008, "x1": 0.32453245324532454, "y1": 0.714063714063714}, {"text": "Burning Rice", "x0": 0.3333333333333333, "y0": 0.7249417249417249, "x1": 0.44004400440044006, "y1": 0.7373737373737373}, {"text": "Mid-autumn Mooncakes", "x0": 0.3333333333333333, "y0": 0.7404817404817405, "x1": 0.5291529152915292, "y1": 0.7505827505827506}, {"text": "My Hakka Grandmother", "x0": 0.3333333333333333, "y0": 0.7575757575757576, "x1": 0.5313531353135313, "y1": 0.7707847707847708}, {"text": "Shophouse, Victoria Street", "x0": 0.3333333333333333, "y0": 0.7738927738927739, "x1": 0.5489548954895489, "y1": 0.7871017871017871}, {"text": "Chinese Ginseng", "x0": 0.33443344334433445, "y0": 0.790986790986791, "x1": 0.47084708470847086, "y1": 0.8041958041958042}, {"text": "Winter Meeting", "x0": 0.3355335533553355, "y0": 0.8080808080808081, "x1": 0.4598459845984598, "y1": 0.8205128205128205}, {"text": "Singapore", "x0": 0.3333333333333333, "y0": 0.8243978243978244, "x1": 0.4158415841584158, "y1": 0.8368298368298368}, {"text": "+ Andrew Bovell, The Secret River [by Kate Grenville \u2014 An adaptation for the", "x0": 0.11991199119911991, "y0": 0.8461538461538461, "x1": 0.8415841584158416, "y1": 0.8593628593628594}, {"text": "stage by Andrew Bovell]", "x0": 0.30913091309130913, "y0": 0.8632478632478633, "x1": 0.5071507150715071, "y1": 0.8764568764568764}], [{"text": "arah Gavron, Brick Lane", "x0": 0.2156215621562156, "y0": 0.003108003108003108, "x1": 0.4136413641364136, "y1": 0.01554001554001554}, {"text": "Question 3 \u2014 Elective 2: Worlds of Upheaval (25 marks)", "x0": 0.11991199119911991, "y0": 0.12276612276612277, "x1": 0.6017601760176018, "y1": 0.13597513597513597}, {"text": "To what extent has your study of ideas and values in Worlds of Upheaval enhanced your", "x0": 0.11991199119911991, "y0": 0.1561771561771562, "x1": 0.8338833883388339, "y1": 0.16938616938616938}, {"text": "understanding of the relationship between aspiration and acceptance?", "x0": 0.11991199119911991, "y0": 0.16472416472416473, "x1": 0.6776677667766776, "y1": 0.19114219114219114}, {"text": "In your response, refer to TWO of your prescribed texts and at least ONE related text of your", "x0": 0.11991199119911991, "y0": 0.19735819735819735, "x1": 0.8679867986798679, "y1": 0.22377622377622378}, {"text": "own choosing.", "x0": 0.11991199119911991, "y0": 0.222999222999223, "x1": 0.23542354235423543, "y1": 0.23620823620823622}, {"text": "The prescribed texts are:", "x0": 0.11991199119911991, "y0": 0.29292929292929293, "x1": 0.31573157315731576, "y1": 0.3061383061383061}, {"text": "+ Prose Fiction \u2014 Elizabeth Gaskell, North and South", "x0": 0.11991199119911991, "y0": 0.32634032634032634, "x1": 0.5610561056105611, "y1": 0.33877233877233875}, {"text": "\u2014 Mary Shelley, Frankenstein", "x0": 0.28492849284928495, "y0": 0.34965034965034963, "x1": 0.5346534653465347, "y1": 0.3628593628593629}, {"text": "\u2014 Madeleine Thien, Do Not Say We Have Nothing", "x0": 0.28492849284928495, "y0": 0.372960372960373, "x1": 0.6985698569856986, "y1": 0.3861693861693862}, {"text": "+ Poetry \u2014 Seamus Heaney, Opened Ground: Poems 1966-1996", "x0": 0.11991199119911991, "y0": 0.40714840714840717, "x1": 0.7238723872387238, "y1": 0.4211344211344211}, {"text": "The prescribed poems are:", "x0": 0.3102310231023102, "y0": 0.432012432012432, "x1": 0.5214521452145214, "y1": 0.44522144522144524}, {"text": "* Digging", "x0": 0.31133113311331134, "y0": 0.4553224553224553, "x1": 0.39933993399339934, "y1": 0.46853146853146854}, {"text": "* The Strand at Lough Beg", "x0": 0.31133113311331134, "y0": 0.47241647241647244, "x1": 0.5368536853685368, "y1": 0.48562548562548563}, {"text": "* Casualty", "x0": 0.31133113311331134, "y0": 0.4887334887334887, "x1": 0.40484048404840484, "y1": 0.5019425019425019}, {"text": "* Funeral Rites", "x0": 0.31133113311331134, "y0": 0.5050505050505051, "x1": 0.44334433443344334, "y1": 0.5151515151515151}, {"text": "* from Whatever You Say Say Nothing", "x0": 0.31133113311331134, "y0": 0.5221445221445221, "x1": 0.6303630363036303, "y1": 0.5353535353535354}, {"text": "* Triptych", "x0": 0.31133113311331134, "y0": 0.5384615384615384, "x1": 0.4004400440044004, "y1": 0.5516705516705517}, {"text": "+ Drama \u2014 Samuel Beckett, Waiting for Godot", "x0": 0.11991199119911991, "y0": 0.57187257187257