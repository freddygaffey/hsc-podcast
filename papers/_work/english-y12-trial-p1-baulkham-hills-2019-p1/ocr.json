[[{"text": "BAULKHAM HILLS", "x0": 0.07793633369923161, "y0": 0.046620046620046623, "x1": 0.1986827661909989, "y1": 0.05672105672105672}, {"text": "HIGHER", "x0": 0.28210757409440174, "y0": 0.12276612276612277, "x1": 0.32930845225027444, "y1": 0.12975912975912976}, {"text": "ScHooL 2019", "x0": 0.28210757409440174, "y0": 0.13053613053613053, "x1": 0.6092206366630076, "y1": 0.14840714840714841}, {"text": "CERTIFICATE", "x0": 0.28210757409440174, "y0": 0.14918414918414918, "x1": 0.3633369923161361, "y1": 0.1561771561771562}, {"text": "\u2018TRIAL EXAMINATION", "x0": 0.2810098792535675, "y0": 0.1623931623931624, "x1": 0.40504939626783754, "y1": 0.16938616938616938}, {"text": "English Advanced", "x0": 0.12403951701427003, "y0": 0.27350427350427353, "x1": 0.535675082327113, "y1": 0.3108003108003108}, {"text": "Paper 1 \u2014 Texts and Human Experiences", "x0": 0.12184412733260154, "y0": 0.3442113442113442, "x1": 0.8068057080131723, "y1": 0.36985236985236986}, {"text": "General Reading time \u2014 10 minutes", "x0": 0.11964873765093303, "y0": 0.49572649572649574, "x1": 0.5203073545554336, "y1": 0.5167055167055167}, {"text": "Instructions Working time \u2014 1 hour and 30 minutes", "x0": 0.1207464324917673, "y0": 0.5174825174825175, "x1": 0.6245883644346871, "y1": 0.5345765345765345}, {"text": "Write using black pen", "x0": 0.2843029637760702, "y0": 0.5415695415695416, "x1": 0.47310647639956094, "y1": 0.5555555555555556}, {"text": "A Stimulus Booklet is provided with this paper", "x0": 0.283205268935236, "y0": 0.5625485625485626, "x1": 0.6904500548847421, "y1": 0.5765345765345765}, {"text": "Total marks: Section | - 20 marks (page 2)", "x0": 0.11964873765093303, "y0": 0.6153846153846154, "x1": 0.5389681668496158, "y1": 0.6293706293706294}, {"text": "40 Attempt all questions", "x0": 0.11964873765093303, "y0": 0.6348096348096348, "x1": 0.47091108671789245, "y1": 0.6542346542346542}, {"text": "Allow about 45 minutes for this section", "x0": 0.283205268935236, "y0": 0.662004662004662, "x1": 0.6278814489571899, "y1": 0.6728826728826729}, {"text": "Section Il - 20 marks (pages 3-4)", "x0": 0.2678375411635565, "y0": 0.6930846930846931, "x1": 0.5729967069154775, "y1": 0.7070707070707071}, {"text": "\u00a9 Attempt Question 5", "x0": 0.2678375411635565, "y0": 0.7187257187257188, "x1": 0.4544456641053787, "y1": 0.7327117327117327}, {"text": "Allow about 45 minutes for this section", "x0": 0.283205268935236, "y0": 0.7397047397047397, "x1": 0.6278814489571899, "y1": 0.7505827505827506}], [{"text": "Section I", "x0": 0.07683863885839737, "y0": 0.05283605283605284, "x1": 0.16245883644346873, "y1": 0.0644910644910645}, {"text": "20 marks", "x0": 0.09220636663007684, "y0": 0.09634809634809635, "x1": 0.1712403951701427, "y1": 0.10644910644910645}, {"text": "Attempt all questions", "x0": 0.09220636663007684, "y0": 0.11266511266511267, "x1": 0.27442371020856204, "y1": 0.1258741258741259}, {"text": "Allow about 45 minutes for this section", "x0": 0.09220636663007684, "y0": 0.128982128982129, "x1": 0.424807903402854, "y1": 0.13908313908313907}, {"text": "Your answer will be assessed on how well you:", "x0": 0.10757409440175632, "y0": 0.16161616161616163, "x1": 0.4862788144895719, "y1": 0.17404817404817405}, {"text": "+ demonstrate understanding of human experiences in texts", "x0": 0.12184412733260154, "y0": 0.18104118104118105, "x1": 0.601536772777168, "y1": 0.19347319347319347}, {"text": "+ analyse, explain and assess the ways human experiences are represented in texts", "x0": 0.12184412733260154, "y0": 0.20124320124320125, "x1": 0.7804610318331504, "y1": 0.21367521367521367}, {"text": "Examine Texts 1, 2, 3, 4, and 5 in the Stimulus Booklet carefully and then answer the questions", "x0": 0.09220636663007684, "y0": 0.2571872571872572, "x1": 0.8759604829857299, "y1": 0.2703962703962704}, {"text": "below", "x0": 0.09110867178924259, "y0": 0.27505827505827507, "x1": 0.13721185510428102, "y1": 0.28438228438228436}, {"text": "1. Explain how Text 1 represents the evolutionary nature of human experience. 4", "x0": 0.09440175631174534, "y0": 0.3076923076923077, "x1": 0.8726673984632273, "y1": 0.3209013209013209}, {"text": "In Text 2, how does the composer use language to convey both the potential 4", "x0": 0.13721185510428102, "y0": 0.3411033411033411, "x1": 0.8726673984632273, "y1": 0.3543123543123543}, {"text": "i", "x0": 0.09220636663007684, "y0": 0.3418803418803419, "x1": 0.10428100987925357, "y1": 0.35120435120435123}, {"text": "and limitations of human experience?", "x0": 0.13721185510428102, "y0": 0.35664335664335667, "x1": 0.43798024149286496, "y1": 0.36985236985236986}, {"text": "3. Assess how effectively the writer in Text 3 presents a point of view on the", "x0": 0.09220636663007684, "y0": 0.3885003885003885, "x1": 0.7618002195389681, "y1": 0.4017094017094017}, {"text": "ways different generations have different approaches to the human experience", "x0": 0.13721185510428102, "y0": 0.4048174048174048, "x1": 0.7618002195389681, "y1": 0.41802641802641805}, {"text": "of communication.", "x0": 0.13611416026344675, "y0": 0.4211344211344211, "x1": 0.2864983534577388, "y1": 0.43123543123543123}, {"text": "4. Explain how Text 4 and Text 5 evoke the experience of childhood memories. 7", "x0": 0.09110867178924259, "y0": 0.45376845376845376, "x1": 0.8704720087815587, "y1": 0.466977466977467}], [{"text": "Section II", "x0": 0.07683863885839737, "y0": 0.031857031857031856, "x1": 0.17233809001097694, "y1": 0.04351204351204351}, {"text": "20 marks", "x0": 0.09110867178924259, "y0": 0.06682206682206682, "x1": 0.17014270032930845, "y1": 0.07692307692307693}, {"text": "Attempt Question 5", "x0": 0.09110867178924259, "y0": 0.08391608391608392, "x1": 0.25905598243688255, "y1": 0.09712509712509712}, {"text": "Allow about 45 minutes for this section", "x0": 0.09110867178924259, "y0": 0.10023310023310024, "x1": 0.424807903402854, "y1": 0.11033411033411034}, {"text": "Your answer will be assessed on how well you:", "x0": 0.13721185510428102, "y0": 0.1351981351981352, "x1": 0.48518111964873767, "y1": 0.14685314685314685}, {"text": "+ demonstrate understanding of human experiences in texts", "x0": 0.1525795828759605, "y0": 0.15306915306915306, "x1": 0.6081229418221734, "y1": 0.1655011655011655}, {"text": "+ analyse, explain and assess the ways human experiences are represented in texts", "x0": 0.1525795828759605, "y0": 0.17249417249417248, "x1": 0.7727771679473107, "y1": 0.18414918414918416}, {"text": "+ organise, develop and express ideas using language appropriate to audience, purpose", "x0": 0.1525795828759605, "y0": 0.19114219114219114, "x1": 0.8057080131723381, "y1": 0.20279720279720279}, {"text": "and context", "x0": 0.1800219538968167, "y0": 0.2097902097902098, "x1": 0.26344676180021953, "y1": 0.21833721833721834}, {"text": "Prose Fiction (20 marks)", "x0": 0.08562019758507135, "y0": 0.257964257964258, "x1": 0.29088913282107576, "y1": 0.2703962703962704}, {"text": "In what ways has your perception of the human experience been shaped by the use of setting in", "x0": 0.0867178924259056, "y0": 0.2905982905982906, "x1": 0.8792535675082327, "y1": 0.3038073038073038}, {"text": "prose fiction?", "x0": 0.08562019758507135, "y0": 0.3076923076923077, "x1": 0.1942919868276619, "y1": 0.3209013209013209}, {"text": "OR", "x0": 0.46871569703622395, "y0": 0.3411033411033411, "x1": 0.4961580680570801, "y1": 0.3504273504273504}, {"text": "Poetry (20 marks)", "x0": 0.08562019758507135, "y0": 0.35664335664335667, "x1": 0.23380900109769484, "y1": 0.36985236985236986}, {"text": "Explain how the narrative voice in the prescribed poems has challenged your understanding of the", "x0": 0.08562019758507135, "y0": 0.3822843822843823, "x1": 0.8781558726673985, "y1": 0.40714840714840717}, {"text": "human experience.", "x0": 0.08562019758507135, "y0": 0.40559440559440557, "x1": 0.23600439077936333, "y1": 0.4188034188034188}, {"text": "OR", "x0": 0.46871569703622395, "y0": 0.439005439005439, "x1": 0.4961580680570801, "y1": 0.4483294483294483}, {"text": "Shakespearean Drama (20 marks)", "x0": 0.08562019758507135, "y0": 0.45454545454545453, "x1": 0.3721185510428101, "y1": 0.4677544677544678}, {"text": "In The Merchant of Venice, Shakespeare engages the audience through his representation of conflict", "x0": 0.0867178924259056, "y0": 0.48717948717948717, "x1": 0.8781558726673985, "y1": 0.5003885003885004}, {"text": "between individuals and between collective human experiences.", "x0": 0.08562019758507135, "y0": 0.5042735042735043, "x1": 0.5993413830954994, "y1": 0.5174825174825175}, {"text": "Analyse this statement with close reference to the play as a whole.", "x0": 0.08562019758507135, "y0": 0.5369075369075369, "x1": 0.6180021953896817, "y1": 0.5501165501165501}, {"text": "OR", "x0": 0.46871569703622395, "y0": 0.5703185703185704, "x1": 0.4961580680570801, "y1": 0.5796425796425796}, {"text": "Media (20 marks)", "x0": 0.08562019758507135, "y0": 0.5858585858585859, "x1": 0.23161361141602635, "y1": 0.5982905982905983}, {"text": "\u201cWe cannot truly judge other people\u2019s experience until we walk in their shoes.\u201d", "x0": 0.0889132821075741, "y0": 0.6184926184926185, "x1": 0.7299670691547749, "y1": 0.6317016317016317}, {"text": "Analyse this statement with close reference to Go Back to Where You Came From.", "x0": 0.08562019758507135, "y0": 0.6511266511266511, "x1": 0.7497255762897914, "y1": 0.6643356643356644}, {"text": "OR", "x0": 0.46871569703622395, "y0": 0.6845376845376845, "x1": 0.4961580680570801, "y1": 0.6938616938616938}, {"text": "Nonfiction (20 marks)", "x0": 0.08562019758507135, "y0": 0.7171717171717171, "x1": 0.2678375411635565, "y1": 0.7296037296037297}, {"text": "How does the use of narrative voice enhance your understanding of personal experience in", "x0": 0.0867178924259056, "y0": 0.7498057498057498, "x1": 0.8781558726673985, "y1": 0.763014763014763}, {"text": "nonfiction?", "x0": 0.08562019758507135, "y0": 0.7661227661227661, "x1": 0.1756311745334797, "y1": 0.7762237762237763}, {"text": "OR", "x0": 0.46871569703622395, "y0": 0.7995337995337995, "x1": 0.4961580680570801, "y1": 0.8088578088578089}, {"text": "Film (20 marks)", "x0": 0.08562019758507135, "y0": 0.815073815073815, "x1": 0.21734357848518113, "y1": 0.8275058275058275}, {"text": "Explore how historical context in Billy Elliott has been used to shape your perception of the", "x0": 0.08562019758507135, "y0": 0.8477078477078477, "x1": 0.8781558726673985, "y1": 0.8609168609168609}, {"text": "challenges of the human experience.", "x0": 0.08562019758507135, "y0": 0.8648018648018648, "x1": 0.3765093304061471, "y1": 0.878010878010878}, {"text": "The prescribed texts are listed in the Stimulus Booklet", "x0": 0.13611416026344675, "y0": 0.8982128982128982, "x1": 0.5718990120746432, "y1": 0.9106449106449106}], [{"text": "| HIGHER", "x0": 0.2645444566410538, "y0": 0.18104118104118105, "x1": 0.32930845225027444, "y1": 0.22843822843822845}, {"text": "CERTIFICATE 20 19", "x0": 0.28210757409440174, "y0": 0.19036519036519037, "x1": 0.5806805708013172, "y1": 0.22144522144522144}, {"text": "English Advanced", "x0": 0.12403951701427003, "y0": 0.3108003108003108, "x1": 0.5422612513721186, "y1": 0.34887334887334887}, {"text": "Paper 1 \u2014 Texts and Human Experiences", "x0": 0.12294182217343579, "y0": 0.38306138306138304, "x1": 0.8243688254665203, "y1": 0.4087024087024087}, {"text": "Stimulus Booklet for Section |", "x0": 0.1207464324917673, "y0": 0.44366744366744365, "x1": 0.6092206366630076, "y1": 0.46464646464646464}, {"text": "and", "x0": 0.12184412733260154, "y0": 0.4755244755244755, "x1": 0.18551042810098792, "y1": 0.49572649572649574}, {"text": "List of prescribed texts for Section II", "x0": 0.12184412733260154, "y0": 0.5066045066045066, "x1": 0.7156970362239298, "y1": 0.533022533022533}, {"text": "Section | + Text 1 - Images.", "x0": 0.10208562019758508, "y0": 0.6278166278166278, "x1": 0.4138309549945115, "y1": 0.6425796425796426}, {"text": "+ Text 2 \u2014 Nonfiction extract", "x0": 0.23929747530186607, "y0": 0.6480186480186481, "x1": 0.4983534577387486, "y1": 0.6581196581196581}, {"text": "+ Text 3- Essay", "x0": 0.23929747530186607, "y0": 0.6666666666666666, "x1": 0.4039517014270033, "y1": 0.6798756798756799}, {"text": "+ Text 4\u2014Poem..", "x0": 0.23929747530186607, "y0": 0.6853146853146853, "x1": 0.4127332601536773, "y1": 0.6954156954156954}, {"text": "+ Text 5 \u2014 Fiction extract ..", "x0": 0.23929747530186607, "y0": 0.703962703962704, "x1": 0.49176728869374314, "y1": 0.714063714063714}, {"text": "Section Il + of prescribed texts...", "x0": 0.09879253567508232, "y0": 0.7202797202797203, "x1": 0.49066959385290887, "y1": 0.7350427350427351}], [{"text": "Section I Text 1 \u2014 Images", "x0": 0.14050493962678376, "y0": 0.08080808080808081, "x1": 0.3600439077936334, "y1": 0.09557109557109557}, {"text": "= i", "x0": 0.36663007683863885, "y0": 0.473970473970474, "x1": 0.6597145993413831, "y1": 0.4794094794094794}, {"text": ". Adam and God\u2019 by MICHELANGELO (Sistine Chapel, Vatican City)", "x0": 0.11086717892425905, "y0": 0.48717948717948717, "x1": 0.75192096597146, "y1": 0.5003885003885004}], [{"text": "Text 2 \u2014 Nonfiction extract", "x0": 0.14050493962678376, "y0": 0.1864801864801865, "x1": 0.3787047200878156, "y1": 0.19658119658119658}, {"text": "I saw my life branching out before me like the green fig tree in the story. From the tip of", "x0": 0.14050493962678376, "y0": 0.22533022533022534, "x1": 0.8803512623490669, "y1": 0.23853923853923853}, {"text": "every branch, like a fat purple fig, a wonderful future beckoned and winked. One fig was a", "x0": 0.1394072447859495, "y0": 0.2501942501942502, "x1": 0.8792535675082327, "y1": 0.2634032634032634}, {"text": "husband and a happy home and children, and another fig was a famous poet and another fig,", "x0": 0.14050493962678376, "y0": 0.2742812742812743, "x1": 0.8781558726673985, "y1": 0.2874902874902875}, {"text": "was a brilliant professor, and another fig was Ee Gee, the amazing editor, and another fig", "x0": 0.14050493962678376, "y0": 0.29914529914529914, "x1": 0.8781558726673985, "y1": 0.3123543123543124}, {"text": "was Europe and Africa and South America, and another fig was Constantin and Socrates and", "x0": 0.14050493962678376, "y0": 0.32323232323232326, "x1": 0.8781558726673985, "y1": 0.33644133644133645}, {"text": "Attila and a pack of other lovers with queer names and offbeat professions, and another fig", "x0": 0.14050493962678376, "y0": 0.34498834498834496, "x1": 0.8781558726673985, "y1": 0.3644133644133644}, {"text": "was an Olympic lady crew champion, and beyond and above these figs were many more figs", "x0": 0.14050493962678376, "y0": 0.372960372960373, "x1": 0.8781558726673985, "y1": 0.3861693861693862}, {"text": "I quite make out. I saw myself sitting in the crotch of this fig tree, starving to death,", "x0": 0.14050493962678376, "y0": 0.3939393939393939, "x1": 0.8781558726673985, "y1": 0.4133644133644134}, {"text": "just because I couldn\u2019t make up my mind which of the figs I would choose. I wanted each", "x0": 0.13830954994511527, "y0": 0.4219114219114219, "x1": 0.8781558726673985, "y1": 0.43512043512043513}, {"text": "and every one of them, but choosing one meant losing all the rest, and, as I sat there, unable", "x0": 0.14050493962678376, "y0": 0.4467754467754468, "x1": 0.8781558726673985, "y1": 0.45998445998445997}, {"text": "to decide, the figs began to wrinkle and go black, and, one by one, they plopped to the ground", "x0": 0.14050493962678376, "y0": 0.47086247086247085, "x1": 0.8781558726673985, "y1": 0.4840714840714841}, {"text": "at my feet.", "x0": 0.14050493962678376, "y0": 0.49572649572649574, "x1": 0.2239297475301866, "y1": 0.508935508935509}, {"text": "The Bell Jar - SYLVIA PLATH", "x0": 0.6201975850713501, "y0": 0.54001554001554, "x1": 0.8781558726673985, "y1": 0.5501165501165501}], [{"text": "Text 3\u2014 Essay", "x0": 0.1525795828759605, "y0": 0.07536907536907538, "x1": 0.2854006586169045, "y1": 0.08857808857808858}, {"text": "Television brings us the news of the moment at the moment. Its hallmarks are immediacy, brevity and near", "x0": 0.1525795828759605, "y0": 0.09634809634809635, "x1": 0.9418221734357849, "y1": 0.10878010878010878}, {"text": "verblessness. We want it now and fast or not at all.", "x0": 0.15367727771679474, "y0": 0.1111111111111111, "x1": 0.5268935236004391, "y1": 0.12043512043512043}, {"text": "Constant stimulation and entertainment create the demand for constant stimulation and entertainment.", "x0": 0.1525795828759605, "y0": 0.15151515151515152, "x1": 0.9023051591657519, "y1": 0.16083916083916083}, {"text": "As a result, social commentator Hugh Mackay tells us, we're less skilled at communicating among ourselves,", "x0": 0.15367727771679474, "y0": 0.1919191919191919, "x1": 0.9582875960482986, "y1": 0.20435120435120435}, {"text": "less capable of introspection and reflection, unused to down time, We're fixed on the compressed thought.", "x0": 0.15367727771679474, "y0": 0.2066822066822067, "x1": 0.9363336992316136, "y1": 0.2191142191142191}, {"text": "Benchmarked by the sound bite.", "x0": 0.15367727771679474, "y0": 0.222999222999223, "x1": 0.3896816684961581, "y1": 0.23465423465423466}, {"text": "What\u2019s developing is an intolerance for talk. Not all talk; a certain kind of talk ~ a sustained, exploratory,", "x0": 0.15367727771679474, "y0": 0.2556332556332556, "x1": 0.9286498353457738, "y1": 0.27972027972027974}, {"text": "context-sensitive, inside-looking-out kind of talk.", "x0": 0.1525795828759605, "y0": 0.2773892773892774, "x1": 0.5159165751920965, "y1": 0.2898212898212898}, {"text": "It wasn\u2019t always like this. I can recall, at about age 15, asking my father to help me make sense of a line in a", "x0": 0.15367727771679474, "y0": 0.3177933177933178, "x1": 0.9506037321624589, "y1": 0.33022533022533024}, {"text": "history textbook: \u201cMy neighbour is my enemy but my neighbour is my friend.\u201d", "x0": 0.15367727771679474, "y0": 0.33255633255633255, "x1": 0.8298572996706916, "y1": 0.34498834498834496}, {"text": "The family was in the kitchen, just finishing an evening meal. Dad leapt up, energised by the challenge. He", "x0": 0.1525795828759605, "y0": 0.372960372960373, "x1": 0.9429198682766191, "y1": 0.3853923853923854}, {"text": "removed the dishes, wiped and dried the kitchen table, and then brought in a large historical atlas, opened at", "x0": 0.15367727771679474, "y0": 0.3877233877233877, "x1": 0.9484083424807903, "y1": 0.40015540015540013}, {"text": "a map of Europe, circa 1871. Over the next hour, the late-19\" century network of formal alliances and secret", "x0": 0.15367727771679474, "y0": 0.40093240093240096, "x1": 0.9527991218441273, "y1": 0.4149184149184149}, {"text": "agreements fell out, as it were, on the shiny surface of the kitchen table. Europe was crisscrossed in a", "x0": 0.15367727771679474, "y0": 0.41802641802641805, "x1": 0.8990120746432492, "y1": 0.43045843045843046}, {"text": "diplomatic tapestry of treaties, setting up the conditions for world war. And it all happened in my kitchen. I", "x0": 0.1525795828759605, "y0": 0.43278943278943277, "x1": 0.9440175631174533, "y1": 0.44522144522144524}, {"text": "was spellbound.", "x0": 0.15367727771679474, "y0": 0.4491064491064491, "x1": 0.270032930845225, "y1": 0.46076146076146074}, {"text": "There\u2019s no way, a generation later, I could repeat this scene. Even if I had the knowledge and explanatory", "x0": 0.1525795828759605, "y0": 0.48795648795648794, "x1": 0.9319429198682766, "y1": 0.5003885003885004}, {"text": "prowess, the question is unlikely to come forth. Too open-ended. Too prone to discursive drift.", "x0": 0.15367727771679474, "y0": 0.5027195027195027, "x1": 0.8507135016465422, "y1": 0.5151515151515151}, {"text": "So, not for us, the rambling thought or the digressive cul-de-sac, loosely connected by a flimsy segue. Life is", "x0": 0.15367727771679474, "y0": 0.5439005439005439, "x1": 0.9549945115257958, "y1": 0.5563325563325563}, {"text": "short. There\u2019s no time to waste (sorry, spend) on idle chat or off-task moments. We're, all of us, time-poor.", "x0": 0.15367727771679474, "y0": 0.5586635586635587, "x1": 0.9429198682766191, "y1": 0.5710955710955711}, {"text": "By the time we get around to having time not to worry about time, not much time is left.", "x0": 0.15367727771679474, "y0": 0.5734265734265734, "x1": 0.8035126234906695, "y1": 0.5858585858585859}, {"text": "There\u2019s a case, too, for the neat and brief. Arguably, the measure of a good teacher, for example, is the good", "x0": 0.1525795828759605, "y0": 0.6138306138306139, "x1": 0.9517014270032931, "y1": 0.6262626262626263}, {"text": "explanation. And the measure of this, at least in part, is conciseness, if only because its antithesis \u2014 long-", "x0": 0.1525795828759605, "y0": 0.6216006216006216, "x1": 0.9242590559824369, "y1": 0.6456876456876457}, {"text": "windedness ~ is anathema.", "x0": 0.15367727771679474, "y0": 0.6371406371406372, "x1": 0.34796926454445665, "y1": 0.6612276612276612}, {"text": "In Paris a few years ago, I heard a memorable anecdote from the manager of an English-language school. I", "x0": 0.15367727771679474, "y0": 0.6837606837606838, "x1": 0.9396267837541163, "y1": 0.6961926961926962}, {"text": "was there to talk about managing teachers. He reported that, for the first few years, he\u2019d managed the school", "x0": 0.15367727771679474, "y0": 0.6993006993006993, "x1": 0.9517014270032931, "y1": 0.7117327117327117}, {"text": "by the principles he\u2019d learned on his MBA. But recruitment continued to challenge him and he made too", "x0": 0.1525795828759605, "y0": 0.714063714063714, "x1": 0.9242590559824369, "y1": 0.7264957264957265}, {"text": "many bad appointments. Eventually he dispensed with what he'd learned formally, replacing it with intuition", "x0": 0.15367727771679474, "y0": 0.7288267288267288, "x1": 0.9571899012074643, "y1": 0.7412587412587412}, {"text": "and just one interview question. He asked the interviewee teachers ~ mostly newly arrived Britons on", "x0": 0.1668496158068057, "y0": 0.7373737373737373, "x1": 0.9132821075740944, "y1": 0.7614607614607615}, {"text": "working-holiday visas ~ how they got to the school that day.", "x0": 0.15367727771679474, "y0": 0.7521367521367521, "x1": 0.5971459934138309, "y1": 0.7762237762237763}, {"text": "The explanation, he claimed, turned out to be a reliable indicator of good teaching skills. He named the", "x0": 0.1525795828759605, "y0": 0.7995337995337995, "x1": 0.9132821075740944, "y1": 0.811965811965812}, {"text": "attributes he looked for: clarity, logical organisation, and \u2014 yes ~ you guessed it ~ brevity.", "x0": 0.15367727771679474, "y0": 0.8073038073038074, "x1": 0.8122941822173436, "y1": 0.8313908313908314}, {"text": "So, if you're keen, his school is three Metro stops past the Eiffel Tower, going north.", "x0": 0.15367727771679474, "y0": 0.8547008547008547, "x1": 0.7771679473106476, "y1": 0.8671328671328671}, {"text": "By RUTH WAJNRYB from The Sydney Morning Herald", "x0": 0.10976948408342481, "y0": 0.8966588966588966, "x1": 0.5740944017563118, "y1": 0.9098679098679099}], [{"text": "Text 4\u2014 Poem", "x0": 0.10976948408342481, "y0": 0.07536907536907538, "x1": 0.2414928649835346, "y1": 0.08547008547008547}, {"text": "The Sleepout", "x0": 0.2305159165751921, "y0": 0.1351981351981352, "x1": 0.3413830954994512, "y1": 0.14763014763014762}, {"text": "Childhood sleeps in a verandah room", "x0": 0.2305159165751921, "y0": 0.16705516705516704, "x1": 0.5301866081229418, "y1": 0.18026418026418026}, {"text": "in an iron bed close to the wall", "x0": 0.2305159165751921, "y0": 0.18414918414918416, "x1": 0.47639956092206365, "y1": 0.19347319347319347}, {"text": "where the winter over the railing", "x0": 0.2305159165751921, "y0": 0.19968919968919968, "x1": 0.49176728869374314, "y1": 0.2128982128982129}, {"text": "swelled the blind on its timber boom", "x0": 0.2305159165751921, "y0": 0.21678321678321677, "x1": 0.5246981339187706, "y1": 0.22688422688422688}, {"text": "and splinters picked lint off warm linen", "x0": 0.2305159165751921, "y0": 0.2494172494172494, "x1": 0.5466520307354555, "y1": 0.26262626262626265}, {"text": "and the stars were out over the hill;", "x0": 0.2305159165751921, "y0": 0.2665112665112665, "x1": 0.5115257958287596, "y1": 0.2773892773892774}, {"text": "then one wall of the room was forest", "x0": 0.2305159165751921, "y0": 0.28205128205128205, "x1": 0.5236004390779363, "y1": 0.29215229215229216}, {"text": "and all things in there were to come.", "x0": 0.2305159165751921, "y0": 0.29914529914529914, "x1": 0.5214050493962679, "y1": 0.31157731157731156}, {"text": "Breathings climbed up on the verandah", "x0": 0.2305159165751921, "y0": 0.3317793317793318, "x1": 0.544456641053787, "y1": 0.3442113442113442}, {"text": "when dark cattle rubbed at the corner", "x0": 0.2305159165751921, "y0": 0.3480963480963481, "x1": 0.5290889132821076, "y1": 0.35742035742035744}, {"text": "and sometimes dim towering rain stood", "x0": 0.2305159165751921, "y0": 0.36363636363636365, "x1": 0.5477497255762898, "y1": 0.37684537684537683}, {"text": "for forest, and the dry cave hung woollen.", "x0": 0.23161361141602635, "y0": 0.37995337995337997, "x1": 0.5653128430296378, "y1": 0.39316239316239315}, {"text": "Inside the forest was lamplit", "x0": 0.2305159165751921, "y0": 0.4133644133644134, "x1": 0.4566410537870472, "y1": 0.4257964257964258}, {"text": "along tracks to a starry creek bed", "x0": 0.2305159165751921, "y0": 0.43045843045843046, "x1": 0.4950603732162459, "y1": 0.4428904428904429}, {"text": "and beyond lay the never-fenced country,", "x0": 0.2305159165751921, "y0": 0.445998445998446, "x1": 0.5631174533479693, "y1": 0.4592074592074592}, {"text": "Its full billabongs all surrounded", "x0": 0.2305159165751921, "y0": 0.46231546231546233, "x1": 0.49176728869374314, "y1": 0.4755244755244755}, {"text": "By animals and birds, in loud crustings,", "x0": 0.2305159165751921, "y0": 0.494949494949495, "x1": 0.5488474204171241, "y1": 0.5081585081585082}, {"text": "and sometimes kept leaping up amongst them.", "x0": 0.2305159165751921, "y0": 0.5112665112665112, "x1": 0.601536772777168, "y1": 0.5244755244755245}, {"text": "And out there, to kindle whenever", "x0": 0.2305159165751921, "y0": 0.5283605283605284, "x1": 0.5038419319429198, "y1": 0.5392385392385393}, {"text": "dark found it, hung the daylight moon.", "x0": 0.2305159165751921, "y0": 0.5439005439005439, "x1": 0.54006586169045, "y1": 0.5571095571095571}, {"text": "LES MURRAY", "x0": 0.47530186608122943, "y0": 0.578088578088578, "x1": 0.6004390779363337, "y1": 0.5874125874125874}], [{"text": "Text 5 \u2014 Fiction Extract", "x0": 0.10976948408342481, "y0": 0.07536907536907538, "x1": 0.3227222832052689, "y1": 0.08547008547008547}, {"text": "Thad been driving towards a house that had not existed for decades. I thought of turning around,", "x0": 0.10976948408342481, "y0": 0.11344211344211344, "x1": 0.8781558726673985, "y1": 0.12665112665112666}, {"text": "then, as I drove down a wide street that had once been a flint lane beside a barley field, of turning", "x0": 0.10976948408342481, "y0": 0.12975912975912976, "x1": 0.8781558726673985, "y1": 0.14996114996114995}, {"text": "back and leaving the past undisturbed. But I was curious. The old house, the one I had lived in", "x0": 0.10976948408342481, "y0": 0.1522921522921523, "x1": 0.8781558726673985, "y1": 0.1655011655011655}, {"text": "for seven years, from when I was five until I was twelve, that house had been knocked down and", "x0": 0.11086717892425905, "y0": 0.17249417249417248, "x1": 0.8781558726673985, "y1": 0.1857031857031857}, {"text": "was lost for good. The new house, the one my parents had built at the bottom of the garden,", "x0": 0.10976948408342481, "y0": 0.1888111888111888, "x1": 0.8781558726673985, "y1": 0.20823620823620823}, {"text": "between the azalea bushes and the green circle in the grass we called the fairy ring, that had been", "x0": 0.10976948408342481, "y0": 0.21134421134421136, "x1": 0.8781558726673985, "y1": 0.22455322455322455}, {"text": "sold thirty years ago. I slowed the car as I saw the new house. It would always be the new house", "x0": 0.10976948408342481, "y0": 0.23232323232323232, "x1": 0.8781558726673985, "y1": 0.24475524475524477}, {"text": "in my head.", "x0": 0.10976948408342481, "y0": 0.2517482517482518, "x1": 0.20197585071350166, "y1": 0.2641802641802642}, {"text": "I pulled up into the driveway, observing the way they had built out on the mid-seventies", "x0": 0.10976948408342481, "y0": 0.2905982905982906, "x1": 0.8781558726673985, "y1": 0.3038073038073038}, {"text": "architecture. I had forgotten that the bricks of the house were chocolate brown. The new people", "x0": 0.10976948408342481, "y0": 0.31002331002331, "x1": 0.8781558726673985, "y1": 0.32323232323232326}, {"text": "had made my mother\u2019s tiny balcony into a two-storey sunroom. I stared at the house,", "x0": 0.10976948408342481, "y0": 0.32944832944832947, "x1": 0.8781558726673985, "y1": 0.34265734265734266}, {"text": "remembering less than I had expected about my teenage years: no good times, no bad times. I'd", "x0": 0.10976948408342481, "y0": 0.34965034965034963, "x1": 0.8781558726673985, "y1": 0.3628593628593629}, {"text": "lived in that pla", "x0": 0.10976948408342481, "y0": 0.3690753690753691, "x1": 0.23161361141602635, "y1": 0.3822843822843823}, {"text": "e, for a while, as a teenager. It didn\u2019t seem to be any part of who I was now. I", "x0": 0.24588364434687157, "y0": 0.3690753690753691, "x1": 0.8781558726673985, "y1": 0.3822843822843823}, {"text": "backed the car out of their driveway. . . . The little country lane of my childhood had become a", "x0": 0.10976948408342481, "y0": 0.3853923853923854, "x1": 0.8792535675082327, "y1": 0.40559440559440557}, {"text": "black tarmac road that swerved as a buffer between two sprawling housing estates. I drove further", "x0": 0.10976948408342481, "y0": 0.40792540792540793, "x1": 0.8792535675082327, "y1": 0.4211344211344211}, {"text": "down it, away from the town, which was not the way I should have been travelling, and it felt", "x0": 0.10976948408342481, "y0": 0.4281274281274281, "x1": 0.8781558726673985, "y1": 0.44133644133644134}, {"text": "good. The slick black road b", "x0": 0.10976948408342481, "y0": 0.4483294483294483, "x1": 0.3743139407244786, "y1": 0.46076146076146074}, {"text": "\"ame narrower, windier, became the", "x0": 0.3929747530186608, "y0": 0.4483294483294483, "x1": 0.7047200878155873, "y1": 0.4592074592074592}, {"text": "single-lane track I", "x0": 0.7233809001097695, "y0": 0.4483294483294483, "x1": 0.8781558726673985, "y1": 0.46076146076146074}, {"text": "remembered from my childhood, became packed earth and knobbly, bone-like flints.", "x0": 0.10976948408342481, "y0": 0.466977466977467, "x1": 0.7903402854006586, "y1": 0.4801864801864802}, {"text": "Soon I was driving slowly, bumpily, down a narrow lane with brambles and briar roses on each", "x0": 0.10976948408342481, "y0": 0.5066045066045066, "x1": 0.8781558726673985, "y1": 0.5198135198135199}, {"text": "side, wherever the edge was not a stand of hazels or a wild hedgerow. It felt like I had driven", "x0": 0.10976948408342481, "y0": 0.526029526029526, "x1": 0.8781558726673985, "y1": 0.5392385392385393}, {"text": "back in time. I remembered it before I turned the corner and saw it, in all its dilapidated red-brick", "x0": 0.10976948408342481, "y0": 0.5462315462315462, "x1": 0.8781558726673985, "y1": 0.5594405594405595}, {"text": "glory: the Hempstocks\u2019 farmhouse. It took me by surprise, although that was where the lane had", "x0": 0.10976948408342481, "y0": 0.5656565656565656, "x1": 0.8781558726673985, "y1": 0.5788655788655789}, {"text": "always ended. I could have gone no further. I parked the car at the side of the farmyard. I had no", "x0": 0.10976948408342481, "y0": 0.585081585081585, "x1": 0.8781558726673985, "y1": 0.5982905982905983}, {"text": "plan. I wondered whether, after all these years, there was anyone still living there, or, more", "x0": 0.10976948408342481, "y0": 0.6045066045066045, "x1": 0.8781558726673985, "y1": 0.6177156177156177}, {"text": "precisely, if the Hempstocks were still living there. It seemed unlikely, but then, from what little", "x0": 0.10976948408342481, "y0": 0.6247086247086248, "x1": 0.8781558726673985, "y1": 0.6379176379176379}, {"text": "I remembered, they had been unlikely people. The stench of cow muck struck me as I got out of", "x0": 0.10976948408342481, "y0": 0.6441336441336442, "x1": 0.8803512623490669, "y1": 0.6573426573426573}, {"text": "the car, and I walked gingerly across the small yard to the front door. I looked for a doorbell, in", "x0": 0.10976948408342481, "y0": 0.6635586635586636, "x1": 0.8781558726673985, "y1": 0.6767676767676768}, {"text": "vain, and then I knocked. The door had not been latched properly, and it swung gently open as I", "x0": 0.10976948408342481, "y0": 0.6845376845376845, "x1": 0.8781558726673985, "y1": 0.696969696969697}, {"text": "rapped it with my knuckles. I had been here, hadn\u2019t I, a long time ago? I was sure I had.", "x0": 0.10976948408342481, "y0": 0.7031857031857032, "x1": 0.8770581778265643, "y1": 0.7163947163947164}, {"text": "Childhood memories are sometimes covered and obscured beneath the things that come later,", "x0": 0.10976948408342481, "y0": 0.7226107226107226, "x1": 0.8781558726673985, "y1": 0.7358197358197358}, {"text": "like childhood toys forgotten at the bottom of a crammed adult closet, but they are never lost for", "x0": 0.10976948408342481, "y0": 0.7397047397047397, "x1": 0.8792535675082327, "y1": 0.7591297591297591}, {"text": "good.", "x0": 0.10976948408342481, "y0": 0.763014763014763, "x1": 0.1525795828759605, "y1": 0.7754467754467754}, {"text": "The Ocean at the End of the Lane \u2014 NEIL GAIMAN", "x0": 0.41931942919868276, "y0": 0.7871017871017871, "x1": 0.8781558726673985, "y1": 0.797979797979798}, {"text": "Copyright notice/Acknowledgment: The Ocean at the End of the Lane, copyright \u00a9 2016 by Neil", "x0": 0.14050493962678376, "y0": 0.8298368298368298, "x1": 0.9034028540065862, "y1": 0.8430458430458431}, {"text": "Gaiman. Text Reprinted by permission of Writers House LLC acting as agent for the author.", "x0": 0.1712403951701427, "y0": 0.8453768453768454, "x1": 0.9012074643249177, "y1": 0.8585858585858586}], [{"text": "Section II", "x0": 0.11964873765093303, "y0": 0.07614607614607614, "x1": 0.21514818880351264, "y1": 0.08780108780108781}, {"text": "The prescribed texts for Section II are:", "x0": 0.11855104281009879, "y0": 0.13442113442113443, "x1": 0.4281009879253567, "y1": 0.14763014763014762}, {"text": "Prose Fiction", "x0": 0.14270032930845225, "y0": 0.17482517482517482, "x1": 0.2557628979143798, "y1": 0.18492618492618493}, {"text": "Anthony Doerr, All the Light We Cannot See", "x0": 0.31174533479692645, "y0": 0.17482517482517482, "x1": 0.6739846322722283, "y1": 0.18803418803418803}, {"text": "Amanda Lohrey, Vertigo", "x0": 0.30954994511525796, "y0": 0.20590520590520592, "x1": 0.5115257958287596, "y1": 0.21833721833721834}, {"text": "George Orwell, Nineteen Eighty-Four", "x0": 0.30954994511525796, "y0": 0.23543123543123542, "x1": 0.6180021953896817, "y1": 0.24864024864024864}, {"text": "Favel Parrett, Past the Shallows", "x0": 0.30954994511525796, "y0": 0.26573426573426573, "x1": 0.566410537870472, "y1": 0.2773892773892774}, {"text": "Poetry", "x0": 0.14270032930845225, "y0": 0.30691530691530694, "x1": 0.1986827661909989, "y1": 0.3201243201243201}, {"text": "Rosemary Dobson, Rosemary Dobson Collected", "x0": 0.31174533479692645, "y0": 0.30691530691530694, "x1": 0.7014270032930845, "y1": 0.3201243201243201}, {"text": "The prescribed poems are:", "x0": 0.30954994511525796, "y0": 0.3317793317793318, "x1": 0.5203073545554336, "y1": 0.3442113442113442}, {"text": "* Young Girl at a Window", "x0": 0.3106476399560922, "y0": 0.3473193473193473, "x1": 0.5323819978046103, "y1": 0.37218337218337216}, {"text": "* Over the Hill", "x0": 0.3106476399560922, "y0": 0.3706293706293706, "x1": 0.44017563117453345, "y1": 0.38073038073038074}, {"text": "* Summer's End", "x0": 0.3106476399560922, "y0": 0.3885003885003885, "x1": 0.4522502744237102, "y1": 0.3978243978243978}, {"text": "* The Conversation", "x0": 0.3106476399560922, "y0": 0.4048174048174048, "x1": 0.47530186608122943, "y1": 0.41414141414141414}, {"text": "* Cock Crow", "x0": 0.3106476399560922, "y0": 0.4219114219114219, "x1": 0.424807903402854, "y1": 0.43123543123543123}, {"text": "* Amy Caroline", "x0": 0.3106476399560922, "y0": 0.4382284382284382, "x1": 0.4456641053787047, "y1": 0.4483294483294483}, {"text": "* Canberra Morning", "x0": 0.3106476399560922, "y0": 0.45454545454545453, "x1": 0.48518111964873767, "y1": 0.466977466977467}, {"text": "Kenneth Slessor, Selected Poems", "x0": 0.3106476399560922, "y0": 0.4840714840714841, "x1": 0.5773874862788145, "y1": 0.494949494949495}, {"text": "The prescribed poems are:", "x0": 0.30954994511525796, "y0": 0.5081585081585082, "x1": 0.5203073545554336, "y1": 0.5205905205905206}, {"text": "Wild Grapes", "x0": 0.33479692645444564, "y0": 0.5306915306915307, "x1": 0.43468715697036225, "y1": 0.5439005439005439}, {"text": "Gulliver", "x0": 0.3336992316136114, "y0": 0.5485625485625486, "x1": 0.40065861690450055, "y1": 0.5578865578865578}, {"text": "Out of Time", "x0": 0.3336992316136114, "y0": 0.5648795648795649, "x1": 0.43029637760702527, "y1": 0.5773115773115773}, {"text": "Vesper-Song of the Reverend Samuel Marsden", "x0": 0.33479692645444564, "y0": 0.5811965811965812, "x1": 0.7091108671789242, "y1": 0.5944055944055944}, {"text": "William Street", "x0": 0.33479692645444564, "y0": 0.5982905982905983, "x1": 0.4489571899012075, "y1": 0.6076146076146076}, {"text": "Beach Burial", "x0": 0.3336992316136114, "y0": 0.6146076146076146, "x1": 0.44017563117453345, "y1": 0.6247086247086248}, {"text": "Drama", "x0": 0.14270032930845225, "y0": 0.6565656565656566, "x1": 0.20197585071350166, "y1": 0.6666666666666666}, {"text": "Jane Harrison, Rainbow's End, from Vivienne Cleven et al.,", "x0": 0.31174533479692645, "y0": 0.6565656565656566, "x1": 0.7958287596048299, "y1": 0.6682206682206682}, {"text": "Contemporary Indigenous Plays", "x0": 0.3106476399560922, "y0": 0.6728826728826729, "x1": 0.5697036223929748, "y1": 0.6860916860916861}, {"text": "\u2014 Arthur Miller, The Crucible", "x0": 0.2854006586169045, "y0": 0.7031857031857032, "x1": 0.5345773874862788, "y1": 0.7148407148407149}, {"text": "\u2014 William Shakespeare, The Merchant of Venice", "x0": 0.2854006586169045, "y0": 0.7334887334887334, "x1": 0.6871569703622393, "y1": 0.7466977466977467}, {"text": "Section II continues on page 8", "x0": 0.36553238199780463, "y0": 0.8344988344988346, "x1": 0.6212952799121844, "y1": 0.8477078477078477}], [{"text": "Section II prescribed texts (continued)", "x0": 0.09440175631174534, "y0": 0.07536907536907538, "x1": 0.40065861690450055, "y1": 0.08857808857808858}, {"text": "+ Nonfiction", "x0": 0.09440175631174534, "y0": 0.11732711732711733, "x1": 0.2074643249176729, "y1": 0.12742812742812742}, {"text": "\u2014 Tim Winton, The Boy Behind the Curtain", "x0": 0.2601536772777168, "y0": 0.11732711732711733, "x1": 0.6212952799121844, "y1": 0.1282051282051282}, {"text": "Havoc: A Life in Accidents", "x0": 0.3084522502744237, "y0": 0.14219114219114218, "x1": 0.5257958287596048, "y1": 0.15462315462315462}, {"text": "Betsy", "x0": 0.3084522502744237, "y0": 0.1585081585081585, "x1": 0.3512623490669594, "y1": 0.1686091686091686}, {"text": "Twice on Sundays", "x0": 0.3084522502744237, "y0": 0.17560217560217561, "x1": 0.45334796926454446, "y1": 0.18803418803418803}, {"text": "The Wait and the Flow", "x0": 0.3084522502744237, "y0": 0.19114219114219114, "x1": 0.49396267837541163, "y1": 0.20124320124320125}, {"text": "In the Shadow of the Hospital", "x0": 0.3084522502744237, "y0": 0.20823620823620823, "x1": 0.5499451152579583, "y1": 0.22144522144522144}, {"text": "The Demon Shark", "x0": 0.3084522502744237, "y0": 0.22533022533022534, "x1": 0.4544456641053787, "y1": 0.23465423465423466}, {"text": "Barefoot in the Temple of Art", "x0": 0.3084522502744237, "y0": 0.24242424242424243, "x1": 0.5466520307354555, "y1": 0.25485625485625485}, {"text": "Malala Yousafzai and Christina Lamb, J am Malala", "x0": 0.2843029637760702, "y0": 0.27117327117327117, "x1": 0.703622392974753, "y1": 0.2828282828282828}, {"text": "+ Film", "x0": 0.09440175631174534, "y0": 0.31313131313131315, "x1": 0.15697036223929747, "y1": 0.32323232323232326}, {"text": "Stephen Daldry, Billy Elliot", "x0": 0.28210757409440174, "y0": 0.31313131313131315, "x1": 0.5049396267837541, "y1": 0.32634032634032634}, {"text": "+ Media", "x0": 0.09440175631174534, "y0": 0.3550893550893551, "x1": 0.1712403951701427, "y1": 0.3651903651903652}, {"text": "Ivan O\u2019Mahoney", "x0": 0.2864983534577388, "y0": 0.3550893550893551, "x1": 0.42151481888035125, "y1": 0.3682983682983683}, {"text": "* Go Back to Where You Came From", "x0": 0.2854006586169045, "y0": 0.3791763791763792, "x1": 0.5960482985729967, "y1": 0.3885003885003885}, {"text": "\u2014 Series 1: Episodes 1, 2 and 3", "x0": 0.30735455543358947, "y0": 0.39316239316239315, "x1": 0.5598243688254665, "y1": 0.41181041181041184}, {"text": "and", "x0": 0.3084522502744237, "y0": 0.41647241647241645, "x1": 0.3358946212952799, "y1": 0.4257964257964258}, {"text": "* The Response", "x0": 0.2854006586169045, "y0": 0.4358974358974359, "x1": 0.41822173435784854, "y1": 0.4483294483294483}, {"text": "Lucy Walker, Waste Land", "x0": 0.2843029637760702, "y0": 0.4654234654234654, "x1": 0.4972557628979144, "y1": 0.47863247863247865}, {"text": "End of Section II", "x0": 0.3907793633369923, "y0": 0.5501165501165501, "x1": 0.535675082327113, "y1": 0.5602175602175602}]]