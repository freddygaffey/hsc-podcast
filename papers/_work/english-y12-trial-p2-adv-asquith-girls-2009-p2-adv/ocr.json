4835164, "y0": 0.2286158631415241, "x1": 0.8461538461538461, "y1": 0.24339035769828926}, {"text": "and meaning", "x0": 0.15164835164835164, "y0": 0.24572317262830481, "x1": 0.25934065934065936, "y1": 0.25894245723172626}, {"text": "\u00a9 organise, develop and express ideas using language appropriate to audience, purpose", "x0": 0.12197802197802197, "y0": 0.26049766718507, "x1": 0.8725274725274725, "y1": 0.276049766718507}, {"text": "and form", "x0": 0.15164835164835164, "y0": 0.27838258164852253, "x1": 0.22637362637362637, "y1": 0.2892690513219285}, {"text": "Question 8 - Elective 1: Conflicting Perspectives (20 marks)", "x0": 0.12307692307692308, "y0": 0.328149300155521, "x1": 0.6373626373626373, "y1": 0.3429237947122862}, {"text": "\u201cDon't be afraid of opposition. Remember, a kite rises against, not with, the wind.\u201d", "x0": 0.12307692307692308, "y0": 0.3584758942457232, "x1": 0.7758241758241758, "y1": 0.37325038880248834}, {"text": "Hamilton Mabie", "x0": 0.654945054945055, "y0": 0.3740279937791602, "x1": 0.7835164835164835, "y1": 0.38413685847589424}, {"text": "Evaluate this proposition in relation to your prescribed text and at least TWO related texts", "x0": 0.12307692307692308, "y0": 0.4051321928460342, "x1": 0.8703296703296703, "y1": 0.4214618973561431}, {"text": "of your own choosing.", "x0": 0.12307692307692308, "y0": 0.4237947122861586, "x1": 0.3087912087912088, "y1": 0.4370139968895801}, {"text": "The prescribed texts are:", "x0": 0.12307692307692308, "y0": 0.4548989113530327, "x1": 0.3252747252747253, "y1": 0.4681181959564541}, {"text": "Shakespearean Drama - William Shakespeare, Julius Caesar", "x0": 0.15384615384615385, "y0": 0.46967340590979784, "x1": 0.7, "y1": 0.48522550544323484}, {"text": "Prose Fiction - David Guterson, Snow Falling on Cedars", "x0": 0.15384615384615385, "y0": 0.5023328149300156, "x1": 0.7527472527472527, "y1": 0.5155520995334371}, {"text": "\u00a9 Drama or Film - Peter Whelan, The Herbal Bed", "x0": 0.12527472527472527