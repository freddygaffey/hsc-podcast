[[{"text": "ASCHAM SCHOOL,", "x0": 0.3824175824175824, "y0": 0.1320901320901321, "x1": 0.5758241758241758, "y1": 0.14374514374514374}, {"text": "English (Advanced)", "x0": 0.2934065934065934, "y0": 0.30691530691530694, "x1": 0.6571428571428571, "y1": 0.33644133644133645}, {"text": "Trial HSC", "x0": 0.3824175824175824, "y0": 0.3434343434343434, "x1": 0.5681318681318681, "y1": 0.36752136752136755}, {"text": "Paper 2 \u2014 Modules", "x0": 0.30439560439560437, "y0": 0.411033411033411, "x1": 0.6461538461538462, "y1": 0.44133644133644134}, {"text": "Total Marks - 60", "x0": 0.5351648351648352, "y0": 0.5244755244755245, "x1": 0.6989010989010989, "y1": 0.5361305361305362}, {"text": "Section 1)", "x0": 0.5043956043956044, "y0": 0.5594405594405595, "x1": 0.5901098901098901, "y1": 0.5718725718725719}, {"text": "20 marks", "x0": 0.5032967032967033, "y0": 0.5827505827505828, "x1": 0.5923076923076923, "y1": 0.5944055944055944}, {"text": "Attempt either Question 1 or 2", "x0": 0.5164835164835165, "y0": 0.6052836052836053, "x1": 0.756043956043956, "y1": 0.6184926184926185}, {"text": "General Instructions", "x0": 0.12417582417582418, "y0": 0.6223776223776224, "x1": 0.2978021978021978, "y1": 0.6332556332556333}, {"text": "Allow about 40 minutes for this section.", "x0": 0.5175824175824176, "y0": 0.6254856254856255, "x1": 0.8307692307692308, "y1": 0.6363636363636364}, {"text": "* Reading time \u2014 5 minutes -", "x0": 0.15384615384615385, "y0": 0.655011655011655, "x1": 0.5494505494505495, "y1": 0.6682206682206682}, {"text": "Working time ~ 2 hours Section 2", "x0": 0.1835164835164835, "y0": 0.6573426573426573, "x1": 0.5956043956043956, "y1": 0.6899766899766899}, {"text": "\u00a9 Write using black or blue 20 marks", "x0": 0.15494505494505495, "y0": 0.6884226884226884, "x1": 0.5923076923076923, "y1": 0.7024087024087025}, {"text": "pen.", "x0": 0.1824175824175824, "y0": 0.7086247086247086, "x1": 0.2153846153846154, "y1": 0.7187257187257188}, {"text": "* Attempt ONE question from Questions 3-10", "x0": 0.5043956043956044, "y0": 0.7101787101787101, "x1": 0.8637362637362638, "y1": 0.7241647241647242}, {"text": "* Allow about 40 minutes for this section.", "x0": 0.5043956043956044, "y0": 0.7303807303807304, "x1": 0.8318681318681319, "y1": 0.7412587412587412}, {"text": "Section 3", "x0": 0.5054945054945055, "y0": 0.7661227661227661, "x1": 0.5934065934065934, "y1": 0.7863247863247863}, {"text": "20 marks", "x0": 0.5043956043956044, "y0": 0.7940947940947941, "x1": 0.5934065934065934, "y1": 0.8057498057498057}, {"text": "Attempt ONE question from Questions 11-13", "x0": 0.5175824175824176, "y0": 0.8158508158508159, "x1": 0.8736263736263736, "y1": 0.8298368298368298}, {"text": "* Allow about 40 minutes for this section.", "x0": 0.5054945054945055, "y0": 0.8360528360528361, "x1": 0.8318681318681319, "y1": 0.846930846930847}], [{"text": "Section 1 - Module A: Comparative Study of Texts and Context", "x0": 0.12417582417582418, "y0": 0.11965811965811966, "x1": 0.7615384615384615, "y1": 0.1351981351981352}, {"text": "20 marks", "x0": 0.12417582417582418, "y0": 0.15462315462315462, "x1": 0.2010989010989011, "y1": 0.1655011655011655}, {"text": "Attempt either Question 1 or Question 2", "x0": 0.12417582417582418, "y0": 0.17094017094017094, "x1": 0.46703296703296704, "y1": 0.18492618492618493}, {"text": "Allow about 40 minutes for this section", "x0": 0.12307692307692308, "y0": 0.18725718725718726, "x1": 0.45714285714285713, "y1": 0.19813519813519814}, {"text": "Answer the question in a writing booklet. Extra writing booklets are available.", "x0": 0.12417582417582418, "y0": 0.2198912198912199, "x1": 0.7527472527472527, "y1": 0.2338772338772339}, {"text": "Tn your answer you will be assessed on how well you:", "x0": 0.12307692307692308, "y0": 0.25252525252525254, "x1": 0.5560439560439561, "y1": 0.2665112665112665}, {"text": "Demonstrate understanding of the meanings of a pair of texts when considered", "x0": 0.1835164835164835, "y0": 0.26262626262626265, "x1": 0.8153846153846154, "y1": 0.289044289044289}, {"text": "together", "x0": 0.1824175824175824, "y0": 0.2867132867132867, "x1": 0.24945054945054945, "y1": 0.2999222999222999}, {"text": "* evaluate the relationships between texts and contexts", "x0": 0.15384615384615385, "y0": 0.3038073038073038, "x1": 0.6087912087912087, "y1": 0.3177933177933178}, {"text": "\u00a9 organise, develop and express ideas using language appropriate to audience,", "x0": 0.15384615384615385, "y0": 0.32167832167832167, "x1": 0.7945054945054945, "y1": 0.33644133644133645}, {"text": "purpose and form", "x0": 0.1824175824175824, "y0": 0.337995337995338, "x1": 0.3252747252747253, "y1": 0.351981351981352}, {"text": "Question 1 \u2014 Elective 1: Exploring Connections (20 marks)", "x0": 0.12747252747252746, "y0": 0.3916083916083916, "x1": 0.6901098901098901, "y1": 0.40714840714840717}, {"text": "\u2018The tension between the individual and society is what leds to questioning and change.", "x0": 0.12307692307692308, "y0": 0.45376845376845376, "x1": 0.8285714285714286, "y1": 0.46853146853146854}, {"text": "Discuss this statement in relation to your TWO prescribed texts.", "x0": 0.12307692307692308, "y0": 0.47785547785547783, "x1": 0.6373626373626373, "y1": 0.49184149184149184}, {"text": "The prescribed texts are:", "x0": 0.12197802197802197, "y0": 0.5299145299145299, "x1": 0.31868131868131866, "y1": 0.5439005439005439}, {"text": "\u00a2 Shakespearean Drama and Film \u2014 Shakespeare, King Richard and", "x0": 0.15384615384615385, "y0": 0.5555555555555556, "x1": 0.7824175824175824, "y1": 0.581973581973582}, {"text": "Al Pacino, Looking for Richard", "x0": 0.4989010989010989, "y0": 0.5796425796425796, "x1": 0.7549450549450549, "y1": 0.5936285936285937}, {"text": "* Prose Fiction and Poetry Patrick White, The Aunt\u2019s Story and", "x0": 0.15384615384615385, "y0": 0.6138306138306139, "x1": 0.7901098901098901, "y1": 0.6278166278166278}, {"text": "Rosemary Dobson, Selected Poems", "x0": 0.4989010989010989, "y0": 0.6301476301476302, "x1": 0.7835164835164835, "y1": 0.6441336441336442}, {"text": "\u00a2 Prose Fiction and Nonfiction Jane Austen, Pride and Prejudice and", "x0": 0.15384615384615385, "y0": 0.6643356643356644, "x1": 0.8043956043956044, "y1": 0.6775446775446775}, {"text": "Fay Weldon, Letters to Alice", "x0": 0.4989010989010989, "y0": 0.6806526806526807, "x1": 0.7296703296703296, "y1": 0.6938616938616938}, {"text": "\u00a9 Poetry and Drama John Donne, Selected Poems and", "x0": 0.15274725274725276, "y0": 0.714063714063714, "x1": 0.7648351648351648, "y1": 0.728049728049728}, {"text": "Margaret Edson, W;t", "x0": 0.4989010989010989, "y0": 0.7303807303807304, "x1": 0.667032967032967, "y1": 0.7443667443667443}, {"text": "OR", "x0": 0.43956043956043955, "y0": 0.8298368298368298, "x1": 0.46923076923076923, "y1": 0.83993783993784}], [{"text": "Question 2 \u2014 Elective 2: Text in Time (20 marks)", "x0": 0.11648351648351649, "y0": 0.09634809634809635, "x1": 0.589010989010989, "y1": 0.11188811188811189}, {"text": "\u2018The tension between the individual and society is what leads to questioning and change.", "x0": 0.11208791208791209, "y0": 0.14296814296814297, "x1": 0.8197802197802198, "y1": 0.15695415695415696}, {"text": "Discuss this statement in relation to your TWO prescribed texts.", "x0": 0.11208791208791209, "y0": 0.16627816627816627, "x1": 0.6274725274725275, "y1": 0.18026418026418026}, {"text": "The prescribed texts are:", "x0": 0.11208791208791209, "y0": 0.21833721833721834, "x1": 0.3098901098901099, "y1": 0.23232323232323232}, {"text": "+ Prose Fiction and Film Mary Shelley, Frankenstein and", "x0": 0.12857142857142856, "y0": 0.2517482517482518, "x1": 0.6879120879120879, "y1": 0.26495726495726496}, {"text": "Ridley Scott, Blade Runner", "x0": 0.42857142857142855, "y0": 0.2680652680652681, "x1": 0.6494505494505495, "y1": 0.2812742812742813}, {"text": "+ Prose Fiction and Poetry F, Scott Fitzgerald, The Great Gatsby and", "x0": 0.12857142857142856, "y0": 0.3006993006993007, "x1": 0.7703296703296704, "y1": 0.3146853146853147}, {"text": "Elizabeth Barrett Browning, Poems", "x0": 0.42857142857142855, "y0": 0.317016317016317, "x1": 0.7131868131868132, "y1": 0.33022533022533024}, {"text": "+ Drama and Nonfiction Edward Albee, Who's Afraid of Virginia Woolf", "x0": 0.12857142857142856, "y0": 0.34965034965034963, "x1": 0.8131868131868132, "y1": 0.36363636363636365}, {"text": "Virginia Woolf, A Room of One\u2019s Own", "x0": 0.42857142857142855, "y0": 0.36596736596736595, "x1": 0.7417582417582418, "y1": 0.3791763791763792}], [{"text": "Section I \u2014 Module B: Critical Study of Texts", "x0": 0.12197802197802197, "y0": 0.10101010101010101, "x1": 0.5813186813186814, "y1": 0.11655011655011654}, {"text": "20 marks", "x0": 0.12197802197802197, "y0": 0.13675213675213677, "x1": 0.2010989010989011, "y1": 0.14685314685314685}, {"text": "Attempt ONE question from Questions 3-10", "x0": 0.12087912087912088, "y0": 0.1522921522921523, "x1": 0.4967032967032967, "y1": 0.16627816627816627}, {"text": "Allow about 40 minutes for this section", "x0": 0.12197802197802197, "y0": 0.1686091686091686, "x1": 0.45494505494505494, "y1": 0.18026418026418026}, {"text": "Answer the question in a writing booklet. Clearly mark the Question you are attempting.", "x0": 0.12087912087912088, "y0": 0.20124320124320125, "x1": 0.8318681318681319, "y1": 0.21522921522921523}, {"text": "Extra writing booklets are available.", "x0": 0.12087912087912088, "y0": 0.21756021756021757, "x1": 0.41208791208791207, "y1": 0.23154623154623155}, {"text": "Jn your answer you will be assessed on how well you:", "x0": 0.12087912087912088, "y0": 0.25097125097125095, "x1": 0.5538461538461539, "y1": 0.26495726495726496}, {"text": "\u00a9 demonstrate an informed understanding of the ideas expressed in the text", "x0": 0.15274725274725276, "y0": 0.2680652680652681, "x1": 0.7692307692307693, "y1": 0.28205128205128205}, {"text": "\u00abevaluate the text\u2019s language, content and construction", "x0": 0.15164835164835164, "y0": 0.2851592851592852, "x1": 0.6131868131868132, "y1": 0.29914529914529914}, {"text": "organise, develop and express ideas using language appropriate to audience,", "x0": 0.1835164835164835, "y0": 0.30303030303030304, "x1": 0.7945054945054945, "y1": 0.317016317016317}, {"text": "purpose and form", "x0": 0.1824175824175824, "y0": 0.31934731934731936, "x1": 0.3230769230769231, "y1": 0.3341103341103341}, {"text": "Question 3 \u2014 William Shakespeare, Hamlet (20 marks)", "x0": 0.13736263736263737, "y0": 0.3947163947163947, "x1": 0.654945054945055, "y1": 0.41025641025641024}, {"text": "\u201cA critical study of Hamlet allows us to engage closely with the notion of loss.\u201d", "x0": 0.13626373626373625, "y0": 0.4405594405594406, "x1": 0.7791208791208791, "y1": 0.45454545454545453}, {"text": "How does this represent your understanding of Shakespeare\u2019s Hamlet?", "x0": 0.13626373626373625, "y0": 0.46386946386946387, "x1": 0.7054945054945055, "y1": 0.47785547785547783}, {"text": "OR", "x0": 0.46923076923076923, "y0": 0.5167055167055167, "x1": 0.5, "y1": 0.5268065268065268}, {"text": "Question 4 \u2014 Prose Fiction (20 marks)", "x0": 0.13736263736263737, "y0": 0.5501165501165501, "x1": 0.5032967032967033, "y1": 0.5648795648795649}, {"text": "\u201cThe meaning of a text is created through the act of reading, not the act of writing.\u201d", "x0": 0.13626373626373625, "y0": 0.5843045843045843, "x1": 0.8087912087912088, "y1": 0.5982905982905983}, {"text": "How does the composer of your prescribed text allow you to develop your own", "x0": 0.13626373626373625, "y0": 0.616938616938617, "x1": 0.7736263736263737, "y1": 0.6309246309246309}, {"text": "informed personal understanding of the key ideas in the novel?", "x0": 0.13626373626373625, "y0": 0.6332556332556333, "x1": 0.6428571428571429, "y1": 0.6472416472416472}, {"text": "The prescribed texts are:", "x0": 0.13626373626373625, "y0": 0.6666666666666666, "x1": 0.33296703296703295, "y1": 0.6806526806526807}, {"text": "* Michael Ondaatje, In the Skin ofa Lion", "x0": 0.13736263736263737, "y0": 0.682983682983683, "x1": 0.46483516483516485, "y1": 0.6961926961926962}, {"text": "* Tim Winton, Cloudstreet", "x0": 0.13736263736263737, "y0": 0.6993006993006993, "x1": 0.35274725274725277, "y1": 0.7125097125097125}, {"text": "* Gail Jones, Sixty Lights", "x0": 0.13736263736263737, "y0": 0.7156177156177156, "x1": 0.3373626373626374, "y1": 0.7296037296037297}, {"text": "+ Charlotte Bronte, Jane Eyre", "x0": 0.13736263736263737, "y0": 0.7319347319347319, "x1": 0.37362637362637363, "y1": 0.7451437451437452}, {"text": "OR", "x0": 0.4703296703296703, "y0": 0.7816627816627817, "x1": 0.5, "y1": 0.7925407925407926}], [{"text": "Question 5 \u2014 Drama (20 marks)", "x0": 0.12307692307692308, "y0": 0.0979020979020979, "x1": 0.42747252747252745, "y1": 0.11188811188811189}, {"text": "Nora: Dr Rank? You don\u2019t think I\u2019d ever ask him...? Though I\u2019m sure if I did...", "x0": 0.1824175824175824, "y0": 0.14296814296814297, "x1": 0.7736263736263737, "y1": 0.1561771561771562}, {"text": "Mrs Linde: Which you won't.", "x0": 0.1835164835164835, "y0": 0.1655011655011655, "x1": 0.4, "y1": 0.17793317793317792}, {"text": "Nora: Of course I won\u2019t. But if T di", "x0": 0.1824175824175824, "y0": 0.18026418026418026, "x1": 0.44175824175824174, "y1": 0.20512820512820512}, {"text": "Mrs Linde: Behind your husband\u2019s back?", "x0": 0.1824175824175824, "y0": 0.2097902097902098, "x1": 0.4879120879120879, "y1": 0.22144522144522144}, {"text": "Nora: I'll finish with the other one. That\u2019s also behind his back. I\u2019ve got to finish it.", "x0": 0.1824175824175824, "y0": 0.23154623154623155, "x1": 0.7978021978021979, "y1": 0.24553224553224554}, {"text": "Mrs Linde: I said so yesterday. But \u2014", "x0": 0.1813186813186813, "y0": 0.2463092463092463, "x1": 0.4582417582417582, "y1": 0.27195027195027194}, {"text": "Nora: (pacing). It\u2019s easy for a man to end that kind of thing. But a wife...", "x0": 0.1813186813186813, "y0": 0.26884226884226886, "x1": 0.721978021978022, "y1": 0.29448329448329447}, {"text": "Mrs Linde: Her husband could do it.", "x0": 0.1813186813186813, "y0": 0.29836829836829837, "x1": 0.45054945054945056, "y1": 0.3084693084693085}, {"text": "Nora: Oh no. (stands still.) When you pay off a debt, you do get your contract back?", "x0": 0.1813186813186813, "y0": 0.31313131313131315, "x1": 0.8021978021978022, "y1": 0.33877233877233875}, {"text": "Mrs Linde: I imagine so.", "x0": 0.1824175824175824, "y0": 0.34265734265734266, "x1": 0.3648351648351648, "y1": 0.3550893550893551}, {"text": "Nora: And you can tear it to bits, burn the nasty, filthy thing.", "x0": 0.1813186813186813, "y0": 0.3651903651903652, "x1": 0.6263736263736264, "y1": 0.3776223776223776}, {"text": "Mrs Linde looks at her, then puts down the sewing and goes to her.", "x0": 0.25274725274725274, "y0": 0.38694638694638694, "x1": 0.7450549450549451, "y1": 0.40015540015540013}, {"text": "Mrs Linde: What is it, Nora?", "x0": 0.1824175824175824, "y0": 0.4094794094794095, "x1": 0.3945054945054945, "y1": 0.4211344211344211}, {"text": "Nora: What?", "x0": 0.1813186813186813, "y0": 0.432012432012432, "x1": 0.27692307692307694, "y1": 0.4421134421134421}, {"text": "Mrs Linde: Something\u2019s happened since yesterday.", "x0": 0.1824175824175824, "y0": 0.45376845376845376, "x1": 0.5593406593406594, "y1": 0.466977466977467}, {"text": "Nora: (going close). Kristine... (listens.) Sh! Torvald. Look, go in there, with the", "x0": 0.18021978021978022, "y0": 0.4763014763014763, "x1": 0.8175824175824176, "y1": 0.48951048951048953}, {"text": "children, d\u2019you mind? Torvald hated seeing dress-making. Anne-Marie\u2019ll help you.", "x0": 0.1813186813186813, "y0": 0.49106449106449107, "x1": 0.7956043956043956, "y1": 0.5042735042735043}, {"text": "\u2018Mrs Linde gathers some of her things.", "x0": 0.35934065934065934, "y0": 0.5135975135975136, "x1": 0.6384615384615384, "y1": 0.526029526029526}, {"text": "Mrs Linde: All right, but I won\u2019t leave the house till we\u2019ve talked about this properly.", "x0": 0.1813186813186813, "y0": 0.5353535353535354, "x1": 0.8120879120879121, "y1": 0.5493395493395493}, {"text": "She goes into the room, left, as Helmer comes in from the hall.", "x0": 0.1824175824175824, "y0": 0.5578865578865578, "x1": 0.6450549450549451, "y1": 0.5703185703185704}, {"text": "Nora: (going to meet him). Darling. I\u2019ve been waiting...", "x0": 0.1813186813186813, "y0": 0.5796425796425796, "x1": 0.5934065934065934, "y1": 0.5928515928515928}, {"text": "Helmer: Was that the dressmaker?", "x0": 0.1824175824175824, "y0": 0.6021756021756022, "x1": 0.43626373626373627, "y1": 0.6122766122766122}, {"text": "Nora: No, Kristine. She\u2019s helping me. I'll look splendid.", "x0": 0.1813186813186813, "y0": 0.6247086247086248, "x1": 0.5967032967032967, "y1": 0.6379176379176379}, {"text": "Helmer: Wasn\u2019t it a good idea?", "x0": 0.1813186813186813, "y0": 0.6464646464646465, "x1": 0.41318681318681316, "y1": 0.6588966588966589}, {"text": "Nora: And aren\u2019t I good at doing it?", "x0": 0.1813186813186813, "y0": 0.6612276612276612, "x1": 0.44835164835164837, "y1": 0.6860916860916861}, {"text": "Helmer: (chucking her under the chin). Good, to agree with your husband? Tut, tut,", "x0": 0.1813186813186813, "y0": 0.6907536907536908, "x1": 0.8175824175824176, "y1": 0.7031857031857032}, {"text": "tut. Well, I'll keep out of the way. You\u2019ll be wanting to try it on.", "x0": 0.1824175824175824, "y0": 0.7055167055167055, "x1": 0.6571428571428571, "y1": 0.7187257187257188}, {"text": "In the context of your critical study, to what extent does your response to the excerpt", "x0": 0.12197802197802197, "y0": 0.7513597513597513, "x1": 0.8175824175824176, "y1": 0.7661227661227661}, {"text": "above from Act 2 of A Doil\u2019s House challenge your notion that the play is primarily", "x0": 0.12197802197802197, "y0": 0.7676767676767676, "x1": 0.8175824175824176, "y1": 0.7824397824397824}, {"text": "about complex relationships?", "x0": 0.12307692307692308, "y0": 0.7847707847707848, "x1": 0.35824175824175825, "y1": 0.7987567987567987}, {"text": "In your response, make detailed references to A Doll\u2019s House.", "x0": 0.12307692307692308, "y0": 0.8313908313908314, "x1": 0.6197802197802198, "y1": 0.8453768453768454}, {"text": "OR", "x0": 0.45604395604395603, "y0": 0.8741258741258742, "x1": 0.4857142857142857, "y1": 0.885003885003885}], [{"text": "Question 6 \u2014 Film (20 marks)", "x0": 0.13956043956043956, "y0": 0.09945609945609946, "x1": 0.4208791208791209, "y1": 0.11421911421911422}, {"text": "\u201cA critical study of Citizen Kane allows us to engage closely with the notion of loss.\u201d", "x0": 0.13956043956043956, "y0": 0.1383061383061383, "x1": 0.8274725274725274, "y1": 0.1522921522921523}, {"text": "How does this represent your understanding of Orson Welles\u2019 film?", "x0": 0.13956043956043956, "y0": 0.16161616161616163, "x1": 0.6846153846153846, "y1": 0.17560217560217561}, {"text": "OR", "x0": 0.4725274725274725, "y0": 0.21445221445221446, "x1": 0.5032967032967033, "y1": 0.22455322455322455}, {"text": "Question 7 \u2014 Poetry (20 marks)", "x0": 0.14065934065934066, "y0": 0.24786324786324787, "x1": 0.44175824175824174, "y1": 0.2634032634032634}, {"text": "Harwood\u2019s exploration of the links between memory and relationships is at the core", "x0": 0.13956043956043956, "y0": 0.2898212898212898, "x1": 0.8351648351648352, "y1": 0.3038073038073038}, {"text": "of her poetry.", "x0": 0.13956043956043956, "y0": 0.30691530691530694, "x1": 0.24835164835164836, "y1": 0.3201243201243201}, {"text": "In the context of your critical study, to what extent does this statement resonate with", "x0": 0.13956043956043956, "y0": 0.32944832944832947, "x1": 0.8362637362637363, "y1": 0.3434343434343434}, {"text": "your own interpretation of Harwood\u2019s poetry?", "x0": 0.13846153846153847, "y0": 0.3395493395493395, "x1": 0.5098901098901099, "y1": 0.3628593628593629}, {"text": "In your response make detailed reference to \u2018Father and Child\u2019 and at least ONE other", "x0": 0.13956043956043956, "y0": 0.36985236985236986, "x1": 0.8351648351648352, "y1": 0.3838383838383838}, {"text": "poem set for study.", "x0": 0.13846153846153847, "y0": 0.3861693861693862, "x1": 0.2923076923076923, "y1": 0.40015540015540013}, {"text": "OR", "x0": 0.4725274725274725, "y0": 0.439005439005439, "x1": 0.5021978021978022, "y1": 0.4491064491064491}, {"text": "Question 8 \u2014 Nonfiction (20 marks)", "x0": 0.13956043956043956, "y0": 0.47474747474747475, "x1": 0.48021978021978023, "y1": 0.48951048951048953}, {"text": "A critical study of these texts allows us to engage closely with the notion of loss.\u201d", "x0": 0.13956043956043956, "y0": 0.508935508935509, "x1": 0.7978021978021979, "y1": 0.5229215229215229}, {"text": "How does this represent your understanding of at least TWO essays/speeches", "x0": 0.13956043956043956, "y0": 0.5174825174825175, "x1": 0.7615384615384615, "y1": 0.5439005439005439}, {"text": "prescribed for study?", "x0": 0.13846153846153847, "y0": 0.5423465423465423, "x1": 0.3087912087912088, "y1": 0.5563325563325563}, {"text": "The prescribed texts are:", "x0": 0.13846153846153847, "y0": 0.574980574980575, "x1": 0.33516483516483514, "y1": 0.5889665889665889}, {"text": "* George Orwell, George Orwell: Essays", "x0": 0.13956043956043956, "y0": 0.5912975912975913, "x1": 0.46813186813186813, "y1": 0.6052836052836053}, {"text": "+ Paul Keating ~ \u201cFuneral Service of the Unknown Australian Soldier\u201d, 1993", "x0": 0.13956043956043956, "y0": 0.6076146076146076, "x1": 0.7571428571428571, "y1": 0.6208236208236209}, {"text": "* Margaret Atwood \u2014 \u201cSpotty-Handed Villainesses\u201d, 1994", "x0": 0.13956043956043956, "y0": 0.6208236208236209, "x1": 0.6065934065934065, "y1": 0.6418026418026418}, {"text": "+ Aung San Suu Kyi \u2014 \u201cKeynote Address at the Beijing World Conference on", "x0": 0.13956043956043956, "y0": 0.6402486402486403, "x1": 0.7637362637362637, "y1": 0.6542346542346542}, {"text": "Women\u201d, 1995", "x0": 0.13846153846153847, "y0": 0.6573426573426573, "x1": 0.26153846153846155, "y1": 0.6697746697746698}, {"text": "+ Noel Pearson \u2014 \u201cAn Australian History for Us All\u201d, 1996", "x0": 0.13956043956043956, "y0": 0.6728826728826729, "x1": 0.6120879120879121, "y1": 0.6868686868686869}, {"text": "+ Faith Bandler, \u201cFaith, Hope and Reconciliation\u201d, 1999", "x0": 0.13956043956043956, "y0": 0.6899766899766899, "x1": 0.5901098901098901, "y1": 0.7031857031857032}, {"text": "+ William Deane, \u201cIt is Still Winter at Home\u201d, 1999", "x0": 0.13956043956043956, "y0": 0.7055167055167055, "x1": 0.554945054945055, "y1": 0.7187257187257188}, {"text": "+ Anwar Sadat, \u201cSpeech to the Israeli Knesset\u201d, 1977", "x0": 0.13956043956043956, "y0": 0.7226107226107226, "x1": 0.5659340659340659, "y1": 0.7358197358197358}], [{"text": "Section III \u2014 Module C: Representation and Text (20 marks)", "x0": 0.12637362637362637, "y0": 0.0979020979020979, "x1": 0.7274725274725274, "y1": 0.11421911421911422}, {"text": "Attempt ONE question from Questions 11-13", "x0": 0.12637362637362637, "y0": 0.13286713286713286, "x1": 0.5153846153846153, "y1": 0.14607614607614608}, {"text": "Allow about 40 minutes for this section", "x0": 0.12637362637362637, "y0": 0.14918414918414918, "x1": 0.4593406593406593, "y1": 0.16006216006216006}, {"text": "Answer the question ina SEPARATE booklet. Extra writing booklets are available.", "x0": 0.12527472527472527, "y0": 0.18181818181818182, "x1": 0.798901098901099, "y1": 0.1958041958041958}, {"text": "In your answer you will be assessed on how well you:", "x0": 0.11098901098901098, "y0": 0.21445221445221446, "x1": 0.5439560439560439, "y1": 0.22843822843822845}, {"text": "\u00ab demonstrate understanding of and evaluate the relationship between", "x0": 0.14175824175824175, "y0": 0.23232323232323232, "x1": 0.7175824175824176, "y1": 0.2463092463092463}, {"text": "representation and meaning", "x0": 0.17032967032967034, "y0": 0.24864024864024864, "x1": 0.3934065934065934, "y1": 0.2618492618492618}, {"text": "* organise, develop and express ideas using language appropriate to audience,", "x0": 0.14175824175824175, "y0": 0.26573426573426573, "x1": 0.7824175824175824, "y1": 0.2804972804972805}, {"text": "purpose and form", "x0": 0.17032967032967034, "y0": 0.28205128205128205, "x1": 0.3142857142857143, "y1": 0.29603729603729606}, {"text": "Question 11 \u2014 Elective 1: Conflicting Perspectives (20 marks)", "x0": 0.12637362637362637, "y0": 0.3356643356643357, "x1": 0.7241758241758242, "y1": 0.35120435120435123}, {"text": "\u201cThe representation of conflicting perspectives is ultimately designed to position the", "x0": 0.12527472527472527, "y0": 0.36985236985236986, "x1": 0.8043956043956044, "y1": 0.3838383838383838}, {"text": "audience to favour one of these perspectives.\u201d", "x0": 0.12527472527472527, "y0": 0.3861693861693862, "x1": 0.4956043956043956, "y1": 0.40015540015540013}, {"text": "To what extent is this true of your study of Conflicting Perspectives?", "x0": 0.12527472527472527, "y0": 0.4188034188034188, "x1": 0.6791208791208792, "y1": 0.43356643356643354}, {"text": "Refer to your prescribed text and ONE other related text of your own choosing.", "x0": 0.12527472527472527, "y0": 0.4522144522144522, "x1": 0.7626373626373626, "y1": 0.4662004662004662}, {"text": "\u2018The prescribed texts are:", "x0": 0.12527472527472527, "y0": 0.48484848484848486, "x1": 0.3230769230769231, "y1": 0.4988344988344988}, {"text": "+ William Shakespeare, Julius Caesar", "x0": 0.12527472527472527, "y0": 0.5011655011655012, "x1": 0.4307692307692308, "y1": 0.5151515151515151}, {"text": "+ David Guterson, Snow Falling on Cedars", "x0": 0.12527472527472527, "y0": 0.5182595182595182, "x1": 0.4714285714285714, "y1": 0.5314685314685315}, {"text": "+ Peter Whelan, The Herbal Bed", "x0": 0.12527472527472527, "y0": 0.5337995337995338, "x1": 0.38571428571428573, "y1": 0.5470085470085471}, {"text": "+ Barry Levinson, Wag the Dog", "x0": 0.12527472527472527, "y0": 0.5508935508935509, "x1": 0.3791208791208791, "y1": 0.5641025641025641}, {"text": "+ Ted Hughes, Birthday Letters", "x0": 0.12637362637362637, "y0": 0.5672105672105672, "x1": 0.3769230769230769, "y1": 0.5804195804195804}, {"text": "+ Geoffrey Robertson, The Justice Game", "x0": 0.12637362637362637, "y0": 0.5835275835275835, "x1": 0.45164835164835165, "y1": 0.5967365967365967}, {"text": "OR", "x0": 0.4593406593406593, "y0": 0.616938616938617, "x1": 0.489010989010989, "y1": 0.627039627039627}, {"text": "Question 12 \u2014 Elective 2: History and Memory (20 marks)", "x0": 0.12527472527472527, "y0": 0.6503496503496503, "x1": 0.6934065934065934, "y1": 0.6658896658896659}, {"text": "\u201cThe construction of texts may represent multiple views of history and memory, but", "x0": 0.12527472527472527, "y0": 0.6845376845376845, "x1": 0.8032967032967033, "y1": 0.6985236985236986}, {"text": "these are rarely objective.\u201d", "x0": 0.12527472527472527, "y0": 0.7016317016317016, "x1": 0.34175824175824177, "y1": 0.7148407148407149}, {"text": "Discuss this statement with reference to your prescribed text and ONE text of your", "x0": 0.12527472527472527, "y0": 0.7334887334887334, "x1": 0.7912087912087912, "y1": 0.7474747474747475}, {"text": "own choosing.", "x0": 0.12527472527472527, "y0": 0.7505827505827506, "x1": 0.24175824175824176, "y1": 0.7637917637917638}, {"text": "The prescribed texts are:", "x0": 0.12527472527472527, "y0": 0.7832167832167832, "x1": 0.3230769230769231, "y1": 0.7972027972027972}, {"text": "+ Maxine Hong Kingston, The Woman Warrior", "x0": 0.12637362637362637, "y0": 0.7995337995337995, "x1": 0.5054945054945055, "y1": 0.8127428127428128}, {"text": "+ Peter Carey, The True History of the Kelly Gang", "x0": 0.12637362637362637, "y0": 0.8158508158508159, "x1": 0.5285714285714286, "y1": 0.8290598290598291}, {"text": "+ Stephen Frears, The Queen", "x0": 0.12637362637362637, "y0": 0.8321678321678322, "x1": 0.35494505494505496, "y1": 0.8461538461538461}, {"text": "* Denise Levertoy, Selected Poems", "x0": 0.12637362637362637, "y0": 0.8484848484848485, "x1": 0.4065934065934066, "y1": 0.8616938616938616}, {"text": "+ Mark Raphael Baker, The Fiftieth Gate", "x0": 0.12637362637362637, "y0": 0.8648018648018648, "x1": 0.45384615384615384, "y1": 0.8787878787878788}, {"text": "+ Smithsonian National Museum of American History September 11 website", "x0": 0.12637362637362637, "y0": 0.8811188811188811, "x1": 0.7417582417582418, "y1": 0.8951048951048951}]]