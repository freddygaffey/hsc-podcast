text": "+ Poetry \u2014 William Wordsworth, William Wordsworth: The Major Works", "x0": 0.1437980241492865, "y0": 0.4219114219114219, "x1": 0.8386388583973655, "y1": 0.43512043512043513}, {"text": "The prescribed poems are:", "x0": 0.33260153677277715, "y0": 0.44522144522144524, "x1": 0.544456641053787, "y1": 0.45843045843045843}, {"text": "Lines written a few miles above Tintern Abbey", "x0": 0.3567508232711306, "y0": 0.46853146853146854, "x1": 0.7343578485181119, "y1": 0.48174048174048173}, {"text": "eee RR RE", "x0": 0.3205268935236004, "y0": 0.46853146853146854, "x1": 0.3512623490669594, "y1": 0.5912975912975913}, {"text": "Three years she grew in sun and shower", "x0": 0.3589462129527991, "y0": 0.48562548562548563, "x1": 0.6849615806805708, "y1": 0.4988344988344988}, {"text": "My heart leaps up when I behold", "x0": 0.3567508232711306, "y0": 0.5019425019425019, "x1": 0.6245883644346871, "y1": 0.5151515151515151}, {"text": "Resolution and Independence", "x0": 0.3567508232711306, "y0": 0.519036519036519, "x1": 0.5949506037321625, "y1": 0.5322455322455323}, {"text": "The world is too much with us", "x0": 0.3589462129527991, "y0": 0.5353535353535354, "x1": 0.601536772777168, "y1": 0.5454545454545454}, {"text": "Ode (\u2018There was a time\u2019)", "x0": 0.3578485181119649, "y0": 0.5524475524475524, "x1": 0.5609220636663008, "y1": 0.5656565656565656}, {"text": "The Solitary Reaper", "x0": 0.3589462129527991, "y0": 0.5687645687645687, "x1": 0.5203073545554336, "y1": 0.581973581973582}, {"text": "The Prelude (1805) \u2014 Book One, lines 1-67, 271\u2014 441", "x0": 0.3589462129527991, "y0": 0.585081585081585, "x1": 0.7969264544456641, "y1": 0.5982905982905983}, {"text": "+ Film \u2014 Daniel Nettheim, The Hunter", "x0": 0.1437980241492865, "y0": 0.6223776223776224, "x1": 0.570801317233809, "y1": 0.634032634032634}, {"text": "End of paper", "x0": 0.4445664105378705, "y0": 0.7070707070707071, "x1": 0.5565312843029637, "y1": 0.7195027195027195}]]