[[{"text": "HIGHER", "x0": 0.3150384193194292, "y0": 0.12276612276612277, "x1": 0.3633369923161361, "y1": 0.12975912975912976}, {"text": "BAULKHAM HILLS", "x0": 0.1350164654226125, "y0": 0.12665112665112666, "x1": 0.24368825466520308, "y1": 0.1351981351981352}, {"text": "SCHOOL", "x0": 0.3150384193194292, "y0": 0.1351981351981352, "x1": 0.36882546652030734, "y1": 0.14219114219114218}, {"text": "CERTIFICATE", "x0": 0.31394072447859495, "y0": 0.14840714840714841, "x1": 0.39626783754116357, "y1": 0.1554001554001554}, {"text": "TRIAL EXAMINATION", "x0": 0.30735455543358947, "y0": 0.16161616161616163, "x1": 0.4313940724478595, "y1": 0.1686091686091686}, {"text": "2020", "x0": 0.1437980241492865, "y0": 0.2400932400932401, "x1": 0.2239297475301866, "y1": 0.257964257964258}, {"text": "BAULKHAM HILLS HIGH SCHOOL", "x0": 0.3150384193194292, "y0": 0.2727272727272727, "x1": 0.716794731064764, "y1": 0.2867132867132867}, {"text": "English Extension 1", "x0": 0.33699231613611413, "y0": 0.34887334887334887, "x1": 0.7299670691547749, "y1": 0.37839937839937837}, {"text": "General Reading time \u2014 10 minutes", "x0": 0.11964873765093303, "y0": 0.439005439005439, "x1": 0.5126234906695939, "y1": 0.4592074592074592}, {"text": "Instructions Working time \u2014 2 hours", "x0": 0.11964873765093303, "y0": 0.45998445998445997, "x1": 0.4884742041712404, "y1": 0.47785547785547783}, {"text": "Write using black pen", "x0": 0.283205268935236, "y0": 0.48484848484848486, "x1": 0.47200878155872666, "y1": 0.4988344988344988}, {"text": "Total marks: Section | \u2014 25 marks (pages 2-3)", "x0": 0.11964873765093303, "y0": 0.5384615384615384, "x1": 0.5718990120746432, "y1": 0.5516705516705517}, {"text": "50 Attempt Question 1", "x0": 0.11964873765093303, "y0": 0.5563325563325563, "x1": 0.45334796926454446, "y1": 0.5765345765345765}, {"text": "Allow about 1 hour for this section", "x0": 0.283205268935236, "y0": 0.5811965811965812, "x1": 0.5850713501646543, "y1": 0.602952602952603}, {"text": "Section Il \u2014 25 marks (pages", "x0": 0.2667398463227223, "y0": 0.616938616938617, "x1": 0.5323819978046103, "y1": 0.6301476301476302}, {"text": "Attempt ONE question from Questions 2-6", "x0": 0.283205268935236, "y0": 0.6410256410256411, "x1": 0.6608122941822173, "y1": 0.655011655011655}, {"text": "Allow about 1 hour for this section", "x0": 0.283205268935236, "y0": 0.6627816627816627, "x1": 0.5894621295279913, "y1": 0.6736596736596736}], [{"text": "Section I\u2014 Common Module: Literary Worlds", "x0": 0.14050493962678376, "y0": 0.055944055944055944, "x1": 0.6048298572996706, "y1": 0.07148407148407149}, {"text": "25 marks", "x0": 0.1394072447859495, "y0": 0.08857808857808858, "x1": 0.21844127332601537, "y1": 0.09867909867909867}, {"text": "Attempt Question 1", "x0": 0.1394072447859495, "y0": 0.1048951048951049, "x1": 0.3062568605927552, "y1": 0.11810411810411811}, {"text": "Allow about 1 hour for this section", "x0": 0.1394072447859495, "y0": 0.12198912198912198, "x1": 0.43578485181119647, "y1": 0.1320901320901321}, {"text": "Answer the question in the writing booklet. Extra writing booklets are available.", "x0": 0.1394072447859495, "y0": 0.1554001554001554, "x1": 0.7848518111964874, "y1": 0.1686091686091686}, {"text": "Your answer will be assessed on how well you:", "x0": 0.1394072447859495, "y0": 0.1958041958041958, "x1": 0.5192096597145993, "y1": 0.20901320901320902}, {"text": "+ demonstrate an understanding of the ideas and values of Literary Worlds and", "x0": 0.17014270032930845, "y0": 0.20823620823620823, "x1": 0.8331503841931943, "y1": 0.23465423465423466}, {"text": "how they are shaped and reflected in texts", "x0": 0.19978046103183314, "y0": 0.23465423465423466, "x1": 0.54006586169045, "y1": 0.24786324786324787}, {"text": "+ sustained composition appropriate to the question, demonstrating control", "x0": 0.17014270032930845, "y0": 0.2571872571872572, "x1": 0.8331503841931943, "y1": 0.2703962703962704}, {"text": "of the use of language", "x0": 0.19538968166849616, "y0": 0.2665112665112665, "x1": 0.3765093304061471, "y1": 0.29292929292929293}, {"text": "Use Text I and Text 2 to answer Question 1.", "x0": 0.14050493962678376, "y0": 0.32245532245532244, "x1": 0.4983534577387486, "y1": 0.3356643356643357}, {"text": "Text 1 \u2014 Nonfiction Extract", "x0": 0.1394072447859495, "y0": 0.35664335664335667, "x1": 0.3743139407244786, "y1": 0.3667443667443667}, {"text": "\u201cBut back to our City of Invention. Let me put it like this - writers create Houses of the", "x0": 0.15697036223929747, "y0": 0.3745143745143745, "x1": 0.7980241492864983, "y1": 0.3954933954933955}, {"text": "Imagination and Speculation, from whose doors the generations greet each other...in and out", "x0": 0.15697036223929747, "y0": 0.3947163947163947, "x1": 0.8375411635565313, "y1": 0.40714840714840717}, {"text": "of the centuries.", "x0": 0.15697036223929747, "y0": 0.4017094017094017, "x1": 0.27332601536772777, "y1": 0.42657342657342656}, {"text": "And thus, by such discussion and such shared experience, do we understand ourselves and", "x0": 0.15697036223929747, "y0": 0.44133644133644134, "x1": 0.8221734357848518, "y1": 0.45376845376845376}, {"text": "one another, and our pasts and our futures. It is in the literature, the novels, the fantasy, the", "x0": 0.15697036223929747, "y0": 0.4560994560994561, "x1": 0.8254665203073546, "y1": 0.46853146853146854}, {"text": "fiction of the past, that you find rea! history, and not in text books. Thomas More's Utopia", "x0": 0.15697036223929747, "y0": 0.4630924630924631, "x1": 0.8210757409440176, "y1": 0.48795648795648794}, {"text": "tells us as much about his own century, his own world, as the one he invented for the", "x0": 0.15697036223929747, "y0": 0.4864024864024864, "x1": 0.7826564215148188, "y1": 0.4988344988344988}, {"text": "delectation of his peers.", "x0": 0.15697036223929747, "y0": 0.4933954933954934, "x1": 0.33040614709110866, "y1": 0.5182595182595182}, {"text": "Writers are privileged visitors here. They have a house or two of their own in the City, after", "x0": 0.15697036223929747, "y0": 0.5244755244755245, "x1": 0.8331503841931943, "y1": 0.5493395493395493}, {"text": "all, Perhaps even well-thought of, and nicely maintained: or perhaps never much reckoned", "x0": 0.15697036223929747, "y0": 0.5477855477855478, "x1": 0.8221734357848518, "y1": 0.5602175602175602}, {"text": "and falling into disrepair. But to have a house of any kind, even to have brought it only to", "x0": 0.15697036223929747, "y0": 0.5547785547785548, "x1": 0.8166849615806806, "y1": 0.5796425796425796}, {"text": "planning stage, and have given up in despair, is to realise more fully the wonder of the City,", "x0": 0.15697036223929747, "y0": 0.5773115773115773, "x1": 0.8331503841931943, "y1": 0.5897435897435898}, {"text": "and to know how its houses are built: to know also that though one brick may look much like", "x0": 0.15697036223929747, "y0": 0.5928515928515928, "x1": 0.8430296377607025, "y1": 0.6052836052836053}, {"text": "another, and all builders go about their work in much the same way, some buildings will be", "x0": 0.15697036223929747, "y0": 0.6076146076146076, "x1": 0.8298572996706916, "y1": 0.62004662004662}, {"text": "good, some bad. And a very few, sometimes the least suspected, will last, and not crumble", "x0": 0.15697036223929747, "y0": 0.6223776223776224, "x1": 0.823271130625686, "y1": 0.6348096348096348}, {"text": "with the decades.", "x0": 0.15697036223929747, "y0": 0.6379176379176379, "x1": 0.28210757409440174, "y1": 0.6472416472416472}, {"text": "Builders vary in intellect, aspiration, talent and efficiency; they build well or badly in", "x0": 0.15697036223929747, "y0": 0.668997668997669, "x1": 0.7848518111964874, "y1": 0.6814296814296814}, {"text": "different suburbs of the City. Some build because they need to, have to, live to, or believe", "x0": 0.15697036223929747, "y0": 0.6837606837606838, "x1": 0.8177826564215148, "y1": 0.6961926961926962}, {"text": "they are appointed to, others to prove a point or to change the world. But to build at all", "x0": 0.15697036223929747, "y0": 0.6993006993006993, "x1": 0.7947310647639956, "y1": 0.7117327117327117}, {"text": "requires courage, persistence, faith and a surplus of animation. A writer's all is not taken up", "x0": 0.15697036223929747, "y0": 0.714063714063714, "x1": 0.8298572996706916, "y1": 0.7264957264957265}, {"text": "by the real world. There is something left over: enough for them to build these alternative,", "x0": 0.15697036223929747, "y0": 0.7288267288267288, "x1": 0.8210757409440176, "y1": 0.7412587412587412}, {"text": "finite realities...", "x0": 0.15697036223929747, "y0": 0.7443667443667443, "x1": 0.2711306256860593, "y1": 0.7536907536907537}, {"text": "The good builders, the really good builders, carry a vision out of the real world and transpose", "x0": 0.15697036223929747, "y0": 0.7676767676767676, "x1": 0.8441273326015367, "y1": 0.7925407925407926}, {"text": "it into the City of Invention, and refresh and enlighten the reader, so that on his, or her, return", "x0": 0.15697036223929747, "y0": 0.7902097902097902, "x1": 0.845225027442371, "y1": 0.8026418026418026}, {"text": "to reality, that reality itself is changed, however minutely. A book that has no base in an", "x0": 0.15697036223929747, "y0": 0.797979797979798, "x1": 0.8046103183315039, "y1": 0.8228438228438228}, {"text": "initial reality, written out of reason and not conviction, is a house built of - what shall we say?", "x0": 0.15697036223929747, "y0": 0.8127428127428128, "x1": 0.849615806805708, "y1": 0.8376068376068376}, {"text": "bricks and no mortar? Walk into it, brush against a door frame, and the whole edifice falls", "x0": 0.16794731064763996, "y0": 0.8352758352758353, "x1": 0.8298572996706916, "y1": 0.8477078477078477}, {"text": "down about your ears. Like the first little pig's house of straw, when the big bad wolf huffed", "x0": 0.15697036223929747, "y0": 0.8430458430458431, "x1": 0.8353457738748628, "y1": 0.8679098679098679}, {"text": "and puffed.\u201d", "x0": 0.15697036223929747, "y0": 0.8655788655788655, "x1": 0.24807903402854006, "y1": 0.878010878010878}, {"text": "Extract from Letters to Alice by Fay Weldon", "x0": 0.15697036223929747, "y0": 0.8803418803418803, "x1": 0.48518111964873767, "y1": 0.8927738927738927}], [{"text": "Text 2 \u2014 Prose fiction extract", "x0": 0.1394072447859495, "y0": 0.06682206682206682, "x1": 0.38748627881448955, "y1": 0.07692307692307693}, {"text": "\u2018A wind sprang high in the west, like a wave of unreasonable happiness, and tore eastward", "x0": 0.14489571899012074, "y0": 0.10878010878010878, "x1": 0.8068057080131723, "y1": 0.12121212121212122}, {"text": "across England, trailing with it the frosty scent of forests and the cold intoxication of the sea.", "x0": 0.145993413830955, "y0": 0.12432012432012432, "x1": 0.8287596048298573, "y1": 0.13675213675213677}, {"text": "Ina million holes and corners it refreshed a man like a flagon, and astonished him like a", "x0": 0.145993413830955, "y0": 0.13908313908313907, "x1": 0.7947310647639956, "y1": 0.15151515151515152}, {"text": "blow. In the inmost chambers of intricate and embowered houses it woke like a domestic", "x0": 0.14489571899012074, "y0": 0.15384615384615385, "x1": 0.8002195389681669, "y1": 0.16317016317016317}, {"text": "explosion, littering the floor with some professor's papers till they seemed as precious as", "x0": 0.145993413830955, "y0": 0.1686091686091686, "x1": 0.7969264544456641, "y1": 0.18104118104118105}, {"text": "fugitive, or blowing out the candle by which a boy read Treasure Island and wrapping him in", "x0": 0.145993413830955, "y0": 0.18414918414918416, "x1": 0.8309549945115258, "y1": 0.19658119658119658}, {"text": "roaring dark. But everywhere it bore drama into undramatic lives, and carried the trump of", "x0": 0.145993413830955, "y0": 0.1989121989121989, "x1": 0.814489571899012, "y1": 0.21134421134421136}, {"text": "crisis across the world. Many a harassed mother in a mean backyard had looked at five", "x0": 0.14489571899012074, "y0": 0.21367521367521367, "x1": 0.7848518111964874, "y1": 0.2261072261072261}, {"text": "dwarfish shirts on the clothes-line as at some small, sick tragedy; it was as if she had hanged", "x0": 0.14489571899012074, "y0": 0.22921522921522922, "x1": 0.8265642151481888, "y1": 0.24164724164724163}, {"text": "her five children. The wind came, and they were full and kicking as if five fat imps* had", "x0": 0.145993413830955, "y0": 0.24397824397824397, "x1": 0.7969264544456641, "y1": 0.2564102564102564}, {"text": "sprung into them; and far down in her oppressed subconscious she half-remembered those", "x0": 0.145993413830955, "y0": 0.25874125874125875, "x1": 0.8090010976948409, "y1": 0.27117327117327117}, {"text": "coarse comedies of her father\u2019s when the elves still dwelt in the homes of men. Many an", "x0": 0.14489571899012074, "y0": 0.2742812742812743, "x1": 0.7969264544456641, "y1": 0.2867132867132867}, {"text": "unnoticed girl in a dank walled garden had tossed herself into the hammock with the same", "x0": 0.145993413830955, "y0": 0.2812742812742813, "x1": 0.8100987925356751, "y1": 0.3061383061383061}, {"text": "intolerant gesture with which she might have tossed herself into the Thames*; and that wind", "x0": 0.145993413830955, "y0": 0.3038073038073038, "x1": 0.8254665203073546, "y1": 0.3162393162393162}, {"text": "rent the waving wall of woods and lifted the hammock like a balloon, and showed her shapes", "x0": 0.145993413830955, "y0": 0.31934731934731936, "x1": 0.8309549945115258, "y1": 0.3317793317793318}, {"text": "of quaint clouds far beyond, and pictures of bright villages far below, as if she rode heaven in", "x0": 0.14489571899012074, "y0": 0.32634032634032634, "x1": 0.8342480790340285, "y1": 0.35120435120435123}, {"text": "a fairy boat, Many a dusty clerk or cleric, plodding a telescopic road of poplars*, thought for", "x0": 0.145993413830955, "y0": 0.34887334887334887, "x1": 0.8287596048298573, "y1": 0.3613053613053613}, {"text": "the hundredth time that they were like the plumes of a hearse; when this invisible energy", "x0": 0.14489571899012074, "y0": 0.35664335664335667, "x1": 0.7991218441273326, "y1": 0.3815073815073815}, {"text": "caught and swung and clashed them round his head like a wreath or salutation of seraphic*", "x0": 0.14489571899012074, "y0": 0.3714063714063714, "x1": 0.814489571899012, "y1": 0.3962703962703963}, {"text": "wings. There was in it something more inspired and authoritative even than the old wind of", "x0": 0.14489571899012074, "y0": 0.3939393939393939, "x1": 0.8199780461031834, "y1": 0.4063714063714064}, {"text": "the proverb; for this was the good wind that blows nobody harm.", "x0": 0.14489571899012074, "y0": 0.4094794094794095, "x1": 0.6223929747530187, "y1": 0.4219114219114219}, {"text": "Opening of G.K Chesterton\u2019s Manalive", "x0": 0.14489571899012074, "y0": 0.439005439005439, "x1": 0.44127332601536773, "y1": 0.45143745143745145}, {"text": "*imps \u2014 a small, mischievous sprite or devil", "x0": 0.145993413830955, "y0": 0.46153846153846156, "x1": 0.4676180021953897, "y1": 0.4864024864024864}, {"text": "*the Thames \u2014 the river running through London", "x0": 0.145993413830955, "y0": 0.4763014763014763, "x1": 0.5049396267837541, "y1": 0.5011655011655012}, {"text": "*poplars ~ tall, thin trees that are often line roads or fields as wind breaks", "x0": 0.145993413830955, "y0": 0.49184149184149184, "x1": 0.6871569703622393, "y1": 0.5167055167055167}, {"text": "*seraphic ~ from seraph ~ a celestial being like an angel", "x0": 0.145993413830955, "y0": 0.5066045066045066, "x1": 0.5631174533479693, "y1": 0.5314685314685315}, {"text": "Question 1 (25 marks)", "x0": 0.10976948408342481, "y0": 0.574980574980575, "x1": 0.29308452250274425, "y1": 0.5874125874125874}, {"text": "(a) Use Text 1 and Text 2 to answer this question:", "x0": 0.1394072447859495, "y0": 0.6076146076146076, "x1": 0.5477497255762898, "y1": 0.6208236208236209}, {"text": "Analyse to what extent both texts explore the value of building literary worlds.", "x0": 0.17014270032930845, "y0": 0.6161616161616161, "x1": 0.8024149286498353, "y1": 0.6418026418026418}, {"text": "Draw on your understanding of the module Literary Worlds in your response.", "x0": 0.17014270032930845, "y0": 0.6402486402486403, "x1": 0.7925356750823271, "y1": 0.6534576534576535}, {"text": "(10 marks)", "x0": 0.17014270032930845, "y0": 0.6565656565656566, "x1": 0.25686059275521406, "y1": 0.6697746697746698}, {"text": "(b) Use Text 2 to answer this question:", "x0": 0.1394072447859495, "y0": 0.6891996891996892, "x1": 0.4544456641053787, "y1": 0.7024087024087025}, {"text": "In a sustained piece of imaginative writing, build further on one of the scenarios in", "x0": 0.17014270032930845, "y0": 0.6977466977466977, "x1": 0.8485181119648738, "y1": 0.7218337218337219}, {"text": "the extract; the refreshed man, the professor, the boy reading, the harassed mother,", "x0": 0.17014270032930845, "y0": 0.7218337218337219, "x1": 0.8474204171240395, "y1": 0.7350427350427351}, {"text": "the unnoticed girl, or the dusty clerk to \u201ccarry a vision out of the real world and", "x0": 0.17014270032930845, "y0": 0.7381507381507382, "x1": 0.8485181119648738, "y1": 0.7513597513597513}, {"text": "transpose it\u201d into a world of your own creation.", "x0": 0.17014270032930845, "y0": 0.7544677544677545, "x1": 0.5367727771679474, "y1": 0.7676767676767676}, {"text": "Your response should draw on your knowledge and understanding of the module Literary", "x0": 0.17014270032930845, "y0": 0.7707847707847708, "x1": 0.8474204171240395, "y1": 0.7832167832167832}, {"text": "Worlds and the extracts provided.", "x0": 0.17014270032930845, "y0": 0.7855477855477856, "x1": 0.41822173435784854, "y1": 0.797979797979798}, {"text": "(15 marks)", "x0": 0.17014270032930845, "y0": 0.8010878010878011, "x1": 0.25686059275521406, "y1": 0.8142968142968143}], [{"text": "Section II \u2014 Electives", "x0": 0.11964873765093303, "y0": 0.11577311577311578, "x1": 0.32821075740944017, "y1": 0.12742812742812742}, {"text": "25 marks", "x0": 0.1394072447859495, "y0": 0.15073815073815075, "x1": 0.21844127332601537, "y1": 0.16006216006216006}, {"text": "Attempt ONE question from Questions 2-6", "x0": 0.1394072447859495, "y0": 0.16783216783216784, "x1": 0.5104281009879253, "y1": 0.18026418026418026}, {"text": "Allow about 1 hour for this section", "x0": 0.1394072447859495, "y0": 0.18492618492618493, "x1": 0.43578485181119647, "y1": 0.19425019425019424}, {"text": "\u2018Answer the question in the writing booklet. Extra writing booklets are available.", "x0": 0.1394072447859495, "y0": 0.21678321678321677, "x1": 0.7848518111964874, "y1": 0.22999222999222999}, {"text": "Your answer will be a:", "x0": 0.14050493962678376, "y0": 0.2501942501942502, "x1": 0.31613611416026344, "y1": 0.2602952602952603}, {"text": "ssed on how well you:", "x0": 0.3424807903402854, "y0": 0.2501942501942502, "x1": 0.5203073545554336, "y1": 0.2634032634032634}, {"text": "+ demonstrate an understanding of the ideas and values of Literary Worlds and", "x0": 0.17014270032930845, "y0": 0.26262626262626265, "x1": 0.8331503841931943, "y1": 0.289044289044289}, {"text": "how they are shaped and reflected in texts", "x0": 0.19978046103183314, "y0": 0.289044289044289, "x1": 0.54006586169045, "y1": 0.30225330225330227}, {"text": "+ sustained composition appropriate to the question, demonstrating control", "x0": 0.17014270032930845, "y0": 0.31157731157731156, "x1": 0.8320526893523601, "y1": 0.3247863247863248}, {"text": "of the use of language", "x0": 0.19978046103183314, "y0": 0.3209013209013209, "x1": 0.37760702524698136, "y1": 0.3473193473193473}, {"text": "Question 2 \u2014 Elective 1: Literary Homelands (25 marks)", "x0": 0.1394072447859495, "y0": 0.3651903651903652, "x1": 0.6158068057080132, "y1": 0.37839937839937837}, {"text": "Analyse how your study of the ideas and values in Literary Homelands has deepened your", "x0": 0.1394072447859495, "y0": 0.38927738927738925, "x1": 0.8638858397365532, "y1": 0.4156954156954157}, {"text": "perception of the interplay between diversity and social status.", "x0": 0.1394072447859495, "y0": 0.40559440559440557, "x1": 0.6399560922063666, "y1": 0.432012432012432}, {"text": "In your response, refer to TWO of your prescribed texts and at least ONE related text of", "x0": 0.14050493962678376, "y0": 0.4382284382284382, "x1": 0.8660812294182217, "y1": 0.46464646464646464}, {"text": "your own choosing.", "x0": 0.1394072447859495, "y0": 0.4630924630924631, "x1": 0.29747530186608123, "y1": 0.4763014763014763}, {"text": "The prescribed texts are:", "x0": 0.14270032930845225, "y0": 0.4965034965034965, "x1": 0.3391877058177827, "y1": 0.5097125097125097}, {"text": "+ Prose Fiction \u2014 Aravind Adiga, The White Tiger", "x0": 0.1437980241492865, "y0": 0.5291375291375291, "x1": 0.5960482985729967, "y1": 0.5423465423465423}, {"text": "EM Forster, A Passage to India", "x0": 0.3336992316136114, "y0": 0.5555555555555556, "x1": 0.5949506037321625, "y1": 0.5687645687645687}, {"text": "~ Colm T\u00e9ibin, Brooklyn", "x0": 0.30954994511525796, "y0": 0.5827505827505828, "x1": 0.5203073545554336, "y1": 0.5959595959595959}, {"text": "+ Poetry \u2014 Eileen Chong, Burning Rice", "x0": 0.1437980241492865, "y0": 0.6192696192696193, "x1": 0.562019758507135, "y1": 0.6324786324786325}, {"text": "The prescribed poems are:", "x0": 0.33260153677277715, "y0": 0.6425796425796426, "x1": 0.544456641053787, "y1": 0.6557886557886557}, {"text": "RE", "x0": 0.3336992316136114, "y0": 0.6658896658896659, "x1": 0.3413830954994512, "y1": 0.7055167055167055}, {"text": "Burning Rice", "x0": 0.3567508232711306, "y0": 0.6666666666666666, "x1": 0.4632272228320527, "y1": 0.679098679098679}, {"text": "Mid-autumn Mooncakes", "x0": 0.3567508232711306, "y0": 0.682983682983683, "x1": 0.5521405049396267, "y1": 0.6930846930846931}, {"text": "My Hakka Grandmother", "x0": 0