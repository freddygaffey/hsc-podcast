[[{"text": "Student Number:", "x0": 0.45604395604395603, "y0": 0.06371406371406371, "x1": 0.6164835164835165, "y1": 0.07381507381507381}, {"text": "2020 Higher School Certificate Trial Examination", "x0": 0.17252747252747253, "y0": 0.11577311577311578, "x1": 0.8857142857142857, "y1": 0.13752913752913754}, {"text": "Task 3 \u2014 English Extension 1", "x0": 0.12087912087912088, "y0": 0.3504273504273504, "x1": 0.5296703296703297, "y1": 0.37218337218337216}, {"text": "General", "x0": 0.12967032967032968, "y0": 0.48795648795648794, "x1": 0.1967032967032967, "y1": 0.4972804972804973}, {"text": "Instructions \u00a9 Reading Time \u201410 minutes", "x0": 0.12967032967032968, "y0": 0.5034965034965035, "x1": 0.5868131868131868, "y1": 0.5174825174825175}, {"text": "* Working Time \u2014 2 hours", "x0": 0.3395604395604396, "y0": 0.5244755244755245, "x1": 0.5681318681318681, "y1": 0.5376845376845377}, {"text": "\u00a9 Write using black pen", "x0": 0.3395604395604396, "y0": 0.5415695415695416, "x1": 0.5461538461538461, "y1": 0.5547785547785548}, {"text": "Total marks: Section I \u2014 25 marks (pages 2-3)", "x0": 0.12967032967032968, "y0": 0.5765345765345765, "x1": 0.6164835164835165, "y1": 0.5889665889665889}, {"text": "50 \u00a9 Attempt Question 1", "x0": 0.16923076923076924, "y0": 0.5928515928515928, "x1": 0.5252747252747253, "y1": 0.6060606060606061}, {"text": "Allow about | hour for this section", "x0": 0.37032967032967035, "y0": 0.6107226107226107, "x1": 0.6505494505494506, "y1": 0.6208236208236209}, {"text": "Section II \u2014 25 marks (page 4-8)", "x0": 0.34395604395604396, "y0": 0.6433566433566433, "x1": 0.6164835164835165, "y1": 0.6557886557886557}, {"text": "* Attempt ONE question from Questions 2-6", "x0": 0.3395604395604396, "y0": 0.6604506604506605, "x1": 0.7164835164835165, "y1": 0.6736596736596736}, {"text": "Allow about | hour for this section", "x0": 0.37032967032967035, "y0": 0.6783216783216783, "x1": 0.6505494505494506, "y1": 0.6884226884226884}, {"text": "This paper MUST not be removed from the examination room", "x0": 0.11978021978021978, "y0": 0.846930846930847, "x1": 0.654945054945055, "y1": 0.8593628593628594}], [{"text": "Section I- Common Module", "x0": 0.11978021978021978, "y0": 0.06293706293706294, "x1": 0.4065934065934066, "y1": 0.07459207459207459}, {"text": "iterary Worlds", "x0": 0.44285714285714284, "y0": 0.06371406371406371, "x1": 0.5901098901098901, "y1": 0.07847707847707848}, {"text": "25 marks", "x0": 0.11978021978021978, "y0": 0.0979020979020979, "x1": 0.1989010989010989, "y1": 0.108003108003108}, {"text": "Attempt Question 1", "x0": 0.11978021978021978, "y0": 0.11421911421911422, "x1": 0.2868131868131868, "y1": 0.12742812742812742}, {"text": "Allow about 1 hour for this section", "x0": 0.11978021978021978, "y0": 0.13053613053613053, "x1": 0.4164835164835165, "y1": 0.14063714063714064}, {"text": "Answer the question in a SEPARATE answer booklet.", "x0": 0.11978021978021978, "y0": 0.16317016317016317, "x1": 0.5846153846153846, "y1": 0.17637917637917638}, {"text": "Your answer will be assessed on how well you:", "x0": 0.11978021978021978, "y0": 0.22066822066822067, "x1": 0.5, "y1": 0.2338772338772339}, {"text": "\u00a9 demonstrate an understanding of the ideas and values of Literary Worlds and how they are shaped", "x0": 0.12087912087912088, "y0": 0.22843822843822845, "x1": 0.9263736263736264, "y1": 0.25485625485625485}, {"text": "and reflected in texts", "x0": 0.11978021978021978, "y0": 0.2533022533022533, "x1": 0.2868131868131868, "y1": 0.2634032634032634}, {"text": "\u00a9 craft a sustained composition appropriate to the question, demonstrating control of the use of", "x0": 0.12087912087912088, "y0": 0.26961926961926963, "x1": 0.8879120879120879, "y1": 0.2828282828282828}, {"text": "language", "x0": 0.11978021978021978, "y0": 0.28593628593628595, "x1": 0.1912087912087912, "y1": 0.29914529914529914}, {"text": "Use Text 1 to answer Question 1.", "x0": 0.11978021978021978, "y0": 0.33877233877233875, "x1": 0.4318681318681319, "y1": 0.35353535353535354}, {"text": "Text 1 \u2014 Prose fiction extract", "x0": 0.11978021978021978, "y0": 0.37684537684537683, "x1": 0.4076923076923077, "y1": 0.3885003885003885}, {"text": "As I* proceed to unfold, I hope, the character of Dominic before the reader, I may provoke", "x0": 0.14285714285714285, "y0": 0.44133644133644134, "x1": 0.8681318681318682, "y1": 0.4553224553224553}, {"text": "the criticism: \u2018But that is not consistent with what he has just done.\u2019 The difficulty about", "x0": 0.14285714285714285, "y0": 0.45765345765345766, "x1": 0.8505494505494505, "y1": 0.47086247086247085}, {"text": "Dominic\u2019s character was that it did not appear I can only proceed like the painter", "x0": 0.14395604395604394, "y0": 0.4662004662004662, "x1": 0.8956043956043956, "y1": 0.4926184926184926}, {"text": "Sisley, who, when he wished to convey an effect of green, put a dot of blue on his canvas,", "x0": 0.14285714285714285, "y0": 0.4825174825174825, "x1": 0.8615384615384616, "y1": 0.508935508935509}, {"text": "then a dot of yellow beside it. From a little way off the green thus appears more lively and", "x0": 0.14285714285714285, "y0": 0.4988344988344988, "x1": 0.8637362637362638, "y1": 0.5252525252525253}, {"text": "luminous. So I must put these dots of contradictory colour next to each other in the hope that", "x0": 0.14395604395604394, "y0": 0.5229215229215229, "x1": 0.8846153846153846, "y1": 0.5376845376845377}, {"text": "Dominic may ultimately appear alive. And this is more or less my method \u2014 to give what", "x0": 0.14395604395604394, "y0": 0.5392385392385393, "x1": 0.8538461538461538, "y1": 0.554001554001554}, {"text": "information I can, and let the reader form his own conception of the character.", "x0": 0.14395604395604394, "y0": 0.5563325563325563, "x1": 0.7670329670329671, "y1": 0.5695415695415695}, {"text": "There are certain incidents in his boyhood of which I cannot remember the exact dates, which", "x0": 0.14395604395604394, "y0": 0.5881895881895882, "x1": 0.8923076923076924, "y1": 0.6146076146076146}, {"text": "do throw some light on his character, and one I shall insert here to form, as it were, a", "x0": 0.14395604395604394, "y0": 0.6122766122766122, "x1": 0.8208791208791208, "y1": 0.627039627039627}, {"text": "corrective blue to the happy yellow of the day I have just recorded.", "x0": 0.14395604395604394, "y0": 0.6216006216006216, "x1": 0.6780219780219781, "y1": 0.6480186480186481}, {"text": "\u2014 extract from A Difficult Young Man by Martin Boyd", "x0": 0.4593406593406593, "y0": 0.662004662004662, "x1": 0.8978021978021978, "y1": 0.6868686868686869}, {"text": "* In the novel, A Difficult Young Man, the narrator is Guy Langton, Dominic\u2019s brother", "x0": 0.14505494505494507, "y0": 0.7086247086247086, "x1": 0.8351648351648352, "y1": 0.7218337218337219}, {"text": "Ig gt", "x0": 0.3901098901098901, "y0": 0.7086247086247086, "x1": 0.6527472527472528, "y1": 0.7303807303807304}, {"text": "Question 1 continues overleaf", "x0": 0.3824175824175824, "y0": 0.8834498834498834, "x1": 0.6791208791208792, "y1": 0.8982128982128982}], [{"text": "Question 1 (25 marks)", "x0": 0.11978021978021978, "y0": 0.08313908313908314, "x1": 0.34175824175824177, "y1": 0.09712509712509712}, {"text": "There are two parts to this question.", "x0": 0.11978021978021978, "y0": 0.12043512043512043, "x1": 0.45494505494505494, "y1": 0.13597513597513597}, {"text": "Read both (a) and (b) before you begin writing.", "x0": 0.11978021978021978, "y0": 0.1585081585081585, "x1": 0.5637362637362637, "y1": 0.17404817404817405}, {"text": "Answer each question on a new page.", "x0": 0.11978021978021978, "y0": 0.19658119658119658, "x1": 0.4725274725274725, "y1": 0.21212121212121213}, {"text": "(a) Creative Response Marks", "x0": 0.12967032967032968, "y0": 0.23620823620823622, "x1": 0.9131868131868132, "y1": 0.25097125097125095}, {"text": "Compose a piece of imaginative writing that reveals an inconsistent 15", "x0": 0.189010989010989, "y0": 0.2540792540792541, "x1": 0.8912087912087913, "y1": 0.26961926961926963}, {"text": "or complex individual.", "x0": 0.189010989010989, "y0": 0.27350427350427353, "x1": 0.4, "y1": 0.289044289044289}, {"text": "Your writing may be based on a real or imaginary person.", "x0": 0.189010989010989, "y0": 0.3084693084693085, "x1": 0.7296703296703296, "y1": 0.33022533022533024}, {"text": "In your response, draw on your knowledge and understanding of", "x0": 0.189010989010989, "y0": 0.34965034965034963, "x1": 0.8142857142857143, "y1": 0.3651903651903652}, {"text": "Literary Worlds AND Text 1", "x0": 0.189010989010989, "y0": 0.3690753690753691, "x1": 0.4582417582417582, "y1": 0.38461538461538464}, {"text": "10", "x0": 0.8714285714285714, "y0": 0.40792540792540793, "x1": 0.8912087912087913, "y1": 0.4188034188034188}, {"text": "(b) Critical Response", "x0": 0.12967032967032968, "y0": 0.4257964257964258, "x1": 0.3637362637362637, "y1": 0.44133644133644134}, {"text": "Analyse your creative response in (a) explaining how your writing", "x0": 0.1879120879120879, "y0": 0.44522144522144524, "x1": 0.8120879120879121, "y1": 0.46076146076146074}, {"text": "choices were influenced by your knowledge and understanding of", "x0": 0.189010989010989, "y0": 0.46464646464646464, "x1": 0.8142857142857143, "y1": 0.4801864801864802}, {"text": "literary worlds AND Text 1.", "x0": 0.189010989010989, "y0": 0.48329448329448327, "x1": 0.45274725274725275, "y1": 0.4988344988344988}, {"text": "End of Question 1", "x0": 0.44065934065934065, "y0": 0.9013209013209014, "x1": 0.6175824175824176, "y1": 0.9215229215229215}, {"text": "3", "x0": 0.5263736263736264, "y0": 0.9393939393939394, "x1": 0.5340659340659341, "y1": 0.947940947940948}], [{"text": "Section II \u2014 Electives", "x0": 0.11978021978021978, "y0": 0.06371406371406371, "x1": 0.32857142857142857, "y1": 0.07459207459207459}, {"text": "25 marks", "x0": 0.11978021978021978, "y0": 0.09867909867909867, "x1": 0.1989010989010989