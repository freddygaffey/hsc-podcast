1": 0.2835164835164835, "y1": 0.6130536130536131}, {"text": "Gulliver", "x0": 0.1824175824175824, "y0": 0.6184926184926185, "x1": 0.24835164835164836, "y1": 0.6285936285936286}, {"text": "Out of Time", "x0": 0.1824175824175824, "y0": 0.6371406371406372, "x1": 0.2802197802197802, "y1": 0.6472416472416472}, {"text": "Vesper-Song of the Reverend Samuel Marsden", "x0": 0.1824175824175824, "y0": 0.6557886557886557, "x1": 0.5604395604395604, "y1": 0.668997668997669}, {"text": "William Street", "x0": 0.1824175824175824, "y0": 0.6744366744366744, "x1": 0.2989010989010989, "y1": 0.6845376845376845}, {"text": "Beach Burial", "x0": 0.1824175824175824, "y0": 0.6930846930846931, "x1": 0.2857142857142857, "y1": 0.7031857031857032}, {"text": "\u2014 Jane Harrison, Rainbow's End, from Vivienne Cleven et al., Contemporary Indigenous", "x0": 0.12637362637362637, "y0": 0.7746697746697747, "x1": 0.8373626373626374, "y1": 0.7878787878787878}, {"text": "Plays", "x0": 0.12087912087912088, "y0": 0.7925407925407926, "x1": 0.16483516483516483, "y1": 0.8057498057498057}, {"text": "Arthur Miller, The Crucible", "x0": 0.13626373626373625, "y0": 0.8197358197358198, "x1": 0.36043956043956044, "y1": 0.8313908313908314}], [{"text": "+ Shakespearean Drama", "x0": 0.12197802197802197, "y0": 0.08935508935508936, "x1": 0.3274725274725275, "y1": 0.10178710178710179}, {"text": "\u2014 William Shakespeare, The Merchant of Venice", "x0": 0.12087912087912088, "y0": 0.11577311577311578, "x1": 0.512087912087912, "y1": 0.128982128982129}, {"text": "+ Nonfiction", "x0": 0.12197802197802197, "y0": 0.17094017094017094, "x1": 0.2230769230769231, "y1": 0.18026418026418026}, {"text": "\u2014 Tim Winton, The Boy Behind the Curtain", "x0": 0.12087912087912088, "y0": 0.19735819735819735, "x1": 0.4703296703296703, "y1": 0.21056721056721056}, {"text": "A Life in Accidents", "x0": 0.24505494505494504, "y0": 0.22533022533022534, "x1": 0.4032967032967033, "y1": 0.23543123543123542}, {"text": "Betsy", "x0": 0.1824175824175824, "y0": 0.24475524475524477, "x1": 0.22637362637362637, "y1": 0.2571872571872572}, {"text": "Twice on Sundays", "x0": 0.1824175824175824, "y0": 0.26262626262626265, "x1": 0.32967032967032966, "y1": 0.27583527583527584}, {"text": "The Wait and the Flow", "x0": 0.1824175824175824, "y0": 0.2812742812742813, "x1": 0.367032967032967, "y1": 0.2913752913752914}, {"text": "In the Shadow of the Hospital", "x0": 0.1824175824175824, "y0": 0.29681429681429683, "x1": 0.421978021978022, "y1": 0.3162393162393162}, {"text": "The Demon Shark", "x0": 0.1824175824175824, "y0": 0.3185703185703186, "x1": 0.32857142857142857, "y1": 0.32867132867132864}, {"text": "Barefoot in the Temple of Art", "x0": 0.1824175824175824, "y0": 0.33022533022533024, "x1": 0.421978021978022, "y1": 0.3543123543123543}, {"text": "Yousafzai and Christina Lamb, J am Malala", "x0": 0.1978021978021978, "y0": 0.38306138306138304, "x1": 0.5527472527472528, "y1": 0.3954933954933955}, {"text": "+ Film", "x0": 0.12197802197802197, "y0": 0.43745143745143744, "x1": 0.17252747252747253, "y1": 0.4467754467754468}, {"text": "\u2014 Stephen Daldry, Billy Elliot", "x0": 0.12637362637362637, "y0": 0.46386946386946387, "x1": 0.3648351648351648, "y1": 0.47707847707847706}, {"text": "+ Media", "x0": 0.12197802197802197, "y0": 0.5198135198135199, "x1": 0.18681318681318682, "y1": 0.5291375291375291}, {"text": "\u2014 Ivan O\u2019Mahoney", "x0": 0.12087912087912088, "y0": 0.5454545454545454, "x1": 0.27362637362637365, "y1": 0.5586635586635587}, {"text": "Go Back to Where You Came From", "x0": 0.1824175824175824, "y0": 0.5734265734265734, "x1": 0.46703296703296704, "y1": 0.5835275835275835}, {"text": "~ Series 1: Episodes 1, 2 and 3", "x0": 0.1813186813186813, "y0": 0.6006216006216006, "x1": 0.42747252747252745, "y1": 0.6138306138306139}, {"text": "and", "x0": 0.1824175824175824, "y0": 0.6285936285936286, "x1": 0.2098901098901099, "y1": 0.6386946386946387}, {"text": "The Response", "x0": 0.1835164835164835, "y0": 0.6565656565656566, "x1": 0.2923076923076923, "y1": 0.6697746697746698}, {"text": "\u2014 Lucy Walker, Waste Land", "x0": 0.1813186813186813, "y0": 0.6837606837606838, "x1": 0.4087912087912088, "y1": 0.696969696969697}, {"text": "End of Section II", "x0": 0.42747252747252745, "y0": 0.8445998445998446, "x1": 0.5714285714285714, "y1": 0.8632478632478633}, {"text": "10", "x0": 0.49230769230769234, "y0": 0.9292929292929293, "x1": 0.5087912087912088, "y1": 0.9378399378399378}], [{"text": "STUDENT NUMBER", "x0": 0.6054945054945055, "y0": 0.12043512043512043, "x1": 0.8164835164835165, "y1": 0.13131313131313133}, {"text": "ABBOTSLEIGH", "x0": 0.12087912087912088, "y0": 0.24087024087024086, "x1": 0.2923076923076923, "y1": 0.2517482517482518}, {"text": "2025 HSC TRIAL EXAMINATION", "x0": 0.12197802197802197, "y0": 0.3006993006993007, "x1": 0.5340659340659341, "y1": 0.3139083139083139}, {"text": "English Advanced", "x0": 0.12197802197802197, "y0": 0.3356643356643357, "x1": 0.4065934065934066, "y1": 0.358974358974359}, {"text": "Paper 1 \u2014 Texts and Human Experiences", "x0": 0.12197802197802197, "y0": 0.40714840714840717, "x1": 0.7032967032967034, "y1": 0.4289044289044289}, {"text": "STIMULUS BOOKLET", "x0": 0.12307692307692308, "y0": 0.4763014763014763, "x1": 0.4714285714285714, "y1": 0.4933954933954934}, {"text": "Section I", "x0": 0.12197802197802197, "y0": 0.5143745143745144, "x1": 0.22087912087912087, "y1": 0.5275835275835276}, {"text": "Text One \u2014 Discursive articl", "x0": 0.1824175824175824, "y0": 0.5796425796425796, "x1": 0.41318681318681316, "y1": 0.5897435897435898}, {"text": "Text Two \u2014 Magazine cover.", "x0": 0.1824175824175824, "y0": 0.5990675990675991, "x1": 0.4164835164835165, "y1": 0.6114996114996115}, {"text": "Text Three \u2014 Poem", "x0": 0.1824175824175824, "y0": 0.6177156177156177, "x1": 0.34285714285714286, "y1": 0.627039627039627}, {"text": "Text Four \u2014 Prose extract", "x0": 0.1824175824175824, "y0": 0.6363636363636364, "x1": 0.3923076923076923, "y1": 0.6456876456876457}, {"text": "Text Five \u2014 Memoir extra", "x0": 0.1824175824175824, "y0": 0.655011655011655, "x1": 0.3923076923076923, "y1": 0.6643356643356644}], [{"text": "Text 1 \u2014 Discursive article", "x0": 0.12197802197802197, "y0": 0.08935508935508936, "x1": 0.34395604395604396, "y1": 0.09867909867909867}, {"text": "Misery Loves Company", "x0": 0.12087912087912088, "y0": 0.11655011655011654, "x1": 0.3153846153846154, "y1": 0.128982128982129}, {"text": "It\u2019s wedding season in the US, which means that a lot of money will be spent on venues,", "x0": 0.12197802197802197, "y0": 0.14296814296814297, "x1": 0.8769230769230769, "y1": 0.1561771561771562}, {"text": "decorations, flowers, appetisers, alcohol, photographers, and gifts. Toasts will be made,", "x0": 0.12197802197802197, "y0": 0.16083916083916083, "x1": 0.878021978021978, "y1": 0.17404817404817405}, {"text": "champagne-induced laughter will drown out small talk, and middle-aged bodies will take over", "x0": 0.12197802197802197, "y0": 0.17871017871017872, "x1": 0.8791208791208791, "y1": 0.1919191919191919}, {"text": "the dance floor, shaking off anxieties induced by this chaotic world. Third cousins will", "x0": 0.12197802197802197, "y0": 0.1958041958041958, "x1": 0.8769230769230769, "y1": 0.20901320901320902}, {"text": "reconnect over vats of pasta. Instagram reels will be created, gossip will be spread, and, after", "x0": 0.12197802197802197, "y0": 0.20512820512820512, "x1": 0.8791208791208791, "y1": 0.23154623154623155}, {"text": "midnight, all of Cinderella\u2019s horses will turn back into mice and sink into large beds, their ears", "x0": 0.12197802197802197, "y0": 0.23154623154623155, "x1": 0.878021978021978, "y1": 0.24475524475524477}, {"text": "still ringing with party music.", "x0": 0.12197802197802197, "y0": 0.2494172494172494, "x1": 0.35824175824175825, "y1": 0.26262626262626265}, {"text": "This year, I\u2019ve got three weddings in my family, and I am skipping them all. To be fair, my", "x0": 0.12197802197802197, "y0": 0.27583527583527584, "x1": 0.878021978021978, "y1": 0.289044289044289}, {"text": "niece is having an \u2018intimate\u2019 wedding, which I am grateful not to be invited to. My nephew is", "x0": 0.12197802197802197, "y0": 0.2937062937062937, "x1": 0.878021978021978, "y1": 0.30691530691530694}, {"text": "skipping the big party in lieu of a down payment for a house. As for my brother, I went to his", "x0": 0.12197802197802197, "y0": 0.3038073038073038, "x1": 0.878021978021978, "y1": 0.3278943278943279}, {"text": "first wedding, where I learned that the minutes I will get to spend with him won\u2019t justify the", "x0": 0.12197802197802197, "y0": 0.32944832944832947, "x1": 0.878021978021978, "y1": 0.34265734265734266}, {"text": "exorbitant airline ticket price. There won't be time for a meaningful connection in that", "x0": 0.12197802197802197, "y0": 0.3473193473193473, "x1": 0.878021978021978, "y1": 0.3605283605283605}, {"text": "celebratory space.", "x0": 0.12197802197802197, "y0": 0.3651903651903652, "x1": 0.26483516483516484, "y1": 0.37839937839937837}, {"text": "But there\u2019s also a philosophical reason for skipping out on weddings. The Spanish philosopher", "x0": 0.12197802197802197, "y0": 0.3916083916083916, "x1": 0.8758241758241758, "y1": 0.4048174048174048}, {"text": "Miguel de Unamuno believed that joyful occasions just don\u2019t encourage deep connection. Joy", "x0": 0.12197802197802197, "y0": 0.4094794094794095, "x1": 0.878021978021978, "y1": 0.4226884226884227}, {"text": "is the emotion to choose if you want levity, fun, silliness \u2014a good time. Even Unamuno had to", "x0": 0.12197802197802197, "y0": 0.42735042735042733, "x1": 0.878021978021978, "y1": 0.4405594405594406}, {"text": "admit that \u201cbodies are united by pleasure.\u201d But if after early morning heart-to-hearts,", "x0": 0.12197802197802197, "y0": 0.44522144522144524, "x1": 0.8769230769230769, "y1": 0.45843045843045843}, {"text": "soul conspiracy, and blood brotherhood, joy isn\u2019t the strongest player on the bench. Upbeat", "x0": 0.12197802197802197, "y0": 0.46231546231546233, "x1": 0.878021978021978, "y1": 0.4755244755244755}, {"text": "feelings will insulate you from anyone who might spoil your fun, The last thing you want when", "x0": 0.12197802197802197, "y0": 0.4801864801864802, "x1": 0.878021978021978, "y1": 0.4933954933954934}, {"text": "you\u2019 ve got your mojo is a wet blanket trying to make eye contact. When we're up, we turn our", "x0": 0.12197802197802197, "y0": 0.48951048951048953, "x1": 0.8791208791208791, "y1": 0.515928515928516}, {"text": "heads away from the misery that lies beneath.", "x0": 0.12197802197802197, "y0": 0.5151515151515151, "x1": 0.4879120879120879, "y1": 0.5283605283605284}, {"text": "But when we\u2019re down, Unamuno found, the gig is up. \u201cSouls are united by pain,\u201d he wrote in", "x0": 0.12197802197802197, "y0": 0.5431235431235432, "x1": 0.878021978021978, "y1": 0.5563325563325563}, {"text": "The Tragic Sense of Life. Misery is muscular. It\u2019s willing to admit that suffering is ubiquitous.", "x0": 0.12307692307692308, "y0": 0.5524475524475524, "x1": 0.8769230769230769, "y1": 0.5765345765345765}, {"text": "And when we are sad, it can be comforting to be in the presence of a person who has lowered", "x0": 0.12087912087912088, "y0": 0.5703185703185704, "x1": 0.878021978021978, "y1": 0.5944055944055944}, {"text": "their mask. Shared sorrow is why groups exist, and why a person might feel that they can be", "x0": 0.12197802197802197, "y0": 0.5959595959595959, "x1": 0.878021978021978, "y1": 0.6091686091686092}, {"text": "emotionally honest there. In Unamuno\u2019s eyes, sorrow draws us into a cocoon \u2014 a mortar of", "x0": 0.12197802197802197, "y0": 0.6138306138306139, "x1": 0.8802197802197802, "y1": 0.627039627039627}, {"text": "suffering, he called it \u2014 away from the blinding sunshine of toxic positivity.", "x0": 0.12197802197802197, "y0": 0.6231546231546231, "x1": 0.7285714285714285, "y1": 0.6472416472416472}, {"text": "Calling up sadness in the clutch is a risky move because, in many societies it\u2019s seen as a burden", "x0": 0.12197802197802197, "y0": 0.6581196581196581, "x1": 0.8769230769230769, "y1": 0.6713286713286714}, {"text": "we shouldn\u2019t lay on our loved ones. Many of us were taught to hide our emotional and physical", "x0": 0.12197802197802197, "y0": 0.6674436674436675, "x1": 0.878021978021978, "y1": 0.6938616938616938}, {"text": "pain as an act of love for others, So, whether it\u2019s hiding a diagnosis from a parent, or not", "x0": 0.12087912087912088, "y0": 0.6938616938616938, "x1": 0.878021978021978, "y1": 0.7070707070707071}, {"text": "disclosing a worry, sadness, or fear to a best friend, we have become experts at \u2018protecting\u2019", "x0": 0.12197802197802197, "y0": 0.7117327117327117, "x1": 0.8769230769230769, "y1": 0.7249417249417249}, {"text": "one another. Our self-sacrifice is motivated by care: since we think that sharing pain causes", "x0": 0.12197802197802197, "y0": 0.7296037296037297, "x1": 0.878021978021978, "y1": 0.7428127428127428}, {"text": "pain, we keep secrets in the name of love. But what if Unamuno is right? What if communion", "x0": 0.12087912087912088, "y0": 0.7381507381507382, "x1": 0.878021978021978, "y1": 0.7645687645687645}, {"text": "comes from compassion, and compassion from suffering? If we continue to see sadness as a", "x0": 0.12197802197802197, "y0": 0.7645687645687645, "x1": 0.878021978021978, "y1": 0.7777777777777778}, {"text": "burden, then we'll smile through the pain and abandon the shared road of compassion.", "x0": 0.12087912087912088, "y0": 0.7824397824397824, "x1": 0.8142857142857143, "y1": 0.7956487956487956}, {"text": "So, if the goal is deep connection, we \u00a2", "x0": 0.12197802197802197, "y0": 0.8096348096348096, "x1": 0.44505494505494503, "y1": 0.8228438228438228}, {"text": "rt looking for it in the neglected corners of our", "x0": 0.4945054945054945, "y0": 0.8096348096348096, "x1": 0.8791208791208791, "y1": 0.8228438228438228}, {"text": "lives. We'll find each other in the cobwebs", "x0": 0.12197802197802197, "y0": 0.8267288267288267, "x1": 0.46263736263736266, "y1": 0.8368298368298368}, {"text": ", in the dark, and at funerals.", "x0": 0.46703296703296704, "y0": 0.8267288267288267, "x1": 0.6956043956043956, "y1": 0.8391608391608392}, {"text": "existing or being everywhere, especially at the same time", "x0": 0.2164835164835165, "y0": 0.8663558663558664, "x1": 0.5989010989010989, "y1": 0.8772338772338772}, {"text": "MARIANNA ALESSANDRI", "x0": 0.6362637362637362, "y0": 0.891996891996892, "x1": 0.8747252747252747, "y1": 0.9013209013209014}], [{"text": "Text 2 \u2014 Magazine cover", "x0": 0.12197802197802197, "y0": 0.08935508935508936, "x1": 0.33076923076923076, "y1": 0.10178710178710179}, {"text": "SEPT. 9, 2024", "x0": 0.689010989010989, "y0": 0.16705516705516704, "x1": 0.823076923076923, "y1": 0.17871017871017872}, {"text": "YN", "x0": 0.6076923076923076, "y0": 0.5928515928515928, "x1": 0.6186813186813187, "y1": 0.5982905982905983}, {"text": "/", "x0": 0.7450549450549451, "y0": 0.62004662004662, "x1": 0.7604395604395604, "y1": 0.6278166278166278}], [{"text": "Text Poem", "x0": 0.12197802197802197, "y0": 0.08935508935508936, "x1": 0.24285714285714285, "y1": 0.09867909867909867}, {"text": "A Country Childhood", "x0": 0.11978021978021978, "y0": 0.12432012432012432, "x1": 0.3010989010989011, "y1": 0.13752913752913754}, {"text": "Near old Dunkeld bluestones in the faulted Grampians", "x0": 0.12197802197802197, "y0": 0.1592851592851593, "x1": 0.5681318681318681, "y1": 0.17249417249417248}, {"text": "where corellas dipped and looped, you stood shoulder", "x0": 0.13186813186813187, "y0": 0.17715617715617715, "x1": 0.5692307692307692, "y1": 0.19036519036519037}, {"text": "high in scratchy heather and picked blue tinsel lilies,", "x0": 0.12197802197802197, "y0": 0.19502719502719504, "x1": 0.5428571428571428, "y1": 0.20823620823620823}, {"text": "golden moth orchids and green correas, parrot peas \u2014", "x0": 0.12197802197802197, "y0": 0.22999222999222999, "x1": 0.5483516483516484, "y1": 0.2432012432012432}, {"text": "wildflowers with crimped petals studing the ground", "x0": 0.13186813186813187, "y0": 0.24786324786324787, "x1": 0.5571428571428572, "y1": 0.26107226107226106}, {"text": "in a tumble of splintered stars, But remember, too,", "x0": 0.12197802197802197, "y0": 0.2571872571872572, "x1": 0.5252747252747253, "y1": 0.2836052836052836}, {"text": "the sweetish stink of flesh gone bad, how wind ruined", "x0": 0.12197802197802197, "y0": 0.29215229215229216, "x1": 0.554945054945055, "y1": 0.3185703185703186}, {"text": "silver banksia, crows gulped steaming guts torn from", "x0": 0.13186813186813187, "y0": 0.3185703185703186, "x1": 0.5582417582417583, "y1": 0.3317793317793318}, {"text": "inside a rabbit\u2019s belly and spilled from beaks as they flew", "x0": 0.12197802197802197, "y0": 0.33644133644133645, "x1": 0.5846153846153846, "y1": 0.34965034965034963}, {"text": "off, trailing crinoline. And how a solemn faced", "x0": 0.12197802197802197, "y0": 0.3714063714063714, "x1": 0.5032967032967033, "y1": 0.38461538461538464}, {"text": "child stood in dusky purple leaves below a yellow", "x0": 0.13186813186813187, "y0": 0.38927738927738925, "x1": 0.532967032967033, "y1": 0.4024864024864025}, {"text": "wreathe of wattle, a gun held slackly along one arm.", "x0": 0.12197802197802197, "y0": 0.40714840714840717, "x1": 0.5406593406593406, "y1": 0.42035742035742035}, {"text": "This evening, as you watch the scarlet maple", "x0": 0.12197802197802197, "y0": 0.4421134421134421, "x1": 0.4824175824175824, "y1": 0.4553224553224553}, {"text": "bleed out on the lawn, you count them: the time", "x0": 0.13186813186813187, "y0": 0.45998445998445997, "x1": 0.5153846153846153, "y1": 0.4731934731934732}, {"text": "you fought off dogs hellbent on ripping crimson", "x0": 0.12197802197802197, "y0": 0.4693084693084693, "x1": 0.5087912087912088, "y1": 0.49572649572649574}, {"text": "chasms in the fox\u2019s cloud-soft throat; and returned", "x0": 0.12197802197802197, "y0": 0.5128205128205128, "x1": 0.5274725274725275, "y1": 0.5252525252525253}, {"text": "a shallow-mouthed trout from a hook into the brown", "x0": 0.13186813186813187, "y0": 0.5306915306915307, "x1": 0.5538461538461539, "y1": 0.5407925407925408}, {"text": "liquid soul that was its river; and scared wild ducks", "x0": 0.12197802197802197, "y0": 0.5485625485625486, "x1": 0.5340659340659341, "y1": 0.5617715617715617}, {"text": "off the lake before the gunmen came, laughter inside", "x0": 0.12197802197802197, "y0": 0.5835275835275835, "x1": 0.545054945054945, "y1": 0.5967365967365967}, {"text": "their slaughter leaking into dawn; and freed a furry", "x0": 0.13186813186813187, "y0": 0.6013986013986014, "x1": 0.5406593406593406, "y1": 0.6146076146076146}, {"text": "huntsman, long legs unfurled inside a window screen;", "x0": 0.12197802197802197, "y0": 0.6192696192696193, "x1": 0.5538461538461539, "y1": 0.6324786324786325}, {"text": "and all the bees; and the bogong moth \u2014 velvet as cob-", "x0": 0.12197802197802197, "y0": 0.6542346542346542, "x1": 0.5582417582417583, "y1": 0.6674436674436675}, {"text": "webs on lips \u2014 sifted from water for summer\u2019s breath", "x0": 0.13186813186813187, "y0": 0.6721056721056721, "x1": 0.5582417582417583, "y1": 0.6853146853146853}, {"text": "to dry drenched wings; and countless birds retrieved", "x0": 0.12197802197802197, "y0": 0.6899766899766899, "x1": 0.5417582417582417, "y1": 0.7031857031857032}, {"text": "like the bird that dropped down dead, when, aged ten,", "x0": 0.12197802197802197, "y0": 0.7249417249417249, "x1": 0.5527472527472528, "y1": 0.7381507381507382}, {"text": "you raised the .22, steadied your sights on that knot", "x0": 0.13186813186813187, "y0": 0.7428127428127428, "x1": 0.545054945054945, "y1": 0.756021756021756}, {"text": "of feather and little bones, and cleanly took the shot. JO GARDINER", "x0": 0.12197802197802197, "y0": 0.7606837606837606, "x1": 0.8769230769230769, "y1": 0.7738927738927739}, {"text": "Grampians: an iconic and wild mountain range located in western Victoria, Australia.", "x0": 0.12197802197802197, "y0": 0.8135198135198135, "x1": 0.8186813186813187, "y1": 0.8267288267288267}, {"text": "corellas: a species of white cockatoo", "x0": 0.12197802197802197, "y0": 0.8313908313908314, "x1": 0.4186813186813187, "y1": 0.8445998445998446}, {"text": "crinoline: a structured petticoat, shaped like a large hoop, worn under a long skirt", "x0": 0.12197802197802197, "y0": 0.8492618492618492, "x1": 0.8593406593406593, "y1": 0.8624708624708625}, {"text": "22: a rifle, firearm", "x0": 0.12197802197802197, "y0": 0.8663558663558664, "x1": 0.27362637362637365, "y1": 0.8787878787878788}], [{"text": "Text 4 \u2014 Prose extract", "x0": 0.12197802197802197, "y0": 0.08935508935508936, "x1": 0.3087912087912088, "y1": 0.09867909867909867}, {"text": "Where the Water\u2019s Deepest", "x0": 0.12307692307692308, "y0": 0.1250971250971251, "x1": 0.34615384615384615, "y1": 0.13752913752913754}, {"text": "NB: An au pair, similar to a nanny, is a young person from a foreign country who lives with a", "x0": 0.12087912087912088, "y0": 0.1592851592851593, "x1": 0.878021978021978, "y1": 0.17249417249417248}, {"text": "host family to provide childcare and light housework in exchange for room, board, and a", "x0": 0.12087912087912088, "y0": 0.17715617715617715, "x1": 0.878021978021978, "y1": 0.19036519036519037}, {"text": "weekly allowance.", "x0": 0.12197802197802197, "y0": 0.19502719502719504, "x1": 0.26593406593406593, "y1": 0.20823620823620823}, {"text": "Last winter they travelled north, a three-hour flight to New York City for the long weekend.", "x0": 0.12197802197802197, "y0": 0.22999222999222999, "x1": 0.8769230769230769, "y1": 0.2432012432012432}, {"text": "They stayed in a hotel suite nineteen floors up with a small balcony and a view of Manhattan.", "x0": 0.12087912087912088, "y0": 0.24786324786324787, "x1": 0.8769230769230769, "y1": 0.26107226107226106}, {"text": "That evening the boy\u2019s mama dressed up in a loose silk dress and a mink jacket, took her", "x0": 0.12087912087912088, "y0": 0.26573426573426573, "x1": 0.8791208791208791, "y1": 0.2789432789432789}, {"text": "husband\u2019s arm and they went out to dinner. The au pair ordered a pizza funghi and Coca-Colas", "x0": 0.12197802197802197, "y0": 0.2836052836052836, "x1": 0.878021978021978, "y1": 0.29681429681429683}, {"text": "from room-service, played snakes and ladders with the boy. He threw the dice, and they", "x0": 0.12197802197802197, "y0": 0.3006993006993007, "x1": 0.878021978021978, "y1": 0.3139083139083139}, {"text": "climbed and slithered up and down the board until bedtime. The au pair stayed up, took a hot", "x0": 0.12197802197802197, "y0": 0.3185703185703186, "x1": 0.878021978021978, "y1": 0.3317793317793318}, {"text": "shower and wrapped herself in the fluffy dressing gown with the hotel crest impressed upon", "x0": 0.12197802197802197, "y0": 0.33644133644133645, "x1": 0.878021978021978, "y1": 0.34965034965034963}, {"text": "the lapel. She opened the balcony door and from the arm-chair watched the skyline, the evening", "x0": 0.12197802197802197, "y0": 0.3543123543123543, "x1": 0.878021978021978, "y1": 0.36752136752136755}, {"text": "bleeding into darkness behind the tallest buildings; but she didn\u2019t dare go out and look down.", "x0": 0.12087912087912088, "y0": 0.3714063714063714, "x1": 0.8769230769230769, "y1": 0.38461538461538464}, {"text": "Instead she wrote letters home, saying she might not be back for Christmas after all, how she", "x0": 0.12197802197802197, "y0": 0.38927738927738925, "x1": 0.878021978021978, "y1": 0.4024864024864025}, {"text": "missed the ocean, but they were good to her; she wanted for nothing.", "x0": 0.12197802197802197, "y0": 0.40714840714840717, "x1": 0.6747252747252748, "y1": 0.42035742035742035}, {"text": "It was late when they got back. She\u2019d dozed off in the chair, but woke to hear them talking in", "x0": 0.12197802197802197, "y0": 0.43356643356643354, "x1": 0.878021978021978, "y1": 0.45998445998445997}, {"text": "the bedroom. Then the talking stopped and the man went out on to the balcony. Cigar smoke", "x0": 0.12197802197802197, "y0": 0.45998445998445997, "x1": 0.878021978021978, "y1": 0.4731934731934732}, {"text": "and freezing cold air drifted back into the room. He bolted the balcony doors and came back in", "x0": 0.12197802197802197, "y0": 0.47785547785547783, "x1": 0.878021978021978, "y1": 0.49106449106449107}, {"text": "and sat on the edge of the couch looking down at her. He smelled of beer and Polo aftershave", "x0": 0.12197802197802197, "y0": 0.4864024864024864, "x1": 0.878021978021978, "y1": 0.5128205128205128}, {"text": "and the au pair felt the cold off his good wool suit.", "x0": 0.12197802197802197, "y0": 0.5042735042735043, "x1": 0.5274725274725275, "y1": 0.5306915306915307}, {"text": "\u201cYou know what happens if we lose the baby, don\u2019t you?\u201d he said. \u2018We lose the baby, we lose", "x0": 0.12307692307692308, "y0": 0.5485625485625486, "x1": 0.878021978021978, "y1": 0.5617715617715617}, {"text": "the babysitter. You keep those balcony doors locked, sweetheart, or you'll be taking the first", "x0": 0.12197802197802197, "y0": 0.5656565656565656, "x1": 0.878021978021978, "y1": 0.5788655788655789}, {"text": "plane home.\u2019 He kissed her then, a strange, deliberate kiss, an airport kiss for someone you're", "x0": 0.12087912087912088, "y0": 0.5835275835275835, "x1": 0.878021978021978, "y1": 0.5967365967365967}, {"text": "glad to see the back of, then got up and went back in to his wife.", "x0": 0.12197802197802197, "y0": 0.6013986013986014, "x1": 0.6384615384615384, "y1": 0.6146076146076146}, {"text": "When she heard his snores, she rose and stepped out on to the balcony. A weak wind was", "x0": 0.12197802197802197, "y0": 0.6363636363636364, "x1": 0.878021978021978, "y1": 0.6495726495726496}, {"text": "driving large snowflakes across the air, sifting them into flurries. A December speckled night", "x0": 0.12197802197802197, "y0": 0.6542346542346542, "x1": 0.878021978021978, "y1": 0.6674436674436675}, {"text": "with the hooting of traffic, Soon it would be Christmas. She gripped the railings and looked", "x0": 0.12197802197802197, "y0": 0.6635586635586636, "x1": 0.878021978021978, "y1": 0.6899766899766899}, {"text": "down. A snarl of angry yellow taxis clotted the streets below. She imagined falling, imagined", "x0": 0.12197802197802197, "y0": 0.6899766899766899, "x1": 0.878021978021978, "y1": 0.7031857031857032}, {"text": "how that might feel, to dive down, be lost like that, mean everything for moments only, then", "x0": 0.12197802197802197, "y0": 0.7078477078477079, "x1": 0.878021978021978, "y1": 0.721056721056721}, {"text": "be gone. She backed inside and locked the doors.", "x0": 0.12087912087912088, "y0": 0.7249417249417249, "x1": 0.5153846153846153, "y1": 0.7381507381507382}, {"text": "CLAIRE KEEGAN", "x0": 0.7186813186813187, "y0": 0.8321678321678322, "x1": 0.8769230769230769, "y1": 0.8414918414918415}], [{"text": "Text 5 \u2014 Memoir extract", "x0": 0.12197802197802197, "y0": 0.08935508935508936, "x1": 0.32967032967032966, "y1": 0.09867909867909867}, {"text": "A Different Kind of Power", "x0": 0.11978021978021978, "y0": 0.1250971250971251, "x1": 0.34065934065934067, "y1": 0.13752913752913754}, {"text": "Arizona was hot, and beautiful, and expensive. While I\u2019d saved up enough money to survive", "x0": 0.12087912087912088, "y0": 0.1592851592851593, "x1": 0.878021978021978, "y1": 0.17249417249417248}, {"text": "there, I didn\u2019t exactly have enough to live independently. I lived in Mesa, about 12 kilometres", "x0": 0.12197802197802197, "y0": 0.1686091686091686, "x1": 0.878021978021978, "y1": 0.19502719502719504}, {"text": "from campus. Everything was flat, low-rise, with the exception of Camelback Mountain", "x0": 0.12197802197802197, "y0": 0.19502719502719504, "x1": 0.878021978021978, "y1": 0.20823620823620823}, {"text": "glowing red far off in the distance. The desert landscape was so different from anything I was", "x0": 0.12197802197802197, "y0": 0.21212121212121213, "x1": 0.878021978021978, "y1": 0.22533022533022534}, {"text": "used to. Most front yards were covered in stone and dotted with succulents: massive yucca", "x0": 0.12197802197802197, "y0": 0.22999222999222999, "x1": 0.878021978021978, "y1": 0.2432012432012432}, {"text": "spikes and cacti standing taller than me. Backyards were surrounded by tall fences, though I", "x0": 0.12197802197802197, "y0": 0.24786324786324787, "x1": 0.878021978021978, "y1": 0.26107226107226106}, {"text": "couldn\u2019t quite imagine children playing outside. Not in that heat. In some places there were no", "x0": 0.12197802197802197, "y0": 0.26573426573426573, "x1": 0.878021978021978, "y1": 0.2789432789432789}, {"text": "sidewalks, but that made some sense. No one here walked. Even when I tried, people honked", "x0": 0.12197802197802197, "y0": 0.27505827505827507, "x1": 0.878021978021978, "y1": 0.3014763014763015}, {"text": "at me, as if warning me that it was a bad idea.", "x0": 0.12197802197802197, "y0": 0.3006993006993007, "x1": 0.4879120879120879, "y1": 0.3139083139083139}, {"text": "To get to campus, I took two buses. One day, early in the semester, I decided to walk home", "x0": 0.12197802197802197, "y0": 0.33644133644133645, "x1": 0.878021978021978, "y1": 0.34965034965034963}, {"text": "instead of waiting in the heat for my second bus. When I reached home a few miles later, I", "x0": 0.12197802197802197, "y0": 0.3543123543123543, "x1": 0.878021978021978, "y1": 0.36752136752136755}, {"text": "caught a glimpse of myself in the mirror. I looked like a char-grilled red capsicum with googly", "x0": 0.12197802197802197, "y0": 0.36363636363636365, "x1": 0.878021978021978, "y1": 0.3877233877233877}, {"text": "eyes attached. A few hours after that, the nausea, headache and dizziness of heat stroke kicked", "x0": 0.12197802197802197, "y0": 0.3861693861693862, "x1": 0.878021978021978, "y1": 0.4063714063714064}, {"text": "in. I never walked to or from that bus stop again.", "x0": 0.12197802197802197, "y0": 0.40714840714840717, "x1": 0.512087912087912, "y1": 0.42035742035742035}, {"text": "Classes at ASU (Arizona State University) felt different, too. My American foreign policy", "x0": 0.12197802197802197, "y0": 0.4421134421134421, "x1": 0.878021978021978, "y1": 0.4553224553224553}, {"text": "professor, for example, was a tall, assertive man, with a barrel chest and a booming voice. He", "x0": 0.12087912087912088, "y0": 0.45998445998445997, "x1": 0.878021978021978, "y1": 0.4731934731934732}, {"text": "declared that he used the \u2018Harvard method.\u2019 He was unforgiving about missed classes, and he", "x0": 0.12197802197802197, "y0": 0.47785547785547783, "x1": 0.878021978021978, "y1": 0.49106449106449107}, {"text": "liked to call on students at random, by pointing at them. Answer promptly, and correctly, or", "x0": 0.12197802197802197, "y0": 0.494949494949495, "x1": 0.8791208791208791, "y1": 0.5081585081585082}, {"text": "lose points. I was never sure if that was what he meant by the Harvard method; all I knew was", "x0": 0.12197802197802197, "y0": 0.5128205128205128, "x1": 0.878021978021978, "y1": 0.526029526029526}, {"text": "that I was afraid of it.", "x0": 0.12197802197802197, "y0": 0.5275835275835276, "x1": 0.2934065934065934, "y1": 0.5477855477855478}, {"text": "One day, as I sat on campus, eating a jam sandwich I had made that morning, the question came", "x0": 0.12197802197802197, "y0": 0.5656565656565656, "x1": 0.878021978021978, "y1": 0.5788655788655789}, {"text": "into my head: Why am I here? | knew why I'd come \u2014 for the excitement of being in a different", "x0": 0.12197802197802197, "y0": 0.5757575757575758, "x1": 0.878021978021978, "y1": 0.6006216006216006}, {"text": "place while still surrounded by an enormous community of church members. And I had got", "x0": 0.12087912087912088, "y0": 0.6013986013986014, "x1": 0.8791208791208791, "y1": 0.6146076146076146}, {"text": "both of these things. I was also making friends. These friends were welcoming, funny, generous", "x0": 0.12087912087912088, "y0": 0.6192696192696193, "x1": 0.878021978021978, "y1": 0.6324786324786325}, {"text": "and kind. But for all that, I was lonely.", "x0": 0.12197802197802197, "y0": 0.6363636363636364, "x1": 0.4307692307692308, "y1": 0.6495726495726496}, {"text": "This loneliness was deeper than homesickness. It was about far more than the distance between", "x0": 0.12197802197802197, "y0": 0.6721056721056721, "x1": 0.878021978021978, "y1": 0.6853146853146853}, {"text": "Arizona and New Zealand, about the change in landscape, or the fact that long-distance phone", "x0": 0.12087912087912088, "y0": 0.6899766899766899, "x1": 0.878021978021978, "y1": 0.7031857031857032}, {"text": "calls were too expensive to allow me to talk to Mum or Dad often. It was something more", "x0": 0.12197802197802197, "y0": 0.7078477078477079, "x1": 0.878021978021978, "y1": 0.721056721056721}, {"text": "fundamental. I'd always believed that there was a reason and purpose to every experience. But", "x0": 0.12197802197802197, "y0": 0.7249417249417249, "x1": 0.878021978021978, "y1": 0.7381507381507382}, {"text": "as I finished my sandwich and packed up in the blazing red sun to move to my next class, I", "x0": 0.12197802197802197, "y0": 0.7428127428127428, "x1": 0.878021978021978, "y1": 0.756021756021756}, {"text": "could not figure out the purpose of this one.", "x0": 0.12197802197802197, "y0": 0.752913752913753, "x1": 0.4725274725274725, "y1": 0.777000777000777}, {"text": "JACINDA ARDERN", "x0": 0.701098901098901, "y0": 0.8142968142968143, "x1": 0.8725274725274725, "y1": 0.8236208236208237}, {"text": "End of texts for Section I", "x0": 0.3934065934065934, "y0": 0.885003885003885, "x1": 0.6054945054945055, "y1": 0.8943278943278943}]]