[[{"text": "STUDENT NUMBER", "x0": 0.6048298572996706, "y0": 0.1592851592851593, "x1": 0.8166849615806806, "y1": 0.17094017094017094}, {"text": "ABBOTSLEIGH", "x0": 0.1207464324917673, "y0": 0.27972027972027974, "x1": 0.29198682766191, "y1": 0.2913752913752914}, {"text": "2022 HSC TRIAL EXAMINATION", "x0": 0.12184412733260154, "y0": 0.3411033411033411, "x1": 0.531284302963776, "y1": 0.3543123543123543}, {"text": "English Extension 1", "x0": 0.12184412733260154, "y0": 0.37684537684537683, "x1": 0.48518111964873767, "y1": 0.4048174048174048}, {"text": "Section I and Section II", "x0": 0.12294182217343579, "y0": 0.452991452991453, "x1": 0.4544456641053787, "y1": 0.4700854700854701}, {"text": "General Instructions", "x0": 0.12184412733260154, "y0": 0.5205905205905206, "x1": 0.29857299670691545, "y1": 0.5299145299145299}, {"text": "Reading time \u2014 10 minutes", "x0": 0.18221734357848518, "y0": 0.5470085470085471, "x1": 0.3973655323819978, "y1": 0.5602175602175602}, {"text": ".", "x0": 0.1525795828759605, "y0": 0.5501165501165501, "x1": 0.16136114160263446, "y1": 0.5563325563325563}, {"text": "Working time \u2014 2 hours", "x0": 0.18221734357848518, "y0": 0.5648795648795649, "x1": 0.37102085620197583, "y1": 0.578088578088578}, {"text": ".", "x0": 0.1525795828759605, "y0": 0.567987567987568, "x1": 0.16136114160263446, "y1": 0.5742035742035742}, {"text": "Write using black pen", "x0": 0.18221734357848518, "y0": 0.581973581973582, "x1": 0.3567508232711306, "y1": 0.5951825951825952}, {"text": ".", "x0": 0.1525795828759605, "y0": 0.585081585081585, "x1": 0.16136114160263446, "y1": 0.5912975912975913}, {"text": "Write your student number as indicated", "x0": 0.18221734357848518, "y0": 0.5998445998445998, "x1": 0.4972557628979144, "y1": 0.6130536130536131}, {"text": ".", "x0": 0.1525795828759605, "y0": 0.602952602952603, "x1": 0.16136114160263446, "y1": 0.6091686091686092}, {"text": "Total marks: 50", "x0": 0.12184412733260154, "y0": 0.655011655011655, "x1": 0.2557628979143798, "y1": 0.6643356643356644}, {"text": "Section I: Literary Worlds (25 marks)", "x0": 0.12184412733260154, "y0": 0.6822066822066822, "x1": 0.4456641053787047, "y1": 0.6946386946386947}, {"text": "Attempt Question |", "x0": 0.12184412733260154, "y0": 0.7086247086247086, "x1": 0.27661909989023054, "y1": 0.7218337218337219}, {"text": "Allow about | hour for this section", "x0": 0.12184412733260154, "y0": 0.7358197358197358, "x1": 0.40175631174533477, "y1": 0.745920745920746}, {"text": "Section II: Electives (25 marks)", "x0": 0.12184412733260154, "y0": 0.790986790986791, "x1": 0.3896816684961581, "y1": 0.8026418026418026}, {"text": "Attempt one question from Questions 2(a) \u2014 2(e)", "x0": 0.12184412733260154, "y0": 0.8174048174048174, "x1": 0.5126234906695939, "y1": 0.8306138306138307}, {"text": "Allow about | hour for this section", "x0": 0.12184412733260154, "y0": 0.8445998445998446, "x1": 0.40175631174533477, "y1": 0.8547008547008547}], [{"text": "Section I \u2014 Common Module: Literary Worlds", "x0": 0.12184412733260154, "y0": 0.08935508935508936, "x1": 0.562019758507135, "y1": 0.10334110334110334}, {"text": "25 marks", "x0": 0.12184412733260154, "y0": 0.11499611499611499, "x1": 0.20636663007683864, "y1": 0.1250971250971251}, {"text": "Attempt Question 1", "x0": 0.1207464324917673, "y0": 0.13364413364413363, "x1": 0.300768386388584, "y1": 0.14763014763014762}, {"text": "Allow about 1 hour for this section", "x0": 0.1207464324917673, "y0": 0.15306915306915306, "x1": 0.442371020856202, "y1": 0.16394716394716394}, {"text": "Your answers will be assessed on how well you:", "x0": 0.12184412733260154, "y0": 0.18181818181818182, "x1": 0.5389681668496158, "y1": 0.1958041958041958}, {"text": "demonstrate an understanding of the ideas and values of Literary Worlds and", "x0": 0.15697036223929747, "y0": 0.20046620046620048, "x1": 0.8243688254665203, "y1": 0.22144522144522144}, {"text": "how they are shaped and reflected in texts", "x0": 0.15697036223929747, "y0": 0.22144522144522144, "x1": 0.5214050493962679, "y1": 0.23543123543123542}, {"text": "craft a sustained composition appropriate to the question, demonstrating", "x0": 0.15697036223929747, "y0": 0.2432012432012432, "x1": 0.7837541163556532, "y1": 0.2571872571872572}, {"text": "control of the use of language", "x0": 0.15697036223929747, "y0": 0.26107226107226106, "x1": 0.42041712403951703, "y1": 0.27505827505827507}, {"text": "Read Text 1, Text 2, Text 3, and Text 4.", "x0": 0.12184412733260154, "y0": 0.3061383061383061, "x1": 0.4632272228320527, "y1": 0.31934731934731936}, {"text": "Question 1 (25 marks)", "x0": 0.12184412733260154, "y0": 0.3348873348873349, "x1": 0.3205268935236004, "y1": 0.34887334887334887}, {"text": "(a) Use Text 1, or Text 2, or both to answer this part. 15", "x0": 0.1602634467618002, "y0": 0.3923853923853924, "x1": 0.8507135016465422, "y1": 0.4063714063714064}, {"text": "How does Yan Ge invite the reader to explore new horizons and arrive", "x0": 0.19099890230515917, "y0": 0.43045843045843046, "x1": 0.8035126234906695, "y1": 0.4444444444444444}, {"text": "at new insights by inviting them into a world different to their own?", "x0": 0.19099890230515917, "y0": 0.44988344988344986, "x1": 0.7804610318331504, "y1": 0.46386946386946387}, {"text": "(b) Use Text 3 and Text 4 to answer this part.", "x0": 0.1602634467618002, "y0": 0.4988344988344988, "x1": 0.5510428100987925, "y1": 0.5128205128205128}, {"text": "10", "x0": 0.8320526893523601, "y0": 0.5167055167055167, "x1": 0.8518111964873765, "y1": 0.5268065268065268}, {"text": "Discuss how the critical extracts invite readers to consider the diverse", "x0": 0.19099890230515917, "y0": 0.5369075369075369, "x1": 0.7969264544456641, "y1": 0.5477855477855478}, {"text": "reasons why literature is valuable.", "x0": 0.19099890230515917, "y0": 0.5555555555555556, "x1": 0.48518111964873767, "y1": 0.5695415695415695}, {"text": "In your response, demonstrate an understanding of Literary Worlds.", "x0": 0.19099890230515917, "y0": 0.5944055944055944, "x1": 0.7782656421514819, "y1": 0.6083916083916084}, {"text": "Question 1 continues on the next page", "x0": 0.3238199780461032, "y0": 0.7171717171717171, "x1": 0.6739846322722283, "y1": 0.7311577311577312}], [{"text": "Text 1 \u2014 Novel Extract: Strange Beasts of China, by Yan Ge", "x0": 0.12184412733260154, "y0": 0.08935508935508936, "x1": 0.6542261251372119, "y1": 0.10334110334110334}, {"text": "# [shou] - beast", "x0": 0.3699231613611416, "y0": 0.19658119658119658, "x1": 0.6311745334796927, "y1": 0.2191142191142191}, {"text": "Originally used to describe the act of hunting, the", "x0": 0.2623490669593853, "y0": 0.27972027972027974, "x1": 0.7299670691547749, "y1": 0.2913752913752914}, {"text": "meaning of the word shifted over time to the object", "x0": 0.2557628979143798, "y0": 0.29448329448329447, "x1": 0.7376509330406147, "y1": 0.3061383061383061}, {"text": "of the hunt, the prey. More than a neutral word for", "x0": 0.25905598243688255, "y0": 0.3084693084693085, "x1": 0.7332601536772777, "y1": 0.3201243201243201}, {"text": "animal, # denotes the absence of humanity, and", "x0": 0.2678375411635565, "y0": 0.32167832167832167, "x1": 0.7233809001097695, "y1": 0.3333333333333333}, {"text": "carries the connotations of savagery and wildness.", "x0": 0.2579582875960483, "y0": 0.3372183372183372, "x1": 0.7332601536772777, "y1": 0.34887334887334887}, {"text": "SORROWFUL BEASTS", "x0": 0.38419319429198684, "y0": 0.40792540792540793, "x1": 0.6136114160263447, "y1": 0.4188034188034188}, {"text": "As the Splendid River flows through Yong\u2019an City\u2019s centre and heads east, it", "x0": 0.15587266739846323, "y0": 0.4522144522144522, "x1": 0.8254665203073546, "y1": 0.4662004662004662}, {"text": "separates into the Lotus and Peacock Rivers in Luoding District. The sorrowful", "x0": 0.13062568605927552, "y0": 0.47474747474747475, "x1": 0.8199780461031834, "y1": 0.4887334887334887}, {"text": "beasts live in a housing development on the Peacock\u2019s southern bank, in the", "x0": 0.12952799121844127, "y0": 0.4965034965034965, "x1": 0.7903402854006586, "y1": 0.5104895104895105}, {"text": "north-eastern quarter of the city. These old buildings, their walls thick with ivy, are", "x0": 0.13062568605927552, "y0": 0.5112665112665112, "x1": 0.8507135016465422, "y1": 0.5361305361305362}, {"text": "known as the Leye Estate. They were originally built as dormitories for the Ping Le", "x0": 0.13062568605927552, "y0": 0.5407925407925408, "x1": 0.8572996706915478, "y1": 0.5547785547785548}, {"text": "Cotton Mill, where many of the sorrowful beasts have worked for years, ever since", "x0": 0.13062568605927552, "y0": 0.5602175602175602, "x1": 0.8518111964873765, "y1": 0.5811965811965812}, {"text": "they first came to Yong\u2019an City from the south and settled here. Sorrowful beasts", "x0": 0.12952799121844127, "y0": 0.585081585081585, "x1": 0.8364434687156971, "y1": 0.5990675990675991}, {"text": "are gentle by nature, and prefer the cold and dark. They love cauliflower and mung", "x0": 0.13062568605927552, "y0": 0.6076146076146076, "x1": 0.8529088913282108, "y1": 0.6216006216006216}, {"text": "beans, vanilla ice cream and tangerine pudding. They fear trains, bitter gourd and", "x0": 0.12952799121844127, "y0": 0.6293706293706294, "x1": 0.8375411635565313, "y1": 0.6433566433566433}, {"text": "satellite TV.", "x0": 0.13062568605927552, "y0": 0.6519036519036518, "x1": 0.2327113062568606, "y1": 0.6627816627816627}, {"text": "The males of the species are tall, with large mouths and small hands, scales on", "x0": 0.15697036223929747, "y0": 0.6705516705516705, "x1": 0.8386388583973655, "y1": 0.6915306915306916}, {"text": "the insides of their left calves and fins attached to their right ears. The skin around", "x0": 0.12952799121844127, "y0": 0.6930846930846931, "x1": 0.845225027442371, "y1": 0.714063714063714}, {"text": "their belly buttons is dark green. Other than that, they\u2019re just like regular people.", "x0": 0.12952799121844127, "y0": 0.7187257187257188, "x1": 0.8298572996706916, "y1": 0.7327117327117327}, {"text": "The females are beautiful \u2014 slender figures with reddish skin, long, narrow eyes,", "x0": 0.13062568605927552, "y0": 0.7404817404817405, "x1": 0.8287596048298573, "y1": 0.7544677544677545}, {"text": "ears a little larger than normal. For three days at the full moon, they lose the ability", "x0": 0.13062568605927552, "y0": 0.7599067599067599, "x1": 0.8529088913282108, "y1": 0.7801087801087802}, {"text": "of human speech and squawk like birds instead.", "x0": 0.13062568605927552, "y0": 0.7847707847707848, "x1": 0.544456641053787, "y1": 0.7987567987567987}, {"text": "Otherwise, they\u2019re just like regular people.", "x0": 0.15697036223929747, "y0": 0.8073038073038074, "x1": 0.5279912184412733, "y1": 0.8212898212898213}], [{"text": "Text 2 \u2014 Novel Extract: Strange Beasts of China, by Yan Ge", "x0": 0.12184412733260154, "y0": 0.08935508935508936, "x1": 0.6542261251372119, "y1": 0.10334110334110334}, {"text": "FLOURISHING BEASTS", "x0": 0.3787047200878156, "y0": 0.1561771561771562, "x1": 0.6201975850713501, "y1": 0.16705516705516704}, {"text": "All flourishing beasts are female. They reside in herds and are placid by nature.", "x0": 0.12952799121844127, "y0": 0.20046620046620048, "x1": 0.8210757409440176, "y1": 0.21445221445221446}, {"text": "They have made their living as gardeners since ancient times, and are particularly", "x0": 0.13062568605927552, "y0": 0.222999222999223, "x1": 0.8408342480790341, "y1": 0.236985236985237}, {"text": "skilled at raising rare species. A corruption of the word \u2018flower\u2019 gives rise to their", "x0": 0.13062568605927552, "y0": 0.23776223776223776, "x1": 0.8441273326015367, "y1": 0.26262626262626265}, {"text": "name, \u2018flourishing\u2019.", "x0": 0.13062568605927552, "y0": 0.26728826728826727, "x1": 0.3018660812294182, "y1": 0.2812742812742813}, {"text": "The flourishing beasts live in the south-eastern corner of Yong\u2019an City, in the", "x0": 0.19099890230515917, "y0": 0.2898212898212898, "x1": 0.862788144895719, "y1": 0.3038073038073038}, {"text": "Temple of the Antiquities. There, they grow all manner of plants in the back", "x0": 0.13062568605927552, "y0": 0.31157731157731156, "x1": 0.7925356750823271, "y1": 0.32556332556332557}, {"text": "courtyard, filling it with fragrance all year round.", "x0": 0.13062568605927552, "y0": 0.3341103341103341, "x1": 0.557628979143798, "y1": 0.3480963480963481}, {"text": "The flourishing beasts have delicate features that are etched perpetually with", "x0": 0.19099890230515917, "y0": 0.35586635586635584, "x1": 0.8572996706915478, "y1": 0.36985236985236986}, {"text": "worry. They seldom speak. Their pale skin is marked with pale blue crescent moons,", "x0": 0.12952799121844127, "y0": 0.37839937839937837, "x1": 0.8649835345773875, "y1": 0.3923853923853924}, {"text": "and they have six fingers on each hand, but otherwise they are no different from any", "x0": 0.13062568605927552, "y0": 0.40015540015540013, "x1": 0.8638858397365532, "y1": 0.41414141414141414}, {"text": "human woman. Their markings grow more vivid with age, turning first dark blue,", "x0": 0.13062568605927552, "y0": 0.4226884226884227, "x1": 0.8397365532381997, "y1": 0.4366744366744367}, {"text": "then black. After this comes death. When a flourishing beast\u2019s life ends, her tribe", "x0": 0.12952799121844127, "y0": 0.44133644133644134, "x1": 0.8342480790340285, "y1": 0.46231546231546233}, {"text": "cuts her into eight pieces, which are planted into the ground, and then watered with", "x0": 0.13062568605927552, "y0": 0.466977466977467, "x1": 0.854006586169045, "y1": 0.48096348096348096}, {"text": "yellow rice wine. A month later, a flourishing stem appears, flawlessly white, firm", "x0": 0.12952799121844127, "y0": 0.48951048951048953, "x1": 0.8474204171240395, "y1": 0.5034965034965035}, {"text": "and lustrous as jade. After another month, this stem sprouts four limbs; then, another", "x0": 0.13062568605927552, "y0": 0.5112665112665112, "x1": 0.8682766190998902, "y1": 0.5252525252525253}, {"text": "month later, a face. Now beast-shaped, the wood continues to soften. One more", "x0": 0.13062568605927552, "y0": 0.5337995337995338, "x1": 0.8199780461031834, "y1": 0.5477855477855478}, {"text": "month, and the stem snaps off: a new flourishing beast is born", "x0": 0.13062568605927552, "y0": 0.5555555555555556, "x1": 0.6695938529088913, "y1": 0.5695415695415695}, {"text": "It is hard for flourishing beasts to reproduce. Of every eight pieces that are", "x0": 0.19099890230515917, "y0": 0.578088578088578, "x1": 0.8386388583973655, "y1": 0.5920745920745921}, {"text": "planted, only one or two survive. Conditions need to be exactly right, and the", "x0": 0.13062568605927552, "y0": 0.5998445998445998, "x1": 0.8024149286498353, "y1": 0.6138306138306139}, {"text": "saplings are particularly vulnerable during the early stage, when human merchants", "x0": 0.13062568605927552, "y0": 0.6223776223776224, "x1": 0.8474204171240395, "y1": 0.6363636363636364}, {"text": "are wont to chop them down for their high-quality wood, to be manufactured into", "x0": 0.13062568605927552, "y0": 0.6441336441336442, "x1": 0.8386388583973655, "y1": 0.6581196581196581}, {"text": "small, exquisite household objects and sold at astronomical prices.", "x0": 0.13062568605927552, "y0": 0.6666666666666666, "x1": 0.70801317233809, "y1": 0.6806526806526807}, {"text": "Decades ago, there was an episode of unrest in Yong\u2019an City that ended", "x0": 0.19099890230515917, "y0": 0.6884226884226884, "x1": 0.814489571899012, "y1": 0.7024087024087025}, {"text": "unpleasantly. After the government had restored order, strict new laws were", "x0": 0.13062568605927552, "y0": 0.710955710955711, "x1": 0.7881448957189902, "y1": 0.7249417249417249}, {"text": "introduced to prohibit this practice. But the profits were just too enticing, and", "x0": 0.13062568605927552, "y0": 0.7334887334887334, "x1": 0.8035126234906695, "y1": 0.7474747474747475}, {"text": "flourishing wood continued to be chopped down.", "x0": 0.13062568605927552, "y0": 0.7552447552447552, "x1": 0.5565312843029637, "y1": 0.7692307692307693}], [{"text": "Text 3 \u2014 Critical Extract: \u2018Of Monsters, Men and Migration\u2019, by Ksenia Shcherbino.", "x0": 0.12184412733260154, "y0": 0.08935508935508936, "x1": 0.8704720087815587, "y1": 0.10334110334110334}, {"text": "Read through the lens of colonialism, Yan Ge\u2019s Strange Beasts of China explores", "x0": 0.13062568605927552, "y0": 0.12742812742812742, "x1": 0.8364434687156971, "y1": 0.15462315462315462}, {"text": "questions of migration, acceptance, domination and hybridity in the body of a", "x0": 0.13062568605927552, "y0": 0.14996114996114995, "x1": 0.8090010976948409, "y1": 0.17715617715617715}, {"text": "chimera, a creature of fantasy. The book keeps asking the readers to re-evaluate", "x0": 0.13062568605927552, "y0": 0.18026418026418026, "x1": 0.8221734357848518, "y1": 0.19425019425019424}, {"text": "the ideas of power and possession, speech and silence. Who colonised who, are", "x0": 0.12952799121844127, "y0": 0.20279720279720279, "x1": 0.8210757409440176, "y1": 0.21678321678321677}, {"text": "humans nothing but the former beasts who have conquered the land and", "x0": 0.13062568605927552, "y0": 0.22533022533022534, "x1": 0.7552140504939627, "y1": 0.23931623931623933}, {"text": "re-written its history? Who has the right of speech? Is silence a way of telling a", "x0": 0.13062568605927552, "y0": 0.23853923853923853, "x1": 0.818880351262349, "y1": 0.26573426573426573}, {"text": "story by the marginalised (beasts)?", "x0": 0.13062568605927552, "y0": 0.26961926961926963, "x1": 0.43249176728869376, "y1": 0.2836052836052836}, {"text": "Yan Ge\u2019s Yong\u2019an is a postcolonial space where the story of subjugation of the", "x0": 0.13062568605927552, "y0": 0.3139083139083139, "x1": 0.814489571899012, "y1": 0.3278943278943279}, {"text": "beasts, or the struggle for de/re-territorialisation is already part of history, and the", "x0": 0.12952799121844127, "y0": 0.3356643356643357, "x1": 0.8375411635565313, "y1": 0.34965034965034963}, {"text": "question that haunts both humans and beasts is the same that haunts in our day and", "x0": 0.13062568605927552, "y0": 0.3581973581973582, "x1": 0.849615806805708, "y1": 0.37218337218337216}, {"text": "time: how the interdependence of colonisers and the colonised has shaped \u2014 and", "x0": 0.12952799121844127, "y0": 0.37684537684537683, "x1": 0.8265642151481888, "y1": 0.3978243978243978}, {"text": "continues shaping \u2014 our understanding of the world.", "x0": 0.13062568605927552, "y0": 0.3947163947163947, "x1": 0.5817782656421515, "y1": 0.4195804195804196}, {"text": "Text 4 \u2014 Critical Extract: \u2018Otherworldly Encounters\u2019, by Mandana Chaffa.", "x0": 0.12184412733260154, "y0": 0.4654234654234654, "x1": 0.7815587266739846, "y1": 0.4794094794094794}, {"text": "With Yan Ge\u2019s poetic prose and limitless imagination, this would have been a", "x0": 0.13062568605927552, "y0": 0.5066045066045066, "x1": 0.8046103183315039, "y1": 0.5205905205905206}, {"text": "satisfying novel even if it were solely a series of exquisite tales and allegories, but", "x0": 0.13062568605927552, "y0": 0.5205905205905206, "x1": 0.845225027442371, "y1": 0.5454545454545454}, {"text": "her scope and talent arrow far beyond such boundaries. Herein are mysteries,", "x0": 0.13062568605927552, "y0": 0.5508935508935509, "x1": 0.8002195389681669, "y1": 0.5648795648795649}, {"text": "histories, love affairs, heartbreak, villains, and saviors. Often what appears to be a", "x0": 0.13062568605927552, "y0": 0.5726495726495726, "x1": 0.8430296377607025, "y1": 0.5866355866355867}, {"text": "surety, with a twist of shadow or light, turns new and startling, causing readers to", "x0": 0.13062568605927552, "y0": 0.5951825951825952, "x1": 0.8364434687156971, "y1": 0.6091686091686092}, {"text": "rethink the story\u2014as well as their own stories\u2014entirely. In this world, our world,", "x0": 0.13062568605927552, "y0": 0.616938616938617, "x1": 0.8397365532381997, "y1": 0.6309246309246309}, {"text": "humans are the strangest beasts of all.", "x0": 0.13062568605927552, "y0": 0.6363636363636364, "x1": 0.45773874862788144, "y1": 0.6565656565656566}, {"text": "Near the end of the book, the narrator writes: \u201call we have are stories.\u201d But only an", "x0": 0.13062568605927552, "y0": 0.6806526806526807, "x1": 0.8529088913282108, "y1": 0.7008547008547008}, {"text": "author of great skill, style, and soul creates stories as remarkable as these. I question", "x0": 0.13062568605927552, "y0": 0.7062937062937062, "x1": 0.862788144895719, "y1": 0.7202797202797203}, {"text": "our world, my life: what is illusory? What is real? And how would I ever know,", "x0": 0.13062568605927552, "y0": 0.728049728049728, "x1": 0.818880351262349, "y1": 0.7420357420357421}, {"text": "given how easily we can be fooled into believing the safest narrative, even if i", "x0": 0.13062568605927552, "y0": 0.7474747474747475, "x1": 0.8079034028540066, "y1": 0.7684537684537684}, {"text": "not the most accurate?", "x0": 0.13062568605927552, "y0": 0.7723387723387724, "x1": 0.3238199780461032, "y1": 0.7832167832167832}, {"text": "It\u2019s a more beautiful world because of these remarkable, unforgettable stories. That", "x0": 0.13062568605927552, "y0": 0.8166278166278166, "x1": 0.8529088913282108, "y1": 0.8306138306138307}, {"text": "I\u2019m sure of. That I know.", "x0": 0.13062568605927552, "y0": 0.8391608391608392, "x1": 0.3468715697036224, "y1": 0.85003885003885}], [{"text": "End of Section I", "x0": 0.4313940724478595, "y0": 0.08935508935508936, "x1": 0.5675082327113062, "y1": 0.09867909867909867}, {"text": "SECTION II: Electives", "x0": 0.12184412733260154, "y0": 0.13597513597513597, "x1": 0.3358946212952799, "y1": 0.14685314685314685}, {"text": "25 marks", "x0": 0.12184412733260154, "y0": 0.1623931623931624, "x1": 0.20636663007683864, "y1": 0.17249417249417248}, {"text": "Attempt ONE question from Question 2(a) \u2014 2(e)", "x0": 0.1207464324917673, "y0": 0.18104118104118105, "x1": 0.5729967069154775, "y1": 0.19502719502719504}, {"text": "Allow about 1 hour for this section", "x0": 0.1207464324917673, "y0": 0.20046620046620048, "x1": 0.442371020856202, "y1": 0.21134421134421136}, {"text": "Read the question carefully and then answer the question on the lined writing paper", "x0": 0.12184412733260154, "y0": 0.23776223776223776, "x1": 0.8485181119648738, "y1": 0.2517482517482518}, {"text": "provided.", "x0": 0.12184412733260154, "y0": 0.2556332556332556, "x1": 0.20197585071350166, "y1": 0.26961926961926963}, {"text": "Your answers will be assessed on how well you:", "x0": 0.12184412733260154, "y0": 0.2836052836052836, "x1": 0.5389681668496158, "y1": 0.2975912975912976}, {"text": "demonstrate an understanding of the ideas and values of your elective and how", "x0": 0.15697036223929747, "y0": 0.30225330225330227, "x1": 0.8430296377607025, "y1": 0.32323232323232326}, {"text": "they are shaped and reflected in texts", "x0": 0.15587266739846323, "y0": 0.32323232323232326, "x1": 0.47859495060373214, "y1": 0.3372183372183372}, {"text": "craft a sustained composition appropriate to the question, demonstrating", "x0": 0.15697036223929747, "y0": 0.3442113442113442, "x1": 0.7837541163556532, "y1": 0.3581973581973582}, {"text": "control of the use of language", "x0": 0.15697036223929747, "y0": 0.35975135975135974, "x1": 0.4149286498353458, "y1": 0.37995337995337997}, {"text": "Question 2(a) \u2014 Elective 1: Literary Homelands (25 marks)", "x0": 0.12184412733260154, "y0": 0.40792540792540793, "x1": 0.677277716794731, "y1": 0.4219114219114219}, {"text": "How has your study of Literary Homelands provided insight into the tension between", "x0": 0.12184412733260154, "y0": 0.4366744366744367, "x1": 0.8649835345773875, "y1": 0.4506604506604507}, {"text": "home and the unknown?", "x0": 0.12184412733260154, "y0": 0.4560994560994561, "x1": 0.3336992316136114, "y1": 0.466977466977467}, {"text": "In your response, refer to TWO of your prescribed texts and ONE related text of your", "x0": 0.12184412733260154, "y0": 0.48174048174048173, "x1": 0.8660812294182217, "y1": 0.5019425019425019}, {"text": "own choosing.", "x0": 0.12184412733260154, "y0": 0.5034965034965035, "x1": 0.24588364434687157, "y1": 0.5174825174825175}, {"text": "The prescribed texts are:", "x0": 0.12184412733260154, "y0": 0.5322455322455323, "x1": 0.3336992316136114, "y1": 0.5462315462315462}, {"text": "+ Prose \u2014 Aravind Adiga, The White Tiger", "x0": 0.17014270032930845, "y0": 0.560994560994561, "x1": 0.6608122941822173, "y1": 0.574980574980575}, {"text": "\u2014 EM Forster, A Passage to India", "x0": 0.3567508232711306, "y0": 0.5897435897435898, "x1": 0.6608122941822173, "y1": 0.6037296037296037}, {"text": "\u2014 Colm Toibin, Brooklyn", "x0": 0.3567508232711306, "y0": 0.6184926184926185, "x1": 0.5817782656421515, "y1": 0.6317016317016317}, {"text": "+ Poetry \u2014 Eileen Chong, Burning Rice", "x0": 0.17014270032930845, "y0": 0.6472416472416472, "x1": 0.6245883644346871, "y1": 0.6612276612276612}, {"text": "Re RR RRR", "x0": 0.42590559824368823, "y0": 0.6752136752136753, "x1": 0.433589462129528, "y1": 0.7964257964257965}, {"text": "Burning Rice", "x0": 0.446761800219539, "y0": 0.675990675990676, "x1": 0.562019758507135, "y1": 0.6891996891996892}, {"text": "Mid-autumn Mooncakes", "x0": 0.446761800219539, "y0": 0.6946386946386947, "x1": 0.6586169045005489, "y1": 0.7055167055167055}, {"text": "My Hakka Grandmother", "x0": 0.446761800219539, "y0": 0.714063714063714, "x1": 0.6608122941822173, "y1": 0.728049728049728}, {"text": "Shophouse, Victoria Street", "x0": 0.446761800219539, "y0": 0.7327117327117327, "x1": 0.677277716794731, "y1": 0.7466977466977467}, {"text": "Chinese Ginseng", "x0": 0.4478594950603732, "y0": 0.7521367521367521, "x1": 0.5949506037321625, "y1": 0.7661227661227661}, {"text": "Winter Meeting", "x0": 0.4489571899012075, "y0": 0.7723387723387724, "x1": 0.5817782656421515, "y1": 0.7855477855477856}, {"text": "Singapore", "x0": 0.446761800219539, "y0": 0.7902097902097902, "x1": 0.5345773874862788, "y1": 0.8041958041958042}, {"text": "+ Drama \u2014 Andrew Bovell, The Secret River", "x0": 0.18331503841931943, "y0": 0.8383838383838383, "x1": 0.6684961580680571, "y1": 0.8515928515928516}, {"text": "Film \u2014 Sarah Gavron, Brick Lane", "x0": 0.21185510428100987, "y0": 0.8772338772338772, "x1": 0.605927552140505, "y1": 0.8904428904428905}], [{"text": "Question 2(b) \u2014 Elective 2: Worlds of Upheaval (25 marks)", "x0": 0.12184412733260154, "y0": 0.08935508935508936, "x1": 0.6739846322722283, "y1": 0.10334110334110334}, {"text": "How has your study Worlds of Upheaval provided insight into the tension between", "x0": 0.12184412733260154, "y0": 0.11732711732711733, "x1": 0.8408342480790341, "y1": 0.13131313131313133}, {"text": "certainty and change?", "x0": 0.12184412733260154, "y0": 0.13675213675213677, "x1": 0.30954994511525796, "y1": 0.15073815073815075}, {"text": "In your response, refer to TWO of your prescribed texts and ONE related text of your", "x0": 0.12184412733260154, "y0": 0.1623931623931624, "x1": 0.8660812294182217, "y1": 0.1825951825951826}, {"text": "own choosing.", "x0": 0.12184412733260154, "y0": 0.18492618492618493, "x1": 0.24588364434687157, "y1": 0.1989121989121989}, {"text": "The prescribed texts are:", "x0": 0.12184412733260154, "y0": 0.2128982128982129, "x1": 0.3336992316136114, "y1": 0.22688422688422688}, {"text": "e Prose Fiction \u2014 Elizabeth Gaskell, North and South", "x0": 0.18331503841931943, "y0": 0.24164724164724163, "x1": 0.6904500548847421, "y1": 0.25485625485625485}, {"text": "\u2014 Mary Shelley, Frankenstein", "x0": 0.3567508232711306, "y0": 0.2703962703962704, "x1": 0.6223929747530187, "y1": 0.28438228438228436}, {"text": "\u2014 Madeleine Thien, Do Not Say