835164835165, "y1": 0.11965811965811966}, {"text": "QUESTION 9:", "x0": 0.12197802197802197, "y0": 0.1592851592851593, "x1": 0.24175824175824176, "y1": 0.1717171717171717}, {"text": "d) (i) The Domain was between -4 and 4, not just x <4. In most cases, to do the range you", "x0": 0.1813186813186813, "y0": 0.1888111888111888, "x1": 0.8032967032967033, "y1": 0.19968919968919968}, {"text": "really", "x0": 0.8087912087912088, "y0": 0.1888111888111888, "x1": 0.8461538461538461, "y1": 0.19968919968919968}, {"text": "have to know what the graph looks like, and the half-cirele gives y as between 0 and 4, not just", "x0": 0.12197802197802197, "y0": 0.20279720279720279, "x1": 0.7582417582417582, "y1": 0.21367521367521367}, {"text": "2 0.", "x0": 0.7846153846153846, "y0": 0.20357420357420358, "x1": 0.8098901098901099, "y1": 0.21212121212121213}, {"text": "QUESTION 10:", "x0": 0.12197802197802197, "y0": 0.23076923076923078, "x1": 0.2571428571428571, "y1": 0.2432012432012432}, {"text": "a) Make sure you use the correct notation when differentiating and for each step of working.", "x0": 0.15164835164835164, "y0": 0.24708624708624707, "x1": 0.7791208791208791, "y1": 0.257964257964258}, {"text": "Students", "x0": 0.789010989010989, "y0": 0.24708624708624707, "x1": 0.8461538461538461, "y1": 0.2556332556332556}, {"text": "need to be aware of setting out E.g. y = x? # 2x", "x0": 0.1824175824175824, "y0": 0.2595182595182595, "x1": 0.5241758241758242, "y1": 0.27195027195027194}, {"text": "For parts (iii) and (iv), those who did not change the original equations to a negative/fractional", "x0": 0.1824175824175824, "y0": 0.2742812742812743, "x1": 0.8153846153846154, "y1": 0.2851592851592852}, {"text": "index", "x0": 0.8208791208791208, "y0": 0.2742812742812743, "x1": 0.8571428571428571, "y1": 0.2828282828282828}, {"text": "first had less success differentiating,", "x0": 0.1824175824175824, "y0": 0.28826728826728826, "x1": 0.4208791208791209, "y1": 0.29914529914529914}, {"text": "\u00a9) (ii) Some students used the incorrect gradient. Needed to find the gradient perpendicular", "x0": 0.15164835164835164, "y0": 0.3014763014763015, "x1": 0.7857142857142857, "y1": 0.3123543123543124}, {"text": "to line AC", "x0": 0.7923076923076923, "y0": 0.3014763014763015, "x1": 0.8604395604395605, "y1": 0.31002331002331}, {"text": "Some found the perpendicular distance and lost 3 marks ~ Read the question!", "x0": 0.1824175824175824, "y0": 0.31546231546231546, "x1": 0.6989010989010989, "y1": 0.32634032634032634}, {"text": "QUESTION 1", "x0": 0.12197802197802197, "y0": 0.3457653457653458, "x1": 0.23956043956043957, "y1": 0.3581973581973582}, {"text": "\u00a9) Ifthe question asks you to copy the diagram, please do so. Then", "x0": 0.15164835164835164, "y0": 0.3620823620823621, "x1": 0.6120879120879121, "y1": 0.372960372960373}, {"text": "a. A formal proof requires you to start with \u201cIn ACDB and ......\u201d not just waffle on.", "x0": 0.21208791208791208, "y0": 0.3690753690753691, "x1": 0.7857142857142857, "y1": 0.38927738927738925}, {"text": "b. The only similarity proof involving sides is that two sides are in ratio, about a common", "x0": 0.21208791208791208, "y0": 0.3822843822843823, "x1": 0.8263736263736263, "y1": 0.40559440559440557}, {"text": "angle.", "x0": 0.8307692307692308, "y0": 0.38927738927738925, "x1": 0.8670329670329671, "y1": 0.40015540015540013}, {"text": "SAS is NOT a similarity proof. AA is NOT a reason for similarity. We would accept", "x0": 0.24285714285714285, "y0": 0.4024864024864025, "x1": 0.8142857142857143, "y1": 0.4133644133644134}, {"text": "AAA,", "x0": 0.8197802197802198, "y0": 0.40326340326340326, "x1": 0.8593406593406593, "y1": 0.41181041181041184}, {"text": "but better to say \u201cequiangular\u201d", "x0": 0.24285714285714285, "y0": 0.41647241647241645, "x1": 0.4472527472527473, "y1": 0.42735042735042733}, {"text": "you only need to prove 2 angles are the same (by angle sum, the third", "x0": 0.34285714285714286, "y0": 0.43045843045843046, "x1": 0.8076923076923077, "y1": 0.44133644133644134}, {"text": "HAS to", "x0": 0.8131868131868132, "y0": 0.43045843045843046, "x1": 0.8637362637362638, "y1": 0.439005439005439}, {"text": "be the same)", "x0": 0.24285714285714285, "y0": 0.44366744366744365, "x1": 0.3263736263736264, "y1": 0.45454545454545453}, {"text": "In this example, x had to be found before progressing.", "x0": 0.24285714285714285, "y0": 0.45765345765345766, "x1": 0.6010989010989011, "y1": 0.46853146853146854}, {"text": "e. Many people used ACDB and ACAB (ok), and then quoted angle ABD which is", "x0": 0.21208791208791208, "y0": 0.47086247086247085, "x1": 0.7791208791208791, "y1": 0.48174048174048173}, {"text": "in neither", "x0": 0.7846153846153846, "y0": 0.47086247086247085, "x1": 0.8461538461538461, "y1": 0.4794094794094794}, {"text": "triangle.", "x0": 0.24175824175824176, "y0": 0.48484848484848486, "x1": 0.2923076923076923, "y1": 0.49572649572649574}, {"text": "QUESTION 1", "x0": 0.12197802197802197, "y0": 0.5120435120435121, "x1": 0.23956043956043957, "y1": 0.5244755244755245}, {"text": "This question was generally well done by all candidates.", "x0": 0.12087912087912088, "y0": 0.5283605283605284, "x1": 0.4956043956043956, "y1": 0.5392385392385393}, {"text": "QUESTION 1.", "x0": 0.12197802197802197, "y0": 0.5563325563325563, "x1": 0.23956043956043957, "y1": 0.5687645687645687}, {"text": "a) You need to mention why \u00a9=60 is not an answer. The question is worth 3 marks!", "x0": 0.15164835164835164, "y0": 0.5718725718725719, "x1": 0.7274725274725274, "y1": 0.5827505827505828}, {"text": "b) ii) Find the point furthest from the origin (0,0) not the centre of the circle.", "x0": 0.15164835164835164, "y0": 0.5858585858585859, "x1": 0.6714285714285714, "y1": 0.5967365967365967}, {"text": "1", "x0": 0.7054945054945055, "y0": 0.5990675990675991, "x1": 0.7120879120879121, "y1": 0.6068376068376068}, {"text": "\u00a9) kis not the root! Since the roots are reciprocal to each other, start with oc and \u2014 then use", "x0": 0.15164835164835164, "y0": 0.6076146076146076, "x1": 0.7758241758241758, "y1": 0.6184926184926185}, {"text": "product of the", "x0": 0.7813186813186813, "y0": 0.6076146076146076, "x1": 0.8736263736263736, "y1": 0.6184926184926185}, {"text": "roots formula,", "x0": 0.1824175824175824, "y0": 0.627039627039627, "x1": 0.2714285714285714, "y1": 0.6355866355866356}, {"text": "QUESTION 14:", "x0": 0.12197802197802197, "y0": 0.6581196581196581, "x1": 0.2571428571428571, "y1": 0.6705516705516705}, {"text": "a) Students need to give a correct reason for geometry (e.g. the triangle was isosceles as the", "x0": 0.15164835164835164, "y0": 0.6736596736596736, "x1": 0.778021978021978, "y1": 0.6845376845376845}, {"text": "radii were", "x0": 0.7835164835164835, "y0": 0.6736596736596736, "x1": 0.8494505494505494, "y1": 0.6822066822066822}, {"text": "\u2018equal resulting in equal sides)", "x0": 0.1813186813186813, "y0": 0.6876456876456877, "x1": 0.3813186813186813, "y1": 0.6985236985236986}, {"text": "b) General form is ax + by +c = 0", "x0": 0.15164835164835164, "y0": 0.6938616938616938, "x1": 0.4065934065934066, "y1": 0.717948717948718}, {"text": "QUESTION 1", "x0": 0.12197802197802197, "y0": 0.7296037296037297, "x1": 0.23956043956043957, "y1": 0.7420357420357421}, {"text": "a) answer the given question \u2014 asked to find an expression not a limit, or a substitution of x=0", "x0": 0.15164835164835164, "y0": 0.7373737373737373, "x1": 0.7923076923076923, "y1": 0.7614607614607615}, {"text": "or x=h", "x0": 0.798901098901099, "y0": 0.7451437451437452, "x1": 0.8428571428571429, "y1": 0.7536907536907537}, {"text": "b) convoluted methods used, subject to silly mistakes", "x0": 0.15164835164835164, "y0": 0.7583527583527584, "x1": 0.5208791208791209, "y1": 0.7692307692307693}, {"text": "\u00a9) forgot the plus/minus sign when solving the equations", "x0": 0.15164835164835164, "y0": 0.7723387723387724, "x1": 0.5439560439560439, "y1": 0.7832167832167832}, {"text": "QUESTION 1", "x0": 0.12197802197802197, "y0": 0.8135198135198135, "x1": 0.23956043956043957, "y1": 0.8259518259518259}, {"text": "a) (ii) Use the quotient rule when you have a quotient! Do not use the product rule as this is", "x0": 0.15164835164835164, "y0": 0.8298368298368298, "x1": 0.7824175824175824, "y1": 0.8407148407148407}, {"text": "often messy", "x0": 0.7868131868131868, "y0": 0.8298368298368298, "x1": 0.8670329670329671, "y1": 0.8407148407148407}, {"text": "and does not give the simplest form.", "x0": 0.1813186813186813, "y0": 0.8430458430458431, "x1": 0.4208791208791209, "y1": 0.853923853923854}, {"text": "b) (i) \u201cExplain\u201d means \u201cset out with reasons\u201d", "x0": 0.15164835164835164, "y0": 0.857031857031857, "x1": 0.46703296703296704, "y1": 0.8679098679098679}, {"text": "(iii) Use AP = 21 (from (ii)). You do not need to use more accurate (exact) value for AP", "x0": 0.1824175824175824, "y0": 0.864024864024864, "x1": 0.7769230769230769, "y1": 0.8873348873348873}, {"text": "since it was", "x0": 0.7824175824175824, "y0": 0.8725718725718725, "x1": 0.8593406593406593, "y1": 0.8795648795648796}, {"text": "found in part (ii)", "x0": 0.1824175824175824, "y0": 0.8842268842268842, "x1": 0.2923076923076923, "y1": 0.8951048951048951}]]