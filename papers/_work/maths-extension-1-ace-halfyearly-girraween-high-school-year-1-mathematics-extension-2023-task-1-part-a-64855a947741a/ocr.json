[[{"text": "Girraween High School", "x0": 0.265642151481888, "y0": 0.27972027972027974, "x1": 0.7058177826564215, "y1": 0.30536130536130535}, {"text": "Year 11 Mathematics Extension", "x0": 0.17672886937431395, "y0": 0.331002331002331, "x1": 0.7903402854006586, "y1": 0.3504273504273504}, {"text": "2023 Task 1", "x0": 0.36553238199780463, "y0": 0.35120435120435123, "x1": 0.5872667398463227, "y1": 0.3714063714063714}, {"text": "Overview: This", "x0": 0.150384193194292, "y0": 0.4281274281274281, "x1": 0.2897914379802415, "y1": 0.4382284382284382}, {"text": "ssignment consists of two parts. In Part A you will need", "x0": 0.31174533479692645, "y0": 0.4281274281274281, "x1": 0.8079034028540066, "y1": 0.4405594405594406}, {"text": "to", "x0": 0.8177826564215148, "y0": 0.4296814296814297, "x1": 0.8353457738748628, "y1": 0.4382284382284382}, {"text": "answer questions involving further graphs using a graphing software. This", "x0": 0.13172338090010977, "y0": 0.4491064491064491, "x1": 0.8035126234906695, "y1": 0.46153846153846156}, {"text": "is a", "x0": 0.8090010976948409, "y0": 0.44988344988344986, "x1": 0.8353457738748628, "y1": 0.4592074592074592}, {"text": "take home component and can be done in your own time. You need to give clear answers", "x0": 0.13172338090010977, "y0": 0.4700854700854701, "x1": 0.8353457738748628, "y1": 0.4825174825174825}, {"text": "and explanations. Each graph needs to be atleast half a page and clearly labelled", "x0": 0.13172338090010977, "y0": 0.4902874902874903, "x1": 0.7925356750823271, "y1": 0.5027195027195027}, {"text": "with", "x0": 0.8002195389681669, "y0": 0.49106449106449107, "x1": 0.8353457738748628, "y1": 0.5003885003885004}, {"text": "all the necessary information including equations. You are also required to print", "x0": 0.13172338090010977, "y0": 0.5112665112665112, "x1": 0.8013172338090011, "y1": 0.5236985236985237}, {"text": "the", "x0": 0.8100987925356751, "y0": 0.5112665112665112, "x1": 0.8353457738748628, "y1": 0.5213675213675214}, {"text": "solution graphs in colour or use a highlighter to highlight your graphs. In Part", "x0": 0.13172338090010977, "y0": 0.5322455322455323, "x1": 0.7782656421514819, "y1": 0.5446775446775447}, {"text": "B you", "x0": 0.7870472008781558, "y0": 0.5322455322455323, "x1": 0.8342480790340285, "y1": 0.5446775446775447}, {"text": "will use the knowledge and skills gained from Part A as well as your solutions from", "x0": 0.13172338090010977, "y0": 0.5524475524475524, "x1": 0.7936333699231614, "y1": 0.5656565656565656}, {"text": "Part", "x0": 0.8002195389681669, "y0": 0.5532245532245532, "x1": 0.8342480790340285, "y1": 0.5633255633255633}, {"text": "A to answer similar questions. This is a formal assessement task and you are required", "x0": 0.13172338090010977, "y0": 0.5734265734265734, "x1": 0.8342480790340285, "y1": 0.5858585858585859}, {"text": "to follow the guidelines set out in the assessment booklet in case of absences.", "x0": 0.13172338090010977, "y0": 0.5944055944055944, "x1": 0.7453347969264544, "y1": 0.6068376068376068}, {"text": "A hardcopy of assignment along with the signed Statement of Authenticity,", "x0": 0.13172338090010977, "y0": 0.6216006216006216, "x1": 0.8331503841931943, "y1": 0.634032634032634}, {"text": "which is attached to the back of Part A, is to be submitted at the start", "x0": 0.13172338090010977, "y0": 0.6425796425796426, "x1": 0.8090010976948409, "y1": 0.6542346542346542}, {"text": "of", "x0": 0.8177826564215148, "y0": 0.6433566433566433, "x1": 0.8364434687156971, "y1": 0.6526806526806527}, {"text": "the lesson in class on 10 May, 2023. Plagiarism will result in zero marks.", "x0": 0.13172338090010977, "y0": 0.6635586635586636, "x1": 0.7815587266739846, "y1": 0.675990675990676}, {"text": "Any", "x0": 0.8024149286498353, "y0": 0.6643356643356644, "x1": 0.8342480790340285, "y1": 0.675990675990676}, {"text": "late submissions will result in penalities. Part A will be worth 5% of the total", "x0": 0.13062568605927552, "y0": 0.6