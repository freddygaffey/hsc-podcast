[[{"text": "GOVERNMENT", "x0": 0.12197802197802197, "y0": 0.1592851592851593, "x1": 0.22527472527472528, "y1": 0.16705516705516704}, {"text": "NSW Education Standards Authority", "x0": 0.11978021978021978, "y0": 0.19114219114219114, "x1": 0.4725274725274725, "y1": 0.20512820512820512}, {"text": "2021", "x0": 0.12747252747252746, "y0": 0.31002331002331, "x1": 0.1824175824175824, "y1": 0.32323232323232326}, {"text": "HIGHER SCHOOL CERTIFICATE EXAMINATION", "x0": 0.2043956043956044, "y0": 0.3146853146853147, "x1": 0.5857142857142857, "y1": 0.32323232323232326}, {"text": "English Advanced", "x0": 0.12307692307692308, "y0": 0.351981351981352, "x1": 0.5461538461538461, "y1": 0.38694638694638694}, {"text": "Paper 2 \u2014 Modules", "x0": 0.12197802197802197, "y0": 0.4211344211344211, "x1": 0.45494505494505494, "y1": 0.445998445998446}, {"text": "General", "x0": 0.11978021978021978, "y0": 0.4933954933954934, "x1": 0.19230769230769232, "y1": 0.5034965034965035}, {"text": "+ Reading time - 5 minutes", "x0": 0.2681318681318681, "y0": 0.4933954933954934, "x1": 0.5131868131868131, "y1": 0.5066045066045066}, {"text": "Instructions Working time - 2 hours", "x0": 0.11978021978021978, "y0": 0.5112665112665112, "x1": 0.49230769230769234, "y1": 0.5275835275835276}, {"text": "+ Write using black pen", "x0": 0.2681318681318681, "y0": 0.5353535353535354, "x1": 0.47802197802197804, "y1": 0.5485625485625486}, {"text": "Total marks: Section | - 20 marks (pages 2-12)", "x0": 0.11868131868131868, "y0": 0.5897435897435898, "x1": 0.5824175824175825, "y1": 0.602952602952603}, {"text": "60", "x0": 0.11868131868131868, "y0": 0.6076146076146076, "x1": 0.14065934065934066, "y1": 0.6177156177156177}, {"text": "+ Attempt ONE question from Questions 1 (a)-1 (9)", "x0": 0.2681318681318681, "y0": 0.6138306138306139, "x1": 0.7230769230769231, "y1": 0.627039627039627}, {"text": "+ Allow about 40 minutes for this section", "x0": 0.2681318681318681, "y0": 0.6355866355866356, "x1": 0.6351648351648351, "y1": 0.6456876456876457}, {"text": "Section II - 20 marks (pages 14-15)", "x0": 0.26703296703296703, "y0": 0.6682206682206682, "x1": 0.6, "y1": 0.6814296814296814}, {"text": "+ Attempt Question 2", "x0": 0.2681318681318681, "y0": 0.6923076923076923, "x1": 0.4582417582417582, "y1": 0.7055167055167055}, {"text": "+ Allow about 40 minutes for this section", "x0": 0.2681318681318681, "y0": 0.714063714063714, "x1": 0.6351648351648351, "y1": 0.7241647241647242}, {"text": "Section III - 20 marks (page 16)", "x0": 0.26703296703296703, "y0": 0.7466977466977467, "x1": 0.5637362637362637, "y1": 0.7599067599067599}, {"text": "+ Attempt Question 3", "x0": 0.2681318681318681, "y0": 0.7715617715617715, "x1": 0.4582417582417582, "y1": 0.7847707847707848}, {"text": "+ Allow about 40 minutes for this section", "x0": 0.2681318681318681, "y0": 0.7925407925407926, "x1": 0.6351648351648351, "y1": 0.8026418026418026}, {"text": "1025", "x0": 0.08241758241758242, "y0": 0.9463869463869464, "x1": 0.11758241758241758, "y1": 0.9549339549339549}], [{"text": "Section I \u2014 Module A: Textual Conversations", "x0": 0.11978021978021978, "y0": 0.08236208236208237, "x1": 0.5846153846153846, "y1": 0.09401709401709402}, {"text": "20 marks", "x0": 0.11868131868131868, "y0": 0.11732711732711733, "x1": 0.1989010989010989, "y1": 0.12742812742812742}, {"text": "Attempt ONE question from Questions 1 (a)-1(g)", "x0": 0.11868131868131868, "y0": 0.13364413364413363, "x1": 0.5483516483516484, "y1": 0.14685314685314685}, {"text": "Allow about 40 minutes for this section", "x0": 0.11868131868131868, "y0": 0.15073815073815075, "x1": 0.45604395604395603, "y1": 0.16083916083916083}, {"text": "Answer the question on pages 2-8 of the Paper 2 Writing Booklet. Extra writing booklets are", "x0": 0.11978021978021978, "y0": 0.18337218337218336, "x1": 0.8791208791208791, "y1": 0.19658119658119658}, {"text": "available.", "x0": 0.11978021978021978, "y0": 0.20124320124320125, "x1": 0.1956043956043956, "y1": 0.21056721056721056}, {"text": "Your answer will be assessed on how well you:", "x0": 0.14395604395604394, "y0": 0.23154623154623155, "x1": 0.5274725274725275, "y1": 0.24397824397824397}, {"text": "demonstrate understanding of how composers are influenced by another text\u2019s", "x0": 0.16703296703296702, "y0": 0.2501942501942502, "x1": 0.856043956043956, "y1": 0.2634032634032634}, {"text": "concepts and values", "x0": 0.16703296703296702, "y0": 0.2680652680652681, "x1": 0.3274725274725275, "y1": 0.2804972804972805}, {"text": "evaluate the relationships between texts and contexts", "x0": 0.16703296703296702, "y0": 0.2874902874902875, "x1": 0.5945054945054945, "y1": 0.3006993006993007}, {"text": "organise, develop and express ideas using language appropriate to audience, purpose", "x0": 0.16703296703296702, "y0": 0.30691530691530694, "x1": 0.856043956043956, "y1": 0.3201243201243201}, {"text": "and form", "x0": 0.16703296703296702, "y0": 0.32400932400932403, "x1": 0.23956043956043957, "y1": 0.3341103341103341}, {"text": "Question 1 (a) \u2014 Shakespearean Drama and Film (20 marks)", "x0": 0.11978021978021978, "y0": 0.3690753690753691, "x1": 0.6450549450549451, "y1": 0.3822843822843823}, {"text": "How do the extracts provided contribute to a broader textual conversation between the pair of", "x0": 0.11978021978021978, "y0": 0.4024864024864025, "x1": 0.8813186813186813, "y1": 0.4156954156954157}, {"text": "prescribed texts that you have studied in Module A?", "x0": 0.11978021978021978, "y0": 0.4195804195804196, "x1": 0.5428571428571428, "y1": 0.43278943278943277}, {"text": "Enter Ricuarp aloft, between two Bishops", "x0": 0.21428571428571427, "y0": 0.466977466977467, "x1": 0.5582417582417583, "y1": 0.4794094794094794}, {"text": "Mayor: See where his grace stands, \u2018tween two clergymen.", "x0": 0.21428571428571427, "y0": 0.49184149184149184, "x1": 0.7703296703296704, "y1": 0.5112665112665112}, {"text": "BUCKINGHAM: \u2014 Two props of virtue for a Christian prince,", "x0": 0.2153846153846154, "y0": 0.515928515928516, "x1": 0.701098901098901, "y1": 0.5392385392385393}, {"text": "To stay him from the fall of vanity.", "x0": 0.35714285714285715, "y0": 0.54001554001554, "x1": 0.6428571428571429, "y1": 0.5532245532245532}, {"text": "And see, a book of prayer in his hand,", "x0": 0.35714285714285715, "y0": 0.5563325563325563, "x1": 0.6659340659340659, "y1": 0.5695415695415695}, {"text": "True ornaments to know a holy man \u2014", "x0": 0.35714285714285715, "y0": 0.5742035742035742, "x1": 0.676923076923077, "y1": 0.5866355866355867}, {"text": "Famous Plantagenet, most gracious prince,", "x0": 0.35714285714285715, "y0": 0.5897435897435898, "x1": 0.7032967032967034, "y1": 0.602952602952603}, {"text": "Lend favourable ear to our reques", "x0": 0.35714285714285715, "y0": 0.6060606060606061, "x1": 0.6274725274725275, "y1": 0.6192696192696193}, {"text": "And pardon us the interruption", "x0": 0.35714285714285715, "y0": 0.6231546231546231, "x1": 0.6065934065934065, "y1": 0.6363636363636364}, {"text": "Of thy devotion and right Christian zeal.", "x0": 0.35714285714285715, "y0": 0.6394716394716394, "x1": 0.6846153846153846, "y1": 0.6526806526806527}, {"text": "(from King Richard III)", "x0": 0.5923076923076923, "y0": 0.6627816627816627, "x1": 0.7846153846153846, "y1": 0.675990675990676}, {"text": "Question 1 (a) continues on page 3", "x0": 0.3516483516483517, "y0": 0.7373737373737373, "x1": 0.6472527472527473, "y1": 0.7505827505827506}], [{"text": "Question 1 (a) (continued)", "x0": 0.11978021978021978, "y0": 0.08158508158508158, "x1": 0.33296703296703295, "y1": 0.09401709401709402}, {"text": "(from Looking for Richard)", "x0": 0.5615384615384615, "y0": 0.5742035742035742, "x1": 0.7846153846153846, "y1": 0.5874125874125874}, {"text": "The prescribed texts are:", "x0": 0.11868131868131868, "y0": 0.6247086247086248, "x1": 0.31758241758241756, "y1": 0.6379176379176379}, {"text": "\u2014 William Shakespeare, King Richard IT", "x0": 0.11868131868131868, "y0": 0.6480186480186481, "x1": 0.46153846153846156, "y1": 0.6612276612276612}, {"text": "and", "x0": 0.23846153846153847, "y0": 0.6721056721056721, "x1": 0.26593406593406593, "y1": 0.6814296814296814}, {"text": "= Al Pacino, Looking for Richard", "x0": 0.11868131868131868, "y0": 0.6946386946386947, "x1": 0.4, "y1": 0.7078477078477079}, {"text": "End of Question 1 (a)", "x0": 0.4065934065934066, "y0": 0.7614607614607615, "x1": 0.5912087912087912, "y1": 0.7738927738927739}, {"text": "OR", "x0": 0.4846153846153846, "y0": 0.811965811965812, "x1": 0.5142857142857142, "y1": 0.822066822066822}], [{"text": "Question 1 (b) \u2014 Prose Fiction and Film (20 marks)", "x0": 0.11978021978021978, "y0": 0.08158508158508158, "x1": 0.5637362637362637, "y1": 0.09401709401709402}, {"text": "How do the extracts provided contribute to a broader textual conversation between the pair of", "x0": 0.11978021978021978, "y0": 0.11499611499611499, "x1": 0.8813186813186813, "y1": 0.1282051282051282}, {"text": "prescribed texts that you have studied in Module A?", "x0": 0.11868131868131868, "y0": 0.1320901320901321, "x1": 0.5428571428571428, "y1": 0.1452991452991453}, {"text": "How many million times she had seen her face, and always with the same imperceptible", "x0": 0.15494505494505495, "y0": 0.17249417249417248, "x1": 0.843956043956044, "y1": 0.1857031857031857}, {"text": "contraction! She pursed her lips when she looked in the glass. It was to give her face", "x0": 0.15494505494505495, "y0": 0.1888111888111888, "x1": 0.843956043956044, "y1": 0.20202020202020202}, {"text": "point. That was her self \u2014 pointed; dartlike; definite. That was her self when some", "x0": 0.15494505494505495, "y0": 0.20590520590520592, "x1": 0.843956043956044, "y1": 0.2191142191142191}, {"text": "effort, some call on her to be her self, drew the parts together, she alone knew how", "x0": 0.15494505494505495, "y0": 0.2222222222222222, "x1": 0.843956043956044, "y1": 0.23543123543123542}, {"text": "different, how incompatible and composed so for the world only into one centre,", "x0": 0.15494505494505495, "y0": 0.23853923853923853, "x1": 0.843956043956044, "y1": 0.2517482517482518}, {"text": "one diamond, one woman who sat in her drawing-room ... had tried to be the same", "x0": 0.15494505494505495, "y0": 0.2556332556332556, "x1": 0.843956043956044, "y1": 0.26884226884226886}, {"text": "always, never showing a sign of all the other sides of her \u2014 faults, jealousies, vanities,", "x0": 0.15494505494505495, "y0": 0.2641802641802642, "x1": 0.843956043956044, "y1": 0.28826728826728826}, {"text": "suspicions, like this of Lady Bruton not asking her to lunch; which, she thought", "x0": 0.15494505494505495, "y0": 0.289044289044289, "x1": 0.843956043956044, "y1": 0.30225330225330227}, {"text": "(combing her hair finally), is utterly base! Now, where was her dress?", "x0": 0.15494505494505495, "y0": 0.30536130536130535, "x1": 0.7230769230769231, "y1": 0.3185703185703186}, {"text": "(from Mrs Dalloway)", "x0": 0.6714285714285714, "y0": 0.32867132867132864, "x1": 0.843956043956044, "y1": 0.3418803418803419}, {"text": "(from The Hours)", "x0": 0.6131868131868132, "y0": 0.7599067599067599, "x1": 0.756043956043956, "y1": 0.7723387723387724}, {"text": "The prescribed texts are:", "x0": 0.11868131868131868, "y0": 0.8010878010878011, "x1": 0.31758241758241756, "y1": 0.8135198135198135}, {"text": "~ Virginia Woolf, Mrs Dalloway", "x0": 0.11868131868131868, "y0": 0.8236208236208237, "x1": 0.3934065934065934, "y1": 0.8368298368298368}, {"text": "and", "x0": 0.23846153846153847, "y0": 0.8477078477078477, "x1": 0.26593406593406593, "y1": 0.857031857031857}, {"text": "\u2014 Stephen Daldry, The Hours", "x0": 0.11868131868131868, "y0": 0.8702408702408703, "x1": 0.3648351648351648, "y1": 0.8834498834498834}, {"text": "OR", "x0": 0.4846153846153846, "y0": 0.9036519036519036, "x1": 0.5142857142857142, "y1": 0.9137529137529138}], [{"text": "Question 1 (c) \u2014 Prose Fiction and Prose Fiction (20 marks)", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.6351648351648351, "y1": 0.09401709401709402}, {"text": "How do the extracts provided contribute to a broader textual conversation between the pair of", "x0": 0.11868131868131868, "y0": 0.11499611499611499, "x1": 0.8813186813186813, "y1": 0.1282051282051282}, {"text": "prescribed texts that you have studied in Module A?", "x0": 0.11868131868131868, "y0": 0.1320901320901321, "x1": 0.5428571428571428, "y1": 0.1452991452991453}, {"text": "(from The Stranger)", "x0": 0.643956043956044, "y0": 0.32556332556332557, "x1": 0.8065934065934066, "y1": 0.33877233877233875}, {"text": "LIETRANGER Copyright \u00a9 Editions Gallimard, Paris, 1942", "x0": 0.45494505494505494, "y0": 0.33877233877233875, "x1": 0.8021978021978022, "y1": 0.36363636363636365}, {"text": "At one and the same time, I felt insulted and revealed to myself. I spent", "x0": 0.1901098901098901, "y0": 0.38461538461538464, "x1": 0.8087912087912088, "y1": 0.3978243978243978}, {"text": "the whole night reading that book. My heart was pounding, I was about to", "x0": 0.1901098901098901, "y0": 0.4017094017094017, "x1": 0.8087912087912088, "y1": 0.4149184149184149}, {"text": "suffocate, it was like reading a book written by God himself. A veritable", "x0": 0.1912087912087912, "y0": 0.41802641802641805, "x1": 0.8087912087912088, "y1": 0.43123543123543123}, {"text": "shock, that\u2019s what it is. Everything was there except the essential thing:", "x0": 0.1912087912087912, "y0": 0.43512043512043513, "x1": 0.8076923076923077, "y1": 0.4483294483294483}, {"text": "Musa\u2019s name.", "x0": 0.1901098901098901, "y0": 0.45143745143745145, "x1": 0.3021978021978022, "y1": 0.46153846153846156}, {"text": "(from The Meursault Investigation)", "x0": 0.521978021978022, "y0": 0.47474747474747475, "x1": 0.8076923076923077, "y1": 0.48795648795648794}, {"text": "\u2018The Meursault Investigation by Kamel Daoud.", "x0": 0.5340659340659341, "y0": 0.4933954933954934, "x1": 0.8054945054945055, "y1": 0.5027195027195027}, {"text": "Reproduced with permission of the Licensor through PLSclear", "x0": 0.43846153846153846, "y0": 0.4972804972804973, "x1": 0.8065934065934066, "y1": 0.5198135198135199}, {"text": "The prescribed texts are:", "x0": 0.11868131868131868, "y0": 0.5275835275835276, "x1": 0.31758241758241756, "y1": 0.5407925407925408}, {"text": "\u2014 Albert Camus, The Stranger", "x0": 0.11868131868131868, "y0": 0.5508935508935509, "x1": 0.37252747252747254, "y1": 0.5641025641025641}, {"text": "and", "x0": 0.23846153846153847, "y0": 0.5742035742035742, "x1": 0.26703296703296703, "y1": 0.5843045843045843}, {"text": "\u2014 Kamel Daoud, The Meursault Investigation", "x0": 0.11868131868131868, "y0": 0.5975135975135976, "x1": 0.4945054945054945, "y1": 0.6107226107226107}, {"text": "OR", "x0": 0.4846153846153846, "y0": 0.6394716394716394, "x1": 0.5142857142857142, "y1": 0.6503496503496503}], [{"text": "Question 1 (d) \u2014 Poetry and Drama (20 marks)", "x0": 0.11978021978021978, "y0": 0.08158508158508158, "x1": 0.5274725274725275, "y1": 0.0947940947940948}, {"text": "How do the extracts provided contribute to a broader textual conversation between the pair of", "x0": 0.11978021978021978, "y0": 0.11499611499611499, "x1": 0.8813186813186813, "y1": 0.1282051282051282}, {"text": "prescribed texts that you have studied in Module A?", "x0": 0.11978021978021978, "y0": 0.1320901320901321, "x1": 0.5428571428571428, "y1": 0.1452991452991453}, {"text": "As virtuous men passe mildly away,", "x0": 0.2923076923076923, "y0": 0.1794871794871795, "x1": 0.5846153846153846, "y1": 0.1919191919191919}, {"text": "And whisper to their soules, to goe,", "x0": 0.3274725274725275, "y0": 0.19813519813519814, "x1": 0.6153846153846154, "y1": 0.21134421134421136}, {"text": "Whilst some of their sad friends doe say,", "x0": 0.2923076923076923, "y0": 0.21678321678321677, "x1": 0.6230769230769231, "y1": 0.22999222999222999}, {"text": "The breath goes now, and some say, no:", "x0": 0.3274725274725275, "y0": 0.23543123543123542, "x1": 0.6516483516483517, "y1": 0.24864024864024864}, {"text": "So let us melt, and make no noise,", "x0": 0.2923076923076923, "y0": 0.2742812742812743, "x1": 0.5703296703296703, "y1": 0.2851592851592852}, {"text": "No teare-floods, nor sigh-tempests move,", "x0": 0.3274725274725275, "y0": 0.29292929292929293, "x1": 0.6615384615384615, "y1": 0.3061383061383061}, {"text": "T\u2019were prophanation of our joyes,", "x0": 0.29120879120879123, "y0": 0.31157731157731156, "x1": 0.5681318681318681, "y1": 0.3247863247863248}, {"text": "To tell the layetie our love.", "x0": 0.3274725274725275, "y0": 0.3317793317793318, "x1": 0.5461538461538461, "y1": 0.3442113442113442}, {"text": "(from A Valediction: forbidding mourning)", "x0": 0.35824175824175825, "y0": 0.358974358974359, "x1": 0.7065934065934066, "y1": 0.37218337218337216}, {"text": "VIVIAN: But it can\u2019t be helped. I don\u2019t see any other way. We are", "x0": 0.1912087912087912, "y0": 0.4133644133644134, "x1": 0.8076923076923077, "y1": 0.42657342657342656}, {"text": "discussing life and death, and not in the abstract, either; we are", "x0": 0.2857142857142857, "y0": 0.4296814296814297, "x1": 0.8076923076923077, "y1": 0.4428904428904429}, {"text": "discussing my life and my death ...", "x0": 0.2857142857142857, "y0": 0.445998445998446, "x1": 0.5725274725274725, "y1": 0.4592074592074592}, {"text": "(Quickly) Now is not the time for verbal swordplay, for unlikely", "x0": 0.2857142857142857, "y0": 0.47474747474747475, "x1": 0.8076923076923077, "y1": 0.48795648795648794}, {"text": "flights of imagination and wildly shifting perspectives, for", "x0": 0.2868131868131868, "y0": 0.49184149184149184, "x1": 0.8087912087912088, "y1": 0.5050505050505051}, {"text": "metaphysical conceit, for wit ...", "x0": 0.2857142857142857, "y0": 0.5081585081585082, "x1": 0.545054945054945, "y1": 0.5213675213675214}, {"text": "(Slowly) Now is a time for simplicity. Now is a time for, dare I", "x0": 0.2857142857142857, "y0": 0.5369075369075369, "x1": 0.8076923076923077, "y1": 0.5501165501165501}, {"text": "say it, kindne:", "x0": 0.2857142857142857, "y0": 0.5532245532245532, "x1": 0.3934065934065934, "y1": 0.5664335664335665}, {"text": "(from", "x0": 0.7230769230769231, "y0": 0.5765345765345765, "x1": 0.7670329670329671, "y1": 0.5889665889665889}, {"text": "Wt by Margaret Edson, Reproduced with kind permission from Nick Hern", "x0": 0.36923076923076925, "y0": 0.5975135975135976, "x1": 0.8043956043956044, "y1": 0.6068376068376068}, {"text": "The prescribed texts are listed on the following page.", "x0": 0.11868131868131868, "y0": 0.6332556332556333, "x1": 0.5494505494505495, "y1": 0.6464646464646465}, {"text": "Question 1 (d) continues on page 7", "x0": 0.3505494505494505, "y0": 0.7008547008547008, "x1": 0.6483516483516484, "y1": 0.714063714063714}], [{"text": "Question 1 (d) (continued)", "x0": 0.11978021978021978, "y0": 0.08158508158508158, "x1": 0.33406593406593404, "y1": 0.09401709401709402}, {"text": "The prescribed texts are:", "x0": 0.11868131868131868, "y0": 0.11577311577311578, "x1": 0.31758241758241756, "y1": 0.1282051282051282}, {"text": "\u2014 John Donne, John Donne: A Selection of His Poetry", "x0": 0.11868131868131868, "y0": 0.1383061383061383, "x1": 0.567032967032967, "y1": 0.15151515151515152}, {"text": "The prescribed poems are:", "x0": 0.14285714285714285, "y0": 0.16161616161616163, "x1": 0.35604395604395606, "y1": 0.17482517482517482}, {"text": "The Sunne Rising", "x0": 0.16703296703296702, "y0": 0.1864801864801865, "x1": 0.3076923076923077, "y1": 0.1989121989121989}, {"text": "RR RRR RE", "x0": 0.14395604395604394, "y0": 0.1864801864801865, "x1": 0.15164835164835164, "y1": 0.3084693084693085}, {"text": "The Apparition", "x0": 0.16703296703296702, "y0": 0.20279720279720279, "x1": 0.289010989010989, "y1": 0.21522921522921523}, {"text": "A Valediction: forbidding mourning", "x0": 0.16593406593406593, "y0": 0.21833721833721834, "x1": 0.45714285714285713, "y1": 0.23154623154623155}, {"text": "This is my playes last scene", "x0": 0.16703296703296702, "y0": 0.23620823620823622, "x1": 0.3901098901098901, "y1": 0.24864024864024864}, {"text": "At the round earths imagin'd corners", "x0": 0.16593406593406593, "y0": 0.2517482517482518, "x1": 0.46923076923076923, "y1": 0.26495726495726496}, {"text": "If poysonous mineralls", "x0": 0.16593406593406593, "y0": 0.26884226884226886, "x1": 0.3505494505494505, "y1": 0.28205128205128205}, {"text": "Death be not proud", "x0": 0.16593406593406593, "y0": 0.2851592851592852, "x1": 0.3252747252747253, "y1": 0.29836829836829837}, {"text": "Hymne to God my God, in my sicknesse", "x0": 0.16593406593406593, "y0": 0.30225330225330227, "x1": 0.489010989010989, "y1": 0.31546231546231546}, {"text": "and", "x0": 0.23846153846153847, "y0": 0.32634032634032634, "x1": 0.26593406593406593, "y1": 0.3356643356643357}, {"text": "\u2014 Margaret Edson, W;t", "x0": 0.11868131868131868, "y0": 0.34887334887334887, "x1": 0.3120879120879121, "y1": 0.3620823620823621}, {"text": "End of Question 1 (d)", "x0": 0.4065934065934066, "y0": 0.4156954156954157, "x1": 0.5923076923076923, "y1": 0.4281274281274281}, {"text": "OR", "x0": 0.4846153846153846, "y0": 0.4662004662004662, "x1": 0.5142857142857142, "y1": 0.4763014763014763}], [{"text": "Question 1 (e) \u2014 Poetry and Film (20 marks)", "x0": 0.11978021978021978, "y0": 0.08158508158508158, "x1": 0.5043956043956044, "y1": 0.0947940947940948}, {"text": "How do the extracts provided contribute to a broader textual conversation between the pair of", "x0": 0.11978021978021978, "y0": 0.11499611499611499, "x1": 0.8813186813186813, "y1": 0.1282051282051282}, {"text": "prescribed texts that you have studied in Module A?", "x0": 0.11978021978021978, "y0": 0.1320901320901321, "x1": 0.5428571428571428, "y1": 0.1452991452991453}, {"text": "Out went the taper as she hurried in;", "x0": 0.2835164835164835, "y0": 0.17871017871017872, "x1": 0.578021978021978, "y1": 0.1919191919191919}, {"text": "Its little smoke, in pallid moonshine, died:", "x0": 0.2835164835164835, "y0": 0.19813519813519814, "x1": 0.6241758241758242, "y1": 0.21134421134421136}, {"text": "She closed the door, she panted, all akin", "x0": 0.2835164835164835, "y0": 0.21678321678321677, "x1": 0.6098901098901099, "y1": 0.22999222999222999}, {"text": "To spirits of the air, and visions wide \u2014", "x0": 0.2835164835164835, "y0": 0.23543123543123542, "x1": 0.6120879120879121, "y1": 0.24864024864024864}, {"text": "No uttered syllable, or, woe betide!", "x0": 0.2835164835164835, "y0": 0.2556332556332556, "x1": 0.5681318681318681, "y1": 0.2680652680652681}, {"text": "But to her heart, her heart was voluble,", "x0": 0.2835164835164835, "y0": 0.2742812742812743, "x1": 0.5989010989010989, "y1": 0.2851592851592852}, {"text": "Paining with eloquence her balmy side;", "x0": 0.2835164835164835, "y0": 0.29292929292929293, "x1": 0.6021978021978022, "y1": 0.3061383061383061}, {"text": "As though a tongueless nightingale should swell", "x0": 0.2835164835164835, "y0": 0.31157731157731156, "x1": 0.6747252747252748, "y1": 0.3247863247863248}, {"text": "Her throat in vain, and die, heart-stifled, in her dell.", "x0": 0.25054945054945055, "y0": 0.331002331002331, "x1": 0.6681318681318681, "y1": 0.34265734265734266}, {"text": "(from The Eve of St Agnes,", "x0": 0.4736263736263736, "y0": 0.358974358974359, "x1": 0.6901098901098901, "y1": 0.37218337218337216}, {"text": "Question 1 (\u00a2) continues on page 9", "x0": 0.3516483516483517, "y0": 0.43123543123543123, "x1": 0.6472527472527473, "y1": 0.4444444444444444}], [{"text": "Question | (e) (continued)", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.33296703296703295, "y1": 0.09401709401709402}, {"text": "(from Bright Star)", "x0": 0.5989010989010989, "y0": 0.5229215229215229, "x1": 0.7461538461538462, "y1": 0.5361305361305362}, {"text": "\u00a9 Pathe Productions Ltd, Screen Australia, BBC,", "x0": 0.45604395604395603, "y0": 0.5454545454545454, "x1": 0.7461538461538462, "y1": 0.554001554001554}, {"text": "UK Film Council, NSW Film & Television Office,", "x0": 0.46483516483516485, "y0": 0.5563325563325563, "x1": 0.7461538461538462, "y1": 0.5648795648795649}, {"text": "\u2018and Jan Chapman Productions Ply Lid", "x0": 0.5131868131868131, "y0": 0.567987567987568, "x1": 0.7428571428571429, "y1": 0.574980574980575}, {"text": "The prescribed texts are: reserved 2008.", "x0": 0.11868131868131868, "y0": 0.5695415695415695, "x1": 0.7428571428571429, "y1": 0.5866355866355867}, {"text": "John Keats, The Complete Poems", "x0": 0.14285714285714285, "y0": 0.5967365967365967, "x1": 0.4142857142857143, "y1": 0.60994560994561}, {"text": "The prescribed poems are:", "x0": 0.14285714285714285, "y0": 0.62004662004662, "x1": 0.35604395604395606, "y1": 0.6332556332556333}, {"text": "* La Belle Dame sans Merci", "x0": 0.14395604395604394, "y0": 0.6433566433566433, "x1": 0.3824175824175824, "y1": 0.6534576534576535}, {"text": "* To Autumn", "x0": 0.14395604395604394, "y0": 0.6604506604506605, "x1": 0.2549450549450549, "y1": 0.6697746697746698}, {"text": "* Bright star! would I were steadfast as thou art", "x0": 0.14395604395604394, "y0": 0.6767676767676768, "x1": 0.545054945054945, "y1": 0.6899766899766899}, {"text": "* Qde to a Nightingale", "x0": 0.14395604395604394, "y0": 0.6930846930846931, "x1": 0.3373626373626374, "y1": 0.7062937062937062}, {"text": "* Ode on a Grecian Urn", "x0": 0.14395604395604394, "y0": 0.7101787101787101, "x1": 0.34945054945054943, "y1": 0.7202797202797203}, {"text": "* When I have fears that I may cease to be", "x0": 0.14395604395604394, "y0": 0.7264957264957265, "x1": 0.4978021978021978, "y1": 0.7397047397047397}, {"text": "* The Eve of St Agnes, XXIII", "x0": 0.14395604395604394, "y0": 0.7435897435897436, "x1": 0.38571428571428573, "y1": 0.7567987567987567}, {"text": "and", "x0": 0.23846153846153847, "y0": 0.7676767676767676, "x1": 0.26593406593406593, "y1": 0.777000777000777}, {"text": "\u2014 Jane Campion, Bright Star", "x0": 0.11868131868131868, "y0": 0.7902097902097902, "x1": 0.35934065934065934, "y1": 0.8034188034188035}, {"text": "End of Question 1 (e)", "x0": 0.4076923076923077, "y0": 0.8407148407148407, "x1": 0.5912087912087912, "y1": 0.8531468531468531}, {"text": "OR", "x0": 0.4846153846153846, "y0": 0.8904428904428905, "x1": 0.5142857142857142, "y1": 0.9005439005439005}], [{"text": "Question 1 (f) \u2014 Poetry and Poetry (20 marks)", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.5197802197802198, "y1": 0.0947940947940948}, {"text": "How do the extracts provided contribute to a broader textual conversation between the pair of", "x0": 0.11868131868131868, "y0": 0.11499611499611499, "x1": 0.8813186813186813, "y1": 0.1282051282051282}, {"text": "prescribed texts that you have studied in Module A?", "x0": 0.11868131868131868, "y0": 0.1320901320901321, "x1": 0.5428571428571428, "y1": 0.1452991452991453}, {"text": "(from Lady Lazarus)", "x0": 0.5065934065934066, "y0": 0.4506604506604507, "x1": 0.6747252747252748, "y1": 0.46386946386946387}, {"text": "In my position, the right witchdoctor", "x0": 0.23626373626373626, "y0": 0.5081585081585082, "x1": 0.5351648351648352, "y1": 0.5213675213675214}, {"text": "Might have caught you in flight with his bare hands,", "x0": 0.23626373626373626, "y0": 0.5275835275835276, "x1": 0.6615384615384615, "y1": 0.5407925407925408}, {"text": "Tossed you, cooling, one hand to the other,", "x0": 0.23626373626373626, "y0": 0.5462315462315462, "x1": 0.5868131868131868, "y1": 0.5594405594405595}, {"text": "Godless, happy, quieted.", "x0": 0.23626373626373626, "y0": 0.5656565656565656, "x1": 0.4340659340659341, "y1": 0.5788655788655789}, {"text": "I managed", "x0": 0.43846153846153846, "y0": 0.5843045843045843, "x1": 0.5230769230769231, "y1": 0.5975135975135976}, {"text": "\u2018A wisp of your hair, your ring, your watch, your nightgown.", "x0": 0.23626373626373626, "y0": 0.6037296037296037, "x1": 0.7252747252747253, "y1": 0.616938616938617}, {"text": "(from The Shot)", "x0": 0.634065934065934, "y0": 0.6317016317016317, "x1": 0.7626373626373626, "y1": 0.6441336441336442}, {"text": "\u00a9Ted Hughes", "x0": 0.676923076923077, "y0": 0.6519036519036518, "x1": 0.7593406593406593, "y1": 0.6612276612276612}, {"text": "Used by permission of Faber & Faber Publishing", "x0": 0.4714285714285714, "y0": 0.6519036519036518, "x1": 0.7593406593406593, "y1": 0.6775446775446775}, {"text": "The prescribed texts are listed on the following page.", "x0": 0.11868131868131868, "y0": 0.6853146853146853, "x1": 0.5494505494505495, "y1": 0.6985236985236986}, {"text": "Question 1 (f) continues on page 11", "x0": 0.34835164835164834, "y0": 0.752913752913753, "x1": 0.6505494505494506, "y1": 0.7661227661227661}], [{"text": "Question 1 (f) (continued)", "x0": 0.11978021978021978, "y0": 0.08158508158508158, "x1": 0.33076923076923076, "y1": 0.09401709401709402}, {"text": "The prescribed texts are:", "x0": 0.11868131868131868, "y0": 0.11577311577311578, "x1": 0.31758241758241756, "y1": 0.1282051282051282}, {"text": "\u2014 Sylvia Plath, Arie!", "x0": 0.11868131868131868, "y0": 0.1383061383061383, "x1": 0.29120879120879123, "y1": 0.15151515151515152}, {"text": "The prescribed poems are:", "x0": 0.14285714285714285, "y0": 0.16161616161616163, "x1": 0.35604395604395606, "y1": 0.17482517482517482}, {"text": "Daddy", "x0": 0.16593406593406593, "y0": 0.1857031857031857, "x1": 0.21978021978021978, "y1": 0.19658119658119658}, {"text": "eee RRR", "x0": 0.14395604395604394, "y0": 0.1864801864801865, "x1": 0.15164835164835164, "y1": 0.27505827505827507}, {"text": "Nick and the Candlestick", "x0": 0.16593406593406593, "y0": 0.20202020202020202, "x1": 0.37032967032967035, "y1": 0.21212121212121213}, {"text": "A Birthday Present", "x0": 0.16593406593406593, "y0": 0.21833721833721834, "x1": 0.321978021978022, "y1": 0.23154623154623155}, {"text": "Lady Lazarus", "x0": 0.16593406593406593, "y0": 0.23543123543123542, "x1": 0.27692307692307694, "y1": 0.2463092463092463}, {"text": "Fever 103\u00b0", "x0": 0.16703296703296702, "y0": 0.25252525252525254, "x1": 0.2571428571428571, "y1": 0.2618492618492618}, {"text": "The Arrival of the Bee Box", "x0": 0.16703296703296702, "y0": 0.26884226884226886, "x1": 0.38461538461538464, "y1": 0.28205128205128205}, {"text": "and", "x0": 0.23846153846153847, "y0": 0.29292929292929293, "x1": 0.26593406593406593, "y1": 0.30225330225330227}, {"text": "Ted Hughes, Birthday Letters", "x0": 0.14285714285714285, "y0": 0.31546231546231546, "x1": 0.38351648351648354, "y1": 0.32867132867132864}, {"text": "The prescribed poems are:", "x0": 0.14285714285714285, "y0": 0.33877233877233875, "x1": 0.35604395604395606, "y1": 0.351981351981352}, {"text": "Fulbright Scholars", "x0": 0.16703296703296702, "y0": 0.3620823620823621, "x1": 0.31868131868131866, "y1": 0.3752913752913753}, {"text": "eR RRR", "x0": 0.14395604395604394, "y0": 0.3628593628593629, "x1": 0.15164835164835164, "y1": 0.45143745143745145}, {"text": "The Shot", "x0": 0.16703296703296702, "y0": 0.3791763791763792, "x1": 0.23846153846153847, "y1": 0.38927738927738925}, {"text": "A Picture of Otto", "x0": 0.16593406593406593, "y0": 0.3962703962703963, "x1": 0.3054945054945055, "y1": 0.4087024087024087}, {"text": "Fever", "x0": 0.16703296703296702, "y0": 0.4133644133644134, "x1": 0.21428571428571427, "y1": 0.4226884226884227}, {"text": "Red", "x0": 0.16593406593406593, "y0": 0.4289044289044289, "x1": 0.1978021978021978, "y1": 0.439005439005439}, {"text": "The Bee God", "x0": 0.16703296703296702, "y0": 0.44522144522144524, "x1": 0.2725274725274725, "y1": 0.4553224553224553}, {"text": "End of Question 1 (f)", "x0": 0.4087912087912088, "y0": 0.5128205128205128, "x1": 0.5901098901098901, "y1": 0.5252525252525253}, {"text": "OR", "x0": 0.4846153846153846, "y0": 0.5633255633255633, "x1": 0.5142857142857142, "y1": 0.5734265734265734}, {"text": "Please turn over", "x0": 0.42967032967032964, "y0": 0.6130536130536131, "x1": 0.5692307692307692, "y1": 0.6231546231546231}], [{"text": "Question 1 (g) \u2014 Shakespearean Drama and Prose Fiction (20 marks)", "x0": 0.11978021978021978, "y0": 0.08158508158508158, "x1": 0.7186813186813187, "y1": 0.0947940947940948}, {"text": "How do the extracts provided contribute to a broader textual conversation between the pair of", "x0": 0.11978021978021978, "y0": 0.11499611499611499, "x1": 0.8813186813186813, "y1": 0.1282051282051282}, {"text": "prescribed texts that you have studied in Module A?", "x0": 0.11978021978021978, "y0": 0.13286713286713286, "x1": 0.5428571428571428, "y1": 0.1452991452991453}, {"text": "MIRANDA: ... But thy vile race\u2014", "x0": 0.2098901098901099, "y0": 0.17871017871017872, "x1": 0.4846153846153846, "y1": 0.1919191919191919}, {"text": "Though thou didst learn\u2014 had that in\u2019t which good natures", "x0": 0.30439560439560437, "y0": 0.19813519813519814, "x1": 0.7857142857142857, "y1": 0.21134421134421136}, {"text": "Could not abide to be with; therefore wast thou", "x0": 0.30439560439560437, "y0": 0.21678321678321677, "x1": 0.6879120879120879, "y1": 0.22766122766122765}, {"text": "Deservedly confined into this rock,", "x0": 0.30439560439560437, "y0": 0.23543123543123542, "x1": 0.589010989010989, "y1": 0.24864024864024864}, {"text": "Who hadst deserved more than a prison.", "x0": 0.30439560439560437, "y0": 0.25485625485625485, "x1": 0.6296703296703297, "y1": 0.2680652680652681}, {"text": "CALIBAN: You taught me language, and my profit on\u2019t", "x0": 0.2087912087912088, "y0": 0.29292929292929293, "x1": 0.6615384615384615, "y1": 0.3061383061383061}, {"text": "Is, [know how to curse. The red plague rid you", "x0": 0.30439560439560437, "y0": 0.3123543123543124, "x1": 0.6912087912087912, "y1": 0.3247863247863248}, {"text": "For learning me your language!", "x0": 0.30439560439560437, "y0": 0.3317793317793318, "x1": 0.5593406593406594, "y1": 0.3442113442113442}, {"text": "(from The Tempest)", "x0": 0.6296703296703297, "y0": 0.358974358974359, "x1": 0.789010989010989, "y1": 0.37218337218337216}, {"text": "\u201cThen, seven individuals are imprisoned in events in which the jailer is", "x0": 0.2, "y0": 0.40792540792540793, "x1": 0.7725274725274726, "y1": 0.4211344211344211}, {"text": "Prospero. He would seem to be the top jailer in this play.\u201d", "x0": 0.2010989010989011, "y0": 0.425019425019425, "x1": 0.667032967032967, "y1": 0.4382284382284382}, {"text": "\u201cPlus he\u2019s a slave-driver,\u201d says Red Coyote.", "x0": 0.2, "y0": 0.452991452991453, "x1": 0.5560439560439561, "y1": 0.4662004662004662}, {"text": "\u201cNot just with Caliban, he\u2019s got his foot on Ariel too,\u201d says 8Handz.", "x0": 0.2, "y0": 0.48174048174048173, "x1": 0.7505494505494505, "y1": 0.494949494949495}, {"text": "\u201cHe threatens him with that oak tree. Permanent solitary. It\u2019s inhuman.\u201d", "x0": 0.2, "y0": 0.5097125097125097, "x1": 0.7802197802197802, "y1": 0.5229215229215229}, {"text": "\u201cPlus he\u2019s a land stealer,\u201d adds Red Coyote.", "x0": 0.2, "y0": 0.5384615384615384, "x1": 0.554945054945055, "y1": 0.5516705516705517}, {"text": "(from Hag-Seed)", "x0": 0.6538461538461539, "y0": 0.5695415695415695, "x1": 0.789010989010989, "y1": 0.5827505827505828}, {"text": "From Hag-Seed by Margaret Atwood published by Hogarth", "x0": 0.43736263736263736, "y0": 0.5944055944055944, "x1": 0.7857142857142857, "y1": 0.6037296037296037}, {"text": "Copyright \u00a9 Margaret Atwood, 2016. Reprinted by permission of The Random House Group Limited", "x0": 0.1934065934065934, "y0": 0.5959595959595959, "x1": 0.7857142857142857, "y1": 0.6208236208236209}, {"text": "The prescribed texts are:", "x0": 0.11868131868131868, "y0": 0.6394716394716394, "x1": 0.31648351648351647, "y1": 0.6519036519036518}, {"text": "William Shakespeare, The Tempest", "x0": 0.14285714285714285, "y0": 0.662004662004662, "x1": 0.42857142857142855, "y1": 0.6752136752136753}, {"text": "and", "x0": 0.23846153846153847, "y0": 0.6860916860916861, "x1": 0.26593406593406593, "y1": 0.6954156954156954}, {"text": "\u2014 Margaret Atwood, Hag-Seed", "x0": 0.11868131868131868, "y0": 0.7094017094017094, "x1": 0.3769230769230769, "y1": 0.7218337218337219}, {"text": "End of Question 1", "x0": 0.421978021978022, "y0": 0.7762237762237763, "x1": 0.5758241758241758, "y1": 0.7886557886557887}], [{"text": "BLANK PAGE", "x0": 0.43626373626373627, "y0": 0.3550893550893551, "x1": 0.5626373626373626, "y1": 0.3644133644133644}, {"text": "Please turn over", "x0": 0.42967032967032964, "y0": 0.4219114219114219, "x1": 0.5692307692307692, "y1": 0.432012432012432}], [{"text": "Section If \u2014 Module B: Critical Study of Literature", "x0": 0.11978021978021978, "y0": 0.08236208236208237, "x1": 0.6450549450549451, "y1": 0.09712509712509712}, {"text": "20 marks", "x0": 0.11868131868131868, "y0": 0.11732711732711733, "x1": 0.1989010989010989, "y1": 0.12742812742812742}, {"text": "Attempt Question 2", "x0": 0.11868131868131868, "y0": 0.13364413364413363, "x1": 0.2879120879120879, "y1": 0.14685314685314685}, {"text": "Allow about 40 minutes for this section", "x0": 0.11868131868131868, "y0": 0.15073815073815075, "x1": 0.45604395604395603, "y1": 0.16083916083916083}, {"text": "Answer the question on pages 10-16 of the Paper 2 Writing Booklet. Extra writing booklets", "x0": 0.11978021978021978, "y0": 0.18337218337218336, "x1": 0.8791208791208791, "y1": 0.19658119658119658}, {"text": "are available.", "x0": 0.11978021978021978, "y0": 0.20046620046620048, "x1": 0.22527472527472528, "y1": 0.21056721056721056}, {"text": "Your answer will be assessed on how well you:", "x0": 0.14395604395604394, "y0": 0.23154623154623155, "x1": 0.5274725274725275, "y1": 0.24397824397824397}, {"text": "demonstrate an informed understanding of the ideas expressed in the text", "x0": 0.14285714285714285, "y0": 0.2501942501942502, "x1": 0.7593406593406593, "y1": 0.2634032634032634}, {"text": "evaluate the text\u2019s distinctive language and stylistic qualities", "x0": 0.16703296703296702, "y0": 0.2703962703962704, "x1": 0.6571428571428571, "y1": 0.2836052836052836}, {"text": "\u00a9 organise, develop and express ideas using language appropriate to audience, purpose", "x0": 0.14285714285714285, "y0": 0.2905982905982906, "x1": 0.856043956043956, "y1": 0.3038073038073038}, {"text": "and form", "x0": 0.16703296703296702, "y0": 0.30691530691530694, "x1": 0.23956043956043957, "y1": 0.317016317016317}, {"text": "Question 2 (20 marks)", "x0": 0.11978021978021978, "y0": 0.35275835275835277, "x1": 0.30439560439560437, "y1": 0.3651903651903652}, {"text": "\u2018Literature forces us to ask questions and look for answers. Even if those answers do not exist.\u2019", "x0": 0.12087912087912088, "y0": 0.3978243978243978, "x1": 0.878021978021978, "y1": 0.411033411033411}, {"text": "To what extent is this true?", "x0": 0.11868131868131868, "y0": 0.42657342657342656, "x1": 0.3395604395604396, "y1": 0.4366744366744367}, {"text": "In your response, make close reference to your prescribed text.", "x0": 0.11978021978021978, "y0": 0.45454545454545453, "x1": 0.6285714285714286, "y1": 0.4677544677544678}, {"text": "The prescribed texts are listed on the following page.", "x0": 0.11868131868131868, "y0": 0.4996114996114996, "x1": 0.5494505494505495, "y1": 0.5128205128205128}, {"text": "Question 2 continues on page 15", "x0": 0.36043956043956044, "y0": 0.5672105672105672, "x1": 0.6373626373626373, "y1": 0.5804195804195804}], [{"text": "Question 2 (continued)", "x0": 0.11978021978021978, "y0": 0.08158508158508158, "x1": 0.30439560439560437, "y1": 0.09401709401709402}, {"text": "The prescribed texts are:", "x0": 0.11868131868131868, "y0": 0.11577311577311578, "x1": 0.31758241758241756, "y1": 0.1282051282051282}, {"text": "* Prose Fiction \u2014 Jane Austen, Emma", "x0": 0.11978021978021978, "y0": 0.14840714840714841, "x1": 0.46923076923076923, "y1": 0.16006216006216006}, {"text": "Charles Dickens, Great Expectations",