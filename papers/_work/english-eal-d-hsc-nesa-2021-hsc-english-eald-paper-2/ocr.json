[[{"text": "GOVERNMENT", "x0": 0.12197802197802197, "y0": 0.1592851592851593, "x1": 0.22527472527472528, "y1": 0.16705516705516704}, {"text": "NSW Education Standards Authority", "x0": 0.11978021978021978, "y0": 0.19114219114219114, "x1": 0.4725274725274725, "y1": 0.20512820512820512}, {"text": "2021 | HIGHER SCHOOL CERTIFICATE EXAMINATION", "x0": 0.12747252747252746, "y0": 0.30691530691530694, "x1": 0.5857142857142857, "y1": 0.331002331002331}, {"text": "English as an Additional", "x0": 0.12307692307692308, "y0": 0.351981351981352, "x1": 0.6934065934065934, "y1": 0.38694638694638694}, {"text": "Language or Dialect (EAL/D)", "x0": 0.12307692307692308, "y0": 0.3962703962703963, "x1": 0.8054945054945055, "y1": 0.432012432012432}, {"text": "Paper 2 \u2014 Modules", "x0": 0.12197802197802197, "y0": 0.4662004662004662, "x1": 0.45494505494505494, "y1": 0.49106449106449107}, {"text": "+ Reading time - 5 minutes", "x0": 0.2681318681318681, "y0": 0.5376845376845377, "x1": 0.5131868131868131, "y1": 0.5508935508935509}, {"text": "General", "x0": 0.11978021978021978, "y0": 0.5384615384615384, "x1": 0.19230769230769232, "y1": 0.5485625485625486}, {"text": "Instructions", "x0": 0.11978021978021978, "y0": 0.5563325563325563, "x1": 0.23296703296703297, "y1": 0.5664335664335665}, {"text": "+ Working time - 1 hour", "x0": 0.2681318681318681, "y0": 0.5563325563325563, "x1": 0.4835164835164835, "y1": 0.5757575757575758}, {"text": "+ Write using black pen", "x0": 0.2681318681318681, "y0": 0.5804195804195804, "x1": 0.47802197802197804, "y1": 0.5936285936285937}, {"text": "Total marks:", "x0": 0.11868131868131868, "y0": 0.6348096348096348, "x1": 0.23846153846153847, "y1": 0.6449106449106449}, {"text": "Section | - 20 marks (pages 2-3)", "x0": 0.26703296703296703, "y0": 0.6348096348096348, "x1": 0.5714285714285714, "y1": 0.6480186480186481}, {"text": "40", "x0": 0.11868131868131868, "y0": 0.6526806526806527, "x1": 0.14065934065934066, "y1": 0.6627816627816627}, {"text": "+ Attempt Question 1", "x0": 0.2681318681318681, "y0": 0.6588966588966589, "x1": 0.45604395604395603, "y1": 0.6721056721056721}, {"text": "+ Allow about 30 minutes for this section", "x0": 0.2681318681318681, "y0": 0.6798756798756799, "x1": 0.6351648351648351, "y1": 0.6899766899766899}, {"text": "Section II - 20 marks (pages 4-8)", "x0": 0.26703296703296703, "y0": 0.7132867132867133, "x1": 0.578021978021978, "y1": 0.7264957264957265}, {"text": "+ Attempt ONE question from Questions 2 (a)\u20142 (h)", "x0": 0.2681318681318681, "y0": 0.7373737373737373, "x1": 0.7241758241758242, "y1": 0.7505827505827506}, {"text": "+ Allow about 30 minutes for this section", "x0": 0.2681318681318681, "y0": 0.7591297591297591, "x1": 0.6351648351648351, "y1": 0.7692307692307693}, {"text": "2082", "x0": 0.08131868131868132, "y0": 0.9463869463869464, "x1": 0.11758241758241758, "y1": 0.9549339549339549}], [{"text": "Section I \u2014 Module B: Language, Identity and Culture", "x0": 0.11978021978021978, "y0": 0.08236208236208237, "x1": 0.676923076923077, "y1": 0.09712509712509712}, {"text": "20 marks", "x0": 0.11868131868131868, "y0": 0.11732711732711733, "x1": 0.1989010989010989, "y1": 0.12742812742812742}, {"text": "Attempt Question 1", "x0": 0.11868131868131868, "y0": 0.13364413364413363, "x1": 0.2868131868131868, "y1": 0.14685314685314685}, {"text": "Allow about 30 minutes for this section", "x0": 0.11868131868131868, "y0": 0.15073815073815075, "x1": 0.45604395604395603, "y1": 0.16083916083916083}, {"text": "Answer the question on pages 2-8 of the Paper 2 Writing Booklet. Extra writing booklets are", "x0": 0.11978021978021978, "y0": 0.18337218337218336, "x1": 0.8791208791208791, "y1": 0.19658119658119658}, {"text": "available.", "x0": 0.11978021978021978, "y0": 0.20046620046620048, "x1": 0.1956043956043956, "y1": 0.21056721056721056}, {"text": "Your answer will be assessed on how well you:", "x0": 0.14395604395604394, "y0": 0.23076923076923078, "x1": 0.5274725274725275, "y1": 0.24397824397824397}, {"text": "* demonstrate understanding of how language is used to express cultural identity", "x0": 0.14285714285714285, "y0": 0.2501942501942502, "x1": 0.8076923076923077, "y1": 0.2634032634032634}, {"text": "* organise, develop and express ideas using language appropriate to audience, purpose", "x0": 0.14285714285714285, "y0": 0.2703962703962704, "x1": 0.856043956043956, "y1": 0.2836052836052836}, {"text": "and form", "x0": 0.16703296703296702, "y0": 0.2874902874902875, "x1": 0.23956043956043957, "y1": 0.2975912975912976}, {"text": "Question 1 (20 marks)", "x0": 0.11978021978021978, "y0": 0.33255633255633255, "x1": 0.30439560439560437, "y1": 0.34498834498834496}, {"text": "How do composers use language to reveal the complexities of culture?", "x0": 0.11978021978021978, "y0": 0.36596736596736595, "x1": 0.6923076923076923, "y1": 0.3791763791763792}, {"text": "In your response, refer to your prescribed text.", "x0": 0.11978021978021978, "y0": 0.39937839937839936, "x1": 0.4956043956043956, "y1": 0.4125874125874126}, {"text": "The prescribed texts are listed on page 3.", "x0": 0.11978021978021978, "y0": 0.4491064491064491, "x1": 0.45054945054945056, "y1": 0.46231546231546233}, {"text": "Question 1 continues on page 3", "x0": 0.3659340659340659, "y0": 0.5167055167055167, "x1": 0.6329670329670329, "y1": 0.5299145299145299}], [{"text": "Question 1 (continued)", "x0": 0.11978021978021978, "y0": 0.08158508158508158, "x1": 0.30439560439560437, "y1": 0.0947940947940948}, {"text": "The prescribed texts are:", "x0": 0.11868131868131868, "y0": 0.11499611499611499, "x1": 0.31758241758241756, "y1": 0.1282051282051282}, {"text": "+ Prose Fiction\u2014 Tara June Winch, Swallow the Air", "x0": 0.11978021978021978, "y0": 0.14840714840714841, "x1": 0.5648351648351648, "y1": 0.16083916083916083}, {"text": "Poetry", "x0": 0.14285714285714285, "y0": 0.18181818181818182, "x1": 0.1989010989010989, "y1": 0.19502719502719504}, {"text": "Adam Aitken, Kim Cheng Boey and Michelle Cahill (eds),", "x0": 0.2857142857142857, "y0": 0.18181818181818182, "x1": 0.7637362637362637, "y1": 0.19502719502719504}, {"text": "Contemporary Asian Australian Poets", "x0": 0.2868131868131868, "y0": 0.1989121989121989, "x1": 0.5945054945054945, "y1": 0.21212121212121213}, {"text": "The prescribed poems are:", "x0": 0.2857142857142857, "y0": 0.2222222222222222, "x1": 0.4989010989010989, "y1": 0.23543123543123542}, {"text": "Merlinda Bobis, This is where it begins", "x0": 0.3098901098901099, "y0": 0.24553224553224554, "x1": 0.6285714285714286, "y1": 0.25874125874125875}, {"text": "Eileen Chong, My Hakka Grandmother", "x0": 0.3098901098901099, "y0": 0.26262626262626265, "x1": 0.6296703296703297, "y1": 0.27583527583527584}, {"text": "Ee Tiang Hong, Some New Perspectives", "x0": 0.3098901098901099, "y0": 0.27972027972027974, "x1": 0.6351648351648351, "y1": 0.29215229215229216}, {"text": "Ouyang Yu, The Double Man", "x0": 0.3098901098901099, "y0": 0.29526029526029524, "x1": 0.5505494505494506, "y1": 0.3084693084693085}, {"text": "Jaya Savige, Circular Breathing", "x0": 0.3098901098901099, "y0": 0.3123543123543124, "x1": 0.5703296703296703, "y1": 0.32556332556332557}, {"text": "ee", "x0": 0.2868131868131868, "y0": 0.3123543123543124, "x1": 0.2945054945054945, "y1": 0.3348873348873349}, {"text": "Maureen Ten (Ten U), Translucent Jade", "x0": 0.3098901098901099, "y0": 0.3271173271173271, "x1": 0.689010989010989, "y1": 0.3411033411033411}, {"text": "Langston Hughes", "x0": 0.2868131868131868, "y0": 0.3620823620823621, "x1": 0.42637362637362636, "y1": 0.3752913752913753}, {"text": "The prescribed poems are:", "x0": 0.2857142857142857, "y0": 0.3861693861693862, "x1": 0.4989010989010989, "y1": 0.39937839937839936}, {"text": "* The Negro Speaks of Rivers", "x0": 0.2868131868131868, "y0": 0.4094794094794095, "x1": 0.5340659340659341, "y1": 0.4226884226884227}, {"text": "* Aunt Sue's Stories", "x0": 0.2868131868131868, "y0": 0.4257964257964258, "x1": 0.45714285714285713, "y1": 0.4358974358974359}, {"text": "* A Song to a Negro Wash-woman", "x0": 0.2868131868131868, "y0": 0.4428904428904429, "x1": 0.5747252747252747, "y1": 0.4560994560994561}, {"text": "* 1, Too", "x0": 0.2868131868131868, "y0": 0.4592074592074592, "x1": 0.35714285714285715, "y1": 0.47086247086247085}, {"text": "* The Weary Blues", "x0": 0.2868131868131868, "y0": 0.4755244755244755, "x1": 0.4472527472527473, "y1": 0.4887334887334887}, {"text": "* Theme for English B", "x0": 0.2868131868131868, "y0": 0.4926184926184926, "x1": 0.47692307692307695, "y1": 0.5058275058275058}, {"text": "* Night Funeral in Harlem", "x0": 0.2868131868131868, "y0": 0.508935508935509, "x1": 0.512087912087912, "y1": 0.5221445221445221}, {"text": "Drama", "x0": 0.14285714285714285, "y0": 0.5423465423465423, "x1": 0.2021978021978022, "y1": 0.5524475524475524}, {"text": "Ray Lawler, Summer of the Seventeenth Doll", "x0": 0.2857142857142857, "y0": 0.5423465423465423, "x1": 0.6516483516483517, "y1": 0.5555555555555556}, {"text": "Alana Valentine, Shafana and Aunt Sarrinah", "x0": 0.2857142857142857, "y0": 0.5664335664335665, "x1": 0.6494505494505495, "y1": 0.5796425796425796}, {"text": "Nonfiction", "x0": 0.14285714285714285, "y0": 0.5998445998445998, "x1": 0.23296703296703297, "y1": 0.60994560994561}, {"text": "Lily Chan, Toyo", "x0": 0.2868131868131868, "y0": 0.5998445998445998, "x1": 0.4175824175824176, "y1": 0.6130536130536131}, {"text": "Film", "x0": 0.14285714285714285, "y0": 0.6332556332556333, "x1": 0.1824175824175824, "y1": 0.6433566433566433}, {"text": "Rolf de Heer, Ten Canoes", "x0": 0.2857142857142857, "y0": 0.6332556332556333, "x1": 0.4967032967032967, "y1": 0.6449106449106449}, {"text": "Media", "x0": 0.14285714285714285, "y0": 0.6666666666666666, "x1": 0.1967032967032967, "y1": 0.6767676767676768}, {"text": "Janet Merewether, Reindeer in my Saami Heart", "x0": 0.2857142857142857, "y0": 0.6666666666666666, "x1": 0.6714285714285714, "y1": 0.6798756798756799}, {"text": "End of Question 1", "x0": 0.421978021978022, "y0": 0.7334887334887334, "x1": 0.5758241758241758, "y1": 0.745920745920746}], [{"text": "Section II \u2014 Module C: Close Study of Text", "x0": 0.11978021978021978, "y0": 0.08236208236208237, "x1": 0.5659340659340659, "y1": 0.09712509712509712}, {"text": "20 marks", "x0": 0.11868131868131868, "y0": 0.11732711732711733, "x1": 0.1989010989010989, "y1": 0.12742812742812742}, {"text": "Attempt ONE question from Questions 2 (a)\u20142(h)", "x0": 0.11868131868131868, "y0": 0.13364413364413363, "x1": 0.5516483516483517, "y1": 0.14685314685314685}, {"text": "Allow about 30 minutes for this section", "x0": 0.11868131868131868, "y0": 0.15073815073815075, "x1": 0.45604395604395603, "y1": 0.16083916083916083}, {"text": "\u2018Answer the question on pages 10-16 of the Paper 2 Writing Booklet. Extra writing booklets", "x0": 0.11868131868131868, "y0": 0.18337218337218336, "x1": 0.8791208791208791, "y1": 0.19658119658119658}, {"text": "are available.", "x0": 0.11978021978021978, "y0": 0.20046620046620048, "x1": 0.22527472527472528, "y1": 0.21056721056721056}, {"text": "Your answer will be assessed on how well you:", "x0": 0.14395604395604394, "y0": 0.23076923076923078, "x1": 0.5274725274725275, "y1": 0.24397824397824397}, {"text": "* demonstrate understanding of a text\u2019s distinctive qualities and how these shape", "x0": 0.14285714285714285, "y0": 0.2501942501942502, "x1": 0.856043956043956, "y1": 0.2634032634032634}, {"text": "meaning", "x0": 0.16703296703296702, "y0": 0.2703962703962704, "x1": 0.23516483516483516, "y1": 0.2804972804972805}, {"text": "\u00a9 organise, develop and express ideas using language appropriate to audience, purpose", "x0": 0.14285714285714285, "y0": 0.2874902874902875, "x1": 0.856043956043956, "y1": 0.3006993006993007}, {"text": "and form", "x0": 0.16703296703296702, "y0": 0.3038073038073038, "x1": 0.23956043956043957, "y1": 0.3139083139083139}, {"text": "Question 2 (a) \u2014 Prose Fiction - Ray Bradbury, Fahrenheit 451 (20 marks)", "x0": 0.11978021978021978, "y0": 0.34965034965034963, "x1": 0.765934065934066, "y1": 0.3628593628593629}, {"text": "He stepped into the bedroom and fired twice and the twin beds went up in", "x0": 0.1912087912087912, "y0": 0.3791763791763792, "x1": 0.8076923076923077, "y1": 0.3923853923853924}, {"text": "a great simmering whisper, with more heat and passion and light than he", "x0": 0.1912087912087912, "y0": 0.3962703962703963, "x1": 0.8087912087912088, "y1": 0.4094794094794095}, {"text": "would have supposed them to contain. He burnt the bedroom walls and the", "x0": 0.1912087912087912, "y0": 0.4125874125874126, "x1": 0.8076923076923077, "y1": 0.4257964257964258}, {"text": "cosmetics chest because he wanted to change everything, the chairs, the", "x0": 0.1912087912087912, "y0": 0.4296814296814297, "x1": 0.8087912087912088, "y1": 0.4428904428904429}, {"text": "tables, and in the dining-room the silverware and plastic dishes, everything", "x0": 0.1912087912087912, "y0": 0.445998445998446, "x1": 0.8087912087912088, "y1": 0.4592074592074592}, {"text": "that showed he had lived here in this empty house with a strange woman", "x0": 0.1912087912087912, "y0": 0.4630924630924631, "x1": 0.8076923076923077, "y1": 0.4763014763014763}, {"text": "who would forget him tomorrow, who had gone and quite forgotten him", "x0": 0.1912087912087912, "y0": 0.4794094794094794, "x1": 0.8076923076923077, "y1": 0.4926184926184926}, {"text": "already ... And as before, it was good to burn, he felt himself gush out in the", "x0": 0.1912087912087912, "y0": 0.4965034965034965, "x1": 0.8087912087912088, "y1": 0.5097125097125097}, {"text": "fire, snatch, rend, rip in half with flame", "x0": 0.1912087912087912, "y0": 0.5128205128205128, "x1": 0.5098901098901099, "y1": 0.526029526029526}, {"text": "Reproduced by permission of Don Congdon Associates", "x0": 0.48021978021978023, "y0": 0.5314685314685315, "x1": 0.8076923076923077, "y1": 0.5407925407925408}, {"text": "How does Bradbury create a world that develops our understanding of people and ideas?", "x0": 0.11978021978021978, "y0": 0.5501165501165501, "x1": 0.8384615384615385, "y1": 0.5633255633255633}, {"text": "In your response, make reference to the excerpt and to your prescribed text.", "x0": 0.11978021978021978, "y0": 0.5835275835275835, "x1": 0.7318681318681318, "y1": 0.5967365967365967}, {"text": "OR", "x0": 0.4846153846153846, "y0": 0.6254856254856255, "x1": 0.5142857142857142, "y1": 0.6355866355866356}, {"text": "Question 2 (b) \u2014 Prose Fiction - Jhumpa Lahiri, The Namesake (20 marks)", "x0": 0.11978021978021978, "y0": 0.6674436674436675, "x1": 0.7670329670329671, "y1": 0.6806526806526807}, {"text": "Gogol listens, stunned, his eyes fixed on his father\u2019s profile. Though there are", "x0": 0.1912087912087912, "y0": 0.696969696969697, "x1": 0.8087912087912088, "y1": 0.7101787101787101}, {"text": "only inches between them, for an instant his father is a stranger, a man who", "x0": 0.1912087912087912, "y0": 0.714063714063714, "x1": 0.8076923076923077, "y1": 0.7272727272727273}, {"text": "has kept a secret, has survived a tragedy, a man whose past he does not fully", "x0": 0.1912087912087912, "y0": 0.7303807303807304, "x1": 0.8076923076923077, "y1": 0.7435897435897436}, {"text": "know. A man who is vulnerable, who has suffered in an inconceivable way", "x0": 0.1912087912087912, "y0": 0.7474747474747475, "x1": 0.7934065934065934, "y1": 0.7599067599067599}, {"text": "He imagines his father, in his twenties as Gogol is now, sitting on a train", "x0": 0.1912087912087912, "y0": 0.7637917637917638, "x1": 0.7857142857142857, "y1": 0.777000777000777}, {"text": "Gogol had just been, reading a story ... Against instinct he tries to imagine", "x0": 0.1912087912087912, "y0": 0.7808857808857809, "x1": 0.8076923076923077, "y1": 0.7940947940947941}, {"text": "life without his father, a world in which his father does not exist.", "x0": 0.1912087912087912, "y0": 0.7972027972027972, "x1": 0.7164835164835165, "y1": 0.8096348096348096}, {"text": "\u00a9 Jhumpa Lah 2011. Reprinted with permission from Harper Colins Lt", "x0": 0.37142857142857144, "y0": 0.8158508158508159, "x1": 0.8054945054945055, "y1": 0.8251748251748252}, {"text": "How does Lahiri create a world that develops our understanding of people and ideas?", "x0": 0.11978021978021978, "y0": 0.8360528360528361, "x1": 0.8120879120879121, "y1": 0.8492618492618492}, {"text": "In your response, make reference to the excerpt and to your prescribed text.", "x0": 0.11978021978021978, "y0": 0.8694638694638694, "x1": 0.7318681318681318, "y1": 0.8826728826728827}, {"text": "OR", "x0": 0.4846153846153846, "y0": 0.9075369075369075, "x1": 0.5142857142857142, "y1": 0.9176379176379177}], [{"text": "Question 2 (c) \u2014 Poetry - Emma Jones, The Striped World (20 marks)", "x0": 0.11978021978021978, "y0": 0.08158508158508158, "x1": 0.7175824175824176, "y1": 0.0947940947940948}, {"text": "Waking (excerpt)", "x0": 0.2868131868131868, "y0": 0.11188811188811189, "x1": 0.4307692307692308, "y1": 0.1250971250971251}, {"text": "For twenty-five years I\u2019ve been waking", "x0": 0.2868131868131868, "y0": 0.1452991452991453, "x1": 0.6054945054945055, "y1": 0.1585081585081585}, {"text": "this way. There was one morning", "x0": 0.2857142857142857, "y0": 0.1623931623931624, "x1": 0.5560439560439561, "y1": 0.17560217560217561}, {"text": "when my mother woke and felt a twitch", "x0": 0.2857142857142857, "y0": 0.1958041958041958, "x1": 0.6087912087912087, "y1": 0.20901320901320902}, {"text": "inside, like the shifting of curtains.", "x0": 0.2868131868131868, "y0": 0.21212121212121213, "x1": 0.567032967032967, "y1": 0.22533022533022534}, {"text": "She woke and so did I. I was like a bird", "x0": 0.2868131868131868, "y0": 0.24553224553224554, "x1": 0.6087912087912087, "y1": 0.2556332556332556}, {"text": "beating. She had no time for anaesthetic.", "x0": 0.2857142857142857, "y0": 0.2618492618492618, "x1": 0.6153846153846154, "y1": 0.27505827505827507}, {"text": "We just rolled from each other like indecent genies.", "x0": 0.2868131868131868, "y0": 0.29526029526029524, "x1": 0.7043956043956044, "y1": 0.3084693084693085}, {"text": "Even the nurses were startled.", "x0": 0.2868131868131868, "y0": 0.3123543123543124, "x1": 0.5274725274725275, "y1": 0.32245532245532244}, {"text": "Now she says the world and I were eager", "x0": 0.2868131868131868, "y0": 0.3457653457653458, "x1": 0.6208791208791209, "y1": 0.358974358974359}, {"text": "from the start. But 1 was only waking.", "x0": 0.2868131868131868, "y0": 0.3620823620823621, "x1": 0.5934065934065934, "y1": 0.3752913752913753}, {"text": "The Striped World by Emma Jones,", "x0": 0.4967032967032967, "y0": 0.3822843822843823, "x1": 0.7065934065934066, "y1": 0.3916083916083916}, {"text": "Reproduced by permission of Faber and Faber Lid", "x0": 0.4087912087912088, "y0": 0.3939393939393939, "x1": 0.7076923076923077, "y1": 0.40326340326340326}, {"text": "How does Jones create a world that develops our understanding of people and ideas?", "x0": 0.11978021978021978, "y0": 0.4289044289044289, "x1": 0.8076923076923077, "y1": 0.4421134421134421}, {"text": "In your response, make reference to the excerpt and to your prescribed text.", "x0": 0.11978021978021978, "y0": 0.46231546231546233, "x1": 0.7318681318681318, "y1": 0.4755244755244755}, {"text": "The prescribed poems are:", "x0": 0.11868131868131868, "y0": 0.49572649572649574, "x1": 0.33186813186813185, "y1": 0.508935508935509}, {"text": "* Waking", "x0": 0.11978021978021978, "y0": 0.519036519036519, "x1": 0.2032967032967033, "y1": 0.5322455322455323}, {"text": "eee REE", "x0": 0.11978021978021978, "y0": 0.5361305361305362, "x1": 0.12747252747252746, "y1": 0.6254856254856255}, {"text": "Farming", "x0": 0.14285714285714285, "y0": 0.5369075369075369, "x1": 0.21208791208791208, "y1": 0.5493395493395493}, {"text": "Tiger in the Menagerie", "x0": 0.14395604395604394, "y0": 0.5532245532245532, "x1": 0.32967032967032966, "y1": 0.5656565656565656}, {"text": "Window", "x0": 0.14395604395604394, "y0": 0.5687645687645687, "x1": 0.2076923076923077, "y1": 0.5788655788655789}, {"text": "Equator", "x0": 0.14285714285714285, "y0": 0.5866355866355867, "x1": 0.2087912087912088, "y1": 0.5990675990675991}, {"text": "Hush", "x0": 0.14285714285714285, "y0": 0.6021756021756022, "x1": 0.18461538461538463, "y1": 0.6122766122766122}, {"text": "Painted Tigers", "x0": 0.14285714285714285, "y0": 0.6192696192696193, "x1": 0.26153846153846155, "y1": 0.6324786324786325}, {"text": "OR", "x0": 0.4846153846153846, "y0": 0.6612276612276612, "x1": 0.5142857142857142, "y1": 0.6713286713286714}], [{"text": "Question 2 (d) \u2014 Drama - Michael Gow, Away (20 marks)", "x0": 0.11978021978021978, "y0": 0.08158508158508158, "x1": 0.6197802197802198, "y1": 0.0947940947940948}, {"text": "Act Four, Scene One", "x0": 0.21318681318681318, "y0": 0.11266511266511267, "x1": 0.3824175824175824, "y1": 0.12354312354312354}, {"text": "Jim: ... After that storm we salvaged what we could and dried it out.", "x0": 0.21428571428571427, "y0": 0.14063714063714064, "x1": 0.7835164835164835, "y1": 0.15384615384615385}, {"text": "We thought we'd just go straight home ... We drove all day", "x0": 0.26263736263736265, "y0": 0.15695415695415696, "x1": 0.7846153846153846, "y1": 0.17016317016317017}, {"text": "yesterday and we were getting pretty hot and tired and the girl", "x0": 0.26263736263736265, "y0": 0.17404817404817405, "x1": 0.7835164835164835, "y1": 0.18725718725718726}, {"text": "suddenly pointed at a road sign and said we had to turn off the", "x0": 0.26263736263736265, "y0": 0.18181818181818182, "x1": 0.7846153846153846, "y1": 0.20823620823620823}, {"text": "highway. She really wanted us to, kept insisting, So I tuned the", "x0": 0.26263736263736265, "y0": 0.20745920745920746, "x1": 0.7846153846153846, "y1": 0.22066822066822067}, {"text": "car around and drove back to the road sign and turned off down", "x0": 0.26263736263736265, "y0": 0.22377622377622378, "x1": 0.7846153846153846, "y1": 0.236985236985237}, {"text": "the dirt road. And when we came up over the last hill and saw the", "x0": 0.26263736263736265, "y0": 0.24087024087024086, "x1": 0.7846153846153846, "y1": 0.2540792540792541}, {"text": "beach ...", "x0": 0.26153846153846155, "y0": 0.2571872571872572, "x1": 0.33296703296703295, "y1": 0.26728826728826727}, {"text": "This extract from Away \u00a9 Michael Gow is reproduced", "x0": 0.46703296703296704, "y0": 0.2703962703962704, "x1": 0.7813186813186813, "y1": 0.27972027972027974}, {"text": "with the permission of the publisher, Currency Press", "x0": 0.4725274725274725, "y0": 0.28205128205128205, "x1": 0.7813186813186813, "y1": 0.2913752913752914}, {"text": "How does Gow create a world that develops our understanding of people and ideas?", "x0": 0.11978021978021978, "y0": 0.3061383061383061, "x1": 0.8021978021978022, "y1": 0.31934731934731936}, {"text": "In your response, make close reference to the excerpt and to your prescribed text.", "x0": 0.11978021978021978, "y0": 0.32944832944832947, "x1": 0.7791208791208791, "y1": 0.34265734265734266}, {"text": "OR", "x0": 0.4846153846153846, "y0": 0.3714063714063714, "x1": 0.5142857142857142, "y1": 0.3815073815073815}, {"text": "Question 2 (e) \u2014 Drama - Scott Rankin, Namatjira (20 marks)", "x0": 0.11978021978021978, "y0": 0.4125874125874126, "x1": 0.6538461538461539, "y1": 0.4257964257964258}, {"text": "Act Two, Scene Eight", "x0": 0.21318681318681318, "y0": 0.44366744366744365, "x1": 0.3879120879120879, "y1": 0.4560994560994561}, {"text": "Trevor: In the 1930s Rex and his fianc\u00e9e Bernice live at the", "x0": 0.21428571428571427, "y0": 0.4716394716394716, "x1": 0.7846153846153846, "y1": 0.48174048174048173}, {"text": "mission. The art is going well. Soon to be married in", "x0": 0.3098901098901099, "y0": 0.48795648795648794, "x1": 0.7846153846153846, "y1": 0.5011655011655012}, {"text": "the little white stone chapel. Albert is away painting his", "x0": 0.3098901098901099, "y0": 0.5050505050505051, "x1": 0.7846153846153846, "y1": 0.5182595182595182}, {"text": "country \u2014 beautiful Palm Valley. Big desert rains fall, lush", "x0": 0.3098901098901099, "y0": 0.5213675213675214, "x1": 0.7846153846153846, "y1": 0.5345765345765345}, {"text": "and green, rockpools fill and flow. This is his mother\u2019s", "x0": 0.3098901098901099, "y0": 0.5384615384615384, "x1": 0.7846153846153846, "y1": 0.5516705516705517}, {"text": "country, he\u2019s responsible for this place he loves.", "x0": 0.3098901098901099, "y0": 0.5547785547785548, "x1": 0.7, "y1": 0.567987567987568}, {"text": "And these are the crossover days, Albert has his tjaarta.", "x0": 0.3098901098901099, "y0": 0.5835275835275835, "x1": 0.7835164835164835, "y1": 0.5967365967365967}, {"text": "[We see him with a hunting spear.] His merra. [He shows", "x0": 0.310989010989011, "y0": 0.5998445998445998, "x1": 0.7846153846153846, "y1": 0.6130536130536131}, {"text": "his spear-thrower.] His urlpurrinya. He hunts and paints", "x0": 0.3098901098901099, "y0": 0.616938616938617, "x1": 0.7846153846153846, "y1": 0.6301476301476302}, {"text": "his country.", "x0": 0.3098901098901099, "y0": 0.6332556332556333, "x1": 0.4032967032967033, "y1": 0.6464646464646465}, {"text": "This extract from Namatjra \u00a9 Scott Rankin is reproduced", "x0": 0.44395604395604393, "y0": 0.6472416472416472, "x1": 0.7824175824175824, "y1": 0.6565656565656566}, {"text": "with the permission of the publisher, Currency Press", "x0": 0.4736263736263736, "y0": 0.6588966588966589, "x1": 0.7824175824175824, "y1": 0.6682206682206682}, {"text": "How does Rankin create a world that develops our understanding of people and ideas?", "x0": 0.11978021978021978, "y0": 0.6736596736596736, "x1": 0.8208791208791208, "y1": 0.7000777000777001}, {"text": "In your response, make reference to the excerpt and to your prescribed text.", "x0": 0.11978021978021978, "y0": 0.7070707070707071, "x1": 0.7318681318681318, "y1": 0.7202797202797203}, {"text": "OR", "x0": 0.4846153846153846, "y0": 0.749028749028749, "x1": 0.5142857142857142, "y1": 0.7591297591297591}], [{"text": "Question 2 (f) \u2014 Nonfiction - Raymond Gaita, Romulus, My Father (20 marks)", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.7967032967032966, "y1": 0.0947940947940948}, {"text": "Though the landscape is one of rare beauty, to a European or English eye", "x0": 0.1901098901098901, "y0": 0.11188811188811189, "x1": 0.8087912087912088, "y1": 0.1250971250971251}, {"text": "it seems desolate, and even after more than forty years my father could", "x0": 0.1912087912087912, "y0": 0.128982128982129, "x1": 0.8087912087912088, "y1": 0.14219114219114218}, {"text": "not become reconciled to it. He longed for the generous and soft European", "x0": 0.1901098901098901, "y0": 0.1452991452991453, "x1": 0.8087912087912088, "y1": 0.1585081585081585}, {"text": "foliage, but the eucalypts of Baringhup, scraggy except for the noble red", "x0": 0.1912087912087912, "y0": 0.1623931623931624, "x1": 0.8087912087912088, "y1": 0.17560217560217561}, {"text": "gums on the river bank, seemed symbols of deprivation and barrenness. In", "x0": 0.1901098901098901, "y0": 0.17871017871017872, "x1": 0.8087912087912088, "y1": 0.1919191919191919}, {"text": "this he was typical of many of the immigrants whose eyes looked directly to", "x0": 0.1901098901098901, "y0": 0.1958041958041958, "x1": 0.8087912087912088, "y1": 0.20901320901320902}, {"text": "the foliage and always turned away offended. Even the wonderful summer", "x0": 0.1901098901098901, "y0": 0.21212121212121213, "x1": 0.8087912087912088, "y1": 0.22533022533022534}, {"text": "smell of eucalyptus attracted them only because it promised usefiul oil.", "x0": 0.1912087912087912, "y0": 0.22843822843822845, "x1": 0.7615384615384615, "y1": 0.24164724164724163}, {"text": "{\u00a9 Reimond Gita, Romulus My Father, Published by The Text Publishing Company", "x0": 0.31978021978021975, "y0": 0.23620823620823622, "x1": 0.8164835164835165, "y1": 0.26262626262626265}, {"text": "How does Gaita create a world that develops our understanding of people and ideas?", "x0": 0.11868131868131868, "y0": 0.2773892773892774, "x1": 0.8065934065934066, "y1": 0.2905982905982906}, {"text": "In your response, make reference to the excerpt and to your prescribed text.", "x0": 0.11868131868131868, "y0": 0.3108003108003108, "x1": 0.7318681318681318, "y1": 0.32400932400932403}, {"text": "OR", "x0": 0.4846153846153846, "y0": 0.35275835275835277, "x1": 0.5142857142857142, "y1": 0.36363636363636365}, {"text": "Question 2 (g) \u2014 Film - Peter Weir, The Truman Show (20 marks)", "x0": 0.11868131868131868, "y0": 0.3947163947163947, "x1": 0.6901098901098901, "y1": 0.40792540792540793}, {"text": "How does Weir create a world that develops our understanding of people and ideas?", "x0": 0.11868131868131868, "y0": 0.8174048174048174, "x1": 0.8032967032967033, "y1": 0.8306138306138307}, {"text": "In your response, make reference to the screenshots and to your prescribed text.", "x0": 0.11868131868131868, "y0": 0.8508158508158508, "x1": 0.765934065934066, "y1": 0.864024864024864}, {"text": "OR", "x0": 0.4846153846153846, "y0": 0.8927738927738927, "x1": 0.5142857142857142, "y1": 0.9036519036519036}, {"text": "Please turn over", "x0": 0.42967032967032964, "y0": 0.9222999222999223, "x1": 0.5703296703296703, "y1": 0.9331779331779332}], [{"text": "Question 2 (h) \u2014 Media - Lucy Walker, Waste Land (20 marks)", "x0": 0.11978021978021978, "y0": 0.08158508158508158, "x1": 0.6659340659340659, "y1": 0.0947940947940948}, {"text": "\u00a9 Lucy Walker, Waste Land.", "x0": 0.5417582417582417, "y0": 0.5532245532245532, "x1": 0.7329670329670329, "y1": 0.5633255633255633}, {"text": "Reproduced with kind permission of Almega Projects Ltd", "x0": 0.35604395604395606, "y0": 0.5664335664335665, "x1": 0.7329670329670329, "y1": 0.5765345765345765}, {"text": "How does Walker create a world that develops our understanding of people and ideas?", "x0": 0.11978021978021978, "y0": 0.6107226107226107, "x1": 0.8197802197802198, "y1": 0.6239316239316239}, {"text": "In your response, make close reference to the screenshots and your prescribed text.", "x0": 0.11978021978021978, "y0": 0.6441336441336442, "x1": 0.7912087912087912, "y1": 0.6573426573426573}, {"text": "End of paper", "x0": 0.44285714285714284, "y0": 0.7086247086247086, "x1": 0.5560439560439561, "y1": 0.7218337218337219}, {"text": "(\u00a9 2021 NSW Edueation Standards Authority", "x0": 0.3824175824175824, "y0": 0.9673659673659674, "x1": 0.6164835164835165, "y1": 0.9751359751359752}]]