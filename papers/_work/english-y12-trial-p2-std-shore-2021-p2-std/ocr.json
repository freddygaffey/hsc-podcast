[[{"text": "SHORE", "x0": 0.2032967032967033, "y0": 0.09557109557109557, "x1": 0.421978021978022, "y1": 0.13131313131313133}, {"text": "Exam Number:", "x0": 0.5846153846153846, "y0": 0.1111111111111111, "x1": 0.7186813186813187, "y1": 0.12121212121212122}, {"text": "Year 12", "x0": 0.0956043956043956, "y0": 0.21445221445221446, "x1": 0.1945054945054945, "y1": 0.22999222999222999}, {"text": "English (Standard) Course", "x0": 0.0956043956043956, "y0": 0.2463092463092463, "x1": 0.4582417582417582, "y1": 0.26728826728826727}, {"text": "HSC Trial Examination", "x0": 0.0956043956043956, "y0": 0.27816627816627815, "x1": 0.4164835164835165, "y1": 0.29448329448329447}, {"text": "Paper 2 - Modules", "x0": 0.0956043956043956, "y0": 0.31002331002331, "x1": 0.34835164835164834, "y1": 0.331002331002331}, {"text": "2021", "x0": 0.0956043956043956, "y0": 0.34265734265734266, "x1": 0.15494505494505495, "y1": 0.3581973581973582}, {"text": "General instructions", "x0": 0.1054945054945055, "y0": 0.3916083916083916, "x1": 0.27582417582417584, "y1": 0.40093240093240096}, {"text": "Total marks \u2014 60", "x0": 0.5186813186813187, "y0": 0.3923853923853924, "x1": 0.6637362637362637, "y1": 0.4017094017094017}, {"text": "\u00a9 Reading time \u2014 10 minutes", "x0": 0.1054945054945055, "y0": 0.4172494172494173, "x1": 0.34175824175824177, "y1": 0.43045843045843046}, {"text": "\u00a9 Working time \u2014 1 hour and 30 minutes", "x0": 0.1054945054945055, "y0": 0.4421134421134421, "x1": 0.43736263736263736, "y1": 0.4553224553224553}, {"text": "Page 3", "x0": 0.6879120879120879, "y0": 0.44755244755244755, "x1": 0.7417582417582418, "y1": 0.45998445998445997}, {"text": "\u00a9 Write using black pen", "x0": 0.1054945054945055, "y0": 0.4700854700854701, "x1": 0.3032967032967033, "y1": 0.48329448329448327}, {"text": "20 marks", "x0": 0.5186813186813187, "y0": 0.47086247086247085, "x1": 0.5967032967032967, "y1": 0.4801864801864802}, {"text": "\u00a9 Attempt Question 1", "x0": 0.5186813186813187, "y0": 0.494949494949495, "x1": 0.7032967032967034, "y1": 0.5081585081585082}, {"text": "Allow about 40 minutes for this section", "x0": 0.5483516483516484, "y0": 0.519036519036519, "x1": 0.865934065934066, "y1": 0.5291375291375291}, {"text": "Page 4", "x0": 0.6901098901098901, "y0": 0.5695415695415695, "x1": 0.7450549450549451, "y1": 0.581973581973582}, {"text": "20 marks", "x0": 0.5186813186813187, "y0": 0.5928515928515928, "x1": 0.5967032967032967, "y1": 0.6021756021756022}, {"text": "\u00a9 Attempt Question 2", "x0": 0.5186813186813187, "y0": 0.616938616938617, "x1": 0.7054945054945055, "y1": 0.6301476301476302}, {"text": "Allow about 40 minutes for this section", "x0": 0.5483516483516484, "y0": 0.6418026418026418, "x1": 0.8967032967032967, "y1": 0.6519036519036518}, {"text": "Page 5", "x0": 0.6901098901098901, "y0": 0.6930846930846931, "x1": 0.7450549450549451, "y1": 0.7055167055167055}, {"text": "20 marks", "x0": 0.5186813186813187, "y0": 0.7163947163947164, "x1": 0.5967032967032967, "y1": 0.7257187257187258}, {"text": "\u00a9 Attempt Question 3", "x0": 0.5186813186813187, "y0": 0.7404817404817405, "x1": 0.7054945054945055, "y1": 0.7536907536907537}, {"text": "Allow about 40 minutes for this section", "x0": 0.5186813186813187, "y0": 0.7653457653457654, "x1": 0.8670329670329671, "y1": 0.7754467754467754}, {"text": "Note: Any time you have remaining should be spent revising your answers.", "x0": 0.17912087912087912, "y0": 0.8251748251748252, "x1": 0.8527472527472527, "y1": 0.8391608391608392}, {"text": "DO NOT REMOVE THIS PAPER FROM THE EXAMINATION ROOM", "x0": 0.13296703296703297, "y0": 0.8523698523698524, "x1": 0.9, "y1": 0.8648018648018648}], [{"text": "BLANK PAGE.", "x0": 0.43736263736263736, "y0": 0.3978243978243978, "x1": 0.5626373626373626, "y1": 0.40714840714840717}], [{"text": "Section I - Module A: Language, Identity and Culture", "x0": 0.0956043956043956, "y0": 0.06993006993006994, "x1": 0.5340659340659341, "y1": 0.08313908313908314}, {"text": "20 marks", "x0": 0.0956043956043956, "y0": 0.08624708624708624, "x1": 0.16813186813186815, "y1": 0.0947940947940948}, {"text": "Attempt Question 1", "x0": 0.0945054945054945, "y0": 0.10023310023310024, "x1": 0.25384615384615383, "y1": 0.11266511266511267}, {"text": "Allow about 40 minutes for this section", "x0": 0.0945054945054945, "y0": 0.11577311577311578, "x1": 0.41208791208791207, "y1": 0.1250971250971251}, {"text": "Answer the question in a SEPARATE writing booklet.", "x0": 0.0956043956043956, "y0": 0.13131313131313133, "x1": 0.5032967032967033, "y1": 0.1445221445221445}, {"text": "Your answers will be as", "x0": 0.0956043956043956, "y0": 0.16317016317016317, "x1": 0.2714285714285714, "y1": 0.17249417249417248}, {"text": "sed on how well you:", "x0": 0.3021978021978022, "y0": 0.16317016317016317, "x1": 0.46593406593406594, "y1": 0.17637917637917638}, {"text": "\u00a9 demonstrate understanding of how ide:", "x0": 0.12637362637362637, "y0": 0.18104118104118105, "x1": 0.45714285714285713, "y1": 0.19425019425019424}, {"text": "bout language, identity and culture are expressed", "x0": 0.4868131868131868, "y0": 0.18104118104118105, "x1": 0.8637362637362638, "y1": 0.19425019425019424}, {"text": "through texts", "x0": 0.15604395604395604, "y0": 0.19735819735819735, "x1": 0.25824175824175827, "y1": 0.21056721056721056}, {"text": "\u00a9 demonstrate understanding of how language is used to shape meaning about individuals and/or", "x0": 0.12637362637362637, "y0": 0.21445221445221446, "x1": 0.9010989010989011, "y1": 0.22843822843822845}, {"text": "cultural groups", "x0": 0.15604395604395604, "y0": 0.23154623154623155, "x1": 0.2714285714285714, "y1": 0.24475524475524477}, {"text": "\u00a9 organise, develop and express your ideas using language appropriate to audience, purpose and", "x0": 0.12637362637362637, "y0": 0.2494172494172494, "x1": 0.8857142857142857, "y1": 0.26262626262626265}, {"text": "form", "x0": 0.15714285714285714, "y0": 0.26573426573426573, "x1": 0.1934065934065934, "y1": 0.27505827505827507}, {"text": "Question 1 (20 marks)", "x0": 0.0956043956043956, "y0": 0.31313131313131315, "x1": 0.27362637362637365, "y1": 0.32556332556332557}, {"text": "Examine how the dramatic form of George Bernard Shaw's Pygmalion is used to present messages about the", "x0": 0.0956043956043956, "y0": 0.35586635586635584, "x1": 0.9439560439560439, "y1": 0.3690753690753691}, {"text": "connections between Language, Identity and Culture.", "x0": 0.0956043956043956, "y0": 0.37373737373737376, "x1": 0.5087912087912088, "y1": 0.38694638694638694}, {"text": "\u2018The prescribed text is:", "x0": 0.0956043956043956, "y0": 0.41647241647241645, "x1": 0.26703296703296703, "y1": 0.4296814296814297}, {"text": "\u00a9 Drama \u2014 Shaw, George Bernard, Pygmalion", "x0": 0.12637362637362637, "y0": 0.44522144522144524, "x1": 0.4857142857142857, "y1": 0.45843045843045843}, {"text": "End of Question 1", "x0": 0.4230769230769231, "y0": 0.8741258741258742, "x1": 0.5758241758241758, "y1": 0.8857808857808858}], [{"text": "Section II - Module B: Close Study of Literature", "x0": 0.0956043956043956, "y0": 0.06993006993006994, "x1": 0.4879120879120879, "y1": 0.08236208236208237}, {"text": "20 marks", "x0": 0.0956043956043956, "y0": 0.08624708624708624, "x1": 0.16813186813186815, "y1": 0.0947940947940948}, {"text": "Attempt Question 2", "x0": 0.0945054945054945, "y0": 0.10023310023310024, "x1": 0.256043956043956, "y1": 0.11266511266511267}, {"text": "Allow about 40 minutes for this section", "x0": 0.0945054945054945, "y0": 0.11577311577311578, "x1": 0.41208791208791207, "y1": 0.1250971250971251}, {"text": "Answer the question in a SEPARATE writing booklet.", "x0": 0.0956043956043956, "y0": 0.13131313131313133, "x1": 0.5032967032967033, "y1": 0.1445221445221445}, {"text": "Your answer will be assessed on how well you:", "x0": 0.0956043956043956, "y0": 0.16161616161616163, "x1": 0.44285714285714284, "y1": 0.17249417249417248}, {"text": "\u00a9 demonstrate understanding of a text's distinctive qualities and how these shape meaning", "x0": 0.12637362637362637, "y0": 0.1794871794871795, "x1": 0.8131868131868132, "y1": 0.1926961926961927}, {"text": "\u00a9 organise, develop and express ideas using language appropriate to audience, purpose and form.", "x0": 0.12637362637362637, "y0": 0.1989121989121989, "x1": 0.8626373626373627, "y1": 0.21212121212121213}, {"text": "Question 2 (20 marks)", "x0": 0.0956043956043956, "y0": 0.24553224553224554, "x1": 0.27472527472527475, "y1": 0.257964257964258}, {"text": "Mark Haddon\u2019s The Curious Incident Of The Dog In The Night-Time explores the motivations and choices of", "x0": 0.0956043956043956, "y0": 0.27816627816627815, "x1": 0.9054945054945055, "y1": 0.2913752913752914}, {"text": "individuals still learning to understand themselves and others.", "x0": 0.0956043956043956, "y0": 0.2937062937062937, "x1": 0.5725274725274725, "y1": 0.30691530691530694}, {"text": "Discuss this statement making detailed reference to your prescribed text.", "x0": 0.0956043956043956, "y0": 0.32634032634032634, "x1": 0.6593406593406593, "y1": 0.3395493395493395}, {"text": "\u2018The prescribed text is:", "x0": 0.0956043956043956, "y0": 0.37373737373737376, "x1": 0.26703296703296703, "y1": 0.38694638694638694}, {"text": "Fiction \u2014 Haddon, Mark, The Curious Incident of the Dog in the Night-Time", "x0": 0.15604395604395604, "y0": 0.40792540792540793, "x1": 0.701098901098901, "y1": 0.4211344211344211}, {"text": "End of Question 2", "x0": 0.421978021978022, "y0": 0.8725718725718725, "x1": 0.5769230769230769, "y1": 0.8842268842268842}], [{"text": "Section III - Module C: The Craft of Writing", "x0": 0.0956043956043956, "y0": 0.06993006993006994, "x1": 0.4593406593406593, "y1": 0.08236208236208237}, {"text": "20 marks", "x0": 0.0956043956043956, "y0": 0.08624708624708624, "x1": 0.16813186813186815, "y1": 0.0947940947940948}, {"text": "Attempt Question 3", "x0": 0.0945054945054945, "y0": 0.10023310023310024, "x1": 0.256043956043956, "y1": 0.11266511266511267}, {"text": "Allow about 40 minutes for this section", "x0": 0.0945054945054945, "y0": 0.11577311577311578, "x1": 0.41208791208791207, "y1": 0.1250971250971251}, {"text": "Answer the question in a SEPARATE writing booklet.", "x0": 0.0956043956043956, "y0": 0.13131313131313133, "x1": 0.5032967032967033, "y1": 0.1445221445221445}, {"text": "Your answer will be assessed on how well you:", "x0": 0.0956043956043956, "y0": 0.16161616161616163, "x1": 0.44285714285714284, "y1": 0.17249417249417248}, {"text": "\u00a9 craft language to address the demands of the question", "x0": 0.12637362637362637, "y0": 0.1794871794871795, "x1": 0.5571428571428572, "y1": 0.1926961926961927}, {"text": "\u00a9 use language appropriate to audience, purpose and context to deliberately shape meaning.", "x0": 0.12637362637362637, "y0": 0.19658119658119658, "x1": 0.8219780219780219, "y1": 0.2097902097902098}, {"text": "Question 3 (20 marks)", "x0": 0.0956043956043956, "y0": 0.24242424242424243, "x1": 0.26703296703296703, "y1": 0.25485625485625485}, {"text": "a) Referring to ONE character from a text you have studied in either Module A or Module 12", "x0": 0.1054945054945055, "y0": 0.2742812742812743, "x1": 0.8703296703296703, "y1": 0.2874902874902875}, {"text": "B, compose the opening of an imaginative, discursive or persuasive piece that explores a", "x0": 0.1043956043956044, "y0": 0.2828282828282828, "x1": 0.7912087912087912, "y1": 0.3076923076923077}, {"text": "significant realisation made by or about that character.", "x0": 0.1054945054945055, "y0": 0.30691530691530694, "x1": 0.5252747252747253, "y1": 0.3201243201243201}, {"text": "b) Evaluate at least ONE of your stylistic choices that most succ:", "x0": 0.1043956043956044, "y0": 0.33877233877233875, "x1": 0.6054945054945055, "y1": 0.351981351981352}, {"text": "ssfully conveys the 8", "x0": 0.6153846153846154, "y0": 0.33877233877233875, "x1": 0.865934065934066, "y1": 0.351981351981352}, {"text": "significant realisation explored in Part a).", "x0": 0.1054945054945055, "y0": 0.3543123543123543, "x1": 0.4208791208791209, "y1": 0.36752136752136755}, {"text": "End of Question 2", "x0": 0.421978021978022, "y0": 0.7871017871017871, "x1": 0.5769230769230769, "y1": 0.7987567987567987}, {"text": "End of Examination", "x0": 0.41318681318681316, "y0": 0.8834498834498834, "x1": 0.5857142857142857, "y1": 0.8927738927738927}], [{"text": "BLANK PAGE.", "x0": 0.43736263736263736, "y0": 0.5027195027195027, "x1": 0.5626373626373626, "y1": 0.5120435120435121}]]