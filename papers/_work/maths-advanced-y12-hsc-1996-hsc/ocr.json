317016317}, {"text": "xem", "x0": 0.3516483516483517, "y0": 0.3613053613053613, "x1": 0.3901098901098901, "y1": 0.3682983682983683}, {"text": "PORS is a rectangle with PQ = 6 cm and QR = 4m. T and U lie on the lines", "x0": 0.16703296703296702, "y0": 0.5470085470085471, "x1": 0.8087912087912088, "y1": 0.5718725718725719}, {"text": "SP and SR respectively, so that T, Q, and U are collinear, as shown in the", "x0": 0.16703296703296702, "y0": 0.5695415695415695, "x1": 0.8087912087912088, "y1": 0.5827505827505828}, {"text": "diagram. Let PT =x cm and RU=y cm.", "x0": 0.16703296703296702, "y0": 0.5835275835275835, "x1": 0.512087912087912, "y1": 0.5967365967365967}, {"text": "(i) Show that triangles TPQ and QRU are similar.", "x0": 0.18681318681318682, "y0": 0.6138306138306139, "x1": 0.5945054945054945, "y1": 0.6262626262626263}, {"text": "(ii) Show that xy = 24.", "x0": 0.1824175824175824, "y0": 0.6433566433566433, "x1": 0.3813186813186813, "y1": 0.655011655011655}, {"text": "(iii) Show that the area, A, of triangle TSU is given by", "x0": 0.17692307692307693, "y0": 0.6651126651126651, "x1": 0.6252747252747253, "y1": 0.6899766899766899}, {"text": "A=2443x438,", "x0": 0.3934065934065934, "y0": 0.6993006993006993, "x1": 0.5362637362637362, "y1": 0.7264957264957265}, {"text": "x", "x0": 0.5131868131868131, "y0": 0.7226107226107226, "x1": 0.5230769230769231, "y1": 0.7288267288267288}, {"text": "(iv) Find the height and base of the triangle TSU with minimum area. Justify", "x0": 0.17692307692307693, "y0": 0.7451437451437452, "x1": 0.8076923076923077, "y1": 0.7583527583527584}, {"text": "your answer.", "x0": 0.22747252747252747, "y0": 0.7622377622377622, "x1": 0.33076923076923076, "y1": 0.7723387723387724}], [{"text": "10", "x0": 0.49340659340659343, "y0": 0.03496503496503497, "x1": 0.5098901098901099, "y1": 0.04428904428904429}, {"text": "QUESTION 9. Use a separate Writing Booklet.", "x0": 0.11978021978021978, "y0": 0.06837606837606838, "x1": 0.5208791208791209, "y1": 0.08158