[[{"text": "GOVERNMENT", "x0": 0.12197802197802197, "y0": 0.1592851592851593, "x1": 0.22527472527472528, "y1": 0.16705516705516704}, {"text": "NSW Education Standards Authority", "x0": 0.11978021978021978, "y0": 0.19114219114219114, "x1": 0.4725274725274725, "y1": 0.20512820512820512}, {"text": "2024 | HIGHER SCHOOL CERTIFICATE EXAMINATION", "x0": 0.12747252747252746, "y0": 0.30691530691530694, "x1": 0.5868131868131868, "y1": 0.331002331002331}, {"text": "English as an Additional", "x0": 0.12307692307692308, "y0": 0.351981351981352, "x1": 0.6934065934065934, "y1": 0.38694638694638694}, {"text": "Language or Dialect (EAL/D)", "x0": 0.12307692307692308, "y0": 0.3962703962703963, "x1": 0.8054945054945055, "y1": 0.432012432012432}, {"text": "Paper 1", "x0": 0.12197802197802197, "y0": 0.4662004662004662, "x1": 0.24285714285714285, "y1": 0.49106449106449107}, {"text": "General + Reading time - 10 minutes", "x0": 0.11978021978021978, "y0": 0.5353535353535354, "x1": 0.5241758241758242, "y1": 0.5547785547785548}, {"text": "Instructions Working time 1 hour and 30 minutes", "x0": 0.11978021978021978, "y0": 0.5563325563325563, "x1": 0.6285714285714286, "y1": 0.5726495726495726}, {"text": "+ Write using black pen", "x0": 0.2681318681318681, "y0": 0.5804195804195804, "x1": 0.47802197802197804, "y1": 0.5936285936285937}, {"text": "Total marks: Section | - 30 marks (pages 2-7)", "x0": 0.11868131868131868, "y0": 0.6348096348096348, "x1": 0.5714285714285714, "y1": 0.6480186480186481}, {"text": "45 This section has two parts, Part A and Part B", "x0": 0.11868131868131868, "y0": 0.6526806526806527, "x1": 0.6747252747252748, "y1": 0.6721056721056721}, {"text": "Part A- 15 marks", "x0": 0.2681318681318681, "y0": 0.6798756798756799, "x1": 0.42857142857142855, "y1": 0.6899766899766899}, {"text": "+ Attempt Questions 1-4", "x0": 0.2681318681318681, "y0": 0.7016317016317016, "x1": 0.4901098901098901, "y1": 0.7148407148407149}, {"text": "+ Allow about 30 minutes for this part", "x0": 0.2681318681318681, "y0": 0.7226107226107226, "x1": 0.6054945054945055, "y1": 0.7358197358197358}, {"text": "Part B - 15 marks", "x0": 0.2681318681318681, "y0": 0.7435897435897436, "x1": 0.42857142857142855, "y1": 0.7536907536907537}, {"text": "+ Attempt Question 5", "x0": 0.2681318681318681, "y0": 0.7645687645687645, "x1": 0.4582417582417582, "y1": 0.7777777777777778}, {"text": "+ Allow about 30 minutes for this part", "x0": 0.2681318681318681, "y0": 0.7863247863247863, "x1": 0.6054945054945055, "y1": 0.7995337995337995}, {"text": "Section II - 15 marks (page 8)", "x0": 0.26703296703296703, "y0": 0.818958818958819, "x1": 0.5461538461538461, "y1": 0.8321678321678322}, {"text": "+ Attempt Question 6", "x0": 0.2681318681318681, "y0": 0.8438228438228438, "x1": 0.4593406593406593, "y1": 0.857031857031857}, {"text": "+ Allow about 30 minutes for this section", "x0": 0.2681318681318681, "y0": 0.8648018648018648, "x1": 0.6351648351648351, "y1": 0.8749028749028749}, {"text": "2080", "x0": 0.08131868131868132, "y0": 0.9463869463869464, "x1": 0.11758241758241758, "y1": 0.9549339549339549}], [{"text": "Section I \u2014 Module A: Texts and Human Experiences", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.667032967032967, "y1": 0.09712509712509712}, {"text": "30 marks", "x0": 0.11868131868131868, "y0": 0.10023310023310024, "x1": 0.1989010989010989, "y1": 0.1111111111111111}, {"text": "Part A - 15 marks", "x0": 0.11868131868131868, "y0": 0.1282051282051282, "x1": 0.27802197802197803, "y1": 0.1383061383061383}, {"text": "Attempt Questions 1-4", "x0": 0.11868131868131868, "y0": 0.1452991452991453, "x1": 0.31648351648351647, "y1": 0.1585081585081585}, {"text": "Allow about 30 minutes for this part", "x0": 0.11868131868131868, "y0": 0.16161616161616163, "x1": 0.4340659340659341, "y1": 0.17482517482517482}, {"text": "Examine Texts 1, 2, 3 and 4 carefully and then answer the questions in the Paper 1 Answer", "x0": 0.11868131868131868, "y0": 0.19036519036519037, "x1": 0.8802197802197802, "y1": 0.20357420357420358}, {"text": "Booklet.", "x0": 0.11868131868131868, "y0": 0.2066822066822067, "x1": 0.18681318681318682, "y1": 0.21756021756021757}, {"text": "Your answers will be assessed on how well you:", "x0": 0.14285714285714285, "y0": 0.22999222999222999, "x1": 0.5351648351648352, "y1": 0.2432012432012432}, {"text": "demonstrate understanding of human experiences in texts", "x0": 0.16593406593406593, "y0": 0.2501942501942502, "x1": 0.6318681318681318, "y1": 0.2634032634032634}, {"text": "\u00a9 demonstrate understanding of the ways language shapes and expresses perceptions", "x0": 0.14285714285714285, "y0": 0.2703962703962704, "x1": 0.8362637362637363, "y1": 0.2836052836052836}, {"text": "Text 1 \u2014 Visual text", "x0": 0.11868131868131868, "y0": 0.31002331002331, "x1": 0.2978021978021978, "y1": 0.3209013209013209}], [{"text": "Text 2 \u2014 Poem", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.25164835164835164, "y1": 0.09168609168609168}, {"text": "Lone Figure \u2014 Annaghmakerrig'!!", "x0": 0.24505494505494504, "y0": 0.13131313131313133, "x1": 0.5835164835164836, "y1": 0.14840714840714841}, {"text": "Down the hill I went", "x0": 0.24505494505494504, "y0": 0.17016317016317017, "x1": 0.41318681318681316, "y1": 0.18026418026418026}, {"text": "watching the weak outline of all things", "x0": 0.24615384615384617, "y0": 0.18725718725718726, "x1": 0.5604395604395604, "y1": 0.20046620046620048}, {"text": "inside a soft rain.", "x0": 0.24615384615384617, "y0": 0.20512820512820512, "x1": 0.38461538461538464, "y1": 0.21522921522921523}, {"text": "And in the distance came the lake\u2019s presence,", "x0": 0.3054945054945055, "y0": 0.24087024087024086, "x1": 0.6758241758241759, "y1": 0.2540792540792541}, {"text": "a kind of shimmer standing there like longing.", "x0": 0.24505494505494504, "y0": 0.25874125874125875, "x1": 0.6208791208791209, "y1": 0.27195027195027194}, {"text": "And in the", "x0": 0.3054945054945055, "y0": 0.29526029526029524, "x1": 0.3912087912087912, "y1": 0.3045843045843046}, {"text": "small movement approached me.", "x0": 0.4835164835164835, "y0": 0.29526029526029524, "x1": 0.7505494505494505, "y1": 0.3076923076923077}, {"text": "It scuttled in patches of light", "x0": 0.24615384615384617, "y0": 0.33022533022533024, "x1": 0.47692307692307695, "y1": 0.3434343434343434}, {"text": "and when it reached me it was eager for touch.", "x0": 0.24505494505494504, "y0": 0.3480963480963481, "x1": 0.6252747252747253, "y1": 0.3613053613053613}, {"text": "A black and white cat, we made polite conversation", "x0": 0.24065934065934066, "y0": 0.3628593628593629, "x1": 0.6648351648351648, "y1": 0.38306138306138304}, {"text": "then went our separate ways.", "x0": 0.24615384615384617, "y0": 0.38461538461538464, "x1": 0.47912087912087914, "y1": 0.39704739704739705}, {"text": "And when I reached the lake", "x0": 0.3054945054945055, "y0": 0.4156954156954157, "x1": 0.5384615384615384, "y1": 0.4358974358974359}, {"text": "the night had become all but dripping trees.", "x0": 0.24615384615384617, "y0": 0.4366744366744367, "x1": 0.5978021978021978, "y1": 0.44988344988344986}, {"text": "And I stood underneath these tears", "x0": 0.3054945054945055, "y0": 0.4731934731934732, "x1": 0.5857142857142857, "y1": 0.4825174825174825}, {"text": "trying to make sense of something.", "x0": 0.24615384615384617, "y0": 0.4902874902874903, "x1": 0.5285714285714286, "y1": 0.5034965034965035}, {"text": "I listened hard, listened to the soft edges of the water", "x0": 0.24615384615384617, "y0": 0.526029526029526, "x1": 0.6758241758241759, "y1": 0.5392385392385393}, {"text": "move inside a sway so like", "x0": 0.24505494505494504, "y0": 0.5439005439005439, "x1": 0.46373626373626375, "y1": 0.5571095571095571}, {"text": "And I thought of water spirits rising,", "x0": 0.3054945054945055, "y0": 0.5796425796425796, "x1": 0.6032967032967033, "y1": 0.5928515928515928}, {"text": "of leaves dripping and a lake lapping.", "x0": 0.24505494505494504, "y0": 0.5975135975135976, "x1": 0.5505494505494506, "y1": 0.6107226107226107}, {"text": "I looked out towards O\u2019Hanlon\u2019s Hill", "x0": 0.24615384615384617, "y0": 0.6324786324786325, "x1": 0.5494505494505495, "y1": 0.6425796425796426}, {"text": "and the world felt very small", "x0": 0.24505494505494504, "y0": 0.6503496503496503, "x1": 0.47802197802197804, "y1": 0.6635586635586636}, {"text": "as if I could put it in my pocket,", "x0": 0.24505494505494504, "y0": 0.6651126651126651, "x1": 0.5065934065934066, "y1": 0.6845376845376845}, {"text": "tub it like a polished stone.", "x0": 0.24505494505494504, "y0": 0.6860916860916861, "x1": 0.46483516483516485, "y1": 0.6993006993006993}, {"text": "Lippy HART", "x0": 0.656043956043956, "y0": 0.7226107226107226, "x1": 0.7538461538461538, "y1": 0.7319347319347319}, {"text": "\u00a9 Libby Hart, poet", "x0": 0.6428571428571429, "y0": 0.7474747474747475, "x1": 0.7516483516483516, "y1": 0.7567987567987567}, {"text": "(1 Annaghmakerrig A centre for creative artists near a lake", "x0": 0.24615384615384617, "y0": 0.7754467754467754, "x1": 0.6901098901098901, "y1": 0.7871017871017871}, {"text": "21 vocation sense of purpose", "x0": 0.24615384615384617, "y0": 0.7925407925407926, "x1": 0.5351648351648352, "y1": 0.804972804972805}], [{"text": "Text 3 \u2014 Fiction extract", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.33076923076923076, "y1": 0.09246309246309246}, {"text": "Later that night at dinner, Antonia chews slowly, hardly tasting her food. The", "x0": 0.1813186813186813, "y0": 0.13286713286713286, "x1": 0.8175824175824176, "y1": 0.14607614607614608}, {"text": "cacophony\"! of Sunday surrounds her, but Antonia retreats into her chair,", "x0": 0.1813186813186813, "y0": 0.14763014763014762, "x1": 0.8186813186813187, "y1": 0.16394716394716394}, {"text": "making herself as inconspicuous!\u201d! as possible ... Antonia is anonymous, sure.", "x0": 0.1813186813186813, "y0": 0.1655011655011655, "x1": 0.8175824175824176, "y1": 0.18104118104118105}, {"text": "She sees fewer kids from their old school than she would expect ... She and", "x0": 0.1813186813186813, "y0": 0.1857031857031857, "x1": 0.8175824175824176, "y1": 0.1989121989121989}, {"text": "Sofia have no classes together, and this has never happened before. Without", "x0": 0.1813186813186813, "y0": 0.20357420357420358, "x1": 0.8175824175824176, "y1": 0.21678321678321677}, {"text": "Sofia, Antonia has been disappointed to discover she is timid, and small, and", "x0": 0.1813186813186813, "y0": 0.22144522144522144, "x1": 0.8175824175824176, "y1": 0.23465423465423466}, {"text": "easily brushed past in the hallway ...", "x0": 0.1813186813186813, "y0": 0.23931623931623933, "x1": 0.48021978021978023, "y1": 0.25252525252525254}, {"text": "Sofia lies in bed that night and imagines that Antonia has met a new best friend.", "x0": 0.1813186813186813, "y0": 0.2742812742812743, "x1": 0.8175824175824176, "y1": 0.2874902874902875}, {"text": "In her imagination the other girl is taller than Sofia, and thinner, and has brighter", "x0": 0.1813186813186813, "y0": 0.29215229215229216, "x1": 0.8186813186813187, "y1": 0.30536130536130535}, {"text": "eyes. She is quieter and more contained. She does not lash out; she does not", "x0": 0.1813186813186813, "y0": 0.30924630924630925, "x1": 0.8175824175824176, "y1": 0.32245532245532244}, {"text": "lose her temper; she is more like Antonia. The Antonia in Sofia\u2019s imagination", "x0": 0.1813186813186813, "y0": 0.3271173271173271, "x1": 0.8175824175824176, "y1": 0.34032634032634035}, {"text": "is much happier with her new friend. She does not need Sofia anymore. The", "x0": 0.1813186813186813, "y0": 0.34498834498834496, "x1": 0.8175824175824176, "y1": 0.3581973581973582}, {"text": "two of them link arms and share the quiet secrets of confident friendships; they", "x0": 0.1813186813186813, "y0": 0.3628593628593629, "x1": 0.8175824175824176, "y1": 0.37606837606837606}, {"text": "laugh softly; their underarms never smell bitter and rotten. Sofia falls into a", "x0": 0.1813186813186813, "y0": 0.38073038073038074, "x1": 0.8175824175824176, "y1": 0.3939393939393939}, {"text": "restless, untethered!! sleep, and wakes the next morning feeling like she has", "x0": 0.1813186813186813, "y0": 0.3954933954933955, "x1": 0.8175824175824176, "y1": 0.41181041181041184}, {"text": "forgotten something terrible.", "x0": 0.1813186813186813, "y0": 0.41647241647241645, "x1": 0.41208791208791207, "y1": 0.4296814296814297}, {"text": "On her second Monday of high school Sofia does not ask Antonia what she", "x0": 0.2010989010989011, "y0": 0.45143745143745145, "x1": 0.8175824175824176, "y1": 0.46464646464646464}, {"text": "did that weekend and Antonia does not know how to tell her bright, beautiful", "x0": 0.1813186813186813, "y0": 0.46853146853146854, "x1": 0.8175824175824176, "y1": 0.48174048174048173}, {"text": "friend that she has been spending her Sundays at Lately, her papa\u2019s", "x0": 0.1813186813186813, "y0": 0.4864024864024864, "x1": 0.8175824175824176, "y1": 0.4996114996114996}, {"text": "features hover just on the edge of her memory, refusing to come into focus.", "x0": 0.1813186813186813, "y0": 0.5042735042735043, "x1": 0.7934065934065934, "y1": 0.5174825174825175}, {"text": "And so this year Sofia and Antonia keep their first secrets. They separate.", "x0": 0.2010989010989011, "y0": 0.5392385392385393, "x1": 0.8175824175824176, "y1": 0.5524475524475524}, {"text": "And in each of them something wholly new begins to grow.", "x0": 0.1813186813186813, "y0": 0.5571095571095571, "x1": 0.6681318681318681, "y1": 0.5703185703185704}, {"text": "KRUuprtsky", "x0": 0.7307692307692307, "y0": 0.5920745920745921, "x1": 0.8175824175824176, "y1": 0.6013986013986014}, {"text": "The Family", "x0": 0.7263736263736263, "y0": 0.60994560994561, "x1": 0.8175824175824176, "y1": 0.6223776223776224}, {"text": "\u2018The Borough Press", "x0": 0.6989010989010989, "y0": 0.6332556332556333, "x1": 0.8131868131868132, "y1": 0.6425796425796426}, {"text": "|] cacophony mixture of loud, unpleasant sounds", "x0": 0.1813186813186813, "y0": 0.6627816627816627, "x1": 0.5945054945054945, "y1": 0.6752136752136753}, {"text": "21 inconspicuous not attracting attention", "x0": 0.1813186813186813, "y0": 0.6806526806526807, "x1": 0.5153846153846153, "y1": 0.6923076923076923}, {"text": "(1 untethered disconnected", "x0": 0.1813186813186813, "y0": 0.6977466977466977, "x1": 0.4472527472527473, "y1": 0.7070707070707071}, {"text": "(41 Mass, religious ceremony", "x0": 0.1813186813186813, "y0": 0.7148407148407149, "x1": 0.489010989010989, "y1": 0.7272727272727273}], [{"text": "Text 4 \u2014 Nonfiction extract", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.36153846153846153, "y1": 0.09168609168609168}, {"text": "The sun has just peeked above the cloudless horizon, but its golden light holds", "x0": 0.18021978021978022, "y0": 0.13286713286713286, "x1": 0.8175824175824176, "y1": 0.14607614607614608}, {"text": "little warmth at this hour, at this time of year ...", "x0": 0.1813186813186813, "y0": 0.15073815073815075, "x1": 0.5703296703296703, "y1": 0.16394716394716394}, {"text": "We walk down the path that cuts between the dunes from the surf club to the", "x0": 0.2010989010989011, "y0": 0.18492618492618493, "x1": 0.8175824175824176, "y1": 0.19813519813519814}, {"text": "golden strip of sand. For the past week or so, the ocean has been whipped by", "x0": 0.1813186813186813, "y0": 0.20279720279720279, "x1": 0.8175824175824176, "y1": 0.216006216006216}, {"text": "a powerful southerly storm, making swimming too dangerous, but now there", "x0": 0.1813186813186813, "y0": 0.22066822066822067, "x1": 0.8175824175824176, "y1": 0.2338772338772339}, {"text": "is only a small swell and very little wind chop. On the shoreline we don!!! our", "x0": 0.1813186813186813, "y0": 0.23543123543123542, "x1": 0.8186813186813187, "y1": 0.2517482517482518}, {"text": "goggles, then, gasping, dive into the clear, crisp water.", "x0": 0.1813186813186813, "y0": 0.2564102564102564, "x1": 0.6230769230769231, "y1": 0.26961926961926963}, {"text": "We ride the strong rip-current over the seagrass meadow and rocky reef,", "x0": 0.2010989010989011, "y0": 0.2905982905982906, "x1": 0.8186813186813187, "y1": 0.3038073038073038}, {"text": "away from land and our lives on it as if it were a conveyer belt. Once we're", "x0": 0.1813186813186813, "y0": 0.3084693084693085, "x1": 0.8175824175824176, "y1": 0.32167832167832167}, {"text": "past the breaking waves, we stop briefly, as we always do, to decide the day\u2019s", "x0": 0.1813186813186813, "y0": 0.32634032634032634, "x1": 0.8175824175824176, "y1": 0.3395493395493395}, {"text": "course on a whim. As we\u2019re bobbing around on the surface like large colourful", "x0": 0.1813186813186813, "y0": 0.3442113442113442, "x1": 0.8175824175824176, "y1": 0.35742035742035744}, {"text": "corks in the water, someone shouts North! and we all agree to head that way,", "x0": 0.1813186813186813, "y0": 0.3620823620823621, "x1": 0.8186813186813187, "y1": 0.3752913752913753}, {"text": "parallel to the beach. Then we start to swim further out to sea \u2014 and the rippled,", "x0": 0.1813186813186813, "y0": 0.37995337995337997, "x1": 0.8186813186813187, "y1": 0.39316239316239315}, {"text": "sandy bottom below us slowly disappears from sight.", "x0": 0.1813186813186813, "y0": 0.3978243978243978, "x1": 0.6120879120879121, "y1": 0.411033411033411}, {"text": "I think with a little fear, as I often do, of the many other (and much larger)", "x0": 0.2021978021978022, "y0": 0.4289044289044289, "x1": 0.8175824175824176, "y1": 0.4483294483294483}, {"text": "creatures whose natural territory this is, and scan the surrounding water for any", "x0": 0.1813186813186813, "y0": 0.44988344988344986, "x1": 0.8175824175824176, "y1": 0.4630924630924631}, {"text": "dark, fast-moving shadows. But soon I relax and settle into the rhythm of my", "x0": 0.1813186813186813, "y0": 0.46464646464646464, "x1": 0.8175824175824176, "y1": 0.4840714840714841}, {"text": "freestyle stroke. Breathe. Pull. Pull. Pull. Breathe. Pull. Pull. Pull. Breathe.", "x0": 0.1813186813186813, "y0": 0.48562548562548563, "x1": 0.8175824175824176, "y1": 0.4988344988344988}, {"text": "My body rises with the gentle waves that are rolling in to the beach, moves", "x0": 0.1813186813186813, "y0": 0.5034965034965035, "x1": 0.8175824175824176, "y1": 0.5167055167055167}, {"text": "in harmony with the motion of the water that carries clumps of golden-brown", "x0": 0.1813186813186813, "y0": 0.5213675213675214, "x1": 0.8175824175824176, "y1": 0.5345765345765345}, {"text": "seaweed, tiny iridescent-blue jellyfish and a few pieces of plastic. I keep a", "x0": 0.1813186813186813, "y0": 0.5392385392385393, "x1": 0.8175824175824176, "y1": 0.5524475524475524}, {"text": "peripheral eye!\u201d! on the rest of the group, making sure I don\u2019t stray. We are", "x0": 0.1813186813186813, "y0": 0.554001554001554, "x1": 0.8175824175824176, "y1": 0.5703185703185704}, {"text": "flying over a deep blue void!*!, one that we could fall into at any moment.", "x0": 0.1813186813186813, "y0": 0.5718725718725719, "x1": 0.7824175824175824, "y1": 0.5881895881895882}, {"text": "We pause briefly in the middle of the bay, in line with the bright-blue", "x0": 0.2010989010989011, "y0": 0.6091686091686092, "x1": 0.8175824175824176, "y1": 0.6223776223776224}, {"text": "lifeguard pavilion, to regroup and check everyone is okay, before continuing to", "x0": 0.1813186813186813, "y0": 0.627039627039627, "x1": 0.8175824175824176, "y1": 0.6402486402486403}, {"text": "the northern headland. When we reach it, we turn around and retrace our course", "x0": 0.1813186813186813, "y0": 0.6449106449106449, "x1": 0.8175824175824176, "y1": 0.655011655011655}, {"text": "south. We emerge from the water about forty-five minutes after we entered, but", "x0": 0.1813186813186813, "y0": 0.6627816627816627, "x1": 0.8175824175824176, "y1": 0.675990675990676}, {"text": "it feels to me like much more time has passed. Drinking coffee and eating cake", "x0": 0.1813186813186813, "y0": 0.6806526806526807, "x1": 0.8175824175824176, "y1": 0.6938616938616938}, {"text": "together back at the surf club, I feel blissfully light-headed, as I always do after", "x0": 0.1813186813186813, "y0": 0.6915306915306916, "x1": 0.8186813186813187, "y1": 0.7156177156177156}, {"text": "a long swim.", "x0": 0.1813186813186813, "y0": 0.7163947163947164, "x1": 0.2846153846153846, "y1": 0.7296037296037297}, {"text": "Drew ROOKE", "x0": 0.7098901098901099, "y0": 0.7513597513597513, "x1": 0.8175824175824176, "y1": 0.7606837606837606}, {"text": "Into the Void", "x0": 0.7120879120879121, "y0": 0.7684537684537684, "x1": 0.8186813186813187, "y1": 0.7785547785547785}, {"text": "\u00a9 Drew Rooke", "x0": 0.7318681318681318, "y0": 0.790986790986791, "x1": 0.8186813186813187, "y1": 0.797979797979798}, {"text": "don put on", "x0": 0.2, "y0": 0.8158508158508159, "x1": 0.4010989010989011, "y1": 0.8259518259518259}, {"text": "1 peripheral eye watch", "x0": 0.1813186813186813, "y0": 0.8313908313908314, "x1": 0.3978021978021978, "y1": 0.8430458430458431}, {"text": "BI void large, completely empty space", "x0": 0.1813186813186813, "y0": 0.8484848484848485, "x1": 0.5626373626373626, "y1": 0.8601398601398601}], [{"text": "Section I \u2014 Module A (continued)", "x0": 0.11978021978021978, "y0": 0.08158508158508158, "x1": 0.45274725274725275, "y1": 0.09557109557109557}, {"text": "Part B - 15 marks", "x0": 0.11978021978021978, "y0": 0.11655011655011654, "x1": 0.27692307692307694, "y1": 0.12665112665112666}, {"text": "Attempt Question 5", "x0": 0.11978021978021978, "y0": 0.13286713286713286, "x1": 0.2879120879120879, "y1": 0.14607614607614608}, {"text": "Allow about 30 minutes for this part", "x0": 0.11978021978021978, "y0": 0.14996114996114995, "x1": 0.4340659340659341, "y1": 0.16317016317016317}, {"text": "Answer the question on pages 6-12 of the Paper 1 Answer Booklet. Extra writing booklets are", "x0": 0.11978021978021978, "y0": 0.18337218337218336, "x1": 0.8791208791208791, "y1": 0.19658119658119658}, {"text": "available.", "x0": 0.11978021978021978, "y0": 0.20046620046620048, "x1": 0.1956043956043956, "y1": 0.2097902097902098}, {"text": "Your answer will be a:", "x0": 0.14395604395604394, "y0": 0.22999222999222999, "x1": 0.321978021978022, "y1": 0.2400932400932401}, {"text": "ssed on how well you:", "x0": 0.34835164835164834, "y0": 0.22999222999222999, "x1": 0.5274725274725275, "y1": 0.2432012432012432}, {"text": "demonstrate understanding of human experiences in texts", "x0": 0.16703296703296702, "y0": 0.2501942501942502, "x1": 0.6318681318681318, "y1": 0.2634032634032634}, {"text": "\u00a9 organise, develop and express ideas using language appropriate to audience, context", "x0": 0.14285714285714285, "y0": 0.2703962703962704, "x1": 0.856043956043956, "y1": 0.2836052836052836}, {"text": "and purpose", "x0": 0.16703296703296702, "y0": 0.2874902874902875, "x1": 0.26373626373626374, "y1": 0.2999222999222999}, {"text": "Question 5 (15 marks)", "x0": 0.11978021978021978, "y0": 0.3317793317793318, "x1": 0.30439560439560437, "y1": 0.3442113442113442}, {"text": "To what extent does the composer of your prescribed text reveal the connection between", "x0": 0.11868131868131868, "y0": 0.3651903651903652, "x1": 0.8791208791208791, "y1": 0.37839937839937837}, {"text": "human emotions and behaviour?", "x0": 0.11978021978021978, "y0": 0.38306138306138304, "x1": 0.3824175824175824, "y1": 0.3923853923853924}, {"text": "The Module A prescribed texts are listed on page 7.", "x0": 0.11868131868131868, "y0": 0.43278943278943277, "x1": 0.5406593406593406, "y1": 0.44522144522144524}], [{"text": "The Module A prescribed texts are:", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.4054945054945055, "y1": 0.0947940947940948}, {"text": "Prose Fiction \u2014 Allan Baillie, The China Coin", "x0": 0.14285714285714285, "y0": 0.11499611499611499, "x1": 0.5285714285714286, "y1": 0.12665112665112666}, {"text": "or", "x0": 0.4043956043956044, "y0": 0.1414141414141414, "x1": 0.4230769230769231, "y1": 0.14840714840714841}, {"text": "Favel Parrett, Past the Shallows", "x0": 0.2857142857142857, "y0": 0.1623931623931624, "x1": 0.5439560439560439, "y1": 0.17327117327117328}, {"text": "Poetry", "x0": 0.14285714285714285, "y0": 0.19502719502719504, "x1": 0.1989010989010989, "y1": 0.20823620823620823}, {"text": "Oodgeroo Noonuccal, My People", "x0": 0.2857142857142857, "y0": 0.1958041958041958, "x1": 0.5560439560439561, "y1": 0.20823620823620823}, {"text": "The prescribed poems are:", "x0": 0.2857142857142857, "y0": 0.21833721833721834, "x1": 0.4989010989010989, "y1": 0.23154623154623155}, {"text": "Last of His Tribe", "x0": 0.3098901098901099, "y0": 0.24164724164724163, "x1": 0.4472527472527473, "y1": 0.25485625485625485}, {"text": "The Young Girl Wanda", "x0": 0.3098901098901099, "y0": 0.2595182595182595, "x1": 0.4967032967032967, "y1": 0.27195027195027194}, {"text": "The Unhappy Race", "x0": 0.3098901098901099, "y0": 0.27583527583527584, "x1": 0.46373626373626375, "y1": 0.28826728826728826}, {"text": "Corroboree", "x0": 0.3098901098901099, "y0": 0.29215229215229216, "x1": 0.4032967032967033, "y1": 0.30225330225330227}, {"text": "Gifts", "x0": 0.3098901098901099, "y0": 0.30924630924630925, "x1": 0.34725274725274724, "y1": 0.32167832167832167}, {"text": "We Are Going", "x0": 0.310989010989011, "y0": 0.32634032634032634, "x1": 0.42417582417582417, "y1": 0.33877233877233875}, {"text": "The Past", "x0": 0.3098901098901099, "y0": 0.34265734265734266, "x1": 0.3802197802197802, "y1": 0.351981351981352}, {"text": "or", "x0": 0.4043956043956044, "y0": 0.3682983682983683, "x1": 0.4230769230769231, "y1": 0.3752913752913753}, {"text": "Ken Watson (ed.), The Round Earth's Imagined Corners", "x0": 0.2868131868131868, "y0": 0.3885003885003885, "x1": 0.7461538461538462, "y1": 0.4017094017094017}, {"text": "The prescribed poems are:", "x0": 0.2857142857142857, "y0": 0.41181041181041184, "x1": 0.4989010989010989, "y1": 0.425019425019425}, {"text": "Sujata Bhatt, The Stare", "x0": 0.3098901098901099, "y0": 0.4358974358974359, "x1": 0.4967032967032967, "y1": 0.4491064491064491}, {"text": "Carol Ann Duffy, Originally and Yes, Officer", "x0": 0.3098901098901099, "y0": 0.4522144522144522, "x1": 0.6780219780219781, "y1": 0.4654234654234654}, {"text": "Miroslav Holub, Brief Thoughts on Laughter", "x0": 0.3098901098901099, "y0": 0.46853146853146854, "x1": 0.6747252747252748, "y1": 0.48174048174048173}, {"text": "Gwyneth Lewis, Flyover Elegies", "x0": 0.3098901098901099, "y0": 0.48562548562548563, "x1": 0.5747252747252747, "y1": 0.4988344988344988}, {"text": "Mudrooroo, City Suburban Lines", "x0": 0.3098901098901099, "y0": 0.5019425019425019, "x1": 0.578021978021978, "y1": 0.5135975135975136}, {"text": "Dennis O'Driscoll, Jn Office", "x0": 0.3098901098901099, "y0": 0.519036519036519, "x1": 0.5395604395604395, "y1": 0.5322455322455323}, {"text": "Drama", "x0": 0.14285714285714285, "y0": 0.5524475524475524, "x1": 0.2021978021978022, "y1": 0.5625485625485626}, {"text": "Jane Harrison, Rainbow's End", "x0": 0.2857142857142857, "y0": 0.5524475524475524, "x1": 0.532967032967033, "y1": 0.5633255633255633}, {"text": "from Vivienne Cleven et al., Contemporary Indigenous Plays", "x0": 0.2868131868131868, "y0": 0.5687645687645687, "x1": 0.7846153846153846, "y1": 0.581973581973582}, {"text": "Nonfiction", "x0": 0.14285714285714285, "y0": 0.6021756021756022, "x1": 0.23296703296703297, "y1": 0.6122766122766122}, {"text": "Ernesto \u2018Che\u2019 Guevara, The Motorcycle Diaries", "x0": 0.2857142857142857, "y0": 0.6021756021756022, "x1": 0.6758241758241759, "y1": 0.6153846153846154}, {"text": "or", "x0": 0.4043956043956044, "y0": 0.6293706293706294, "x1": 0.4230769230769231, "y1": 0.6363636363636364}, {"text": "Alice Pung, Unpolished Gem", "x0": 0.2857142857142857, "