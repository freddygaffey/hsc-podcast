[[{"text": "GOVERNMENT", "x0": 0.12197802197802197, "y0": 0.1592851592851593, "x1": 0.22527472527472528, "y1": 0.16705516705516704}, {"text": "NSW Education Standards Authority", "x0": 0.11978021978021978, "y0": 0.19114219114219114, "x1": 0.4725274725274725, "y1": 0.20512820512820512}, {"text": "2024 | HIGHER SCHOOL CERTIFICATE EXAMINATION", "x0": 0.12747252747252746, "y0": 0.30691530691530694, "x1": 0.5868131868131868, "y1": 0.331002331002331}, {"text": "English Extension 1", "x0": 0.12307692307692308, "y0": 0.351981351981352, "x1": 0.5813186813186814, "y1": 0.38694638694638694}, {"text": "General + Reading time - 10 minutes", "x0": 0.11978021978021978, "y0": 0.4289044289044289, "x1": 0.5241758241758242, "y1": 0.4483294483294483}, {"text": "Instructions \u2014- Working time \u2014 2 hours", "x0": 0.11978021978021978, "y0": 0.44988344988344986, "x1": 0.49230769230769234, "y1": 0.4662004662004662}, {"text": "+ Write using black pen", "x0": 0.2681318681318681, "y0": 0.473970473970474, "x1": 0.47802197802197804, "y1": 0.48717948717948717}, {"text": "Total marks: Section | - 25 marks (page 2)", "x0": 0.11868131868131868, "y0": 0.5283605283605284, "x1": 0.5406593406593406, "y1": 0.5415695415695416}, {"text": "50 + Attempt Question 1", "x0": 0.11868131868131868, "y0": 0.5454545454545454, "x1": 0.45604395604395603, "y1": 0.5656565656565656}, {"text": "+ Allow about 1 hour for this section", "x0": 0.2681318681318681, "y0": 0.5734265734265734, "x1": 0.5934065934065934, "y1": 0.5835275835275835}, {"text": "Section II - 25 marks (pages 3-8)", "x0": 0.26703296703296703, "y0": 0.6068376068376068, "x1": 0.578021978021978, "y1": 0.62004662004662}, {"text": "+ Attempt Question 2", "x0": 0.2681318681318681, "y0": 0.6309246309246309, "x1": 0.4582417582417582, "y1": 0.6441336441336442}, {"text": "+ Allow about 1 hour for this section", "x0": 0.2681318681318681, "y0": 0.6526806526806527, "x1": 0.5934065934065934, "y1": 0.6627816627816627}, {"text": "2250", "x0": 0.08131868131868132, "y0": 0.9463869463869464, "x1": 0.11758241758241758, "y1": 0.9549339549339549}], [{"text": "Section I \u2014 Common Module: Literary Worlds", "x0": 0.11978021978021978, "y0": 0.08158508158508158, "x1": 0.6, "y1": 0.09634809634809635}, {"text": "25 marks", "x0": 0.11868131868131868, "y0": 0.11188811188811189, "x1": 0.1989010989010989, "y1": 0.12198912198912198}, {"text": "Attempt Question 1", "x0": 0.11978021978021978, "y0": 0.1282051282051282, "x1": 0.2868131868131868, "y1": 0.1414141414141414}, {"text": "Allow about 1 hour for this section", "x0": 0.11978021978021978, "y0": 0.1452991452991453, "x1": 0.4186813186813187, "y1": 0.1554001554001554}, {"text": "Answer the question on pages 2\u201412 of the English Extension 1 Writing Booklet. Extra writing", "x0": 0.11978021978021978, "y0": 0.17327117327117328, "x1": 0.8791208791208791, "y1": 0.1864801864801865}, {"text": "booklets are available.", "x0": 0.11868131868131868, "y0": 0.19036519036519037, "x1": 0.3, "y1": 0.20046620046620048}, {"text": "Your answer will be assessed on how well you:", "x0": 0.14395604395604394, "y0": 0.21678321678321677, "x1": 0.5274725274725275, "y1": 0.22999222999222999}, {"text": "demonstrate an understanding of the ideas and values of Literary Worlds and how they", "x0": 0.16703296703296702, "y0": 0.236985236985237, "x1": 0.8549450549450549, "y1": 0.2501942501942502}, {"text": "are shaped and reflected in texts", "x0": 0.16703296703296702, "y0": 0.2540792540792541, "x1": 0.42747252747252745, "y1": 0.26728826728826727}, {"text": "craft a sustained composition appropriate to the question, demonstrating control of the", "x0": 0.16703296703296702, "y0": 0.27350427350427353, "x1": 0.856043956043956, "y1": 0.2867132867132867}, {"text": "use of language", "x0": 0.16813186813186815, "y0": 0.2905982905982906, "x1": 0.2934065934065934, "y1": 0.3038073038073038}, {"text": "Question 1 (25 marks)", "x0": 0.11978021978021978, "y0": 0.32634032634032634, "x1": 0.30439560439560437, "y1": 0.33877233877233875}, {"text": "Read the extract and then answer the questions that follow.", "x0": 0.11978021978021978, "y0": 0.3550893550893551, "x1": 0.5978021978021978, "y1": 0.3682983682983683}, {"text": "Treally don\u2019t like words like \u201cartist\u201d or \u201cintegrity\u201d or \u201ccourage\u201d or \u201cnobility\u201d.", "x0": 0.1824175824175824, "y0": 0.39083139083139085, "x1": 0.8164835164835165, "y1": 0.40404040404040403}, {"text": "T have a kind of distrust of all those words because I don\u2019t really know what", "x0": 0.1824175824175824, "y0": 0.40714840714840717, "x1": 0.8164835164835165, "y1": 0.42035742035742035}, {"text": "they mean, any more than I really know what such words as \u201cdemocracy\u201d or", "x0": 0.1824175824175824, "y0": 0.425019425019425, "x1": 0.8175824175824176, "y1": 0.43745143745143744}, {"text": "\u201cpeace\u201d or \u201cpeace-loving\u201d or \u201cwarlike\u201d or \u201cintegration\u201d mean. And yet one is,", "x0": 0.1824175824175824, "y0": 0.4405594405594406, "x1": 0.8164835164835165, "y1": 0.45376845376845376}, {"text": "compelled to recognize that all these imprecise words are attempts made by us", "x0": 0.1824175824175824, "y0": 0.45843045843045843, "x1": 0.8164835164835165, "y1": 0.47086247086247085}, {"text": "all to get to something which is real and which lives behind the words. Whether", "x0": 0.1824175824175824, "y0": 0.473970473970474, "x1": 0.8175824175824176, "y1": 0.48717948717948717}, {"text": "1 like it or not, for example, and no matter what I call myself, I suppose the", "x0": 0.17802197802197803, "y0": 0.4840714840714841, "x1": 0.8164835164835165, "y1": 0.5081585081585082}, {"text": "only word for me, when the chips are down*, is that I am an artist. There is", "x0": 0.1824175824175824, "y0": 0.5073815073815073, "x1": 0.8164835164835165, "y1": 0.5205905205905206}, {"text": "such a thing. There is such a thing as integrity. Some people are noble. There is,", "x0": 0.1824175824175824, "y0": 0.5236985236985237, "x1": 0.8164835164835165, "y1": 0.5369075369075369}, {"text": "such a thing as courage. The terrible thing is that the reality behind these words", "x0": 0.1824175824175824, "y0": 0.5407925407925408, "x1": 0.8164835164835165, "y1": 0.554001554001554}, {"text": "depends ultimately on what the human being (meaning every single one of us)", "x0": 0.1824175824175824, "y0": 0.5571095571095571, "x1": 0.8164835164835165, "y1": 0.5703185703185704}, {"text": "believes to be real. The terrible thing is that the reality behind all these words", "x0": 0.1824175824175824, "y0": 0.5742035742035742, "x1": 0.8164835164835165, "y1": 0.5874125874125874}, {"text": "depends on choices one has got to make, for ever and ever and ever, every day.", "x0": 0.1824175824175824, "y0": 0.5905205905205905, "x1": 0.8175824175824176, "y1": 0.6037296037296037}, {"text": "1am not interested really in talking to you as an artist. It seems to me that the", "x0": 0.1824175824175824, "y0": 0.6371406371406372, "x1": 0.8175824175824176, "y1": 0.6503496503496503}, {"text": "struggle for integrity must be considered as a kind of metaphor for the", "x0": 0.24395604395604395, "y0": 0.6542346542346542, "x1": 0.8175824175824176, "y1": 0.6674436674436675}, {"text": "struggle, which is universal and daily, of all human beings on the face of this", "x0": 0.1824175824175824, "y0": 0.6705516705516705, "x1": 0.8175824175824176, "y1": 0.6837606837606838}, {"text": "globe to get to become human beings ... The poets (by which I mean all artists)", "x0": 0.1824175824175824, "y0": 0.6845376845376845, "x1": 0.8175824175824176, "y1": 0.703962703962704}, {"text": "are finally the only people who know the truth about us.", "x0": 0.1824175824175824, "y0": 0.703962703962704, "x1": 0.6373626373626373, "y1": 0.7171717171717171}, {"text": "JAMES BALDWIN", "x0": 0.6879120879120879, "y0": 0.728049728049728, "x1": 0.8164835164835165, "y1": 0.7373737373737373}, {"text": "Extract from The Artist's Struggle for Integrity", "x0": 0.43736263736263736, "y0": 0.7443667443667443, "x1": 0.8175824175824176, "y1": 0.7575757575757576}, {"text": "* when the chips are down when forced to choose", "x0": 0.16813186813186815, "y0": 0.77000777000777, "x1": 0.5340659340659341, "y1": 0.7808857808857809}, {"text": "James Baldwin, excerpts from \u201cThe Artist's Struggle for Integrity\" from The Cross of Redemption:", "x0": 0.26153846153846155, "y0": 0.7878787878787878, "x1": 0.8307692307692308, "y1": 0.7972027972027972}, {"text": "Uncollected Writings. Copyright \u00a9 1963 by James Baldwin. Copyright \u00a9 2010 by The James Baldwin Estate.", "x0": 0.1934065934065934, "y0": 0.7995337995337995, "x1": 0.8307692307692308, "y1": 0.8088578088578089}, {"text": "Reprinted with the permission of The Permissions Company LLC on behalf of the James Baldwin Estate.", "x0": 0.2164835164835165, "y0": 0.8111888111888111, "x1": 0.8318681318681319, "y1": 0.8205128205128205}, {"text": "Use the ideas in the extract to compose a narrative in which you construct a 15", "x0": 0.16703296703296702, "y0": 0.8321678321678322, "x1": 0.8791208791208791, "y1": 0.8453768453768454}, {"text": "(a)", "x0": 0.11978021978021978, "y0": 0.8329448329448329, "x1": 0.14065934065934066, "y1": 0.8445998445998446}, {"text": "literary world to explore \u2018something which is real and which lives behind the", "x0": 0.16703296703296702, "y0": 0.8492618492618492, "x1": 0.8076923076923077, "y1": 0.8624708624708625}, {"text": "words\u2019.", "x0": 0.16703296703296702, "y0": 0.8663558663558664, "x1": 0.22637362637362637, "y1": 0.8756798756798757}, {"text": "Analyse how you constructed a literary world in part (a) to explore \u2018something 10", "x0": 0.16703296703296702, "y0": 0.8958818958818959, "x1": 0.8802197802197802, "y1": 0.9153069153069153}, {"text": "(b)", "x0": 0.11978021978021978, "y0": 0.8997668997668997, "x1": 0.14175824175824175, "y1": 0.9114219114219114}, {"text": "which is real and which lives behind the words\u2019.", "x0": 0.16703296703296702, "y0": 0.916083916083916, "x1": 0.5593406593406594, "y1": 0.9261849261849262}], [{"text": "Section II \u2014 Electives", "x0": 0.11978021978021978, "y0": 0.08158508158508158, "x1": 0.34175824175824177, "y1": 0.09324009324009325}, {"text": "25 marks", "x0": 0.11868131868131868, "y0": 0.11655011655011654, "x1": 0.1989010989010989, "y1": 0.12665112665112666}, {"text": "Attempt Question 2", "x0": 0.11978021978021978, "y0": 0.13286713286713286, "x1": 0.2879120879120879, "y1": 0.14607614607614608}, {"text": "Allow about 1 hour for this section", "x0": 0.11978021978021978, "y0": 0.14996114996114995, "x1": 0.4186813186813187, "y1": 0.16006216006216006}, {"text": "Answer the question on pages 14-24 of the English Extension | Writing Booklet. Extra writing", "x0": 0.11978021978021978, "y0": 0.18337218337218336, "x1": 0.8802197802197802, "y1": 0.19658119658119658}, {"text": "booklets are available.", "x0": 0.11868131868131868, "y0": 0.19968919968919968, "x1": 0.3, "y1": 0.2097902097902098}, {"text": "Your answer will be assessed on how well you:", "x0": 0.14395604395604394, "y0": 0.22999222999222999, "x1": 0.5274725274725275, "y1": 0.2432012432012432}, {"text": "demonstrate an understanding of the ideas and values of Literary Worlds and how they", "x0": 0.14285714285714285, "y0": 0.2501942501942502, "x1": 0.8549450549450549, "y1": 0.2634032634032634}, {"text": "are shaped and reflected in texts", "x0": 0.16703296703296702, "y0": 0.2665112665112665, "x1": 0.42747252747252745, "y1": 0.27972027972027974}, {"text": "\u00a9 craft a sustained composition appropriate to the question, demonstrating control of the", "x0": 0.14285714285714285, "y0": 0.2867132867132867, "x1": 0.856043956043956, "y1": 0.2999222999222999}, {"text": "use of language", "x0": 0.16703296703296702, "y0": 0.30303030303030304, "x1": 0.2934065934065934, "y1": 0.3162393162393162}, {"text": "Question 2 (25 marks)", "x0": 0.11978021978021978, "y0": 0.34887334887334887, "x1": 0.30439560439560437, "y1": 0.3613053613053613}, {"text": "Why do we value literary worlds that immerse us in powerful and challenging experiences?", "x0": 0.11978021978021978, "y0": 0.3822843822843823, "x1": 0.8626373626373627, "y1": 0.3954933954933955}, {"text": "Justify your argument in light of the literary worlds you have studied in your elective.", "x0": 0.11868131868131868, "y0": 0.4156954156954157, "x1": 0.8164835164835165, "y1": 0.4289044289044289}, {"text": "In your response, make close reference to TWO prescribed texts and ONE other text of your", "x0": 0.11978021978021978, "y0": 0.4491064491064491, "x1": 0.8802197802197802, "y1": 0.46231546231546233}, {"text": "own choosing.", "x0": 0.11868131868131868, "y0": 0.4662004662004662, "x1": 0.23626373626373626, "y1": 0.47863247863247865}, {"text": "The prescribed texts for Section II are listed on pages 4-8.", "x0": 0.11868131868131868, "y0": 0.4988344988344988, "x1": 0.5934065934065934, "y1": 0.5120435120435121}], [{"text": "The prescribed texts for Section II are:", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.4307692307692308, "y1": 0.0947940947940948}, {"text": "+ Elective 1: Literary Homelands", "x0": 0.11978021978021978, "y0": 0.11499611499611499, "x1": 0.4142857142857143, "y1": 0.1282051282051282}, {"text": "The prescribed texts are:", "x0": 0.14285714285714285, "y0": 0.14840714840714841, "x1": 0.34065934065934067, "y1": 0.16161616161616163}, {"text": "Prose Fiction", "x0": 0.16703296703296702, "y0": 0.18181818181818182, "x1": 0.2802197802197802, "y1": 0.1919191919191919}, {"text": "\u2014 Aravind Adiga, The White Tiger", "x0": 0.3087912087912088, "y0": 0.18181818181818182, "x1": 0.5967032967032967, "y1": 0.19502719502719504}, {"text": "\u2014 EM Forster, A Passage to India", "x0": 0.3087912087912088, "y0": 0.20512820512820512, "x1": 0.5956043956043956, "y1": 0.21833721833721834}, {"text": "Colm T\u00e9ibin, Brooklyn", "x0": 0.33296703296703295, "y0": 0.22843822843822845, "x1": 0.5197802197802198, "y1": 0.24164724164724163}, {"text"