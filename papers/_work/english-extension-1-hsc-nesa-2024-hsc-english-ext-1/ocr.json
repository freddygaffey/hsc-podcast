17793318}, {"text": "Lines written a few miles above Tintern Abbey", "x0": 0.35714285714285715, "y0": 0.3418803418803419, "x1": 0.734065934065934, "y1": 0.3550893550893551}, {"text": "Three years she grew in sun and shower", "x0": 0.35824175824175825, "y0": 0.358974358974359, "x1": 0.6857142857142857, "y1": 0.37218337218337216}, {"text": "My heart leaps up when I behold", "x0": 0.35604395604395606, "y0": 0.3752913752913753, "x1": 0.6252747252747253, "y1": 0.3885003885003885}, {"text": "Resolution and Independence", "x0": 0.35714285714285715, "y0": 0.3923853923853924, "x1": 0.5956043956043956, "y1": 0.40559440559440557}, {"text": "The world is too much with us", "x0": 0.35824175824175825, "y0": 0.4087024087024087, "x1": 0.6021978021978022, "y1": 0.4188034188034188}, {"text": "Ode (\u2018There was a time\u2019)", "x0": 0.35824175824175825, "y0": 0.4257964257964258, "x1": 0.5615384615384615, "y1": 0.439005439005439}, {"text": "The Solitary Reaper", "x0": 0.35824175824175825, "y0": 0.4421134421134421, "x1": 0.5197802197802198, "y1": 0.4553224553224553}, {"text": "The Prelude (1805) ~ Book One, lines 1-67, 271-441", "x0": 0.35824175824175825, "y0": 0.45843045843045843, "x1": 0.7978021978021979, "y1": 0.47086247086247085}, {"text": "Film", "x0": 0.16703296703296702, "y0": 0.4926184926184926, "x1": 0.20549450549450549, "y1": 0.5027195027195027}, {"text": "Daniel Nettheim, The Hunter", "x0": 0.33406593406593404, "y0": 0.4926184926184926, "x1": 0.5703296703296703, "y1": 0.5042735042735043}, {"text": "End of paper", "x0": 0.44285714285714284, "y0": 0.5594405594405595, "x1": 0.5560439560439561, "y1": 0.5726495726495726}, {"text": "(\u00a9 2024 NSW Edueation Standards Authority", "x0": 0.3824175824175824, "y0": 0.9673659673659674, "x1": 0.6164835164835165, "y1": 0.9751359751359752}]]