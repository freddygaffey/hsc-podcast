[[{"text": "GOVERNMENT", "x0": 0.12197802197802197, "y0": 0.1592851592851593, "x1": 0.22527472527472528, "y1": 0.16705516705516704}, {"text": "NSW Education Standards Authority", "x0": 0.11978021978021978, "y0": 0.19114219114219114, "x1": 0.4725274725274725, "y1": 0.20512820512820512}, {"text": "2019 | HIGHER SCHOOL CERTIFICATE EXAMINATION", "x0": 0.12747252747252746, "y0": 0.30691530691530694, "x1": 0.5857142857142857, "y1": 0.331002331002331}, {"text": "English Extension 1", "x0": 0.12307692307692308, "y0": 0.351981351981352, "x1": 0.5813186813186814, "y1": 0.38694638694638694}, {"text": "General + Reading time 10 minutes", "x0": 0.11978021978021978, "y0": 0.4289044289044289, "x1": 0.5241758241758242, "y1": 0.4483294483294483}, {"text": "Instructions \u2014- Working time \u2014 2 hours", "x0": 0.11978021978021978, "y0": 0.44988344988344986, "x1": 0.49230769230769234, "y1": 0.4662004662004662}, {"text": "+ Write using black pen", "x0": 0.2681318681318681, "y0": 0.473970473970474, "x1": 0.47802197802197804, "y1": 0.48717948717948717}, {"text": "Total marks: Section | - 25 marks (pages 2-3)", "x0": 0.11868131868131868, "y0": 0.5283605283605284, "x1": 0.5714285714285714, "y1": 0.5415695415695416}, {"text": "50 + Attempt Question 1", "x0": 0.11868131868131868, "y0": 0.5454545454545454, "x1": 0.45604395604395603, "y1": 0.5656565656565656}, {"text": "+ Allow about 1 hour for this section", "x0": 0.2681318681318681, "y0": 0.5734265734265734, "x1": 0.5934065934065934, "y1": 0.5835275835275835}, {"text": "Section II - 25 marks (pages 4-8)", "x0": 0.26703296703296703, "y0": 0.6068376068376068, "x1": 0.578021978021978, "y1": 0.62004662004662}, {"text": "+ Attempt ONE question from Questions 2-6", "x0": 0.2681318681318681, "y0": 0.6309246309246309, "x1": 0.6703296703296703, "y1": 0.6441336441336442}, {"text": "+ Allow about 1 hour for this section", "x0": 0.2681318681318681, "y0": 0.6526806526806527, "x1": 0.5934065934065934, "y1": 0.6627816627816627}, {"text": "2270", "x0": 0.08131868131868132, "y0": 0.9463869463869464, "x1": 0.11758241758241758, "y1": 0.9549339549339549}], [{"text": "Section I \u2014 Common Module: Literary Worlds", "x0": 0.11978021978021978, "y0": 0.08236208236208237, "x1": 0.5989010989010989, "y1": 0.09712509712509712}, {"text": "25 marks", "x0": 0.11868131868131868, "y0": 0.11732711732711733, "x1": 0.1989010989010989, "y1": 0.12742812742812742}, {"text": "Attempt Question 1", "x0": 0.11868131868131868, "y0": 0.13364413364413363, "x1": 0.2868131868131868, "y1": 0.14685314685314685}, {"text": "Allow about 1 hour for this section", "x0": 0.11868131868131868, "y0": 0.15073815073815075, "x1": 0.4186813186813187, "y1": 0.16083916083916083}, {"text": "Answer the question on pages 2\u201412 of the English Extension 1 Writing Booklet. Extra writing", "x0": 0.11978021978021978, "y0": 0.18337218337218336, "x1": 0.8791208791208791, "y1": 0.19658119658119658}, {"text": "booklets are available.", "x0": 0.11868131868131868, "y0": 0.20046620046620048, "x1": 0.2989010989010989, "y1": 0.21056721056721056}, {"text": "Your answer will be assessed on how well you:", "x0": 0.14395604395604394, "y0": 0.23076923076923078, "x1": 0.5274725274725275, "y1": 0.24397824397824397}, {"text": "demonstrate an understanding of the ideas and values of Literary Worlds and how", "x0": 0.16703296703296702, "y0": 0.2501942501942502, "x1": 0.8538461538461538, "y1": 0.2634032634032634}, {"text": "they are shaped and reflected in texts", "x0": 0.16703296703296702, "y0": 0.26728826728826727, "x1": 0.46703296703296704, "y1": 0.2804972804972805}, {"text": "\u00a9 craft a sustained composition appropriate to the question, demonstrating control of the", "x0": 0.14285714285714285, "y0": 0.2874902874902875, "x1": 0.856043956043956, "y1": 0.3006993006993007}, {"text": "use of language", "x0": 0.16703296703296702, "y0": 0.3038073038073038, "x1": 0.2934065934065934, "y1": 0.317016317016317}, {"text": "Use Text | and Text 2 to answer Question 1.", "x0": 0.11978021978021978, "y0": 0.3504273504273504, "x1": 0.4824175824175824, "y1": 0.3620823620823621}, {"text": "Text 1 \u2014 Nonfiction extract", "x0": 0.11868131868131868, "y0": 0.3822843822843823, "x1": 0.36153846153846153, "y1": 0.3923853923853924}, {"text": "All fiction is a masquerade.", "x0": 0.17032967032967034, "y0": 0.4234654234654235, "x1": 0.3923076923076923, "y1": 0.4366744366744367}, {"text": "We writers adopt disguises: we flirt, feign and play, and the story is the mask we", "x0": 0.17032967032967034, "y0": 0.4568764568764569, "x1": 0.8285714285714286, "y1": 0.4700854700854701}, {"text": "wear. Behind every fiction, though, is fact. Behind every white page, the red of", "x0": 0.17032967032967034, "y0": 0.4731934731934732, "x1": 0.8307692307692308, "y1": 0.4864024864024864}, {"text": "real life bleeds through ...", "x0": 0.17032967032967034, "y0": 0.4902874902874903, "x1": 0.3813186813186813, "y1": 0.5034965034965035}, {"text": "A mask allows the wearer to say what otherwise they cannot, perhaps because", "x0": 0.17032967032967034, "y0": 0.5236985236985237, "x1": 0.8285714285714286, "y1": 0.5369075369075369}, {"text": "of political fears or private reluctance. \u2018Man is least himself when he talks in", "x0": 0.17032967032967034, "y0": 0.54001554001554, "x1": 0.8285714285714286, "y1": 0.5532245532245532}, {"text": "his own person,\u2019 wrote Oscar Wilde. \u2018Give him a mask, and he will tell you the", "x0": 0.17032967032967034, "y0": 0.5571095571095571, "x1": 0.8285714285714286, "y1": 0.5703185703185704}, {"text": "truth.\u201d Truth is not the opposite of fiction: it is the fire at its heart. Fiction tells its", "x0": 0.17032967032967034, "y0": 0.5734265734265734, "x1": 0.8285714285714286, "y1": 0.5866355866355867}, {"text": "truths slanted in metaphor and disguised with masks. But, crucially, the disguise", "x0": 0.17032967032967034, "y0": 0.5905205905205905, "x1": 0.8285714285714286, "y1": 0.6037296037296037}, {"text": "discloses meaning: the mask unmasks deeper truths. In this, and in so many ways,", "x0": 0.16923076923076924, "y0": 0.6068376068376068, "x1": 0.8285714285714286, "y1": 0.62004662004662}, {"text": "the mask is a maestro of paradox. It covers and uncovers. It offers both shelter", "x0": 0.17032967032967034, "y0": 0.6231546231546231, "x1": 0.8296703296703297, "y1": 0.6363636363636364}, {"text": "and licence. The mask can collapse space so the moon is within kissing distance,", "x0": 0.17032967032967034, "y0": 0.6402486402486403, "x1": 0.8285714285714286, "y1": 0.6534576534576535}, {"text": "and can tumble time so a hundred years is yesterday, and the future is in our hands", "x0": 0.17032967032967034, "y0": 0.6565656565656566, "x1": 0.8285714285714286, "y1": 0.6697746697746698}, {"text": "now.", "x0": 0.17032967032967034, "y0": 0.6775446775446775, "x1": 0.2076923076923077, "y1": 0.6837606837606838}, {"text": "They say that art mirrors life. I am interested in the way we artists can trick life", "x0": 0.16923076923076924, "y0": 0.7070707070707071, "x1": 0.8285714285714286, "y1": 0.7202797202797203}, {"text": "into imitating art. I wanted to explore a singular grief in my life and to rewrite my", "x0": 0.17032967032967034, "y0": 0.7233877233877234, "x1": 0.8285714285714286, "y1": 0.7365967365967366}, {"text": "own script. To transform grief to transcendence, turning bitter water into wine.", "x0": 0.17032967032967034, "y0": 0.7404817404817405, "x1": 0.8076923076923077, "y1": 0.7536907536907537}, {"text": "Artists weave their past into their work ... With my book, I wanted to write my", "x0": 0.17032967032967034, "y0": 0.7738927738927739, "x1": 0.8274725274725274, "y1": 0.7871017871017871}, {"text": "future: to write it in order to make it come true. If writing the past is an act of", "x0": 0.17032967032967034, "y0": 0.7902097902097902, "x1": 0.8307692307692308, "y1": 0.8034188034188035}, {"text": "memory, and writing the present an act of confession, then mine is a spell. If you", "x0": 0.17032967032967034, "y0": 0.8065268065268065, "x1": 0.8285714285714286, "y1": 0.8197358197358198}, {"text": "stencil your dreams on the walls, you can walk through them. Anyone can, though", "x0": 0.17032967032967034, "y0": 0.8236208236208237, "x1": 0.8285714285714286, "y1": 0.8368298368298368}, {"text": "writers make their spells literal.", "x0": 0.17032967032967034, "y0": 0.8407148407148407, "x1": 0.42527472527472526, "y1": 0.8531468531468531}, {"text": "Jay GRIFFITHS", "x0": 0.7142857142857143, "y0": 0.8741258741258742, "x1": 0.8285714285714286, "y1": 0.8834498834498834}, {"text": "s of Fiction\u2019, Griffith Review 34", "x0": 0.5703296703296703, "y0": 0.8904428904428905, "x1": 0.8285714285714286, "y1": 0.9036519036519036}, {"text": "Extract from \u201cMas", "x0": 0.4098901098901099, "y0": 0.8904428904428905, "x1": 0.554945054945055, "y1": 0.9005439005439005}, {"text": "\u00a9 Jay Griffiths", "x0": 0.7593406593406593, "y0": 0.9207459207459208, "x1": 0.8428571428571429, "y1": 0.9300699300699301}], [{"text": "Text 2 \u2014 Prose fiction extract", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.3791208791208791, "y1": 0.09168609168609168}, {"text": "Does such a thing as \u2018the fatal flaw\u2019, that showy dark crack running down the", "x0": 0.17032967032967034, "y0": 0.12276612276612277, "x1": 0.8285714285714286, "y1": 0.13597513597513597}, {"text": "middle of a life, exist outside literature? I used to think it didn\u2019t. Now I think it", "x0": 0.17032967032967034, "y0": 0.13597513597513597, "x1": 0.8285714285714286, "y1": 0.1561771561771562}, {"text": "s. And I think that mine is this: a morbid longing for the picturesque at all", "x0": 0.2021978021978022, "y0": 0.1561771561771562, "x1": 0.8285714285714286, "y1": 0.16938616938616938}, {"text": "On leaving home I was able to fabricate a new and far more satisfying history, full", "x0": 0.17032967032967034, "y0": 0.20590520590520592, "x1": 0.8285714285714286, "y1": 0.2191142191142191}, {"text": "of striking, simplistic environmental influences; a colourful past, easily accessible", "x0": 0.17032967032967034, "y0": 0.222999222999223, "x1": 0.8285714285714286, "y1": 0.23620823620823622}, {"text": "to strangers.", "x0": 0.17032967032967034, "y0": 0.24164724164724163, "x1": 0.26703296703296703, "y1": 0.25252525252525254}, {"text": "The dazzle of this fictive childhood \u2014 full of swimming pools and orange groves", "x0": 0.16923076923076924, "y0": 0.2727272727272727, "x1": 0.8285714285714286, "y1": 0.28593628593628595}, {"text": "and dissolute, charming show-biz parents ~ has all but eclipsed the drab original.", "x0": 0.17032967032967034, "y0": 0.2898212898212898, "x1": 0.8274725274725274, "y1": 0.30303030303030304}, {"text": "In fact, when I think about my real childhood I am unable to recall much about", "x0": 0.17032967032967034, "y0": 0.3061383061383061, "x1": 0.8285714285714286, "y1": 0.31934731934731936}, {"text": "it at all except a sad jumble of objects: the sneakers I wore year-round; colouring", "x0": 0.17032967032967034, "y0": 0.32245532245532244, "x1": 0.8285714285714286, "y1": 0.3356643356643357}, {"text": "books and comics from the supermarket; little of interest, less of beauty. I was.", "x0": 0.17032967032967034, "y0": 0.3395493395493395, "x1": 0.8285714285714286, "y1": 0.35275835275835277}, {"text": "quiet, tall for my age, prone to freckles. I didn\u2019t have many friends but whether", "x0": 0.17032967032967034, "y0": 0.35586635586635584, "x1": 0.8296703296703297, "y1": 0.3690753690753691}, {"text": "this was due to choice or circumstance I do not now know. I did well in school, it", "x0": 0.17032967032967034, "y0": 0.372960372960373, "x1": 0.8285714285714286, "y1": 0.38461538461538464}, {"text": "seems, but not exceptionally wel liked to read \u2014 Tom Swift, the Tolkien books", "x0": 0.17032967032967034, "y0": 0.38927738927738925, "x1": 0.8285714285714286, "y1": 0.4024864024864025}, {"text": "\u2014 but also to watch television, which I did plenty of, lying on the carpet of our", "x0": 0.16923076923076924, "y0": 0.4063714063714064, "x1": 0.8296703296703297, "y1": 0.4195804195804196}, {"text": "empty living room in the long dull afternoons after school.", "x0": 0.17032967032967034, "y0": 0.4226884226884227, "x1": 0.6450549450549451, "y1": 0.4358974358974359}, {"text": "Donna TARTT", "x0": 0.7142857142857143, "y0": 0.4568764568764569, "x1": 0.8285714285714286, "y1": 0.4662004662004662}, {"text": "Extract from The Secret History", "x0": 0.5692307692307692, "y0": 0.47241647241647244, "x1": 0.8285714285714286, "y1": 0.48562548562548563}, {"text": "\u2018The agreed upon 222 words from The Secret History by Donna Tartt", "x0": 0.44175824175824174, "y0": 0.5027195027195027, "x1": 0.8472527472527472, "y1": 0.5120435120435121}, {"text": "Published by Penguin. Copyright \u00a9 Donna Tartt", "x0": 0.5659340659340659, "y0": 0.5066045066045066, "x1": 0.8472527472527472, "y1": 0.5283605283605284}, {"text": "Reproduced by permission of the author c/o Rogers", "x0": 0.5406593406593406, "y0": 0.526029526029526, "x1": 0.8472527472527472, "y1": 0.5353535353535354}, {"text": "Coleridge & White Ltd., 20 Powis Mews, London W11 1 JN", "x0": 0.4978021978021978, "y0": 0.5369075369075369, "x1": 0.8472527472527472, "y1": 0.5462315462315462}, {"text": "Question 1 (25 marks)", "x0": 0.11978021978021978, "y0": 0.5493395493395493, "x1": 0.30439560439560437, "y1": 0.5617715617715617}, {"text": "In your response to parts (a) and (b), draw on your understanding of the module", "x0": 0.11978021978021978, "y0": 0.5827505827505828, "x1": 0.8076923076923077, "y1": 0.5959595959595959}, {"text": "Literary Worlds and the extract(s) provided.", "x0": 0.11978021978021978, "y0": 0.5998445998445998, "x1": 0.4758241758241758, "y1": 0.6130536130536131}, {"text": "Answer part (a) of the question on pages 2-5 of the Writing Booklet.", "x0": 0.11978021978021978, "y0": 0.6495726495726496, "x1": 0.6802197802197802, "y1": 0.6627816627816627}, {"text": "10", "x0": 0.8615384615384616, "y0": 0.682983682983683, "x1": 0.8802197802197802, "y1": 0.6930846930846931}, {"text": "(a)", "x0": 0.11978021978021978, "y0": 0.6837606837606838, "x1": 0.14065934065934066, "y1": 0.6954156954156954}, {"text": "Use Text | and Text 2 to answer this part.", "x0": 0.16703296703296702, "y0": 0.6837606837606838, "x1": 0.5076923076923077, "y1": 0.6961926961926962}, {"text": "To what extent do both extracts resonate with your understanding of why we", "x0": 0.16593406593406593, "y0": 0.7163947163947164, "x1": 0.8076923076923077, "y1": 0.7296037296037297}, {"text": "compose literary worlds?", "x0": 0.16703296703296702, "y0": 0.7327117327117327, "x1": 0.37032967032967035, "y1": 0.745920745920746}, {"text": "Answer part (b) of the question on pages 6-12 of the Writing Booklet.", "x0": 0.11978021978021978, "y0": 0.7832167832167832, "x1": 0.6912087912087912, "y1": 0.7964257964257965}, {"text": "Use Text 2 to answer this part.", "x0": 0.16703296703296702, "y0": 0.8158508158508159, "x1": 0.4142857142857143, "y1": 0.8290598290598291}, {"text": "(b)", "x0": 0.11978021978021978, "y0": 0.8166278166278166, "x1": 0.14175824175824175, "y1": 0.8282828282828283}, {"text": "Using the character in Text 2, imagine a moment in which the past intrudes on", "x0": 0.16703296703296702, "y0": 0.8492618492618492, "x1": 0.8076923076923077, "y1": 0.8624708624708625}, {"text": "this fabricated world. Compose a piece of imaginative writing that", "x0": 0.16703296703296702, "y0": 0.8663558663558664, "x1": 0.8087912087912088, "y1": 0.8795648795648796}, {"text": "explores this intrusion.", "x0": 0.16703296703296702, "y0": 0.8826728826728827, "x1": 0.3505494505494505, "y1": 0.8958818958818959}], [{"text": "Section II \u2014 Electives", "x0": 0.11978021978021978, "y0": 0.08236208236208237, "x1": 0.34065934065934067, "y1": 0.09401709401709402}, {"text": "25 marks", "x0": 0.11868131868131868, "y0": 0.11732711732711733, "x1": 0.1989010989010989, "y1": 0.12742812742812742}, {"text": "Attempt ONE question from Questions 2-6", "x0": 0.11868131868131868, "y0": 0.13364413364413363, "x1": 0.49230769230769234, "y1": 0.14685314685314685}, {"text": "Allow about 1 hour for this section", "x0": 0.11868131868131868, "y0": 0.15073815073815075, "x1": 0.4186813186813187, "y1": 0.16083916083916083}, {"text": "Answer the question on pages 14-24 of the English Extension | Writing Booklet. Extra writing", "x0": 0.11978021978021978, "y0": 0.18337218337218336, "x1": 0.8791208791208791, "y1": 0.19658119658119658}, {"text": "booklets are available.", "x0": 0.11868131868131868, "y0": 0.20046620046620048, "x1": 0.2989010989010989, "y1": 0.21056721056721056}, {"text": "Your answer will be assessed on how well you:", "x0": 0.14395604395604394, "y0": 0.23076923076923078, "x1": 0.5274725274725275, "y1": 0.24397824397824397}, {"text": "demonstrate an understanding of the ideas and values of Literary Worlds and how", "x0": 0.16703296703296702, "y0": 0.2501942501942502, "x1": 0.8538461538461538, "y1": 0.2634032634032634}, {"text": "they are shaped and reflected in texts", "x0": 0.16703296703296702, "y0": 0.26728826728826727, "x1": 0.46703296703296704, "y1": 0.2804972804972805}, {"text": "\u00a9 craft a sustained composition appropriate to the question, demonstrating control of the", "x0": 0.14285714285714285, "y0": 0.2874902874902875, "x1": 0.856043956043956, "y1": 0.3006993006993007}, {"text": "use of language", "x0": 0.16703296703296702, "y0": 0.3038073038073038, "x1": 0.2934065934065934, "y1": 0.317016317016317}, {"text": "Question 2 \u2014 Elective", "x0": 0.11978021978021978, "y0": 0.3442113442113442, "x1": 0.310989010989011, "y1": 0.35664335664335667}, {"text": ": Literary Homelands (25 marks)", "x0": 0.32857142857142857, "y0": 0.3442113442113442, "x1": 0.6076923076923076, "y1": 0.35742035742035744}, {"text": "To what extent has your study of ideas and values in Literary Homelands enhanced your", "x0": 0.11868131868131868, "y0": 0.3752913752913753, "x1": 0.8802197802197802, "y1": 0.38