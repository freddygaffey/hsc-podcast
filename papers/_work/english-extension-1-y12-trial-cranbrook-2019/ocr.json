[[{"text": "CRANBROOK", "x0": 0.1408140814081408, "y0": 0.06216006216006216, "x1": 0.3487348734873487, "y1": 0.08080808080808081}, {"text": "SCHOOL", "x0": 0.1408140814081408, "y0": 0.08547008547008547, "x1": 0.2222222222222222, "y1": 0.09557109557109557}, {"text": "2019", "x0": 0.823982398239824, "y0": 0.20823620823620823, "x1": 0.88998899889989, "y1": 0.22377622377622378}, {"text": "HSC Trial Examination", "x0": 0.5874587458745875, "y0": 0.23232323232323232, "x1": 0.8888888888888888, "y1": 0.24786324786324787}, {"text": "English Extension 1", "x0": 0.12431243124312431, "y0": 0.38073038073038074, "x1": 0.5258525852585259, "y1": 0.41181041181041184}, {"text": "General + Reading time \u2014 10 minutes", "x0": 0.11991199119911991, "y0": 0.6013986013986014, "x1": 0.5247524752475248, "y1": 0.6208236208236209}, {"text": "Instructions Working time \u2014 2 hours", "x0": 0.11991199119911991, "y0": 0.6223776223776224, "x1": 0.49284928492849284, "y1": 0.6386946386946387}, {"text": "+ Write using black pen", "x0": 0.26732673267326734, "y0": 0.6472416472416472, "x1": 0.47854785478547857, "y1": 0.6604506604506605}, {"text": "Total marks: Section | 25 marks (pages 3-7)", "x0": 0.1188118811881188, "y0": 0.7008547008547008, "x1": 0.5720572057205721, "y1": 0.714063714063714}, {"text": "50 + Attempt Question 1", "x0": 0.11991199119911991, "y0": 0.7187257187257188, "x1": 0.45654565456545654, "y1": 0.7389277389277389}, {"text": "+ Allow about 1 hour for this section", "x0": 0.26732673267326734, "y0": 0.7466977466977467, "x1": 0.5852585258525853, "y1": 0.7567987567987567}, {"text": "Section Il - 25 marks (page 8)", "x0": 0.26732673267326734, "y0": 0.7793317793317793, "x1": 0.5467546754675467, "y1": 0.7925407925407926}, {"text": "+ Attempt Question 2", "x0": 0.26732673267326734, "y0": 0.8041958041958042, "x1": 0.45874587458745875, "y1": 0.8174048174048174}, {"text": "+ Allow about 1 hour for this section", "x0": 0.26732673267326734, "y0": 0.8251748251748252, "x1": 0.5852585258525853, "y1": 0.8352758352758353}], [{"text": "Section I: Common Module \u2014 Literary Worlds", "x0": 0.11991199119911991, "y0": 0.08857808857808858, "x1": 0.6006600660066007, "y1": 0.10411810411810411}, {"text": "25 marks", "x0": 0.11991199119911991, "y0": 0.12121212121212122, "x1": 0.19911991199119913, "y1": 0.13053613053613053}, {"text": "Attempt Question 1", "x0": 0.11991199119911991, "y0": 0.1383061383061383, "x1": 0.28602860286028603, "y1": 0.15073815073815075}, {"text": "Allow about 1 hour for this section", "x0": 0.11991199119911991, "y0": 0.15462315462315462, "x1": 0.41914191419141916, "y1": 0.16394716394716394}, {"text": "Your answer will be assessed on how well you:", "x0": 0.14411441144114412, "y0": 0.20745920745920746, "x1": 0.528052805280528, "y1": 0.22066822066822067}, {"text": "\u00ab demonstrate an understanding of the ideas and values of Literary Worlds and", "x0": 0.14301430143014301, "y0": 0.22533022533022534, "x1": 0.7865786578657866, "y1": 0.24553224553224554}, {"text": "how they are shaped and reflected in texts", "x0": 0.16721672167216722, "y0": 0.2463092463092463, "x1": 0.5071507150715071, "y1": 0.2595182595182595}, {"text": "craft a sustained composition appropriate to the question demonstrating control", "x0": 0.16721672167216722, "y0": 0.26728826728826727, "x1": 0.8041804180418042, "y1": 0.2804972804972805}, {"text": "of the use of language", "x0": 0.16721672167216722, "y0": 0.2851592851592852, "x1": 0.34433443344334436, "y1": 0.29836829836829837}, {"text": "Question 1: Critical response (25 marks)", "x0": 0.11001100110011001, "y0": 0.32867132867132864, "x1": 0.4521452145214521, "y1": 0.3418803418803419}, {"text": "Use Text 1 and Text 2 to answer this question.", "x0": 0.11001100110011001, "y0": 0.3620823620823621, "x1": 0.49174917491749176, "y1": 0.3752913752913753}, {"text": "Evaluate how effectively, and to what purpose, Christopher Nolan constructs the world of", "x0": 0.11001100110011001, "y0": 0.40404040404040403, "x1": 0.8360836083608361, "y1": 0.4172494172494173}, {"text": "his protagonist, Batman/Bruce Wayne, in his film, Batman Begins.", "x0": 0.11001100110011001, "y0": 0.42035742035742035, "x1": 0.6457645764576457, "y1": 0.43356643356643354}, {"text": "Your response should draw on your knowledge and understanding of the module Literary", "x0": 0.11001100110011001, "y0": 0.45376845376845376, "x1": 0.8305830583058306, "y1": 0.466977466977467}, {"text": "Worlds and reference the selected extracts.", "x0": 0.11001100110011001, "y0": 0.4700854700854701, "x1": 0.45434543454345433, "y1": 0.4801864801864802}, {"text": "Text 1 \u2014 Nonfiction extracts", "x0": 0.11001100110011001, "y0": 0.5205905205905206, "x1": 0.35753575357535755, "y1": 0.5299145299145299}, {"text": "Christopher Edward Nolan, CBE (born 30 July 1970) is an English-American film director,", "x0": 0.11001100110011001, "y0": 0.5524475524475524, "x1": 0.8492849284928493, "y1": 0.5656565656565656}, {"text": "screenwriter, and producer. He is known for making personal, distinctive films within the", "x0": 0.10891089108910891, "y0": 0.5687645687645687, "x1": 0.8316831683168316, "y1": 0.581973581973582}, {"text": "Hollywood mainstream and is regarded as an auteur.", "x0": 0.10891089108910891, "y0": 0.585081585081585, "x1": 0.5390539053905391, "y1": 0.5982905982905983}, {"text": "- Wikipedia", "x0": 0.6545654565456546, "y0": 0.6021756021756022, "x1": 0.7733773377337734, "y1": 0.6146076146076146}, {"text": "Nolan admitted that he approached the comic-book world through a different lens, as a noir-", "x0": 0.11001100110011001, "y0": 0.6418026418026418, "x1": 0.8525852585258525, "y1": 0.655011655011655}, {"text": "thriller. \u201cYes, it\u2019s a superhero, but it\u2019s based on ideas of guilt, fear, these strong impulses that", "x0": 0.11001100110011001, "y0": 0.6581196581196581, "x1": 0.8624862486248625, "y1": 0.6713286713286714}, {"text": "the character has,\u201d Nolan said. \u201cBruce Wayne doesn\u2019t have any super powers other than", "x0": 0.11001100110011001, "y0": 0.6744366744366744, "x1": 0.8195819581958196, "y1": 0.6876456876456877}, {"text": "extraordinary wealth, But really, he\u2019s just someone who does a lot of push-ups. In that sense,", "x0": 0.11001100110011001, "y0": 0.6907536907536908, "x1": 0.858085808580858, "y1": 0.703962703962704}, {"text": "he\u2019s very relatable and human. I think that\u2019s why I gravitated towards it.\u201d", "x0": 0.11001100110011001, "y0": 0.7070707070707071, "x1": 0.7007700770077008, "y1": 0.7202797202797203}, {"text": "Grounded in realism \u2014 grounded in heightened realism, grounded in the degree of realism that", "x0": 0.11001100110011001, "y0": 0.7381507381507382, "x1": 0.8767876787678768, "y1": 0.763014763014763}, {"text": "we expected at the time from, you know, our action movies, Jerry Bruckheimer action movies", "x0": 0.11001100110011001, "y0": 0.763014763014763, "x1": 0.8822882288228823, "y1": 0.7762237762237763}, {"text": "and things, that would have realistic textures, you know? So, \"OK, let\u2019s do that.\" What I loved", "x0": 0.11001100110011001, "y0": 0.7793317793317793, "x1": 0.8712871287128713, "y1": 0.7925407925407926}, {"text": "about Superman was the way New York felt like New York, or rather Metropolis felt like New", "x0": 0.11001100110011001, "y0": 0.7956487956487956, "x1": 0.8745874587458746, "y1": 0.8088578088578089}, {"text": "York. Metropolis felt like a city you could recognize \u2014 and then there was this guy flying", "x0": 0.11001100110011001, "y0": 0.8127428127428128, "x1": 0.8382838283828383, "y1": 0.8259518259518259}, {"text": "through the streets. \"That's amazing, so let\u2019s do that for Batman, and let's start by putting", "x0": 0.11001100110011001, "y0": 0.8290598290598291, "x1": 0.8316831683168316, "y1": 0.8422688422688422}, {"text": "together an amazing cast,\"", "x0": 0.11001100110011001, "y0": 0.8453768453768454, "x1": 0.32123212321232125, "y1": 0.8585858585858586}, {"text": "When asked if his \u201cBatman\u201d paid homage to James Bond, Nolan admitted a connection. \u201cWe", "x0": 0.11001100110011001, "y0": 0.891996891996892, "x1": 0.8613861386138614, "y1": 0.9052059052059052}, {"text": "mercilessly pillaged from the James Bond films for certain aspects,\u201d Nolan said, adding that", "x0": 0.11001100110011001, "y0": 0.9083139083139083, "x1": 0.8514851485148515, "y1": 0.9215229215229215}, {"text": "they wanted to make him as compelling as 007. He noted how Gotham\u2019s chief inventor Lucius", "x0": 0.11001100110011001, "y0": 0.916083916083916, "x1": 0.8723872387238724, "y1": 0.9425019425019425}], [{"text": "Fox is similar to Bond\u2019s Agent Q, who has a closet full of gadgets. \u201cBut I think if I made my", "x0": 0.11001100110011001, "y0": 0.06216006216006216, "x1": 0.856985698569857, "y1": 0.08857808857808858}, {"text": "version of James Bond, \u2018Inception\u2019 is far more guilty of that than \u2018The Dark Knight,\u201d\u201d Nolan", "x0": 0.11001100110011001, "y0": 0.07847707847707848, "x1": 0.858085808580858, "y1": 0.1048951048951049}, {"text": "said,", "x0": 0.11001100110011001, "y0": 0.10334110334110334, "x1": 0.14521452145214522, "y1": 0.11344211344211344}, {"text": "To me, each film is a different genre,\u201d Nolan said, about the movies starring Christian Bale as", "x0": 0.11001100110011001, "y0": 0.14296814296814297, "x1": 0.8668866886688669, "y1": 0.1561771561771562}, {"text": "Batman. \u201cThey tend to be defined by the villain.\u201d", "x0": 0.11001100110011001, "y0": 0.1592851592851593, "x1": 0.5071507150715071, "y1": 0.17249417249417248}, {"text": "Christopher Nolan introduction (Wikipedia)", "x0": 0.5082508250825083, "y0": 0.1926961926961927, "x1": 0.88998899889989, "y1": 0.20512820512820512}, {"text": "and extracts from various interviews", "x0": 0.5764576457645765, "y0": 0.20901320901320902, "x1": 0.88998899889989, "y1": 0.21833721833721834}, {"text": "Text 2 \u2014 Script extract", "x0": 0.11001100110011001, "y0": 0.27505827505827507, "x1": 0.31133113311331134, "y1": 0.2874902874902875}, {"text": "INT. CAVERNS - CONTINUOUS", "x0": 0.11001100110011001, "y0": 0.30691530691530694, "x1": 0.39383938393839385, "y1": 0.317016317016317}, {"text": "Wayne climbs down a jagged rock crevice. Air blows in his face. The crevice widens into a low-", "x0": 0.11221122112211221, "y0": 0.3395493395493395, "x1": 0.8822882288228823, "y1": 0.35275835275835277}, {"text": "ceilinged chamber. Wayne hears the rush of water. He crouches, advances through the low", "x0": 0.11001100110011001, "y0": 0.35586635586635584, "x1": 0.8448844884488449, "y1": 0.3690753690753691}, {"text": "chamber. It turns downwards, steeper - Wayne carefiilly slides on his back, lowering himself", "x0": 0.11001100110011001, "y0": 0.37218337218337216, "x1": 0.8602860286028603, "y1": 0.3853923853923854}, {"text": "into \u2014", "x0": 0.11001100110011001, "y0": 0.38927738927738925, "x1": 0.1562156215621562, "y1": 0.3986013986013986}, {"text": "Limitless black. Wayne stands. A roar of water now. He reaches into his coat, pulls out a", "x0": 0.10891089108910891, "y0": 0.4211344211344211, "x1": 0.8272827282728272, "y1": 0.43434343434343436}, {"text": "chemical torch. Cracks it, throwing light into -", "x0": 0.11001100110011001, "y0": 0.4382284382284382, "x1": 0.48624862486248627, "y1": 0.45143745143745145}, {"text": "A vast cavern. An underground river, a jagged ceiling, far above, which, as Wayne peers, starts", "x0": 0.10891089108910891, "y0": 0.45454545454545453, "x1": 0.8822882288228823, "y1": 0.4677544677544678}, {"text": "to move -", "x0": 0.11001100110011001, "y0": 0.4731934731934732, "x1": 0.18371837183718373, "y1": 0.48096348096348096}, {"text": "Bats explode from the ceiling. Thousands descend, screeching, attracted to the light. Wayne", "x0": 0.10891089108910891, "y0": 0.5034965034965035, "x1": 0.8503850385038504, "y1": 0.5167055167055167}, {"text": "instinctively crouches. But as they swarm around him terrifvingly -", "x0": 0.11001100110011001, "y0": 0.5198135198135199, "x1": 0.647964796479648, "y1": 0.533022533022533}, {"text": "Wayne rises to his feet amidst a cyclone of bats, watching the fluttering blackness with a", "x0": 0.11221122112211221, "y0": 0.5524475524475524, "x1": 0.8228822882288229, "y1": 0.5656565656565656}, {"text": "profound calm.", "x0": 0.1078107810781078, "y0": 0.5687645687645687, "x1": 0.2299229922992299, "y1": 0.581973581973582}, {"text": "And he knows the symbol he must use.", "x0": 0.10891089108910891, "y0": 0.6013986013986014, "x1": 0.41474147414741475, "y1": 0.6146076146076146}, {"text": "INT. MAIN HALL, WAYNE MANOR \u2014- CONTINUOUS", "x0": 0.11001100110011001, "y0": 0.6674436674436675, "x1": 0.5808580858085809, "y1": 0.679098679098679}, {"text": "Hundreds of Guests. Music, Tables groaning with food.", "x0": 0.10891089108910891, "y0": 0.6837606837606838, "x1": 0.5555555555555556, "y1": 0.696969696969697}, {"text": "WAYNE", "x0": 0.46314631463146316, "y0": 0.7334887334887334, "x1": 0.5368536853685368, "y1": 0.7428127428127428}, {"text": "Crane was working for you.", "x0": 0.11001100110011001, "y0": 0.749028749028749, "x1": 0.3333333333333333, "y1": 0.7622377622377622}, {"text": "RA\u2019S AL GHUL", "x0": 0.4312431243124312, "y0": 0.7801087801087802, "x1": 0.5687568756875687, "y1": 0.7917637917637917}, {"text": "His toxin is derived from the organic compound in our blue poppies. He was able to weaponize", "x0": 0.11001100110011001, "y0": 0.797979797979798, "x1": 0.8778877887788779, "y1": 0.8111888111888111}, {"text": "it,", "x0": 0.11001100110011001, "y0": 0.8142968142968143, "x1": 0.12431243124312431, "y1": 0.8243978243978244}, {"text": "WAYNE", "x0": 0.46314631463146316, "y0": 0.8484848484848485, "x1": 0.5368536853685368, "y1": 0.8578088578088578}, {"text": "He\u2019s not a member of the League of Shadows", "x0": 0.11001100110011001, "y0": 0.8554778554778555, "x1": 0.47854785478547857, "y1": 0.8818958818958819}, {"text": "As guests filter out, a dozen of Ra\u2019s men remain, scattered around the room.", "x0": 0.10891089108910891, "y0": 0.8966588966588966, "x1": 0.7227722772277227, "y1": 0.9098679098679099}], [{"text": "RA\u2019S AL GHUL", "x0": 0.4312431243124312, "y0": 0.08547008547008547, "x1": 0.5687568756875687, "y1": 0.09712509712509712}, {"text": "Of course not. He thought our plan was to hold the city to ransom.", "x0": 0.11001100110011001, "y0": 0.10334110334110334, "x1": 0.6435643564356436, "y1": 0.11655011655011654}, {"text": "WAYNE", "x0": 0.46314631463146316, "y0": 0.13675213675213677, "x1": 0.5368536853685368, "y1": 0.14607614607614608}, {"text": "But really going to unleash Crane\u2019s poison on the entire", "x0": 0.11001100110011001, "y0": 0.1522921522921523, "x1": 0.6171617161716172, "y1": 0.1655011655011655}, {"text": "RA\u2019S AL GHUL", "x0": 0.4312431243124312, "y0": 0.18337218337218336, "x1": 0.5687568756875687, "y1": 0.19502719502719504}, {"text": "Then watch Gotham tear itself apart through fear... .", "x0": 0.11001100110011001, "y0": 0.1926961926961927, "x1": 0.5324532453245324, "y1": 0.2191142191142191}, {"text": "WAYNE", "x0": 0.46314631463146316, "y0": 0.23465423465423466, "x1": 0.5368536853685368, "y1": 0.24397824397824397}, {"text": "You're going to destroy millions of lives.", "x0": 0.11001100110011001, "y0": 0.24164724164724163, "x1": 0.44224422442244227, "y1": 0.2680652680652681}, {"text": "RA\u2019S AL GHUL", "x0": 0.4312431243124312, "y0": 0.28205128205128205, "x1": 0.5687568756875687, "y1": 0.2937062937062937}, {"text": "Only a cynical man would call what these people have \u2018lives\u2019, Wayne.", "x0": 0.11001100110011001, "y0": 0.2999222999222999, "x1": 0.6765676567656765, "y1": 0.31313131313131315}, {"text": "steps out of the main hall and into a corridor.", "x0": 0.15071507150715072, "y0": 0.33255633255633255, "x1": 0.5148514851485149, "y1": 0.3457653457653458}, {"text": "INT. CORRIDOR, WAYNE MANOR - CONTINUOUS", "x0": 0.11001100110011001, "y0": 0.3815073815073815, "x1": 0.5698569856985699, "y1": 0.3939393939393939}, {"text": "The corridor is long and dark, lined with books and windows.", "x0": 0.1111111111111111, "y0": 0.41414141414141414, "x1": 0.6061606160616062, "y1": 0.42735042735042733}, {"text": "Outside across the darkened hills: the glow of Gotham.", "x0": 0.11001100110011001, "y0": 0.4467754467754468, "x1": 0.5533553355335533, "y1": 0.45998445998445997}, {"text": "RA\u2019S AL GHUL", "x0": 0.4312431243124312, "y0": 0.47863247863247865, "x1": 0.5687568756875687, "y1": 0.4902874902874903}, {"text": "People stacked like boxes. Families sleeping in garbage. Crime. Despair. This is not how man", "x0": 0.11001100110011001, "y0": 0.4965034965034965, "x1": 0.8657865786578658, "y1": 0.5097125097125097}, {"text": "was supposed to live.", "x0": 0.11001100110011001, "y0": 0.5128205128205128, "x1": 0.28052805280528054, "y1": 0.526029526029526}, {"text": "Ra\u2019s al Ghiil gestures at the distant glow of Gotham.", "x0": 0.10891089108910891, "y0": 0.5454545454545454, "x1": 0.5324532453245324, "y1": 0.5586635586635587}, {"text": "The League of Shadows has been a check against human corruption for thousands of years. We", "x0": 0.11001100110011001, "y0": 0.578088578088578, "x1": 0.8778877887788779, "y1": 0.5912975912975913}, {"text": "sacked Rome. Loaded trade ships with plague rats. Burned London to the ground. Every time", "x0": 0.11001100110011001, "y0": 0.5944055944055944, "x1": 0.8624862486248625, "y1": 0.6076146076146076}, {"text": "civilisation reaches the pinnacle of its decadence, we return to restore the balance.", "x0": 0.11001100110011001, "y0": 0.6107226107226107, "x1": 0.768976897689769, "y1": 0.6239316239316239}, {"text": "WAYNE", "x0": 0.46314631463146316, "y0": 0.6441336441336442, "x1": 0.5368536853685368, "y1": 0.6534576534576535}, {"text": "Gotham isn\u2019t beyond saving. There are good people here, people who -", "x0": 0.11001100110011001, "y0": 0.6604506604506605, "x1": 0.682068206820682, "y1": 0.6736596736596736}, {"text": "INT. CORRIDOR, WAYNE MANOR - CONTINUOUS", "x0": 0.11001100110011001, "y0": 0.7094017094017094, "x1": 0.5698569856985699, "y1": 0.7218337218337219}, {"text": "Ra\u2019s al Ghiil turns to Wayne.", "x0": 0.10891089108910891, "y0": 0.7583527583527584, "x1": 0.34213421342134215, "y1": 0.7715617715617715}, {"text": "RA\u2019S AL GHUL", "x0": 0.4312431243124312, "y0": 0.7731157731157731, "x1": 0.5687568756875687, "y1": 0.7847707847707848}, {"text": "You have no illusions about the world, Bruce. When I found you in that jail you were lost. But I", "x0": 0.11001100110011001, "y0": 0.790986790986791, "x1": 0.8833883388338833, "y1": 0.8041958041958042}, {"text": "believed in you. I took away your fear, and showed you a path. You were my greatest student . .", "x0": 0.11001100110011001, "y0": 0.8073038073038074, "x1": 0.8822882288228823, "y1": 0.8205128205128205}, {"text": ". it should be you standing by my side, saving the world.", "x0": 0.1111111111111111, "y0": 0.8236208236208237, "x1": 0.5643564356435643, "y1": 0.8368298368298368}, {"text": "WAYNE", "x0": 0.46314631463146316, "y0": 0.8578088578088578, "x1": 0.5368536853685368, "y1": 0.8671328671328671}, {"text": "I'll be standing right where I am now - between you and the people of Gotham.", "x0": 0.11001100110011001, "y0": 0.8733488733488733, "x1": 0.7480748074807481, "y1": 0.8865578865578866}, {"text": "Ra's al Ghiil looks at Wayne, hard. A door closing.", "x0": 0.10891089108910891, "y0": 0.905982905982906, "x1": 0.5203520352035204, "y1": 0.9191919191919192}], [], [{"text": "Section II: Electives", "x0": 0.11978021978021978, "y0": 0.12198912198912198, "x1": 0.31978021978021975, "y1": 0.13364413364413363}, {"text": "25 marks", "x0": 0.11978021978021978, "y0": 0.15773115773115773, "x1": 0.1989010989010989, "y1": 0.16705516705516704}, {"text": "Attempt Question 2", "x0": 0.11978021978021978, "y0": 0.17404817404817405, "x1": 0.2879120879120879, "y1": 0.1864801864801865}, {"text": "Allow about 1 hour for this section", "x0": 0.11978021978021978, "y0": 0.19114219114219114, "x1": 0.4186813186813187, "y1": 0.20046620046620048}, {"text": "Your answer will be assessed on how well you:", "x0": 0.14395604395604394, "y0": 0.24864024864024864, "x1": 0.5274725274725275, "y1": 0.2618492618492618}, {"text": "\u00abdemonstrate an understanding of the ideas and values of Literary Worlds", "x0": 0.14395604395604394, "y0": 0.2602952602952603, "x1": 0.7516483516483516, "y1": 0.2867132867132867}, {"text": "and how they are shaped and reflected in texts", "x0": 0.16703296703296702, "y0": 0.28593628593628595, "x1": 0.5417582417582417, "y1": 0.29914529914529914}, {"text": "\u00a9 craft a sustained composition appropriate to the question, demonstrating", "x0": 0.14395604395604394, "y0": 0.30536130536130535, "x1": 0.743956043956044, "y1": 0.3185703185703186}, {"text": "control of the use of language", "x0": 0.16703296703296702, "y0": 0.32245532245532244, "x1": 0.4065934065934066, "y1": 0.3356643356643357}, {"text": "Question 2", "x0": 0.12197802197802197, "y0": 0.3651903651903652, "x1": 0.21208791208791208, "y1": 0.3776223776223776}, {"text": "Elective 4: Literary Mindscapes (25 marks)", "x0": 0.12197802197802197, "y0": 0.3978243978243978, "x1": 0.49230769230769234, "y1": 0.411033411033411}, {"text": "In times of great change, we are challenged to hold on to our identity or forge new ways of", "x0": 0.12197802197802197, "y0": 0.43045843045843046, "x1": 0.8549450549450549, "y1": 0.44366744366744365}, {"text": "being and thinking.", "x0": 0.12197802197802197, "y0": 0.4467754467754468, "x1": 0.27582417582417584, "y1": 0.45998445998445997}, {"text": "To what extent do the texts that you have studied explore this idea in different ways? In your", "x0": 0.12197802197802197, "y0": 0.4662004662004662, "x1": 0.8582417582417582, "y1": 0.4794094794094794}, {"text": "response, refer to TWO prescribed texts and at least ONE related text of your own choosing.", "x0": 0.12197802197802197, "y0": 0.4825174825174825, "x1": 0.8571428571428571, "y1": 0.49572649572649574}, {"text": "Note: Representations of the mind, including desires, motivations, emotions and memories,", "x0": 0.12197802197802197, "y0": 0.5376845376845377, "x1": 0.856043956043956, "y1": 0.5508935508935509}, {"text": "communicate notions of identity and alternative ways of being and thinking.", "x0": 0.12197802197802197, "y0": 0.5454545454545454, "x1": 0.7351648351648352, "y1": 0.5718725718725719}, {"text": "The prescribed texts for Section II are:", "x0": 0.11978021978021978, "y0": 0.5928515928515928, "x1": 0.45494505494505494, "y1": 0.6052836052836053}, {"text": "@ Elective 1: Literary Homelands", "x0": 0.12087912087912088, "y0": 0.6394716394716394, "x1": 0.4142857142857143, "y1": 0.6534576534576535}, {"text": "+ Prose Fiction \u2014 Aravind Adiga, The White Tiger", "x0": 0.14395604395604394, "y0": 0.6767676767676768, "x1": 0.5967032967032967, "y1": 0.6899766899766899}, {"text": "\u2014 EM Forster, A Passage to India", "x0": 0.3087912087912088, "y0": 0.7031857031857032, "x1": 0.5956043956043956, "y1": 0.7163947163947164}, {"text": "\u2014 Colm T\u00e9ibin, Brooklyn", "x0": 0.3087912087912088, "y0": 0.7303807303807304, "x1": 0.5208791208791209, "y1": 0.7435897435897436}, {"text": "* Poetry \u2014 Eileen Chong, Burning Rice", "x0": 0.14395604395604394, "y0": 0.7668997668997669, "x1": 0.5615384615384615, "y1": 0.7801087801087802}, {"text": "The prescribed poems are:", "x0": 0.33406593406593404, "y0": 0.7902097902097902, "x1": 0.5461538461538461, "y1": 0.8034188034188035}, {"text": "* Burning Rice", "x0": 0.33516483516483514, "y0": 0.8135198135198135, "x1": 0.46373626373626375, "y1": 0.8267288267288267}, {"text": "* Mid-autumn Mooncakes", "x0": 0.33516483516483514, "y0": 0.8306138306138307, "x1": 0.5527472527472528, "y1": 0.8407148407148407}, {"text": "* My Hakka Grandmother", "x0": 0.33516483516483514, "y0": 0.846930846930847, "x1": 0.5560439560439561, "y1": 0.8601398601398601}, {"text": "* Shophouse, Victoria Street", "x0": 0.33516483516483514, "y0": 0.864024864024864, "x1": 0.5736263736263736, "y1": 0.8772338772338772}, {"text": "* Chinese Ginseng", "x0": 0.33516483516483514, "y0": 0.8803418803418803, "x1": 0.4945054945054945, "y1": 0.8935508935508936}, {"text": "* Winter Meeting", "x0": 0.33516483516483514, "y0": 0.8974358974358975, "x1": 0.4835164835164835, "y1": 0.9106449106449106}, {"text": "* Singapore", "x0": 0.33516483516483514, "y0": 0.9137529137529138, "x1": 0.43956043956043955, "y1": 0.9269619269619269}], [{"text": "\u2014 Andrew Bovell, The Secret River [by Kate Grenville \u2014 An", "x0": 0.3087912087912088, "y0": 0.0979020979020979, "x1": 0.8032967032967033, "y1": 0.1111111111111111}, {"text": "Drama", "x0": 0.16703296703296702, "y0": 0.09867909867909867, "x1": 0.22637362637362637, "y1": 0.108003108003108}, {"text": "adaptation for the stage by Andrew Bovell]", "x0": 0.33406593406593404, "y0": 0.11421911421911422, "x1": 0.6846153846153846, "y1": 0.12742812742812742}, {"text": "Film", "x0": 0.16703296703296702, "y0": 0.15151515151515152, "x1": 0.20549450549450549, "y1": 0.16161616161616163}, {"text": "\u2014 Sarah Gavron, Brick Lane", "x0": 0.3087912087912088, "y0": 0.15151515151515152, "x1": 0.545054945054945, "y1": 0.16394716394716394}], [{"text": "@ Elective 2: Worlds of Upheaval", "x0": 0.12087912087912088, "y0": 0.08003108003108003, "x1": 0.41208791208791207, "y1": 0.09401709401709402}, {"text": "Elizabeth Gaskell, North and South", "x0": 0.33516483516483514, "y0": 0.11810411810411811, "x1": 0.6197802197802198, "y1": 0.12975912975912976}, {"text": "Prose Fiction", "x0": 0.16813186813186815, "y0": 0.11888111888111888, "x1": 0.27912087912087913, "y1": 0.1282051282051282}, {"text": "Mary Shelley, Frankenstein", "x0": 0.33406593406593404, "y0": 0.1445221445221445, "x1": 0.5582417582417583, "y1": 0.15773115773115773}, {"text": "Madeleine Thien, Do Not Say We Have Nothing", "x0": 0.33406593406593404, "y0": 0.1717171717171717, "x1": 0.7252747252747253, "y1": 0.18492618492618493}, {"text": "Seamus Heaney, Opened Ground: Poems 1966-1996", "x0": 0.33516483516483514, "y0": 0.20823620823620823, "x1": 0.7692307692307693, "y1": 0.22144522144522144}, {"text": "Poetry", "x0": 0.16813186813186815, "y0": 0.20901320901320902, "x1": 0.2230769230769231, "y1": 0.22144522144522144}, {"text": "The prescribed poems are:", "x0": 0.33406593406593404, "y0": 0.23154623154623155, "x1": 0.5461538461538461, "y1": 0.24475524475524477}, {"text": "* Digging", "x0": 0.33516483516483514, "y0": 0.25485625485625485, "x1": 0.4230769230769231, "y1": 0.2680652680652681}, {"text": "* The Strand at Lough Beg", "x0": 0.33516483516483514, "y0": 0.27195027195027194, "x1": 0.5615384615384615, "y1": 0.2851592851592852}, {"text": "* Casualty", "x0": 0.33516483516483514, "y0": 0.28826728826728826, "x1": 0.42857142857142855, "y1": 0.3014763014763015}, {"text": "* Funeral Rites", "x0": 0.33516483516483514, "y0": 0.30536130536130535, "x1": 0.46703296703296704, "y1": 0.31546231546231546}, {"text": "* Whatever You Say Say Nothing", "x0": 0.33516483516483514, "y0": 0.32167832167832167, "x1": 0.610989010989011, "y1": 0.3348873348873349}, {"text": "* Triptych", "x0": 0.33516483516483514, "y0": 0.33877233877233875, "x1": 0.42417582417582417, "y1": 0.351981351981352}, {"text": "Samuel Beckett, Waiting for Godot", "x0": 0.33516483516483514, "y0": 0.3752913752913753, "x1": 0.6197802197802198, "y1": 0.3885003885003885}, {"text": "Drama", "x0": 0.16703296703296702, "y0": 0.37606837606837606, "x1": 0.22637362637362637, "y1": 0.3853923853923854}, {"text": "Fritz Lang, Metropolis", "x0": 0.33516483516483514, "y0": 0.4125874125874126, "x1": 0.5164835164835165, "y1": 0.4257964257964258}, {"text": "Film", "x0": 0.16703296703296702, "y0": 0.4133644133644134, "x1": 0.20549450549450549, "y1": 0.4226884226884227}], [{"text": "@ Elective 3: Reimagined Worlds", "x0": 0.12087912087912088, "y0": 0.08003108003108003, "x1": 0.41098901098901097, "y1": 0.09401709401709402}, {"text": "\u2014 Italo Calvino, [fon a Winter\u2019s Night a Traveller", "x0": 0.3087912087912088, "y0": 0.10955710955710955, "x1": 0.7252747252747253, "y1": 0.13597513597513597}, {"text": "Prose Fiction", "x0": 0.16813186813186815, "y0": 0.11888111888111888, "x1": 0.27912087912087913, "y1": 0.1282051282051282}, {"text": "\u2014 Ursula Le Guin, The Left Hand of Darkness", "x0": 0.3087912087912088, "y0": 0.1445221445221445, "x1": 0.6901098901098901, "y1": 0.15773115773115773}, {"text": "\u2014 Jonathan Swift, Gulliver's Travels", "x0": 0.3087912087912088, "y0": 0.1717171717171717, "x1": 0.6120879120879121, "y1": 0.18414918414918416}, {"text": "\u2014 Samuel Taylor Coleridge, Samuel Taylor Coleridge: The Complete", "x0": 0.3087912087912088, "y0": 0.20823620823620823, "x1": 0.878021978021978, "y1": 0.22144522144522144}, {"text": "Poetry", "x0": 0.16813186813186815, "y0": 0.20901320901320902, "x1": 0.2230769230769231, "y1": 0.22144522144522144}, {"text": "Poems", "x0": 0.33296703296703295, "y0": 0.2261072261072261, "x1": 0.38571428571428573, "y1": 0.23543123543123542}, {"text": "The prescribed poems are:", "x0": 0.33406593406593404, "y0": 0.24864024864024864, "x1": 0.5461538461538461, "y1": 0.2618492618492618}, {"text": "* The Rime of the Ancient Mariner (1834)", "x0": 0.33516483516483514, "y0": 0.27195027195027194, "x1": 0.6835164835164835, "y1": 0.2851592851592852}, {"text": "* The Eolian Harp", "x0": 0.33516483516483514, "y0": 0.28826728826728826, "x1": 0.4945054945054945, "y1": 0.3014763014763015}, {"text": "* Kubla Khan", "x0": 0.33516483516483514, "y0": 0.30536130536130535, "x1": 0.45494505494505494, "y1": 0.31546231546231546}, {"text": "* Christabel", "x0": 0.33516483516483514, "y0": 0.32167832167832167, "x1": 0.44285714285714284, "y1": 0.3317793317793318}, {"text": "\u2014 Tracy K Smith, Life on Mars", "x0": 0.3087912087912088, "y0": 0.358974358974359, "x1": 0.5692307692307692, "y1": 0.37218337218337216}, {"text": "The prescribed poems are:", "x0": 0.33406593406593404, "y0": 0.3822843822843823, "x1": 0.546