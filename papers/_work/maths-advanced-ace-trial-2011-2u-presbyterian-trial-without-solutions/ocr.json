7645764576457645, "y1": 0.19735819735819735}, {"text": "minutes at a constant rate until it reaches 100km/h and maintains this", "x0": 0.22442244224422442, "y0": 0.19658119658119658, "x1": 0.7887788778877888, "y1": 0.2066822066822067}, {"text": "velocity for a further 5 minutes.", "x0": 0.22442244224422442, "y0": 0.21522921522921523, "x1": 0.47854785478547857, "y1": 0.22843822843822845}, {"text": "At this time each of the trains then begin to slow down at a constant rate,", "x0": 0.22442244224422442, "y0": 0.24786324786324787, "x1": 0.8096809680968097, "y1": 0.26107226107226106}, {"text": "arriving at the next station, X, at the same time.", "x0": 0.22442244224422442, "y0": 0.2641802641802642, "x1": 0.6028602860286029, "y1": 0.2773892773892774}, {"text": "The graph of velocity versus time for the first train has been drawn", "x0": 0.22332233223322331, "y0": 0.29448329448329447, "x1": 0.7623762376237624, "y1": 0.3139083139083139}, {"text": "below:", "x0": 0.22442244224422442, "y0": 0.3146853146853147, "x1": 0.2761276127612761, "y1": 0.32400932400932403}, {"text": "y", "x0": 0.3124312431243124, "y0": 0.33255633255633255, "x1": 0.32123212321232125, "y1": 0.34032634032634035}, {"text": "*", "x0": 0.31133113311331134, "y0": 0.3504273504273504, "x1": 0.32123212321232125, "y1": 0.35742035742035744}, {"text": "80", "x0": 0.29262926292629265, "y0": 0.40559440559440557, "x1": 0.31133113311331134, "y1": 0.4156954156954157}, {"text": ">t", "x0": 0.7029702970297029, "y0": 0.47785547785547783, "x1": 0.7315731573157316, "y1": 0.48795648795648794}, {"text": "+ (hours)", "x0": 0.6490649064906491, "y0": 0.49417249417249415, "x1": 0.7612761276127613, "y1": 0.5073815073815073}, {"text": "Copy or trace this diagram on your answer sheet.", "x0": 0.22442244224422442, "y0": 0.5439005439005439, "x1": 0.6182618261826183, "y1": 0.5563325563325563}, {"text": "s in part i) draw in the velocity/time graph for the", "x0": 0.39933993399339934, "y0": 0.5920745920745921, "x1": 0.7920792079207921, "y1": 0.6052836052836053}, {"text": "On the same sketch", "x0": 0.22442244224422442, "y0": 0.5928515928515928, "x1": 0.3795379537953795, "y1": 0.6021756021756022}, {"text": "second train.", "x0": 0.22442244224422442, "y0": 0.6091686091686092, "x1": 0.32453245324532454, "y1": 0.6184926184926185}, {"text": "iii)", "x0": 0.1771177117711771, "y0": 0.6410256410256411, "x1": 0.19911991199119913, "y1": 0.6534576534576535}, {"text": "Calculate the time taken for the trains to travel between the two stations.", "x0": 0.22442244224422442, "y0": 0.6410256410256411, "x1": 0.8063806380638063, "y1": 0.6511266511266511}, {"text": "iv)", "x0": 0.1771177117711771, "y0": 0.6744366744366744, "x1": 0.19801980198019803, "y1": 0.6868686868686869}, {"text": "How far apart are the two stations?", "x0": 0.22772277227722773, "y0": 0.6744366744366744, "x1": 0.5082508250825083, "y1": 0.6876456876456877}, {"text": "End of Examination", "x0": 0.35533553355335534, "y0": 0.8243978243978244, "x1": 0.6435643564356436, "y1": 0.8407148407148407}, {"text": "PLC Sydney", "x0": 0.11991199119911991, "y0": 0.9347319347319347, "x1": 0.19141914191419143, "y1": 0.9417249417249417}, {"text": "Mathematics Trial HSC, 2011", "x0": 0.12101210121012101, "y0": 0.9471639471639471, "x1": 0.30033003300330036, "y1": 0.9541569541569541}, {"text": "Page 11", "x0": 0.8338833883388339, "y0": 0.9471639471639471, "x1": 0.8800880088008801, "y1": 0.9564879564879565}], [{"text": "STANDARD INTEGRALS", "x0": 0.3564356435643564, "y0": 0.08780108780108781, "x1": 0.6446644664466447, "y1": 0.09945609945609946}, {"text": "fora oy, x40, ifn<0", "x0": 0.23322332233223322, "y0": 0.108003108003108, "x1": 0.7678767876787679, "y1": 0.14918414918414918}, {"text": "n+l", "x0": 0.44884488448844884, "y0": 0.1351981351981352, "x1": 0.48954895489548955, "y1": 0.14685314685314685}, {"text": "1", "x0": 0.2585258525852585, "y0": 0.18181818181818182, "x1": 0.264026402640264, "y1": 0.19347319347319347}, {"text": "\u2014dx =Inx, x>0", "x0": 0.254125412541