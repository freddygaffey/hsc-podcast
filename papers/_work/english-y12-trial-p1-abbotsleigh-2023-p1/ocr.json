1": 0.7031857031857032}, {"text": "+ Drama", "x0": 0.12197802197802197, "y0": 0.7482517482517482, "x1": 0.19230769230769232, "y1": 0.7575757575757576}, {"text": "\u2014 Jane Harrison, Rainbow's End, from Vivienne Cleven et al., Contemporary Indigenous", "x0": 0.12527472527472527, "y0": 0.7746697746697747, "x1": 0.8373626373626374, "y1": 0.7878787878787878}, {"text": "Plays", "x0": 0.12087912087912088, "y0": 0.7925407925407926, "x1": 0.16483516483516483, "y1": 0.8057498057498057}, {"text": "\u2014 Arthur Miller, The Crucible", "x0": 0.12087912087912088, "y0": 0.8197358197358198, "x1": 0.36043956043956044, "y1": 0.8321678321678322}], [{"text": "+ Shakespearean Drama", "x0": 0.12197802197802197, "y0": 0.08935508935508936, "x1": 0.3274725274725275, "y1": 0.10178710178710179}, {"text": "\u2014 William Shakespeare, The Merchant of Venice", "x0": 0.12087912087912088, "y0": 0.11577311577311578, "x1": 0.512087912087912, "y1": 0.128982128982129}, {"text": "+ Nonfiction", "x0": 0.12197802197802197, "y0": 0.17094017094017094, "x1": 0.2230769230769231, "y1": 0.18026418026418026}, {"text": "\u2014Tim Winton, The Boy Behind the Curtain", "x0": 0.12087912087912088, "y0": 0.19735819735819735, "x1": 0.4703296703296703, "y1": 0.21056721056721056}, {"text": "\u00a9 Havoc: A Life in Accidents", "x0": 0.15164835164835164, "y0": 0.22533022533022534, "x1": 0.4032967032967033, "y1": 0.23543123543123542}, {"text": "Betsy", "x0": 0.1824175824175824, "y0": 0.24475524475524477, "x1": 0.22637362637362637, "y1": 0.2571872571872572}, {"text": "\u00a9 Twice on Sundays", "x0": 0.15164835164835164, "y0": 0.26262626262626265, "x1": 0.32967032967032966, "y1": 0.27583527583527584}, {"text": "\u00a9 The Wait and the Flow", "x0": 0.15164835164835164, "y0": 0.28205128205128205, "x1": 0.3659340659340659, "y1": 0.29215229215229216}, {"text": "In the Shadow of the Hospital", "x0": 0.1824175824175824, "y0": 0.29215229215229216, "x1": 0.4208791208791209, "y1": 0.3185703185703186}, {"text": "\u00a9 The Demon Shark", "x0": 0.15164835164835164, "y0": 0.31934731934731936, "x1": 0.32857142857142857, "y1": 0.32944832944832947}, {"text": "\u00a9 Barefoot in the Temple of Art", "x0": 0.15164835164835164, "y0": 0.337995337995338, "x1": 0.421978021978022, "y1": 0.35120435120435123}, {"text": "\u2014Malala Yousafzai and Christina Lamb, J am Malala", "x0": 0.12087912087912088, "y0": 0.3822843822843823, "x1": 0.5527472527472528, "y1": 0.3947163947163947}, {"text": "+ Film", "x0": 0.12197802197802197, "y0": 0.43745143745143744, "x1": 0.17252747252747253, "y1": 0.4467754467754468}, {"text": "\u2014 Stephen Daldry, Billy Elliot", "x0": 0.12527472527472527, "y0": 0.46386946386946387, "x1": 0.3648351648351648, "y1": 0.47707847707847706}, {"text": "+ Media", "x0": 0.12197802197802197, "y0": 0.519036519036519, "x1": 0.18681318681318682, "y1": 0.5283605283605284}, {"text": "\u2014 Ivan", "x0": 0.12087912087912088, "y0": 0.5462315462315462, "x1": 0.17142857142857143, "y1": 0.5555555555555556}, {"text": "* Go Back to Where You Came From", "x0": 0.15164835164835164, "y0": 0.5742035742035742, "x1": 0.46593406593406594, "y1": 0.5843045843045843}, {"text": "~ Series 1: Episodes 1, 2 and 3", "x0": 0.1813186813186813, "y0": 0.6006216006216006, "x1": 0.42637362637362636, "y1": 0.6138306138306139}, {"text": "and", "x0": 0.1824175824175824, "y0": 0.6285936285936286, "x1": 0.2098901098901099, "y1": 0.6386946386946387}, {"text": "\u00a9 The Response", "x0": 0.15164835164835164, "y0": 0.6565656565656566, "x1": 0.2923076923076923, "y1": 0.6697746697746698}, {"text": "\u2014 Lucy Walker, Waste Land", "x0": 0.1813186813186813, "y0": 0.6837606837606838, "x1": 0.4087912087912088, "y1": 0.696969696969697}, {"text": "10", "x0": 0.49230769230769234, "y0": 0.9292929292929293, "x1": 0.5087912087912088, "y1": 0.9378399378399378}], [{"text": "STUDENT NUMBER", "x0": 0.6054945054945055, "y0": 0.11965811965811966, "x1": 0.8175824175824176, "y1": 0.13131313131313133}, {"text": "ABBOTSLEIGH", "x0": 0.12197802197802197, "y0": 0.2400932400932401, "x1": 0.2923076923076923, "y1": 0.2517482517482518}, {"text": "2023 HSC TRIAL EXAMINATION", "x0": 0.12197802197802197, "y0": 0.3006993006993007, "x1": 0.5340659340659341, "y1": 0.3139083139083139}, {"text": "English Advanced", "x0": 0.12197802197802197, "y0": 0.3356643356643357, "x1": 0.4054945054945055, "y1": 0.358974358974359}, {"text": "Paper 1 \u2014 Texts and Human Experiences", "x0": 0.12197802197802197, "y0": 0.40714840714840717, "x1": 0.7032967032967034, "y1": 0.4289044289044289}, {"text": "STIMULUS BOOKLET", "x0": 0.12307692307692308, "y0": 0.4763014763014763, "x1": 0.4714285714285714, "y1": 0.4933954933954934}, {"text": "Section I", "x0": 0.12197802197802197, "y0": 0.5135975135975136, "x1": 0.21978021978021978, "y1": 0.5268065268065268}, {"text": "Text One \u2014 Illustration.", "x0": 0.1824175824175824, "y0": 0.5796425796425796, "x1": 0.3747252747252747, "y1": 0.5897435897435898}, {"text": "Text Two \u2014 Poem", "x0": 0.1824175824175824, "y0": 0.5990675990675991, "x1": 0.32857142857142857, "y1": 0.6083916083916084}, {"text": "Text Three \u2014 Discur:", "x0": 0.1824175824175824, "y0": 0.616938616938617, "x1": 0.3505494505494505, "y1": 0.627039627039627}, {"text": "e", "x0": 0.3747252747252747, "y0": 0.6208236208236209, "x1": 0.3824175824175824, "y1": 0.627039627039627}, {"text": "Text Four \u2014 Prose fiction extra", "x0": 0.1824175824175824, "y0": 0.6355866355866356, "x1": 0.4351648351648352, "y1": 0.6456876456876457}, {"text": "Text Five \u2014 Persuasive", "x0": 0.1824175824175824, "y0": 0.6557886557886557, "x1": 0.36813186813186816, "y1": 0.6651126651126651}], [{"text": "Text 1 \u2014 Illustration", "x0": 0.12087912087912088, "y0": 0.08857808857808858, "x1": 0.2923076923076923, "y1": 0.09867909867909867}, {"text": "FIND A SPOT WHERE DIG A BIG ENOUGH WATER IT IN.", "x0": 0.24725274725274726, "y0": 0.17560217560217561, "x1": 0.7516483516483516, "y1": 0.1864801864801865}, {"text": "\\T CAN GROW. Hote", "x0": 0.2692307692307692, "y0": 0.1895881895881896, "x1": 0.5274725274725275, "y1": 0.1989121989121989}, {"text": "TAKE To PRETEND To IT", "x0": 0.26593406593406593, "y0": 0.30924630924630925, "x1": 0.7483516483516484, "y1": 0.31934731934731936}, {"text": "WONDER. EVERY DAY.", "x0": 0.2956043956043956, "y0": 0.3209013209013209, "x1": 0.7329670329670329, "y1": 0.33255633255633255}, {"text": "SHARE IT @Row A FoREST !", "x0": 0.45054945054945056, "y0": 0.45843045843045843, "x1": 0.7835164835164835, "y1": 0.4801864801864802}, {"text": "WITH OTHERS", "x0": 0.4582417582417582, "y0": 0.47474747474747475, "x1": 0.5604395604395604, "y1": 0.4840714840714841}, {"text": "FIND A NEW SPOT", "x0": 0.634065934065934, "y0": 0.6542346542346542, "x1": 0.7549450549450549, "y1": 0.6643356643356644}, {"text": "WHERE iT CAN GROW.", "x0": 0.6329670329670329, "y0": 0.6666666666666666, "x1": 0.7879120879120879, "y1": 0.675990675990676}, {"text": "The Shape of Ideas", "x0": 0.667032967032967, "y0": 0.822066822066822, "x1": 0.8186813186813187, "y1": 0.8352758352758353}, {"text": "GRANT SNIDER.", "x0": 0.6648351648351648, "y0": 0.8492618492618492, "x1": 0.8120879120879121, "y1": 0.8601398601398601}], [{"text": "Text 2\u2014 Poem", "x0": 0.12197802197802197, "y0": 0.08935508935508936, "x1": 0.24175824175824176, "y1": 0.09867909867909867}, {"text": "Dawn service", "x0": 0.12087912087912088, "y0": 0.11655011655011654, "x1": 0.23186813186813188, "y1": 0.1258741258741259}, {"text": "Five and a hungry lamb wail from the cot", "x0": 0.12197802197802197, "y0": 0.15151515151515152, "x1": 0.5, "y1": 0.16472416472416473}, {"text": "as the murmuring clock radio says it\u2019s Anzac Day.", "x0": 0.12197802197802197, "y0": 0.1686091686091686, "x1": 0.5274725274725275, "y1": 0.18181818181818182}, {"text": "The world belongs to war veterans and breastfeeding mothers,", "x0": 0.12087912087912088, "y0": 0.1864801864801865, "x1": 0.621978021978022, "y1": 0.19968919968919968}, {"text": "all rising for the dawn service.", "x0": 0.12197802197802197, "y0": 0.20435120435120435, "x1": 0.3648351648351648, "y1": 0.21756021756021757}, {"text": "A\\ll of us in shared testimony to the same belief,", "x0": 0.12087912087912088, "y0": 0.23076923076923078, "x1": 0.5054945054945055, "y1": 0.2571872571872572}, {"text": "our minute\u2019s silence to what stays unacknowledged,", "x0": 0.12197802197802197, "y0": 0.2571872571872572, "x1": 0.5395604395604395, "y1": 0.2703962703962704}, {"text": "all the unfathomable, exhausted sacrifice", "x0": 0.12197802197802197, "y0": 0.27505827505827507, "x1": 0.44945054945054946, "y1": 0.2874902874902875}, {"text": "of our mutely bowed heads.", "x0": 0.12197802197802197, "y0": 0.29292929292929293, "x1": 0.34395604395604396, "y1": 0.3061383061383061}, {"text": "The baby\u2019s eyes, absorbed and concentrating,", "x0": 0.12087912087912088, "y0": 0.3278943278943279, "x1": 0.4868131868131868, "y1": 0.3411033411033411}, {"text": "stare over my shoulder as if there\u2019s something", "x0": 0.12197802197802197, "y0": 0.3457653457653458, "x1": 0.49230769230769234, "y1": 0.358974358974359}, {"text": "of huge, ungraspable portent* on the horizon \u2014", "x0": 0.12197802197802197, "y0": 0.36363636363636365, "x1": 0.4978021978021978, "y1": 0.37684537684537683}, {"text": "men coming over battlements, say,", "x0": 0.12197802197802197, "y0": 0.38073038073038074, "x1": 0.4010989010989011, "y1": 0.3939393939393939}, {"text": "arising sun cold as steel,", "x0": 0.12197802197802197, "y0": 0.3986013986013986, "x1": 0.3208791208791209, "y1": 0.41181041181041184}, {"text": "a glint of bayonets above the cliffs.", "x0": 0.12197802197802197, "y0": 0.41647241647241645, "x1": 0.4032967032967033, "y1": 0.4296814296814297}, {"text": "\u2018A tiny frown creases her forehead", "x0": 0.12087912087912088, "y0": 0.45143745143745145, "x1": 0.3934065934065934, "y1": 0.46464646464646464}, {"text": "and her hand jerks up and comes to rest", "x0": 0.12197802197802197, "y0": 0.4693084693084693, "x1": 0.43956043956043955, "y1": 0.4825174825174825}, {"text": "against her face.", "x0": 0.12197802197802197, "y0": 0.48717948717948717, "x1": 0.25054945054945055, "y1": 0.5003885003885004}, {"text": "We sit there milk-drunk, humming, somnolent,**", "x0": 0.12197802197802197, "y0": 0.5050505050505051, "x1": 0.5197802197802198, "y1": 0.5182595182595182}, {"text": "the breaking dawn scudding like a prow*** towards the shore", "x0": 0.12197802197802197, "y0": 0.5221445221445221, "x1": 0.6197802197802198, "y1": 0.5353535353535354}, {"text": "and onwards, boys, to glory -", "x0": 0.12197802197802197, "y0": 0.54001554001554, "x1": 0.35604395604395606, "y1": 0.5532245532245532}, {"text": "because there she lies, the quiet hard-won miracle of her", "x0": 0.12087912087912088, "y0": 0.5757575757575758, "x1": 0.5747252747252747, "y1": 0.5889665889665889}, {"text": "gazing past me at something beyond my vision", "x0": 0.12197802197802197, "y0": 0.5928515928515928, "x1": 0.4989010989010989, "y1": 0.6060606060606061}, {"text": "my perfect little opus.", "x0": 0.12197802197802197, "y0": 0.6107226107226107, "x1": 0.2967032967032967, "y1": 0.6239316239316239}, {"text": "There is no trumpet playing the last post, no drums.", "x0": 0.12087912087912088, "y0": 0.6464646464646465, "x1": 0.5351648351648352, "y1": 0.6596736596736597}, {"text": "Just her curving cheek,", "x0": 0.12087912087912088, "y0": 0.6635586635586636, "x1": 0.3054945054945055, "y1": 0.6767676767676768}, {"text": "unsullied and fragile and full of promise,", "x0": 0.12197802197802197, "y0": 0.6814296814296814, "x1": 0.44945054945054946, "y1": 0.6946386946386947}, {"text": "her slight but determined breathing", "x0": 0.12197802197802197, "y0": 0.6993006993006993, "x1": 0.4032967032967033, "y1": 0.7125097125097125}, {"text": "as she pulls all nourishment into herself,", "x0": 0.12197802197802197, "y0": 0.7171717171717171, "x1": 0.44505494505494503, "y1": 0.7303807303807304}, {"text": "and that small hand raising itself softly, insistently,", "x0": 0.12197802197802197, "y0": 0.7264957264957265, "x1": 0.5307692307692308, "y1": 0.7505827505827506}, {"text": "like an envoy stepping out into no-man\u2019s land", "x0": 0.12197802197802197, "y0": 0.7521367521367521, "x1": 0.4901098901098901, "y1": 0.7653457653457654}, {"text": "calling for peace.", "x0": 0.12197802197802197, "y0": 0.77000777000777, "x1": 0.25824175824175827, "y1": 0.7832167832167832}, {"text": "* portent \u2014 a sign, omen or warning of a terrible future event", "x0": 0.12307692307692308, "y0": 0.815073815073815, "x1": 0.532967032967033, "y1": 0.8383838383838383}, {"text": "** somnolent \u2014 sleepy or drowsy", "x0": 0.12307692307692308, "y0": 0.8298368298368298, "x1": 0.34395604395604396, "y1": 0.8531468531468531}, {"text": "prow \u2014 the pointed front part of a ship", "x0": 0.14945054945054945, "y0": 0.8515928515928516, "x1": 0.4076923076923077, "y1": 0.8624708624708625}, {"text": "CATE KENNEDY", "x0": 0.6659340659340659, "y0": 0.8857808857808858, "x1": 0.8186813186813187, "y1": 0.8951048951048951}], [{"text": "Text 3 \u2014 Discursive extract", "x0": 0.12197802197802197, "y0": 0.08935508935508936, "x1": 0.34945054945054943, "y1": 0.09867909867909867}, {"text": "from On Travel", "x0": 0.12197802197802197, "y0": 0.12432012432012432, "x1": 0.25384615384615383, "y1": 0.13442113442113443}, {"text": "HOME", "x0": 0.12197802197802197, "y0": 0.16006216006216006, "x1": 0.1835164835164835, "y1": 0.16938616938616938}, {"text": "\u2018No one realises how it is to travel until he comes home and rests his head on his old,", "x0": 0.12527472527472527, "y0": 0.19502719502719504, "x1": 0.8769230769230769, "y1": 0.2066822066822067}, {"text": "familiar pillow.\u2019 (Lin Yutang, writer and philosopher)", "x0": 0.11758241758241758, "y0": 0.21212121212121213, "x1": 0.554945054945055, "y1": 0.22533022533022534}, {"text": "\u2018Holiday home\u2019 has to be a modern oxymoron \u2014 a holiday is something we do when we leave", "x0": 0.12307692307692308, "y0": 0.24786324786324787, "x1": 0.878021978021978, "y1": 0.26107226107226106}, {"text": "home, isn\u2019t it? Yet some of the very best travel doesn\u2019t involve much travel at all, it\u2019s simply", "x0": 0.12197802197802197, "y0": 0.257964257964258, "x1": 0.878021978021978, "y1": 0.28205128205128205}, {"text": "going somewhere and putting down temporary roots. If the travel experience improves when", "x0": 0.12197802197802197, "y0": 0.2828282828282828, "x1": 0.878021978021978, "y1": 0.29603729603729606}, {"text": "we slow down, then surely the best travel of all is the slowest of all, simply going somewhere", "x0": 0.12197802197802197, "y0": 0.29292929292929293, "x1": 0.878021978021978, "y1": 0.317016317016317}, {"text": "and going native? Certainly some of the best \u2014 and bestselling \u2014 travel books are about that", "x0": 0.12197802197802197, "y0": 0.3108003108003108, "x1": 0.878021978021978, "y1": 0.3348873348873349}, {"text": "attempt to establish another home, perhaps somewhere comfortably familiar, but with a better", "x0": 0.12197802197802197, "y0": 0.33644133644133645, "x1": 0.8791208791208791, "y1": 0.34965034965034963}, {"text": "climate and more interesting food. Even dealing with the builders \u2014 who display all the same", "x0": 0.12197802197802197, "y0": 0.35353535353535354, "x1": 0.878021978021978, "y1": 0.3667443667443667}, {"text": "undesirable habits as the ones back home \u2014 is more interesting when it\u2019s done in French, Italian", "x0": 0.12197802197802197, "y0": 0.3714063714063714, "x1": 0.878021978021978, "y1": 0.38461538461538464}, {"text": "or Indonesian.", "x0": 0.12197802197802197, "y0": 0.38927738927738925, "x1": 0.23406593406593407, "y1": 0.39937839937839936}, {"text": "Or there\u2019s the attempt to make a home somewhere utterly, scarily different from the familiar", "x0": 0.12197802197802197, "y0": 0.42424242424242425, "x1": 0.8791208791208791, "y1": 0.43745143745143744}, {"text": "one \u2014 an Antarctic exile at one extreme, a tropical castaway at the other. Two of my favourite", "x0": 0.12197802197802197, "y0": 0.4421134421134421, "x1": 0.878021978021978, "y1": 0.4553224553224553}, {"text": "travel tales encompass exactly those extremes. In 1961, Duncan Carse was dropped off with", "x0": 0.12197802197802197, "y0": 0.45998445998445997, "x1": 0.878021978021978, "y1": 0.4731934731934732}, {"text": "12 tonnes of supplies on a remote beach on the island of South Georgia to enjoy a spell as an", "x0": 0.12417582417582418, "y0": 0.47785547785547783, "x1": 0.878021978021978, "y1": 0.49106449106449107}, {"text": "Antarctic Robinson Crusoe. Three months later a freak wave crashed Carse, fast asleep at the", "x0": 0.12087912087912088, "y0": 0.494949494949495, "x1": 0.878021978021978, "y1": 0.5081585081585082}, {"text": "time, his hut and most of his supplies into the sea. Remarkably he managed to crawl ashore and", "x0": 0.12197802197802197, "y0": 0.5128205128205128, "x1": 0.878021978021978, "y1": 0.526029526029526}, {"text": "salvage enough equipment to survive the frigid winter until a passing sealing ship rescued him", "x0": 0.12197802197802197, "y0": 0.5306915306915307, "x1": 0.878021978021978, "y1": 0.5439005439005439}, {"text": "four months later.", "x0": 0.12197802197802197, "y0": 0.5477855477855478, "x1": 0.26373626373626374, "y1": 0.5578865578865578}, {"text": "Tom Neale was a much more traditional castaway, spending 16 years in three separate spells", "x0": 0.12087912087912088, "y0": 0.5835275835275835, "x1": 0.878021978021978, "y1": 0.5967365967365967}, {"text": "on the out-of-the-way island of Suwarrow in the Cook Islands. His book An Island to Oneself", "x0": 0.12197802197802197, "y0": 0.6013986013986014, "x1": 0.8824175824175824, "y1": 0.6146076146076146}, {"text": "has made his island a pilgrimage spot for Pacific yachties. Tom Hanks also made an island into", "x0": 0.12197802197802197, "y0": 0.6192696192696193, "x1": 0.878021978021978, "y1": 0.6324786324786325}, {"text": "a pilgrimage spot with the movie Castaway. Even a we seem to want the comforts", "x0": 0.12197802197802197, "y0": 0.6363636363636364, "x1": 0.878021978021978, "y1": 0.6495726495726496}, {"text": "of home. Weather apart, Carse was doing okay until the unexpected wave swept his supplies", "x0": 0.12197802197802197, "y0": 0.6542346542346542, "x1": 0.878021978021978, "y1": 0.6674436674436675}, {"text": "away. Island life for Tom Neale was much more organised than for Tom Hanks. Like Carse,", "x0": 0.12197802197802197, "y0": 0.6721056721056721, "x1": 0.8769230769230769, "y1": 0.6853146853146853}, {"text": "Neale wasn\u2019t shipwrecked, his castaway spell was carefully planned and well provisioned.", "x0": 0.12197802197802197, "y0": 0.6899766899766899, "x1": 0.8769230769230769, "y1": 0.7031857031857032}, {"text": "We\u2019re fascinated by Robinson Crusoe in part because he managed to turn his isolated hideaway", "x0": 0.12197802197802197, "y0": 0.7070707070707071, "x1": 0.878021978021978, "y1": 0.7202797202797203}, {"text": "into a reasonable facsimile of home.", "x0": 0.12197802197802197, "y0": 0.7218337218337219, "x1": 0.41098901098901097, "y1": 0.7420357420357421}, {"text": "The things that make home so comfortable and familiar are often exactly what we're trying to", "x0": 0.12087912087912088, "y0": 0.7606837606837606, "x1": 0.878021978021978, "y1": 0.7738927738927739}, {"text": "cast off when we travel. The pleasure of a tent is that it\u2019s not home; it may have few of the", "x0": 0.12197802197802197, "y0": 0.7777777777777778, "x1": 0.878021978021978, "y1": 0.790986790986791}, {"text": "comforts of home, but it also contains few of the responsibilities. So long as you've taken the", "x0": 0.12197802197802197, "y0": 0.7956487956487956, "x1": 0.878021978021978, "y1": 0.8088578088578089}, {"text": "\u2018travel light\u2019 lesson to heart, the zen of travel is exactly that \u2014 it can be a zen existence, stripped", "x0": 0.12307692307692308, "y0": 0.8057498057498057, "x1": 0.878021978021978, "y1": 0.8298368298368298}, {"text": "back to essentials. Sometimes we simply need to leave home, to get kicked out of that", "x0": 0.12087912087912088, "y0": 0.8313908313908314, "x1": 0.878021978021978, "y1": 0.8445998445998446}, {"text": "comfortable nest, just like fledgling birds.", "x0": 0.12197802197802197, "y0": 0.8484848484848485, "x1": 0.45714285714285713, "y1": 0.8616938616938616}, {"text": "TONY WHEELER", "x0": 0.6648351648351648, "y0": 0.885003885003885, "x1": 0.8219780219780219, "y1": 0.8943278943278943}], [{"text": "Text 4 \u2014 Prose fiction extracts", "x0": 0.08547008547008547, "y0": 0.12527472527472527, "x1": 0.26573426573426573, "y1": 0.13956043956043956}, {"text": "from Extremely Loud and Incredibly Close", "x0": 0.08624708624708624, "y0": 0.17582417582417584, "x1": 0.3395493395493395, "y1": 0.1945054945054945}, {"text": "NB: The following pages surround the events of September 11\"* 2001 in the World Trade Centre (p.283 ~ 284).", "x0": 0.08547008547008547, "y0": 0.22197802197802197, "x1": 0.7163947163947164, "y1": 0.24395604395604395}, {"text": "\u201cBut this is the thing I have never told anyone. I looked at the caller", "x0": 0.09246309246309246, "y0": 0.2989010989010989, "x1": 0.47863247863247865, "y1": 0.31758241758241756}, {"text": "ID and saw that it was his cell phone. I couldn\u2019t pick up the phone. I", "x0": 0.09246309246309246, "y0": 0.3230769230769231, "x1": 0.48096348096348096, "y1": 0.34175824175824177}, {"text": "just couldn\u2019t do it, It rang and rang, and I couldn\u2019t move. I wanted to", "x0": 0.09090909090909091, "y0": 0.34615384615384615, "x1": 0.48329448329448327, "y1": 0.3648351648351648}, {"text": "pick it up, but I couldn\u2019t. He needed me, and I couldn\u2019t pick up. The", "x0": 0.09246309246309246, "y0": 0.36923076923076925, "x1": 0.48096348096348096, "y1": 0.3879120879120879}, {"text": "answering machine went on, and I heard my own voice.\u201d", "x0": 0.09246309246309246, "y0": 0.3923076923076923, "x1": 0.41647241647241645, "y1": 0.41098901098901097}, {"text": "Hi, you've reached the Schell residence. Please leave a message.", "x0": 0.10722610722610723, "y0": 0.43846153846153846, "x1": 0.4763014763014763, "y1": 0.45714285714285713}, {"text": "\u201cThere was a beep. Then I heard Dad\u2019s voice.\u201d", "x0": 0.09246309246309246, "y0": 0.4846153846153846, "x1": 0.358974358974359, "y1": 0.5032967032967033}, {"text": "Are you there? Are you there? Are you there? Are you there?", "x0": 0.13442113442113443, "y0": 0.5307692307692308, "x1": 0.48329448329448327, "y1": 0.5494505494505495}, {"text": "Are you there? Are you there? Are you there? Are you there?", "x0": 0.13442113442113443, "y0": 0.5538461538461539, "x1": 0.48329448329448327, "y1": 0.5725274725274725}, {"text": "Are you there? Are you there? Are you there?", "x0": 0.13442113442113443, "y0": 0.5769230769230769, "x1": 0.3954933954933955, "y1": 0.5956043956043956}, {"text": "Are you there? Are you", "x0": 0.13442113442113443, "y0": 0.6010989010989011, "x1": 0.26728826728826727, "y1": 0.6197802197802198}, {"text": "\u201cAnd then it cut off.\u201d", "x0": 0.09246309246309246, "y0": 0.6703296703296703, "x1": 0.2128982128982129, "y1": 0.6846153846153846}, {"text": "p.283", "x0": 0.27972027972027974, "y0": 0.8087912087912088, "x1": 0.30536130536130535, "y1": 0.823076923076923}, {"text": "p.284", "x0": 0.6938616938616938, "y0": 0.8087912087912088, "x1": 0.7195027195027195, "y1": 0.823076923076923}, {"text": "JONATHAN SAFRAN FOER", "x0": 0.7264957264957265, "y0": 0.8516483516483516, "x1": 0.9020979020979021, "y1": 0.865934065934066}], [{"text": "Text 5 \u2014 Persuasive extract", "x0": 0.12197802197802197, "y0": 0.08935508935508936, "x1": 0.3516483516483517, "y1": 0.09867909867909867}, {"text": "from Ten Years on From the Misogyny Speech \u2014 Not Now, Not Ever", "x0": 0.12197802197802197, "y0": 0.1250971250971251, "x1": 0.6901098901098901, "y1": 0.13752913752913754}, {"text": "Misogyny is both as old as time and modem as a tweet. It continues to pervade workplaces,", "x0": 0.12197802197802197, "y0": 0.1592851592851593, "x1": 0.878021978021978, "y1": 0.17249417249417248}, {"text": "influence media reporting and shape politics. Misogyny still appears in its traditional forms, as", "x0": 0.12197802197802197, "y0": 0.17715617715617715, "x1": 0.878021978021978, "y1": 0.19036519036519037}, {"text": "well as shapeshifting as technology and social norms change. Misogyny allies itself with racism", "x0": 0.12197802197802197, "y0": 0.1864801864801865, "x1": 0.878021978021978, "y1": 0.2128982128982129}, {"text": "and ither forms of discrimination, so that women who are already facing prejudice and", "x0": 0.12197802197802197, "y0": 0.21212121212121213, "x1": 0.878021978021978, "y1": 0.22533022533022534}, {"text": "exclusion endure more of it.", "x0": 0.12197802197802197, "y0": 0.22999222999222999, "x1": 0.34615384615384615, "y1": 0.2400932400932401}, {"text": "Misogyny is the fist that strikes a woman\u2019s body and the belief that women\u2019s bodies are not", "x0": 0.12197802197802197, "y0": 0.26573426573426573, "x1": 0.878021978021978, "y1": 0.2789432789432789}, {"text": "their own. For women, living with misogyny is like walking through the world being forced to", "x0": 0.12197802197802197, "y0": 0.2828282828282828, "x1": 0.878021978021978, "y1": 0.29603729603729606}, {"text": "carry an unwanted burden. We are so used to this baggage, most of the time we don\u2019t even", "x0": 0.12197802197802197, "y0": 0.3006993006993007, "x1": 0.878021978021978, "y1": 0.3139083139083139}, {"text": "recognise how heavy it is. Women everywhere are weighed down by misogyny, but the degree", "x0": 0.12197802197802197, "y0": 0.3185703185703186, "x1": 0.878021978021978, "y1": 0.3317793317793318}, {"text": "of gender inequality women confront varies from nation to nation, community to community.", "x0": 0.12197802197802197, "y0": 0.33644133644133645, "x1": 0.8769230769230769, "y1": 0.34965034965034963}, {"text": "For billions of women, poverty and the denial of basic rights, such as getting to go to school,", "x0": 0.12197802197802197, "y0": 0.35353535353535354, "x1": 0.878021978021978, "y1": 0.3667443667443667}, {"text": "cement inequality and rob them of choices and opportunities. A vital part of our feminist", "x0": 0.12197802197802197, "y0": 0.3714063714063714, "x1": 0.878021978021978, "y1": 0.38461538461538464}, {"text": "mission is showing solidarity with and giving support to these women, many of whom are", "x0": 0.12197802197802197, "y0": 0.38927738927738925, "x1": 0.878021978021978, "y1": 0.4024864024864025}, {"text": "courageously campaigning for change.", "x0": 0.12197802197802197, "y0": 0.40714840714840717, "x1": 0.4318681318681319, "y1": 0.42035742035742035}, {"text": "Billions of other women today have more options available to them than their mothers or", "x0": 0.12197802197802197, "y0": 0.4421134421134421, "x1": 0.8791208791208791, "y1": 0.4553224553224553}, {"text": "grandmothers could have imagined in their wildest dreams, yet they do not live in a gender", "x0": 0.12197802197802197, "y0": 0.45998445998445997, "x1": 0.8791208791208791, "y1": 0.4731934731934732}, {"text": "equal world. Instead, when looking up, they see a glass ceiling, and at the same time the floor", "x0": 0.12197802197802197, "y0": 0.47785547785547783, "x1": 0.8791208791208791, "y1": 0.49106449106449107}, {"text": "they stand on feels wobbly because hard-won advances, including reproductive rights, can be", "x0": 0.12197802197802197, "y0": 0.494949494949495, "x1": 0.878021978021978, "y1": 0.5081585081585082}, {"text": "taken away. In the face of all this, do words matter? A speech? A book? A shout of solidarity?", "x0": 0.12197802197802197, "y0": 0.5042735042735043, "x1": 0.878021978021978, "y1": 0.5306915306915307}, {"text": "\u2018Are words poor weapons in the face of a phenomenon so ubiquitous and insidious? My answer", "x0": 0.12087912087912088, "y0": 0.5306915306915307, "x1": 0.8791208791208791, "y1": 0.5439005439005439}, {"text": "to that is a resounding no. Words can and do change the world. Looking back since the", "x0": 0.12197802197802197, "y0": 0.5477855477855478, "x1": 0.878021978021978, "y1": 0.560994560994561}, {"text": "misogyny speech, the biggest thing that stands out to me is the sea change in how we see and", "x0": 0.12197802197802197, "y0": 0.5656565656565656, "x1": 0.878021978021978, "y1": 0.5788655788655789}, {"text": "describe the world. This is what has been achieved through the #MeToo movement, the revival", "x0": 0.12197802197802197, "y0": 0.5835275835275835, "x1": 0.8769230769230769, "y1": 0.5967365967365967}, {"text": "of women\u2019s history and the identification of gender barriers in work, politics, and civil society.", "x0": 0.12197802197802197, "y0": 0.6013986013986014, "x1": 0.8769230769230769, "y1": 0.6146076146076146}, {"text": "We see the world differently and we use our words to describe the manifest gender inequality.", "x0": 0.12197802197802197, "y0": 0.6363636363636364, "x1": 0.8769230769230769, "y1": 0.6495726495726496}, {"text": "This is a vital process, because the more we analyse, categorise and describe misogyny and its", "x0": 0.12197802197802197, "y0": 0.6542346542346542, "x1": 0.878021978021978, "y1": 0.6674436674436675}, {"text": "impacts, the easier it becomes to stand up to it now and ultimately defeat it.", "x0": 0.12197802197802197, "y0": 0.6721056721056721, "x1": 0.7274725274725274, "y1": 0.6853146853146853}, {"text": "Misogyny will end when we all come together to call it out and then demand immediate and", "x0": 0.12197802197802197, "y0": 0.7070707070707071, "x1": 0.878021978021978, "y1": 0.7202797202797203}, {"text": "effective action to eradicate it. A marrying of words, minds and decisive campaigning, all", "x0": 0.12197802197802197, "y0": 0.7249417249417249, "x1": 0.878021978021978, "y1": 0.7381507381507382}, {"text": "fuelled by impatient energy, because the world should already be better than it is. I want for", "x0": 0.12197802197802197, "y0": 0.7428127428127428, "x1": 0.8791208791208791, "y1": 0.756021756021756}, {"text": "everyone on earth the sense of openness and inclusion that would come is gender inequality", "x0": 0.12197802197802197, "y0": 0.7606837606837606, "x1": 0.878021978021978, "y1": 0.7738927738927739}, {"text": "was something that only existed in history books. And we can get there together.", "x0": 0.12197802197802197, "y0": 0.7777777777777778, "x1": 0.7703296703296704, "y1": 0.790986790986791}, {"text": "Obviously, there will be carping critics and curmudgeons who will want to stand in our way.", "x0": 0.12197802197802197, "y0": 0.7956487956487956, "x1": 0.8769230769230769, "y1": 0.8088578088578089}, {"text": "But we don\u2019t have to listen to any lectures from them. Not now, not ever.", "x0": 0.12197802197802197, "y0": 0.8135198135198135, "x1": 0.7098901098901099, "y1": 0.8267288267288267}, {"text": "JULIA GILLARD", "x0": 0.7252747252747253, "y0": 0.8492618492618492, "x1": 0.8736263736263736, "y1": 0.8585858585858586}, {"text": "End of texts for Section I", "x0": 0.3934065934065934, "y0": 0.885003885003885, "x1": 0.6054945054945055, "y1": 0.8943278943278943}]]