[[{"text": "GOVERNMENT", "x0": 0.12197802197802197, "y0": 0.1592851592851593, "x1": 0.22527472527472528, "y1": 0.16705516705516704}, {"text": "NSW Education Standards Authority", "x0": 0.11978021978021978, "y0": 0.19036519036519037, "x1": 0.4714285714285714, "y1": 0.20512820512820512}, {"text": "2020 | HIGHER SCHOOL CERTIFICATE EXAMINATION", "x0": 0.12747252747252746, "y0": 0.30691530691530694, "x1": 0.5857142857142857, "y1": 0.331002331002331}, {"text": "English Extension 1", "x0": 0.12307692307692308, "y0": 0.351981351981352, "x1": 0.5813186813186814, "y1": 0.38694638694638694}, {"text": "General + Reading time 10 minutes", "x0": 0.11978021978021978, "y0": 0.4289044289044289, "x1": 0.5241758241758242, "y1": 0.4483294483294483}, {"text": "Instructions Working time \u2014 2 hours", "x0": 0.11978021978021978, "y0": 0.44988344988344986, "x1": 0.49230769230769234, "y1": 0.4662004662004662}, {"text": "+ Write using black pen", "x0": 0.2681318681318681, "y0": 0.473970473970474, "x1": 0.47802197802197804, "y1": 0.48717948717948717}, {"text": "Total marks: Section | - 25 marks (pages 2-5)", "x0": 0.11868131868131868, "y0": 0.5283605283605284, "x1": 0.5714285714285714, "y1": 0.5415695415695416}, {"text": "50 + Attempt Question 1", "x0": 0.11868131868131868, "y0": 0.5454545454545454, "x1": 0.45604395604395603, "y1": 0.5656565656565656}, {"text": "+ Allow about 1 hour for this section", "x0": 0.2681318681318681, "y0": 0.5734265734265734, "x1": 0.5934065934065934, "y1": 0.5835275835275835}, {"text": "Section II - 25 marks (pages 6-11)", "x0": 0.26703296703296703, "y0": 0.6068376068376068, "x1": 0.589010989010989, "y1": 0.62004662004662}, {"text": "+ Attempt Question 2", "x0": 0.2681318681318681, "y0": 0.6309246309246309, "x1": 0.4582417582417582, "y1": 0.6441336441336442}, {"text": "+ Allow about 1 hour for this section", "x0": 0.2681318681318681, "y0": 0.6526806526806527, "x1": 0.5934065934065934, "y1": 0.6627816627816627}, {"text": "1260", "x0": 0.08241758241758242, "y0": 0.9463869463869464, "x1": 0.11758241758241758, "y1": 0.9549339549339549}], [{"text": "Section I \u2014 Common Module: Literary Worlds", "x0": 0.11978021978021978, "y0": 0.08236208236208237, "x1": 0.5989010989010989, "y1": 0.09712509712509712}, {"text": "25 marks", "x0": 0.11868131868131868, "y0": 0.11732711732711733, "x1": 0.1989010989010989, "y1": 0.12742812742812742}, {"text": "Attempt Question 1", "x0": 0.11868131868131868, "y0": 0.13364413364413363, "x1": 0.2868131868131868, "y1": 0.14685314685314685}, {"text": "Allow about 1 hour for this section", "x0": 0.11868131868131868, "y0": 0.15073815073815075, "x1": 0.4186813186813187, "y1": 0.16083916083916083}, {"text": "Answer the question on pages 2\u201412 of the English Extension | Writing Booklet. Extra writing", "x0": 0.11978021978021978, "y0": 0.18337218337218336, "x1": 0.8791208791208791, "y1": 0.19658119658119658}, {"text": "booklets are available.", "x0": 0.11868131868131868, "y0": 0.20046620046620048, "x1": 0.2989010989010989, "y1": 0.21056721056721056}, {"text": "Your answer will be assessed on how well you:", "x0": 0.14395604395604394, "y0": 0.23154623154623155, "x1": 0.5274725274725275, "y1": 0.24397824397824397}, {"text": "e demonstrate an understanding of the ideas and values of Literary Worlds and how", "x0": 0.14285714285714285, "y0": 0.2501942501942502, "x1": 0.8538461538461538, "y1": 0.2634032634032634}, {"text": "they are shaped and reflected in texts", "x0": 0.16703296703296702, "y0": 0.26728826728826727, "x1": 0.46703296703296704, "y1": 0.2804972804972805}, {"text": "\u00a9 craft a sustained composition appropriate to the question, demonstrating control of the", "x0": 0.14285714285714285, "y0": 0.2874902874902875, "x1": 0.856043956043956, "y1": 0.3006993006993007}, {"text": "use of language", "x0": 0.16703296703296702, "y0": 0.3038073038073038, "x1": 0.2934065934065934, "y1": 0.317016317016317}, {"text": "Question 1 (25 marks)", "x0": 0.11978021978021978, "y0": 0.34965034965034963, "x1": 0.30439560439560437, "y1": 0.3620823620823621}, {"text": "Read Texts 1, 2 and 3.", "x0": 0.11978021978021978, "y0": 0.38306138306138304, "x1": 0.3010989010989011, "y1": 0.3939393939393939}, {"text": "Compare how the construction of literary worlds offers you new insights.", "x0": 0.11868131868131868, "y0": 0.4156954156954157, "x1": 0.7142857142857143, "y1": 0.4289044289044289}, {"text": "In your response, refer to TWO of the extracts provided.", "x0": 0.11978021978021978, "y0": 0.4491064491064491, "x1": 0.5769230769230769, "y1": 0.46231546231546233}, {"text": "Question 1 continues on page 3", "x0": 0.3659340659340659, "y0": 0.5167055167055167, "x1": 0.6329670329670329, "y1": 0.5299145299145299}], [{"text": "Question | (continued)", "x0": 0.11978021978021978, "y0": 0.08158508158508158, "x1": 0.30439560439560437, "y1": 0.09401709401709402}, {"text": "Text 1 \u2014 Short story extract", "x0": 0.11868131868131868, "y0": 0.11499611499611499, "x1": 0.36813186813186816, "y1": 0.1282051282051282}, {"text": "Afloat on the empty night it is the sea itself that amazes him. The sea as a place", "x0": 0.17032967032967034, "y0": 0.1561771561771562, "x1": 0.8285714285714286, "y1": 0.16938616938616938}, {"text": "of the living. There are no dead here. Gazing around, entranced and awestruck,", "x0": 0.17032967032967034, "y0": 0.17249417249417248, "x1": 0.8285714285714286, "y1": 0.1857031857031857}, {"text": "he murmurs under his breath, but the words of his landlocked language do not", "x0": 0.17032967032967034, "y0": 0.1895881895881896, "x1": 0.8285714285714286, "y1": 0.20279720279720279}, {"text": "seem adequate. That noble language of his forebears, having been shaped by gritty", "x0": 0.17032967032967034, "y0": 0.20590520590520592, "x1": 0.8285714285714286, "y1": 0.2191142191142191}, {"text": "plains and harsh rocks, the dignities of work, even high notions of the sacred", "x0": 0.17032967032967034, "y0": 0.222999222999223, "x1": 0.8285714285714286, "y1": 0.23620823620823622}, {"text": "flame, has no voice for this ... this continent of water. His heart opens with an", "x0": 0.17032967032967034, "y0": 0.23620823620823622, "x1": 0.8285714285714286, "y1": 0.2556332556332556}, {"text": "ecstasy of unreadiness and yearning.", "x0": 0.17032967032967034, "y0": 0.2564102564102564, "x1": 0.46483516483516485, "y1": 0.26961926961926963}, {"text": "There is so much sea. Even as a modern, educated man he is unprepared. He can", "x0": 0.16923076923076924, "y0": 0.2898212898212898, "x1": 0.8285714285714286, "y1": 0.30303030303030304}, {"text": "hardly breathe for the jostle of a million dancing moon-shards programmed to rise", "x0": 0.17032967032967034, "y0": 0.3061383061383061, "x1": 0.8285714285714286, "y1": 0.31934731934731936}, {"text": "and subside with breathtaking restlessness. Thus, the strange name ocean (strange", "x0": 0.17032967032967034, "y0": 0.32323232323232326, "x1": 0.8285714285714286, "y1": 0.33644133644133645}, {"text": "perhaps in every tongue) delivers for him, at last, its reality: the greatest beauty of", "x0": 0.17032967032967034, "y0": 0.3395493395493395, "x1": 0.8307692307692308, "y1": 0.35275835275835277}, {"text": "creation. Nothing else on earth so vast or dazzling. Not rivers, not lakes, nor even", "x0": 0.17032967032967034, "y0": 0.35664335664335667, "x1": 0.8285714285714286, "y1": 0.36985236985236986}, {"text": "snow-covered mountains.", "x0": 0.17032967032967034, "y0": 0.372960372960373, "x1": 0.3758241758241758, "y1": 0.38306138306138304}, {"text": "Head tipped back he opens his voiceless mouth. Whether this is anguish or longing", "x0": 0.17032967032967034, "y0": 0.4063714063714064, "x1": 0.8285714285714286, "y1": 0.4195804195804196}, {"text": "no one else on board is awake to witness or wonder ... Sea near. And sea far.", "x0": 0.17032967032967034, "y0": 0.42035742035742035, "x1": 0.8274725274725274, "y1": 0.4405594405594406}, {"text": "Waves interlocked and heaving with sinister elasticity. Sinister? No, he corrects", "x0": 0.17032967032967034, "y0": 0.4397824397824398, "x1": 0.8285714285714286, "y1": 0.452991452991453}, {"text": "himself. This is, at last, an interval of hope. Himself almost at peace. He gazes", "x0": 0.17032967032967034, "y0": 0.4560994560994561, "x1": 0.8285714285714286, "y1": 0.4693084693084693}, {"text": "over the side. To glimpse, past glassy fractures, a liquid abyss*. Always and", "x0": 0.17032967032967034, "y0": 0.4731934731934732, "x1": 0.8285714285714286, "y1": 0.4864024864024864}, {"text": "forever the abyss. Seen now and then for an instant only. Water vertiginous** as", "x0": 0.17032967032967034, "y0": 0.48951048951048953, "x1": 0.8285714285714286, "y1": 0.5027195027195027}, {"text": "the inverted sky in that towering transparency. Triggered alarm flashes lightnings", "x0": 0.17032967032967034, "y0": 0.5066045066045066, "x1": 0.8285714285714286, "y1": 0.5198135198135199}, {"text": "through his uprooted tree. He recollects an ancient warning against casting oneself", "x0": 0.17032967032967034, "y0": 0.5229215229215229, "x1": 0.8307692307692308, "y1": 0.5361305361305362}, {"text": "on the waters. Defiantly, he has done so. They have done so.", "x0": 0.17032967032967034, "y0": 0.54001554001554, "x1": 0.6615384615384615, "y1": 0.5532245532245532}, {"text": "The moon, heavy as marble and miraculously airborne, hurtles overboard.", "x0": 0.16923076923076924, "y0": 0.5734265734265734, "x1": 0.7692307692307693, "y1": 0.5866355866355867}, {"text": "Ropney HALL", "x0": 0.7142857142857143, "y0": 0.6076146076146076, "x1": 0.8285714285714286, "y1": 0.616938616938617}, {"text": "Extract from \u2018Moonlight\u2019, A Country Too Far", "x0": 0.45604395604395603, "y0": 0.6231546231546231, "x1": 0.8296703296703297, "y1": 0.6363636363636364}, {"text": "* abyss a seemingly bottomless depth", "x0": 0.18681318681318682, "y0": 0.6736596736596736, "x1": 0.5340659340659341, "y1": 0.6837606837606838}, {"text": "vertiginous extremely high and steep", "x0": 0.2, "y0": 0.6938616938616938, "x1": 0.5043956043956044, "y1": 0.703962703962704}, {"text": "Reproduced with permission by Martin Shaw Literary Agent", "x0": 0.4912087912087912, "y0": 0.7327117327117327, "x1": 0.8428571428571429, "y1": 0.7420357420357421}, {"text": "Question 1 continues on page 4", "x0": 0.3659340659340659, "y0": 0.7793317793317793, "x1": 0.6329670329670329, "y1": 0.7925407925407926}], [{"text": "Question | (continued)", "x0": 0.11978021978021978, "y0": 0.08158508158508158, "x1": 0.30439560439560437, "y1": 0.09401709401709402}, {"text": "Text 2 \u2014 Novel extract", "x0": 0.11868131868131868, "y0": 0.11499611499611499, "x1": 0.31978021978021975, "y1": 0.1250971250971251}, {"text": "They left at sunset. The west, over the land, was a clear gush of light up from", "x0": 0.16923076923076924, "y0": 0.1561771561771562, "x1": 0.8285714285714286, "y1": 0.16938616938616938}, {"text": "the departed sun. The east, over the Pacific, was a tall concave of rose-coloured", "x0": 0.17032967032967034, "y0": 0.17249417249417248, "x1": 0.8285714285714286, "y1": 0.1857031857031857}, {"text": "clouds, a marvellous high apse*. Now the bush had gone dark and spectral again,", "x0": 0.17032967032967034, "y0": 0.1895881895881896, "x1": 0.8285714285714286, "y1": 0.20279720279720279}, {"text": "on the right hand ... And from time to time, on the left hand, they caught sight of", "x0": 0.17032967032967034, "y0": 0.20590520590520592, "x1": 0.8307692307692308, "y1": 0.2191142191142191}, {"text": "the long green rollers of the Pacific, with the star-white foam, and back of that,", "x0": 0.17032967032967034, "y0": 0.222999222999223, "x1": 0.8285714285714286, "y1": 0.23620823620823622}, {"text": "the dusk green sea glimmered over with smoky rose, reflected from the eastern", "x0": 0.17032967032967034, "y0": 0.23931623931623933, "x1": 0.8285714285714286, "y1": 0.25252525252525254}, {"text": "horizon where the bank of flesh-rose colour and pure smoke-blue lingered a long", "x0": 0.17032967032967034, "y0": 0.2564102564102564, "x1": 0.8285714285714286, "y1": 0.26961926961926963}, {"text": "time, like magic, as if the sky\u2019s rim were cooling down. It seemed characteristic", "x0": 0.17032967032967034, "y0": 0.2727272727272727, "x1": 0.8285714285714286, "y1": 0.28593628593628595}, {"text": "of Australia, this far-off flesh-rose bank of colour on the sky\u2019s horizon, so tender", "x0": 0.16593406593406593, "y0": 0.2867132867132867, "x1": 0.8296703296703297, "y1": 0.30691530691530694}, {"text": "and unvisited, topped with the smoky, beautiful blueness. And then the thickness", "x0": 0.17032967032967034, "y0": 0.3061383061383061, "x1": 0.8285714285714286, "y1": 0.31934731934731936}, {"text": "of the stars overhead, and one star very brave in the last effulgence** of", "x0": 0.17032967032967034, "y0": 0.32245532245532244, "x1": 0.8307692307692308, "y1": 0.3356643356643357}, {"text": "sunset, westward over the continent. As soon as night came, all the raggle-taggle", "x0": 0.17032967032967034, "y0": 0.3395493395493395, "x1": 0.8285714285714286, "y1": 0.35275835275835277}, {"text": "of amorphous white settlements disappeared, and the continent of the Kangaroo", "x0": 0.17032967032967034, "y0": 0.35586635586635584, "x1": 0.8285714285714286, "y1": 0.3690753690753691}, {"text": "reassumed its strange, unvisited glamour ...", "x0": 0.17032967032967034, "y0": 0.372960372960373, "x1": 0.5241758241758242, "y1": 0.3861693861693862}, {"text": "DH", "x0": 0.7087912087912088, "y0": 0.40714840714840717, "x1": 0.7362637362637363, "y1": 0.41647241647241645}, {"text": "Extract from Kangaroo", "x0": 0.6395604395604395, "y0": 0.4226884226884227, "x1": 0.8285714285714286, "y1": 0.4358974358974359}, {"text": "* apse a large recess with a domed roof in a church", "x0": 0.18681318681318682, "y0": 0.4755244755244755, "x1": 0.6164835164835165, "y1": 0.48562548562548563}, {"text": "effulgence radiance", "x0": 0.1989010989010989, "y0": 0.4965034965034965, "x1": 0.37142857142857144, "y1": 0.5066045066045066}, {"text": "Question 1 continues on page 5", "x0": 0.3659340659340659, "y0": 0.574980574980575, "x1": 0.6329670329670329, "y1": 0.5881895881895882}], [{"text": "Question | (continued)", "x0": 0.11978021978021978, "y0": 0.08158508158508158, "x1": 0.30439560439560437, "y1": 0.09401709401709402}, {"text": "Text 3 \u2014 Novel extract", "x0": 0.11868131868131868, "y0": 0.11499611499611499, "x1": 0.31978021978021975, "y1": 0.1250971250971251}, {"text": "Sydney, November 1960", "x0": 0.15604395604395604, "y0": 0.1561771561771562, "x1": 0.3516483516483517, "y1": 0.16938616938616938}, {"text": "The day the great man sang, heat blazed in haloes over Bennelong Point*. This is what", "x0": 0.15494505494505495, "y0": 0.1895881895881896, "x1": 0.8428571428571429, "y1": 0.20279720279720279}, {"text": "Pearl will remember, later, this is what she will say: that his voice** turned the air", "x0": 0.15604395604395604, "y0": 0.20590520590520592, "x1": 0.843956043956044, "y1": 0.2191142191142191}, {"text": "holy. Men, sweat-slicked, stood with bowed heads or hung off scaffolds, swatting at", "x0": 0.15604395604395604, "y0": 0.222999222999223, "x1": 0.8428571428571429, "y1": 0.23620823620823622}, {"text": "flies and tears. Few looked at the singer; they needed all their senses to hear. Needed", "x0": 0.15604395604395604, "y0": 0.23931623931623933, "x1": 0.8428571428571429, "y1": 0.25252525252525254}, {"text": "their whole bodies, skin and eyes and hearts, to absorb what they couldn\u2019t say: that", "x0": 0.15604395604395604, "y0": 0.2564102564102564, "x1": 0.8428571428571429, "y1": 0.26961926961926963}, {"text": "sacredness had returned to this place. It flowed through them on a single human voice,", "x0": 0.15604395604395604, "y0": 0.26961926961926963, "x1": 0.8428571428571429, "y1": 0.289044289044289}, {"text": "through their bodies and the building that was rising beneath their hands.", "x0": 0.15604395604395604, "y0": 0.2898212898212898, "x1": 0.7472527472527473, "y1": 0.30303030303030304}, {"text": "Pearl stood with the other journalists, and watched the men grow luminous. Wept as", "x0": 0.15604395604395604, "y0": 0.32323232323232326, "x1": 0.8428571428571429, "y1": 0.33644133644133645}, {"text": "she understood: that it wasn\u2019t just the building or the place Robeson had sanctified,", "x0": 0.15604395604395604, "y0": 0.3395493395493395, "x1": 0.8428571428571429, "y1": 0.35275835275835277}, {"text": "but the labour. The valour of it. The modest hearts of workers. In his songs, in the", "x0": 0.15604395604395604, "y0": 0.35664335664335667, "x1": 0.8428571428571429, "y1": 0.36985236985236986}, {"text": "faces of the men, was every story she had ever tried to write. This one too. She", "x0": 0.15604395604395604, "y0": 0.372960372960373, "x1": 0.8428571428571429, "y1": 0.3861693861693862}, {"text": "closed her eyes as the voice trailed away. Words formed and crumbled in her head,", "x0": 0.15604395604395604, "y0": 0.3900543900543901, "x1": 0.8428571428571429, "y1": 0.40326340326340326}, {"text": "insubstantial. She gripped her notebook and forgot to write them down.", "x0": 0.15604395604395604, "y0": 0.4063714063714064, "x1": 0.734065934065934, "y1": 0.4195804195804196}, {"text": "Autumn 1965", "x0": 0.15494505494505495, "y0": 0.473970473970474, "x1": 0.26373626373626374, "y1": 0.48329448329448327}, {"text": "Darkness thickened as they passed Bennelong Point. In starlight the new structure was", "x0": 0.15604395604395604, "y0": 0.5066045066045066, "x1": 0.8428571428571429, "y1": 0.5198135198135199}, {"text": "a strange oceanic creature mantling the land. Each head turned to it, a gravitational", "x0": 0.15604395604395604, "y0": 0.5236985236985237, "x1": 0.8428571428571429, "y1": 0.5369075369075369}, {"text": "pull. God help us, said the man next to her. But now Pearl could see how its new", "x0": 0.15604395604395604, "y0": 0.54001554001554, "x1": 0.8428571428571429, "y1": 0.5532245532245532}, {"text": "curves pulled at the water. heard the first thing Utzon*** had done, before", "x0": 0.15604395604395604, "y0": 0.5571095571095571, "x1": 0.8428571428571429, "y1": 0.5703185703185704}, {"text": "he thought about design, before he began to draw, was to consult the sea charts for", "x0": 0.15604395604395604, "y0": 0.5734265734265734, "x1": 0.843956043956044, "y1": 0.5866355866355867}, {"text": "Sydney Harbour. It made sudden sense: the building was marine more than earthly.", "x0": 0.15604395604395604, "y0": 0.5905205905205905, "x1": 0.8428571428571429, "y1": 0.6037296037296037}, {"text": "From this angle, in this light, it was not a structure but an eruption from the sea. An", "x0": 0.15604395604395604, "y0": 0.6068376068376068, "x1": 0.8428571428571429, "y1": 0.62004662004662}, {"text": "act of nature rather than man, a disturbance. She stared at its massive base, a plinth", "x0": 0.15604395604395604, "y0": 0.6239316239316239, "x1": 0.8428571428571429, "y1": 0.6371406371406372}, {"text": "for a sculpture or a ceremony, and thought about surfaces, the familiar faces of earth", "x0": 0.15604395604395604, "y0": 0.6402486402486403, "x1": 0.8428571428571429, "y1": 0.6534576534576535}, {"text": "and water, what lay beneath. About the way of seeing.", "x0": 0.15604395604395604, "y0": 0.6565656565656566, "x1": 0.6857142857142857, "y1": 0.6697746697746698}, {"text": "KRISTINA OLSSON", "x0": 0.7032967032967034, "y0": 0.6915306915306916, "x1": 0.8428571428571429, "y1": 0.7008547008547008}, {"text": "Extract from Shell", "x0": 0.6956043956043956, "y0": 0.7070707070707071, "x1": 0.843956043956044, "y1": 0.7171717171717171}, {"text": "* Bennelong Point site of the Sydney Opera House", "x0": 0.17252747252747253, "y0": 0.7599067599067599, "x1": 0.5582417582417583, "y1": 0.77000777000777}, {"text": "his voice in 1960 African-American singer Paul Robeson sang for the", "x0": 0.18571428571428572, "y0": 0.7801087801087802, "x1": 0.756043956043956, "y1": 0.7902097902097902}, {"text": "construction workers", "x0": 0.34615384615384615, "y0": 0.7940947940947941, "x1": 0.4879120879120879, "y1": 0.8018648018648019}, {"text": "Utzon architect who designed the Sydney Opera House", "x0": 0.18571428571428572, "y0": 0.815073815073815, "x1": 0.6736263736263737, "y1": 0.8251748251748252}, {"text": "\u2018This extract from Shell by Kristina Olsson is reproduced with permission of Simon & Schuster Australia", "x0": 0.23956043956043957, "y0": 0.8515928515928516, "x1": 0.8472527472527472, "y1": 0.8609168609168609}, {"text": "End of Question 1", "x0": 0.421978021978022, "y0": 0.8912198912198912, "x1": 0.5758241758241758, "y1": 0.9036519036519036}], [{"text": "Section II \u2014 Electives", "x0": 0.11978021978021978, "y0": 0.08236208236208237, "x1": 0.34065934065934067, "y1": 0.09401709401709402}, {"text": "25 marks", "x0": 0.11868131868131868, "y0": 0.11732711732711733, "x1": 0.1989010989010989, "y1": 0.12742812742812742}, {"text": "Attempt Question 2", "x0": 0.11868131868131868, "y0": 0.13364413364413363, "x1": 0.2879120879120879, "y1": 0.14685314685314685}, {"text": "Allow about 1 hour for this section", "x0": 0.11868131868131868, "y0": 0.15073815073815075, "x1": 0.4186813186813187, "y1": 0.16083916083916083}, {"text": "Answer the question on pages 14-24 of the English Extension | Writing Booklet. Extra writing", "x0": 0.11978021978021978, "y0": 0.18337218337218336, "x1": 0.8791208791208791, "y1": 0.19658119658119658}, {"text": "booklets are available.", "x0": 0.11868131868131868, "y0": 0.20124320124320125, "x1": 0.2989010989010989, "y1": 0.21056721056721056}, {"text": "Your answer will be assessed on how well you:", "x0": 0.14395604395604394, "y0": 0.23076923076923078, "x1": 0.5274725274725275, "y1": 0.24397824397824397}, {"text": "demonstrate an understanding of the ideas and values of Literary Worlds and how", "x0": 0.16703296703296702, "y0": 0.2501942501942502, "x1": 0.8538461538461538, "y1": 0.2634032634032634}, {"text": "they are shaped and reflected in texts", "x0": 0.16703296703296702, "y0": 0.26728826728826727, "x1": 0.46703296703296704, "y1": 0.2804972804972805}, {"text": "\u00a9 craft a sustained composition appropriate to the question, demonstrating control of the", "x0": 0.14285714285714285, "y0": 0.2874902874902875, "x1": 0.856043956043956, "y1": 0.3006993006993007}, {"text": "use of language", "x0": 0.16703296703296702, "y0": 0.3038073038073038, "x1": 0.2934065934065934, "y1": 0.317016317016317}, {"text": "Question 2 (25 marks)", "x0": 0.11978021978021978, "y0": 0.34965034965034963, "x1": 0.30439560439560437, "y1": 0.3620823620823621}, {"text": "When composers construct texts that interrogate contextual values, we are positioned to", "x0": 0.11868131868131868, "y0": 0.3822843822843823, "x1": 0.8791208791208791, "y1": 0.3954933954933955}, {"text": "consider the complexity of the world.", "x0": 0.11868131868131868, "y0": 0.39937839937839936, "x1": 0.421978021978022, "y1": 0.4125874125874126}, {"text": "Discuss this statement in light of the elective that you have studied.", "x0": 0.11978021978021978, "y0": 0.43278943278943277, "x1": 0.6659340659340659, "y1": 0.445998445998446}, {"text": "In your response, refer to TWO of your prescribed texts and ONE related text of your own", "x0": 0.11978021978021978, "y0": 0.4662004662004662, "x1": 0.8791208791208791, "y1": 0.4794094794094794}, {"text": "choosing.", "x0": 0.11868131868131868, "y0": 0.48329448329448327, "x1": 0.1956043956043956, "y1": 0.49572649572649574}, {"text": "The prescribed texts for Section II are listed on pages 7-11.", "x0": 0.11868131868131868, "y0": 0.515928515928516, "x1": 0.6043956043956044, "y1": 0.5291375291375291}, {"text": "Section II continues on page 7", "x0": 0.37032967032967035, "y0": 0.5827505827505828, "x1": 0.6285714285714286, "y1": 0.5959595959595959}], [{"text": "The prescribed texts for Section II are:", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.4307692307692308, "y1": 0.0947940947940948}, {"text": "+ Elective 1: Literary Homelands", "x0": 0.11978021978021978, "y0": 0.11499611499611499, "x1": 0.4142857142857143, "y1": 0.1282051282051282}, {"text": "The prescribed texts are:", "x0": 0.14285714285714285, "y0": 0.14840714840714841, "x1": 0.34065934065934067, "y1": 0.16161616161616163}, {"text": "Prose Fiction", "x0": 0.16703296703296702, "y0": 0.18181818181818182, "x1": 0.2802197802197802, "y1": 0.1919191919191919}, {"text": "Aravind White Tiger", "x0": 0.3384615384615385, "y0": 0.18181818181818182, "x1": 0.5967032967032967, "y1": 0.19502719502719504}, {"text": "EM Forster, A Passage to India", "x0": 0.33406593406593404, "y0": 0.20590520590520592, "x1": 0.5956043956043956, "y1": 0.21833721833721834}, {"text": "Colm T\u00e9ibin, Brooklyn", "x0": 0.33296703296703295, "y0": 0.22843822843822845, "x1": 0.5208791208791209, "y1": 0.24164724164724163}, {"text": "Poetry", "x0": 0.16703296703296702, "y0": 0.26262626262626265, "x1": 0.2230769230769231, "y1": 0.27583527583527584}, {"text": "Eileen Chong, Burning Rice", "x0": 0.33406593406593404, "y0": 0.26262626262626265, "x1": 0.5615384615384615, "y1": 0.27583527583527584}, {"text": "The prescribed poems are:", "x0": 0.33296703296703295, "y0": 0.28593628593628595, "x1": 0.5461538461538461, "y1": 0.29914529914529914}, {"text": "eR RR RR", "x0": 0.3208791208791209, "y0": 0.30691530691530694, "x1": 0.3516483516483517, "y1": 0.4149184149184149}, {"text": "Burning Rice", "x0": 0.35714285714285715, "y0": 0.31002331002331, "x1": 0.46373626373626375, "y1": 0.32245532245532244}, {"text": "Mid-autumn Mooncakes", "x0": 0.35714285714285715, "y0": 0.32634032634032634, "x1": 0.5527472527472528, "y1": 0.3356643356643357}, {"text": "My Hakka Grandmother", "x0": 0.35714285714285715, "y0": 0.34265734265734266, "x1": 0.5560439560439561, "y1": 0.35353535353535354}, {"text": "Shophouse, Victoria Street", "x0": 0.35714285714285715, "y0": 0.358974358974359, "x1": 0.5736263736263736, "y1": 0.37218337218337216}, {"text": "Chinese Ginseng", "x0": 0.35824175824175825, "y0": 0.37684537684537683, "x1": 0.49340659340659343, "y1": 0.38927738927738925}, {"text": "Winter Meeting", "x0": 0.35824175824175825, "y0": 0.39316239316239315, "x1": 0.4824175824175824, "y1": 0.40559440559440557}, {"text": "Singapore", "x0": 0.35714285714285715, "y0": 0.4094794094794095, "x1": 0.43846153846153846, "y1": 0.4219114219114219}, {"text": "Drama", "x0": 0.16703296703296702, "y0": 0.4428904428904429, "x1": 0.22637362637362637, "y1": 0.452991452991453}, {"text": "Andrew Bovell, The Secret River [by Kate Grenville \u2014 An", "x0": 0.33406593406593404, "y0": 0.4428904428904429, "x1": 0.8032967032967033, "y1": 0.4553224553224553}, {"text": "adaptation for the stage by Andrew Bovell]", "x0": 0.33296703296703295, "y0": 0.4592074592074592, "x1": 0.6846153846153846, "y1": 0.47241647241647244}, {"text": "Film", "x0": 0.16703296703296702, "y0": 0.4926184926184926, "x1": 0.20549450549450549, "y1": 0.5027195027195027}, {"text": "Sarah Gavron,Brick Lane", "x0": 0.3384615384615385, "y0": 0.4933954933954934, "x1": 0.5439560439560439, "y1": 0.5042735042735043}, {"text": "Section II prescribed texts continue on page 8", "x0": 0.3032967032967033, "y0": 0.5602175602175602, "x1": 0.6967032967032967, "y1": 0.5734265734265734}], [{"text": "The prescribed texts for Section II (continued)", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.4945054945054945, "y1": 0.0947940947940948}, {"text": "+ Elective 2: Worlds of Upheaval", "x0": 0.11978021978021978, "y0": 0.11499611499611499, "x1": 0.41098901098901097, "y1": 0.1282051282051282}, {"text": "The prescribed texts are:", "x0": 0.14285714285714285, "y0": 0.14840714840714841, "x1": 0.34065934065934067, "y1": 0.16161616161616163}, {"text": "+ Prose Fiction \u2014 Elizabeth and South", "x0": 0.14285714285714285, "y0": 0.18181818181818182, "x1": 0.6197802197802198, "y1": 0.1919191919191919}, {"text": "\u2014 Mary Shelley, Frankenstein", "x0": 0.3087912087912088, "y0": 0.20590520590520592, "x1": 0.5582417582417583, "y1": 0.21833721833721834}