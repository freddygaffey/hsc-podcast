23155, "x1": 0.5274725274725275, "y1": 0.24397824397824397}, {"text": "demonstrate understanding of the concept of discovery in the context of your study", "x0": 0.16703296703296702, "y0": 0.2501942501942502, "x1": 0.8406593406593407, "y1": 0.2634032634032634}, {"text": "m= analyse, explain and assess the ways discovery is represented in a variety of texts", "x0": 0.14285714285714285, "y0": 0.2703962703962704, "x1": 0.8263736263736263, "y1": 0.2836052836052836}, {"text": "m= organise, develop and express ideas using language appropriate to audience, purpose", "x0": 0.14285714285714285, "y0": 0.2905982905982906, "x1": 0.856043956043956, "y1": 0.3038073038073038}, {"text": "and context", "x0": 0.16703296703296702, "y0": 0.3076923076923077, "x1": 0.25934065934065936, "y1": 0.317016317016317}, {"text": "Question 3 (15 marks)", "x0": 0.11978021978021978, "y0": 0.35275835275835277, "x1": 0.30439560439560437, "y1": 0.3651903651903652}, {"text": "To what extent do the texts you have studied reveal both the emotional and intellectual", "x0": 0.11868131868131868, "y0": 0.3861693861693862, "x1": 0.8791208791208791, "y1": 0.39937839937839936}, {"text": "responses provoked by the experience of discovering?", "x0": 0.11978021978021978, "y0": 0.4024864024864025, "x1": 0.5571428571428572, "y1": 0.4156954156954157}, {"text": "In your response, refer to your prescribed text and ONE other related text of your own choosing.", "x0": 0.11978021978021978, "y0": 0.4358974358974359, "x1": 0.8791208791208791, "y1": 0.4491064491064491}, {"text": "The prescribed texts are listed on page 10 of the Stimulus Booklet.", "x0": 0.11868131868131868, "y0": 0.4693084693084693, "x1": 0.6604395604395604, "y1": 0.4825174825174825}, {"text": "End of paper", "x0": 0.44285714285714284, "y0": 0.5361305361305362, "x1": 0.5560439560439561, "y1": 0.5493395493395493}, {"text": "(\u00a9 2016 Board of Studies, Teaching and Educational Standards NSW", "x0": 0.3362637362637363, "y0": 0.9665889665889665, "x1": 0.6615384615384615, "y1": 0.9735819735819736}], [{"text": "BOARD OF sTUDIES", "x0": 0.2802197802197802, "y0": 0.09712509712509712, "x1": 0.43626373626373627, "y1": 0.10334110334110334}, {"text": "TEACHING", "x0": 0.2802197802197802, "y0": 0.10722610722610723, "x1": 0.35824175824175825, "y1": 0.11266511266511267}, {"text": "BOSTES", "x0": 0.12087912087912088, "y0": 0.11421911421911422, "x1": 0.26373626373626374, "y1": 0.13364413364413363}, {"text": "EDUCATIONAL", "x0": 0.2802197802197802, "y0": 0.11732711732711733, "x1": 0.3923076923076923, "y1": 0.12276612276612277}, {"text": "STANDARDS NSW", "x0": 0.2802197802197802, "y0": 0.12742812742812742, "x1": 0.4142857142857143, "y1": 0.13286713286713286}, {"text": "2016", "x0": 0.11868131868131868, "y0": 0.1717171717171717, "x1": 0.2087912087912088, "y1": 0.19502719502719504}, {"text": "English (Standard)", "x0": 0.12417582417582418, "y0": 0.27972027972027974, "x1": 0.6230769230769231, "y1": 0.32634032634032634}, {"text": "and English (Advanced)", "x0": 0.12087912087912088, "y0": 0.3372183372183372, "x1": 0.7703296703296704, "y1": 0.3838383838383838}, {"text": "Paper 1 \u2014 Area of Study", "x0": 0.12197802197802197, "y0": 0.41414141414141414, "x1": 0.6153846153846154, "y1": 0.445998445998446}, {"text": "Stimulus Booklet for Sections | and II", "x0": 0.12087912087912088, "y0": 0.48096348096348096, "x1": 0.7956043956043956, "y1": 0.5042735042735043}, {"text": "and", "x0": 0.11978021978021978, "y0": 0.5205905205905206, "x1": 0.18461538461538463, "y1": 0.5431235431235432}, {"text": "List of prescribed texts for Section Ill", "x0": 0.12197802197802197, "y0": 0.5594405594405595, "x1": 0.8043956043956044, "y1": 0.5905205905205905}, {"text": "Pages", "x0": 0.7384615384615385, "y0": 0.6410256410256411, "x1": 0.7846153846153846, "y1": 0.6534576534576535}, {"text": "Section I \u00a9 Text 1 Feature article extract 3", "x0": 0.11978021978021978, "y0": 0.6752136752136753, "x1": 0.7835164835164835, "y1": 0.6853146853146853}, {"text": "* Text 2 Fiction extract", "x0": 0.23846153846153847, "y0": 0.7101787101787101, "x1": 0.42967032967032964, "y1": 0.7195027195027195}, {"text": "* Text 3 Poem", "x0": 0.23846153846153847, "y0": 0.7451437451437452, "x1": 0.35824175824175825, "y1": 0.7544677544677545}, {"text": "Section IL \u00a9 Ttems", "x0": 0.11978021978021978, "y0": 0.8135198135198135, "x1": 0.2989010989010989, "y1": 0.8236208236208237}, {"text": "Section III + List of prescribed texts...", "x0": 0.11978021978021978, "y0": 0.8484848484848485, "x1": 0.45494505494505494, "y1": 0.8616938616938616}, {"text": "1021", "x0": 0.08351648351648351, "y0": 0.9456099456099456, "x1": 0.11098901098901098, "y1": 0.9533799533799534}], [{"text": "BLANK PAGE", "x0": 0.43626373626373627, "y0": 0.3550893550893551, "x1": 0.5626373626373626, "y1": 0.3644133644133644}], [{"text": "Section I", "x0": 0.11868131868131868, "y0": 0.08236208236208237, "x1": 0.2076923076923077, "y1": 0.0947940947940948}, {"text": "Text 1 \u2014 Feature article extract", "x0": 0.11868131868131868, "y0": 0.13364413364413363, "x1": 0.3978021978021978, "y1": 0.1445221445221445}, {"text": "How I discovered that everyday walking is no mere pedestrian activity", "x0": 0.1956043956043956, "y0": 0.18337218337218336, "x1": 0.8043956043956044, "y1": 0.19658119658119658}, {"text": "STEPHEN QUINN", "x0": 0.7538461538461538, "y0": 0.7839937839937839, "x1": 0.8791208791208791, "y1": 0.7972027972027972}], [{"text": "Text 2 \u2014 Fiction extract", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.33076923076923076, "y1": 0.09168609168609168}, {"text": "The Museum\u2019s entrance is airy and full of light. I stare at the", "x0": 0.26153846153846155, "y0": 0.13286713286713286, "x1": 0.7604395604395604, "y1": 0.14607614607614608}, {"text": "map, all lines and boxes and no pictures, trying to make sense", "x0": 0.23846153846153847, "y0": 0.15073815073815075, "x1": 0.7604395604395604, "y1": 0.16394716394716394}, {"text": "of it. We only have an hour, Eleanor says, not long enough but", "x0": 0.23846153846153847, "y0": 0.1686091686091686, "x1": 0.7604395604395604, "y1": 0.18181818181818182}, {"text": "it will have to do. I can see that the dinosaur display is on Level", "x0": 0.23846153846153847, "y0": 0.1864801864801865, "x1": 0.7604395604395604, "y1": 0.19968919968919968}, {"text": "2, but it\u2019s hard to work out how to get up there. A tour group", "x0": 0.23846153846153847, "y0": 0.20435120435120435, "x1": 0.7604395604395604, "y1": 0.21756021756021757}, {"text": "piles in through the front door and surrounds me. I twist around,", "x0": 0.23846153846153847, "y0": 0.2222222222222222, "x1": 0.7604395604395604, "y1": 0.23543123543123542}, {"text": "searching for the stairs, but there are too many people in the", "x0": 0.23846153846153847, "y0": 0.2400932400932401, "x1": 0.7604395604395604, "y1": 0.2533022533022533}, {"text": "way, standing in a big huddle, craning their necks. I\u2019m about to", "x0": 0.23846153846153847, "y0": 0.257964257964258, "x1": 0.7604395604395604, "y1": 0.27117327117327117}, {"text": "push my way through the middle of them when curiosity makes", "x0": 0.23846153846153847, "y0": 0.27583527583527584, "x1": 0.7604395604395604, "y1": 0.289044289044289}, {"text": "me look up, too.", "x0": 0.23846153846153847, "y0": 0.2937062937062937, "x1": 0.36923076923076925, "y1": 0.3061383061383061}, {"text": "A whale skeleton floating above us takes up most of the", "x0": 0.26263736263736265, "y0": 0.3278943278943279, "x1": 0.7604395604395604, "y1": 0.3411033411033411}, {"text": "ceiling. I stand there gawking and feel shoved again, like", "x0": 0.23846153846153847, "y0": 0.3457653457653458, "x1": 0.7604395604395604, "y1": 0.358974358974359}, {"text": "yesterday when the height of the skyscraper tried to push me", "x0": 0.23846153846153847, "y0": 0.36363636363636365, "x1": 0.7604395604395604, "y1": 0.37684537684537683}, {"text": "over. It\u2019s hard to imagine an animal so big swimming around and", "x0": 0.23846153846153847, "y0": 0.3815073815073815, "x1": 0.7604395604395604, "y1": 0.3947163947163947}, {"text": "yet there\u2019s not much to it, really; hardly any bones. Each rib is", "x0": 0.23846153846153847, "y0": 0.39937839937839936, "x1": 0.7604395604395604, "y1": 0.4125874125874126}, {"text": "thick and chunky, like a log carved and set in place, but I can", "x0": 0.23846153846153847, "y0": 0.4172494172494173, "x1": 0.7604395604395604, "y1": 0.43045843045843046}, {"text": "see how helpless a whale would feel washed up on the beach.", "x0": 0.23846153846153847, "y0": 0.43512043512043513, "x1": 0.7593406593406593, "y1": 0.4483294483294483}, {"text": "Its whole stomach would be crushed under the weight of those", "x0": 0.23846153846153847, "y0": 0.4522144522144522, "x1": 0.7604395604395604, "y1": 0.4654234654234654}, {"text": "heavy bones. I think of myself out in the deep water with the", "x0": 0.23846153846153847, "y0": 0.4700854700854701, "x1": 0.7604395604395604, "y1": 0.48329448329448327}, {"text": "whale swimming under me and all my breath rushes out. I feel", "x0": 0.23846153846153847, "y0": 0.48795648795648794, "x1": 0.7604395604395604, "y1": 0.5011655011655012}, {"text": "afraid, for myself and for the whale, too.", "x0": 0.23846153846153847, "y0": 0.5058275058275058, "x1": 0.567032967032967, "y1": 0.519036519036519}, {"text": "I find a bench to sit on so I ca", "x0": 0.26263736263736265, "y0": 0.5407925407925408, "x1": 0.5307692307692308, "y1": 0.5508935508935509}, {"text": "study the whale without", "x0": 0.5571428571428572, "y0": 0.5407925407925408, "x1": 0.7604395604395604, "y1": 0.554001554001554}, {"text": "getting dizzy. Looking up, I feel as though I\u2019m sitting on the", "x0": 0.23846153846153847, "y0": 0.5586635586635587, "x1": 0.7604395604395604, "y1": 0.5718725718725719}, {"text": "ocean floor, as small as a speck of phosphorescence. After", "x0": 0.23846153846153847, "y0": 0.5765345765345765, "x1": 0.7615384615384615, "y1": 0.5897435897435898}, {"text": "a while I pull out my sketchpad and start drawing. Gradually", "x0": 0.23846153846153847, "y0": 0.5936285936285937, "x1": 0.7604395604395604, "y1": 0.6068376068376068}, {"text": "1 make out the suspension wires and the connecting bits that", "x0": 0.23846153846153847, "y0": 0.6114996114996115, "x1": 0.7604395604395604, "y1": 0.6247086247086248}, {"text": "let each joint of the skeleton sit as it would in muscle. I study", "x0": 0.23846153846153847, "y0": 0.6293706293706294, "x1": 0.7604395604395604, "y1": 0.6425796425796426}, {"text": "each smooth rib, each snug piece of vertebrae, and the hollow", "x0": 0.23846153846153847, "y0": 0.6472416472416472, "x1": 0.7604395604395604, "y1": 0.6604506604506605}, {"text": "feeling I\u2019ve been carrying starts to fill up with water. I'm flowing", "x0": 0.23846153846153847, "y0": 0.6651126651126651, "x1": 0.7604395604395604, "y1": 0.6783216783216783}, {"text": "out with the tide, melting into a current of calm, hovering on", "x0": 0.23846153846153847, "y0": 0.682983682983683, "x1": 0.7604395604395604, "y1": 0.6961926961926962}, {"text": "the ocean\u2019s graveyard bottom, while the monster fish \u2014 the", "x0": 0.23846153846153847, "y0": 0.7008547008547008, "x1": 0.7604395604395604, "y1": 0.714063714063714}, {"text": "ugly ones with strange protrusions and useless, gaping eyes", "x0": 0.23846153846153847, "y0": 0.7187257187257188, "x1": 0.7604395604395604, "y1": 0.7319347319347319}, {"text": "\u2014 scavenge around me for threads of filtered food. The whole", "x0": 0.23736263736263735, "y0": 0.7365967365967366, "x1": 0.7604395604395604, "y1": 0.7498057498057498}, {"text": "ocean presses down. It feels soothing to be pressed by a weight", "x0": 0.23846153846153847, "y0": 0.7544677544677545, "x1": 0.7604395604395604, "y1": 0.7676767676767676}, {"text": "so much greater than my own; peaceful. Down here, nothing", "x0": 0.23846153846153847, "y0": 0.7723387723387724, "x1": 0.7604395604395604, "y1": 0.7855477855477856}, {"text": "much matters.", "x0": 0.23846153846153847, "y0": 0.790986790986791, "x1": 0.3505494505494505, "y1": 0.8003108003108003}, {"text": "Text 2 continues on page 5", "x0": 0.38461538461538464, "y0": 0.8741258741258742, "x1": 0.6142857142857143, "y1": 0.8873348873348873}], [{"text": "Text 2 (continued)", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.2692307692307692, "y1": 0.09401709401709402}, {"text": "Eleanor comes to sit beside me. She asks to see what I've", "x0": 0.26263736263736265, "y0": 0.11655011655011654, "x1": 0.7604395604395604, "y1": 0.12665112665112666}, {"text": "drawn. Without realising, I have filled several pages with ribs and", "x0": 0.23846153846153847, "y0": 0.13442113442113443, "x1": 0.7604395604395604, "y1": 0.14763014763014762}, {"text": "spine and horror fish. \u2018It looks like your father\u2019s boat.\u201d", "x0": 0.23846153846153847, "y0": 0.1522921522921523, "x1": 0.676923076923077, "y1": 0.1655011655011655}, {"text": "I take another look at my sketchpad. She\u2019s right, the boat", "x0": 0.26263736263736265, "y0": 0.1864801864801865, "x1": 0.7604395604395604, "y1": 0.19968919968919968}, {"text": "and the whale are the same \u2014 one set of ribcages reaching up,", "x0": 0.23846153846153847, "y0": 0.20435120435120435, "x1": 0.7604395604395604, "y1": 0.21756021756021757}, {"text": "the other down. In a flash, I think of the patterns I saw from the", "x0": 0.23846153846153847, "y0": 0.2222222222222222, "x1": 0.7604395604395604, "y1": 0.23543123543123542}, {"text": "aeroplane window. I wonder whether everything starts out like", "x0": 0.23846153846153847, "y0": 0.24087024087024086, "x1": 0.7604395604395604, "y1": 0.2533022533022533}, {"text": "this, no matter how big or small. Just a simple pattern.", "x0": 0.23846153846153847, "y0": 0.257964257964258, "x1": 0.6780219780219781, "y1": 0.27117327117327117}, {"text": "The idea fills me with air. From the dark ocean floor I shoot", "x0": 0.26153846153846155, "y0": 0.29215229215229216, "x1": 0.7604395604395604, "y1": 0.30225330225330227}, {"text": "up, rushing through bubbles, bursting through the water\u2019s sloppy", "x0": 0.23846153846153847, "y0": 0.3108003108003108, "x1": 0.7604395604395604, "y1": 0.32323232323232326}, {"text": "skin into warm sunlight. Up on the surface I take a deep breath.", "x0": 0.23846153846153847, "y0": 0.3278943278943279, "x1": 0.7593406593406593, "y1": 0.3411033411033411}, {"text": "Everything is sparkling clear. The cicadas are screaming in my", "x0": 0.23846153846153847, "y0": 0.3457653457653458, "x1": 0.7604395604395604, "y1": 0.358974358974359}, {"text": "ears, full throttle.", "x0": 0.23846153846153847, "y0": 0.36363636363636365, "x1": 0.3758241758241758, "y1": 0.3752913752913753}, {"text": "Eleanor says, \u2018I came here with your grandfather, once.\u201d", "x0": 0.26263736263736265, "y0": 0.3986013986013986, "x1": 0.7142857142857143, "y1": 0.41181041181041184}, {"text": "I look at her in surprise. She looks back with a sad smile, puts", "x0": 0.26263736263736265, "y0": 0.43278943278943277, "x1": 0.7604395604395604, "y1": 0.445998445998446}, {"text": "her arm around me and squeezes. Then she stands up. \u2018Do you", "x0": 0.23846153846153847, "y0": 0.4506604506604507, "x1": 0.7604395604395604, "y1": 0.46386946386946387}, {"text": "want to see the silkworms?\u201d", "x0": 0.23846153846153847, "y0": 0.46853146853146854, "x1": 0.46263736263736266, "y1": 0.47863247863247865}, {"text": "ADRIENNE FERREIRA", "x0": 0.6, "y0": 0.5042735042735043, "x1": 0.7604395604395604, "y1": 0.5135975135975136}, {"text": "Extract from Watercolours", "x0": 0.5439560439560439, "y0": 0.5205905205905206, "x1": 0.7604395604395604, "y1": 0.5306915306915307}, {"text": "Reproduced by permission of HarperCollins Publishers Australia", "x0": 0.38351648351648354, "y0": 0.5431235431235432, "x1": 0.7637362637362637, "y1": 0.5524475524475524}, {"text": "End of Text 2", "x0": 0.44065934065934065, "y0": 0.6060606060606061, "x1": 0.5582417582417583, "y1": 0.6161616161616161}], [{"text": "Text 3 \u2014 Poem", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.25164835164835164, "y1": 0.09168609168609168}, {"text": "Boy with a Telescope", "x0": 0.26263736263736265, "y0": 0.13053613053613053, "x1": 0.3989010989010989, "y1": 0.13986013986013987}, {"text": "for Andrew", "x0": 0.26263736263736265, "y0": 0.14918414918414918, "x1": 0.3274725274725275, "y1": 0.1561771561771562}, {"text": "Shadowy neanderthal, his silhouette", "x0": 0.26263736263736265, "y0": 0.18181818181818182, "x1": 0.5538461538461539, "y1": 0.19502719502719504}, {"text": "straightens to shake a fist", "x0": 0.26263736263736265, "y0": 0.19813519813519814, "x1": 0.46703296703296704, "y1": 0.21756021756021757}, {"text": "at the prowling clouds", "x0": 0.26263736263736265, "y0": 0.22066822066822067, "x1": 0.44175824175824174, "y1": 0.2331002331002331}, {"text": "then down again eagerly", "x0": 0.26263736263736265, "y0": 0.23931623931623933, "x1": 0.4593406593406593, "y1": 0.2517482517482518}, {"text": "to Saturn\u2019s swirling rings", "x0": 0.26263736263736265, "y0": 0.257964257964258, "x1": 0.46593406593406594, "y1": 0.27117327117327117}, {"text": "or Jupiter trailing his brood of moons.", "x0": 0.26153846153846155, "y0": 0.2766122766122766, "x1": 0.5692307692307692, "y1": 0.2898212898212898}, {"text": "The warm room of the family", "x0": 0.26153846153846155, "y0": 0.29603729603729606, "x1": 0.5021978021978022, "y1": 0.30924630924630925}, {"text": "is galaxies away;", "x0": 0.26263736263736265, "y0": 0.3146853146853147, "x1": 0.3989010989010989, "y1": 0.3278943278943279}, {"text": "tonight he charts the distance and the dark,", "x0": 0.26263736263736265, "y0": 0.3333333333333333, "x1": 0.6087912087912087, "y1": 0.34654234654234656}, {"text": "burning with a cool celestial fire;", "x0": 0.26153846153846155, "y0": 0.35275835275835277, "x1": 0.5296703296703297, "y1": 0.36596736596736595}, {"text": "names like charms spin in his head \u2014", "x0": 0.26263736263736265, "y0": 0.3714063714063714, "x1": 0.5615384615384615, "y1": 0.38461538461538464}, {"text": "Betelgeuse*, Rigel, Aldebaran** \u2014", "x0": 0.26263736263736265, "y0": 0.3916083916083916, "x1": 0.5439560439560439, "y1": 0.40404040404040403}, {"text": "they peal like bells in the cold air.", "x0": 0.26263736263736265, "y0": 0.4094794094794095, "x1": 0.5362637362637362, "y1": 0.4226884226884227}, {"text": "He calls me over to see", "x0": 0.26263736263736265, "y0": 0.4296814296814297, "x1": 0.45054945054945056, "y1": 0.439005439005439}, {"text": "an open cluster in Scorpio.", "x0": 0.26263736263736265, "y0": 0.44755244755244755, "x1": 0.47802197802197804, "y1": 0.46076146076146074}, {"text": "I squinch my face against metal, admire a blur;", "x0": 0.26263736263736265, "y0": 0.4662004662004662, "x1": 0.6428571428571429, "y1": 0.4794094794094794}, {"text": "\u2018No, no, through the secondary lens down here.\u201d", "x0": 0.26373626373626374, "y0": 0.48484848484848486, "x1": 0.6527472527472528, "y1": 0.49805749805749805}, {"text": "He puts me in focus. I crouch to a pinpoint.", "x0": 0.26263736263736265, "y0": 0.5042735042735043, "x1": 0.6142857142857143, "y1": 0.5174825174825175}, {"text": "\u2018Six thousand five hundred light years away!\u201d", "x0": 0.26373626373626374, "y0": 0.5229215229215229, "x1": 0.6318681318681318, "y1": 0.5361305361305362}, {"text": "he reels it off with awe.", "x0": 0.26263736263736265, "y0": 0.5423465423465423, "x1": 0.45274725274725275, "y1": 0.5524475524475524}, {"text": "The immensity of the night,", "x0": 0.26153846153846155, "y0": 0.5617715617715617, "x1": 0.4868131868131868, "y1": 0.574980574980575}, {"text": "these tiny sparks taken on trust, we share.", "x0": 0.26263736263736265, "y0": 0.5811965811965812, "x1": 0.5989010989010989, "y1": 0.5936285936285937}, {"text": "T touch his arm and go,", "x0": 0.26263736263736265, "y0": 0.5990675990675991, "x1": 0.44835164835164837, "y1": 0.6122766122766122}, {"text": "but look back from the door:", "x0": 0.26153846153846155, "y0": 0.6184926184926185, "x1": 0.49340659340659343, "y1": 0.6285936285936286}, {"text": "he is swivelling to another constellation,", "x0": 0.26263736263736265, "y0": 0.6371406371406372, "x1": 0.589010989010989, "y1": 0.6503496503496503}, {"text": "checking the finder, muttering to himself.", "x0": 0.26153846153846155, "y0": 0.6565656565656566, "x1": 0.5978021978021978, "y1": 0.6697746697746698}, {"text": "And may he always stand so \u2014", "x0": 0.26263736263736265, "y0": 0.675990675990676, "x1": 0.5098901098901099, "y1": 0.6884226884226884}, {"text": "a little to one side of what he loves;", "x0": 0.25824175824175827, "y0": 0.6915306915306916, "x1": 0.5505494505494506, "y1": 0.7125097125097125}, {"text": "earn a clear view", "x0": 0.26153846153846155, "y0": 0.714063714063714, "x1": 0.3989010989010989, "y1": 0.7233877233877234}, {"text": "through fine adjustments, steady care.", "x0": 0.26263736263736265, "y0": 0.7319347319347319, "x1": 0.5681318681318681, "y1": 0.7451437451437452}, {"text": "I wish him distance and desire,", "x0": 0.26263736263736265, "y0": 0.7513597513597513, "x1": 0.512087912087912, "y1": 0.763014763014763}, {"text": "quick hands, keen eyes \u2014", "x0": 0.26153846153846155, "y0": 0.77000777000777, "x1": 0.46483516483516485, "y1": 0.7832167832167832}, {"text": "may his mind reach, tactile as fingertips,", "x0": 0.26263736263736265, "y0": 0.7894327894327894, "x1": 0.5901098901098901, "y1": 0.8026418026418026}, {"text": "to the sharp braille of the skies.", "x0": 0.26263736263736265, "y0": 0.8080808080808081, "x1": 0.5153846153846153, "y1": 0.8212898212898213}, {"text": "JAN OWEN \u2014 \u00a9 Jan Owen", "x0": 0.45494505494505494, "y0": 0.8445998445998446, "x1": 0.6461538461538462, "y1": 0.8632478632478633}, {"text": "* Betelgeuse, Rigel, Aldebaran names of stars", "x0": 0.26263736263736265, "y0": 0.8958818958818959, "x1": 0.6472527472527473, "y1": 0.905982905982906}], [{"text": "Text 4 \u2014 Fiction extract", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.33076923076923076, "y1": 0.09246309246309246}, {"text": "BARBARA KINGSOLVER", "x0": 0.6032967032967033, "y0": 0.6837606837606838, "x1": 0.7846153846153846, "y1": 0.6930846930846931}, {"text": "Adapted from Flight Behaviour", "x0": 0.5285714285714286, "y0": 0.6993006993006993, "x1": 0.7857142857142857, "y1": 0.7125097125097125}], [{"text": "Section II", "x0": 0.11978021978021978, "y0": 0.08236208236208237, "x1": 0.2164835164835165, "y1": 0.0947940947940948}, {"text": "Item 1", "x0": 0.11868131868131868, "y0": 0.11033411033411034, "x1": 0.17362637362637362, "y1": 0.12043512043512043}, {"text": "Item 2", "x0": 0.33076923076923076, "y0": 0.4063714063714064, "x1": 0.38571428571428573, "y1": 0.41647241647241645}, {"text": "\u00a9 Barry O'Malley also known as Baz - The Landy", "x0": 0.3263736263736264, "y0": 0.6651126651126651, "x1": 0.6186813186813187, "y1": 0.6744366744366744}, {"text": "Item 3", "x0": 0.11868131868131868, "y0": 0.675990675990676, "x1": 0.17362637362637362, "y1": 0.6860916860916861}, {"text": "(\u00a9) Murray Fredericks 2006", "x0": 0.11098901098901098, "y0": 0.9386169386169386, "x1": 0.2714285714285714, "y1": 0.947940947940948}], [{"text": "Item 4", "x0": 0.11978021978021978, "y0": 0.08158508158508158, "x1": 0.17472527472527472, "y1": 0.09168609168609168}, {"text": "\u00a9 Lee Robinson", "x0": 0.7736263736263737, "y0": 0.8368298368298368, "x1": 0.8692307692307693, "y1": 0.8438228438228438}], [{"text": "Section IT", "x0": 0.11978021978021978, "y0": 0.08236208236208237, "x1": 0.22527472527472528, "y1": 0.09401709401709402}, {"text": "The prescribed texts for Section III are:", "x0": 0.11868131868131868, "y0": 0.11732711732711733, "x1": 0.43846153846153846, "y1": 0.13053613053613053}, {"text": "Prose Fiction", "x0": 0.14285714285714285, "y0": 0.14840714840714841, "x1": 0.256043956043956, "y1": 0.1585081585081585}, {"text": "James Bradley, Wrack", "x0": 0.33296703296703295, "y0": 0.14840714840714841, "x1": 0.5142857142857142, "y1": 0.16161616161616163}, {"text": "Kate Chopin, The Awakening", "x0": 0.33406593406593404, "y0": 0.17016317016317017, "x1": 0.5703296703296703, "y1": 0.18337218337218336}, {"text": "Tara June Winch, Swallow the Air", "x0": 0.33296703296703295, "y0": 0.19114219114219114, "x1": 0.6120879120879121, "y1": 0.20279720279720279}, {"text": "Nonfiction", "x0": 0.14285714285714285, "y0": 0.2128982128982129, "x1": 0.23296703296703297, "y1": 0.222999222999223}, {"text": "Bill Bryson, A Short History of Nearly Everything", "x0": 0.33406593406593404, "y0": 0.2128982128982129, "x1": 0.7395604395604396, "y1": 0.2261072261072261}, {"text": "Emesto \u2018Che\u2019 Guevara, The Motorcycle Diaries", "x0": 0.33406593406593404, "y0": 0.2338772338772339, "x1": 0.7230769230769231, "y1": 0.24553224553224554}, {"text": "Drama", "x0": 0.14285714285714285, "y0": 0.2556332556332556, "x1": 0.2021978021978022, "y1": 0.26573426573426573}, {"text": "Michael Gow, Away", "x0": 0.33406593406593404, "y0": 0.2556332556332556, "x1": 0.4989010989010989, "y1": 0.26728826728826727}, {"text": "Jane Harrison, Rainbow's End", "x0": 0.33296703296703295, "y0": 0.2773892773892774, "x1": 0.5802197802197803, "y1": 0.289044289044289}, {"text": "from Vivienne Cleven et al., Contemporary Indigenous Plays", "x0": 0.33406593406593404, "y0": 0.29292929292929293, "x1": 0.8318681318681319, "y1": 0.3061383061383061}, {"text": "Shakespearean", "x0": 0.14285714285714285, "y0": 0.3146853146853147, "x1": 0.2714285714285714, "y1": 0.3278943278943279}, {"text": "William Shakespeare, The Tempest", "x0": 0.33296703296703295, "y0": 0.32245532245532244, "x1": 0.6186813186813187, "y1": 0.3356643356643357}, {"text": "Drama", "x0": 0.14285714285714285, "y0": 0.33022533022533024, "x1": 0.2021978021978022, "y1": 0.34032634032634035}, {"text": "Film", "x0": 0.14285714285714285, "y0": 0.351981351981352, "x1": 0.1824175824175824, "y1": 0.3620823620823621}, {"text": "Ang Lee, Life of Pi", "x0": 0.33406593406593404, "y0": 0.35275835275835277, "x1": 0.489010989010989, "y1": 0.3651903651903652}, {"text": "Poetry", "x0": 0.14285714285714285, "y0": 0.372960372960373, "x1": 0.1989010989010989, "y1": 0.3861693861693862}, {"text": "Rosemary Dobson, Rosemary Dobson Collected", "x0": 0.33406593406593404, "y0": 0.372960372960373, "x1": 0.7252747252747253, "y1": 0.3861693861693862}, {"text": "The prescribed poems are:", "x0": 0.33296703296703295, "y0": 0.3923853923853924, "x1": 0.5461538461538461, "y1": 0.40559440559440557}, {"text": "Young Girl at a Window", "x0": 0.35824175824175825, "y0": 0.411033411033411, "x1": 0.554945054945055, "y1": 0.42424242424242425}, {"text": "RH RE", "x0": 0.33406593406593404, "y0": 0.41181041181041184, "x1": 0.34175824175824177, "y1": 0.5866355866355867}, {"text": "Wonder", "x0": 0.35824175824175825, "y0": 0.42657342657342656, "x1": 0.4208791208791209, "y1": 0.4366744366744367}, {"text": "Painter of Antwerp", "x0": 0.35714285714285715, "y0": 0.44366744366744365, "x1": 0.512087912087912, "y1": 0.4560994560994561}, {"text": "Traveller's Tale", "x0": 0.35824175824175825, "y0": 0.4592074592074592, "x1": 0.4868131868131868, "y1": 0.4693084693084693}, {"text": "The Tiger", "x0": 0.35824175824175825, "y0": 0.4755244755244755, "x1": 0.43626373626373627, "y1": 0.48795648795648794}, {"text": "Cock Crow", "x0": 0.35824175824175825, "y0": 0.49106449106449107, "x1": 0.44835164835164837, "y1": 0.5011655011655012}, {"text": "Ghost Town: New England", "x0": 0.35714285714285715, "y0": 0.5073815073815073, "x1": 0.578021978021978, "y1": 0.5198135198135199}, {"text": "Robert Frost, The Poetry of Robert Frost", "x0": 0.33406593406593404, "y0": 0.5283605283605284, "x1": 0.6659340659340659, "y1": 0.5415695415695416}, {"text": "The prescribed poems are:", "x0": 0.33296703296703295, "y0": 0.5470085470085471, "x1": 0.5461538461538461, "y1": 0.5602175602175602}, {"text": "The Tuft of Flowers", "x0": 0.35824175824175825, "y0": 0.5656565656565656, "x1": 0.5175824175824176, "y1": 0.5788655788655789}, {"text": "Mending Wall", "x0": 0.35604395604395606, "y0": 0.581973581973582, "x1": 0.4714285714285714, "y1": 0.5951825951825952}, {"text": "Home Burial", "x0": 0.35714285714285715, "y0": 0.5975135975135976, "x1": 0.46153846153846156, "y1": 0.6076146076146076}, {"text": "After Apple-Picking", "x0": 0.35604395604395606, "y0": 0.6146076146076146, "x1": 0.5164835164835165, "y1": 0.627039627039627}, {"text": "Fire and Ice", "x0": 0.35714285714285715, "y0": 0.6301476301476302, "x1": 0.45714285714285713, "y1": 0.6402486402486403}, {"text": "Stopping by Woods on a Snowy Evening", "x0": 0.35714285714285715, "y0": 0.6456876456876457, "x1": 0.6835164835164835, "y1": 0.6588966588966589}, {"text": "Robert Gray, Coast Road", "x0": 0.33406593406593404, "y0": 0.6674436674436675, "x1": 0.5395604395604395, "y1": 0.6806526806526807}, {"text": "The prescribed poems are:", "x0": 0.33296703296703295, "y0": 0.6860916860916861, "x1": 0.5461538461538461, "y1": 0.6993006993006993}, {"text": "Journey: the North Coast", "x0": 0.35604395604395606, "y0": 0.7047397047397047, "x1": 0.5637362637362637, "y1": 0.717948717948718}, {"text": "The Meatworks", "x0": 0.35824175824175825, "y0": 0.721056721056721, "x1": 0.48131868131868133, "y1": 0.7311577311577312}, {"text": "North Coast Town", "x0": 0.35714285714285715, "y0": 0.7365967365967366, "x1": 0.5054945054945055, "y1": 0.7466977466977467}, {"text": "Late Ferry", "x0": 0.35714285714285715, "y0": 0.7536907536907537, "x1": 0.44395604395604393, "y1": 0.7661227661227661}, {"text": "Flames and Dangling Wire", "x0": 0.35714285714285715, "y0": 0.7684537684537684, "x1": 0.578021978021978, "y1": 0.7816627816627817}, {"text": "Diptych", "x0": 0.35714285714285715, "y0": 0.7855477855477856, "x1": 0.4197802197802198, "y1": 0.797979797979798}, {"text": "Media", "x0": 0.14285714285714285, "y0": 0.8065268065268065, "x1": 0.1967032967032967, "y1": 0.8166278166278166}, {"text": "Simon Nasht, Frank Hurley - The Man Who Made History", "x0": 0.33406593406593404, "y0": 0.8065268065268065, "x1": 0.8131868131868132, "y1": 0.8197358197358198}, {"text": "Ivan O\u2019 Mahoney", "x0": 0.33406593406593404, "y0": 0.8282828282828283, "x1": 0.4703296703296703, "y1": 0.8407148407148407}, {"text": "* Go Back to Where You Came From", "x0": 0.33406593406593404, "y0": 0.8508158508158508, "x1": 0.6450549450549451, "y1": 0.8609168609168609}, {"text": "~ Series 1: Episodes 1, 2 and 3", "x0": 0.35714285714285715, "y0": 0.8663558663558664, "x1": 0.6087912087912087, "y1": 0.8795648795648796}, {"text": "and", "x0": 0.35714285714285715, "y0": 0.8857808857808858, "x1": 0.38571428571428573, "y1": 0.8951048951048951}, {"text": "* The Response", "x0": 0.33406593406593404, "y0": 0.9044289044289044, "x1": 0.46813186813186813, "y1": 0.9168609168609169}, {"text": "-10-", "x0": 0.4736263736263736, "y0": 0.9440559440559441, "x1": 0.5252747252747253, "y1": 0.9533799533799534}], [{"text": "BLANK PAGE", "x0": 0.43626373626373627, "y0": 0.3550893550893551, "x1": 0.5626373626373626, "y1": 0.3644133644133644}], [{"text": "BLANK PAGE", "x0": 0.43626373626373627, "y0": 0.3543123543123543, "x1": 0.5626373626373626, "y1": 0.3644133644133644}, {"text": "(\u00a9 2016 Board of Studies, Teaching and Educational Standards NSW", "x0": 0.33186813186813185, "y0": 0.958041958041958, "x1": 0.6626373626373626, "y1": 0.9797979797979798}]]