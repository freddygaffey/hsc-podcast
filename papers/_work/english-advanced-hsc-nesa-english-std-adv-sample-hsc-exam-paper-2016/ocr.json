0.3362637362637363, "y0": 0.947940947940948, "x1": 0.6615384615384615, "y1": 0.9549339549339549}], [{"text": "80", "x0": 0.2802197802197802, "y0": 0.09712509712509712, "x1": 0.2978021978021978, "y1": 0.10334110334110334}, {"text": "Te", "x0": 0.2802197802197802, "y0": 0.10722610722610723, "x1": 0.2945054945054945, "y1": 0.11266511266511267}, {"text": "BOSTES", "x0": 0.12087912087912088, "y0": 0.11421911421911422, "x1": 0.26373626373626374, "y1": 0.13364413364413363}, {"text": "st", "x0": 0.2802197802197802, "y0": 0.12742812742812742, "x1": 0.2956043956043956, "y1": 0.13286713286713286}, {"text": "20 | HIGHER SCHOOL CERTIFICATE", "x0": 0.11868131868131868, "y0": 0.1717171717171717, "x1": 0.43736263736263736, "y1": 0.19502719502719504}, {"text": "EXAMINATION", "x0": 0.22417582417582418, "y0": 0.1864801864801865, "x1": 0.3230769230769231, "y1": 0.19502719502719504}, {"text": "English (Standard)", "x0": 0.12417582417582418, "y0": 0.30924630924630925, "x1": 0.6241758241758242, "y1": 0.35586635586635584}, {"text": "and English (Advanced)", "x0": 0.12087912087912088, "y0": 0.3667443667443667, "x1": 0.7703296703296704, "y1": 0.4133644133644134}, {"text": "Paper 1 \u2014 Study Stimulus Booklet", "x0": 0.12197802197802197, "y0": 0.445998445998446, "x1": 0.8769230769230769, "y1": 0.47474747474747475}, {"text": "General Instructions", "x0": 0.11978021978021978, "y0": 0.6402486402486403, "x1": 0.2978021978021978, "y1": 0.6503496503496503}, {"text": "* Detach this stimulus booklet", "x0": 0.11978021978021978, "y0": 0.6705516705516705, "x1": 0.367032967032967, "y1": 0.6798756798756799}, {"text": "* The Jist of prescribed texts for Seetion III is provided on page 8", "x0": 0.11978021978021978, "y0": 0.6993006993006993, "x1": 0.6538461538461539, "y1": 0.7125097125097125}, {"text": "1051", "x0": 0.08351648351648351, "y0": 0.9456099456099456, "x1": 0.11208791208791209, "y1": 0.9533799533799534}], [{"text": "Section I", "x0": 0.11978021978021978, "y0": 0.08236208236208237, "x1": 0.2076923076923077, "y1": 0.09401709401709402}, {"text": "Text 1 \u2014 Short story extract", "x0": 0.11978021978021978, "y0": 0.13364413364413363, "x1": 0.36813186813186816, "y1": 0.14685314685314685}, {"text": "FRIDAY MORNING. GREENWICH VILLAGE.", "x0": 0.11978021978021978, "y0": 0.18492618492618493, "x1": 0.5241758241758242, "y1": 0.19425019425019424}, {"text": "The industrial dumbwaiter*, jam-packed with a two-day accumulation of tenants\u2019 rubbish,", "x0": 0.11868131868131868, "y0": 0.21833721833721834, "x1": 0.8791208791208791, "y1": 0.23154623154623155}, {"text": "made three trips from the basement of the elegant apartment to the street.", "x0": 0.11978021978021978, "y0": 0.23543123543123542, "x1": 0.7626373626373626, "y1": 0.24864024864024864}, {"text": "A team of janitors removed a pile of dark plastic rubbish /bags to a corner wall of a raised", "x0": 0.11538461538461539, "y0": 0.26262626262626265, "x1": 0.8802197802197802, "y1": 0.28593628593628595}, {"text": "garden bed that ran along the north face of the building and shaped a mound from theny there.", "x0": 0.11978021978021978, "y0": 0.2867132867132867, "x1": 0.8791208791208791, "y1": 0.2999222999222999}, {"text": "The plastic glinted in the pale winter sun.", "x0": 0.11868131868131868, "y0": 0.3038073038073038, "x1": 0.45494505494505494, "y1": 0.317016317016317}, {"text": "On the fourth trip, a different type of rubbish: a battered Woodeit wardrobe tied around the", "x0": 0.11978021978021978, "y0": 0.337995337995338, "x1": 0.8802197802197802, "y1": 0.35120435120435123}, {"text": "middle with thick yellow string, a stroller, a child\u2019s car seat, a Wooden of drawers covered", "x0": 0.11978021978021978, "y0": 0.3550893550893551, "x1": 0.8802197802197802, "y1": 0.3682983682983683}, {"text": "with plaited white plastic and topped with a bfight-blue lid, and two single bed", "x0": 0.11978021978021978, "y0": 0.37218337218337216, "x1": 0.8802197802197802, "y1": 0.3853923853923854}, {"text": "bases, a single mattress, three crocheted cushions in perfect condition ...", "x0": 0.11978021978021978, "y0": 0.38927738927738925, "x1": 0.7076923076923077, "y1": 0.4024864024864025}, {"text": "Minutes after the rubbish was placed streetf\"@young Couple who had been walking by", "x0": 0.11978021978021978, "y0": 0.4234654234654235, "x1": 0.8791208791208791, "y1": 0.4366744366744367}, {"text": "lunged at it. What treasures might they/find her\u00e9? How much of it ntight be worth selling?", "x0": 0.11978021978021978, "y0": 0.4405594405594406, "x1": 0.8538461538461538, "y1": 0.45376845376845376}, {"text": "\u201cOh, man, look at this!\u201d", "x0": 0.12087912087912088, "y0": 0.4755244755244755, "x1": 0.3076923076923077, "y1": 0.4864024864024864}, {"text": "\u201cDon\u2019t take those trunks,\u201d the Woman called", "x0": 0.12087912087912088, "y0": 0.5097125097125097, "x1": 0.4758241758241758, "y1": 0.5205905205905206}, {"text": "He tried to argue with her, but she was r\u00e98olute, so his arms with books. When he", "x0": 0.11978021978021978, "y0": 0.5431235431235432, "x1": 0.8802197802197802, "y1": 0.5563325563325563}, {"text": "could hold no more, he placed them in piles on the footpath. He looked around. How to carry", "x0": 0.11978021978021978, "y0": 0.5602175602175602, "x1": 0.8791208791208791, "y1": 0.5734265734265734}, {"text": "all this? ...", "x0": 0.11978021978021978, "y0": 0.5773115773115773, "x1": 0.20659340659340658, "y1": 0.5874125874125874}, {"text": "Frenzied, he dumped the books into drawers, then moved to examine the next trunk.", "x0": 0.11978021978021978, "y0": 0.6114996114996115, "x1": 0.8021978021978022, "y1": 0.6247086247086248}, {"text": "In the meantime, his girlfri\u00e9nd kicked and prodded, then rummaged through the fabric-tied", "x0": 0.11978021978021978, "y0": 0.6456876456876457, "x1": 0.8802197802197802, "y1": 0.6588966588966589}, {"text": "bags.", "x0": 0.11978021978021978, "y0": 0.6635586635586636, "x1": 0.15934065934065933, "y1": 0.675990675990676}, {"text": "\u201c\u2018Books/here!\u201d she cried out.", "x0": 0.12087912087912088, "y0": 0.696969696969697, "x1": 0.34395604395604396, "y1": 0.7070707070707071}, {"text": "\u201cWhoa! Look at this,\u201d she whoop\u00e9d as she displayed a voluminous pair of white rayon bloomers", "x0": 0.12087912087912088, "y0": 0.7303807303807304, "x1": 0.8791208791208791, "y1": 0.7435897435897436}, {"text": "against her chest. He was too preoccupied to look up but that didn\u2019t dampen her delight.", "x0": 0.11978021978021978, "y0": 0.7474747474747475, "x1": 0.8351648351648352, "y1": 0.7606837606837606}, {"text": "Next, she found a multicoloured raffia beach bag with long red leather straps.", "x0": 0.11978021978021978, "y0": 0.7816627816627817, "x1": 0.7483516483516484, "y1": 0.7948717948717948}, {"text": "\u2018This!\u2019 She waved the\u2019bag in circles, lass", "x0": 0.12087912087912088, "y0": 0.8158508158508159, "x1": 0.44945054945054946, "y1": 0.8290598290598291}, {"text": "high in the air.", "x0": 0.5197802197802198, "y0": 0.8158508158508159, "x1": 0.6362637362637362, "y1": 0.8290598290598291}, {"text": "Into the beach bag she stuffed a many-coloured skirt, a pair of shoes, two rayon singlets", "x0": 0.11978021978021978, "y0": 0.85003885003885, "x1": 0.8791208791208791, "y1": 0.8632478632478633}, {"text": "(dresses for her), two scarves, more bloomers. Discarded clothes lay scattered wherever she", "x0": 0.11978021978021978, "y0": 0.8671328671328671, "x1": 0.8802197802197802, "y1": 0.8803418803418803}, {"text": "threw them, tKeir colours gaudy against the dark rubbish bags ...", "x0": 0.11978021978021978, "y0": 0.885003885003885, "x1": 0.6450549450549451, "y1": 0.8974358974358975}], [{"text": "Now the couple approached the wardrobe. Unable to break the yellow string, they Carried the", "x0": 0.11978021978021978, "y0": 0.08158508158508158, "x1": 0.8802197802197802, "y1": 0.0947940947940948}, {"text": "wardrobe \u2014 from the ease with which they hoisted it, it seemed empty \u2014 to the footpath, stood it", "x0": 0.11978021978021978, "y0": 0.09867909867909867, "x1": 0.8802197802197802, "y1": 0.11188811188811189}, {"text": "upright and rolled down the string. As the door swung open, a hibachi** tumbled out. It looked", "x0": 0.11978021978021978, "y0": 0.11655011655011654, "x1": 0.8802197802197802, "y1": 0.12975912975912976}, {"text": "new. He went to claim it.", "x0": 0.11978021978021978, "y0": 0.13364413364413363, "x1": 0.3241758241758242, "y1": 0.14374514374514374}, {"text": "\u2018No,\u2019 she shouted. \u2018No! I don\u2019t want that. I don\u2019t want any junk in the apartment.\u2019", "x0": 0.12197802197802197, "y0": 0.16783216783216784, "x1": 0.7846153846153846, "y1": 0.18104118104118105}, {"text": "He hesitated, but only for an instant; defiant, he claimed it.", "x0": 0.11978021978021978, "y0": 0.20124320124320125, "x1": 0.5967032967032967, "y1": 0.21445221445221446}, {"text": "There was a bonus for the couple: the chest of drawers was furnished with a set of", "x0": 0.11978021978021978, "y0": 0.23543123543123542, "x1": 0.8142857142857143, "y1": 0.24864024864024864}, {"text": "That would take some weight off. She closed the book-filled drawers; he secured them with the", "x0": 0.11978021978021978, "y0": 0.25252525252525254, "x1": 0.8802197802197802, "y1": 0.26573426573426573}, {"text": "yellow string. They stacked bags filled with clothes and on top of the chest. Each slung", "x0": 0.11978021978021978, "y0": 0.26961926961926963, "x1": 0.8802197802197802, "y1": 0.2828282828282828}, {"text": "a bag over one shoulder, hoisted another under their clutched others in their fingers.", "x0": 0.12087912087912088, "y0": 0.2874902874902875, "x1": 0.8802197802197802, "y1": 0.3006993006993007}, {"text": "Packed to the gills, they departed briskly, the sound of/metal wheels on concrete clacking in", "x0": 0.12087912087912088, "y0": 0.3045843045843046, "x1": 0.8802197802197802, "y1": 0.3177933177933178}, {"text": "their wake.", "x0": 0.12087912087912088, "y0": 0.32167832167832167, "x1": 0.2087912087912088, "y1": 0.3317793317793318}, {"text": "Two English tourists, who had been watching, disgusted, turned to each other/", "x0": 0.11978021978021978, "y0": 0.35586635586635584, "x1": 0.7549450549450549, "y1": 0.3690753690753691}, {"text": "\u201cWhat do you think they do with it?\u201d", "x0": 0.12197802197802197, "y0": 0.38927738927738925, "x1": 0.4153846153846154, "y1": 0.4024864024864025}, {"text": "\u2018Ican\u2019t imagine.\u2019", "x0": 0.12197802197802197, "y0": 0.42424242424242425, "x1": 0.25934065934065936, "y1": 0.4366744366744367}, {"text": "He shuddered, offered his companion his arm and they walked/off in the direction of Sth", "x0": 0.12087912087912088, "y0": 0.45765345765345766, "x1": 0.8802197802197802, "y1": 0.47086247086247085}, {"text": "Avenue, heads shaking in wonder,at the lik@s,of what goes on in New York.", "x0": 0.12087912087912088, "y0": 0.47474747474747475, "x1": 0.7384615384615385, "y1": 0.48795648795648794}, {"text": "On the street, the pile of dark plastic bags glinted inthe pal\u00e9 winter sun.", "x0": 0.12087912087912088, "y0": 0.508935508935509, "x1": 0.7054945054945055, "y1": 0.5221445221445221}, {"text": "SANDRA GOLDBLOOM ZURBO", "x0": 0.6505494505494506, "y0": 0.5439005439005439, "x1": 0.8802197802197802, "y1": 0.5532245532245532}, {"text": "Adapted from \u201cScene from a Window\u2019", "x0": 0.567032967032967, "y0": 0.5602175602175602, "x1": 0.878021978021978, "y1": 0.5734265734265734}, {"text": "Sandra Goldbioom Zurbo is Melbourne author, editor and proofreader. Her novel, The book of Rachel, was published by Allen &", "x0": 0.11978021978021978, "y0": 0.5912975912975913, "x1": 0.8703296703296703, "y1": 0.6006216006216006}, {"text": "Unwin. Her short stories and poems, several of which can be found \u00e9nline, have been published in literary journals and anthologies.", "x0": 0.11978021978021978, "y0": 0.6013986013986014, "x1": 0.8758241758241758, "y1": 0.6107226107226107}, {"text": "* dumbwaiter/ lift, elevators", "x0": 0.13076923076923078, "y0": 0.6480186480186481, "x1": 0.33516483516483514, "y1": 0.6573426573426573}, {"text": "** hibachi small Japanese cooking stove\u2019", "x0": 0.12197802197802197, "y0": 0.6612276612276612, "x1": 0.45274725274725275, "y1": 0.6721056721056721}, {"text": "End of Text 1", "x0": 0.44065934065934065, "y0": 0.7272727272727273, "x1": 0.5571428571428572, "y1": 0.7373737373737373}], [{"text": "Text 2 \u2014 Image", "x0": 0.11978021978021978, "y0": 0.08158508158508158, "x1": 0.25824175824175827, "y1": 0.0947940947940948}, {"text": "Painting of Albertus Seba", "x0": 0.6725274725274726, "y0": 0.8205128205128205, "x1": 0.8802197802197802, "y1": 0.8337218337218337}, {"text": "by Jacob Houbraken, 1730", "x0": 0.6637362637362637, "y0": 0.8376068376068376, "x1": 0.8802197802197802, "y1": 0.85003885003885}], [{"text": "Text 3\u2014 Poem", "x0": 0.11868131868131868, "y0": 0.0777000777000777, "x1": 0.25274725274725274, "y1": 0.09945609945609946}, {"text": "** abstruse hard to understand, obscure", "x0": 0.3098901098901099, "y0": 0.8974358974358975, "x1": 0.634065934065934, "y1": 0.9075369075369075}], [{"text": "Text 4 \u2014 Nonfiction extract", "x0": 0.11978021978021978, "y0": 0.08158508158508158, "x1": 0.36153846153846153, "y1": 0.09168609168609168}, {"text": "First came her stories like webs across the world. They crisscrossed the Atlanti\u00a2 on steamers and", "x0": 0.11978021978021978, "y0": 0.13286713286713286, "x1": 0.8802197802197802, "y1": 0.1452991452991453}, {"text": "the Rockies by train. They made their way down dirt tracks where the scrub het overhead. They", "x0": 0.11978021978021978, "y0": 0.14918414918414918, "x1": 0.8791208791208791, "y1": 0.1623931623931624}, {"text": "flew from Ben Lomond in the Tasmanian Highlands, which we could see from her verandah, to", "x0": 0.11978021978021978, "y0": 0.16705516705516704, "x1": 0.8802197802197802, "y1": 0.18026418026418026}, {"text": "Welsh farmhouses of dark stone. The air would shiver slightly each tinfe she began.", "x0": 0.11978021978021978, "y0": 0.18414918414918416, "x1": 0.7967032967032966, "y1": 0.19735819735819735}, {"text": "Once upon a time, when pigs were swine and monkeys chewed tobacco, there was a little girl", "x0": 0.11978021978021978, "y0": 0.216006216006216, "x1": 0.8802197802197802, "y1": 0.22921522921522922}, {"text": "who lived at the foot of the mountains in the centre of the univers\u00a2 at the bottom of the world . .4", "x0": 0.11978021978021978, "y0": 0.2338772338772339, "x1": 0.8791208791208791, "y1": 0.24708624708624707}, {"text": "The story-teller was my grandmother and the child was me. We came to her for stories .. /Her", "x0": 0.11868131868131868, "y0": 0.26573426573426573, "x1": 0.8802197802197802, "y1": 0.2789432789432789}, {"text": "stories were vivid and shapely and we heard them again and again. In the night under th\u00e9 pine", "x0": 0.11978021978021978, "y0": 0.2828282828282828, "x1": 0.8802197802197802, "y1": 0.29603729603729606}, {"text": "trees, her house creaked and her stories invaded our dr\u00e9ams. Later I would catch something", "x0": 0.11978021978021978, "y0": 0.2999222999222999, "x1": 0.8802197802197802, "y1": 0.31313131313131315}, {"text": "of their rhythms and word play in ballads and sagas arid knowpwhat a talented story-teller she", "x0": 0.11978021978021978, "y0": 0.3177933177933178, "x1": 0.8802197802197802, "y1": 0.331002331002331}, {"text": "was. Then we took her for granted ...", "x0": 0.11978021978021978, "y0": 0.3348873348873349, "x1": 0.4230769230769231, "y1": 0.3480963480963481}, {"text": "She was born in 1894, a beloved only child family with money or the myth of", "x0": 0.11978021978021978, "y0": 0.3667443667443667, "x1": 0.8813186813186813, "y1": 0.37995337995337997}, {"text": "money from her great-great-grandfather, a \u00a2lergyman, who had invested during the early", "x0": 0.11978021978021978, "y0": 0.38461538461538464, "x1": 0.8791208791208791, "y1": 0.3978243978243978}, {"text": "nineteenth century, surely somewhat dubiously, in Wel8h.coalmines. Family portraits survive", "x0": 0.11978021978021978, "y0": 0.4017094017094017, "x1": 0.8802197802197802, "y1": 0.4149184149184149}, {"text": "and hang in a Tasmanian dining-room.", "x0": 0.11978021978021978, "y0": 0.4188034188034188, "x1": 0.432967032967033, "y1": 0.432012432012432}, {"text": "I know I should check the facts. There is evidence to be weighed, archives to be searched,", "x0": 0.11978021978021978, "y0": 0.44755244755244755, "x1": 0.8791208791208791, "y1": 0.4677544677544678}, {"text": "family members still alive who knew her willbe shipping lists and parish", "x0": 0.12087912087912088, "y0": 0.46853146853146854, "x1": 0.8802197802197802, "y1": 0.48174048174048173}, {"text": "records, deeds and wills lodged in three countries. The men I will find easily, labelled by their", "x0": 0.11978021978021978, "y0": 0.48562548562548563, "x1": 0.8802197802197802, "y1": 0.4988344988344988}, {"text": "work and their bank balances, the buying and land, and of houses returned to at night.", "x0": 0.11978021978021978, "y0": 0.5027195027195027, "x1": 0.8791208791208791, "y1": 0.515928515928516}, {"text": "The women will have left less clear the record but more of a mark on me, perhaps,", "x0": 0.11978021978021978, "y0": 0.5198135198135199, "x1": 0.8791208791208791, "y1": 0.533022533022533}, {"text": "and on all the children in b\u00e9tween. some family papers, recipes, photographs and a", "x0": 0.11978021978021978, "y0": 0.5369075369075369, "x1": 0.8802197802197802, "y1": 0.5501165501165501}, {"text": "sampler in black cross-stitch done, my grandmother told me, by a child, my great-great-great-", "x0": 0.11978021978021978, "y0": 0.554001554001554, "x1": 0.8791208791208791, "y1": 0.5672105672105672}, {"text": "great-grandmother, during the whe children were forbidden to use coloured", "x0": 0.11978021978021978, "y0": 0.5718725718725719, "x1": 0.8802197802197802, "y1": 0.585081585081585}, {"text": "silks. Or so she said/", "x0": 0.11978021978021978, "y0": 0.5889665889665889, "x1": 0.2857142857142857, "y1": 0.5990675990675991}, {"text": "There were stori\u00e9s of unfeeling and withheld and unsuitable marriages when.", "x0": 0.11978021978021978, "y0": 0.6208236208236209, "x1": 0.8802197802197802, "y1": 0.634032634032634}, {"text": "good-looking took adVantage of well-to-do widows \u2014 one of whom was my greg", "x0": 0.11978021978021978, "y0": 0.6379176379176379, "x1": 0.8626373626373627, "y1": 0.6511266511266511}, {"text": "grandmother. She seems to An American twenty years her junior after my great-", "x0": 0.11978021978021978, "y0": 0.6557886557886557, "x1": 0.8791208791208791, "y1": 0.668997668997669}, {"text": "grandfathet died. This young man wenvinto the city of London every morning at ten but never", "x0": 0.11978021978021978, "y0": 0.6728826728826729, "x1": 0.8813186813186813, "y1": 0.6860916860916861}, {"text": "told his wife what he did there. Perhaps she never asked. When it was discovered that he'd been", "x0": 0.11978021978021978, "y0": 0.6899766899766899, "x1": 0.8802197802197802, "y1": 0.7031857031857032}, {"text": "through all her money, he returned fo America, never to be seen again. Or so the story goes ...", "x0": 0.11978021978021978, "y0": 0.7070707070707071, "x1": 0.8791208791208791, "y1": 0.7202797202797203}, {"text": "The historian at the back of my brain says I should discover what is true and what is", "x0": 0.11978021978021978, "y0": 0.7397047397047397, "x1": 0.8296703296703297, "y1": 0.752913752913753}, {"text": "ake a properly considered a\u00a2count before it\u2019s too late. The rest of me, the part that w:", "x0": 0.11978021978021978, "y0": 0.7567987567987567, "x1": 0.8032967032967033, "y1": 0.77000777000777}, {"text": "by the sense of myself at the centre of the universe at the bottom of the world, still sees, as", "x0": 0.11978021978021978, "y0": 0.7738927738927739, "x1": 0.8582417582417582, "y1": 0.7871017871017871}, {"text": "through certain cloud formations above paddocks pale with tussocks, the shapes and shadows", "x0": 0.12087912087912088, "y0": 0.790986790986791, "x1": 0.8802197802197802, "y1": 0.8041958041958042}, {"text": "of other places she made my own.", "x0": 0.11978021978021978, "y0": 0.8080808080808081, "x1": 0.3956043956043956, "y1": 0.8212898212898213}, {"text": "I want to leave her/and her stories be.", "x0": 0.12087912087912088, "y0": 0.8414918414918415, "x1": 0.42417582417582417, "y1": 0.8508158508158508}, {"text": "McPHEE", "x0": 0.8120879120879121, "y0": 0.8741258741258742, "x1": 0.8802197802197802, "y1": 0.8834498834498834}, {"text": "Adapted from Other People\u2019s Words", "x0": 0.5813186813186814, "y0": 0.8904428904428905, "x1": 0.8802197802197802, "y1": 0.9036519036519036}, {"text": "Other's people's Words by Hilary McPhee (Picador 2001),", "x0": 0.11978021978021978, "y0": 0.9153069153069153, "x1": 0.44945054945054946, "y1": 0.9246309246309247}, {"text": "www.hilarymephee.com", "x0": 0.11978021978021978, "y0": 0.9261849261849262, "x1": 0.2549450549450549, "y1": 0.9355089355089355}], [{"text": "Section II", "x0": 0.11978021978021978, "y0": 0.08236208236208237, "x1": 0.2164835164835165, "y1": 0.09401709401709402}, {"text": "Text 5", "x0": 0.11978021978021978, "y0": 0.11810411810411811, "x1": 0.17252747252747253, "y1": 0.12742812742812742}, {"text": "\u00a9 Dynamic Duo Studio, worried Man 48370", "x0": 0.5010989010989011, "y0": 0.1383061383061383, "x1": 0.8263736263736263, "y1": 0.14763014763014762}, {"text": "Se", "x0": 0.0945054945054945, "y0": 0.16938616938616938, "x1": 0.11868131868131868, "y1": 0.18337218337218336}, {"text": "33", "x0": 0.09230769230769231, "y0": 0.20046620046620048, "x1": 0.11868131868131868, "y1": 0.21678321678321677}, {"text": "as", "x0": 0.09230769230769231, "y0": 0.22066822066822067, "x1": 0.11868131868131868, "y1": 0.23543123543123542}, {"text": "Awaiting copyright", "x0": 0.4164835164835165, "y0": 0.4094794094794095, "x1": 0.578021978021978, "y1": 0.4226884226884227}, {"text": "Awaiting copyright", "x0": 0.5824175824175825, "y0": 0.6635586635586636, "x1": 0.743956043956044, "y1": 0.6767676767676768}, {"text": "tion of a golden compass on an antique map", "x0": 0.09230769230769231, "y0": 0.6930846930846931, "x1": 0.1054945054945055, "y1": 0.8857808857808858}, {"text": "#g94565653 \u00a9 GoGraph.com/Paul Fi", "x0": 0.1087912087912088, "y0": 0.7505827505827506, "x1": 0.12197802197802197, "y1": 0.9145299145299145}, {"text": "tus", "x0": 0.09230769230769231, "y0": 0.9028749028749029, "x1": 0.1021978021978022, "y1": 0.9145299145299145}], [{"text": "Section III", "x0": 0.11978021978021978, "y0": 0.08236208236208237, "x1": 0.22527472527472528, "y1": 0.09401709401709402}, {"text": "The prescribed texts for Section III are listed below:", "x0": 0.11868131868131868, "y0": 0.11732711732711733, "x1": 0.5417582417582417, "y1": 0.13053613053613053}, {"text": "Prose Fiction", "x0": 0.14395604395604394, "y0": 0.14840714840714841, "x1": 0.256043956043956, "y1": 0.1585081585081585}, {"text": "James Bradley, Wrack", "x0": 0.33406593406593404, "y0": 0.14918414918414918, "x1": 0.5153846153846153, "y1": 0.16161616161616163}, {"text": "Kate Chopin, The Awakening", "x0": 0.33406593406593404, "y0": 0.17094017094017094, "x1": 0.5703296703296703, "y1": 0.18337218337218336}, {"text": "Tara June Winch, Swallow the Air", "x0": 0.33296703296703295, "y0": 0.19114219114219114, "x1": 0.6120879120879121, "y1": 0.20279720279720279}, {"text": "Nonfiction", "x0": 0.14285714285714285, "y0": 0.2128982128982129, "x1": 0.23296703296703297, "y1": 0.222999222999223}, {"text": "Bill Bryson, A Short History of Nearly Everything", "x0": 0.33406593406593404, "y0": 0.2128982128982129, "x1": 0.7395604395604396, "y1": 0.2261072261072261}, {"text": "Ernesto \u2018Che\u2019 Guevara, The Motorcy\u00a2le Diaries", "x0": 0.33406593406593404, "y0": 0.2338772338772339, "x1": 0.7230769230769231, "y1": 0.2455322455