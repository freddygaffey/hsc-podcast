7342657342656, "x1": 0.4208791208791209, "y1": 0.4366744366744367}, {"text": "* Painter of Antwerp.", "x0": 0.33516483516483514, "y0": 0.4428904428904429, "x1": 0.512087912087912, "y1": 0.4560994560994561}, {"text": "* Travell\u00e9r\u2019s Tale", "x0": 0.33516483516483514, "y0": 0.4592074592074592, "x1": 0.4868131868131868, "y1": 0.46853146853146854}, {"text": "The Tiger", "x0": 0.35824175824175825, "y0": 0.47474747474747475, "x1": 0.43736263736263736, "y1": 0.48795648795648794}, {"text": "*", "x0": 0.33516483516483514, "y0": 0.4755244755244755, "x1": 0.34175824175824177, "y1": 0.48096348096348096}, {"text": "Cock Crow", "x0": 0.35824175824175825, "y0": 0.49106449106449107, "x1": 0.44835164835164837, "y1": 0.5011655011655012}, {"text": "*", "x0": 0.33516483516483514, "y0": 0.49184149184149184, "x1": 0.34175824175824177, "y1": 0.4972804972804973}, {"text": "Ghost Town: New England", "x0": 0.35824175824175825, "y0": 0.5066045066045066, "x1": 0.578021978021978, "y1": 0.5198135198135199}, {"text": "*", "x0": 0.33516483516483514, "y0": 0.5073815073815073, "x1": 0.34175824175824177, "y1": 0.5128205128205128}, {"text": "Robert Frost, The Poetry of Robert Frost", "x0": 0.33406593406593404, "y0": 0.5283605283605284, "x1": 0.6659340659340659, "y1": 0.5415695415695416}, {"text": "The prescribed poems are:", "x0": 0.33296703296703295, "y0": 0.5470085470085471, "x1": 0.5461538461538461, "y1": 0.5602175602175602}, {"text": "Flowers", "x0": 0.45274725274725275, "y0": 0.5664335664335665, "x1": 0.5175824175824176, "y1": 0.5757575757575758}, {"text": "Mending Wall", "x0": 0.35714285714285715, "y0": 0.581973581973582, "x1": 0.4725274725274725, "y1": 0.5951825951825952}, {"text": "Home Burial", "x0": 0.35714285714285715, "y0": 0.5982905982905983, "x1": 0.46153846153846156, "y1": 0.6076146076146076}, {"text": "\u201cAfter Apple-Picking", "x0": 0.35604395604395606, "y0": 0.6138306138306139, "x1": 0.5164835164835165, "y1": 0.627039627039627}, {"text": "Fif@and Ice", "x0": 0.35714285714285715, "y0": 0.6301476301476302, "x1": 0.45714285714285713, "y1": 0.6410256410256411}, {"text": "Stopping by Woods on a Snowy Evening", "x0": 0.35714285714285715, "y0": 0.6456876456876457, "x1": 0.6835164835164835, "y1": 0.6588966588966589}, {"text": "Rob\u00e9it Gray, Coast Road", "x0": 0.33406593406593404, "y0": 0.6674436674436675, "x1": 0.5395604395604395, "y1": 0.6806526806526807}, {"text": "The prescribed poems are:", "x0": 0.33296703296703295, "y0": 0.6868686868686869, "x1": 0.5461538461538461, "y1": 0.6993006993006993}, {"text": "Journ\u00e9y: the North Coast", "x0": 0.35714285714285715, "y0": 0.7047397047397047, "x1": 0.5637362637362637, "y1": 0.717948717948718}, {"text": "The/Meatworks", "x0": 0.35824175824175825, "y0": 0.721056721056721, "x1": 0.48131868131868133, "y1": 0.7311577311577312}, {"text": "North Coast Town", "x0": 0.35714285714285715, "y0": 0.7373737373737373, "x1": 0.5054945054945055, "y1": 0.7466977466977467}, {"text": "Late Ferry", "x0": 0.35604395604395606, "y0": 0.7536907536907537, "x1": 0.44395604395604393, "y1": 0.7637917637917638}, {"text": "Flames and Dangling Wire", "x0": 0.35714285714285715, "y0": 0.7684537684537684, "x1": 0.578021978021978, "y1": 0.7816627816627817}, {"text": "Diptych", "x0": 0.35714285714285715, "y0": 0.7855477855477856, "x1": 0.4197802197802198, "y1": 0.797979797979798}, {"text": "Media", "x0": 0.14285714285714285, "y0": 0.8065268065268065, "x1": 0.1967032967032967, "y1": 0.8166278166278166}, {"text": "Simon Nasht, Frank Hurley ~ The Man Who Made History", "x0": 0.33406593406593404, "y0": 0.8065268065268065, "x1": 0.8131868131868132, "y1": 0.8181818181818182}, {"text": "Ivan O\u2019Mahoney", "x0": 0.33406593406593404, "y0": 0.8282828282828283, "x1": 0.4703296703296703, "y1": 0.8407148407148407}, {"text": "* Go Back to Where You Came From", "x0": 0.33516483516483514, "y0": 0.8508158508158508, "x1": 0.6461538461538462, "y1": 0.8601398601398601}, {"text": "~ Series 1: Episodes 1, 2 and 3", "x0": 0.35714285714285715, "y0": 0.8663558663558664, "x1": 0.6098901098901099, "y1": 0.8795648795648796}, {"text": "and", "x0": 0.35714285714285715, "y0": 0.8857808857808858, "x1": 0.38571428571428573, "y1": 0.8951048951048951}, {"text": "* The Response", "x0": 0.33516483516483514, "y0": 0.9036519036519036, "x1": 0.46813186813186813, "y1": 0.9168609168609169}, {"text": "(\u00a9 2016 Board of Teaching and Educational Standards NSW", "x0": 0.3362637362637363, "y0": 0.9572649572649573, "x1": 0.6626373626373626, "y1": 0.9642579642579643}]]