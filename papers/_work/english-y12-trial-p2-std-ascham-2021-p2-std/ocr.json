[[{"text": "ASCHAM SCHOOL", "x0": 0.4032085561497326, "y0": 0.09421487603305785, "x1": 0.5967914438502674, "y1": 0.10661157024793388}, {"text": "2021", "x0": 0.46203208556149733, "y0": 0.24793388429752067, "x1": 0.5347593582887701, "y1": 0.26859504132231404}, {"text": "English Standard", "x0": 0.3433155080213904, "y0": 0.30082644628099175, "x1": 0.6556149732620321, "y1": 0.3330578512396694}, {"text": "Trial HSC", "x0": 0.40641711229946526, "y0": 0.3413223140495868, "x1": 0.5925133689839572, "y1": 0.3669421487603306}, {"text": "Paper 2 \u2014 Modules", "x0": 0.32834224598930484, "y0": 0.4140495867768595, "x1": 0.6705882352941176, "y1": 0.4462809917355372}, {"text": "Total Marks - 60", "x0": 0.5593582887700534, "y0": 0.5380165289256198, "x1": 0.7219251336898396, "y1": 0.5504132231404959}, {"text": "Section 1)", "x0": 0.5283422459893048, "y0": 0.5760330578512397, "x1": 0.6128342245989304, "y1": 0.5884297520661157}, {"text": "20 marks", "x0": 0.5272727272727272, "y0": 0.6016528925619835, "x1": 0.6160427807486631, "y1": 0.6140495867768595}, {"text": "* Attempt ONE Question", "x0": 0.5272727272727272, "y0": 0.6264462809917355, "x1": 0.7251336898395722, "y1": 0.640495867768595}, {"text": "General Instructions Allow about 40 minutes for this section.", "x0": 0.14759358288770053, "y0": 0.6454545454545455, "x1": 0.8545454545454545, "y1": 0.6586776859504132}, {"text": "Reading time \u2014 5 minutes", "x0": 0.17754010695187167, "y0": 0.6801652892561983, "x1": 0.40641711229946526, "y1": 0.6942148760330579}, {"text": "Section 2|", "x0": 0.5283422459893048, "y0": 0.6917355371900826, "x1": 0.613903743315508, "y1": 0.7041322314049587}, {"text": "\u00a9 Working time \u2014 2 hours", "x0": 0.17754010695187167, "y0": 0.6983471074380165, "x1": 0.3925133689839572, "y1": 0.7123966942148761}, {"text": "\u00a9 Write using black pen. 20 marks", "x0": 0.17754010695187167, "y0": 0.7165289256198347, "x1": 0.6160427807486631, "y1": 0.731404958677686}, {"text": "* Attempt ONE question", "x0": 0.5272727272727272, "y0": 0.7413223140495868, "x1": 0.720855614973262, "y1": 0.7553719008264462}, {"text": "* Allow about 40 minutes for this section.", "x0": 0.5272727272727272, "y0": 0.7628099173553718, "x1": 0.8545454545454545, "y1": 0.7735537190082644}, {"text": "Section 3}", "x0": 0.5283422459893048, "y0": 0.8066115702479338, "x1": 0.613903743315508, "y1": 0.8190082644628099}, {"text": "20 marks", "x0": 0.5272727272727272, "y0": 0.8322314049586776, "x1": 0.6160427807486631, "y1": 0.8446280991735537}, {"text": "Attempt Question 3", "x0": 0.5422459893048128, "y0": 0.856198347107438, "x1": 0.6941176470588235, "y1": 0.8702479338842976}, {"text": "Allow about 40 minutes for this section", "x0": 0.5422459893048128, "y0": 0.8785123966942149, "x1": 0.8502673796791443, "y1": 0.8892561983471075}], [{"text": "Section I\u2014 Module A: Language, Identity and Culture", "x0": 0.12197802197802197, "y0": 0.08857808857808858, "x1": 0.7417582417582418, "y1": 0.10567210567210568}, {"text": "Total marks 20", "x0": 0.12197802197802197, "y0": 0.10955710955710955, "x1": 0.26263736263736265, "y1": 0.12121212121212122}, {"text": "Attempt ONE question.", "x0": 0.12087912087912088, "y0": 0.128982128982129, "x1": 0.34175824175824177, "y1": 0.1445221445221445}, {"text": "Allow about 40 minutes for this section.", "x0": 0.12087912087912088, "y0": 0.14840714840714841, "x1": 0.4978021978021978, "y1": 0.16006216006216006}, {"text": "Answer the question in a writing booklet.", "x0": 0.12087912087912088, "y0": 0.16705516705516704, "x1": 0.5087912087912088, "y1": 0.1825951825951826}, {"text": "In your answer you will be assessed on how well you:", "x0": 0.12197802197802197, "y0": 0.22377622377622378, "x1": 0.554945054945055, "y1": 0.236985236985237}, {"text": "\u00a9 demonstrate understanding of how ideas about language, identity and culture are", "x0": 0.12197802197802197, "y0": 0.2571872571872572, "x1": 0.8, "y1": 0.2703962703962704}, {"text": "expressed through texts", "x0": 0.15164835164835164, "y0": 0.27350427350427353, "x1": 0.34065934065934067, "y1": 0.2867132867132867}, {"text": "\u00a9 demonstrate understanding of how language is used to shape meaning about individuals", "x0": 0.12197802197802197, "y0": 0.2913752913752914, "x1": 0.8582417582417582, "y1": 0.3045843045843046}, {"text": "and/or cultural groups", "x0": 0.15164835164835164, "y0": 0.3076923076923077, "x1": 0.32857142857142857, "y1": 0.3209013209013209}, {"text": "\u00a9 organise, develop and express your ideas using language appropriate to audience, purpose", "x0": 0.12197802197802197, "y0": 0.3247863247863248, "x1": 0.8747252747252747, "y1": 0.337995337995338}, {"text": "and form", "x0": 0.15164835164835164, "y0": 0.33255633255633255, "x1": 0.2230769230769231, "y1": 0.358974358974359}, {"text": "Question 1", "x0": 0.12197802197802197, "y0": 0.40792540792540793, "x1": 0.210989010989011, "y1": 0.4195804195804196}, {"text": "Prose Fiction", "x0": 0.12197802197802197, "y0": 0.4405594405594406, "x1": 0.23296703296703297, "y1": 0.44988344988344986}, {"text": "\u2014 Henry Lawson, The Penguin Henry Lawson Short Stories (20 marks)", "x0": 0.12087912087912088, "y0": 0.4568764568764569, "x1": 0.7021978021978021, "y1": 0.4700854700854701}, {"text": "Each of the stories set for study remind us in some way that conditions in the nineteenth century were", "x0": 0.10989010989010989, "y0": 0.49106449106449107, "x1": 0.8593406593406593, "y1": 0.5034965034965035}, {"text": "hard. Life in the bush and the world of Australia represented, inspire Lawson to craft characters who are", "x0": 0.10989010989010989, "y0": 0.5058275058275058, "x1": 0.878021978021978, "y1": 0.5182595182595182}, {"text": "resilient but also suspicious of others.", "x0": 0.10989010989010989, "y0": 0.5213675213675214, "x1": 0.38571428571428573, "y1": 0.5337995337995338}, {"text": "How does Lawson effectively capture life and the world of Australia in TWO of the prescribed short", "x0": 0.10989010989010989, "y0": 0.5431235431235432, "x1": 0.8527472527472527, "y1": 0.567987567987568}, {"text": "stories from The Penguin Henry Lawson Short Stories?", "x0": 0.10989010989010989, "y0": 0.5664335664335665, "x1": 0.5472527472527473, "y1": 0.5796425796425796}, {"text": "The prescribed short stories are:", "x0": 0.12197802197802197, "y0": 0.5944055944055944, "x1": 0.378021978021978, "y1": 0.6076146076146076}, {"text": "*The Wife", "x0": 0.12197802197802197, "y0": 0.6130536130536131, "x1": 0.2835164835164835, "y1": 0.6231546231546231}, {"text": "*The Union Buries Its Dead", "x0": 0.12197802197802197, "y0": 0.6317016317016317, "x1": 0.34725274725274724, "y1": 0.6418026418026418}, {"text": "*Shooting the Moon", "x0": 0.12197802197802197, "y0": 0.6511266511266511, "x1": 0.2857142857142857, "y1": 0.6643356643356644}, {"text": "*Our Pipes", "x0": 0.12197802197802197, "y0": 0.6697746697746698, "x1": 0.2098901098901099, "y1": 0.682983682983683}, {"text": "*The Loaded Dog", "x0": 0.12197802197802197, "y0": 0.6884226884226884, "x1": 0.26703296703296703, "y1": 0.7016317016317016}, {"text": "OR", "x0": 0.4846153846153846, "y0": 0.7202797202797203, "x1": 0.5142857142857142, "y1": 0.7296037296037297}, {"text": "\u2014 Andrea Levy, Small Island (20 marks)", "x0": 0.12087912087912088, "y0": 0.7668997668997669, "x1": 0.45494505494505494, "y1": 0.7801087801087802}, {"text": "There are some words that once spoken will split the world in two. There would be the life before you", "x0": 0.10989010989010989, "y0": 0.8010878010878011, "x1": 0.8626373626373627, "y1": 0.8135198135198135}, {"text": "breathed them and then the altered life after they'd been said. They take a long time to find, words like", "x0": 0.10989010989010989, "y0": 0.8158508158508159, "x1": 0.8648351648351649, "y1": 0.8282828282828283}, {"text": "that. They make you hesitate. Choose them with care. Hold onto them unspoken as long as you can", "x0": 0.10989010989010989, "y0": 0.8306138306138307, "x1": 0.8428571428571429, "y1": 0.8430458430458431}, {"text": "just so your world will stay intact.", "x0": 0.1076923076923077, "y0": 0.8461538461538461, "x1": 0.36153846153846153, "y1": 0.8585858585858586}, {"text": "How does Levy effectively capture a world that is \u2018split in two\u2019 in her novel, Small Island?", "x0": 0.10989010989010989, "y0": 0.8756798756798757, "x1": 0.7813186813186813, "y1": 0.8881118881118881}, {"text": "OR", "x0": 0.4846153846153846, "y0": 0.9168609168609169, "x1": 0.5142857142857142, "y1": 0.9261849261849262}], [{"text": "POETRY", "x0": 0.10989010989010989, "y0": 0.08857808857808858, "x1": 0.19230769230769232, "y1": 0.0979020979020979}, {"text": "\u2014 Adam Aitken, Boey Kim Cheng and Michelle Cahill (eds),", "x0": 0.12087912087912088, "y0": 0.11810411810411811, "x1": 0.6208791208791209, "y1": 0.13131313131313133}, {"text": "Contemporary Asian Australian Poets (20 marks)", "x0": 0.12197802197802197, "y0": 0.13442113442113443, "x1": 0.5208791208791209, "y1": 0.14763014763014762}, {"text": "Contemporary Asian Australian Poets has three introductions one written by each editor that focuses on", "x0": 0.10989010989010989, "y0": 0.16705516705516704, "x1": 0.8769230769230769, "y1": 0.1794871794871795}, {"text": "the worlds offered by the poets in the anthology. Kim Cheng Boey focuses on the experience of", "x0": 0.10989010989010989, "y0": 0.18181818181818182, "x1": 0.8186813186813187, "y1": 0.19425019425019424}, {"text": "migration, emphasising the writing of first-generation immigrants. Michelle Cahill examines the work of", "x0": 0.10989010989010989, "y0": 0.19658119658119658, "x1": 0.8857142857142857, "y1": 0.20901320901320902}, {"text": "women poets and their experience of marginalisation. Aitken offers (that) Asian-Australian poets may", "x0": 0.10989010989010989, "y0": 0.21212121212121213, "x1": 0.8637362637362638, "y1": 0.22455322455322455}, {"text": "choose to speak as a member of a minority culture and to be strategically essentialist.", "x0": 0.10989010989010989, "y0": 0.2191142191142191, "x1": 0.7373626373626374, "y1": 0.24397824397824397}, {"text": "How do TWO poets from your prescribed text effectively capture the worlds offered by the editors of", "x0": 0.10989010989010989, "y0": 0.2564102564102564, "x1": 0.8615384615384616, "y1": 0.26884226884226886}, {"text": "Contemporary Asian Australian Poets?", "x0": 0.10989010989010989, "y0": 0.27195027195027194, "x1": 0.4, "y1": 0.28438228438228436}, {"text": "The prescribed poems are:", "x0": 0.12087912087912088, "y0": 0.29836829836829837, "x1": 0.33186813186813185, "y1": 0.31157731157731156}, {"text": "*Merlinda Bobis, This is where it begins", "x0": 0.12197802197802197, "y0": 0.3177933177933178, "x1": 0.4472527472527473, "y1": 0.331002331002331}, {"text": "*Miriam Wei Wei Lo, Home", "x0": 0.12197802197802197, "y0": 0.33644133644133645, "x1": 0.35384615384615387, "y1": 0.3480963480963481}, {"text": "*Ouyang Yu, New Accents", "x0": 0.12197802197802197, "y0": 0.3550893550893551, "x1": 0.3373626373626374, "y1": 0.3682983682983683}, {"text": "*Vuong Pham, Mother", "x0": 0.12197802197802197, "y0": 0.37373737373737376, "x1": 0.3065934065934066, "y1": 0.38694638694638694}, {"text": "*Jaya Savige, Circular Breathing", "x0": 0.12197802197802197, "y0": 0.39316239316239315, "x1": 0.3923076923076923, "y1": 0.4063714063714064}, {"text": "*Maureen Ten (Ten Chin U), Translucent Jade", "x0": 0.12197802197802197, "y0": 0.41025641025641024, "x1": 0.5076923076923077, "y1": 0.42424242424242425}, {"text": "OR", "x0": 0.545054945054945, "y0": 0.4568764568764569, "x1": 0.5747252747252747, "y1": 0.4662004662004662}, {"text": "\u2014 Ali Cobby Eckermann, Inside my Mother (20 marks)", "x0": 0.12087912087912088, "y0": 0.49805749805749805, "x1": 0.5703296703296703, "y1": 0.5112665112665112}, {"text": "As an Aboriginal descended from the Yankunytjatjara language group, Cobby Eckermann\u2019s chief", "x0": 0.10989010989010989, "y0": 0.5299145299145299, "x1": 0.8318681318681319, "y1": 0.5423465423465423}, {"text": "concern is to express the world of what she sees as the untold truth of Aboriginal people, both in terms of", "x0": 0.10989010989010989, "y0": 0.5454545454545454, "x1": 0.889010989010989, "y1": 0.5578865578865578}, {"text": "vital aspects of their culture, as well as regarding the (ongoing) detrimental impact of European", "x0": 0.10989010989010989, "y0": 0.5524475524475524, "x1": 0.8142857142857143, "y1": 0.5773115773115773}, {"text": "colonisation.", "x0": 0.10989010989010989, "y0": 0.574980574980575, "x1": 0.2032967032967033, "y1": 0.5843045843045843}, {"text": "How do TWO of Eckermann\u2019s poems effectively capture the world of the untold truth of Aboriginal", "x0": 0.10989010989010989, "y0": 0.5975135975135976, "x1": 0.8494505494505494, "y1": 0.6223776223776224}, {"text": "people in the poetry collection, Inside my Mother?", "x0": 0.10989010989010989, "y0": 0.6208236208236209, "x1": 0.489010989010989, "y1": 0.634032634032634}, {"text": "The prescribed poems are:", "x0": 0.12087912087912088, "y0": 0.6487956487956488, "x1": 0.33186813186813185, "y1": 0.662004662004662}, {"text": "*Trance", "x0": 0.12197802197802197, "y0": 0.6674436674436675, "x1": 0.1879120879120879, "y1": 0.6775446775446775}, {"text": "*Unearth", "x0": 0.12197802197802197, "y0": 0.6860916860916861, "x1": 0.1967032967032967, "y1": 0.6961926961926962}, {"text": "*Oombulgarri", "x0": 0.12197802197802197, "y0": 0.7055167055167055, "x1": 0.23736263736263735, "y1": 0.7187257187257188}, {"text": "*Byes", "x0": 0.12197802197802197, "y0": 0.7241647241647242, "x1": 0.16813186813186815, "y1": 0.7373737373737373}, {"text": "*Leaves", "x0": 0.12197802197802197, "y0": 0.7428127428127428, "x1": 0.18571428571428572, "y1": 0.752913752913753}, {"text": "*Key", "x0": 0.12417582417582418, "y0": 0.7614607614607615, "x1": 0.16263736263736264, "y1": 0.7746697746697747}, {"text": "OR", "x0": 0.4846153846153846, "y0": 0.8197358197358198, "x1": 0.5142857142857142, "y1": 0.8290598290598291}], [{"text": "DRAMA", "x0": 0.10989010989010989, "y0": 0.10256410256410256, "x1": 0.18571428571428572, "y1": 0.11188811188811189}, {"text": "\u2014 Ray Lawler, Summer of the Seventeenth Doll (20 marks)", "x0": 0.12087912087912088, "y0": 0.13286713286713286, "x1": 0.6010989010989011, "y1": 0.14607614607614608}, {"text": "Images of Australian manhood in the first half of the 20\" Century were based around ideas of", "x0": 0.10989010989010989, "y0": 0.16006216006216006, "x1": 0.8021978021978022, "y1": 0.18492618492618493}, {"text": "individualism, self-confidence, physical strength and mateship. Women in the 1950s were expected to fill", "x0": 0.10989010989010989, "y0": 0.1825951825951826, "x1": 0.889010989010989, "y1": 0.19502719502719504}, {"text": "a domestic role, to find a husband, have children, and then stay at home. However, the world in the 1950s", "x0": 0.10989010989010989, "y0": 0.19735819735819735, "x1": 0.889010989010989, "y1": 0.2097902097902098}, {"text": "was a time of transition and change for the way Australian men and women saw themselves and in the", "x0": 0.10989010989010989, "y0": 0.2128982128982129, "x1": 0.8648351648351649, "y1": 0.22533022533022534}, {"text": "ways they related to their domestic world.", "x0": 0.10989010989010989, "y0": 0.22766122766122765, "x1": 0.4186813186813187, "y1": 0.2400932400932401}, {"text": "How does Lawler effectively capture the domestic world of transition and change in his play, \u2018Summer", "x0": 0.10989010989010989, "y0": 0.257964257964258, "x1": 0.8714285714285714, "y1": 0.2703962703962704}, {"text": "of the 17th Doll\u201d?", "x0": 0.10989010989010989, "y0": 0.26495726495726496, "x1": 0.24065934065934066, "y1": 0.2898212898212898}, {"text": "OR", "x0": 0.4846153846153846, "y0": 0.31313131313131315, "x1": 0.5142857142857142, "y1": 0.32245532245532244}, {"text": "\u2014 Bernard Shaw, Pygmalion (20 marks)", "x0": 0.12087912087912088, "y0": 0.35586635586635584, "x1": 0.45054945054945056, "y1": 0.3690753690753691}, {"text": "In Shaw\u2019s Pygmalion, Higgins, a teacher \u2018creates\u2019 Eliza, his pupil, by teaching her to speak like a", "x0": 0.10989010989010989, "y0": 0.39083139083139085, "x1": 0.8285714285714286, "y1": 0.40326340326340326}, {"text": "duchess ~ a transformation that allows Shaw to attack the superficial class prejudices of his time and", "x0": 0.10989010989010989, "y0": 0.3986013986013986, "x1": 0.8516483516483516, "y1": 0.4234654234654235}, {"text": "present a play that challenged rigid social classes. The play is about language, and the idea that, through", "x0": 0.10989010989010989, "y0": 0.4211344211344211, "x1": 0.8769230769230769, "y1": 0.43356643356643354}, {"text": "language, one can raise one social status. Once Higgins completes Eliza\u2019s transformation she is stuck", "x0": 0.10989010989010989, "y0": 0.4358974358974359, "x1": 0.8571428571428571, "y1": 0.4483294483294483}, {"text": "between the worlds.", "x0": 0.10989010989010989, "y0": 0.45143745143745145, "x1": 0.256043956043956, "y1": 0.46076146076146074}, {"text": "How does Shaw effectively capture this negotiation of being between worlds in his play Pygmalion\u2019?", "x0": 0.10989010989010989, "y0": 0.48096348096348096, "x1": 0.8516483516483516, "y1": 0.4933954933954934}, {"text": "OR", "x0": 0.4846153846153846, "y0": 0.5221445221445221, "x1": 0.5142857142857142, "y1": 0.5314685314685315}, {"text": "\u2014 Alana Valentine, Shafana and Aunt Sarrinah (20 marks)", "x0": 0.12087912087912088, "y0": 0.5648795648795649, "x1": 0.6, "y1": 0.578088578088578}, {"text": "Shafana and Aunt Sarrinah introduces us to two Persian women of different generations who live in", "x0": 0.1087912087912088, "y0": 0.5920745920745921, "x1": 0.8494505494505494, "y1": 0.616938616938617}, {"text": "Australia. The world of the contemporary Australian Muslim woman is explored in the play. Throughout", "x0": 0.10989010989010989, "y0": 0.6146076146076146, "x1": 0.8846153846153846, "y1": 0.627039627039627}, {"text": "we are made aware of the aspirations of both women, their sacrifices and their strength and", "x0": 0.10989010989010989, "y0": 0.6301476301476302, "x1": 0.7824175824175824, "y1": 0.6425796425796426}, {"text": "determination, and also their spirituality.", "x0": 0.10989010989010989, "y0": 0.6449106449106449, "x1": 0.4087912087912088, "y1": 0.6573426573426573}, {"text": "How does Valentine effectively capture the world of these two Persian women in Shafana and Aunt", "x0": 0.10989010989010989, "y0": 0.6752136752136753, "x1": 0.8461538461538461, "y1": 0.6876456876456877}, {"text": "Sarrinah?", "x0": 0.1087912087912088, "y0": 0.6899766899766899, "x1": 0.1824175824175824, "y1": 0.6993006993006993}, {"text": "OR", "x0": 0.4846153846153846, "y0": 0.7062937062937062, "x1": 0.5142857142857142, "y1": 0.7156177156177156}, {"text": "Nonfiction", "x0": 0.10989010989010989, "y0": 0.7474747474747475, "x1": 0.1989010989010989, "y1": 0.7575757575757576}, {"text": "\u2014 Alice Pung, Unpolished Gem (20 marks)", "x0": 0.12087912087912088, "y0": 0.7801087801087802, "x1": 0.4472527472527473, "y1": 0.7925407925407926}, {"text": "Children of migrants can struggle to establish themselves in a new world while still honouring their", "x0": 0.10989010989010989, "y0": 0.8104118104118104, "x1": 0.843956043956044, "y1": 0.8228438228438228}, {"text": "parent\u2019s old-world history.", "x0": 0.10989010989010989, "y0": 0.8251748251748252, "x1": 0.3054945054945055, "y1": 0.8376068376068376}, {"text": "How does Pung effectively capture this negotiation of being between worlds in her memoir, Unpolished", "x0": 0.10989010989010989, "y0": 0.8554778554778555, "x1": 0.8791208791208791, "y1": 0.8679098679098679}, {"text": "OR", "x0": 0.4846153846153846, "y0": 0.9028749028749029, "x1": 0.5142857142857142, "y1": 0.9121989121989122}], [{"text": "Film", "x0": 0.10989010989010989, "y0": 0.13364413364413363, "x1": 0.14835164835164835, "y1": 0.14296814296814297}, {"text": "\u2014 Rachel Perkins, One Night the Moon (20 marks)", "x0": 0.12087912087912088, "y0": 0.16317016317016317, "x1": 0.5340659340659341, "y1": 0.17637917637917638}, {"text": "One Night the Moon centres on the true events that occurred in 1932. The story surrounding the", "x0": 0.10989010989010989, "y0": 0.19813519813519814, "x1": 0.8153846153846154, "y1": 0.21056721056721056}, {"text": "disappearance of a young girl in the outback draws a broader commentary on Indigenous and white", "x0": 0.10989010989010989, "y0": 0.20512820512820512, "x1": 0.8428571428571429, "y1": 0.22999222999222999}, {"text": "perspectives of the Australian landscape. The editing in the film is important in constructing the", "x0": 0.10989010989010989, "y0": 0.22843822843822845, "x1": 0.8175824175824176, "y1": 0.24087024087024086}, {"text": "conflicting \u2018worlds\u2019 represented in the film ~ those Indigenous and white perspectives of the Australian", "x0": 0.10989010989010989, "y0": 0.23543123543123542, "x1": 0.8725274725274725, "y1": 0.2602952602952603}, {"text": "land.", "x0": 0.10989010989010989, "y0": 0.257964257964258, "x1": 0.14505494505494507, "y1": 0.26728826728826727}, {"text": "How does Perkins effectively capture the conflicting worlds in her film, One Night the Moon\u2019?", "x0": 0.10989010989010989, "y0": 0.28826728826728826, "x1": 0.8032967032967033, "y1": 0.3006993006993007}, {"text": "OR", "x0": 0.4846153846153846, "y0": 0.3473193473193473, "x1": 0.5142857142857142, "y1": 0.35664335664335667}, {"text": "\u2014 Rob Sitch, The Castle (20 marks)", "x0": 0.12087912087912088, "y0": 0.40714840714840717, "x1": 0.4142857142857143, "y1": 0.42035742035742035}, {"text": "Sitch\u2019s film explores the uniqueness of how Australians view and understand their world. From the", "x0": 0.10989010989010989, "y0": 0.4421134421134421, "x1": 0.8417582417582418, "y1": 0.45454545454545453}, {"text": "David and Goliath story of battlers fighting against big business and bureaucracy to the striking working-", "x0": 0.10989010989010989, "y0": 0.4568764568764569, "x1": 0.8868131868131868, "y1": 0.4693084693084693}, {"text": "class characters. The film satirises and admires its subjects.", "x0": 0.10989010989010989, "y0": 0.47241647241647244, "x1": 0.5461538461538461, "y1": 0.48484848484848486}, {"text": "How does Sitch effectively capture the uniqueness of how Australians view and understand their world in", "x0": 0.10989010989010989, "y0": 0.5019425019425019, "x1": 0.8901098901098901, "y1": 0.5143745143745144}, {"text": "his film, The Castle.", "x0": 0.10989010989010989, "y0": 0.5174825174825175, "x1": 0.25824175824175827, "y1": 0.5275835275835276}, {"text": "OR", "x0": 0.4846153846153846, "y0": 0.5757575757575758, "x1": 0.5142857142857142, "y1": 0.585081585081585}, {"text": "Media", "x0": 0.12197802197802197, "y0": 0.6371406371406372, "x1": 0.17472527472527472, "y1": 0.6464646464646465}, {"text": "\u2014 Janet Merewether, Reindeer in my Saami Heart (20 marks)", "x0": 0.12087912087912088, "y0": 0.6666666666666666, "x1": 0.6208791208791209, "y1": 0.6798756798756799}, {"text": "This innovative documentary by Janet Merewether blends English and Northern Saami languages to", "x0": 0.10989010989010989, "y0": 0.7016317016317016, "x1": 0.8494505494505494, "y1": 0.714063714063714}, {"text": "present the world of a woman who is passionate about preserving her Northern Saami language and", "x0": 0.10989010989010989, "y0": 0.7094017094017094, "x1": 0.845054945054945, "y1": 0.7342657342657343}, {"text": "culture for future generations.", "x0": 0.10989010989010989, "y0": 0.7319347319347319, "x1": 0.32857142857142857, "y1": 0.7443667443667443}, {"text": "How does Merewether effectively capture this world of blending English and Northern Saami language", "x0": 0.10989010989010989, "y0": 0.7622377622377622, "x1": 0.8736263736263736, "y1": 0.7746697746697747}, {"text": "in her documentary Reindeer in my Saami Heart?", "x0": 0.10989010989010989, "y0": 0.777000777000777, "x1": 0.4758241758241758, "y1": 0.7894327894327894}, {"text": "END MODULE A", "x0": 0.42417582417582417, "y0": 0.864024864024864, "x1": 0.5802197802197803, "y1": 0.8733488733488733}], [{"text": "Section II \u2014 Module B: Close Study of Literature", "x0": 0.12197802197802197, "y0": 0.08857808857808858, "x1": 0.6780219780219781, "y1": 0.10567210567210568}, {"text": "Total marks 20", "x0": 0.12197802197802197, "y0": 0.10955710955710955, "x1": 0.26263736263736265, "y1": 0.12121212121212122}, {"text": "Attempt ONE question", "x0": 0.12087912087912088, "y0": 0.128982128982129, "x1": 0.3373626373626374, "y1": 0.1445221445221445}, {"text": "Allow about 40 minutes for this section.", "x0": 0.12087912087912088, "y0": 0.14840714840714841, "x1": 0.4978021978021978, "y1": 0.16006216006216006}, {"text": "Answer the question in a writing booklet.", "x0": 0.12087912087912088, "y0": 0.16705516705516704, "x1": 0.5087912087912088, "y1": 0.1825951825951826}, {"text": "In your answer you will be assessed on how well you:", "x0": 0.12197802197802197, "y0": 0.22377622377622378, "x1": 0.554945054945055, "y1": 0.236985236985237}, {"text": "\u00a9 demonstrate understanding of a text\u2019s distinctive qualities and how these shape meaning", "x0": 0.12197802197802197, "y0": 0.24864024864024864, "x1": 0.8604395604395605, "y1": 0.27505827505827507}, {"text": "\u00a9 organise, develop and express your ideas using language appropriate to audience, purpose", "x0": 0.12197802197802197, "y0": 0.27505827505827507, "x1": 0.8747252747252747, "y1": 0.28826728826728826}, {"text": "and form", "x0": 0.15164835164835164, "y0": 0.2913752913752914, "x1": 0.2230769230769231, "y1": 0.3014763014763015}, {"text": "Answer on your prescribed text within options A-F", "x0": 0.12087912087912088, "y0": 0.33877233877233875, "x1": 0.5582417582417583, "y1": 0.35120435120435123}, {"text": "A\u2014 Prose Fiction (20 marks)", "x0": 0.12087912087912088, "y0": 0.3706293706293706, "x1": 0.3659340659340659, "y1": 0.38306138306138304}, {"text": "(a) MT Anderson, Feed", "x0": 0.12197802197802197, "y0": 0.38694638694638694, "x1": 0.321978021978022, "y1": 0.40015540015540013}, {"text": "How has Anderson crafted a distinctive narrative voice to convey the importance of", "x0": 0.12197802197802197, "y0": 0.4195804195804196, "x1": 0.7967032967032966, "y1": 0.43278943278943277}, {"text": "language and communication in our lives?", "x0": 0.12197802197802197, "y0": 0.4382284382284382, "x1": 0.46153846153846156, "y1": 0.45143745143745145}, {"text": "OR", "x0": 0.4846153846153846, "y0": 0.4700854700854701, "x1": 0.5142857142857142, "y1": 0.4794094794094794}, {"text": "(b) Mark Haddon, The Curious Incident of the Dog in the Night-time", "x0": 0.12197802197802197, "y0": 0.5019425019425019, "x1": 0.6747252747252748, "y1": 0.5151515151515151}, {"text": "How has Haddon crafted a distinctive narrative voice to convey the importance of", "x0": 0.12197802197802197, "y0": 0.5345765345765345, "x1": 0.7824175824175824, "y1": 0.5477855477855478}, {"text": "order and stability in our lives?", "x0": 0.12197802197802197, "y0": 0.5532245532245532, "x1": 0.37142857142857144, "y1": 0.5664335664335665}, {"text": "OR", "x0": 0.4846153846153846, "y0": 0.6013986013986014, "x1": 0.5142857142857142, "y1": 0.6107226107226107}, {"text": "A\u2014 Poetry (20 marks)", "x0": 0.12087912087912088, "y0": 0.6332556332556333, "x1": 0.3098901098901099, "y1": 0.6464646464646465}, {"text": "(a) Robert Gray, Coast Road", "x0": 0.12197802197802197, "y0": 0.6658896658896659, "x1": 0.35274725274725277, "y1": 0.679098679098679}, {"text": "How has Gray crafted distinctive figurative images to convey the important tensions", "x0": 0.12197802197802197, "y0": 0.6985236985236986, "x1": 0.8, "y1": 0.7117327117327117}, {"text": "between urbanisation and the natural world?", "x0": 0.12087912087912088, "y0": 0.717948717948718, "x1": 0.47802197802197804, "y1": 0.728049728049728}, {"text": "Make close reference to Journey, the North Coast, and at least ONE other poem set for study", "x0": 0.12197802197802197, "y0": 0.7365967365967366, "x1": 0.8703296703296703, "y1": 0.7498057498057498}, {"text": "The prescribed poems are:", "x0": 0.12197802197802197, "y0": 0.7668997668997669, "x1": 0.33186813186813185, "y1": 0.7801087801087802}, {"text": "the North Coast", "x0": 0.20659340659340658, "y0": 0.7863247863247863, "x1": 0.33406593406593404, "y1": 0.7964257964257965}, {"text": "*Flames and Dangling Wire", "x0": 0.12197802197802197, "y0": 0.804972804972805, "x1": 0.3505494505494505, "y1": 0.8181818181818182}, {"text": "*Harbour Dusk", "x0": 0.12197802197802197, "y0": 0.8236208236208237, "x1": 0.24835164835164836, "y1": 0.8337218337218337}, {"text": "*Byron Bay: Winter", "x0": 0.12197802197802197, "y0": 0.8422688422688422, "x1": 0.2835164835164835, "y1": 0.8554778554778555}, {"text": "*Description of a Walk", "x0": 0.12197802197802197, "y0": 0.8547008547008547, "x1": 0.3087912087912088, "y1": 0.878010878010878}, {"text": "*24 Poems", "x0": 0.12197802197802197, "y0": 0.8803418803418803, "x1": 0.2087912087912088, "y1": 0.8904428904428905}, {"text": "OR", "x0": 0.4846153846153846, "y0": 0.9121989121989122, "x1": 0.5142857142857142, "y1": 0.9215229215229215}], [{"text": "(b) Oodgeroo Noonuccal, Selected Poems", "x0": 0.12197802197802197, "y0": 0.08702408702408702, "x1": 0.45714285714285713, "y1": 0.10023310023310024}, {"text": "How has Noonuccal crafted distinctive language features and forms to convey the", "x0": 0.12197802197802197, "y0": 0.11965811965811966, "x1": 0.7802197802197802, "y1": 0.13286713286713286}, {"text": "importance of Indigenous experience, culture, and spirituality?", "x0": 0.12197802197802197, "y0": 0.13908313908313907, "x1": 0.6263736263736264, "y1": 0.1522921522921523}, {"text": "Make close reference to The Past, and at least ONE other poem set for study", "x0": 0.12197802197802197, "y0": 0.17715617715617715, "x1": 0.7373626373626374, "y1": 0.19036519036519037}, {"text": "The prescribed poems are:", "x0": 0.12197802197802197, "y0": 0.22688422688422688, "x1": 0.33186813186813185, "y1": 0.2400932400932401}, {"text": "*The Past", "x0": 0.12197802197802197, "y0": 0.2463092463092463, "x1": 0.2021978021978022, "y1": 0.2564102564102564}, {"text": "*China... Woman", "x0": 0.12197802197802197, "y0": 0.26495726495726496, "x1": 0.26263736263736265, "y1": 0.27505827505827507}, {"text": "*Reed Flute Cave", "x0": 0.12197802197802197, "y0": 0.2836052836052836, "x1": 0.26373626373626374, "y1": 0.2937062937062937}, {"text": "*Entombed Warriors", "x0": 0.12197802197802197, "y0": 0.30225330225330227, "x1": 0.29120879120879123, "y1": 0.3123543123543124}, {"text": "*Visit to Sun Yat-Sen Memorial Hall", "x0": 0.12197802197802197, "y0": 0.32167832167832167, "x1": 0.4175824175824176, "y1": 0.3317793317793318}, {"text": "on Huampu River", "x0": 0.1967032967032967, "y0": 0.3411033411033411, "x1": 0.3395604395604396, "y1": 0.35353535353535354}, {"text": "OR", "x0": 0.4846153846153846, "y0": 0.37218337218337216, "x1": 0.5142857142857142, "y1": 0.3815073815073815}, {"text": "C\u2014 Drama (20 marks)", "x0": 0.12197802197802197, "y0": 0.4017094017094017, "x1": 0.3131868131868132, "y1": 0.4149184149184149}, {"text": "(a) Scott Rankin, Namatjira from Namatjira & Ngapartji \u2014 Two plays by Scott Rankin", "x0": 0.12197802197802197, "y0": 0.43434343434343436, "x1": 0.823076923076923, "y1": 0.44755244755244755}, {"text": "How has Rankin crafted distinctive dramatic techniques and language to convey the", "x0": 0.12197802197802197, "y0": 0.466977466977467, "x1": 0.7967032967032966, "y1": 0.4801864801864802}, {"text": "importance of Indigenous story and identity?", "x0": 0.12197802197802197, "y0": 0.4864024864024864, "x1": 0.4824175824175824, "y1": 0.4996114996114996}, {"text": "OR", "x0": 0.4846153846153846, "y0": 0.5369075369075369, "x1": 0.5142857142857142, "y1": 0.5462315462315462}, {"text": "(b) William Shakespeare, A Midsummer Night\u2019s Dream", "x0": 0.12197802197802197, "y0": 0.5975135975135976, "x1": 0.5692307692307692, "y1": 0.6107226107226107}, {"text": "How has Shakespeare crafted distinctive dramatic techniques and language to convey", "x0": 0.12197802197802197, "y0": 0.6301476301476302, "x1": 0.8087912087912088, "y1": 0.6433566433566433}, {"text": "the importance of order and relationships?", "x0": 0.12197802197802197, "y0": 0.6495726495726496, "x1": 0.4604395604395604, "y1": 0.6627816627816627}, {"text": "OR", "x0": 0.4846153846153846, "y0": 0.7000777000777001, "x1": 0.5142857142857142, "y1": 0.7094017094017094}, {"text": "D\u2014 Nonfiction\u2014 Anna Funder, Stasiland (20 marks)", "x0": 0.12197802197802197, "y0": 0.745920745920746, "x1": 0.5714285714285714, "y1": 0.7583527583527584}, {"text": "How has Funder crafted a distinctive writing style to convey the importance of", "x0": 0.12197802197802197, "y0": 0.7785547785547785, "x1": 0.7571428571428571, "y1": 0.7917637917637917}, {"text": "courage and heroism in a world of surveillance?", "x0": 0.12197802197802197, "y0": 0.797979797979798, "x1": 0.5076923076923077, "y1": 0.8111888111888111}, {"text": "OR", "x0": 0.4846153846153846, "y0": 0.8298368298368298, "x1": 0.5142857142857142, "y1": 0.8391608391608392}], [{"text": "E\u2014 Film\u2014 Peter Weir, The Truman Show (20 marks)", "x0": 0.12197802197802197, "y0": 0.08236208236208237, "x1": 0.578021978021978, "y1": 0.0947940947940948}, {"text": "How has Weir crafted distinctive conventions of film to convey the importance of the", "x0": 0.12197802197802197, "y0": 0.1258741258741259, "x1": 0.8098901098901099, "y1": 0.14607614607614608}, {"text": "quest for truth in a world of commercialism?", "x0": 0.12197802197802197, "y0": 0.14840714840714841, "x1": 0.48131868131868133, "y1": 0.16161616161616163}, {"text": "OR", "x0": 0.4846153846153846, "y0": 0.22377622377622378, "x1": 0.5142857142857142, "y1": 0.2331002331002331}, {"text": "F\u2014 Media\u2014 Simon Nasht, Frank Hurley: The Man Who Made History (20 marks)", "x0": 0.10989010989010989, "y0": 0.26107226107226106, "x1": 0.8065934065934066, "y1": 0.2742812742812743}, {"text": "How has Nasht crafted distinctive conventions of a documentary to convey the", "x0": 0.12197802197802197, "y0": 0.2851592851592852, "x1": 0.7549450549450549, "y1": 0.31157731157731156}, {"text": "importance of truth and ethical dilemmas in a world of conflicting perspectives?", "x0": 0.12197802197802197, "y0": 0.3038073038073038, "x1": 0.765934065934066, "y1": 0.33022533022533024}, {"text": "END MODULE B", "x0": 0.41208791208791207, "y0": 0.8461538461538461, "x1": 0.567032967032967, "y1": 0.8554778554778555}], [{"text": "Section III\u2014 Module C: The Craft of Writing", "x0": 0.12197802197802197, "y0": 0.08391608391608392, "x1": 0.6461538461538462, "y1": 0.10101010101010101}, {"text": "20 Marks", "x0": 0.12197802197802197, "y0": 0.1282051282051282, "x1": 0.22967032967032966, "y1": 0.1414141414141414}, {"text": "Attempt Question 3", "x0": 0.12087912087912088, "y0": 0.14996114996114995, "x1": 0.34505494505494505, "y1": 0.16705516705516704}, {"text": "Allow about 40 minutes for this section", "x0": 0.12087912087912088, "y0": 0.1717171717171717, "x1": 0.5659340659340659, "y1": 0.18492618492618493}, {"text": "In your answer you will be assessed on how well you:", "x0": 0.12197802197802197, "y0": 0.20901320901320902, "x1": 0.554945054945055, "y1": 0.2191142191142191}, {"text": "craft language to address the demands of the question", "x0": 0.15164835164835164, "y0": 0.22921522921522922, "x1": 0.5824175824175825, "y1": 0.24242424242424243}, {"text": "use language appropriate to audience, purpose and form to shape meaning", "x0": 0.15164835164835164, "y0": 0.24708624708624707, "x1": 0.7472527472527473, "y1": 0.2602952602952603}, {"text": "Some days later, at the hospital, I prop myself up in a mid-blue tub chair in the", "x0": 0.17032967032967034, "y0": 0.31313131313131315, "x1": 0.8472527472527472, "y1": 0.337995337995338}, {"text": "social worker\u2019s room. Outside the sky is colourless, the landscape dun and dry, a", "x0": 0.17032967032967034, "y0": 0.3372183372183372, "x1": 0.8604395604395605, "y1": 0.34965034965034963}, {"text": "wasteland waiting for snow...", "x0": 0.17032967032967034, "y0": 0.35353535353535354, "x1": 0.4230769230769231, "y1": 0.36596736596736595}, {"text": "I blame the landscape, out there pining like a suitorless spinster for the snow, for", "x0": 0.17032967032967034, "y0": 0.3861693861693862, "x1": 0.8626373626373627, "y1": 0.3986013986013986}, {"text": "the blinding swathe of white that will mask its disgrace and wrap in it beauty until", "x0": 0.17032967032967034, "y0": 0.4024864024864025, "x1": 0.8747252747252747, "y1": 0.4149184149184149}, {"text": "the spring when, against all odds, bountiful things will pierce the earth, grow and", "x0": 0.17032967032967034, "y0": 0.4188034188034188, "x1": 0.8648351648351649, "y1": 0.43123543123543123}, {"text": "flower.", "x0": 0.17032967032967034, "y0": 0.43512043512043513, "x1": 0.22857142857142856, "y1": 0.4444444444444444}, {"text": "The Erratics, Vicki Laveau-Harvie, 2019", "x0": 0.5472527472527473, "y0": 0.46853146853146854, "x1": 0.8901098901098901, "y1": 0.4801864801864802}, {"text": "Compose a piece of imaginative, discursive or persuasive writing that draws on the stimulus", "x0": 0.17032967032967034, "y0": 0.519036519036519, "x1": 0.8505494505494505, "y1": 0.5314685314685315}, {"text": "material to describe the impact of the changing world on individuals.", "x0": 0.17032967032967034, "y0": 0.5275835275835276, "x1": 0.6780219780219781, "y1": 0.5524475524475524}, {"text": "(10 marks)", "x0": 0.5934065934065934, "y0": 0.5516705516705517, "x1": 0.6725274725274726, "y1": 0.5633255633255633}, {"text": "b", "x0": 0.13956043956043956, "y0": 0.6037296037296037, "x1": 0.14945054945054945, "y1": 0.6146076146076146}, {"text": "Explain how your study of the craft of writing has enabled you to create an engaging piece. In", "x0": 0.17032967032967034, "y0": 0.6052836052836053, "x1": 0.8637362637362638, "y1": 0.6177156177156177}, {"text": "your response, make detailed reference to your use of imagery in part (a)", "x0": 0.17032967032967034, "y0": 0.6216006216006216, "x1": 0.7065934065934066, "y1": 0.634032634032634}, {"text": "(10 marks)", "x0": 0.41208791208791207, "y0": 0.6379176379176379, "x1": 0.5054945054945055, "y1": 0.6519036519036518}], [{"text": "The prescribed texts for Section III are:", "x0": 0.12197802197802197, "y0": 0.13675213675213677, "x1": 0.46263736263736266, "y1": 0.15073815073815075}, {"text": "Ray Bradbury, The Pedestrian", "x0": 0.4846153846153846, "y0": 0.17249417249417248, "x1": 0.7483516483516484, "y1": 0.1864801864801865}, {"text": "e Prose Fiction \u2014", "x0": 0.15164835164835164, "y0": 0.17327117327117328, "x1": 0.44505494505494503, "y1": 0.18337218337218336}, {"text": "Peter Carey, Report on the Shadow Industry", "x0": 0.4846153846153846, "y0": 0.1888111888111888, "x1": 0.8681318681318682, "y1": 0.20279720279720279}, {"text": "Catherine Cole, Home", "x0": 0.489010989010989, "y0": 0.2066822066822067, "x1": 0.6824175824175824, "y1": 0.2198912198912199}, {"text": "Stephen King, Crouch End", "x0": 0.489010989010989, "y0": 0.22455322455322455, "x1": 0.7252747252747253, "y1": 0.23853923853923853}, {"text": "Melissa Lucashenko, Dreamers", "x0": 0.489010989010989, "y0": 0.24164724164724163, "x1": 0.7637362637362637, "y1": 0.25485625485625485}, {"text": "Helen Garner, Dear Mrs Dunkley", "x0": 0.4846153846153846, "y0": 0.29603729603729606, "x1": 0.7758241758241758, "y1": 0.30924630924630925}, {"text": "e\u00a2 Nonfiction \u2014", "x0": 0.15164835164835164, "y0": 0.29681429681429683, "x1": 0.44505494505494503, "y1": 0.30691530691530694}, {"text": "George Orwell, The Sporting Spirit", "x0": 0.4846153846153846, "y0": 0.3123543123543124, "x1": 0.7923076923076923, "y1": 0.32634032634032634}, {"text": "Sylvia Plath, A Comparison", "x0": 0.4901098901098901, "y0": 0.33022533022533024, "x1": 0.7307692307692307, "y1": 0.3442113442113442}, {"text": "Sarah Vowell, What He Said There", "x0": 0.489010989010989, "y0": 0.3480963480963481, "x1": 0.7956043956043956, "y1": 0.3613053613053613}, {"text": "Linda Burney, First speech to the", "x0": 0.4846153846153846, "y0": 0.3853923853923854, "x1": 0.7769230769230769, "y1": 0.39937839937839936}, {"text": "\u00a9 Speeches \u2014", "x0": 0.15164835164835164, "y0": 0.3861693861693862, "x1": 0.44505494505494503, "y1": 0.39937839937839936}, {"text": "House of Representatives as Member", "x0": 0.4835164835164835, "y0": 0.40326340326340326, "x1": 0.8087912087912088, "y1": 0.4172494172494173}, {"text": "for Barton", "x0": 0.4824175824175824, "y0": 0.4211344211344211, "x1": 0.5736263736263736, "y1": 0.43512043512043513}, {"text": "Steve Jobs, How to Live Before You Die", "x0": 0.4846153846153846, "y0": 0.43745143745143744, "x1": 0.832967032967033, "y1": 0.45143745143745145}, {"text": "Paul Keating, Funeral Service of the", "x0": 0.489010989010989, "y0": 0.45454545454545453, "x1": 0.8065934065934066, "y1": 0.46853146853146854}, {"text": "Unknown Australian Soldier", "x0": 0.4857142857142857, "y0": 0.47241647241647244, "x1": 0.734065934065934, "y1": 0.48329448329448327}, {"text": "JK Rowling, The Fringe Benefits of", "x0": 0.489010989010989, "y0": 0.4902874902874903, "x1": 0.8087912087912088, "y1": 0.5042735042735043}, {"text": "Failure and the Importance of", "x0": 0.4835164835164835, "y0": 0.5081585081585082, "x1": 0.7516483516483516, "y1": 0.5221445221445221}, {"text": "Imagination", "x0": 0.4835164835164835, "y0": 0.5268065268065268, "x1": 0.589010989010989, "y1": 0.54001554001554}, {"text": "Carol Chan, Popcorn", "x0": 0.4846153846153846, "y0": 0.5524475524475524, "x1": 0.6538461538461539, "y1": 0.5656565656565656}, {"text": "\u00a9 Poetry", "x0": 0.15274725274725276, "y0": 0.5532245532245532, "x1": 0.23736263736263735, "y1": 0.5656565656565656}, {"text": "Robert Frost, Stopping By Woods on a Snowy", "x0": 0.4846153846153846, "y0": 0.5703185703185704, "x1": 0.8505494505494505, "y1": 0.5835275835275835}, {"text": "Evening", "x0": 0.4835164835164835, "y0": 0.58741258741