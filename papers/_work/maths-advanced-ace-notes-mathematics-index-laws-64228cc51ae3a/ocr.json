[[{"text": "Chapter 1", "x0": 0.12197802197802197, "y0": 0.10256410256410256, "x1": 0.25164835164835164, "y1": 0.12121212121212122}, {"text": "When multiplying terms with the same base, add the powers.", "x0": 0.12087912087912088, "y0": 0.12742812742812742, "x1": 0.6230769230769231, "y1": 0.13986013986013987}, {"text": "When dividing terms with the same base, subtract the powers.", "x0": 0.12087912087912088, "y0": 0.1655011655011655, "x1": 0.6329670329670329, "y1": 0.17793317793317792}, {"text": "omen", "x0": 0.5483516483516484, "y0": 0.1926961926961927, "x1": 0.5725274725274725, "y1": 0.19658119658119658}, {"text": "a", "x0": 0.5, "y0": 0.20823620823620823, "x1": 0.5087912087912088, "y1": 0.21522921522921523}, {"text": "When raising a term with a power to another power, multiply the powers.", "x0": 0.12087912087912088, "y0": 0.222999222999223, "x1": 0.7252747252747253, "y1": 0.23543123543123542}, {"text": "When raising a product of terms to a power, raise each term to that power.", "x0": 0.12087912087912088, "y0": 0.2618492618492618, "x1": 0.7362637362637363, "y1": 0.2742812742812743}, {"text": "(ab)\"=a\"b\"", "x0": 0.45384615384615384, "y0": 0.2804972804972805, "x1": 0.5461538461538461, "y1": 0.29526029526029524}, {"text": "When raising a quotient of terms to a power, raise each term to that power.", "x0": 0.12087912087912088, "y0": 0.3006993006993007, "x1": 0.7417582417582418, "y1": 0.31313131313131315}, {"text": "Any number raised to the power of zero is equal to 1.", "x0": 0.12087912087912088, "y0": 0.3776223776223776, "x1": 0.5560439560439561, "y1": 0.3900543900543901}, {"text": "@=1", "x0": 0.47802197802197804, "y0": 0.3947163947163947, "x1": 0.5208791208791209, "y1": 0.40714840714840717}, {"text": "Anumber raised to a negative power gives a fraction (with a numerator of 1).", "x0": 0.12087912087912088, "y0": 0.4149184149184149, "x1": 0.7516483516483516, "y1": 0.42735042735042733}, {"text": "A number raised by negative 1/n will give its fractional form with the root being a", "x0": 0.12087912087912088, "y0": 0.5431235431235432, "x1": 0.7846153846153846, "y1": 0.5555555555555556}, {"text": "denominator.", "x0": 0.12197802197802197, "y0": 0.5617715617715617, "x1": 0.23186813186813188, "y1": 0.5718725718725719}, {"text": "Any number raised to the power of negative m/n is the nth root of that number raised", "x0": 0.12087912087912088, "y0": 0.6216006216006216, "x1": 0.8241758241758241, "y1": 0.634032634032634}, {"text": "to.", "x0": 0.8307692307692308, "y0": 0.6223776223776224, "x1": 0.8472527472527472, "y1": 0.6317016317016317}, {"text": "the power m.", "x0": 0.12197802197802197, "y0": 0.6402486402486403, "x1": 0.22967032967032966, "y1": 0.6526806526806527}]]