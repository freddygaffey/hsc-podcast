[[{"text": "2025 | TRIAL HIGHER SCHOOL CERTIFICATE EXAMINATION", "x0": 0.1276127612761276, "y0": 0.3333333333333333, "x1": 0.6380638063806381, "y1": 0.35742035742035744}, {"text": "English Extension 1", "x0": 0.12321232123212321, "y0": 0.37839937839937837, "x1": 0.581958195819582, "y1": 0.41414141414141414}, {"text": "General + Reading time \u2014 10 minutes", "x0": 0.11991199119911991, "y0": 0.4560994560994561, "x1": 0.5247524752475248, "y1": 0.4755244755244755}, {"text": "Instructions \u2014 + Working time \u2014 2 hours", "x0": 0.11991199119911991, "y0": 0.473970473970474, "x1": 0.49284928492849284, "y1": 0.4965034965034965}, {"text": "+ Write using black pen", "x0": 0.26732673267326734, "y0": 0.5011655011655012, "x1": 0.47854785478547857, "y1": 0.5143745143745144}, {"text": "Total marks: Section 1-25 marks", "x0": 0.1188118811881188, "y0": 0.5547785547785548, "x1": 0.4598459845984598, "y1": 0.5656565656565656}, {"text": "50 + Attempt Question 1", "x0": 0.11991199119911991, "y0": 0.5734265734265734, "x1": 0.45544554455445546, "y1": 0.5928515928515928}, {"text": "+ Allow about 1 hour for this section", "x0": 0.26732673267326734, "y0": 0.6006216006216006, "x1": 0.592959295929593, "y1": 0.6107226107226107}, {"text": "Section Il \u2014 25 marks", "x0": 0.26732673267326734, "y0": 0.634032634032634, "x1": 0.46534653465346537, "y1": 0.6441336441336442}, {"text": "+ Attempt ONE question from Questions 2 (a)\u20142 (e)", "x0": 0.26732673267326734, "y0": 0.655011655011655, "x1": 0.7260726072607261, "y1": 0.6752136752136753}, {"text": "+ Allow about 1 hour for this section", "x0": 0.26732673267326734, "y0": 0.679098679098679, "x1": 0.592959295929593, "y1": 0.6891996891996892}], [{"text": "Section I \u2014 Common Module: Literary Worlds", "x0": 0.11991199119911991, "y0": 0.08313908313908314, "x1": 0.5995599559955995, "y1": 0.0979020979020979}, {"text": "25 marks", "x0": 0.1188118811881188, "y0": 0.11810411810411811, "x1": 0.19911991199119913, "y1": 0.12742812742812742}, {"text": "Attempt Question 1", "x0": 0.1188118811881188, "y0": 0.13442113442113443, "x1": 0.2871287128712871, "y1": 0.14685314685314685}, {"text": "Allow about 1 hour for this section", "x0": 0.1188118811881188, "y0": 0.15073815073815075, "x1": 0.41914191419141916, "y1": 0.16006216006216006}, {"text": "Answer the question on pages of the English Extension 1 Writing Booklet. Extra writing", "x0": 0.1188118811881188, "y0": 0.18414918414918416, "x1": 0.8800880088008801, "y1": 0.19735819735819735}, {"text": "booklets are available.", "x0": 0.1188118811881188, "y0": 0.20046620046620048, "x1": 0.2992299229922992, "y1": 0.21056721056721056}, {"text": "Your answer will be assessed on how well you:", "x0": 0.14411441144114412, "y0": 0.22999222999222999, "x1": 0.528052805280528, "y1": 0.2432012432012432}, {"text": "\u00ab demonstrate an understanding of the ideas and values of Literary Worlds and how", "x0": 0.14301430143014301, "y0": 0.2501942501942502, "x1": 0.8547854785478548, "y1": 0.2634032634032634}, {"text": "they are shaped and reflected in texts", "x0": 0.16721672167216722, "y0": 0.26728826728826727, "x1": 0.4675467546754675, "y1": 0.2804972804972805}, {"text": "\u00ab craft a sustained composition appropriate to the question, demonstrating control of the", "x0": 0.14301430143014301, "y0": 0.2867132867132867, "x1": 0.8558855885588559, "y1": 0.2999222999222999}, {"text": "use of language", "x0": 0.16721672167216722, "y0": 0.3038073038073038, "x1": 0.29372937293729373, "y1": 0.317016317016317}, {"text": "Question 1 (25 marks)", "x0": 0.1188118811881188, "y0": 0.3480963480963481, "x1": 0.3047304730473047, "y1": 0.3605283605283605}, {"text": "Read Text | [overleaf] and respond to the following question.", "x0": 0.11991199119911991, "y0": 0.3815073815073815, "x1": 0.6160616061606161, "y1": 0.3947163947163947}, {"text": "How does Eco use setting, characters, and intertextuality to explore the relationship", "x0": 0.12101210121012101, "y0": 0.43045843045843046, "x1": 0.88998899889989, "y1": 0.44366744366744365}, {"text": "between the real and literary worlds?", "x0": 0.12101210121012101, "y0": 0.4467754467754468, "x1": 0.44114411441144114, "y1": 0.45998445998445997}, {"text": "Question 1 continues on page 3", "x0": 0.36633663366336633, "y0": 0.5128205128205128, "x1": 0.6336633663366337, "y1": 0.5252525252525253}], [{"text": "Question 1 (continued)", "x0": 0.1188118811881188, "y0": 0.08158508158508158, "x1": 0.3047304730473047, "y1": 0.09401709401709402}, {"text": "Text 1 \u2014 Non-", "x0": 0.1188118811881188, "y0": 0.12121212121212122, "x1": 0.24752475247524752, "y1": 0.13053613053613053}, {"text": "tion - Essay:", "x0": 0.2717271727172717, "y0": 0.12121212121212122, "x1": 0.3795379537953795, "y1": 0.13364413364413363}, {"text": "Essay titled \u201cHow It Begins, and How It Ends\u201d, taken from Umberto Eco (1994), How to Travel", "x0": 0.11991199119911991, "y0": 0.16938616938616938, "x1": 0.88998899889989, "y1": 0.1825951825951826}, {"text": "with a Salmon and Other Essays, Harcourt, Brace & Company, USA, Orlando", "x0": 0.1188118811881188, "y0": 0.1857031857031857, "x1": 0.7491749174917491, "y1": 0.1989121989121989}, {"text": "Text 1 is on following page.", "x0": 0.1188118811881188, "y0": 0.26107226107226106, "x1": 0.35313531353135313, "y1": 0.2742812742812743}], [{"text": "locked inexorably at midnight. After that hour, those |", "x0": 0.5493395493395493, "y0": 0.13391877058177826, "x1": 0.8298368298368298, "y1": 0.1525795828759605}, {"text": "who were outside remained out, because there were", "x0": 0.5493395493395493, "y0": 0.15587266739846323, "x1": 0.8236208236208237, "y1": 0.17233809001097694}, {"text": "no residential obligations, and if a student wished, he", "x0": 0.5493395493395493, "y0": 0.1778265642151482, "x1": 0.8236208236208237, "y1": 0.19538968166849616}, {"text": "could be absent even for a month, Practically speak- |", "x0": 0.5501165501165501, "y0": 0.19978046103183314, "x1": 0.8298368298368298, "y1": 0.21734357848518113}, {"text": "How It Begins,", "x0": 0.2789432789432789, "y0": 0.2030735455543359, "x1": 0.4063714063714064, "y1": 0.2305159165751921}, {"text": "ing, this meant that at ten minutes to midnight we |", "x0": 0.5501165501165501, "y0": 0.2217343578485181, "x1": 0.8298368298368298, "y1": 0.23929747530186607}, {"text": "and How It Ends", "x0": 0.2703962703962704, "y0": 0.23819978046103182, "x1": 0.41647241647241645, "y1": 0.2601536772777168}, {"text": "had to leave the theater and scurry to our destination.", "x0": 0.5501165501165501, "y0": 0.24259055982436883, "x1": 0.822066822066822, "y1": 0.2601536772777168}, {"text": "But at ten minutes to midnight the play had not yet", "x0": 0.5501165501165501, "y0": 0.26344676180021953, "x1": 0.8236208236208237, "y1": 0.28210757409440174}, {"text": "ended. And so it was that, over a four-year period, I", "x0": 0.5501165501165501, "y0": 0.2854006586169045, "x1": 0.8228438228438228, "y1": 0.3029637760702525}, {"text": "saw the theatrical masterpieces of every time and", "x0": 0.5501165501165501, "y0": 0.30735455543358947, "x1": 0.8228438228438228, "y1": 0.32491767288693746}, {"text": "place, except for their last ten minutes.", "x0": 0.5493395493395493, "y0": 0.32930845225027444, "x1": 0.752913752913753, "y1": 0.3468715697036224}, {"text": "Thus I have lived a lifetime without knowing if", "x0": 0.5641025641025641, "y0": 0.3413830954994512, "x1": 0.8236208236208237, "y1": 0.3754116355653128}, {"text": "Oedipus faced up to the horrible revelation, or what", "x0": 0.5501165501165501, "y0": 0.3732162458836443, "x1": 0.8236208236208237, "y1": 0.3907793633369923}, {"text": "became of the six characters in search of an author, |", "x0": 0.5501165501165501, "y0": 0.3907793633369923, "x1": 0.8298368298368298, "y1": 0.4281009879253567}, {"text": "\u2018There is a drama in my life. I pursued my advanced", "x0": 0.20435120435120435, "y0": 0.3918770581778266, "x1": 0.47863247863247865, "y1": 0.4105378704720088}, {"text": "whether Oswald Alving was cured thanks to penicil- |", "x0": 0.5493395493395493, "y0": 0.407244785949506, "x1": 0.8321678321678322, "y1": 0.4456641053787047}, {"text": "studies as a guest of the University College of Turin,", "x0": 0.20435120435120435, "y0": 0.4138309549945115, "x1": 0.47785547785547783, "y1": 0.43249176728869376}, {"text": "lin, if Hamlet finally discovered that to be was better |", "x0": 0.5501165501165501, "y0": 0.4281009879253567, "x1": 0.8313908313908314, "y1": 0.4643249176728869}, {"text": "where I had won a scholarship. Of those years I have", "x0": 0.20435120435120435, "y0": 0.43468715697036225, "x1": 0.47863247863247865, "y1": 0.45334796926454446}, {"text": "retained the happiest of memories and a lasting dislike", "x0": 0.20435120435120435, "y0": 0.4478594950603732, "x1": 0.47863247863247865, "y1": 0.4829857299670692}, {"text": "than not to be. I still don\u2019t know who the real Signora", "x0": 0.5501165501165501, "y0": 0.4610318331503842, "x1": 0.8228438228438228, "y1": 0.4796926454445664}, {"text": "of tuna fish. It so happened that the college refectory", "x0": 0.20435120435120435, "y0": 0.4796926454445664, "x1": 0.47785547785547783, "y1": 0.4983534577387486}, {"text": "Ponza was, if Ruggero Ruggeri/Socrates drank the", "x0": 0.5493395493395493, "y0": 0.4829857299670692, "x1": 0.8228438228438228, "y1": 0.5005488474204172}, {"text": "remained open exactly one hour and a half for each", "x0": 0.20435120435120435, "y0": 0.5016465422612514, "x1": 0.47785547785547783, "y1": 0.5192096597145993}, {"text": "hemlock, if Othello punched up Iago before setting", "x0": 0.5493395493395493, "y0": 0.5049396267837541, "x1": 0.8228438228438228, "y1": 0.5225027442371021}, {"text": "meal. Those who arrived within the first half hour", "x0": 0.20435120435120435, "y0": 0.5236004390779363, "x1": 0.47785547785547783, "y1": 0.5378704720087816}, {"text": "off on a second honeymoon, if the imaginary invalid\u2019s |", "x0": 0.5493395493395493, "y0": 0.5268935236004391, "x1": 0.8298368298368298, "y1": 0.544456641053787}, {"text": "health improved, if everyone threw rice after Romeo |", "x0": 0.5493395493395493, "y0": 0.5422612513721186, "x1": 0.8298368298368298, "y1": 0.5686059275521405}, {"text": "were served the specialty of the day; latecomers were", "x0": 0.20435120435120435, "y0": 0.5455543358946213, "x1": 0.47785547785547783, "y1": 0.5631174533479693}, {"text": "and Juliet, and who was Bunbury. I thought I was |", "x0": 0.5501165501165501, "y0": 0.5598243688254665, "x1": 0.8321678321678322, "y1": 0.5938529088913282}, {"text": "given tuna. Except for the summer holidays and Sun-", "x0": 0.20435120435120435, "y0": 0.5675082327113062, "x1": 0.47707847707847706, "y1": 0.5850713501646543}, {"text": "the only human being afflicted by this ignorance until, |", "x0": 0.5501165501165501, "y0": 0.5817782656421515, "x1": 0.8321678321678322, "y1": 0.6158068057080132}, {"text": "days, then, over those four years I ate 1,920 meals", "x0": 0.20357420357420358, "y0": 0.5894621295279913, "x1": 0.47785547785547783, "y1": 0.6070252469813392}, {"text": "featuring tuna fish. But that is not the drama I refer", "x0": 0.20357420357420358, "y0": 0.6114160263446762, "x1": 0.47785547785547783, "y1": 0.6289791437980241}, {"text": "casually reliving old memories with my friend Paolo", "x0": 0.5493395493395493, "y0": 0.6136114160263447, "x1": 0.8228438228438228, "y1": 0.6311745334796927}, {"text": "Fabbri, I discovered that for years he has suffered |", "x0": 0.5501165501165501, "y0": 0.6344676180021954, "x1": 0.8298368298368298, "y1": 0.6531284302963776}, {"text": "10.", "x0": 0.20357420357420358, "y0": 0.6377607025246982, "x1": 0.21678321678321677, "y1": 0.6465422612513722}, {"text": "from the same anguish in reverse. During his student |", "x0": 0.5493395493395493, "y0": 0.6542261251372119, "x1": 0.8298368298368298, "y1": 0.6750823271130626}, {"text": "My drama springs from the fact that, while we", "x0": 0.21833721833721834, "y0": 0.6553238199780461, "x1": 0.47707847707847706, "y1": 0.672886937431394}, {"text": "students had no money, we still hungered for movies,", "x0": 0.20357420357420358, "y0": 0.6761800219538968, "x1": 0.4763014763014763, "y1": 0.6948408342480791}, {"text": "years he worked in a theater, organized and run by", "x0": 0.5493395493395493, "y0": 0.6783754116355654, "x1": 0.8228438228438228, "y1": 0.6959385290889133}, {"text": "music, and plays. So we would arrive at the theater", "x0": 0.20357420357420358, "y0": 0.6981339187705817, "x1": 0.47785547785547783, "y1": 0.716794731064764}, {"text": "students; his job was to stand at the door and take", "x0": 0.5501165501165501, "y0": 0.6992316136114161, "x1": 0.8236208236208237, "y1": 0.716794731064764}, {"text": "ten minutes early and approach the gentleman\u2014what", "x0": 0.20357420357420358, "y0": 0.7200878155872668, "x1": 0.47707847707847706, "y1": 0.7376509330406147}, {"text": "tickets. As many ticket-holders arrived late, he was }", "x0": 0.5501165501165501, "y0": 0.721185510428101, "x1": 0.8306138306138307, "y1": 0.7442371020856202}, {"text": "was he called?\u2014the leader of the claque, shaking his", "x0": 0.20357420357420358, "y0": 0.7420417124039517, "x1": 0.47707847707847706, "y1": 0.7596048298572997}, {"text": "never able to slip into a seat before the beginning of |", "x0": 0.5501165501165501, "y0": 0.7420417124039517, "x1": 0.8306138306138307, "y1": 0.7618002195389681}, {"text": "hand and slipping a hundred lire into his palm. Then", "x0": 0.20357420357420358, "y0": 0.7628979143798024, "x1": 0.47707847707847706, "y1": 0.7815587266739846}, {"text": "the second act. He saw Lear, blind and raving, wan- |", "x0": 0.5501165501165501, "y0": 0.7639956092206367, "x1": 0.8306138306138307, "y1": 0.7815587266739846}, {"text": "he would admit us. We were a paying claque.", "x0": 0.20357420357420358, "y0": 0.7848518111964874, "x1": 0.4428904428904429, "y1": 0.8024149286498353}, {"text": "dering around with the corpse of Cordelia in his arms;", "x0": 0.5501165501165501, "y0": 0.7859495060373216, "x1": 0.8228438228438228, "y1": 0.8046103183315039}, {"text": "It also happened that the doors of the college were", "x0": 0.21833721833721834, "y0": 0.8057080131723381, "x1": 0.47707847707847706, "y1": 0.8254665203073546}, {"text": "but he had no idea what had brought the two of them", "x0": 0.5501165501165501, "y0": 0.8068057080131723, "x1": 0.8228438228438228, "y1": 0.8254665203073546}, {"text": "11", "x0": 0.4630924630924631, "y0": 0.8693743139407245, "x1": 0.4763014763014763, "y1": 0.8803512623490669}, {"text": "412", "x0": 0.5508935508935509, "y0": 0.8715697036223929, "x1": 0.5656565656565656, "y1": 0.8825466520307355}], [{"text": "How It Begins, and How It Ends", "x0": 0.18803418803418803, "y0": 0.09440175631174534, "x1": 0.3457653457653458, "y1": 0.1119648737650933}, {"text": "like a Freud case history. If they told you,", "x0": 0.54001554001554, "y0": 0.13062568605927552, "x1": 0.7692307692307693, "y1": 0.150384193194292}, {"text": "to that ghastly pass. He heard Blanche Dubois profess", "x0": 0.12975912975912976, "y0": 0.13721185510428102, "x1": 0.40404040404040403, "y1": 0.15916575192096596}, {"text": "you wouldn\u2019t believe it.\u201d", "x0": 0.4965034965034965, "y0": 0.1525795828759605, "x1": 0.6285936285936286, "y1": 0.1690450054884742}, {"text": "her faith in strangers, but he racked his brain trying", "x0": 0.12975912975912976, "y0": 0.15916575192096596, "x1": 0.40404040404040403, "y1": 0.1800219538968167}, {"text": "Will we be happier afterwards? Or will we have", "x0": 0.5104895104895105, "y0": 0.1734357848518112, "x1": 0.77000777000777, "y1": 0.19209659714599342}, {"text": "to figure out why such a sweet lady was being carted", "x0": 0.13053613053613053, "y0": 0.1800219538968167, "x1": 0.40404040404040403, "y1": 0.2030735455543359}, {"text": "lost the freshness of those who are privileged to ex-", "x0": 0.4965034965034965, "y0": 0.19538968166849616, "x1": 0.7692307692307693, "y1": 0.21844127332601537}, {"text": "panunuos |", "x0": 0.8943278943278943, "y0": 0.20087815587266739, "x1": 0.9044289044289044, "y1": 0.29527991218441274}, {"text": "off to the bin. He never understood why Hamlet was", "x0": 0.13053613053613053, "y0": 0.2030735455543359, "x1": 0.40404040404040403, "y1": 0.22063666300768386}, {"text": "perience art as real life, where we enter after the", "x0": 0.49572649572649574, "y0": 0.21734357848518113, "x1": 0.77000777000777, "y1": 0.23380900109769484}, {"text": "so down on his uncle, who seemed a perfectly nice", "x0": 0.13053613053613053, "y0": 0.22502744237102085, "x1": 0.4048174048174048, "y1": 0.24259055982436883}, {"text": "trumps have been played, and we leave without know-", "x0": 0.4965034965034965, "y0": 0.23819978046103182, "x1": 0.7692307692307693, "y1": 0.2579582875960483}, {"text": "man. He saw Othello perform his dread act, but had", "x0": 0.13053613053613053, "y0": 0.24478594950603733, "x1": 0.4048174048174048, "y1": 0.265642151481888}, {"text": "ing who's going to win or lose the game?", "x0": 0.49572649572649574, "y0": 0.2601536772777168, "x1": 0.7125097125097125, "y1": 0.27991218441273324}, {"text": "no notion why such a docile little wife was being", "x0": 0.13131313131313133, "y0": 0.2678375411635565, "x1": 0.40559440559440557, "y1": 0.287596048298573}, {"text": "placed beneath a pillow and not on top of one.", "x0": 0.13131313131313133, "y0": 0.2897914379802415, "x1": 0.3776223776223776, "y1": 0.31174533479692645}, {"text": "1988", "x0": 0.749028749028749, "y0": 0.29857299670691545, "x1": 0.7692307692307693, "y1": 0.30954994511525796}, {"text": "\u2018Well, to make a long story short, Paolo and I ex-", "x0": 0.1452991452991453, "y0": 0.3106476399560922, "x1": 0.4048174048174048, "y1": 0.33150384193194293}, {"text": "changed confidences. And we discovered that a splen-", "x0": 0.13131313131313133, "y0": 0.33260153677277715, "x1": 0.4048174048174048, "y1": 0.3545554335894621}, {"text": "did old age lies before us. Seated on the front steps", "x0": 0.13131313131313133, "y0": 0.3556531284302964, "x1": 0.40559440559440557, "y1": 0.3754116355653128}, {"text": "of a country house or on a bench ift the park, for", "x0": 0.1320901320901321, "y0": 0.3765093304061471, "x1": 0.40559440559440557, "y1": 0.3973655323819978}, {"text": "years we will tell each other stories: he, endings; I,", "x0": 0.13131313131313133, "y0": 0.3995609220636663, "x1": 0.4048174048174048, "y1": 0.42041712403951703}, {"text": "beginnings, amid cries of amazement at every discov-", "x0": 0.1320901320901321, "y0": 0.42041712403951703, "x1": 0.40559440559440557, "y1": 0.442371020856202}, {"text": "ery of prelude or catharsis.", "x0": 0.1320901320901321, "y0": 0.4445664105378705, "x1": 0.2727272727272727, "y1": 0.4643249176728869}, {"text": "\u201cYou don\u2019t mean it! What did he say?\u201d", "x0": 0.14685314685314685, "y0": 0.4654226125137212, "x1": 0.3550893550893551, "y1": 0.4829857299670692}, {"text": "\u201cHee said: \u2018Mother, I want the sun!\u201d \u201d", "x0": 0.14685314685314685, "y0": 0.4884742041712404, "x1": 0.3457653457653458, "y1": 0.5049396267837541}, {"text": "\u201cAb, then he was done for.\u201d", "x0": 0.14685314685314685, "y0": 0.5104281009879253, "x1": 0.29914529914529914, "y1": 0.5279912184412733}, {"text": "\u201cYes, but what was wrong with him?\u201d", "x0": 0.14685314685314685, "y0": 0.531284302963776, "x1": 0.35120435120435123, "y1": 0.5499451152579583}, {"text": "I whisper the answer in his ear.", "x0": 0.14763014763014762, "y0": 0.5543358946212953, "x1": 0.31157731157731156, "y1": 0.5740944017563118}, {"text": "\u201cMy God, what a family! Now I understand.", "x0": 0.14763014763014762, "y0": 0.5740944017563118, "x1": 0.37839937839937837, "y1": 0.5960482985729967}, {"text": "\u201cBut tell me about Oedipus!\u201d", "x0": 0.14763014763014762, "y0": 0.5982436882546652, "x1": 0.3045843045843046, "y1": 0.6158068057080132}, {"text": "\u201cThere isn\u2019t alot to tell. His Mom commits suicide", "x0": 0.14763014763014762, "y0": 0.6169045005488474, "x1": 0.40714840714840717, "y1": 0.6355653128430296}, {"text": "and he blinds", "x0": 0.13364413364413363, "y0": 0.6432491767288694, "x1": 0.20357420357420358, "y1": 0.6586169045005489}, {"text": "\u201cThe pdor kid. All the same . ... they tried to tell", "x0": 0.14840714840714841, "y0": 0.6608122941822173, "x1": 0.40792540792540793, "y1": 0.6838638858397366}, {"text": "him in every possible way.\u201d", "x0": 0.13442113442113443, "y0": 0.686059275521405, "x1": 0.2812742812742813, "y1": 0.7047200878155873}, {"text": "\u201cTrue, I just can\u2019t figure it. Why didn\u2019t he", "x0": 0.14840714840714841, "y0": 0.7047200878155873, "x1": 0.40792540792540793, "y1": 0.725576289791438}, {"text": "understand?\u201d", "x0": 0.13442113442113443, "y0": 0.7310647639956093, "x1": 0.20357420357420358, "y1": 0.7453347969264544}, {"text": "\u201cPut yourself in his place. The plague begins. He\u2019s", "x0": 0.14918414918414918, "y0": 0.7486278814489572, "x1": 0.4087024087024087, "y1": 0.7694840834248079}, {"text": "aking, happily married. . . .\u201d", "x0": 0.1351981351981352, "y0": 0.7716794731064764, "x1": 0.29215229215229216, "y1": 0.7925356750823271}, {"text": "\u201cSo when he married his Mom, he didn\u2019t\u2014\u201d", "x0": 0.14918414918414918, "y0": 0.7914379802414928, "x1": 0.3861693861693862, "y1": 0.8100987925356751}, {"text": "\u201cOF course not! That\u2019s the whole point.\u201d", "x0": 0.14996114996114995, "y0": 0.814489571899012, "x1": 0.3667443667443667, "y1": 0.8320526893523601}, {"text": "14", "x0": 0.49184149184149184, "y0": 0.8682766190998902, "x1": 0.5066045066045066, "y1": 0.8792535675082327}, {"text": "13", "x0": 0.3947163947163947, "y0": 0.8748627881448957, "x1": 0.4094794094794095, "y1": 0.8869374313940724}], [{"text": "Section Il \u2014 Electives", "x0": 0.11991199119911991, "y0": 0.08313908313908314, "x1": 0.341034103410341, "y1": 0.09401709401709402}, {"text": "25 marks", "x0": 0.1188118811881188, "y0": 0.11810411810411811, "x1": 0.19911991199119913, "y1": 0.12742812742812742}, {"text": "Attempt ONE question from Questions 2 (a)\u20142(e)", "x0": 0.1188118811881188, "y0": 0.13442113442113443, "x1": 0.5478547854785478, "y1": 0.14685314685314685}, {"text": "Allow about 1 hour for this section", "x0": 0.1188118811881188, "y0": 0.15151515151515152, "x1": 0.41914191419141916, "y1": 0.16083916083916083}, {"text": "Answer the question for your Elective studied in class. Write your response in the English", "x0": 0.1188118811881188, "y0": 0.18337218337218336, "x1": 0.847084708470847, "y1": 0.19658119658119658}, {"text": "Extension | Writing Booklet. Extra writingbooklets are available.", "x0": 0.11991199119911991, "y0": 0.20046620046620048, "x1": 0.6457645764576457, "y1": 0.21367521367521367}, {"text": "ed on how well you:", "x0": 0.3641364136413641, "y0": 0.22999222999222999, "x1": 0.528052805280528, "y1": 0.2432012432012432}, {"text": "Your answer will be as:", "x0": 0.14411441144114412, "y0": 0.22999222999222999, "x1": 0.33003300330033003, "y1": 0.2400932400932401}, {"text": "\u00ab demonstrate an understanding of the ideas and values of Literary Worlds and how", "x0": 0.14301430143014301, "y0": 0.2501942501942502, "x1": 0.8558855885588559, "y1": 0.2634032634032634}, {"text": "they are shaped and reflected in texts", "x0": 0.16721672167216722, "y0": 0.2665112665112665, "x1": 0.4675467546754675, "y1": 0.27972027972027974}, {"text": "\u00ab craft a sustained composition appropriate to the question, demonstrating control of the", "x0": 0.14301430143014301, "y0": 0.2867132867132867, "x1": 0.8558855885588559, "y1": 0.2999222999222999}, {"text": "use of language", "x0": 0.16721672167216722, "y0": 0.3038073038073038, "x1": 0.29372937293729373, "y1": 0.317016317016317}, {"text": "Please turn over", "x0": 0.43014301430143015, "y0": 0.3962703962703963, "x1": 0.5698569856985699, "y1": 0.40559440559440557}], [{"text": "Question 2 (a) \u2014 Elective 1: Literary Homelands (25 marks)", "x0": 0.1188118811881188, "y0": 0.08158508158508158, "x1": 0.636963696369637, "y1": 0.0947940947940948}, {"text": "Through the unique ways they explore questions of difference, composers allow us \u2018to practise", "x0": 0.1188118811881188, "y0": 0.10644910644910645, "x1": 0.878987898789879, "y1": 0.13131313131313133}, {"text": "our own humanity\u2019.", "x0": 0.1188118811881188, "y0": 0.1320901320901321, "x1": 0.27832783278327833, "y1": 0.1452991452991453}, {"text": "How does this statement reflect your experience of studying Literary Homelands?", "x0": 0.11991199119911991, "y0": 0.16472416472416473, "x1": 0.7832783278327833, "y1": 0.17793317793317792}, {"text": "In your response, refer to TWO of your prescribed texts and at least ONE related text of your", "x0": 0.11991199119911991, "y0": 0.19813519813519814, "x1": 0.8800880088008801, "y1": 0.21134421134421136}, {"text": "own choosing.", "x0": 0.1188118811881188, "y0": 0.21522921522921523, "x1": 0.23542354235423543, "y1": 0.22843822843822845}, {"text": "The prescribed texts are:", "x0": 0.1188118811881188, "y0": 0.24708624708624707, "x1": 0.3179317931793179, "y1": 0.2602952602952603}, {"text": "+ Prose Fiction \u2014 Aravind Adiga, The White Tiger", "x0": 0.11991199119911991, "y0": 0.2804972804972805, "x1": 0.5731573157315731, "y1": 0.2937062937062937}, {"text": "\u2014 EM Forster, A Passage to India", "x0": 0.28492849284928495, "y0": 0.3038073038073038, "x1": 0.5720572057205721, "y1": 0.317016317016317}, {"text": "\u2014 Colm T\u00e9ibin, Brooklyn", "x0": 0.28492849284928495, "y0": 0.3271173271173271, "x1": 0.49174917491749176, "y1": 0.34032634032634035}, {"text": "+ Poetry \u2014 Eileen Chong, Burning Rice", "x0": 0.11991199119911991, "y0": 0.3605283605283605, "x1": 0.5335533553355336, "y1": 0.37373737373737376}, {"text": "The prescribed poems are:", "x0": 0.3102310231023102, "y0": 0.3838383838383838, "x1": 0.5225522552255225, "y1": 0.39704739704739705}, {"text": "* Burning Rice", "x0": 0.31133113311331134, "y0": 0.40792540792540793, "x1": 0.44114411441144114, "y1": 0.4211344211344211}, {"text": "* Mid-autumn Mooncakes", "x0": 0.31133113311331134, "y0": 0.42424242424242425, "x1": 0.5302530253025303, "y1": 0.43434343434343436}, {"text": "* My Hakka Grandmother", "x0": 0.31133113311331134, "y0": 0.44133644133644134, "x1": 0.5324532453245324, "y1": 0.45454545454545453}, {"text": "* Shophouse, Victoria Street", "x0": 0.31133113311331134, "y0": 0.45765345765345766, "x1": 0.5500550055005501, "y1": 0.47086247086247085}, {"text": "* Chinese Ginseng", "x0": 0.31133113311331134, "y0": 0.473970473970474, "x1": 0.47084708470847086, "y1": 0.48717948717948717}, {"text": "* Winter Meeting", "x0": 0.31133113311331134, "y0": 0.49106449106449107, "x1": 0.4598459845984598, "y1": 0.5042735042735043}, {"text": "* Singapore", "x0": 0.31133113311331134, "y0": 0.5081585081585082, "x1": 0.4158415841584158, "y1": 0.5213675213675214}, {"text": "+ Drama Andrew Bovell, The Secret River [by Kate Grenville \u2014 An adaptation", "x0": 0.11991199119911991, "y0": 0.5415695415695416, "x1": 0.8668866886688669, "y1": 0.5547785547785548}, {"text": "\u2018for the stage by Andrew Bovell]", "x0": 0.30583058305830585, "y0": 0.5578865578865578, "x1": 0.5687568756875687, "y1": 0.5710955710955711}, {"text": "+ Film \u2014 Sarah Gavron, Brick Lane", "x0": 0.11991199119911991, "y0": 0.5912975912975913, "x1": 0.517051705170517, "y1": 0.6037296037296037}, {"text": "OR", "x0": 0.48514851485148514, "y0": 0.634032634032634, "x1": 0.5148514851485149, "y1": 0.6433566433566433}], [{"text": "Question 2 (b) \u2014 Elective 2: Worlds of Upheaval (25 marks)", "x0": 0.1188118811881188, "y0": 0.08158508158508158, "x1": 0.6358635863586358, "y1": 0.0947940947940948}, {"text": "Depictions of social and political upheaval serve to activate change in attitudes towards", "x0": 0.12101210121012101, "y0": 0.14763014763014762, "x1": 0.8668866886688669, "y1": 0.16083916083916083}, {"text": "the vulnerable.", "x0": 0.12101210121012101