[[{"text": "NSW", "x0": 0.2098901098901099, "y0": 0.08857808857808858, "x1": 0.25054945054945055, "y1": 0.09712509712509712}, {"text": "EDUCATION", "x0": 0.2098901098901099, "y0": 0.10101010101010101, "x1": 0.3241758241758242, "y1": 0.10878010878010878}, {"text": "STANDARDS.", "x0": 0.2098901098901099, "y0": 0.11266511266511267, "x1": 0.3241758241758242, "y1": 0.12121212121212122}, {"text": "AUTHORITY", "x0": 0.2098901098901099, "y0": 0.1250971250971251, "x1": 0.3230769230769231, "y1": 0.13286713286713286}, {"text": "HIGHER", "x0": 0.2824175824175824, "y0": 0.17249417249417248, "x1": 0.33516483516483514, "y1": 0.1794871794871795}, {"text": "SCHOOL", "x0": 0.2813186813186813, "y0": 0.1857031857031857, "x1": 0.3395604395604396, "y1": 0.1926961926961927}, {"text": "CERTIFICATE", "x0": 0.2813186813186813, "y0": 0.1989121989121989, "x1": 0.3747252747252747, "y1": 0.20590520590520592}, {"text": "EXAMINATION", "x0": 0.2824175824175824, "y0": 0.21212121212121213, "x1": 0.3813186813186813, "y1": 0.2191142191142191}, {"text": "IMPORTANT:", "x0": 0.12637362637362637, "y0": 0.24864024864024864, "x1": 0.22747252747252747, "y1": 0.2571872571872572}, {"text": "This resource was developed to support a previous version of the syllabus.", "x0": 0.12527472527472527, "y0": 0.26495726495726496, "x1": 0.6791208791208792, "y1": 0.27583527583527584}, {"text": "It may contain content that differs from the current syllabus.", "x0": 0.12637362637362637, "y0": 0.2804972804972805, "x1": 0.5637362637362637, "y1": 0.2913752913752914}, {"text": "English (Standard)", "x0": 0.12307692307692308, "y0": 0.3247863247863248, "x1": 0.554945054945055, "y1": 0.3605283605283605}, {"text": "and English (Advanced)", "x0": 0.12087912087912088, "y0": 0.36985236985236986, "x1": 0.6835164835164835, "y1": 0.40559440559440557}, {"text": "Paper 1 \u2014 Area of Study", "x0": 0.12197802197802197, "y0": 0.4397824397824398, "x1": 0.5417582417582417, "y1": 0.46464646464646464}, {"text": "General + Reading time - 10 minutes", "x0": 0.11978021978021978, "y0": 0.5462315462315462, "x1": 0.5241758241758242, "y1": 0.5656565656565656}, {"text": "Instructions Working time - 2 hours", "x0": 0.11978021978021978, "y0": 0.5672105672105672, "x1": 0.49230769230769234, "y1": 0.5843045843045843}, {"text": "+ Write using black pen", "x0": 0.2681318681318681, "y0": 0.5920745920745921, "x1": 0.47802197802197804, "y1": 0.6052836052836053}, {"text": "+ A Stimulus Booklet is provided with this paper", "x0": 0.2681318681318681, "y0": 0.6130536130536131, "x1": 0.7021978021978021, "y1": 0.6262626262626263}, {"text": "Total marks: Section | - 15 marks (page 2)", "x0": 0.11868131868131868, "y0": 0.6674436674436675, "x1": 0.5406593406593406, "y1": 0.6806526806526807}, {"text": "45 + Attempt Question 1", "x0": 0.11868131868131868, "y0": 0.6853146853146853, "x1": 0.45604395604395603, "y1": 0.7047397047397047}, {"text": "+ Allow about 40 minutes for this section", "x0": 0.2681318681318681, "y0": 0.7132867132867133, "x1": 0.6351648351648351, "y1": 0.7233877233877234}, {"text": "Section II - 15 marks (page 3)", "x0": 0.26703296703296703, "y0": 0.745920745920746, "x1": 0.5461538461538461, "y1": 0.7591297591297591}, {"text": "+ Attempt Question 2", "x0": 0.2681318681318681, "y0": 0.7707847707847708, "x1": 0.4582417582417582, "y1": 0.7839937839937839}, {"text": "+ Allow about 40 minutes for this section", "x0": 0.2681318681318681, "y0": 0.7917637917637917, "x1": 0.6351648351648351, "y1": 0.8018648018648019}, {"text": "Section Ill - 15 marks (page 4)", "x0": 0.26703296703296703, "y0": 0.8243978243978244, "x1": 0.5516483516483517, "y1": 0.8376068376068376}, {"text": "+ Attempt Question 3", "x0": 0.2681318681318681, "y0": 0.8492618492618492, "x1": 0.4582417582417582, "y1": 0.8624708624708625}, {"text": "+ Allow about 40 minutes for this section", "x0": 0.2681318681318681, "y0": 0.8702408702408703, "x1": 0.6351648351648351, "y1": 0.8803418803418803}, {"text": "1020", "x0": 0.08241758241758242, "y0": 0.9463869463869464, "x1": 0.11758241758241758, "y1": 0.9549339549339549}], [{"text": "Section I", "x0": 0.11978021978021978, "y0": 0.08236208236208237, "x1": 0.20659340659340658, "y1": 0.09401709401709402}, {"text": "15 marks", "x0": 0.11978021978021978, "y0": 0.11732711732711733, "x1": 0.1989010989010989, "y1": 0.12742812742812742}, {"text": "Attempt Question 1", "x0": 0.11868131868131868, "y0": 0.13364413364413363, "x1": 0.2868131868131868, "y1": 0.14685314685314685}, {"text": "Allow about 40 minutes for this section", "x0": 0.11868131868131868, "y0": 0.15073815073815075, "x1": 0.45604395604395603, "y1": 0.16083916083916083}, {"text": "Answer the question on pages 2~7 of the Paper | Writing Booklet. Extra writing booklets are", "x0": 0.11978021978021978, "y0": 0.18337218337218336, "x1": 0.8791208791208791, "y1": 0.19658119658119658}, {"text": "available.", "x0": 0.11978021978021978, "y0": 0.20124320124320125, "x1": 0.1956043956043956, "y1": 0.21056721056721056}, {"text": "Your answers will be assessed on how well you:", "x0": 0.14395604395604394, "y0": 0.23154623154623155, "x1": 0.5351648351648352, "y1": 0.24397824397824397}, {"text": "demonstrate understanding of the way perceptions of discovery are shaped in and", "x0": 0.16703296703296702, "y0": 0.2501942501942502, "x1": 0.856043956043956, "y1": 0.2634032634032634}, {"text": "through texts", "x0": 0.16703296703296702, "y0": 0.2680652680652681, "x1": 0.2714285714285714, "y1": 0.2804972804972805}, {"text": "\u00a9 describe, explain and analyse the relationship between language, text and context", "x0": 0.14285714285714285, "y0": 0.2874902874902875, "x1": 0.8252747252747252, "y1": 0.3006993006993007}, {"text": "Question 1 (15 marks)", "x0": 0.11978021978021978, "y0": 0.33255633255633255, "x1": 0.30439560439560437, "y1": 0.34498834498834496}, {"text": "Examine Texts 1, 2 and 3 on pages 3-7 of the Stimulus Booklet carefully and then answer the", "x0": 0.11978021978021978, "y0": 0.36596736596736595, "x1": 0.8791208791208791, "y1": 0.3791763791763792}, {"text": "questions below.", "x0": 0.11868131868131868, "y0": 0.38306138306138304, "x1": 0.25384615384615383, "y1": 0.3954933954933955}, {"text": "Text 1\u2014 Poem", "x0": 0.11868131868131868, "y0": 0.43278943278943277, "x1": 0.25164835164835164, "y1": 0.4428904428904429}, {"text": "(a) Explain how the poet conveys the delight of discovery. 2", "x0": 0.11978021978021978, "y0": 0.4592074592074592, "x1": 0.8791208791208791, "y1": 0.4840714840714841}, {"text": "Text 2 \u2014 Novel extract", "x0": 0.11868131868131868, "y0": 0.515928515928516, "x1": 0.31978021978021975, "y1": 0.526029526029526}, {"text": "(b) How does the text invite the reader on a journey of discovery? 3", "x0": 0.11978021978021978, "y0": 0.5493395493395493, "x1": 0.8791208791208791, "y1": 0.5625485625485626}, {"text": "Text 3 \u2014 Nonfiction extract", "x0": 0.11868131868131868, "y0": 0.5990675990675991, "x1": 0.36153846153846153, "y1": 0.6091686091686092}, {"text": "(c) Analyse how the use of language conveys the role played by speculation 4", "x0": 0.11978021978021978, "y0": 0.6324786324786325, "x1": 0.8802197802197802, "y1": 0.6456876456876457}, {"text": "in his discoveries.", "x0": 0.16703296703296702, "y0": 0.6495726495726496, "x1": 0.310989010989011, "y1": 0.6596736596736597}, {"text": "Text 1, Text 2 and Text 3 \u2014 Poem, Novel extract and Nonfiction extract", "x0": 0.11868131868131868, "y0": 0.6993006993006993, "x1": 0.7351648351648352, "y1": 0.710955710955711}, {"text": "your view, which TWO of these texts most successfully explore the idea that 6", "x0": 0.189010989010989, "y0": 0.7327117327117327, "x1": 0.8802197802197802, "y1": 0.745920745920746}, {"text": "unexpected discoveries can be intensely meaningful?", "x0": 0.16703296703296702, "y0": 0.749028749028749, "x1": 0.5967032967032967, "y1": 0.7622377622377622}, {"text": "Justify your view with close reference to the TWO texts you have chosen.", "x0": 0.16703296703296702, "y0": 0.7824397824397824, "x1": 0.7670329670329671, "y1": 0.7956487956487956}], [{"text": "Section IT", "x0": 0.11868131868131868, "y0": 0.08236208236208237, "x1": 0.2164835164835165, "y1": 0.0947940947940948}, {"text": "15 marks", "x0": 0.11978021978021978, "y0": 0.11732711732711733, "x1": 0.1989010989010989, "y1": 0.1282051282051282}, {"text": "Attempt Question 2", "x0": 0.11868131868131868, "y0": 0.13364413364413363, "x1": 0.2879120879120879, "y1": 0.14685314685314685}, {"text": "Allow about 40 minutes for this section", "x0": 0.11868131868131868, "y0": 0.15073815073815075, "x1": 0.45604395604395603, "y1": 0.16161616161616163}, {"text": "Answer the question on pages 8-15 of the Paper | Writing Booklet. Extra writing booklets are", "x0": 0.11868131868131868, "y0": 0.18337218337218336, "x1": 0.8802197802197802, "y1": 0.19658119658119658}, {"text": "available.", "x0": 0.11868131868131868, "y0": 0.20046620046620048, "x1": 0.1956043956043956, "y1": 0.21056721056721056}, {"text": "Your answer will be assessed on how well you:", "x0": 0.14285714285714285, "y0": 0.23076923076923078, "x1": 0.5274725274725275, "y1": 0.24397824397824397}, {"text": "express understanding of discovery in the context of your studies", "x0": 0.16593406593406593, "y0": 0.2501942501942502, "x1": 0.6945054945054945, "y1": 0.2634032634032634}, {"text": "\u00a9 organise, develop and express ideas using language appropriate to audience, purpose", "x0": 0.14285714285714285, "y0": 0.2703962703962704, "x1": 0.856043956043956, "y1": 0.2836052836052836}, {"text": "and context", "x0": 0.16703296703296702, "y0": 0.2874902874902875, "x1": 0.26043956043956046, "y1": 0.2975912975912976}, {"text": "Question 2 (15 marks)", "x0": 0.11868131868131868, "y0": 0.33255633255633255, "x1": 0.3054945054945055, "y1": 0.3457653457653458}, {"text": "Use ONE of the following statements as the central idea for a piece of imaginative", "x0": 0.11868131868131868, "y0": 0.36596736596736595, "x1": 0.8087912087912088, "y1": 0.3791763791763792}, {"text": "writing exploring the complex nature of discovery.", "x0": 0.11978021978021978, "y0": 0.3822843822843823, "x1": 0.5307692307692308, "y1": 0.3954933954933955}, {"text": "OR", "x0": 0.4846153846153846, "y0": 0.5081585081585082, "x1": 0.5142857142857142, "y1": 0.519036519036519}, {"text": "OR", "x0": 0.4846153846153846, "y0": 0.6083916083916084, "x1": 0.5142857142857142, "y1": 0.6192696192696193}, {"text": "visitors to this spot will be conscious that something has", "x0": 0.25274725274725274, "y0": 0.6503496503496503, "x1": 0.7604395604395604, "y1": 0.6635586635586636}, {"text": "happened here. And even if that knowledge fades, this spot will still exude", "x0": 0.16593406593406593, "y0": 0.6666666666666666, "x1": 0.7615384615384615, "y1": 0.6798756798756799}, {"text": "a faint charge of uncomprehended \u2014 possibly unnoticed meaning.\u201d", "x0": 0.16703296703296702, "y0": 0.6837606837606838, "x1": 0.7175824175824176, "y1": 0.696969696969697}, {"text": "Please turn over", "x0": 0.42967032967032964, "y0": 0.7505827505827506, "x1": 0.5703296703296703, "y1": 0.7614607614607615}], [{"text": "Section IT", "x0": 0.11978021978021978, "y0": 0.08236208236208237, "x1": 0.22527472527472528, "y1": 0.09401709401709402}, {"text": "15 marks", "x0": 0.11978021978021978, "y0": 0.11732711732711733, "x1": 0.1989010989010989, "y1": 0.12742812742812742}, {"text": "Attempt Question 3", "x0": 0.11868131868131868, "y0": 0.13364413364413363, "x1": 0.2879120879120879, "y1": 0.14685314685314685}, {"text": "Allow about 40 minutes for this section", "x0": 0.11868131868131868, "y0": 0.15073815073815075, "x1": 0.45604395604395603, "y1": 0.16083916083916083}, {"text": "Answer the question on pages 16-24 of the Paper 1 Writing Booklet. Extra writing booklets", "x0": 0.11978021978021978, "y0": 0.18337218337218336, "x1": 0.8791208791208791, "y1": 0.19658119658119658}, {"text": "are available.", "x0": 0.11978021978021978, "y0": 0.20046620046620048, "x1": 0.22527472527472528, "y1": 0.21056721056721056}, {"text": "Your answer will be assessed on how well you:", "x0": 0.14395604395604394, "y0": 0.23154623154623155, "x1": 0.5274725274725275, "y1": 0.24397824397824397}, {"text": "demonstrate understanding of the concept of discovery in the context of your study", "x0": 0.16703296703296702, "y0": 0.2501942501942502, "x1": 0.8406593406593407, "y1": 0.2634032634032634}, {"text": "ss the ways discovery is represented in a variety of texts", "x0": 0.37142857142857144, "y0": 0.2703962703962704, "x1": 0.8263736263736263, "y1": 0.2836052836052836}, {"text": "explain and as", "x0": 0.23736263736263735, "y0": 0.27117327117327117, "x1": 0.35274725274725277, "y1": 0.2836052836052836}, {"text": "\u00a9 organise, develop and express ideas using language appropriate to audience, purpose", "x0": 0.14285714285714285, "y0": 0.2905982905982906, "x1": 0.856043956043956, "y1": 0.3038073038073038}, {"text": "and context", "x0": 0.16703296703296702, "y0": 0.3076923076923077, "x1": 0.25934065934065936, "y1": 0.317016317016317}, {"text": "Question 3 (15 marks)", "x0": 0.11978021978021978, "y0": 0.35275835275835277, "x1": 0.30439560439560437, "y1": 0.3651903651903652}, {"text": "\u201cWhether motivated by need, wonder or curiosity, discovery has the power to be transformative.\u2019", "x0": 0.12087912087912088, "y0": 0.3861693861693862, "x1": 0.878021978021978, "y1": 0.39937839937839936}, {"text": "How accurately does this statement reflect the view of discovery explored in your prescribed", "x0": 0.11978021978021978, "y0": 0.4195804195804196, "x1": 0.8791208791208791, "y1": 0.43278943278943277}, {"text": "text and ONE other related text of your own choosing?", "x0": 0.11978021978021978, "y0": 0.4358974358974359, "x1": 0.5648351648351648, "y1": 0.4491064491064491}, {"text": "The prescribed texts are listed on page 8 of the Stimulus Booklet.", "x0": 0.11868131868131868, "y0": 0.4693084693084693, "x1": 0.6505494505494506, "y1": 0.4825174825174825}, {"text": "End of paper", "x0": 0.44285714285714284, "y0": 0.5361305361305362, "x1": 0.5560439560439561, "y1": 0.5493395493395493}, {"text": "(\u00a9 2017 NSW Edueation Standards Authority", "x0": 0.3824175824175824, "y0": 0.9673659673659674, "x1": 0.6164835164835165, "y1": 0.9751359751359752}], [{"text": "NSW", "x0": 0.2098901098901099, "y0": 0.08857808857808858, "x1": 0.25054945054945055, "y1": 0.09712509712509712}, {"text": "EDUCATION", "x0": 0.2098901098901099, "y0": 0.10101010101010101, "x1": 0.3241758241758242, "y1": 0.10878010878010878}, {"text": "STANDARDS.", "x0": 0.2098901098901099, "y0": 0.11266511266511267, "x1": 0.3241758241758242, "y1": 0.12121212121212122}, {"text": "AUTHORITY", "x0": 0.2098901098901099, "y0": 0.1250971250971251, "x1": 0.3230769230769231, "y1": 0.13286713286713286}, {"text": "English (Standard)", "x0": 0.12307692307692308, "y0": 0.3014763014763015, "x1": 0.554945054945055, "y1": 0.3372183372183372}, {"text": "and English (Advanced)", "x0": 0.12087912087912088, "y0": 0.34654234654234656, "x1": 0.6835164835164835, "y1": 0.3822843822843823}, {"text": "Paper 1 \u2014 Area of Study", "x0": 0.12197802197802197, "y0": 0.41647241647241645, "x1": 0.5417582417582417, "y1": 0.44133644133644134}, {"text": "Stimulus Booklet for Section |", "x0": 0.11978021978021978, "y0": 0.47785547785547783, "x1": 0.5945054945054945, "y1": 0.49805749805749805}, {"text": "and", "x0": 0.11868131868131868, "y0": 0.5097125097125097, "x1": 0.18021978021978022, "y1": 0.5299145299145299}, {"text": "List of prescribed texts for Section Ill", "x0": 0.12087912087912088, "y0": 0.5407925407925408, "x1": 0.7076923076923077, "y1": 0.5656565656565656}, {"text": "Section I Text 1 \u2014 3", "x0": 0.11868131868131868, "y0": 0.6503496503496503, "x1": 0.8791208791208791, "y1": 0.6604506604506605}, {"text": "+ Text 2 - Novel extract", "x0": 0.2681318681318681, "y0": 0.6853146853146853, "x1": 0.48131868131868133, "y1": 0.6954156954156954}, {"text": "+ Text 3 - Nonfiction extract ...", "x0": 0.2681318681318681, "y0": 0.7195027195027195, "x1": 0.5395604395604395, "y1": 0.7296037296037297}, {"text": "Section Ill + List of prescribed texts 8", "x0": 0.11868131868131868, "y0": 0.7544677544677545, "x1": 0.8791208791208791, "y1": 0.7676767676767676}, {"text": "1021", "x0": 0.08241758241758242, "y0": 0.9463869463869464, "x1": 0.11428571428571428, "y1": 0.9549339549339549}], [{"text": "BLANK PAGE", "x0": 0.43626373626373627, "y0": 0.3550893550893551, "x1": 0.5626373626373626, "y1": 0.3644133644133644}], [{"text": "Section I", "x0": 0.11868131868131868, "y0": 0.08236208236208237, "x1": 0.2076923076923077, "y1": 0.0947940947940948}, {"text": "Text 1 \u2014 Poem", "x0": 0.11868131868131868, "y0": 0.13364413364413363, "x1": 0.25274725274725274, "y1": 0.1445221445221445}, {"text": "ELLEN VAN NEERVEN", "x0": 0.5, "y0": 0.6891996891996892, "x1": 0.6681318681318681, "y1": 0.6993006993006993}, {"text": "Comfort Food", "x0": 0.5538461538461539, "y0": 0.7055167055167055, "x1": 0.6692307692307692, "y1": 0.7187257187257188}], [{"text": "Text 2 \u2014 Novel extract", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.31978021978021975, "y1": 0.09168609168609168}, {"text": "The Verb To Be", "x0": 0.4307692307692308, "y0": 0.11888111888111888, "x1": 0.5692307692307692, "y1": 0.128982128982129}, {"text": "\u2018The Verb To Be\u2019 was the name of an old bookshop. A murky place,", "x0": 0.2164835164835165, "y0": 0.1522921522921523, "x1": 0.7835164835164835, "y1": 0.1655011655011655}, {"text": "due not to a lack of lighting but to all the nooks and crannies. A.", "x0": 0.21428571428571427, "y0": 0.17016317016317017, "x1": 0.7846153846153846, "y1": 0.1825951825951826}, {"text": "deep space with dark, worn floorboards and secluded niches. Books", "x0": 0.21428571428571427, "y0": 0.1857031857031857, "x1": 0.7835164835164835, "y1": 0.1989121989121989}, {"text": "everywhere, spread on tables and upright in rows, thousands of silent", "x0": 0.21428571428571427, "y0": 0.20202020202020202, "x1": 0.7846153846153846, "y1": 0.21522921522921523}, {"text": "observers on wooden shelves.", "x0": 0.21428571428571427, "y0": 0.2198912198912199, "x1": 0.45494505494505494, "y1": 0.22921522921522922}, {"text": "An ongoing battle between dust and the printed word at \u2018The Verb", "x0": 0.21428571428571427, "y0": 0.25252525252525254, "x1": 0.7846153846153846, "y1": 0.26573426573426573}, {"text": "To Be\u2019, cardboard boxes overflowing with books, piles of volumes", "x0": 0.21428571428571427, "y0": 0.26884226884226886, "x1": 0.7835164835164835, "y1": 0.28205128205128205}, {"text": "threatening to topple. Anarchy* reigning supreme. Grandiose anarchy.", "x0": 0.2153846153846154, "y0": 0.28593628593628595, "x1": 0.7835164835164835, "y1": 0.29914529914529914}, {"text": "A profusion of genres and titles. A joyous alchemy**. It was here that", "x0": 0.2098901098901099, "y0": 0.29526029526029524, "x1": 0.7846153846153846, "y1": 0.3185703185703186}, {"text": "people could drop by any day to procure their reading matter...", "x0": 0.21428571428571427, "y0": 0.31934731934731936, "x1": 0.7307692307692307, "y1": 0.33255633255633255}, {"text": "As the Chinese sage said: \u2018The exquisite delight of discovering a sea of", "x0": 0.21428571428571427, "y0": 0.35275835275835277, "x1": 0.7857142857142857, "y1": 0.36596736596736595}, {"text": "stories that one has not yet perused. Or acquiring the second volume", "x0": 0.21428571428571427, "y0": 0.3690753690753691, "x1": 0.7846153846153846, "y1": 0.3822843822843823}, {"text": "of a work after falling in love with the first.\u2019", "x0": 0.21428571428571427, "y0": 0.3861693861693862, "x1": 0.5725274725274725, "y1": 0.39937839937839936}, {"text": "... Leisure, light, literature: true happiness.", "x0": 0.2153846153846154, "y0": 0.4195804195804196, "x1": 0.5615384615384615, "y1": 0.43278943278943277}, {"text": "At the turn of the twenty-first century it was scornfully prophesied that", "x0": 0.21428571428571427, "y0": 0.452991452991453, "x1": 0.7846153846153846, "y1": 0.4662004662004662}, {"text": "places like this were on the way out. So much for the local bookshop!", "x0": 0.21428571428571427, "y0": 0.4693084693084693, "x1": 0.7835164835164835, "y1": 0.4825174825174825}, {"text": "Done for, that type of trade... It was paper they held in contempt, and", "x0": 0.21428571428571427, "y0": 0.4864024864024864, "x1": 0.7846153846153846, "y1": 0.4996114996114996}, {"text": "ink. The ink used for writing as well as for printing: messy, antiquated", "x0": 0.2153846153846154, "y0": 0.5027195027195027, "x1": 0.7846153846153846, "y1": 0.515928515928516}, {"text": "practices. But they also disdained the little repositories of thoughts,", "x0": 0.21428571428571427, "y0": 0.5198135198135199, "x1": 0.7835164835164835, "y1": 0.533022533022533}, {"text": "visions, words unfurling page after page while remaining singularly", "x0": 0.2153846153846154, "y0": 0.5361305361305362, "x1": 0.7835164835164835, "y1": 0.5493395493395493}, {"text": "compact, self-contained, just right for slipping into your pocket, taking", "x0": 0.21428571428571427, "y0": 0.5532245532245532, "x1": 0.7846153846153846, "y1": 0.5664335664335665}, {"text": "on a journey and opening never mind where, never mind when. To be", "x0": 0.21428571428571427, "y0": 0.5695415695415695, "x1": 0.7846153846153846, "y1": 0.5827505827505828}, {"text": "read. Devoured. Leafed through. No electricity, no screens... On a", "x0": 0.21428571428571427, "y0": 0.5866355866355867, "x1": 0.7846153846153846, "y1": 0.5998445998445998}, {"text": "train. In the cleft of a rock at the seaside. In bed. In a crowd. On the", "x0": 0.2153846153846154, "y0": 0.5998445998445998, "x1": 0.7846153846153846, "y1": 0.6208236208236209}, {"text": "lavatory. Lying in a bubble bath. In the beam of a head torch at the foot", "x0": 0.2153846153846154, "y0": 0.6192696192696193, "x1": 0.7846153846153846, "y1": 0.6324786324786325}, {"text": "of a sand dune, in the wind.", "x0": 0.21428571428571427, "y0": 0.6363636363636364, "x1": 0.43846153846153846, "y1": 0.6472416472416472}, {"text": "There is a warmth about all those books: bought in bookshops,", "x0": 0.21428571428571427, "y0": 0.6697746697746698, "x1": 0.7835164835164835, "y1": 0.682983682983683}, {"text": "treasured, given away as presents, abandoned to their own recondite***", "x0": 0.2153846153846154, "y0": 0.6868686868686869, "x1": 0.7835164835164835, "y1": 0.6993006993006993}, {"text": "fates. Torn, yellowed, forgotten, rediscovered...", "x0": 0.2153846153846154, "y0": 0.7031857031857032, "x1": 0.6054945054945055, "y1": 0.7163947163947164}, {"text": "How many people in the not too distant future will be left who", "x0": 0.2153846153846154, "y0": 0.7365967365967366, "x1": 0.7846153846153846, "y1": 0.7498057498057498}, {"text": "understand what bookshops and booksellers used to mean to people", "x0": 0.2153846153846154, "y0": 0.752913752913753, "x1": 0.7846153846153846, "y1": 0.7661227661227661}, {"text": "like me? The difference it made to a town or city if there were such", "x0": 0.2153846153846154, "y0": 0.77000777000777, "x1": 0.7846153846153846, "y1": 0.7832167832167832}, {"text": "places one could go into in the hope of some revelation? Who will", "x0": 0.21428571428571427, "y0": 0.7863247863247863, "x1": 0.7835164835164835, "y1": 0.7995337995337995}, {"text": "recall the tranquil manner in which one penetrated those warrens", "x0": 0.21428571428571427, "y0": 0.8034188034188035, "x1": 0.7835164835164835, "y1": 0.8166278166278166}, {"text": "redolent of paper and print? The way of tilting the head to decipher", "x0": 0.21428571428571427, "y0": 0.8197358197358198, "x1": 0.7846153846153846, "y1": 0.8329448329448329}, {"text": "one title after another, scan the names of authors familiar or unknown,", "x0": 0.21428571428571427, "y0": 0.8368298368298368, "x1": 0.7835164835164835, "y1": 0.8484848484848485}, {"text": "glean clues from the pale covers? \u2018The only true reader is the", "x0": 0.21428571428571427, "y0": 0.8531468531468531, "x1": 0.7846153846153846, "y1": 0.8663558663558664}, {"text": "thoughtful reader.\u2019 Who will recall the way of placing the index finger", "x0": 0.21428571428571427, "y0": 0.8702408702408703, "x1": 0.7846153846153846, "y1": 0.8834498834498834}, {"text": "Text 2 continues on page 5", "x0": 0.38461538461538464, "y0": 0.9052059052059052, "x1": 0.6131868131868132, "y1": 0.9184149184149184}], [{"text": "Text 2 (continued)", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.2692307692307692, "y1": 0.09401709401709402}, {"text": "at the top of the spine to tip the volume backwards, then drawing it", "x0": 0.21428571428571427, "y0": 0.11888111888111888, "x1": 0.7846153846153846, "y1": 0.1320901320901321}, {"text": "out, opening it, leafing through it, reading the blurb. Standing amid the", "x0": 0.21428571428571427, "y0": 0.1351981351981352, "x1": 0.7846153846153846, "y1": 0.14840714840714841}, {"text": "riffle of pages, encountering a few words that appear to be addressed", "x0": 0.21428571428571427, "y0": 0.1522921522921523, "x1": 0.7846153846153846, "y1": 0.1655011655011655}, {"text": "directly to oneself. The unhoped-for reassurance in black and white. An", "x0": 0.21428571428571427, "y0": 0.1686091686091686, "x1": 0.7846153846153846, "y1": 0.18181818181818182}, {"text": "all-embracing, intimate acquaintance. Soundless music.", "x0": 0.21428571428571427, "y0": 0.1857031857031857, "x1": 0.6626373626373626, "y1": 0.1989121989121989}, {"text": "In the depths of the shop the proprietor keeps himself aloof, which is as", "x0": 0.2153846153846154, "y0": 0.2191142191142191, "x1": 0.7846153846153846, "y1": 0.23232323232323232}, {"text": "it should be, since it is he who has made the encounter possible, who", "x0": 0.2153846153846154, "y0": 0.23543123543123542, "x1": 0.7846153846153846, "y1": 0.24864024864024864}, {"text": "has set out the books in a certain way, who has presented them, brought", "x0": 0.21428571428571427, "y0": 0.2533022533022533, "x1": 0.7846153846153846, "y1": 0.26573426573426573}, {"text": "them together. He is lord and master of the store, the leader of readers,", "x0": 0.2153846153846154, "y0": 0.26884226884226886, "x1": 0.7835164835164835, "y1": 0.28205128205128205}, {"text": "the shepherd of words ever mindful of the likes and dislikes of his", "x0": 0.2153846153846154, "y0": 0.28593628593628595, "x1": 0.7835164835164835, "y1": 0.29914529914529914}, {"text": "customers. It is often he who first discovers a great work, and he who.", "x0": 0.21428571428571427, "y0": 0.30225330225330227, "x1": 0.7846153846153846, "y1": 0.31546231546231546}, {"text": "finds the words to talk of words, who states the price \u2014 by definition", "x0": 0.2153846153846154, "y0": 0.31934731934731936, "x1": 0.7846153846153846, "y1": 0.33255633255633255}, {"text": "risible**** \u2014 of what he knows to be invaluable.", "x0": 0.21428571428571427, "y0": 0.3356643356643357, "x1": 0.6021978021978022, "y1": 0.3457653457653458}, {"text": "PIERRE PEIU", "x0": 0.6879120879120879, "y0": 0.38694638694638694, "x1": 0.7846153846153846, "y1": 0.3962703962703963}, {"text": "Adapted from The Girl from the Chartreuse", "x0": 0.42747252747252745, "y0": 0.4024864024864025, "x1": 0.7846153846153846, "y1": 0.4156954156954157}, {"text": "Reproduced with permission of The Random House Group UK,", "x0": 0.3659340659340659, "y0": 0.43123543123543123, "x1": 0.7857142857142857, "y1": 0.44133644133644134}, {"text": "under the Fair Use provisions", "x0": 0.5065934065934066, "y0": 0.4444444444444444, "x1": 0.701098901098901, "y1": 0.45454545454545453}, {"text": "* anarchy disorganisation", "x0": 0.2153846153846154, "y0": 0.4926184926184926, "x1": 0.5560439560439561, "y1": 0.5027195027195027}, {"text": "alchemy a seemingly magical chemistry", "x0": 0.2164835164835165, "y0": 0.5027195027195027, "x1": 0.6604395604395604, "y1": 0.5252525252525253}, {"text": "eek recondite obscure or mysterious", "x0": 0.2164835164835165, "y0": 0.5198135198135199, "x1": 0.6010989010989011, "y1": 0.5423465423465423}, {"text": "vee risible laughable", "x0": 0.2164835164835165, "y0": 0.5446775446775447, "x1": 0.5186813186813187, "y1": 0.5547785547785548}, {"text": "End of Text 2", "x0": 0.44065934065934065, "y0": 0.6433566433566433, "x1": 0.5582417582417583, "y1": 0.6534576534576535}], [{"text": "Text 3 \u2014 Nonfiction extract", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.36153846153846153, "y1": 0.09246309246309246}, {"text": "Text 3 continues on page 7", "x0": 0.38461538461538464, "y0": 0.8997668997668997, "x1": 0.6142857142857143, "y1": 0.912975912975913}], [{"text": "Text 3 (continued)", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.2692307692307692, "y1": 0.09401709401709402}, {"text": "Georr DYER", "x0": 0.6835164835164835, "y0": 0.4522144522144522, "x1": 0.7846153846153846, "y1": 0.4630924630924631}, {"text": "Adapted from White Sands: Experiences from the Outside World", "x0": 0.2571428571428571, "y0": 0.4693084693084693, "x1": 0.7857142857142857, "y1": 0.4825174825174825}, {"text": "a place in French Polynesia", "x0": 0.4472527472527473, "y0": 0.5081585081585082, "x1": 0.6428571428571429, "y1": 0.5314685314685315}, {"text": "futility pointlessness", "x0": 0.256043956043956, "y0": 0.5322455322455323, "x1": 0.5406593406593406, "y1": 0.5439005439005439}, {"text": "End of Text 3", "x0": 0.44065934065934065, "y0": 0.6239316239316239, "x1": 0.5582417582417583, "y1": 0.6348096348096348}], [{"text": "Section IT", "x0": 0.11978021978021978, "y0": 0.08236208236208237, "x1": 0.22527472527472528, "y1": 0.0947940947940948}, {"text": "The prescribed texts for Section III are:", "x0": 0.11868131868131868, "y0": 0.11732711732711733, "x1": 0.43846153846153846, "y1": 0.13053613053613053}, {"text": "Prose Fiction", "x0": 0.14285714285714285, "y0": 0.14840714840714841, "x1": 0.256043956043956, "y1": 0.1585081585081585}, {"text": "James Bradley, Wrack", "x0": 0.33296703296703295, "y0": 0.14840714840714841, "x1": 0.