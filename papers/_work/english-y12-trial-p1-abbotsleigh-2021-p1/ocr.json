837606837606838, "x1": 0.2956043956043956, "y1": 0.6930846930846931}, {"text": "Attempt questions | \u2014 5", "x0": 0.12197802197802197, "y0": 0.7101787101787101, "x1": 0.3120879120879121, "y1": 0.7233877233877234}, {"text": "Allow about 45 minutes for this section", "x0": 0.12197802197802197, "y0": 0.7373737373737373, "x1": 0.43956043956043955, "y1": 0.7474747474747475}, {"text": "Section Il \u2014 20 marks", "x0": 0.12197802197802197, "y0": 0.7925407925407926, "x1": 0.3032967032967033, "y1": 0.8018648018648019}, {"text": "Attempt question 6", "x0": 0.12197802197802197, "y0": 0.818958818958819, "x1": 0.27472527472527475, "y1": 0.8321678321678322}, {"text": "Allow about 45 minutes for this section", "x0": 0.12197802197802197, "y0": 0.8453768453768454, "x1": 0.43956043956043955, "y1": 0.8554778554778555}], [{"text": "20 marks", "x0": 0.12197802197802197, "y0": 0.11266511266511267, "x1": 0.2, "y1": 0.12198912198912198}, {"text": "Attempt Questions 1-5", "x0": 0.12087912087912088, "y0": 0.13131313131313133, "x1": 0.31758241758241756, "y1": 0.14374514374514374}, {"text": "Allow about 45 minutes for this section", "x0": 0.12087912087912088, "y0": 0.14918414918414918, "x1": 0.45494505494505494, "y1": 0.1585081585081585}, {"text": "Read the texts in the Stimulus Booklet carefully and then answer the questions in the spaces", "x0": 0.12197802197802197, "y0": 0.1825951825951826, "x1": 0.8626373626373627, "y1": 0.1958041958041958}, {"text": "provided. These spaces provide guidance for the expected length of response.", "x0": 0.12087912087912088, "y0": 0.19968919968919968, "x1": 0.7494505494505495, "y1": 0.2128982128982129}, {"text": "Your answers will be assessed on how well you:", "x0": 0.12197802197802197, "y0": 0.2261072261072261, "x1": 0.5098901098901099, "y1": 0.23931623931623933}, {"text": "demonstrate understanding of human experiences in texts", "x0": 0.22967032967032966, "y0": 0.2463092463092463, "x1": 0.6945054945054945, "y1": 0.2595182595182595}, {"text": "analyse, explain and assess the ways human experiences are represented in texts", "x0": 0.22967032967032966, "y0": 0.26573426573426573, "x1": 0.8747252747252747, "y1": 0.2789432789432789}, {"text": "Question 1 (3 marks)", "x0": 0.12197802197802197, "y0": 0.3123543123543124, "x1": 0.2956043956043956, "y1": 0.3247863247863248}, {"text": "Text 1 \u2014 Narrative comic extract", "x0": 0.12197802197802197, "y0": 0.34032634032634035, "x1": 0.3989010989010989, "y1": 0.34965034965034963}, {"text": "Explain how the image inspires the audience to transform negative experiences. 3", "x0": 0.12197802197802197, "y0": 0.3939393939393939, "x1": 0.8549450549450549, "y1": 0.40714840714840717}, {"text": "Section I continues on page 3", "x0": 0.3758241758241758, "y0": 0.885003885003885, "x1": 0.6230769230769231, "y1": 0.8982128982128982}], [{"text": "Question 2 (4 marks)", "x0": 0.12197802197802197, "y0": 0.08857808857808858, "x1": 0.2956043956043956, "y1": 0.10178710178710179}, {"text": "Text 2\u2014 Poem", "x0": 0.12197802197802197, "y0": 0.1250971250971251, "x1": 0.24285714285714285, "y1": 0.13442113442113443}, {"text": "Discuss how the speaker\u2019s personal reflections of ordinary objects invite the reader to share", "x0": 0.12197802197802197, "y0": 0.15073815073815075, "x1": 0.8582417582417582, "y1": 0.17715617715617715}, {"text": "in his appreciation of what is valuable in life. 4", "x0": 0.12197802197802197, "y0": 0.17715617715617715, "x1": 0.856043956043956, "y1": 0.19036519036519037}, {"text": "Section I continues on page 4", "x0": 0.3758241758241758, "y0": 0.8795648795648796, "x1": 0.6230769230769231, "y1": 0.8927738927738927}], [{"text": "Question 3 (3 marks)", "x0": 0.12197802197802197, "y0": 0.08857808857808858, "x1": 0.2956043956043956, "y1": 0.10178710178710179}, {"text": "Text 3 \u2014 Prose fiction extract", "x0": 0.12197802197802197, "y0": 0.11810411810411811, "x1": 0.36813186813186816, "y1": 0.12742812742812742}, {"text": "How is setting painted in a vivid way to display the impact it has on the main character? 3", "x0": 0.12197802197802197, "y0": 0.1452991452991453, "x1": 0.8549450549450549, "y1": 0.1585081585081585}, {"text": "Section I continues on page 5", "x0": 0.3758241758241758, "y0": 0.8834498834498834, "x1": 0.6230769230769231, "y1": 0.8958818958818959}], [{"text": "Question 4 (4 marks)", "x0": 0.12197802197802197, "y0": 0.08857808857808858, "x1": 0.2956043956043956, "y1": 0.10178710178710179}, {"text": "Text 4 \u2014 Discursive essay", "x0": 0.12197802197802197, "y0": 0.12432012432012432, "x1": 0.33406593406593404, "y1": 0.13752913752913754}, {"text": "Analyse how the metaphor of furniture explores the persona\u2019s changing attitude towards her", "x0": 0.12197802197802197, "y0": 0.15073815073815075, "x1": 0.8637362637362638, "y1": 0.17715617715617715}, {"text": "experiences. 4", "x0": 0.12197802197802197, "y0": 0.17016317016317017, "x1": 0.856043956043956, "y1": 0.19347319347319347}, {"text": "Section I continues on pages 6 and 7", "x0": 0.34615384615384615, "y0": 0.8508158508158508, "x1": 0.6538461538461539, "y1": 0.864024864024864}], [{"text": "Question 5 (6 marks)", "x0": 0.12197802197802197, "y0": 0.08857808857808858, "x1": 0.2956043956043956, "y1": 0.10178710178710179}, {"text": "Text 4 AND Text 1, 2 OR 3 \u2014Discursive essay AND narrative comic extract, poem OR", "x0": 0.12197802197802197, "y0": 0.1250971250971251, "x1": 0.8604395604395605, "y1": 0.13752913752913754}, {"text": "prose fiction extract", "x0": 0.12197802197802197, "y0": 0.1414141414141414, "x1": 0.2923076923076923, "y1": 0.15462315462315462}, {"text": "\u201cIt\u2019s an image. Of you. Of all of us. It stands steady. Ok, it\u2019s got those nail holes all over the", "x0": 0.12417582417582418, "y0": 0.17715617715617715, "x1": 0.8670329670329671, "y1": 0.19036519036519037}, {"text": "top. But they're marks of experience.\u201d", "x0": 0.12197802197802197, "y0": 0.19502719502719504, "x1": 0.42967032967032964, "y1": 0.20823620823620823}, {"text": "To what extent is this notion true of Text 4 and ONE other text, 1, 2 or 3? In your answer", "x0": 0.12087912087912088, "y0": 0.22999222999222999, "x1": 0.843956043956044, "y1": 0.2432012432012432}, {"text": "compare, and contrast, both texts. 6", "x0": 0.12197802197802197, "y0": 0.24786324786324787, "x1": 0.856043956043956, "y1": 0.26107226107226106}], [{"text": "Question 5 (continued)", "x0": 0.12197802197802197, "y0": 0.08857808857808858, "x1": 0.3054945054945055, "y1": 0.10178710178710179}, {"text": "End of Section I", "x0": 0.4318681318681319, "y0": 0.8865578865578866, "x1": 0.5681318681318681, "y1": 0.8966588966588966}], [{"text": "SECTION IL", "x0": 0.12197802197802197, "y0": 0.08935508935508936, "x1": 0.23186813186813188, "y1": 0.09867909867909867}, {"text": "20 marks", "x0": 0.12197802197802197, "y0": 0.11188811188811189, "x1": 0.2, "y1": 0.12121212121212122}, {"text": "Attempt Question 6", "x0": 0.12087912087912088, "y0": 0.12975912975912976, "x1": 0.289010989010989, "y1": 0.14219114219114218}, {"text": "Allow about 45 minutes for this section", "x0": 0.12087912087912088, "y0": 0.14763014763014762, "x1": 0.45494505494505494, "y1": 0.15695415695415696}, {"text": "Answer the question in the writing booklets. Write you student number at the top of each", "x0": 0.12197802197802197, "y0": 0.18104118104118105, "x1": 0.8373626373626374, "y1": 0.19425019425019424}, {"text": "booklet used. Extra writing booklets are available.", "x0": 0.12087912087912088, "y0": 0.19735819735819735, "x1": 0.5241758241758242, "y1": 0.21056721056721056}, {"text": "Your answer will be as:", "x0": 0.12197802197802197, "y0": 0.22533022533022534, "x1": 0.3054945054945055, "y1": 0.23543123543123542}, {"text": "sed on how well you:", "x0": 0.3241758241758242, "y0": 0.22533022533022534, "x1": 0.5021978021978022, "y1": 0.23853923853923853}, {"text": "\u00abdemonstrate understanding of human experiences in texts", "x0": 0.20549450549450549, "y0": 0.24553224553224554, "x1": 0.6945054945054945, "y1": 0.25874125874125875}, {"text": "analyse, explain and assess the ways human experiences are represented in texts", "x0": 0.22967032967032966, "y0": 0.26573426573426573, "x1": 0.8747252747252747, "y1": 0.2789432789432789}, {"text": "\u00a9 organise, develop and express ideas using language appropriate to audience,", "x0": 0.20549450549450549, "y0": 0.28593628593628595, "x1": 0.8406593406593407, "y1": 0.29914529914529914}, {"text": "purpose and context", "x0": 0.22857142857142856, "y0": 0.30225330225330227, "x1": 0.3901098901098901, "y1": 0.31546231546231546}, {"text": "Question 6 (20 marks)", "x0": 0.12197802197802197, "y0": 0.36363636363636365, "x1": 0.3054945054945055, "y1": 0.37684537684537683}, {"text": "Composers create powerful stories that enable us to understand and appreciate experiences", "x0": 0.12197802197802197, "y0": 0.3986013986013986, "x1": 0.8516483516483516, "y1": 0.41181041181041184}, {"text": "that are different from our own.", "x0": 0.12197802197802197, "y0": 0.41647241647241645, "x1": 0.3747252747252747, "y1": 0.42657342657342656}, {"text": "Discuss this statement by referring closely to your prescribed text.", "x0": 0.12197802197802197, "y0": 0.44366744366744365, "x1": 0.6538461538461539, "y1": 0.4568764568764569}, {"text": "The prescribed texts are listed on pages 9-10.", "x0": 0.12087912087912088, "y0": 0.5415695415695416, "x1": 0.4846153846153846, "y1": 0.5547785547785548}], [{"text": "Question 6 (continued)", "x0": 0.12197802197802197, "y0": 0.08857808857808858, "x1": 0.3054945054945055, "y1": 0.10178710178710179}, {"text": "The prescribed texts are:", "x0": 0.12087912087912088, "y0": 0.12432012432012432, "x1": 0.31758241758241756, "y1": 0.13752913752913754}, {"text": "+ Prose Fiction", "x0": 0.12197802197802197, "y0": 0.16006216006216006, "x1": 0.24505494505494504, "y1": 0.16938616938616938}, {"text": "\u2014 Anthony Doerr, All the Light We Cannot See", "x0": 0.12087912087912088, "y0": 0.1864801864801865, "x1": 0.4967032967032967, "y1": 0