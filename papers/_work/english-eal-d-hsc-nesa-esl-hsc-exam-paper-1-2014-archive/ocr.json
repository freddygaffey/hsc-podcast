[[{"text": "BOARD oF sTUDIES", "x0": 0.2802197802197802, "y0": 0.09712509712509712, "x1": 0.43626373626373627, "y1": 0.10334110334110334}, {"text": "TEACHING &", "x0": 0.2802197802197802, "y0": 0.10722610722610723, "x1": 0.3769230769230769, "y1": 0.11266511266511267}, {"text": "BOSTES", "x0": 0.12087912087912088, "y0": 0.11421911421911422, "x1": 0.26373626373626374, "y1": 0.13364413364413363}, {"text": "EDUCATIONAL", "x0": 0.2802197802197802, "y0": 0.11732711732711733, "x1": 0.3912087912087912, "y1": 0.12276612276612277}, {"text": "STANDARDS NSW", "x0": 0.2802197802197802, "y0": 0.12742812742812742, "x1": 0.4153846153846154, "y1": 0.13286713286713286}, {"text": "20 I HIGHER SCHOOL CERTIFICATE", "x0": 0.11978021978021978, "y0": 0.1717171717171717, "x1": 0.43626373626373627, "y1": 0.19502719502719504}, {"text": "EXAMINATION", "x0": 0.22417582417582418, "y0": 0.1864801864801865, "x1": 0.321978021978022, "y1": 0.19502719502719504}, {"text": "IMPORTANT:", "x0": 0.12087912087912088, "y0": 0.24475524475524477, "x1": 0.22197802197802197, "y1": 0.2533022533022533}, {"text": "This resource was developed to support a previous version of the syllabus.", "x0": 0.11868131868131868, "y0": 0.26107226107226106, "x1": 0.6725274725274726, "y1": 0.27195027195027194}, {"text": "It may contain content that differs from the current syllabus.", "x0": 0.12087912087912088, "y0": 0.2773892773892774, "x1": 0.5582417582417583, "y1": 0.28826728826728826}, {"text": "English (ESL)", "x0": 0.12307692307692308, "y0": 0.3690753690753691, "x1": 0.4351648351648352, "y1": 0.4149184149184149}, {"text": "Paper 1 \u2014 Language Study", "x0": 0.12197802197802197, "y0": 0.4234654234654235, "x1": 0.6428571428571429, "y1": 0.4592074592074592}, {"text": "within an Area of Study", "x0": 0.34725274725274724, "y0": 0.4716394716394716, "x1": 0.798901098901099, "y1": 0.5066045066045066}, {"text": "Total marks \u2014 45", "x0": 0.4758241758241758, "y0": 0.5889665889665889, "x1": 0.6186813186813187, "y1": 0.5982905982905983}, {"text": "Pages 2-5", "x0": 0.610989010989011, "y0": 0.6208236208236209, "x1": 0.6912087912087912, "y1": 0.6332556332556333}, {"text": "General Instructions 25 marks", "x0": 0.11978021978021978, "y0": 0.6449106449106449, "x1": 0.554945054945055, "y1": 0.6581196581196581}, {"text": "* Reading time \u2014 10 minutes * Attempt Question |", "x0": 0.11978021978021978, "y0": 0.6666666666666666, "x1": 0.643956043956044, "y1": 0.682983682983683}, {"text": "* Working time ~ 14 hours + Allow about 50 minutes for this section", "x0": 0.11978021978021978, "y0": 0.6868686868686869, "x1": 0.8076923076923077, "y1": 0.7062937062937062}, {"text": "* Write using black or blue pen Pages 6-7", "x0": 0.11978021978021978, "y0": 0.7125097125097125, "x1": 0.6912087912087912, "y1": 0.7342657342657343}, {"text": "Black pen is preferred", "x0": 0.13186813186813187, "y0": 0.7303807303807304, "x1": 0.3098901098901099, "y1": 0.7428127428127428}, {"text": "20 marks", "x0": 0.4758241758241758, "y0": 0.7466977466977467, "x1": 0.554945054945055, "y1": 0.756021756021756}, {"text": "+ Attempt Question 2", "x0": 0.4758241758241758, "y0": 0.7676767676767676, "x1": 0.6461538461538462, "y1": 0.7801087801087802}, {"text": "+ Allow about 40 minutes for this section", "x0": 0.4758241758241758, "y0": 0.7878787878787878, "x1": 0.8076923076923077, "y1": 0.797979797979798}, {"text": "1200", "x0": 0.05054945054945055, "y0": 0.9456099456099456, "x1": 0.08021978021978023, "y1": 0.9533799533799534}], [{"text": "Section I", "x0": 0.11978021978021978, "y0": 0.08080808080808081, "x1": 0.20549450549450549, "y1": 0.09246309246309246}, {"text": "25 marks", "x0": 0.11978021978021978, "y0": 0.11732711732711733, "x1": 0.1978021978021978, "y1": 0.12665112665112666}, {"text": "Attempt Question I", "x0": 0.11978021978021978, "y0": 0.13364413364413363, "x1": 0.2857142857142857, "y1": 0.14607614607614608}, {"text": "Allow about 50 minutes for this section", "x0": 0.11978021978021978, "y0": 0.15073815073815075, "x1": 0.45384615384615384, "y1": 0.16006216006216006}, {"text": "Examine Texts one, two, and three carefully and then answer the questions in the Paper 1", "x0": 0.11978021978021978, "y0": 0.18337218337218336, "x1": 0.8769230769230769, "y1": 0.19658119658119658}, {"text": "Answer Booklet.", "x0": 0.11978021978021978, "y0": 0.20046620046620048, "x1": 0.24945054945054945, "y1": 0.2097902097902098}, {"text": "In your answers you will be a", "x0": 0.14395604395604394, "y0": 0.23076923076923078, "x1": 0.38351648351648354, "y1": 0.2432012432012432}, {"text": "ssed on how well you:", "x0": 0.4098901098901099, "y0": 0.23076923076923078, "x1": 0.5835164835164836, "y1": 0.2432012432012432}, {"text": "m= demonstrate understanding of the ways language shapes and expresses perceptions", "x0": 0.14285714285714285, "y0": 0.2501942501942502, "x1": 0.8362637362637363, "y1": 0.2634032634032634}], [{"text": "Text one \u2014 Advertisement", "x0": 0.11868131868131868, "y0": 0.08080808080808081, "x1": 0.34945054945054943, "y1": 0.09168609168609168}], [{"text": "Text two \u2014 Song lyrics", "x0": 0.11868131868131868, "y0": 0.08080808080808081, "x1": 0.31758241758241756, "y1": 0.09401709401709402}], [{"text": "Text three \u2014 Memoir extract", "x0": 0.11868131868131868, "y0": 0.08080808080808081, "x1": 0.37252747252747254, "y1": 0.09090909090909091}, {"text": "The image is vivid in my mind. The night I am thinking about is a clear and recurring memory.", "x0": 0.11868131868131868, "y0": 0.13442113442113443, "x1": 0.8791208791208791, "y1": 0.14763014763014762}, {"text": "Five or six of us are seated on the ground around a smouldering campfire under a star-filled", "x0": 0.11978021978021978, "y0": 0.15073815073815075, "x1": 0.8791208791208791, "y1": 0.16394716394716394}, {"text": "black sky by the waters of the Gulf of Carpentaria in Australia\u2019s remote north. It is", "x0": 0.11868131868131868, "y0": 0.16783216783216784, "x1": 0.8791208791208791, "y1": 0.18104118104118105}, {"text": "1982 \u2014 twenty-seven years ago. Our baby is sleeping in a cot nearby. There is no wind, no", "x0": 0.12197802197802197, "y0": 0.18414918414918416, "x1": 0.8791208791208791, "y1": 0.19735819735819735}, {"text": "temperature to notice, no sounds. The darkness begins immediately behind us. My husband\u2019", "x0": 0.11978021978021978, "y0": 0.20124320124320125, "x1": 0.8714285714285714, "y1": 0.21445221445221446}, {"text": "uncle, Musso, the ceremonial leader of the Yanyuwa people, is telling stories about spirit", "x0": 0.11978021978021978, "y0": 0.21756021756021757, "x1": 0.8791208791208791, "y1": 0.23076923076923078}, {"text": "ancestors in the bush around us, about people leaving their bodies to travel vast distances, about", "x0": 0.11978021978021978, "y0": 0.23465423465423466, "x1": 0.8791208791208791, "y1": 0.24786324786324787}, {"text": "messages birds and animals bring to people in danger. Afterwards we drift off to sleep in the", "x0": 0.11978021978021978, "y0": 0.25097125097125095, "x1": 0.8791208791208791, "y1": 0.2641802641802642}, {"text": "total silence.", "x0": 0.11978021978021978, "y0": 0.2680652680652681, "x1": 0.21978021978021978, "y1": 0.2773892773892774}, {"text": "This same man hauls an enormous sack of writhing crabs across the mudflats the next day to", "x0": 0.11868131868131868, "y0": 0.3006993006993007, "x1": 0.8791208791208791, "y1": 0.3139083139083139}, {"text": "throw on the coals of the fire. We share the sweet white flesh with his family. Laughing, talking,", "x0": 0.11978021978021978, "y0": 0.3177933177933178, "x1": 0.8791208791208791, "y1": 0.331002331002331}, {"text": "enjoying each other\u2019s company. And this same man commands the hunting boat for dugong,", "x0": 0.11868131868131868, "y0": 0.3341103341103341, "x1": 0.8791208791208791, "y1": 0.3473193473193473}, {"text": "singing the song of the spirit when it is speared, cutting its portions for distribution", "x0": 0.11978021978021978, "y0": 0.35120435120435123, "x1": 0.8791208791208791, "y1": 0.3644133644133644}, {"text": "according to ritual and protocol. I pick up just a crude inkling of the interconnection between", "x0": 0.11978021978021978, "y0": 0.36752136752136755, "x1": 0.8791208791208791, "y1": 0.38073038073038074}, {"text": "his powerful culture and the everyday balance of a satisfying life lived in harmony with the", "x0": 0.11978021978021978, "y0": 0.38461538461538464, "x1": 0.8791208791208791, "y1": 0.3978243978243978}, {"text": "elements. In his words and when he is quiet, I sense the sharp wisdom and deep humanity that", "x0": 0.11868131868131868, "y0": 0.40093240093240096, "x1": 0.8791208791208791, "y1": 0.41414141414141414}, {"text": "lies beneath his humility.", "x0": 0.11978021978021978, "y0": 0.4172494172494173, "x1": 0.31978021978021975, "y1": 0.43045843045843046}, {"text": "We were visiting my husband John\u2019s Aboriginal community at Borroloola, in Australia\u2019s", "x0": 0.11868131868131868, "y0": 0.45143745143745145, "x1": 0.8791208791208791, "y1": 0.46386946386946387}, {"text": "Northern Territory. It was the start of an extraordinary journey. Not so much because of the", "x0": 0.11978021978021978, "y0": 0.4677544677544678, "x1": 0.8791208791208791, "y1": 0.48096348096348096}, {"text": "terrain or the vistas \u2014 as spectacularly different as they were \u2014 but because the cultural", "x0": 0.11978021978021978, "y0": 0.4840714840714841, "x1": 0.8791208791208791, "y1": 0.4972804972804973}, {"text": "landscape of family and humanity radiated a warmth that seemed to rise from the baked land", "x0": 0.11978021978021978, "y0": 0.5011655011655012, "x1": 0.8791208791208791, "y1": 0.5143745143745144}, {"text": "itself. In my early twenties, with a baby in tow, the impressions seared into the heart and mind", "x0": 0.11978021978021978, "y0": 0.5174825174825175, "x1": 0.8791208791208791, "y1": 0.5306915306915307}, {"text": "of a white girl from down south were indelible. They were then etched deeper with every trip", "x0": 0.11868131868131868, "y0": 0.5345765345765345, "x1": 0.8791208791208791, "y1": 0.5477855477855478}, {"text": "back over the years, as my own life story became entwined with theirs . . .", "x0": 0.11868131868131868, "y0": 0.5508935508935509, "x1": 0.7197802197802198, "y1": 0.5641025641025641}, {"text": "The children\u2019s Borroloola world was a universe away from our usual life in the city.", "x0": 0.11868131868131868, "y0": 0.5843045843045843, "x1": 0.8791208791208791, "y1": 0.5975135975135976}, {"text": "Spotlighting the eyes of crocs at night along the riverbank, eating dugong meat boiled up on", "x0": 0.11978021978021978, "y0": 0.6006216006216006, "x1": 0.8791208791208791, "y1": 0.6138306138306139}, {"text": "the fire, tearing around the Gulf in a boat hunting turtle. They would float on their backs in", "x0": 0.11978021978021978, "y0": 0.6177156177156177, "x1": 0.8791208791208791, "y1": 0.6309246309246309}, {"text": "wonder on a steaming thermal lake under soaring red and paddle a boat through canopies", "x0": 0.11978021978021978, "y0": 0.634032634032634, "x1": 0.8791208791208791, "y1": 0.6472416472416472}, {"text": "of foliage draped with tree snakes.", "x0": 0.11868131868131868, "y0": 0.6511266511266511, "x1": 0.3967032967032967, "y1": 0.6643356643356644}, {"text": "But the spiritual difference went deeper than the physical, and it began to emerge in layers, a", "x0": 0.11978021978021978, "y0": 0.6845376845376845, "x1": 0.8802197802197802, "y1": 0.6977466977466977}, {"text": "little more every time we went back. During the quiet times of sitting down by the riverbank", "x0": 0.11978021978021978, "y0": 0.7008547008547008, "x1": 0.8802197802197802, "y1": 0.714063714063714}, {"text": "with family in the morning, cooking by the fire at night, in the boat drifting around at the creek", "x0": 0.11978021978021978, "y0": 0.717948717948718, "x1": 0.8802197802197802, "y1": 0.7311577311577312}, {"text": "mouth in search of fish. It was of course natural to John, in his pores and under his skin, but to", "x0": 0.11978021978021978, "y0": 0.7342657342657343, "x1": 0.8791208791208791, "y1": 0.7474747474747475}, {"text": "me it was a gradual revelation ... Travelling with small children in the oppressive climate, and", "x0": 0.11978021978021978, "y0": 0.7505827505827506, "x1": 0.8791208791208791, "y1": 0.7637917637917638}, {"text": "my impatience with a slower, foreign world, restricted my senses in the beginning. While freely", "x0": 0.11978021978021978, "y0": 0.7676767676767676, "x1": 0.8791208791208791, "y1": 0.7808857808857809}, {"text": "given, it would take time for me to feel the arms of inclusion . . .", "x0": 0.11978021978021978, "y0": 0.7839937839937839, "x1": 0.6417582417582418, "y1": 0.7972027972027972}, {"text": "\u2018Acknowledgement: Memoir extract from Listening to Country by Ros Moriarty, c/- Curtis Brown (Aust) Pty Lid", "x0": 0.11868131868131868, "y0": 0.8104118104118104, "x1": 0.7637362637362637, "y1": 0.8197358197358198}, {"text": "End of Question 1", "x0": 0.421978021978022, "y0": 0.8982128982128982, "x1": 0.5758241758241758, "y1": 0.9106449106449106}], [{"text": "Section II", "x0": 0.11978021978021978, "y0": 0.08080808080808081, "x1": 0.2153846153846154, "y1": 0.09246309246309246}, {"text": "20 marks", "x0": 0.11978021978021978, "y0": 0.11577311577311578, "x1": 0.1978021978021978, "y1": 0.1250971250971251}, {"text": "Attempt Question 2", "x0": 0.11868131868131868, "y0": 0.1320901320901321, "x1": 0.2868131868131868, "y1": 0.1445221445221445}, {"text": "Allow about 40 minutes for this section", "x0": 0.11868131868131868, "y0": 0.14840714840714841, "x1": 0.45384615384615384, "y1": 0.15773115773115773}, {"text": "Answer the question in the Paper 1 Answer Booklet. Extra writing booklets are available.", "x0": 0.11978021978021978, "y0": 0.18104118104118105, "x1": 0.843956043956044, "y1": 0.19347319347319347}, {"text": "In your answer you will be assessed on how well you:", "x0": 0.14395604395604394, "y0": 0.20745920745920746, "x1": 0.5802197802197803, "y1": 0.2198912198912199}, {"text": "m= demonstrate understanding of the ways language shapes and expresses perceptions", "x0": 0.14285714285714285, "y0": 0.2261072261072261, "x1": 0.8362637362637363, "y1": 0.23931623931623933}, {"text": "= organise, develop and express ideas using language appropriate to audience, purpose", "x0": 0.14285714285714285, "y0": 0.24708624708624707, "x1": 0.856043956043956, "y1": 0.2595182595182595}, {"text": "and context", "x0": 0.16703296703296702, "y0": 0.2634032634032634, "x1": 0.25934065934065936, "y1": 0.2727272727272727}, {"text": "Question 2 (20 marks)", "x0": 0.11978021978021978, "y0": 0.3123543123543124, "x1": 0.30439560439560437, "y1": 0.32400932400932403}, {"text": "The strength of relationships has the greatest impact on a sense of belonging.", "x0": 0.11868131868131868, "y0": 0.34498834498834496, "x1": 0.743956043956044, "y1": 0.3581973581973582}, {"text": "In what ways is this view presented in the texts you have studied?", "x0": 0.11978021978021978, "y0": 0.3791763791763792, "x1": 0.6527472527472528, "y1": 0.3916083916083916}, {"text": "In your response, refer to your TWO prescribed texts and ONE text of your own choosing.", "x0": 0.11978021978021978, "y0": 0.411033411033411, "x1": 0.8538461538461538, "y1": 0.42424242424242425}, {"text": "The prescribed texts are:", "x0": 0.11868131868131868, "y0": 0.46231546231546233, "x1": 0.31648351648351647, "y1": 0.47474747474747475}, {"text": "* Prose Fiction \u2014 Allan Baillie, The China Coin", "x0": 0.11978021978021978, "y0": 0.494949494949495, "x1": 0.5395604395604395, "y1": 0.5066045066045066}, {"text": "or", "x0": 0.4197802197802198, "y0": 0.5229215229215229, "x1": 0.43736263736263736, "y1": 0.5299145299145299}, {"text": "\u2014 Ruth Prawer Jhabvala, Heat and Dust", "x0": 0.27362637362637365, "y0": 0.5446775446775447, "x1": 0.6021978021978022, "y1": 0.5563325563325563}, {"text": "or", "x0": 0.4197802197802198, "y0": 0.5734265734265734, "x1": 0.43736263736263736, "y1": 0.5804195804195804}, {"text": "\u2014 Tara June Winch, Swallow the Air", "x0": 0.27362637362637365, "y0": 0.5951825951825952, "x1": 0.5725274725274725, "y1": 0.6060606060606061}, {"text": "+ Drama \u2014 Willy Russell, Educating Rita", "x0": 0.11978021978021978, "y0": 0.6449106449106449, "x1": 0.5384615384615384, "y1": 0.6581196581196581}, {"text": "or", "x0": 0.4197802197802198, "y0": 0.6736596736596736, "x1": 0.43736263736263736, "y1": 0.6806526806526807}, {"text": "\u2014 Jane Harrison, Rainbow's End", "x0": 0.27362637362637365, "y0": 0.6954156954156954, "x1": 0.5428571428571428, "y1": 0.7070707070707071}, {"text": "from Vivienne Cleven et al. (eds), Contemporary Indigenous Plays", "x0": 0.2989010989010989, "y0": 0.7117327117327117, "x1": 0.8384615384615385, "y1": 0.7249417249417249}, {"text": "Question 2 continues on page 7", "x0": 0.3659340659340659, "y0": 0.7801087801087802, "x1": 0.6307692307692307, "y1": 0.7925407925407926}], [{"text": "Question 2 (continued)", "x0": 0.11978021978021978, "y0": 0.08080808080808081, "x1": 0.30439560439560437, "y1": 0.09324009324009325}, {"text": "Peter Skrzynecki, /mmigrant Chronicle", "x0": 0.2978021978021978, "y0": 0.11344211344211344, "x1": 0.6153846153846154, "y1": 0.12665112665112666}, {"text": "Poetry", "x0": 0.14395604395604394, "y0": 0.11421911421911422, "x1": 0.1989010989010989, "y1": 0.12665112665112666}, {"text": "The prescribed poems are:", "x0": 0.2978021978021978, "y0": 0.13908313908313907, "x1": 0.5098901098901099, "y1": 0.1522921522921523}, {"text": "Immigrants at Central Station, 1951", "x0": 0.3208791208791209, "y0": 0.16394716394716394, "x1": 0.6120879120879121, "y1": 0.17715617715617715}, {"text": "Feliks Skrzynecki", "x0": 0.3208791208791209, "y0": 0.18026418026418026, "x1": 0.4604395604395604, "y1": 0.19347319347319347}, {"text": "St Patrick's College", "x0": 0.3208791208791209, "y0": 0.19735819735819735, "x1": 0.48021978021978023, "y1": 0.21056721056721056}, {"text": "Ancestors"