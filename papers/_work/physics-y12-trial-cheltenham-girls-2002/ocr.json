56410256411, "x1": 0.189010989010989, "y1": 0.655011655011655}, {"text": "to the right.", "x0": 0.1835164835164835, "y0": 0.6573426573426573, "x1": 0.2802197802197802, "y1": 0.6721056721056721}, {"text": "Unable to be determined.", "x0": 0.14395604395604394, "y0": 0.6736596736596736, "x1": 0.3505494505494505, "y1": 0.6860916860916861}, {"text": "4, Geostationary satellit\u00e9s are most commonly used for communications. These satellites have,", "x0": 0.06043956043956044, "y0": 0.721056721056721, "x1": 0.8516483516483516, "y1": 0.7443667443667443}, {"text": "Period Altitude", "x0": 0.2868131868131868, "y0": 0.7575757575757576, "x1": 0.5615384615384615, "y1": 0.7785547785547785}, {"text": "@ | 24 hours High", "x0": 0.22527472527472528, "y0": 0.7785547785547785, "x1": 0.5340659340659341, "y1": 0.8057498057498057}, {"text": "[24 hours Low .", "x0": 0.2824175824175824, "y0": 0.804972804972805, "x1": 0.8615384615384616, "y1": 0.8329448329448329}, {"text": "| 7 hours High", "x0": 0.26703296703296703, "y0": 0.8368298368298368, "x1": 0.5318681318681319, "y1": 0.8585858585858586}, {"text": "@ Low", "x0": 0.21978021978021978, "y0": 0.8663558663558664, "x1": 0.5274725274725275, "y1": 0.8803418803418803}], [{"text": "a space ship movin,", "x0": 0.34945054945054943, "y0": 0.021756021756021756, "x1": 0.5010989010989011, "y1": 0.039627039627039624}, {"text": "ym the \u2018Spacecraft appear", "x0": 0.32967032967032966, "y0": 0.03807303807303807, "x1": 0.5241758241758242, "y1": 0.061383061383061384}, {"text": "Length Time", "x0": 0.3384615384615385, "y0": 0.07226107226107226, "x1": 0.5637362637362637, "y1": 0.09324009324009325}, {"text": "(a) | Contracted Dilated", "x0": 0.27802197802197803, "y0": 0.09401709401709402, "x1": 0.5813186813186814, "y1": 0.12043512043512043}, {"text": "(b) | Lengthened Dilated", "x0": 0.27912087912087913, "y0": 0.12432012432012432, "x1": 0.5813186813186814, "y1": 0.14607614607614608}, {"text": "%) | Contracted Same", "x0": 0.27912087912087913, "y0": 0.1452991452991453, "x1": 0.567032967032967, "y1": 0.1717171717171717}, {"text": "(| Lengthened Same", "x0": 0.2802197802197802, "y0": 0.17871017871017872, "x1": 0.5681318681318681, "y1": 0.19502719502719504}, {"text": "6.. Electrorhagneti\u00a2 induction occurs when", "x0": 0.08351648351648351, "y0": 0.23853923853923853, "x1": 0.44395604395604393, "y1": 0.2540792540792541}, {"text": "is accelerating in a magnetic field.", "x0": 0.2725274725274725, "y0": 0.27117327117327117, "x1": 0.5516483516483517, "y1": 0.2851592851592852}, {"text": "(b) moves parallel to a magnetic field.", "x0": 0.11648351648351649, "y0": 0.2867132867132867, "x1": 0.5538461538461539, "y1": 0.30225330225330227}, {"text": "(c) moves at right angles to a magnetic field,", "x0": 0.11648351648351649, "y0": 0.30225330225330227, "x1": 0.6087912087912087, "y1": 0.3185703185703186}, {"text": "moves with a large constant in a magnetic field.", "x0": 0.2725274725274725, "y0": 0.3185703185703186, "x1": 0.7351648351648352, "y1": 0.3341103341103341}, {"text": "J, Transformers ate used in our domestic electricity grid are mainly step-down transformers. They are", "x0": 0.08351648351648351, "y0": 0.3682983682983683, "x1": 0.9373626373626374, "y1": 0.38306138306138304}, {"text": "necessary to", "x0": 0.11538461538461539, "y0": 0.38927738927738925, "x1": 0.2175824175824176, "y1": 0.4017094017094017}, {"text": "(a) decrease the voltage in the secondary circuit.", "x0": 0.11758241758241758, "y0": 0.4188034188034188, "x1": 0.5373626373626373, "y1": 0.43434343434343436}, {"text": "(b) _ increase the power in the secondary \u00a2ircuit.", "x0": 0.11758241758241758, "y0": 0.43123543123543123, "x1": 0.5252747252747253, "y1": 0.4553224553224553}, {"text": "(c) decrease the current in the secondary circuit.", "x0": 0.11758241758241758, "y0": 0.4522144522144522, "x1": 0.5351648351648352, "y1": 0.4677544677544678}, {"text": "(d) - increase the resistance in the secondary circuit.", "x0": 0.11758241758241758, "y0": 0.46853146853146854, "x1": 0.5527472527472528, "y1": 0.48484848484848486}, {"text": "8. Two types of generator are shown", "x0": 0.08571428571428572, "y0": 0.519036519036519, "x1": 0.3967032967032967, "y1": 0.5337995337995338}, {"text": "Correct statements about each are:", "x0": 0.11318681318681319, "y0": 0.7218337218337219, "x1": 0.3945054945054945, "y1": 0.7334887334887334}, {"text": "Generator 1 Generator 2", "x0": 0.3010989010989011, "y0": 0.7544677544677545, "x1": 0.765934065934066, "y1": 0.7676767676767676}, {"text": "G | commutator [AC produced | Splitting commutator | DC produced", "x0": 0.12857142857142856, "y0": 0.77000777000777, "x1": 0.865934065934066, "y1": 0.8010878010878011}, {"text": "@) | commutator | AC produced | commutator | DC produced", "x0": 0.12857142857142856, "y0": 0.7956487956487956, "x1": 0.865934065934066, "y1": 0.8259518259518259}, {"text": "() | commutator | DC produced Slip-ring commutator | AC produced", "x0": 0.12857142857142856, "y0": 0.8298368298368298, "x1": 0.865934065934066, "y1": 0.8547008547008547}, {"text": "@) | Slip-ring commutator | DC produced Split-ring commutator | AC produced ..", "x0": 0.12747252747252746, "y0": 0.8562548562548562, "x1": 0.8802197802197802, "y1": 0.8787878787878788}], [{"text": "\u20189. A four tubes, all of equal internal \u2018diameter \u2018two made of and two are", "x0": 0.07802197802197802, "y0": 0.017094017094017096, "x1": 0.865934065934066, "y1": 0.05128205128205128}, {"text": "One of each material has a slot along its length and the other two'do not. The tubes are held vertically", "x0": 0.11428571428571428, "y0": 0.04195804195804196, "x1": 0.954945054945055, "y1": 0.07226107226107226}, {"text": "and a strong magnet is dropped down inside them.", "x0": 0.11428571428571428, "y0": 0.06293706293706294, "x1": 0.5274725274725275, "y1": 0.07847707847707848}, {"text": "Velocity", "x0": 0.20659340659340658, "y0": 0.19813519813519814, "x1": 0.27802197802197803, "y1": 0.21212121212121213}, {"text": "Time", "x0": 0.4307692307692308, "y0": 0.3146853146853147, "x1": 0.4736263736263736, "y1": 0.32556332556332557}, {"text": "The graph \u201cC\u201d refers to", "x0": 0.16263736263736264, "y0": 0.3480963480963481, "x1": 0.42637362637362636, "y1": 0.3620823620823621}, {"text": "(a) The aluminium tube without a slot in it.", "x0": 0.11208791208791209, "y0": 0.3815073815073815, "x1": 0.47802197802197804, "y1": 0.3954933954933955}, {"text": "(b) tube slot in it.", "x0": 0.11208791208791209, "y0": 0.3978243978243978, "x1": 0.45164835164835165, "y1": 0.41181041181041184}, {"text": "(c) The plastic tube without a slot in it.", "x0": 0.11098901098901098, "y0": 0.41414141414141414, "x1": 0.44175824175824174, "y1": 0.4281274281274281}, {"text": "(a) The plastic tube with a slot in it.", "x0": 0.11098901098901098, "y0": 0.43045843045843046, "x1": 0.4164835164835165, "y1": 0.4444444444444444}, {"text": "\u201cTO. The diagram below shows a pair of charged parallel plates;", "x0": 0.06593406593406594, "y0": 0.4716394716394716, "x1": 0.5978021978021978, "y1": 0.4988344988344988}, {"text": "20mm", "x0": 0.5835164835164836, "y0": 0.5299145299145299, "x1": 0.6406593406593407, "y1": 0.5407925407925408}, {"text": "The potential difference across the plates is 186.3 V. The magnitude and direction of the resulting", "x0": 0.1054945054945055, "y0": 0.5843045843045843, "x1": 0.9076923076923077, "y1": 0.6130536130536131}, {"text": "electric field is", "x0": 0.1054945054945055, "y0": 0.6076146076146076, "x1": 0.22637362637362637, "y1": 0.6332556332556333}, {"text": "2) up.", "x0": 0.1010989010989011, "y0": 0.6441336441336442, "x1": 0.26483516483516484, "y1": 0.6596736596736597}, {"text": "9315NC\" down.", "x0": 0.14395604395604394, "y0": 0.6534576534576535, "x1": 0.2868131868131868, "y1": 0.6845376845376845}, {"text": "9.315NC* down.", "x0": 0.14395604395604394, "y0": 0.6736596736596736, "x1": 0.2879120879120879, "y1": 0.6977466977466977}, {"text": "Xd) up. \u2018me", "x0": 0.0978021978021978, "y0": 0.6907536907536908, "x1": 0.6417582417582418, "y1": 0.7086247086247086}, {"text": "11. Which of the following actions could be used to demonstrate the production of alternating current?", "x0": 0.07142857142857142, "y0": 0.7466977466977467, "x1": 0.9120879120879121, "y1": 0.7715617715617715}, {"text": "(@) Move a magnet in and out of a solenoid that is part of a closed circuit.", "x0": 0.1, "y0": 0.7808857808857809, "x1": 0.721978021978022, "y1": 0.8127428127428128}, {"text": "(b) Spina magnet near a piece of aluminium.", "x0": 0.1, "y0": 0.8041958041958042, "x1": 0.489010989010989, "y1": 0.8236208236208237}, {"text": "(c) Move a wire that is part of a closed circuit down through a magnetic field.", "x0": 0.0989010989010989, "y0": 0.8181818181818182, "x1": 0.7549450549450549, "y1": 0.83993783993784}, {"text": "magnet down a metal tube.", "x0": 0.2087912087912088, "y0": 0.8391608391608392, "x1": 0.42857142857142855, "y1": 0.8531468531468531}], [{"text": "12. Which of the following gives the maiii reason why X Rays rather than UV or visible light are", "x0": 0.0945054945054945, "y0": 0.031857031857031856, "x1": 0.8956043956043956, "y1": 0.059052059052059055}, {"text": "normally used to investigate crystal structure.", "x0": 0.12637362637362637, "y0": 0.05672105672105672, "x1": 0.4989010989010989, "y1": 0.07226107226107226}, {"text": "(a) Each X Ray photon has more energy than either UV or visible light.", "x0": 0.12637362637362637, "y0": 0.08780108780108781, "x1": 0.7351648351648352, "y1": 0.10955710955710955}, {"text": "(b) X Rays ntore easily release electrons from atoms.", "x0": 0.12747252747252746, "y0": 0.108003108003108, "x1": 0.5835164835164836, "y1": 0.12198912198912198}, {"text": "(c) X Rays were discovered long before UV or visible light.", "x0": 0.12747252747252746, "y0": 0.12432012432012432, "x1": 0.6406593406593407, "y1": 0.13908313908313907}, {"text": "@ The atomic separation of crystals is approximately equal to the wavelength of X Rays,", "x0": 0.12747252747252746, "y0": 0.14063714063714064, "x1": 0.889010989010989, "y1": 0.15695415695415696}, {"text": "13, This question refers to the following graph.", "x0": 0.0956043956043956, "y0": 0.19036519036519037, "x1": 0.4824175824175824, "y1": 0.2097902097902098}, {"text": "Using information from the graph, which of the following statements is correct?", "x0": 0.12307692307692308, "y0": 0.42035742035742035, "x1": 0.7769230769230769, "y1": 0.4366744366744367}, {"text": "(a) The greater the kinetic energy of the\u2019electrons, the shorter their wavelength.", "x0": 0.12307692307692308, "y0": 0.4553224553224553, "x1": 0.7934065934065934, "y1": 0.4700854700854701}, {"text": "(b) The slope of the line represents Planck\u2019s constant,", "x0": 0.12307692307692308, "y0": 0.4716394716394716, "x1": 0.5813186813186814, "y1": 0.48562548562548563}, {"text": "(c) - The work function of Metal 1 is greater then", "x0": 0.11868131868131868, "y0": 0.4864024864024864, "x1": 0.5351648351648352, "y1": 0.5019425019425019}, {"text": "(@ The intensity of the light used for Metal 2 is greater than that used for Metal 1.", "x0": 0.12087912087912088, "y0": 0.5042735042735043, "x1": 0.8153846153846154, "y1": 0.519036519036519}, {"text": "14, In which case will the induced EMF in the ring cause the current to follow in the direction indicated", "x0": 0.09010989010989011, "y0": 0.5516705516705517, "x1": 0.9406593406593406, "y1": 0.567987567987568}, {"text": "by the arrow labelled \u201c1\u201d?", "x0": 0.11868131868131868, "y0": 0.5672105672105672, "x1": 0.32967032967032966, "y1": 0.5835275835275835}, {"text": "15. \u201cGravity-assist\u201d or \u201cSlingshot Effect\u201d trajectories are often used by NASA to send space", "x0": 0.08131868131868132, "y0": 0.8414918414918415, "x1": 0.8373626373626374, "y1": 0.8578088578088578}, {"text": "distant planets, This type of trajectory is useful because", "x0": 0.11098901098901098, "y0": 0.8585858585858586, "x1": 0.5637362637362637, "y1": 0.8741258741258742}, {"text": "(2) Distant planets are larger and so provide a much greater gravity-assist.", "x0": 0.11098901098901098, "y0": 0.8927738927738927, "x1": 0.7362637362637363, "y1": 0.9083139083139083}, {"text": "(b) It increases the kinetic energy of the space probe.", "x0": 0.11098901098901098, "y0": 0.9090909090909091, "x1": 0.5626373626373626, "y1": 0.9254079254079254}, {"text": "{c) The total distance travelled by the probe is reduced.", "x0": 0.11098901098901098, "y0": 0.9254079254079254, "x1": 0.5813186813186814, "y1": 0.9425019425019425}, {"text": "(@, Itreduces the forces on the fragile equipment carried by the probe.", "x0": 0.11208791208791209, "y0": 0.9432789432789432, "x1": 0.7043956043956044, "y1": 0.9619269619269619}], [{"text": "PartB .", "x0": 0.04945054945054945, "y0": 0.030303030303030304, "x1": 0.7164835164835165, "y1": 0.05672105672105672}, {"text": "Total marks (60) .", "x0": 0.04945054945054945, "y0": 0.05982905982905983, "x1": 0.589010989010989, "y1": 0.07381507381507381}, {"text": "Attempt Questions 16-33 -", "x0": 0.051648351648351645, "y0": 0.06837606837606838, "x1": 0.8582417582417582, "y1": 0.09168609168609168}, {"text": "Allow about 1 hour and 45 minutes for this part", "x0": 0.051648351648351645, "y0": 0.08935508935508936, "x1": 0.4758241758241758, "y1": 0.10878010878010878}, {"text": "\u2018Write your ariswers on this sheet", "x0": 0.05274725274725275, "y0": 0.1258741258741259, "x1": 0.3934065934065934, "y1": 0.1445221445221445}, {"text": "16. The following question refers to the graph below, which shows the g-forces experienced an astronaut", "x0": 0.05714285714285714, "y0": 0.17094017094017094, "x1": 0.9318681318681319, "y1": 0.19425019425019424}, {"text": "during the launch of a spacecraft.", "x0": 0.1, "y0": 0.19425019425019424, "x1": 0.37362637362637363, "y1": 0.21212121212121213}, {"text": "* of muttiple", "x0": 0.45384615384615384, "y0": 0.2618492618492618, "x1": 0.6637362637362637, "y1": 0.28438228438228436}, {"text": "peaks,", "x0": 0.