[[{"text": "STUDENT NUMBER", "x0": 0.5577557755775577, "y0": 0.10567210567210568, "x1": 0.7392739273927392, "y1": 0.11499611499611499}, {"text": "ABBOTSLEIGH", "x0": 0.07260726072607261, "y0": 0.2128982128982129, "x1": 0.22002200220022003, "y1": 0.222999222999223}, {"text": "2022 HSC TRIAL EXAMINATION", "x0": 0.07260726072607261, "y0": 0.2400932400932401, "x1": 0.38173817381738173, "y1": 0.2501942501942502}, {"text": "English Advanced", "x0": 0.07260726072607261, "y0": 0.2975912975912976, "x1": 0.41034103410341033, "y1": 0.32556332556332557}, {"text": "Paper 2 \u2014 Modules A, B and C", "x0": 0.07260726072607261, "y0": 0.3442113442113442, "x1": 0.506050605060506, "y1": 0.3651903651903652}, {"text": "General Instructions", "x0": 0.07260726072607261, "y0": 0.37995337995337997, "x1": 0.24972497249724973, "y1": 0.3900543900543901}, {"text": "\u00a9 Reading time \u2014 5 minutes", "x0": 0.1034103410341034, "y0": 0.4087024087024087, "x1": 0.3388338833883388, "y1": 0.4211344211344211}, {"text": "\u00a9 Working time \u2014 2 hours", "x0": 0.1034103410341034, "y0": 0.42735042735042733, "x1": 0.32453245324532454, "y1": 0.4397824397824398}, {"text": "\u00a9 Write using black pen", "x0": 0.1034103410341034, "y0": 0.44522144522144524, "x1": 0.30913091309130913, "y1": 0.45765345765345766}, {"text": "\u00a9 Attempt every question", "x0": 0.1034103410341034, "y0": 0.46386946386946387, "x1": 0.32123212321232125, "y1": 0.4763014763014763}, {"text": "* Start a new writing booklet for each section", "x0": 0.1034103410341034, "y0": 0.48174048174048173, "x1": 0.48404840484048406, "y1": 0.494949494949495}, {"text": "\u00a9 Write your student number on every writing booklet used", "x0": 0.1034103410341034, "y0": 0.5011655011655012, "x1": 0.5951595159515951, "y1": 0.5135975135975136}, {"text": "Total marks: 60", "x0": 0.07260726072607261, "y0": 0.554001554001554, "x1": 0.21012101210121012, "y1": 0.5641025641025641}, {"text": "Section I - 20 marks", "x0": 0.07260726072607261, "y0": 0.5811965811965812, "x1": 0.24752475247524752, "y1": 0.5912975912975913}, {"text": "Attempt Question I (p.", "x0": 0.07260726072607261, "y0": 0.6091686091686092, "x1": 0.253025302530253, "y1": 0.6216006216006216}, {"text": "Allow about 40 minutes for this section", "x0": 0.07260726072607261, "y0": 0.6348096348096348, "x1": 0.39053905390539057, "y1": 0.6449106449106449}, {"text": "Section II \u2014 20 marks", "x0": 0.07260726072607261, "y0": 0.6891996891996892, "x1": 0.2552255225522552, "y1": 0.6993006993006993}, {"text": "Attempt Question 2 (p. 6 \u2014 8)", "x0": 0.07260726072607261, "y0": 0.7163947163947164, "x1": 0.30913091309130913, "y1": 0.7288267288267288}, {"text": "Allow about 40 minutes for this section", "x0": 0.07260726072607261, "y0": 0.7428127428127428, "x1": 0.39053905390539057, "y1": 0.752913752913753}, {"text": "Section III - 20 marks", "x0": 0.07260726072607261, "y0": 0.7972027972027972, "x1": 0.2629262926292629, "y1": 0.8073038073038074}, {"text": "Attempt Question 3 parts (a) and (b) (p. 9 - 10)", "x0": 0.07260726072607261, "y0": 0.8243978243978244, "x1": 0.45434543454345433, "y1": 0.8368298368298368}, {"text": "Allow about 40 minutes for this section", "x0": 0.07260726072607261, "y0": 0.8508158508158508, "x1": 0.39053905390539057, "y1": 0.8609168609168609}], [{"text": "Section I \u2014 Module A: Textual Conversations", "x0": 0.07260726072607261, "y0": 0.0777000777000777, "x1": 0.46974697469746973, "y1": 0.08780108780108781}, {"text": "20 marks", "x0": 0.07260726072607261, "y0": 0.11033411033411034, "x1": 0.15181518151815182, "y1": 0.12043512043512043}, {"text": "Attempt the question from Section I", "x0": 0.07260726072607261, "y0": 0.12742812742812742, "x1": 0.38173817381738173, "y1": 0.14063714063714064}, {"text": "Allow about 40 minutes for this section", "x0": 0.07260726072607261, "y0": 0.15462315462315462, "x1": 0.40594059405940597, "y1": 0.16472416472416473}, {"text": "Answer the question in a writing booklet. Write your student number at the top of every booklet used. Extra", "x0": 0.07260726072607261, "y0": 0.18104118104118105, "x1": 0.9427942794279428, "y1": 0.19425019425019424}, {"text": "writing booklets are available.", "x0": 0.0737073707370737, "y0": 0.19813519813519814, "x1": 0.3146314631463146, "y1": 0.21134421134421136}, {"text": "Your answer will be assessed on how well you:", "x0": 0.0737073707370737, "y0": 0.2432012432012432, "x1": 0.45324532453245325, "y1": 0.2556332556332556}, {"text": "\u00a9 demonstrate understanding of how composers are influenced by another text\u2019s", "x0": 0.14301430143014301, "y0": 0.26262626262626265, "x1": 0.7964796479647965, "y1": 0.27583527583527584}, {"text": "concepts and values", "x0": 0.16721672167216722, "y0": 0.27972027972027974, "x1": 0.3278327832783278, "y1": 0.29215229215229216}, {"text": "evaluate the relationships between texts and contexts", "x0": 0.16721672167216722, "y0": 0.29836829836829837, "x1": 0.5951595159515951, "y1": 0.31157731157731156}, {"text": "* organise, develop and express ideas using language appropriate to audience, purpose", "x0": 0.14301430143014301, "y0": 0.3185703185703186, "x1": 0.8481848184818482, "y1": 0.3317793317793318}, {"text": "and form", "x0": 0.16721672167216722, "y0": 0.3356643356643357, "x1": 0.23982398239823982, "y1": 0.3457653457653458}, {"text": "Question 1 (20 marks)", "x0": 0.07260726072607261, "y0": 0.37839937839937837, "x1": 0.25742574257425743, "y1": 0.39083139083139085}, {"text": "Poetry and Drama", "x0": 0.07260726072607261, "y0": 0.432012432012432, "x1": 0.23212321232123212, "y1": 0.44522144522144524}, {"text": "Composers shape their form to reimagine the works of others.", "x0": 0.0737073707370737, "y0": 0.4864024864024864, "x1": 0.570957095709571, "y1": 0.4996114996114996}, {"text": "How has the study of the two texts developed your understanding of the importance of form in a textual", "x0": 0.07260726072607261, "y0": 0.5135975135975136, "x1": 0.9075907590759076, "y1": 0.5268065268065268}, {"text": "conversation?", "x0": 0.07260726072607261, "y0": 0.5322455322455323, "x1": 0.18371837183718373, "y1": 0.5415695415695416}, {"text": "The prescribed texts are listed on pages 3 \u2014 5.", "x0": 0.07260726072607261, "y0": 0.585081585081585, "x1": 0.4389438943894389, "y1": 0.5982905982905983}], [{"text": "Question | (continued)", "x0": 0.07260726072607261, "y0": 0.0777000777000777, "x1": 0.25742574257425743, "y1": 0.09013209013209013}, {"text": "The prescribed texts are:", "x0": 0.07260726072607261, "y0": 0.10567210567210568, "x1": 0.26952695269526955, "y1": 0.11810411810411811}, {"text": "+ Shakespearean Drama and Film", "x0": 0.11991199119911991, "y0": 0.1320901320901321, "x1": 0.4081408140814081, "y1": 0.1452991452991453}, {"text": "~ William Shakespeare, King Richard III", "x0": 0.14301430143014301, "y0": 0.1623931623931624, "x1": 0.4752475247524752, "y1": 0.17560217560217561}, {"text": "and", "x0": 0.2629262926292629, "y0": 0.19502719502719504, "x1": 0.29042904290429045, "y1": 0.20435120435120435}, {"text": "\u2014 Al Pacino, Looking for Richard", "x0": 0.14301430143014301, "y0": 0.22533022533022534, "x1": 0.4136413641364136, "y1": 0.23776223776223776}, {"text": "+ Prose Fiction and Film", "x0": 0.11991199119911991, "y0": 0.2564102564102564, "x1": 0.32673267326732675, "y1": 0.2665112665112665}, {"text": "\u2014 Virginia Woolf, Mrs Dalloway", "x0": 0.14631463146314633, "y0": 0.2874902874902875, "x1": 0.41144114411441146, "y1": 0.3006993006993007}, {"text": "and", "x0": 0.13861386138613863, "y0": 0.3201243201243201, "x1": 0.16721672167216722, "y1": 0.32944832944832947}, {"text": "\u2014 Stephen Daldry, The Hours", "x0": 0.11771177117711772, "y0": 0.34965034965034963, "x1": 0.3542354235423542, "y1": 0.3628593628593629}, {"text": "+ Prose Fiction and Prose Fiction", "x0": 0.11991199119911991, "y0": 0.3815073815073815, "x1": 0.4004400440044004, "y1": 0.3916083916083916}, {"text": "\u2014 Albert Camus, The Stranger", "x0": 0.14301430143014301, "y0": 0.41181041181041184, "x1":