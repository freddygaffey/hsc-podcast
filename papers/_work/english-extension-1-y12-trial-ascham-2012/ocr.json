824175824, "y1": 0.1888111888111888}, {"text": "Question 8 \u2014 Elective 1: After the Bomb (25 marks)", "x0": 0.10659340659340659, "y0": 0.22377622377622378, "x1": 0.5505494505494506, "y1": 0.23776223776223776}, {"text": "Compose a piece of original imaginative writing using the following statement as the start of", "x0": 0.10659340659340659, "y0": 0.2533022533022533, "x1": 0.8527472527472527, "y1": 0.27350427350427353}, {"text": "a character\u2019s reflection on an important event in his or her life.", "x0": 0.10659340659340659, "y0": 0.2727272727272727, "x1": 0.6076923076923076, "y1": 0.2867132867132867}, {"text": "The true enemy is within; I can see that now.", "x0": 0.3054945054945055, "y0": 0.2898212898212898, "x1": 0.6615384615384615, "y1": 0.30303030303030304}, {"text": "In your response, draw on your knowledge and understanding of After the Bomb.", "x0": 0.1054945054945055, "y0": 0.3061383061383061, "x1": 0.7604395604395604, "y1": 0.31934731934731936}, {"text": "Question 9 \u2014 Elective 2: Romanticism (25 marks)", "x0": 0.10659340659340659, "y0": 0.3550893550893551, "x1": 0.5285714285714286, "y1": 0.3682983682983683}, {"text": "At its very core Romanticism concerns itself with freedom of thought and the use of the", "x0": 0.1054945054945055, "y0": 0.37995337995337997, "x1": 0.810989010989011, "y1": 0.4063714063714064}, {"text": "imagination in man\u2019s quest to understand himself and the world he lives in.", "x0": 0.10659340659340659, "y0": 0.40404040404040403, "x1": 0.7098901098901099, "y1": 0.4172494172494173}, {"text": "Evaluate this statement with reference to TWO prescribed texts AND texts of your own", "x0": 0.1054945054945055, "y0": 0.42035742035742035, "x1": 0.810989010989011, "y1": 0.43434343434343436}, {"text": "choosing,", "x0": 0.10659340659340659, "y0": 0.43745143745143744, "x1": 0.1824175824175824, "y1": 0.4506604506604507}, {"text": "Question 10 \u2014 Elective 2: Romanticism (25 marks)", "x0": 0.10659340659340659, "y0": 0.4864024864024864, "x1": 0.5395604395604395, "y1": 0.4996114996114996}, {"text": "Compose a piece of original imaginative writing using the following extract from AS Byatt\u2019s", "x0": 0.10659340659340659, "y0": 0.515928515928516, "x1": 0.8538461538461538, "y1": 0.5369075369075369}, {"text": "Possession as stimulus.", "x0": 0.1054945054945055, "y0": 0.5353535353535354, "x1": 0.2934065934065934, "y1": 0.5470085470085471}, {"text": "Men may be martyred", "x0": 0.2879120879120879, "y0": 0.5516705516705517, "x1": 0.46483516483516485, "y1": 0.5656565656565656}, {"text": "Any where", "x0": 0.2857142857142857, "y0": 0.5687645687645687, "x1": 0.37252747252747254, "y1": 0.581973581973582}, {"text": "In desert, cathedral", "x0": 0.2868131868131868, "y0": 0.5843045843045843, "x1": 0.44505494505494503, "y1": 0.5967365967365967}, {"text": "Or Public Square.", "x0": 0.2879120879120879, "y0": 0.6013986013986014, "x1": 0.4318681318681319, "y1": 0.6146076146076146}, {"text": "Inno Rush of Action", "x0": 0.2868131868131868, "y0": 0.6177156177156177, "x1": 0.45164835164835165, "y1": 0.6309246309246309}, {"text": "This is our doom", "x0": 0.289010989010989, "y0": 0.634032634032634, "x1": 0.4230769230769231, "y1": 0.6449106449106449}, {"text": "To Drag a Long Life out", "x0": 0.289010989010989, "y0": 0.6503496503496503, "x1": 0.4846153846153846, "y1": 0.6635586635586636}, {"text": "In a Dark Room. Christabel LaMotte", "x0": 0.2868131868131868, "y0": 0.6666666666666666, "x1": 0.7395604395604396, "y1": 0.6775446775446775}, {"text": "In your response, draw on your knowledge and understanding of Individualism in connection", "x0": 0.1054945054945055, "y0": 0.682983682983683, "x1": 0.8549450549450549, "y1": 0.696969696969697}, {"text": "with the social, political, religious or scientific paradigms of the Romantic period.", "x0": 0.1054945054945055, "y0": 0.6907536907536908, "x1": 0.7626373626373626, "y1": 0.7163947163947164}, {"text": "Question 11 \u2014 Elective 3: Navigating the Global (25 marks)", "x0": 0.10659340659340659, "y0": 0.7482517482517482, "x1": 0.6131868131868132, "y1": 0.7622377622377622}, {"text": "In Navigating the Global, composers not only confront the dilemmas of globalisation but also", "x0": 0.1010989010989011, "y0": 0.7738927738927739, "x1": 0.8571428571428571, "y1": 0.7987567987567987}, {"text": "manipulate textual forms and features in response to their times.", "x0": 0.10659340659340659, "y0": 0.797979797979798, "x1": 0.6197802197802198, "y1": 0.811965811965812}, {"text": "Evaluate this statement with reference to TWO prescribed texts AND texts of your own", "x0": 0.10659340659340659, "y0": 0.8142968142968143, "x1": 0.810989010989011, "y1": 0.8282828282828283}, {"text": "choosing.", "x0": 0.10659340659340659, "y0": 0.8313908313908314, "x1": 0.1835164835164835, "y1": 0.8445998445998446}], [{"text": "Question 12 \u2014 Elective 3: Navigating the Global (25 marks)", "x0": 0.1043956043956044, "y0": 0.09712509712509712, "x1": 0.6098901098901099, "y1": 0.1111111111111111}, {"text": "Compose a piece of original imaginative writing using the following statement as the start of", "x0": 0.1043956043956044, "y0": 0.12975912975912976, "x1": 0.8494505494505494, "y1": 0.14374514374514374}, {"text": "a character\u2019s reflection on an important event in his or her life.", "x0": 0.1043956043956044, "y0": 0.14685314685314685, "x1": 0.6043956043956044, "y1": 0.16006216006216006}, {"text": "Everywhere seemed the same; my choices were clear.", "x0": 0.26593406593406593, "y0": 0.1623931623931624, "x1": 0.6934065934065934, "y1": 0.17637917637917638}, {"text": "In your response, draw on your knowledge and understanding of Navigating the Global.", "x0": 0.10329670329670329, "y0": 0.17871017871017872, "x1": 0.8087912087912088, "y1": 0.19347319347319347}], [{"text": "Module C: Language and Values", "x0": 0.1076923076923077, "y0": 0.09401709401709402, "x1": 0.43626373626373627, "y1": 0.10955710955710955}, {"text": "50 marks", "x0": 0.1076923076923077, "y0": 0.11266511266511267, "x1": 0.18681318681318682, "y1": 0.12354312354312354}, {"text": "You must attempt TWO questions from the elective you have studied", "x0": 0.1076923076923077, "y0": 0.1445221445221445, "x1": 0.6978021978021978, "y1": 0.1585081585081585}, {"text": "Allow about 1 hour for each question", "x0": 0.1076923076923077, "y0": 0.17793317793317792, "x1": 0.42527472527472526, "y1": 0.19114219114219114}, {"text": "Answer each question in a SEPARATE writing booklet. Extra writing booklets are available.", "x0": 0.1076923076923077, "y0": 0.2097902097902098, "x1": 0.8527472527472527, "y1": 0.22455322455322455}, {"text": "Tn your answers you will be assessed on how well you:", "x0": 0.1076923076923077, "y0": 0.22843822843822845, "x1": 0.5461538461538461, "y1": 0.24242424242424243}, {"text": "= demonstrate understanding of the ways in which language shapes and reflects culture", "x0": 0.1087912087912088, "y0": 0.24475524475524477, "x1": 0.8021978021978022, "y1": 0.257964257964258}, {"text": "and values", "x0": 0.1076923076923077, "y0": 0.2634032634032634, "x1": 0.1934065934065934, "y1": 0.27350427350427353}, {"text": "\u00absustain an extended composition appropriate to the question, demonstrating control in", "x0": 0.1087912087912088, "y0": 0.2789432789432789, "x1": 0.8065934065934066, "y1": 0.29292929292929293}, {"text": "the use of language", "x0": 0.1076923076923077, "y0": 0.2975912975912976, "x1": 0.26373626373626374, "y1": 0.3108003108003108}, {"text": "The electives for this module are:", "x0": 0.1076923076923077, "y0": 0.3480963480963481, "x1": 0.3912087912087912, "y1": 0.358974358974359}, {"text": "Elective 1: Textual Dynamics \u2014 Attempt Questions 13 and 14", "x0": 0.1076923076923077, "y0": 0.38073038073038074, "x1": 0.6362637362637362, "y1": 0.3939393939393939}, {"text": "The prescribed texts are:", "x0": 0.1076923076923077, "y0": 0.39704739704739705, "x1": 0.3054945054945055, "y1": 0.411033411033411}, {"text": "+ Prose Fiction", "x0": 0.1087912087912088, "y0": 0.41414141414141414, "x1": 0.23406593406593407, "y1": 0.42424242424242425}, {"text": "\u2014John Fowles, The French Woman", "x0": 0.1076923076923077, "y0": 0.4296814296814297, "x1": 0.4978021978021978, "y1": 0.4428904428904429}, {"text": "\u2014Italo Calvino, Jf on a night a traveller", "x0": 0.1076923076923077, "y0": 0.445998445998446, "x1": 0.4967032967032967, "y1": 0.45998445998445997}, {"text": "\u2014 Robert Dessaix, Night Letters", "x0": 0.1076923076923077, "y0": 0.4630924630924631, "x1": 0.3626373626373626, "y1": 0.4763014763014763}, {"text": "Potter, Orlando", "x0": 0.17582417582417584, "y0": 0.49572649572649574, "x1": 0.3010989010989011, "y1": 0.5081585081585082}, {"text": "Elective 2: Language and Gender \u2014 Attempt Questions 15 and 16", "x0": 0.1087912087912088, "y0": 0.5283605283605284, "x1": 0.6725274725274726, "y1": 0.5423465423465423}, {"text": "The prescribed texts are:", "x0": 0.1087912087912088, "y0": 0.5446775446775447, "x1": 0.3054945054945055, "y1": 0.5586635586635587}, {"text": "+ Prose Fiction", "x0": 0.10989010989010989, "y0": 0.5617715617715617, "x1": 0.23406593406593407, "y1": 0.5726495726495726}, {"text": "Virginia Woolf, Orlando", "x0": 0.12417582417582418, "y0": 0.5773115773115773, "x1": 0.3252747252747253, "y1": 0.5912975912975913}, {"text": "+ Drama", "x0": 0.10989010989010989, "y0": 0.5944055944055944, "x1": 0.1813186813186813, "y1": 0.6052836052836053}, {"text": "\u2014 William Shakespeare, Twelfth Night", "x0": 0.1076923076923077, "y0": 0.60994560994561, "x1": 0.4164835164835165, "y1": 0.6239316239316239}, {"text": "+ Poetry", "x0": 0.10989010989010989, "y0": 0.6278166278166278, "x1": 0.17802197802197803, "y1": 0.6410256410256411}, {"text": "= Jobn Tranter, The Floor of Heaven", "x0": 0.1087912087912088, "y0": 0.6425796425796426, "x1": 0.4032967032967033, "y1": 0.6557886557886557}, {"text": "+ Film", "x0": 0.10989010989010989, "y0": 0.6604506604506605, "x1": 0.16043956043956045, "y1": 0.6705516705516705}, {"text": "\u2014 Shekhar Kapur, Elizabeth", "x0": 0.1087912087912088, "y0": 0.6752136752136753, "x1": 0.33076923076923076, "y1": 0.6899766899766899}], [{"text": "Question 13 \u2014 Elective 1: Textual Dynamics (25 marks)", "x0": 0.1043956043956044, "y0": 0.09634809634809635, "x1": 0.5769230769230769, "y1": 0.10955710955710955}, {"text": "In Textual Dynamics, composers play with textual forms and features in order to transform", "x0": 0.10329670329670329, "y0": 0.128982128982129, "x1": 0.8340659340659341, "y1": 0.14296814296814297}, {"text": "ideas, experience and the act of reading.", "x0": 0.1043956043956044, "y0": 0.1452991452991453, "x1": 0.42417582417582417, "y1": 0.1592851592851593}, {"text": "Evaluate this statement with reference to TWO prescribed texts AND texts of your own", "x0": 0.1043956043956044, "y0": 0.16161616161616163, "x1": 0.8076923076923077, "y1": 0.17482517482517482}, {"text": "choosing.", "x0": 0.1043956043956044, "y0": 0.17871017871017872, "x1": 0.18021978021978022, "y1": 0.1919191919191919}, {"text": "Question 14 \u2014 Elective 1: Textual Dynamics (25 marks)", "x0": 0.1043956043956044, "y0": 0.22688422688422688, "x1": 0.5769230769230769, "y1": 0.24087024087024086}, {"text": "Compose a piece of original imaginative writing using the following statement as the start of", "x0": 0.1043956043956044, "y0": 0.2564102564102564, "x1": 0.8505494505494505, "y1": 0.2773892773892774}, {"text": "a character\u2019s reflection on an important event in his or her life.", "x0": 0.1043956043956044, "y0": 0.27583527583527584, "x1": 0.6043956043956044, "y1": 0.289044289044289}, {"text": "I threw the book at him; it wasn\u2019t supposed to end that way.", "x0": 0.23956043956043957, "y0": 0.29215229215229216, "x1": 0.7197802197802198, "y1": 0.3061383061383061}, {"text": "In your response, draw on your knowledge and understanding of Textual Dynamics.", "x0": 0.1043956043956044, "y0": 0.30924630924630925, "x1": 0.7791208791208791, "y1": 0.32245532245532244}, {"text": "Question 15 \u2014 Elective 2: Language and Gender (25 marks)", "x0": 0.1054945054945055, "y0": 0.3581973581973582, "x1": 0.6142857142857143, "y1": 0.3714063714063714}, {"text": "In Language and Gender, composers play with textual forms and features in order to", "x0": 0.1043956043956044, "y0": 0.39083139083139085, "x1": 0.7813186813186813, "y1": 0.4048174048174048}, {"text": "investigate, challenge and construct aspects of identity.", "x0": 0.1054945054945055, "y0": 0.40714840714840717, "x1": 0.545054945054945, "y1": 0.4211344211344211}, {"text": "Evaluate this statement with reference to TWO prescribed texts AND texts of your own.", "x0": 0.1054945054945055, "y0": 0.4234654234654235, "x1": 0.8087912087912088, "y1": 0.43745143745143744}, {"text": "choosing.", "x0": 0.1043956043956044, "y0": 0.4405594405594406, "x1": 0.18021978021978022, "y1": 0.45376845376845376}, {"text": "Question 16 \u2014 Elective 2: Language and Gender (25 marks)", "x0": 0.1054945054945055, "y0": 0.48951048951048953, "x1": 0.6153846153846154, "y1": 0.5027195027195027}, {"text": "Compose a piece of original imaginative writing using the following statement as the start of", "x0": 0.1054945054945055, "y0": 0.5221445221445221, "x1": 0.8516483516483516, "y1": 0.5361305361305362}, {"text": "a character\u2019s reflection on an important event in his or her life.", "x0": 0.1054945054945055, "y0": 0.5384615384615384, "x1": 0.6054945054945055, "y1": 0.5516705516705517}, {"text": "I thought it would give me freedom; now I'm not so sure.", "x0": 0.25384615384615383, "y0": 0.5547785547785548, "x1": 0.7076923076923077, "y1": 0.5687645687645687}, {"text": "In your response, draw on your knowledge and understanding of Language and Gender.", "x0": 0.1054945054945055, "y0": 0.5710955710955711, "x1": 0.8087912087912088, "y1": 0.585081585081585}, {"text": "End of paper", "x0": 0.42637362637362636, "y0": 0.8181818181818182, "x1": 0.5384615384615384, "y1": 0.8306138306138307}]]