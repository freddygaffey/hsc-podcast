}, {"text": "In your response, make reference to your prescribed text.", "x0": 0.11978021978021978, "y0": 0.5306915306915307, "x1": 0.5813186813186814, "y1": 0.5439005439005439}, {"text": "The prescribed texts are listed on pages 10 and 11.", "x0": 0.11868131868131868, "y0": 0.5641025641025641, "x1": 0.5296703296703297, "y1": 0.5773115773115773}, {"text": "Please turn over", "x0": 0.42967032967032964, "y0": 0.6317016317016317, "x1": 0.5692307692307692, "y1": 0.6418026418026418}, {"text": "1032 -9-", "x0": 0.08241758241758242, "y0": 0.9440559440559441, "x1": 0.5197802197802198, "y1": 0.9549339549339549}], [{"text": "The prescribed texts for Section II are:", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.4307692307692308, "y1": 0.0947940947940948}, {"text": "+ Prose Fiction \u2014 Anthony Doerr, All the Light We Cannot See", "x0": 0.11978021978021978, "y0": 0.11499611499611499, "x1": 0.6736263736263737, "y1": 0.1282051282051282}, {"text": "\u2014 Amanda Lohrey, Vertigo", "x0": 0.2857142857142857, "y0": 0.13986013986013987, "x1": 0.510989010989011, "y1": 0.1522921522921523}, {"text": "\u2014 George Orwell, Nineteen Eighty-Four", "x0": 0.2857142857142857, "y0": 0.16317016317016317, "x1": 0.6175824175824176, "y1": 0.17560217560217561}, {"text": "\u2014 Favel Parrett, Past the Shallows", "x0": 0.2857142857142857, "y0": 0.1857031857031857, "x1": 0.567032967032967, "y1": 0.19735819735819735}, {"text": "+ Poetry \u2014 Rosemary Dobson, Rosemary Dobson Collected", "x0": 0.11978021978021978, "y0": 0.2191142191142191, "x1": 0.701098901098901, "y1": 0.23232323232323232}, {"text": "The prescribed poems are:", "x0": 0.3087912087912088, "y0": 0.2432012432012432, "x1": 0.521978021978022, "y1": 0.2556332556332556}, {"text": "* Young Girl at a Window", "x0": 0.310989010989011, "y0": 0.26573426573426573, "x1": 0.5318681318681319, "y1": 0.2789432789432789}, {"text": "* Over the Hill", "x0": 0.310989010989011, "y0": 0.2836052836052836, "x1": 0.43956043956043955, "y1": 0.29292929292929293}, {"text": "* Summer's End", "x0": 0.310989010989011, "y0": 0.29914529914529914, "x1": 0.45164835164835165, "y1": 0.30924630924630925}, {"text": "* The Conversation", "x0": 0.310989010989011, "y0": 0.31546231546231546, "x1": 0.4758241758241758, "y1": 0.32556332556332557}, {"text": "* Cock Crow", "x0": 0.310989010989011, "y0": 0.3333333333333333, "x1": 0.42417582417582417, "y1": 0.34265734265734266}, {"text": "* Amy Caroline", "x0": 0.310989010989011, "y0": 0.34887334887334887, "x1": 0.44505494505494503, "y1": 0.3620823620823621}, {"text": "* Canberra Morning", "x0": 0.310989010989011, "y0": 0.36596736596736595, "x1": 0.4868131868131868, "y1": 0.3791763791763792}, {"text": "~ Kenneth Slessor, Selected Poems", "x0": 0.2857142857142857, "y0": 0.39937839937839936, "x1": 0.578021978021978, "y1": 0.41025641025641024}, {"text": "The prescribed poems are:", "x0": 0.3087912087912088, "y0": 0.4234654234654235, "x1": 0.521978021978022, "y1": 0.4358974358974359}, {"text": "* Wild Grapes", "x0": 0.310989010989011, "y0": 0.445998445998446, "x1": 0.4351648351648352, "y1": 0.4592074592074592}, {"text": "* Gulliver", "x0": 0.310989010989011, "y0": 0.4630924630924631, "x1": 0.4010989010989011, "y1": 0.4731934731934732}, {"text": "* Out of Time", "x0": 0.310989010989011, "y0": 0.4801864801864802, "x1": 0.42967032967032964, "y1": 0.4926184926184926}, {"text": "* Vesper-Song of the Reverend Samuel Marsden", "x0": 0.310989010989011, "y0": 0.49572649572649574, "x1": 0.7098901098901099, "y1": 0.508935508935509}, {"text": "* William Street", "x0": 0.310989010989011, "y0": 0.5128205128205128, "x1": 0.44945054945054946, "y1": 0.5229215229215229}, {"text": "* Beach Burial", "x0": 0.310989010989011, "y0": 0.5299145299145299, "x1": 0.43956043956043955, "y1": 0.5392385392385393}, {"text": "+ Drama \u2014 Jane Harrison, Rainbow's End, from Vivienne Cleven et al.,", "x0": 0.11978021978021978, "y0": 0.5625485625485626, "x1": 0.7967032967032966, "y1": 0.5742035742035742}, {"text": "Contemporary Indigenous Plays", "x0": 0.3098901098901099, "y0": 0.5796425796425796, "x1": 0.5714285714285714, "y1": 0.5928515928515928}, {"text": "\u2014 Arthur Miller, The Crucible", "x0": 0.2857142857142857, "y0": 0.602952602952603, "x1": 0.5351648351648352, "y1": 0.6146076146076146}, {"text": "\u2014 William Shakespeare, The Merchant of Venice", "x0": 0.2857142857142857, "y0": 0.6262626262626263, "x1": 0.6868131868131868, "y1": 0.6394716394716394}, {"text": "Section II prescribed texts continue on page 11", "x0": 0.2978021978021978, "y0": 0.6938616938616938, "x1": 0.7, "y1": 0.7070707070707071}, {"text": "-10-", "x0": 0.4736263736263736, "y0": 0.9440559440559441, "x1": 0.5252747252747253, "y1": 0.9533799533799534}], [{"text": "Section II prescribed texts (continued)", "x0": 0.11978021978021978, "y0": 0.08158508158508158, "x1": 0.42857142857142855, "y1": 0.0947940947940948}, {"text": "+ \u2014 Tim Winton, The Boy Behind the Curtain", "x0": 0.11978021978021978, "y0": 0.11499611499611499, "x1": 0.6461538461538462, "y1": 0.1282051282051282}, {"text": "The prescribed chapters are:", "x0": 0.3087912087912088, "y0": 0.13986013986013987, "x1": 0.5362637362637362, "y1": 0.1522921522921523}, {"text": "* Havoc: A Life in Accidents", "x0": 0.310989010989011, "y0": 0.1623931623931624, "x1": 0.5516483516483517, "y1": 0.17560217560217561}, {"text": "* Betsy", "x0": 0.310989010989011, "y0": 0.1794871794871795, "x1": 0.3758241758241758, "y1": 0.1919191919191919}, {"text": "* Twice on Sundays", "x0": 0.310989010989011, "y0": 0.1958041958041958, "x1": 0.47912087912087914, "y1": 0.2066822066822067}, {"text": "* The Wait and the Flow", "x0": 0.310989010989011, "y0": 0.21212121212121213, "x1": 0.5186813186813187, "y1": 0.2222222222222222}, {"text": "* In the Shadow of the Hospital", "x0": 0.310989010989011, "y0": 0.22843822843822845, "x1": 0.5747252747252747, "y1": 0.24164724164724163}, {"text": "* The Demon Shark", "x0": 0.310989010989011, "y0": 0.24553224553224554, "x1": 0.47912087912087914, "y1": 0.2556332556332556}, {"text": "* Barefoot in the Temple of Art", "x0": 0.310989010989011, "y0": 0.26262626262626265, "x1": 0.5725274725274725, "y1": 0.27505827505827507}, {"text": "\u2014 Malala Yousafzai and Christina Lamb, J am Malala", "x0": 0.2857142857142857, "y0": 0.29526029526029524, "x1": 0.7296703296703296, "y1": 0.30691530691530694}, {"text": "+ Film \u2014 Stephen Daldry, Billy Elliot", "x0": 0.11978021978021978, "y0": 0.32944832944832947, "x1": 0.5340659340659341, "y1": 0.34265734265734266}, {"text": "+ Media \u2014 Ivan Go Back to Where You Came From", "x0": 0.11978021978021978, "y0": 0.3628593628593629, "x1": 0.7472527472527473, "y1": 0.372960372960373}, {"text": "The prescribed episodes are:", "x0": 0.3087912087912088, "y0": 0.38694638694638694, "x1": 0.5384615384615384, "y1": 0.39937839937839936}, {"text": "* Series 1: Episodes 1, 2 and 3", "x0": 0.310989010989011, "y0": 0.4094794094794095, "x1": 0.5703296703296703, "y1": 0.4226884226884227}, {"text": "and", "x0": 0.33406593406593404, "y0": 0.4296814296814297, "x1": 0.36153846153846153, "y1": 0.4397824397824398}, {"text": "* The Response", "x0": 0.310989010989011, "y0": 0.4491064491064491, "x1": 0.44395604395604393, "y1": 0.46231546231546233}, {"text": "\u2014 Lucy Walker, Waste Land", "x0": 0.2857142857142857, "y0": 0.4840714840714841, "x1": 0.5230769230769231, "y1": 0.4965034965034965}, {"text": "End of paper", "x0": 0.44285714285714284, "y0": 0.5501165501165501, "x1": 0.5560439560439561, "y1": 0.5633255633255633}], [{"text": "BLANK PAGE", "x0": 0.43626373626373627, "y0": 0.3543123543123543, "x1": 0.5626373626373626, "y1": 0.3644133644133644}, {"text": "(\u00a9 2021 NSW Edueation Standards Authority", "x0": 0.3824175824175824, "y0": 0.9673659673659674, "x1": 0.6164835164835165, "y1": 0.9751359751359752}], [{"text": "GOVERNMENT", "x0": 0.12197802197802197, "y0": 0.1592851592851593, "x1": 0.22527472527472528, "y1": 0.16705516705516704}, {"text": "NSW Education Standards Authority", "x0": 0.11978021978021978, "y0": 0.19114219114219114, "x1": 0.4725274725274725, "y1": 0.20512820512820512}, {"text": "2021 | HIGHER SCHOOL CERTIFICATE EXAMINATION", "x0": 0.12747252747252746, "y0": 0.30691530691530694, "x1": 0.5857142857142857, "y1": 0.331002331002331}, {"text": "English Standard", "x0": 0.12307692307692308, "y0": 0.38694638694638694, "x1": 0.5263736263736264, "y1": 0.4226884226884227}, {"text": "Paper 1 \u2014 Texts and Human Experiences", "x0": 0.12197802197802197, "y0": 0.4568764568764569, "x1": 0.8252747252747252, "y1": 0.48174048174048173}, {"text": "Stimulus Booklet", "x0": 0.11978021978021978, "y0": 0.5182595182595182, "x1": 0.3901098901098901, "y1": 0.5384615384615384}, {"text": "Page", "x0": 0.8351648351648352, "y0": 0.5843045843045843, "x1": 0.8791208791208791, "y1": 0.5975135975135976}, {"text": "Section] + Text 1 \u2014 Feature article extract 2", "x0": 0.11868131868131868, "y0": 0.6130536130536131, "x1": 0.8791208791208791, "y1": 0.6285936285936286}, {"text": "+ Text 2 \u2014 Prose fiction extract 3", "x0": 0.2681318681318681, "y0": 0.6534576534576535, "x1": 0.8791208791208791, "y1": 0.6635586635586636}, {"text": "+ Text 3 \u2014 Nonfiction extract 4", "x0": 0.2681318681318681, "y0": 0.6876456876456877, "x1": 0.8791208791208791, "y1": 0.6977466977466977}, {"text": "+ Text 4 \u2014 5", "x0": 0.2681318681318681, "y0": 0.7226107226107226, "x1": 0.8791208791208791, "y1": 0.7327117327117327}, {"text": "+ Text 5 \u2014 Prose fiction extract 6", "x0": 0.2681318681318681, "y0": 0.7567987567987567, "x1": 0.8791208791208791, "y1": 0.7668997668997669}, {"text": "1033", "x0": 0.08241758241758242, "y0": 0.9463869463869464, "x1": 0.11758241758241758, "y1": 0.9549339549339549}], [{"text": "Text 1 \u2014 Feature article extract", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.3989010989010989, "y1": 0.09246309246309246}, {"text": "This article can be viewed at", "x0": 0.37032967032967035, "y0": 0.8601398601398601, "x1": 0.5406593406593406, "y1": 0.8679098679098679}], [{"text": "Text 2 \u2014 Prose fiction extract", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.3791208791208791, "y1": 0.09168609168609168}, {"text": "A brilliant day up the coast.", "x0": 0.11538461538461539, "y0": 0.1258741258741259, "x1": 0.42857142857142855, "y1": 0.1452991452991453}, {"text": "Fresh eyes scoped the entirety of the ocean. Home to one too many a beach memory. Nine-", "x0": 0.11978021978021978, "y0": 0.1554001554001554, "x1": 0.8791208791208791, "y1": 0.1686091686091686}, {"text": "year-old me yearned for that salty tang of the sea breeze. I watched as my younger brother", "x0": 0.11978021978021978, "y0": 0.17249417249417248, "x1": 0.8802197802197802, "y1": 0.1857031857031857}, {"text": "David clambered out of the car. We did most things together. Wearing colourful bathers, we", "x0": 0.11978021978021978, "y0": 0.1888111888111888, "x1": 0.8791208791208791, "y1": 0.20202020202020202}, {"text": "raced to an empty shade-cloth area as Mum yelled, \u2018Quick! Before we lose it!\u201d as a line of cars", "x0": 0.11978021978021978, "y0": 0.1989121989121989, "x1": 0.8791208791208791, "y1": 0.2222222222222222}, {"text": "pulled up a distance away. We anchored ourselves in cool sand and waited for Mum and Dad", "x0": 0.11978021978021978, "y0": 0.2222222222222222, "x1": 0.8791208791208791, "y1": 0.23543123543123542}, {"text": "to come.", "x0": 0.11978021978021978, "y0": 0.24164724164724163, "x1": 0.18681318681318682, "y1": 0.2494172494172494}, {"text": "Fiddling with broken sticks, a crab scuttled past. A teeny one. Its home inches away from my", "x0": 0.11978021978021978, "y0": 0.26573426573426573, "x1": 0.8791208791208791, "y1": 0.2789432789432789}, {"text": "feet. Curiosity got the best of me, I moved closer. David straightened up.", "x0": 0.11978021978021978, "y0": 0.2828282828282828, "x1": 0.710989010989011, "y1": 0.29603729603729606}, {"text": "\u201cWhere\u2019re you goin\u2019?\u201d", "x0": 0.12087912087912088, "y0": 0.30924630924630925, "x1": 0.2989010989010989, "y1": 0.32245532245532244}, {"text": "\u2018Nowhere!\u2019 I said.", "x0": 0.12087912087912088, "y0": 0.3356643356643357, "x1": 0.26703296703296703, "y1": 0.3457653457653458}, {"text": "I shuffled closer to the hole, hoping to hide the entrance from him. David had a thing for", "x0": 0.11978021978021978, "y0": 0.3628593628593629, "x1": 0.8802197802197802, "y1": 0.37606837606837606}, {"text": "crawling things. Lizards, insects, little mice ... if it had four or more legs, David found it like", "x0": 0.11868131868131868, "y0": 0.3791763791763792, "x1": 0.8791208791208791, "y1": 0.3923853923853924}, {"text": "hens to grain.", "x0": 0.11978021978021978, "y0": 0.39704739704739705, "x1": 0.22747252747252747, "y1": 0.4094794094794095}, {"text": "The crashing of waves along the rocky coastline shifted my train of thought. Not far from", "x0": 0.11868131868131868, "y0": 0.4226884226884227, "x1": 0.8791208791208791, "y1": 0.4358974358974359}, {"text": "where we were situated were the Blowholes: a mysterious spot where danger and beauty are", "x0": 0.11978021978021978, "y0": 0.4397824397824398, "x1": 0.8791208791208791, "y1": 0.452991452991453}, {"text": "one and the same. As if she had read my mind, Mum announces we're off for a walk over there.", "x0": 0.11868131868131868, "y0": 0.4560994560994561, "x1": 0.8791208791208791, "y1": 0.4693084693084693}, {"text": "Talways enjoyed the spectacle of it. The big whooshing of the water as it rushed up from below,", "x0": 0.11978021978021978, "y0": 0.4731934731934732, "x1": 0.8791208791208791, "y1": 0.4864024864024864}, {"text": "as if some supernatural force was behind it. The build-up of sticky tension from the anticipation.", "x0": 0.11978021978021978, "y0": 0.48951048951048953, "x1": 0.8802197802197802, "y1": 0.5027195027195027}, {"text": "of something magnificent about to unfold, followed by the explosion of a million insignificant", "x0": 0.11868131868131868, "y0": 0.5066045066045066, "x1": 0.8791208791208791, "y1": 0.5198135198135199}, {"text": "splashes. This was something that was witnessed from a distance.", "x0": 0.11978021978021978, "y0": 0.5229215229215229, "x1": 0.6505494505494506, "y1": 0.5361305361305362}, {"text": "\u2018As we made our way cautiously over to the cliff\u2019s edge, I sensed my brother\u2019s hesitance. His", "x0": 0.11978021978021978, "y0": 0.5493395493395493, "x1": 0.8791208791208791, "y1": 0.5625485625485626}, {"text": "face was a mixture of stifled fear and pure excitement.", "x0": 0.11978021978021978, "y0": 0.5664335664335665, "x1": 0.5604395604395604, "y1": 0.5796425796425796}, {"text": "\u201cAre we reeeally gonna go right up?\u201d David says.", "x0": 0.12087912087912088, "y0": 0.5928515928515928, "x1": 0.5186813186813187, "y1": 0.6060606060606061}, {"text": "\u201cYeah, we are.\u201d I say back. \u2018Even better! Let\u2019s see who can stay right up at the edge for the", "x0": 0.12087912087912088, "y0": 0.62004662004662, "x1": 0.8791208791208791, "y1": 0.6332556332556333}, {"text": "Having known seven-year-old David, the opportunity was a given. The phrase Wouldn\u2019t miss it", "x0": 0.11978021978021978, "y0": 0.6635586635586636, "x1": 0.8802197802197802, "y1": 0.6767676767676768}, {"text": "for the world in capital letters could\u2019 ve been a flashing neon sign on his forehead at that given", "x0": 0.11538461538461539, "y0": 0.6767676767676768, "x1": 0.8791208791208791, "y1": 0.6961926961926962}, {"text": "moment. And we were off.", "x0": 0.11978021978021978, "y0": 0.696969696969697, "x1": 0.3362637362637363, "y1": 0.7070707070707071}, {"text": "Rumbling from deep below, the feeling of promised unease filled us from the toes up. The", "x0": 0.11978021978021978, "y0": 0.7233877233877234, "x1": 0.8791208791208791, "y1": 0.7365967365967366}, {"text": "feeling was similar to the monster underneath your bed \u2014 the unknown consuming you much", "x0": 0.11978021978021978, "y0": 0.7397047397047397, "x1": 0.8791208791208791, "y1": 0.752913752913753}, {"text": "more than the risk of physical harm. We both stood side by side like dolls in the shopfront,", "x0": 0.11978021978021978, "y0": 0.7567987567987567, "x1": 0.8791208791208791, "y1": 0.77000777000777}, {"text": "out for display ... The air shifted, and a niggling thought crossed my mind. As I looked down,", "x0": 0.11868131868131868, "y0": 0.7731157731157731, "x1": 0.8791208791208791, "y1": 0.7863247863247863}, {"text": "there was no water.", "x0": 0.11978021978021978, "y0": 0.790986790986791, "x1": 0.27582417582417584, "y1": 0.8003108003108003}, {"text": "I could see a teeny crab, wedged between two crevices. It was so similar to the one back on", "x0": 0.11978021978021978, "y0": 0.8166278166278166, "x1": 0.8791208791208791, "y1": 0.8298368298368298}, {"text": "the beach.", "x0": 0.11978021978021978, "y0": 0.8344988344988346, "x1": 0.2, "y1": 0.8438228438228438}, {"text": "I known better than to stand that close ... It was too close.", "x0": 0.11978021978021978, "y0": 0.8609168609168609, "x1": 0.676923076923077, "y1": 0.8702408702408703}, {"text": "Nancy MurRRAY", "x0": 0.7472527472527473, "y0": 0.8881118881118881, "x1": 0.8791208791208791, "y1": 0.8974358974358975}, {"text": "Extract from Coast", "x0": 0.7252747252747253, "y0": 0.9036519036519036, "x1": 0.8802197802197802, "y1": 0.9137529137529138}, {"text": "Reproduced with permission from Magabala Books", "x0": 0.5758241758241758, "y0": 0.9230769230769231, "x1": 0.8791208791208791, "y1": 0.9324009324009324}], [{"text": "Text 3 \u2014 Nonfiction extract", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.36153846153846153, "y1": 0.09168609168609168}, {"text": "New books find their way to us via a number of routes. Most obvious is", "x0": 0.1912087912087912, "y0": 0.12665112665112666, "x1": 0.8076923076923077, "y1": 0.13986013986013987}, {"text": "bricks-and-mortar store browsing. There we are, in a shop, reading the", "x0": 0.1901098901098901, "y0": 0.14374514374514374, "x1": 0.8076923076923077, "y1": 0.15695415695415696}, {"text": "back cover, brushing fingers over embossed titles, handling and patting,", "x0": 0.1901098901098901, "y0": 0.16006216006216006, "x1": 0.8076923076923077, "y1": 0.17327117327117328}, {"text": "appreciating the book as an object. We can tickle spines and open up to brush", "x0": 0.1912087912087912, "y0": 0.17715617715617715, "x1": 0.8076923076923077, "y1": 0.19036519036519037}, {"text": "pages, and \u2014 if no one\u2019s looking \u2014 devour their smell. If everything chimes", "x0": 0.1901098901098901, "y0": 0.19347319347319347, "x1": 0.8076923076923077, "y1": 0.2066822066822067}, {"text": "then the book is placed in a wrestler\u2019s headlock, claimed as a joey kangaroo", "x0": 0.1912087912087912, "y0": 0.21056721056721056, "x1": 0.8076923076923077, "y1": 0.22377622377622378}, {"text": "in its mother\u2019s pouch. Chances are that it will soon have siblings \u2014 our eyes", "x0": 0.1912087912087912, "y0": 0.22688422688422688, "x1": 0.8076923076923077, "y1": 0.2400932400932401}, {"text": "are bigger than our bedside tables.", "x0": 0.1912087912087912, "y0": 0.24397824397824397, "x1": 0.46813186813186813, "y1": 0.2571872571872572}, {"text": "Or perhaps a new book may be fostered from a library or foisted* upon you", "x0": 0.1912087912087912, "y0": 0.27195027195027194, "x1": 0.8076923076923077, "y1": 0.2851592851592852}, {"text": "by a friend who insists you will appreciate it. On the way home, blurbs are", "x0": 0.1901098901098901, "y0": 0.289044289044289, "x1": 0.8076923076923077, "y1": 0.30225330225330227}, {"text": "again consumed, and other furnishings idly absorbed \u2014 the review quote and", "x0": 0.1912087912087912, "y0": 0.30536130536130535, "x1": 0.8076923076923077, "y1": 0.3185703185703186}, {"text": "the About the Author, the writer dedication and the font declaration.", "x0": 0.1912087912087912, "y0": 0.32245532245532244, "x1": 0.7428571428571429, "y1": 0.3341103341103341}, {"text": "Then there is that saintly thud of an online order plummeting from the", "x0": 0.1901098901098901, "y0": 0.3504273504273504, "x1": 0.8076923076923077, "y1": 0.36363636363636365}, {"text": "letterbox, or the luscious scrape of cardboard on floor as, on returning home,", "x0": 0.1912087912087912, "y0": 0.36752136752136755, "x1": 0.8076923076923077, "y1": 0.38073038073038074}, {"text": "you push the front door against the package. To buy online leaves you blind", "x0": 0.1912087912087912, "y0": 0.3838383838383838, "x1": 0.8076923076923077, "y1": 0.39704739704739705}, {"text": "in comparison with bookshop scrutiny, but the gamble is surely worth the", "x0": 0.1912087912087912, "y0": 0.40093240093240096, "x1": 0.8076923076923077, "y1": 0.41414141414141414}, {"text": "prize of feverishly setting about unwrapping the parcel. We are Charlie", "x0": 0.1901098901098901, "y0": 0.4172494172494173, "x1": 0.8076923076923077, "y1": 0.43045843045843046}, {"text": "Bucket unwrapping a Wonka Bar, and there is a golden-ticket feeling every", "x0": 0.1912087912087912, "y0": 0.43356643356643354, "x1": 0.8076923076923077, "y1": 0.4467754467754468}, {"text": "time.", "x0": 0.1912087912087912, "y0": 0.452991452991453, "x1": 0.22967032967032966, "y1": 0.46076146076146074}, {"text": "By whichever route a book finds us, in our hands we now hold, we hope, a", "x0": 0.1912087912087912, "y0": 0.47863247863247865, "x1": 0.8087912087912088, "y1": 0.49184149184149184}, {"text": "future escape.", "x0": 0.1912087912087912, "y0": 0.49572649572649574, "x1": 0.3010989010989011, "y1": 0.508935508935509}, {"text": "DANIEL GRAY", "x0": 0.6978021978021978, "y0": 0.5244755244755245, "x1": 0.8076923076923077, "y1": 0.5345765345765345}, {"text": "Extract from Scribbles in the Margin", "x0": 0.5087912087912088, "y0": 0.5407925407925408, "x1": 0.8076923076923077, "y1": 0.554001554001554}, {"text": "\u00a9 Daniel Gray, 2017, Scribbles in the Margins: 50 Eternal Delights of Books,", "x0": 0.35384615384615387, "y0": 0.5594405594405595, "x1": 0.8032967032967033, "y1": 0.5687645687645687}, {"text": "Bloomsbury Publishing Plc", "x0": 0.6483516483516484, "y0": 0.5710955710955711, "x1": 0.8065934065934066, "y1": 0.5804195804195804}, {"text": "* foisted imposed", "x0": 0.1912087912087912, "y0": 0.5959595959595959, "x1": 0.3648351648351648, "y1": 0.6060606060606061}], [{"text": "Text 4 \u2014 Poem", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.25164835164835164, "y1": 0.09168609168609168}, {"text": "For B, at Plaza Blanca, New Mexico*,", "x0": 0.16483516483516483, "y0": 0.128982128982129, "x1": 0.545054945054945, "y1": 0.14374514374514374}, {"text": "having known each other three days.", "x0": 0.21208791208791208, "y0": 0.14840714840714841, "x1": 0.5813186813186814, "y1": 0.16394716394716394}, {"text": "Here, you said, this is a piece of quartz.", "x0": 0.16373626373626374, "y0": 0.18414918414918416, "x1": 0.4835164835164835, "y1": 0.19735819735819735}, {"text": "Take it, and close your hand around it.", "x0": 0.16483516483516483, "y0": 0.20202020202020202, "x1": 0.47912087912087914, "y1": 0.21522921522921523}, {"text": "The rock was heavy for something so small. Its rough", "x0": 0.16373626373626374, "y0": 0.23620823620823622, "x1": 0.6010989010989011, "y1": 0.2494172494172494}, {"text": "edges pressed my outline, changed my shape in a small way.", "x0": 0.16483516483516483, "y0": 0.2533022533022533, "x1": 0.656043956043956, "y1": 0.2665112665112665}, {"text": "I turned it over. I closed my hand around it.", "x0": 0.16483516483516483, "y0": 0.2874902874902875, "x1": 0.5175824175824176, "y1": 0.3006993006993007}, {"text": "The rock made me think of difficult work", "x0": 0.16373626373626374, "y0": 0.3014763014763015, "x1": 0.5021978021978022, "y1": 0.3209013209013209}, {"text": "like lowering yourself into a bath. The quartz made me think", "x0": 0.16483516483516483, "y0": 0.3395493395493395, "x1": 0.6582417582417582, "y1": 0.35275835275835277}, {"text": "of the enormous past, a vast plateau, on which the present moment holds still\u2014", "x0": 0.16483516483516483, "y0": 0.35664335664335667, "x1": 0.810989010989011, "y1": 0.36985236985236986}, {"text": "full and complete. I looked around. We were wrapped in the loose embrace", "x0": 0.16483516483516483, "y0": 0.39083139083139085, "x1": 0.7758241758241758, "y1": 0.40404040404040403}, {"text": "of the ground, and the bare trees, and the low-slung clouds. The rock", "x0": 0.16483516483516483, "y0": 0.40792540792540793, "x1": 0.7241758241758242, "y1": 0.4211344211344211}, {"text": "is ancient. The white formations of Plaza Blanca are ancient, as sleep is ancient\u2014", "x0": 0.16483516483516483, "y0": 0.4428904428904429, "x1": 0.832967032967033, "y1": 0.4560994560994561}, {"text": "and our young lives are winks in a deep night, wrinkles", "x0": 0.16483516483516483, "y0": 0.45998445998445997, "x1": 0.6142857142857143, "y1": 0.4731934731934732}, {"text": "on a long green sea. The sea is more alien than the moon to that white place. You", "x0": 0.16483516483516483, "y0": 0.49417249417249415, "x1": 0.8263736263736263, "y1": 0.5073815073815073}, {"text": "smiled. You smiled as if to say we are two odd birds, aren't we", "x0": 0.16483516483516483, "y0": 0.5112665112665112, "x1": 0.6714285714285714, "y1": 0.5244755244755245}, {"text": "Tunclosed my hand", "x0": 0.16483516483516483, "y0": 0.5462315462315462, "x1": 0.3230769230769231, "y1": 0.5594405594405595}, {"text": "and the quartz bloomed there\u2014", "x0": 0.16483516483516483, "y0": 0.5641025641025641, "x1": 0.4208791208791209, "y1": 0.5765345765345765}, {"text": "CHARLOTTE GUEST", "x0": 0.6846153846153846, "y0": 0.5982905982905983, "x1": 0.8351648351648352, "y1": 0.6076146076146076}, {"text": "With kind permission of Charlotte Guest / AP Anthology", "x0": 0.5043956043956044, "y0": 0.6184926184926185, "x1": 0.8340659340659341, "y1": 0.6278166278166278}, {"text": "* Plaza Blanca, New Mexico \u2018Plaza Blanca\u2019 translates from the Spanish as \u2018the white place", "x0": 0.16483516483516483, "y0": 0.6472416472416472, "x1": 0.8131868131868132, "y1": 0.6573426573426573}, {"text": "It isa region that is famous for large white limestone formations.", "x0": 0.3901098901098901, "y0": 0.6612276612276612, "x1": 0.8285714285714286, "y1": 0.6713286713286714}], [{"text": "Text 5 \u2014 Prose fiction extract", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.3791208791208791, "y1": 0.09168609168609168}, {"text": "With Lan, one of my tasks was to take a pair of tweezers and pluck, one by", "x0": 0.1901098901098901, "y0": 0.12665112665112666, "x1": 0.8076923076923077, "y1": 0.13986013986013987}, {"text": "\u2018one, the grey hairs from her head. \u201cThe snow in my hair,\u201d she explained, \u201cit", "x0": 0.1901098901098901, "y0": 0.14374514374514374, "x1": 0.8087912087912088, "y1": 0.15695415695415696}, {"text": "makes my head itch. Will you pluck my itchy hairs, Little Dog? The snow", "x0": 0.1912087912087912, "y0": 0.16006216006216006, "x1": 0.8076923076923077, "y1": 0.17327117327117328}, {"text": "is rooting into me.\u201d She slid a pair of tweezers between my fingers, \u201cMake", "x0": 0.1912087912087912, "y0": 0.17715617715617715, "x1": 0.8076923076923077, "y1": 0.19036519036519037}, {"text": "Grandma young today, okay?\u201d she said real quiet, grinning.", "x0": 0.1912087912087912, "y0": 0.19347319347319347, "x1": 0.6736263736263737, "y1": 0.2066822066822067}, {"text": "For this work I was paid in stories. After positioning her head under the", "x0": 0.1912087912087912, "y0": 0.2222222222222222, "x1": 0.8076923076923077, "y1": 0.23543123543123542}, {"text": "window\u2019s light, I would kneel on a pillow behind her, the tweezers ready", "x0": 0.1912087912087912, "y0": 0.23853923853923853, "x1": 0.8076923076923077, "y1": 0.2517482517482518}, {"text": "in my grip. She would start to talk, her tone dropping an octave, drifting", "x0": 0.1912087912087912, "y0": 0.2556332556332556, "x1": 0.8076923076923077, "y1": 0.26884226884226886}, {"text": "deep into a narrative. Mostly, as was her way, she rambled, the tales cycling", "x0": 0.1901098901098901, "y0": 0.2727272727272727, "x1": 0.8076923076923077, "y1": 0.2851592851592852}, {"text": "one after another. They spiraled out from her mind only to return the next", "x0": 0.1901098901098901, "y0": 0.289044289044289, "x1": 0.8087912087912088, "y1": 0.30225330225330227}, {"text": "week with the same introduction: \u201cNow this one, Little Dog, this one will", "x0": 0.1912087912087912, "y0": 0.30536130536130535, "x1": 0.8076923076923077, "y1": 0.3185703185703186}, {"text": "really take you out. You ready? Are you even interested in what I\u2019m saying?", "x0": 0.1901098901098901, "y0": 0.32323232323232326, "x1": 0.8076923076923077, "y1": 0.3356643356643357}, {"text": "Good. Because I never lie.\u201d A familiar story would follow, punctuated with", "x0": 0.1912087912087912, "y0": 0.33877233877233875, "x1": 0.8076923076923077, "y1": 0.351981351981352}, {"text": "the same dramatic pauses and inflections during moments of suspense or", "x0": 0.1912087912087912, "y0": 0.3550893550893551, "x1": 0.8087912087912088, "y1": 0.3682983682983683}, {"text": "crucial turns. I'd mouth along with the sentences, as if watching a film for", "x0": 0.1901098901098901, "y0": 0.37218337218337216, "x1": 0.8087912087912088, "y1": 0.3853923853923854}, {"text": "the umpteenth time\u2014a movie made by Lan\u2019s words and animated by my", "x0": 0.1912087912087912, "y0": 0.3885003885003885, "x1": 0.8076923076923077, "y1": 0.4017094017094017}, {"text": "imagination. In this way, we collaborated.", "x0": 0.1912087912087912, "y0": 0.40559440559440557, "x1": 0.5307692307692308, "y1": 0.4188034188034188}, {"text": "As I plucked, the blank walls around us did not so much fill with fantastical", "x0": 0.1912087912087912, "y0": 0.43356643356643354, "x1": 0.8076923076923077, "y1": 0.4467754467754468}, {"text": "landscapes as open into them, the plaster disintegrating to reveal the past", "x0": 0.1912087912087912, "y0": 0.4506604506604507, "x1": 0.8087912087912088, "y1": 0.46386946386946387}, {"text": "behind it. Scenes from the war, mythologies of manlike monkeys, of ancient", "x0": 0.1901098901098901, "y0": 0.466977466977467, "x1": 0.8087912087912088, "y1": 0.4801864801864802}, {"text": "ghost catchers from the hills of Da Lat* who were paid in jugs of rice wine,", "x0": 0.1912087912087912, "y0": 0.4840714840714841, "x1": 0.8076923076923077, "y1": 0.4972804972804973}, {"text": "who traveled through villages with packs of wild dogs and spells written on", "x0": 0.1912087912087912, "y0": 0.5003885003885004, "x1": 0.8076923076923077, "y1": 0.5135975135975136}, {"text": "palm leaves to dispel evil spirits.", "x0": 0.1901098901098901, "y0": 0.5174825174825175, "x1": 0.45494505494505494, "y1": 0.5306915306915307}, {"text": "VuonG", "x0": 0.7516483516483516, "y0": 0.5462315462315462, "x1": 0.8076923076923077, "y1": 0.5555555555555556}, {"text": "Extract from On Earth We're Briefly Gorgeous", "x0": 0.42527472527472526, "y0": 0.5625485625485626, "x1": 0.8087912087912088, "y1": 0.5757575757575758}, {"text": "Reproduced with permission from Penguin Random House, UK", "x0": 0.4318681318681319, "y0": 0.5827505827505828, "x1": 0.8065934065934066, "y1": 0.5920745920745921}, {"text": "*DaLat a city in Vietnam", "x0": 0.1912087912087912, "y0": 0.6177156177156177, "x1": 0.421978021978022, "y1": 0.6254856254856255}], [{"text": "BLANK PAGE", "x0": 0.43626373626373627, "y0": 0.3550893550893551, "x1": 0.5626373626373626, "y1": 0.3644133644133644}], [{"text": "BLANK PAGE", "x0": 0.43626373626373627, "y0": 0.3543123543123543, "x1": 0.5626373626373626, "y1": 0.3644133644133644}, {"text": "(\u00a9 2021 NSW Edueation Standards Authority", "x0": 0.3824175824175824, "y0": 0.9673659673659674, "x1": 0.6164835164835165, "y1": 0.9751359751359752}]]