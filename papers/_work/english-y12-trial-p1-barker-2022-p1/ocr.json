[[{"text": "Barker", "x0": 0.21122112211221122, "y0": 0.13286713286713286, "x1": 0.38943894389438943, "y1": 0.1655011655011655}, {"text": "Wes College", "x0": 0.10121012101210121, "y0": 0.1655011655011655, "x1": 0.29262926292629265, "y1": 0.19347319347319347}, {"text": "TRIAL", "x0": 0.23872387238723872, "y0": 0.22999222999222999, "x1": 0.30583058305830585, "y1": 0.24242424242424243}, {"text": "HIGHER SCHOOL", "x0": 0.31353135313531355, "y0": 0.22999222999222999, "x1": 0.5093509350935094, "y1": 0.2432012432012432}, {"text": "2022", "x0": 0.1111111111111111, "y0": 0.23465423465423466, "x1": 0.20572057205720573, "y1": 0.2571872571872572}, {"text": "CERTIFICATE EXAMINATION", "x0": 0.23982398239823982, "y0": 0.24864024864024864, "x1": 0.55995599559956, "y1": 0.2618492618492618}, {"text": "English Advanced", "x0": 0.1001100110011001, "y0": 0.30691530691530694, "x1": 0.5896589658965896, "y1": 0.34887334887334887}, {"text": "Paper 1 \u2014 Texts and Human Experiences", "x0": 0.09790979097909791, "y0": 0.3885003885003885, "x1": 0.847084708470847, "y1": 0.4156954156954157}, {"text": "Stimulus Booklet for Section | and", "x0": 0.0968096809680968, "y0": 0.4825174825174825, "x1": 0.7216721672167217, "y1": 0.5050505050505051}, {"text": "List of prescribed texts for Section II", "x0": 0.09790979097909791, "y0": 0.5299145299145299, "x1": 0.7568756875687569, "y1": 0.5578865578865578}, {"text": "Pages", "x0": 0.8679867986798679, "y0": 0.5757575757575758, "x1": 0.922992299229923, "y1": 0.5889665889665889}, {"text": "Text 1 -", "x0": 0.23872387238723872, "y0": 0.6045066045066045, "x1": 0.30583058305830585, "y1": 0.6146076146076146}, {"text": "Non-fiction . 2", "x0": 0.3124312431243124, "y0": 0.6045066045066045, "x1": 0.900990099009901, "y1": 0.6146076146076146}, {"text": "\u00ab", "x0": 0.19141914191419143, "y0": 0.6083916083916084, "x1": 0.19911991199119913, "y1": 0.6130536130536131}, {"text": "Poem... 3", "x0": 0.3124312431243124, "y0": 0.6301476301476302, "x1": 0.900990099009901, "y1": 0.6511266511266511}, {"text": "Text 2 -", "x0": 0.23872387238723872, "y0": 0.6332556332556333, "x1": 0.30583058305830585, "y1": 0.6433566433566433}, {"text": "Text 3 -", "x0": 0.23872387238723872, "y0": 0.6612276612276612, "x1": 0.30583058305830585, "y1": 0.6713286713286714}, {"text": "Prose Fiction ... 4", "x0": 0.3124312431243124, "y0": 0.6612276612276612, "x1": 0.900990099009901, "y1": 0.6713286713286714}, {"text": "Non-fiction 5", "x0": 0.3124312431243124, "y0": 0.6868686868686869, "x1": 0.900990099009901, "y1": 0.7078477078477079}, {"text": "Text 4 -", "x0": 0.23872387238723872, "y0": 0.6899766899766899, "x1": 0.30583058305830585, "y1": 0.7000777000777001}, {"text": "Text 5 -", "x0": 0.23872387238723872, "y0": 0.7187257187257188, "x1": 0.30583058305830585, "y1": 0.7288267288267288}, {"text": "Prose fiction .... 6", "x0": 0.3124312431243124, "y0": 0.7187257187257188, "x1": 0.900990099009901, "y1": 0.7288267288267288}, {"text": "Section Il \u00ab", "x0": 0.07590759075907591, "y0": 0.7801087801087802, "x1": 0.19911991199119913, "y1": 0.7917637917637917}, {"text": "List of prescribed texts", "x0": 0.23982398239823982, "y0": 0.7816627816627817, "x1": 0.4389438943894389, "y1": 0.7948717948717948}, {"text": "7-8", "x0": 0.8811881188118812, "y0": 0.7816627816627817, "x1": 0.9086908690869087, "y1": 0.7917637917637917}], [{"text": "Section I", "x0": 0.09570957095709572, "y0": 0.07148407148407149, "x1": 0.18371837183718373, "y1": 0.08313908313908314}, {"text": "Text 1 \u2014 Non-Fiction Extract", "x0": 0.09570957095709572, "y0": 0.10955710955710955, "x1": 0.39603960396039606, "y1": 0.12121212121212122}, {"text": "Mr Eternity: The Story of Arthur Stace by Roy Williams and Elizabeth Meyers", "x0": 0.09460946094609461, "y0": 0.15151515151515152, "x1": 0.7612761276127613, "y1": 0.16472416472416473}, {"text": "As night fell on 31 December 1999, 5 million Sydneysiders looked forward to hours of splendid", "x0": 0.09570957095709572, "y0": 0.18414918414918416, "x1": 0.8701870187018702, "y1": 0.19735819735819735}, {"text": "celebration. It was the eve of the 21st century; the eve of the third Millennium. A feast of live", "x0": 0.09570957095709572, "y0": 0.20590520590520592, "x1": 0.8492849284928493, "y1": 0.22533022533022534}, {"text": "entertainment was planned, much of it on Sydney\u2019s majestic, incomparable harbour. Countless", "x0": 0.09570957095709572, "y0": 0.2338772338772339, "x1": 0.858085808580858, "y1": 0.24708624708624707}, {"text": "lights sparkled and shone in many colours of the rainbow; the water rippled; stars of the Australian", "x0": 0.09570957095709572, "y0": 0.25097125097125095, "x1": 0.8921892189218922, "y1": 0.27583527583527584}, {"text": "music industry performed at Harborside venues. The highlight was a performance in the Opera", "x0": 0.09570957095709572, "y0": 0.2828282828282828, "x1": 0.8602860286028603, "y1": 0.29603729603729606}, {"text": "House forecourt of Icehouse\u2019s clas:", "x0": 0.09570957095709572, "y0": 0.30691530691530694, "x1": 0.37403740374037403, "y1": 0.317016317016317}, {"text": "\u2018ic song \u2018Great Southern Land\u2019. It was reworked and expanded", "x0": 0.38393839383938394, "y0": 0.3076923076923077, "x1": 0.8844884488448845, "y1": 0.3201243201243201}, {"text": "for the o al 25-minute work, \u2018Ghost of Time\u2019.", "x0": 0.0968096809680968, "y0": 0.3317793317793318, "x1": 0.9020902090209021, "y1": 0.34265734265734266}, {"text": "ion by its composer, Iva Davies, as part of a colo:", "x0": 0.19911991199119913, "y0": 0.3317793317793318, "x1": 0.5918591859185919, "y1": 0.34498834498834496}, {"text": "The musicians took their final bows a few minutes before midnight.", "x0": 0.09570957095709572, "y0": 0.35664335664335667, "x1": 0.6413641364136413, "y1": 0.36985236985236986}, {"text": "By now, literally billions of people were watching on television, their attention fixed on Australia's", "x0": 0.09570957095709572, "y0": 0.40559440559440557, "x1": 0.8932893289328933, "y1": 0.4188034188034188}, {"text": "premier city. The first of January 2000 would arrive in Sydney before dawning in any other", "x0": 0.09570957095709572, "y0": 0.43045843045843046, "x1": 0.8338833883388339, "y1": 0.44366744366744365}, {"text": "comparable city on earth.", "x0": 0.09570957095709572, "y0": 0.4553224553224553, "x1": 0.29812981298129815, "y1": 0.4677544677544678}, {"text": "As the new Millennium arrived, there came a massive fireworks display \u2014 perhaps the most", "x0": 0.09570957095709572, "y0": 0.4794094794094794, "x1": 0.8327832783278328, "y1": 0.4926184926184926}, {"text": "spectacular ever seen in Australia \u2014 that lasted 24 minutes. At the end, a fiery cascade erupted", "x0": 0.09570957095709572, "y0": 0.5034965034965035, "x1": 0.8514851485148515, "y1": 0.5167055167055167}, {"text": "downwards from the Bridge\u2019s deck. The bells of a dozen churches peeled loudly.", "x0": 0.09570957095709572, "y0": 0.5252525252525253, "x1": 0.7480748074807481, "y1": 0.5446775446775447}, {"text": "And then, as the smoke cleared, it came into view emblazoned in gold letters just below the apex of", "x0": 0.09570957095709572, "y0": 0.5773115773115773, "x1": 0.8987898789878987, "y1": 0.5905205905205905}, {"text": "the Bridge\u2019s towering arch. The first written word of the third Millennium indistinctive copperplate", "x0": 0.09570957095709572, "y0": 0.6021756021756022, "x1": 0.8965896589658966, "y1": 0.6153846153846154}, {"text": "script: Eternity.", "x0": 0.09570957095709572, "y0": 0.627039627039627, "x1": 0.21892189218921893, "y1": 0.6402486402486403}, {"text": "The crowd cheered with gusto. This was a word deeply and affectionately associated with the", "x0": 0.09570957095709572, "y0": 0.675990675990676, "x1": 0.8481848184818482, "y1": 0.6891996891996892}, {"text": "history of Sydney \u2014 and with one man in particular. He did it using chalk or crayon every day for", "x0": 0.09570957095709572, "y0": 0.7000777000777001, "x1": 0.8778877887788779, "y1": 0.7132867132867133}, {"text": "almost 35 years, perhaps half a million times in all. His name was Arthur Malcolm Stace. He had", "x0": 0.09570957095709572, "y0": 0.7218337218337219, "x1": 0.878987898789879, "y1": 0.7420357420357421}, {"text": "died 32 years before, but was far from forgotten.", "x0": 0.09570957095709572, "y0": 0.7498057498057498, "x1": 0.48624862486248627, "y1": 0.763014763014763}, {"text": "End of Text 1", "x0": 0.44224422442244227, "y0": 0.8158508158508159, "x1": 0.5566556655665567, "y1": 0.8251748251748252}], [{"text": "Text 2\u2014 Poem", "x0": 0.09570957095709572, "y0": 0.07148407148407149, "x1": 0.24972497249724973, "y1": 0.08313908313908314}, {"text": "Mosquitos by Aimee Nezhukumatathil", "x0": 0.21342134213421343, "y0": 0.11810411810411811, "x1": 0.5412541254125413, "y1": 0.13131313131313133}, {"text": "When my father wanted to point out galaxies", "x0": 0.2145214521452145, "y0": 0.1686091686091686, "x1": 0.5764576457645765, "y1": 0.18181818181818182}, {"text": "or Andromeda or the Seven Sisters, I'd complain", "x0": 0.2145214521452145, "y0": 0.18725718725718726, "x1": 0.6083608360836084, "y1": 0.20046620046620048}, {"text": "of the huzz of mosquitoes, or of the yawning", "x0": 0.2145214521452145, "y0": 0.2066822066822067, "x1": 0.5742574257425742, "y1": 0.2198912198912199}, {"text": "moon-quiet in that slow, summer air. All I wanted", "x0": 0.2145214521452145, "y0": 0.22533022533022534, "x1": 0.6182618261826183, "y1": 0.23853923853923853}, {"text": "was to go inside into our cooled house and watch TV", "x0": 0.2156215621562156, "y0": 0.26262626262626265, "x1": 0.6424642464246425, "y1": 0.27583527583527584}, {"text": "or paint my nails. What does a fifteen year-old girl know", "x0": 0.2145214521452145, "y0": 0.27505827505827507, "x1": 0.6721672167216721, "y1": 0.29836829836829837}, {"text": "of patience? What does a girl know of the steady turn", "x0": 0.2145214521452145, "y0": 0.3006993006993007, "x1": 0.6446644664466447, "y1": 0.3139083139083139}, {"text": "of a telescope dial until whole moon valleys crest", "x0": 0.2145214521452145, "y0": 0.3123543123543124, "x1": 0.6127612761276128, "y1": 0.3356643356643357}, {"text": "into foct", "x0": 0.2156215621562156, "y0": 0.35742035742035744, "x1": 0.2761276127612761, "y1": 0.36752136752136755}, {"text": "? Standing there in our driveway with him,", "x0": 0.29592959295929594, "y0": 0.35742035742035744, "x1": 0.6391639163916392, "y1": 0.3706293706293706}, {"text": "I smacked my legs, my arms, and my face so hard", "x0": 0.2156215621562156, "y0": 0.37606837606837606, "x1": 0.6160616061606161, "y1": 0.38927738927738925}, {"text": "while I waited for him to find whatever small pinhole", "x0": 0.2156215621562156, "y0": 0.3947163947163947, "x1": 0.6457645764576457, "y1": 0.40792540792540793}, {"text": "of light he wanted me to see. At night, when I washed", "x0": 0.21012101210121012, "y0": 0.41025641025641024, "x1": 0.6490649064906491, "y1": 0.4296814296814297}, {"text": "my face, I'd find bursts of blood and dried bodies", "x0": 0.2145214521452145, "y0": 0.45143745143745145, "x1": 0.6138613861386139, "y1": 0.46464646464646464}, {"text": "slapped into my skin. Complaints at breakfast about", "x0": 0.2156215621562156, "y0": 0.4700854700854701, "x1": 0.6325632563256326, "y1": 0.48329448329448327}, {"text": "how I'd never do it again, how I have more homework", "x0": 0.2145214521452145, "y0": 0.4887334887334887, "x1": 0.6545654565456546, "y1": 0.5019425019425019}, {"text": "now, Dad, how I can\u2019t go to school with bites all over", "x0": 0.2145214521452145, "y0": 0.5081585081585082, "x1": 0.6457645764576457, "y1": 0.5213675213675214}, {"text": "my face anymore. But now I hardly ever", "x0": 0.2145214521452145, "y0": 0.5454545454545454, "x1": 0.636963696369637, "y1": 0.5586635586635587}, {"text": "say no to him. He has plans to go star-gazing", "x0": 0.2156215621562156, "y0": 0.5641025641025641, "x1": 0.5764576457645765, "y1": 0.5773115773115773}, {"text": "with his grandson and for once I don\u2019t protest.", "x0": 0.2145214521452145, "y0": 0.5835275835275835, "x1": 0.5863586358635864, "y1": 0.5967365967365967}, {"text": "He has plans. I know one day he won\u2019t ask me,", "x0": 0.2156215621562156, "y0": 0.6021756021756022, "x1": 0.594059405940594, "y1": 0.6153846153846154}, {"text": "won't be there to show me the rings of Saturn", "x0": 0.2145214521452145, "y0": 0.6394716394716394, "x1": 0.581958195819582, "y1": 0.6526806526806527}, {"text": "glow gold through the eyepiece. He won\u2019t be there", "x0": 0.2145214521452145, "y0": 0.6588966588966589, "x1": 0.6226622662266227, "y1": 0.6721056721056721}, {"text": "to show me how the moons of Jupiter dance", "x0": 0.2156215621562156, "y0": 0.6744366744366744, "x1": 0.5687568756875687, "y1": 0.6938616938616938}, {"text": "if you catch them on a clear night. I know", "x0": 0.2156215621562156, "y0": 0.6961926961926962, "x1": 0.5500550055005501, "y1": 0.7094017094017094}, {"text": "one day I will look up into the night sky", "x0": 0.2145214521452145, "y0": 0.7350427350427351, "x1": 0.5357535753575358, "y1": 0.7474747474747475}, {"text": "searching, searching\u2014I know mosquitoes", "x0": 0.2156215621562156, "y0": 0.752913752913753, "x1": 0.5522552255225522, "y1": 0.7661227661227661}, {"text": "will have their way with me", "x0": 0.2156215621562156, "y0": 0.7715617715617715, "x1": 0.4389438943894389, "y1": 0.7847707847707848}, {"text": "and my father won\u2019t hear me complain", "x0": 0.2145214521452145, "y0": 0.7902097902097902, "x1": 0.5269526952695269, "y1": 0.8034188034188035}, {"text": "End of Text 2", "x0": 0.44224422442244227, "y0": 0.8547008547008547, "x1": 0.5577557755775577, "y1": 0.8648018648018648}], [{"text": "Text 3 \u2014 Prose Fiction Extract", "x0": 0.10121012101210121, "y0": 0.07148407148407149, "x1": 0.40154015401540155, "y1": 0.08313908313908314}, {"text": "Song of the Crocodile by Nardi Simpson", "x0": 0.19031903190319033, "y0": 0.10411810411810411, "x1": 0.5313531353135313, "y1": 0.11732711732711733}, {"text": "\u2018As Margaret sat up and placed her feet upon the dirt floor, a family of sulphur-", "x0": 0.19141914191419143, "y0": 0.1592851592851593, "x1": 0.8085808580858086, "y1": 0.17249417249417248}, {"text": "crested cockatoo\u2019s dived into the enormous red gum at the front of her camp.", "x0": 0.19031903190319033, "y0": 0.18337218337218336, "x1": 0.8085808580858086, "y1": 0.19658119658119658}, {"text": "She slipped her arms into her nightgown as the birds screeched, her", "x0": 0.19141914191419143, "y0": 0.20823620823620823, "x1": 0.8085808580858086, "y1": 0.22144522144522144}, {"text": "nightgown\u2019s hem floating like her own tail behind her as she walked out of", "x0": 0.19141914191419143, "y0": 0.2331002331002331, "x1": 0.8096809680968097, "y1": 0.2463092463092463}, {"text": "her room, pulled aside the heavy canvas that hung as her front door, and", "x0": 0.19141914191419143, "y0": 0.2571872571872572, "x1": 0.8085808580858086, "y1": 0.2703962703962704}, {"text": "stepped outside. Lifting the lid of the browning water drum and placing it", "x0": 0.19141914191419143, "y0": 0.28205128205128205, "x1": 0.8085808580858086, "y1": 0.29526029526029524}, {"text": "silently down, she cupped her hands then submerge them, allowing the", "x0": 0.19141914191419143, "y0": 0.3061383061383061, "x1": 0.8085808580858086, "y1": 0.31934731934731936}, {"text": "water\u2019s icy pulse to stream into her veins. To take her mind from the stinging", "x0": 0.19141914191419143, "y0": 0.331002331002331, "x1": 0.8085808580858086, "y1": 0.3442113442113442}, {"text": "cold, she began to hum, careful to restrict the descending line so that only a", "x0": 0.19031903190319033, "y0": 0.35586635586635584, "x1": 0.8085808580858086, "y1": 0.3690753690753691}, {"text": "series of squeaks and gushes of air emitted from her body. While her hands", "x0": 0.19141914191419143, "y0": 0.37995337995337997, "x1": 0.8085808580858086, "y1": 0.39316239316239315}, {"text": "floated, she swam in the song. Margaret lifted her face towards the sky, its", "x0": 0.19141914191419143, "y0": 0.4048174048174048, "x1": 0.8085808580858086, "y1": 0.41802641802641805}, {"text": "rising warmth pushing her chin upwards, closing her eyes. Heat crept into the", "x0": 0.19141914191419143, "y0": 0.4289044289044289, "x1": 0.8085808580858086, "y1": 0.4421134421134421}, {"text": "lines on her face; she felt it drip into her brow and trickle towards her lips", "x0": 0.19141914191419143, "y0": 0.45376845376845376, "x1": 0.8074807480748075, "y1": 0.466977466977467}, {"text": "from the pathways at her temples and her cheeks. With her hands in the water", "x0": 0.19141914191419143, "y0": 0.47863247863247865, "x1": 0.8096809680968097, "y1": 0.49184149184149184}, {"text": "and her face to the sun, Margaret Lightning continued her song. She hummed", "x0": 0.19141914191419143, "y0": 0.5027195027195027, "x1": 0.8085808580858086, "y1": 0.515928515928516}, {"text": "as she rubbed water into her face and ran her wet hands through her hair, as", "x0": 0.19141914191419143, "y0": 0.5275835275835276, "x1": 0.8085808580858086, "y1": 0.5407925407925408}, {"text": "she then twisted and pulled it into her regular low bun. She even hummed as", "x0": 0.19141914191419143, "y0": 0.5532245532245532, "x1": 0.8074807480748075, "y1": 0.5656565656565656}, {"text": "she prodded at the wiry strands of grey that had begun to spark at her", "x0": 0.19141914191419143, "y0": 0.5765345765345765, "x1": 0.8096809680968097, "y1": 0.5897435897435898}, {"text": "forehead.", "x0": 0.19141914191419143, "y0": 0.6013986013986014, "x1": 0.264026402640264, "y1": 0.6114996114996115}, {"text": "End of Text 3", "x0": 0.44224422442244227, "y0": 0.8026418026418026, "x1": 0.5577557755775577, "y1": 0.8127428127428128}], [{"text": "Text 4 \u2014 Non-Fiction Extract", "x0": 0.09570957095709572, "y0": 0.07148407148407149, "x1": 0.39603960396039606, "y1": 0.08313908313908314}, {"text": "Language Wars \u2014 sometimes mother knows best by Selina Li Duke", "x0": 0.09460946094609461, "y0": 0.10411810411810411, "x1": 0.6534653465346535, "y1": 0.11732711732711733}, {"text": "These days, even kindergartners and first-graders in Beijing and Shang-hai are learning English.", "x0": 0.09570957095709572, "y0": 0.15306915306915306, "x1": 0.8701870187018702, "y1": 0.16627816627816627}, {"text": "English has become the first foreign language for most of the world, a kind of lingua franca*", "x0": 0.09570957095709572, "y0": 0.17715617715617715, "x1": 0.8426842684268426, "y1": 0.19036519036519037}, {"text": "whenever different nationalities meet, whether at a science conference in Helsinki or a beauty", "x0": 0.09570957095709572, "y0": 0.20202020202020202, "x1": 0.8492849284928493, "y1": 0.21522921522921523}, {"text": "context in Mexico City. The complacent, monolingual Australian thus sees little need to learn the", "x0": 0.09570957095709572, "y0": 0.22688422688422688, "x1": 0.8800880088008801, "y1": 0.2400932400932401}, {"text": "language of other peoples, and many an ethnic parent gives up nagging her Australian-born or -", "x0": 0.09570957095709572, "y0": 0.25097125097125095, "x1": 0.8646864686468647, "y1": 0.2641802641802642}, {"text": "educated offspring to learn her native tongue. What is the use of forcing Cantonese or Tamil or", "x0": 0.09570957095709572, "y0": 0.27583527583527584, "x1": 0.8613861386138614, "y1": 0.289044289044289}, {"text": "Tagalog on your children when it is not used outside the home, anyway?", "x0": 0.09570957095709572, "y0": 0.3006993006993007, "x1": 0.6798679867986799, "y1": 0.3139083139083139}, {"text": "a dominant language takes over more and more spheres of everyday life, and fewer", "x0": 0.22332233223322331, "y0": 0.34965034965034963, "x1": 0.8932893289328933, "y1": 0.3628593628593629}, {"text": "Historically,", "x0": 0.09570957095709572, "y0": 0.3504273504273504, "x1": 0.19471947194719472, "y1": 0.3628593628593629}, {"text": "and fewer children in minority groups learn their parents\u2019 native tongues, the decline of these", "x0": 0.09570957095709572, "y0": 0.3745143745143745, "x1": 0.845984598459846, "y1": 0.3877233877233877}, {"text": "tongues is set in motion. At the beginning of European colonisation of Australia there were about", "x0": 0.09570957095709572, "y0": 0.3986013986013986, "x1": 0.8800880088008801, "y1": 0.41181041181041184}, {"text": "250 different indigenous languages, but in 2005 a national survey found that only 145 were still", "x0": 0.09570957095709572, "y0": 0.4234654234654235, "x1": 0.8657865786578658, "y1": 0.4366744366744367}, {"text": "spoken, of which most were \u2018severely or critically endangered\u2019 and only eighteen were considered", "x0": 0.09570957095709572, "y0": 0.44755244755244755, "x1": 0.8888888888888888, "y1": 0.46076146076146074}, {"text": "\u2018strong\u2019. Nicholas Evans observes that the same kind of language death has occurred in Northern", "x0": 0.0968096809680968, "y0": 0.47241647241647244, "x1": 0.8767876787678768, "y1": 0.48562548562548563}, {"text": "America and South Africa.", "x0": 0.09570957095709572, "y0": 0.4972804972804973, "x1": 0.31133113311331134, "y1": 0.5073815073815073}, {"text": "All over the world, linguists and anthropologists like Evans are frantically documenting dying", "x0": 0.09570957095709572, "y0": 0.5462315462315462, "x1": 0.8536853685368537, "y1": 0.5594405594405595}, {"text": "guages, often in nursing homes where the very last speaker resides, so that the voices of entire", "x0": 0.12101210121012101, "y0": 0.5710955710955711, "x1": 0.8778877887788779, "y1": 0.5843045843045843}, {"text": "I", "x0": 0.09570957095709572, "y0": 0.5718725718725719, "x1": 0.1001100110011001, "y1": 0.5811965811965812}, {"text": "peoples, in all their moods and cadences, do not fade into silence, and the unique experience and", "x0": 0.09570957095709572, "y0": 0.5951825951825952, "x1": 0.8734873487348734, "y1": 0.6083916083916084}, {"text": "knowledge they articulate are not lost to the rest of humanity. Sometimes, even governments get in", "x0": 0.09570957095709572, "y0": 0.62004662004662, "x1": 0.8921892189218922, "y1": 0.6332556332556333}, {"text": "on the act of minority-language maintenance, committing a modicum of funds and resources to the", "x0": 0.09570957095709572, "y0": 0.6441336441336442, "x1": 0.8910891089108911, "y1": 0.6573426573426573}, {"text": "cause. It may be token, a sop to minorities, or a genuine attempt to support \u2018diversity\u2019 and", "x0": 0.09570957095709572, "y0": 0.668997668997669, "x1": 0.8195819581958196, "y1": 0.6822066822066822}, {"text": "\u2018linguistic ecology\u2019. I have the feeling, however, that the decline and eventual death of many", "x0": 0.0968096809680968, "y0": 0.6938616938616938, "x1": 0.8426842684268426, "y1": 0.7070707070707071}, {"text": "languages, especially those without a written culture, will be hard to stop. I wonder what the global", "x0": 0.09570957095709572, "y0": 0.717948717948718, "x1": 0.8943894389438944, "y1": 0.7311577311577312}, {"text": "\\dscape of languages will be like in one or two hundred years; what", "x0": 0.11991199119911991, "y0": 0.7428127428127428, "x1": 0.6578657865786579, "y1": 0.756021756021756}, {"text": "s \u2014 if any \u2014 other than", "x0": 0.7117711771177118, "y0": 0.7428127428127428, "x1": 0.8822882288228823, "y1": 0.756021756021756}, {"text": "I", "x0": 0.09570957095709572, "y0": 0.7435897435897436, "x1": 0.1001100110011001, "y1": 0.752913752913753}, {"text": "those of economic and political power will there be in our splendidly polyphonous world.", "x0": 0.09570957095709572, "y0": 0.7676767676767676, "x1": 0.8162816281628162, "y1": 0.7808857808857809}, {"text": "* lingua franca - a language that is adopted as a common language between speakers whose native", "x0": 0.09790979097909791, "y0": 0.8166278166278166, "x1": 0.8987898789878987, "y1": 0.8298368298368298}, {"text": "languages are different.", "x0": 0.09570957095709572, "y0": 0.8329448329448329, "x1": 0.28602860286028603, "y1": 0.8461538461538461}, {"text": "End of Text 4", "x0": 0.44224422442244227, "y0": 0.8865578865578866, "x1": 0.5577557755775577, "y1": 0.8966588966588966}], [{"text": "Text 5 \u2014 Prose Fiction Extract", "x0": 0.09570957095709572, "y0": 0.09168609168609168, "x1": 0.4081408140814081, "y1": 0.10334110334110334}, {"text": "Extract from At the Edge of the Solid World by Daniel Davis Wood", "x0": 0.16721672167216722, "y0": 0.11965811965811966, "x1": 0.735973597359736, "y1": 0.13286713286713286}, {"text": "On those rare winter days that end up blazing, dawn in the Alps can be heard long", "x0": 0.16721672167216722, "y0": 0.17249417249417248, "x1": 0.8327832783278328, "y1": 0.1857031857031857}, {"text": "before it makes itself seen. Even as the sun lingers behind the mountains, it heralds", "x0": 0.16721672167216722, "y0": 0.19735819735819735, "x1": 0.8316831683168316, "y1": 0.21056721056721056}, {"text": "its arrival with a wave of gentle warmth. The wave crests over the sharp, serrated", "x0": 0.16831683168316833, "y0": 0.22144522144522144, "x1": 0.8316831683168316, "y1": 0.23465423465423466}, {"text": "spires and washes across the snowscapes beneath them, and if you wake up early", "x0": 0.16831683168316833, "y0": 0.2463092463092463, "x1": 0.8316831683168316, "y1": 0.2595182595182595}, {"text": "enough, or if you\u2019ve stayed awake long enough, you can listen to its passage", "x0": 0.16721672167216722, "y0": 0.27117327117327117, "x1": 0.8327832783278328, "y1": 0.28438228438228436}, {"text": "through darkness.", "x0": 0.16831683168316833, "y0": 0.29603729603729606, "x1": 0.30913091309130913, "y1": 0.3084693084693085}, {"text": "The icicles that dangle from gutters start to drip. In a matter of moments, all else", "x0": 0.16721672167216722, "y0": 0.3341103341103341, "x1": 0.8316831683168316, "y1": 0.3473193473193473}, {"text": "being silent, the dripping will surround you, will encompass the house you shelter", "x0": 0.16721672167216722, "y0": 0.358974358974359, "x1": 0.8327832783278328, "y1": 0.37218337218337216}, {"text": "in, with the cantankerous rat-a-tat of a demented tattoo. Then comes the hiss of", "x0": 0.16831683168316833, "y0": 0.3838383838383838, "x1": 0.8338833883388339, "y1": 0.3954933954933955}, {"text": "sintering snow. The warmth in the air shears away the crystals on the surface of the", "x0": 0.16831683168316833, "y0": 0.40792540792540793, "x1": 0.8327832783278328, "y1": 0.4211344211344211}, {"text": "drifts, and as the uttermost flakes fizzle into a flow of tinkling water, daybreak", "x0": 0.16721672167216722, "y0": 0.43278943278943277, "x1": 0.8327832783278328, "y1": 0.445998445998446}, {"text": "arrives amid an entourage of rhythms. The hiss shrouds the world in a field of static.", "x0": 0.16721672167216722, "y0": 0.45376845376845376, "x1": 0.8316831683168316, "y1": 0.473970473970474}, {"text": "The percussion of the ice-melt rises to a clamour. Every so often you'll hear the", "x0": 0.16721672167216722, "y0": 0.48174048174048173, "x1": 0.8327832783278328, "y1": 0.494949494949495}, {"text": "slosh of snow slipping off a roof, the spatter of clods tumbling from the branches", "x0": 0.16831683168316833, "y0": 0.5066045066045066, "x1": 0.8316831683168316, "y1": 0.5198135198135199}, {"text": "of overburdened pines. Then with a faint aureole of white, the sun, its body still", "x0": 0.16721672167216722, "y0": 0.5306915306915307, "x1": 0.8316831683168316, "y1": 0.5439005439005439}, {"text": "hidden erodes the farthest reaches of the dark. The stillness of the night is over.", "x0": 0.16721672167216722, "y0": 0.5555555555555556, "x1": 0.8316831683168316, "y1": 0.5687645687645687}, {"text": "Things start happening all around, inundating the senses, as the conditions for", "x0": 0.16721672167216722, "y0": 0.5804195804195804, "x1": 0.8327832783278328, "y1": 0.5936285936285937}, {"text": "solitude recede with the rotation of the planet.", "x0": 0.16831683168316833, "y0": 0.6045066045066045, "x1": 0.5357535753575358, "y1": 0.6177156177156177}, {"text": "I slumped at the laptop but turned to face the window. With exhaustion biting the", "x0": 0.16831683168316833, "y0": 0.6433566433566433, "x1": 0.8316831683168316, "y1": 0.6565656565656566}, {"text": "back of my eyes, I watched the day come into being.", "x0": 0.16721672167216722, "y0": 0.6682206682206682, "x1": 0.5896589658965896, "y1": 0.6814296814296814}, {"text": "End of Text 5", "x0": 0.44224422442244227, "y0": 0.745920745920746, "x1": 0.5577557755775577, "y1": 0.756021756021756}], [{"text": "Section II", "x0": 0.09570957095709572, "y0": 0.07148407148407149, "x1": 0.1925192519251925, "y1": 0.08391608391608392}, {"text": "The prescribed texts for Section II are:", "x0": 0.09570957095709572, "y0": 0.10567210567210568, "x1": 0.40484048404840484, "y1": 0.11888111888111888}, {"text": "+ Prose", "x0": 0.18811881188118812, "y0": 0.12975912975912976, "x1": 0.2552255225522552, "y1": 0.14996114996114995}, {"text": "Anthony Doerr, All the Light We Cannot See", "x0": 0.3795379537953795, "y0": 0.13286713286713286, "x1": 0.7425742574257426, "y1": 0.14607614607614608}, {"text": "Amanda Lohrey, Vertigo", "x0": 0.37843784378437845, "y0": 0.15695415695415696, "x1": 0.5808580858085809, "y1": 0.16938616938616938}, {"text": "George Orwell, Nineteen Eighty-Four", "x0": 0.37843784378437845, "y0": 0.18026418026418026, "x1": 0.6864686468646864, "y1": 0.1926961926961927}, {"text": "Favel Parrett, Past the Shallows", "x0": 0.37843784378437845, "y0": 0.20279720279720279, "x1": 0.636963696369637, "y1": 0.21367521367521367}, {"text": "+ Poetry -", "x0": 0.18811881188118812, "y0": 0.23776223776223776, "x1": 0.3641364136413641, "y1": 0.2501942501942502}, {"text": "Rosemary Dobson, Rosemary Dobson Collected", "x0": 0.3795379537953795, "y0": 0.23776223776223776, "x1": 0.77007700770077, "y1": 0.2501942501942502}, {"text": "The prescribed poems are:", "x0": 0.37843784378437845, "y0": 0.2602952602952603, "x1": 0.5896589658965896, "y1": 0.27350427350427353}, {"text": "* Young Girl at a Window", "x0": 0.3795379537953795, "y0": 0.2836052836052836, "x1": 0.6006600660066007, "y1": 0.29681429681429683}, {"text": "* Over the Hill", "x0": 0.3795379537953795, "y0": 0.2999222999222999, "x1": 0.5082508250825083, "y1": 0.31002331002331}, {"text": "* Summer's End", "x0": 0.3795379537953795, "y0": 0.317016317016317, "x1": 0.5203520352035204, "y1": 0.3271173271173271}, {"text": "* The Conversation", "x0": 0.3795379537953795, "y0": 0.3333333333333333, "x1": 0.5456545654565457, "y1": 0.3434343434343434}, {"text": "* Cock Crow", "x0": 0.3795379537953795, "y0": 0.35120435120435123, "x1": 0.49284928492849284, "y1": 0.3605283605283605}, {"text": "* Amy Caroline", "x0": 0.3795379537953795, "y0": 0.36752136752136755, "x1": 0.5137513751375138, "y1": 0.37995337995337997}, {"text": "* Canberra Morning", "x0": 0.3795379537953795, "y0": 0.38461538461538464, "x1": 0.5555555555555556, "y1": 0.39704739704739705}, {"text": "Kenneth Slessor, Selected Poems", "x0": 0.3795379537953795, "y0": 0.4172494172494173, "x1": 0.6457645764576457, "y1": 0.4289044289044289}, {"text": "The prescribed poems are:", "x0": 0.37843784378437845, "y0": 0.44133644133644134, "x1": 0.5907590759075908, "y1": 0.45376845376845376}, {"text": "* Wild Grrapes", "x0": 0.3795379537953795, "y0": 0.46386946386946387, "x1": 0.504950495049505, "y1": 0.47707847707847706}, {"text": "* Gulliver", "x0": 0.3795379537953795, "y0": 0.48096348096348096, "x1": 0.46864686468646866, "y1": 0.4902874902874903}, {"text": "* Out of Time", "x0": 0.3795379537953795, "y0": 0.49805749805749805, "x1": 0.49834983498349833, "y1": 0.5104895104895105}, {"text": "* Vesper-Song of the Reverend Samuel Marsden", "x0": 0.3795379537953795, "y0": 0.5135975135975136, "x1": 0.7788778877887789, "y1": 0.5268065268065268}, {"text": "* William Street", "x0": 0.3795379537953795, "y0": 0.5314685314685315, "x1": 0.5181518151815182, "y1": 0.5407925407925408}, {"tex