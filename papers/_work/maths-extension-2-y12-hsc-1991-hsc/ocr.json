8601398601}, {"text": "clic quadrilateral.", "x0": 0.43956043956043955, "y0": 0.846930846930847, "x1": 0.5813186813186814, "y1": 0.8601398601398601}], [{"text": "10", "x0": 0.15164835164835164, "y0": 0.08469308469308469, "x1": 0.16703296703296702, "y1": 0.09246309246309246}, {"text": "(iv) Let ZQPY =a and ZPQY = B. Show that ZSTQ =a + 8.", "x0": 0.15164835164835164, "y0": 0.11577311577311578, "x1": 0.7252747252747253, "y1": 0.12975912975912976}, {"text": "(b) A drinking glass having the form of a right circular cylinder of radius @ and", "x0": 0.15164835164835164, "y0": 0.14374514374514374, "x1": 0.8802197802197802, "y1": 0.15695415695415696}, {"text": "height h, is filled with water. The glass is slowly tilted over, spilling water out of it,", "x0": 0.15054945054945054, "y0": 0.16083916083916083, "x1": 0.8802197802197802, "y1": 0.17404817404817405}, {"text": "until it reaches the position where the water\u2019s surface bisects the base of the glas", "x0": 0.15054945054945054, "y0": 0.17793317793317792, "x1": 0.8626373626373627, "y1": 0.19114219114219114}, {"text": "Figure 1 shows this positi", "x0": 0.15054945054945054, "y0": 0.19502719502719504, "x1": 0.37362637362637363, "y1": 0.20823620823620823}, {"text": "SE", "x0": 0.44175824175824174, "y0": 0.3605283605283605, "x1": 0.5868131868131868, "y1": 0.42035742035742035}, {"text": "Figure 2", "x0": 0.27472527472527475, "y0": 0.5112665112665112, "x1": 0.3373626373626374, "y1": 0.533022533022533}, {"text": "Figure 3", "x0": 0.5978021978021978, "y0": 0.5578865578865578, "x1": 0.6659340659340659, "y1": 0.5796425796425796}, {"text": "va,", "x0": 0.16373626373626374, "y0": 0.6472416472416472, "x1": 0.2087912087912088, "y1": 0.6837606837606838}, {"text": "Note: EG 1 CH at F", "x0": 0.2230769230769231, "y0": 0.6961926961926962, "x1": 0.3912087912087912, "y1": 0.7218337218337219}, {"text": "Note: FH || CO, CO = a, and OD =k", "x0": 0.5340659340659341, "y0": 0.710955710955711, "x1": 0.8483516483516483, "y1": 0.7373737373737373}, {"text": "In Figure 1, AB is a diameter of the circular base with centre C,O is the lowest", "x0": 0.15054945054945054, "y0": 0.752913752913753, "x1": 0.8802197802197802, "y1": 0.7661227661227661}, {"text": "point on the base, and D is the point where the surface touches the rim of", "x0": 0.15054945054945054, "y0": 0.77000777000777, "x1": 0.8824175824175824, "y1": 0.7832167832167832}, {"text": "the glass.", "x0": 0.15054945054945054, "y0": 0.7871017871017871, "x1": 0.22967032967032966, "y1": 0.8003108003108003}, {"text": "Figure 2 shows a cross-section of the titled glass parallel to its base. The centre of", "x0": 0.15054945054945054, "y0": 0.8142968142968143, "x1": 0.8824175824175824, "y1": 0.8275058275058275}, {"text": "this circular section is C\u2019 and EFG shows the water level. The section cuts the lines", "x0": 0.15054945054945054, "y0": 0.8306138306138307, "x1": 0.8802197802197802, "y1": 0.8422688422688422}, {"text": "CD and OD of Figure 1 in F and H respectively.", "x0": 0.15054945054945054, "y0": 0.8484848484848485, "x1": 0.5857142857142857, "y1": 0.8616938616938616}, {"text": "Figure 3 shows the section COD of the tilted glass.", "x0": 0.15054945054945054, "y0": 0.8756798756798757, "x1": 0.6010989010989011, "y1": 0.8888888888888888}], [{"text": "(i) Use Figure 3 to show that FH = \u00a3(h \u2014 a), where OH =a.", "x0": 0.15164835164835164, "y0": 0.108003108003108, "x1": 0.7021978021978021, "y1": 0.13442113442113443}, {"text": "(ii) Use Figure 2 to show that C\u2019F = % and ZHO'G = (2).", "x0": 0.15164835164835164, "y0": 0.1351981351981352, "x1": 0.7406593406593407, "y1": 0.1623931623931624}, {"text": "(iii) Use (i) to show that the area of the shaded segment EGH is", "x0": 0.15164835164835164, "y0": 0.16938616938616938, "x1": 0.8802197802197802, "y1": 0.18337218337218336}, {"text": "(iv) Given that f 4 = 8 cos", "x0": 0.15164835164835164, "y0": 0.23154623154623155, "x1": 0.46263736263736266, "y1": 0.24708624708624707}, {"text": "\u2014 find the vo