[[{"text": "Student Number", "x0": 0.6175824175824176, "y0": 0.08935508935508936, "x1": 0.7626373626373626, "y1": 0.09945609945609946}, {"text": "Wes College", "x0": 0.14065934065934066, "y0": 0.18492618492618493, "x1": 0.3758241758241758, "y1": 0.2191142191142191}, {"text": "TRIAL HIGHER SCHOOL", "x0": 0.2978021978021978, "y0": 0.2400932400932401, "x1": 0.567032967032967, "y1": 0.2533022533022533}, {"text": "CERTIFICATE EXAMINATION", "x0": 0.2978021978021978, "y0": 0.25874125874125875, "x1": 0.6186813186813187, "y1": 0.27195027195027194}, {"text": "English Extension 1", "x0": 0.13736263736263737, "y0": 0.3038073038073038, "x1": 0.667032967032967, "y1": 0.34498834498834496}, {"text": "PM TUESDAY 18\" AUGUST", "x0": 0.6395604395604395, "y0": 0.3628593628593629, "x1": 0.9032967032967033, "y1": 0.3745143745143745}, {"text": "Staff Involved:", "x0": 0.13406593406593406, "y0": 0.3791763791763792, "x1": 0.25934065934065936, "y1": 0.39083139083139085}, {"text": "+ AMH", "x0": 0.13406593406593406, "y0": 0.3947163947163947, "x1": 0.1956043956043956, "y1": 0.40559440559440557}, {"text": "+ +LAS*", "x0": 0.13406593406593406, "y0": 0.411033411033411, "x1": 0.2813186813186813, "y1": 0.4226884226884227}, {"text": "40 copies", "x0": 0.13296703296703297, "y0": 0.44366744366744365, "x1": 0.21868131868131868, "y1": 0.45765345765345766}, {"text": "General + Reading time - 10 minutes", "x0": 0.14285714285714285, "y0": 0.4700854700854701, "x1": 0.5648351648351648, "y1": 0.49106449106449107}, {"text": "Instructions + Working time - 2 hours", "x0": 0.14395604395604394, "y0": 0.4864024864024864, "x1": 0.5318681318681319, "y1": 0.5104895104895105}, {"text": "+ Write using black pen", "x0": 0.3131868131868132, "y0": 0.5143745143745144, "x1": 0.5230769230769231, "y1": 0.5275835275835276}, {"text": "+ Start a NEW answer booklet for each NEW question", "x0": 0.3131868131868132, "y0": 0.5345765345765345, "x1": 0.7956043956043956, "y1": 0.5477855477855478}, {"text": "Total marks: Attempt ONE question from the common module and", "x0": 0.14285714285714285, "y0": 0.574980574980575, "x1": 0.7835164835164835, "y1": 0.5889665889665889}, {"text": "50 ONE question from the elective you have studied.", "x0": 0.14285714285714285, "y0": 0.5905205905205905, "x1": 0.7516483516483516, "y1": 0.60994560994561}, {"text": "Section | - 25 marks (pages 2 - 4)", "x0": 0.3131868131868132, "y0": 0.6379176379176379, "x1": 0.6076923076923076, "y1": 0.6519036519036518}, {"text": "Common Module : Literary Worlds.", "x0": 0.3120879120879121, "y0": 0.6557886557886557, "x1": 0.6175824175824176, "y1": 0.675990675990676}, {"text": "+ Attempt Question 1", "x0": 0.3131868131868132, "y0": 0.6806526806526807, "x1": 0.5, "y1": 0.6938616938616938}, {"text": "+ Allow about 60 minutes for this section", "x0": 0.3131868131868132, "y0": 0.7008547008547008, "x1": 0.6736263736263737, "y1": 0.710955710955711}, {"text": "Section II - 25 marks (pages 5 - 9)", "x0": 0.3131868131868132, "y0": 0.7389277389277389, "x1": 0.6131868131868132, "y1": 0.7599067599067599}, {"text": "Elective 3 : Reimagined Worlds", "x0": 0.3131868131868132, "y0": 0.763014763014763, "x1": 0.5912087912087912, "y1": 0.777000777000777}, {"text": "+ Attempt ONE question from Questions 2 - 6", "x0": 0.3131868131868132, "y0": 0.7847707847707848, "x1": 0.7186813186813187, "y1": 0.797979797979798}, {"text": "+ Allow about 60 minutes for this section", "x0": 0.3131868131868132, "y0": 0.8057498057498057, "x1": 0.6736263736263737, "y1": 0.8158508158508159}], [{"text": "Section I\u2014 Common Module: Literary Worlds", "x0": 0.13406593406593406, "y0": 0.04584304584304584, "x1": 0.6164835164835165, "y1": 0.061383061383061384}, {"text": "25 marks", "x0": 0.13406593406593406, "y0": 0.07148407148407149, "x1": 0.21318681318681318, "y1": 0.08080808080808081}, {"text": "Attempt Question 1", "x0": 0.13406593406593406, "y0": 0.08702408702408702, "x1": 0.3, "y1": 0.09945609945609946}, {"text": "Allow about 1 hour for this section", "x0": 0.13406593406593406, "y0": 0.10334110334110334, "x1": 0.42967032967032964, "y1": 0.11266511266511267}, {"text": "Answer the question in the English Extension 1 Section I Writing Booklet. Extra booklets are", "x0": 0.13406593406593406, "y0": 0.1250971250971251, "x1": 0.8868131868131868, "y1": 0.1383061383061383}, {"text": "available if required.", "x0": 0.13406593406593406, "y0": 0.1414141414141414, "x1": 0.2989010989010989, "y1": 0.15462315462315462}, {"text": "Your answer will be assessed on how well you:", "x0": 0.13406593406593406, "y0": 0.17793317793317792, "x1": 0.5142857142857142, "y1": 0.19114219114219114}, {"text": "= demonstrate an understanding of the ideas and values of Literary Worlds and how they", "x0": 0.13406593406593406, "y0": 0.20124320124320125, "x1": 0.8802197802197802, "y1": 0.21445221445221446}, {"text": "are shaped and reflected in texts", "x0": 0.1813186813186813, "y0": 0.21678321678321677, "x1": 0.43956043956043955, "y1": 0.22999222999222999}, {"text": "= craft a sustained composition appropriate to the question, demonstrating control of the", "x0": 0.13406593406593406, "y0": 0.236985236985237, "x1": 0.8758241758241758, "y1": 0.2564102564102564}, {"text": "use of language.", "x0": 0.1824175824175824, "y0": 0.2556332556332556, "x1": 0.310989010989011, "y1": 0.26884226884226886}, {"text": "Use Text | to answer Question 1.", "x0": 0.13406593406593406, "y0": 0.29448329448329447, "x1": 0.4010989010989011, "y1": 0.30691530691530694}, {"text": "Text 1 \u2014 Nonfiction Extract", "x0": 0.13406593406593406, "y0": 0.3271173271173271, "x1": 0.378021978021978, "y1": 0.33644133644133645}, {"text": "It\u2019s perhaps easier to declare what a short story isn\u2019t: it\u2019s not an abridged version of the", "x0": 0.16263736263736264, "y0": 0.36596736596736595, "x1": 0.8747252747252747, "y1": 0.3900543900543901}, {"text": "novel; nor is it a prose poem, though it can share aspects of these forms \u2014 a distant", "x0": 0.16263736263736264, "y0": 0.3885003885003885, "x1": 0.8747252747252747, "y1": 0.4087024087024087}, {"text": "cousin to both, if you like, a younger, often brash and indecorous one. Let\u2019s start then", "x0": 0.16263736263736264, "y0": 0.41025641025641024, "x1": 0.8747252747252747, "y1": 0.4234654234654235}, {"text": "by terming the story a compressed narrative, irreducible and intense, a piece of fiction", "x0": 0.16263736263736264, "y0": 0.4281274281274281, "x1": 0.8747252747252747, "y1": 0.44133644133644134}, {"text": "designed to move, delight, provoke, amuse or shock \u2014 all in a single sitting.", "x0": 0.16263736263736264, "y0": 0.445998445998446, "x1": 0.7791208791208791, "y1": 0.4592074592074592}, {"text": "Barbara Kingsolver remarked that stories are the successful execution of large truths", "x0": 0.16263736263736264, "y0": 0.47863247863247865, "x1": 0.8747252747252747, "y1": 0.49184149184149184}, {"text": "delivered in tight spaces. Flannery O\u2019Connor, too, evoked this aspect, claiming certain", "x0": 0.16263736263736264, "y0": 0.4965034965034965, "x1": 0.8747252747252747, "y1": 0.5097125097125097}, {"text": "truths exist that can only be told through the short story.", "x0": 0.16263736263736264, "y0": 0.5151515151515151, "x1": 0.6120879120879121, "y1": 0.5283605283605284}, {"text": "Although assimilating elements of early forms of storytelling (fables, myths, sagas,", "x0": 0.16263736263736264, "y0": 0.5470085470085471, "x1": 0.8736263736263736, "y1": 0.5602175602175602}, {"text": "parables, folk tales, ballads), the short story as we know it today is little more than two", "x0": 0.16263736263736264, "y0": 0.5656565656565656, "x1": 0.8747252747252747, "y1": 0.5788655788655789}, {"text": "centuries old. The author Philip O Ceallaigh suggests that after food and shelter, stories", "x0": 0.16263736263736264, "y0": 0.5835275835275835, "x1": 0.8747252747252747, "y1": 0.5967365967365967}, {"text": "are the thing we need most to sustain us. Certainly, storytellers have been revered", "x0": 0.16263736263736264, "y0": 0.6013986013986014, "x1": 0.8747252747252747, "y1": 0.6146076146076146}, {"text": "throughout history; in the gulags, for example, those who told stories were often", "x0": 0.16263736263736264, "y0": 0.62004662004662, "x1": 0.8747252747252747, "y1": 0.6332556332556333}, {"text": "bestowed higher status. The form, then, has its roots within the tradition of oral", "x0": 0.16263736263736264, "y0": 0.6379176379176379, "x1": 0.8736263736263736, "y1": 0.6511266511266511}, {"text": "storytelling, where travellers would earn their supper or a bed in exchange for the", "x0": 0.16263736263736264, "y0": 0.6557886557886557, "x1": 0.8747252747252747, "y1": 0.668997668997669}, {"text": "narrating of an entertaining and compelling tale.", "x0": 0.16263736263736264, "y0": 0.6744366744366744, "x1": 0.5494505494505495, "y1": 0.6876456876456877}, {"text": "From Hawthorne and Poe to Chekhov and Joyce, right up to Carver and Munro, the", "x0": 0.16263736263736264, "y0": 0.7062937062937062, "x1": 0.8747252747252747, "y1": 0.7195027195027195}, {"text": "short story\u2019s emergence has been universal in appeal, adapting itself to disparate", "x0": 0.16263736263736264, "y0": 0.7249417249417249, "x1": 0.8747252747252747, "y1": 0.7381507381507382}, {"text": "cultures and genres. Yet what we regard as the modern short story is the youngest of the", "x0": 0.16263736263736264, "y0": 0.7350427350427351, "x1": 0.8747252747252747, "y1": 0.7591297591297591}, {"text": "literary forms, hardly out of short trousers. It is the precocious child, refusing to", "x0": 0.16263736263736264, "y0": 0.7606837606837606, "x1": 0.8747252747252747, "y1": 0.7738927738927739}, {"text": "conform, to be predictable or well behaved. Yes, it has learned from what's passed", "x0": 0.16263736263736264, "y0": 0.7793317793317793, "x1": 0.8747252747252747, "y1": 0.7925407925407926}, {"text": "before, but it wants to push into new territory, mould the literary landscape to its own", "x0": 0.16263736263736264, "y0": 0.7972027972027972, "x1": 0.8747252747252747, "y1": 0.8104118104118104}, {"text": "will, break free of traditional shackles.", "x0": 0.16263736263736264, "y0": 0.8127428127428128, "x1": 0.4714285714285714, "y1": 0.8329448329448329}, {"text": "continues on page 3", "x0": 0.4351648351648352, "y0": 0.8811188811188811, "x1": 0.6010989010989011, "y1": 0.8935508935508936}], [{"text": "Question 1 (continued)", "x0": 0.13406593406593406, "y0": 0.061383061383061384, "x1": 0.3230769230769231, "y1": 0.07459207459207459}, {"text": "From the earliest writings, and set down by Aristotle, we have a preconceived idea of", "x0": 0.16263736263736264, "y0": 0.09246309246309246, "x1": 0.8769230769230769, "y1": 0.10567210567210568}, {"text": "what the important elements of drama and fiction are: the beginning, middle and end,", "x0": 0.16263736263736264, "y0": 0.1111111111111111, "x1": 0.8736263736263736, "y1": 0.12432012432012432}, {"text": "the what happens, the sequence of exposition of character and setting, the rising action,", "x0": 0.16263736263736264, "y0": 0.128982128982129, "x1": 0.8736263736263736, "y1": 0.14219114219114218}, {"text": "the drama and conflict, and finally the resolution. In Maupassant\u2019s stories, and in other", "x0": 0.16263736263736264, "y0": 0.14685314685314685, "x1": 0.8758241758241758, "y1": 0.16006216006216006}, {"text": "nineteenth-century exemplars, the emphasis was still on plot, with the narrative closed", "x0": 0.16263736263736264, "y0": 0.1655011655011655, "x1": 0.8747252747252747, "y1": 0.17871017871017872}, {"text": "tightly at the end: stories were hewn to a formula, designed to entertain, to satisfy.", "x0": 0.16263736263736264, "y0": 0.18337218337218336, "x1": 0.8219780219780219, "y1": 0.19658119658119658}, {"text": "But now we expect plot to arise directly from character, if indeed it arises at all. Authors", "x0": 0.16263736263736264, "y0": 0.216006216006216, "x1": 0.8747252747252747, "y1": 0.22921522921522922}, {"text": "such as Chekhov and Turgenev began to plot, sacrificing it for deeper", "x0": 0.16263736263736264, "y0": 0.2338772338772339, "x1": 0.8758241758241758, "y1": 0.24708624708624707}, {"text": "characterisation and atmosphere. Conflict in their stories increasingly took place", "x0": 0.16263736263736264, "y0": 0.2517482517482518, "x1": 0.8747252747252747, "y1": 0.26495726495726496}, {"text": "internally, the character(s) wrestling with turmoil or dilemma. Stories such as", "x0": 0.16263736263736264, "y0": 0.2703962703962704, "x1": 0.8747252747252747, "y1": 0.2836052836052836}, {"text": "Mansfield\u2019s \u2018Bliss\u2019 and Chekhov\u2019s \u2018The Lady with the Dog\u201d were patterned by internal", "x0": 0.16263736263736264, "y0": 0.28826728826728826, "x1": 0.8736263736263736, "y1": 0.3014763014763015}, {"text": "emotion, mood and atmosphere rather than by external action. The traditional \u201ctwist\u201d", "x0": 0.16263736263736264, "y0": 0.3061383061383061, "x1": 0.8736263736263736, "y1": 0.31934731934731936}, {"text": "ending fell out of fashion, replaced with something more resonant and true to life.", "x0": 0.16263736263736264, "y0": 0.3247863247863248, "x1": 0.8736263736263736, "y1": 0.337995337995338}, {"text": "Irresolution became an important aspect of the story, beginnings and endings lopped", "x0": 0.16263736263736264, "y0": 0.34265734265734266, "x1": 0.8747252747252747, "y1": 0.35586635586635584}, {"text": "off, leaving only \u2018middles\u2019.", "x0": 0.16263736263736264, "y0": 0.3605283605283605, "x1": 0.3813186813186813, "y1": 0.37373737373737376}, {"text": "Later still, modernism yielded authors such as Conrad, Woolf and Joyce, who injected", "x0": 0.16263736263736264, "y0": 0.39316239316239315, "x1": 0.8747252747252747, "y1": 0.4063714063714064}, {"text": "the short story with such tropes as unreliable narrators, absurdism and a stream-of-", "x0": 0.16263736263736264, "y0": 0.411033411033411, "x1": 0.8747252747252747, "y1": 0.42424242424242425}, {"text": "consciousness narration. Meanwhile, in the Spanish-speaking countries of South", "x0": 0.16263736263736264, "y0": 0.4296814296814297, "x1": 0.8747252747252747, "y1": 0.4428904428904429}, {"text": "America, there emerged a strong tradition of magical realism in the short story, one that", "x0": 0.16263736263736264, "y0": 0.44755244755244755, "x1": 0.8747252747252747, "y1": 0.46076146076146074}, {"text": "thrives to this day.", "x0": 0.16263736263736264, "y0": 0.4654234654234654, "x1": 0.3087912087912088, "y1": 0.47863247863247865}, {"text": "And with postmodernism, stories became even more playful, subversive and untailored,", "x0": 0.16263736263736264, "y0": 0.49805749805749805, "x1": 0.8736263736263736, "y1": 0.5112665112665112}, {"text": "often reluctant to reveal their meaning, the neat narrative conclusion of traditional short", "x0": 0.16263736263736264, "y0": 0.515928515928516, "x1": 0.8747252747252747, "y1": 0.5291375291375291}, {"text": "stories spurned for this irresolution. Metafiction and experiment dominated the form.", "x0": 0.16263736263736264, "y0": 0.5345765345765345, "x1": 0.845054945054945, "y1": 0.5477855477855478}, {"text": "The modern short story is happy to find fertile material in the trivial, the seemingly", "x0": 0.16263736263736264, "y0": 0.5664335664335665, "x1": 0.8747252747252747, "y1": 0.5796425796425796}, {"text": "mundane qualities of human behaviour, the small but devastating moments, the", "x0": 0.16263736263736264, "y0": 0.585081585081585, "x1": 0.8747252747252747, "y1": 0.5982905982905983}, {"text": "moments that change a life. And some might say that behind this seemingly trivial", "x0": 0.16263736263736264, "y0": 0.602952602952603, "x1": 0.8736263736263736, "y1": 0.6161616161616161}, {"text": "detail, short stories tap into something else. For Charles E. May it is something spiritual,", "x0": 0.16263736263736264, "y0": 0.6208236208236209, "x1": 0.8736263736263736, "y1": 0.634032634032634}, {"text": "something beyond the everyday realm:", "x0": 0.16263736263736264, "y0": 0.6394716394716394, "x1": 0.4736263736263736, "y1": 0.6526806526806527}, {"text": "Moreover, the fact that a good short story communicates by a delicate and", "x0": 0.1901098901098901, "y0": 0.6721056721056721, "x1": 0.8472527472527472, "y1": 0.6853146853146853}, {"text": "tightly organised pattern of language \u2014 not by argument, direct statement,", "x0": 0.1912087912087912, "y0": 0.6899766899766899, "x1": 0.843956043956044, "y1": 0.7031857031857032}, {"text": "temporal plot, or moral clich\u00e9 \u2014 means that what the short story strives to", "x0": 0.1912087912087912, "y0": 0.7078477078477079, "x1": 0.8461538461538461, "y1": 0.721056721056721}, {"text": "communicate is too subtle, too ambiguous, too complex, too inchoate, to be", "x0": 0.1912087912087912, "y0": 0.7257187257187258, "x1": 0.8461538461538461, "y1": 0.7389277389277389}, {"text": "communicated by those rhetorical means by which nonfiction and long fiction", "x0": 0.1912087912087912, "y0": 0.7443667443667443, "x1": 0.8461538461538461, "y1": 0.7575757575757576}, {"text": "often communicate.", "x0": 0.1912087912087912, "y0": 0.7622377622377622, "x1": 0.34615384615384615, "y1": 0.7754467754467754}, {"text": "Other short stories are interested in the weird, the unusual, the macabre. The strange, the", "x0": 0.16263736263736264, "y0": 0.7948717948717948, "x1": 0.8747252747252747, "y1": 0.8080808080808081}, {"text": "terrible, the extreme. Often, they are peopled with characters who aren\u2019t conventional", "x0": 0.16263736263736264, "y0": 0.8127428127428128, "x1": 0.8736263736263736, "y1": 0.8259518259518259}, {"text": "heroes. And so the short story seems particularly adept at shining light on the", "x0": 0.16263736263736264, "y0": 0.8306138306138307, "x1": 0.8747252747252747, "y1": 0.8438228438228438}, {"text": "marginalised, the voiceless.", "x0": 0.16263736263736264, "y0": 0.8492618492618492, "x1": 0.38351648351648354, "y1": 0.8624708624708625}, {"text": "continues on page 4", "x0": 0.4351648351648352, "y0": 0.9145299145299145, "x1": 0.6021978021978022, "y1": 0.9269619269619269}, {"text": "-3-", "x0": 0.5021978021978022, "y0": 0.9432789432789432, "x1": 0.5340659340659341, "y1": 0.9526029526029526}], [{"text": "Question 1 (continued)", "x0": 0.13406593406593406, "y0": 0.0777000777000777, "x1": 0.3230769230769231, "y1": 0.09090909090909091}, {"text": "Perhaps Cort\u00e9zar captures it when he says: \u2018A story is meaningful when it ruptures its", "x0": 0.16263736263736264, "y0": 0.10955710955710955, "x1": 0.8747252747252747, "y1": 0.12276612276612277}, {"text": "own limits with an explosion of spiritual energy which suddenly illuminates something", "x0": 0.16263736263736264, "y0": 0.12742812742812742, "x1": 0.8747252747252747, "y1": 0.14063714063714064}, {"text": "far beyond that small and sometimes sordid anecdote which is being told.\u201d", "x0": 0.16263736263736264, "y0": 0.1452991452991453, "x1": 0.7593406593406593, "y1": 0.1585081585081585}, {"text": "Certainly, the stories that resonate the loudest build quietly and expertly towards some", "x0": 0.16263736263736264, "y0": 0.17793317793317792, "x1": 0.8747252747252747, "y1": 0.19114219114219114}, {"text": "devastating (though often underplayed) reveal or epiphany, as Joyce termed it, which is", "x0": 0.16263736263736264, "y0": 0.1958041958041958, "x1": 0.8747252747252747, "y1": 0.20901320901320902}, {"text": "somehow anticipated yet never wholly expected \u2014surprising yet inevitable. But of", "x0": 0.16263736263736264, "y0": 0.21445221445221446, "x1": 0.8769230769230769, "y1": 0.22766122766122765}, {"text": "course, the form is a dynamic, versatile one, and stories that shun epiphanies have a", "x0": 0.16263736263736264, "y0": 0.23232323232323232, "x1": 0.8747252747252747, "y1": 0.24553224553224554}, {"text": "delight all of their own.", "x0": 0.16263736263736264, "y0": 0.2501942501942502, "x1": 0.3505494505494505, "y1": 0.2634032634032634}, {"text": "Tom Fowler", "x0": 0.3120879120879121, "y0": 0.289044289044289, "x1": 0.41208791208791207, "y1": 0.29914529914529914}, {"text": "Extract from What is a Short Story?", "x0": 0.3131868131868132, "y0": 0.3162393162393162, "x1": 0.6010989010989011, "y1": 0.32944832944832947}, {"text": "Question 1 (25 marks)", "x0": 0.13406593406593406, "y0": 0.36596736596736595, "x1": 0.31758241758241756, "y1": 0.37839937839937837}, {"text": "In your response to parts (a) and (b), draw on your understanding of the module Literary", "x0": 0.13406593406593406, "y0": 0.39704739704739705, "x1": 0.845054945054945, "y1": 0.41025641025641024}, {"text": "Worlds and the extract provided.", "x0": 0.13406593406593406, "y0": 0.4133644133644134, "x1": 0.3967032967032967, "y1": 0.42657342657342656}, {"text": "Use Text 1 to answer this part. 15", "x0": 0.1824175824175824, "y0": 0.4444444444444444, "x1": 0.8791208791208791, "y1": 0.45765345765345766}, {"text": "(a)", "x0": 0.13406593406593406, "y0": 0.44522144522144524, "x1": 0.15494505494505495, "y1": 0.45765345765345766}, {"text": "Use the extract to inform your construction of a literary world using TWO", "x0": 0.1824175824175824, "y0": 0.4763014763014763, "x1": 0.7791208791208791, "y1": 0.48951048951048953}, {"text": "distinct forms to offer different perspectives on the significance of arrival.", "x0": 0.1813186813186813, "y0": 0.48329448329448327, "x1": 0.7769230769230769, "y1": 0.5097125097125097}, {"text": "(b)", "x0": 0.13406593406593406, "y0": 0.5547785547785548, "x1": 0.15604395604395604, "y1": 0.567987567987568}, {"text": "To what extent has the use of TWO distinct forms shaped meaning in your", "x0": 0.1813186813186813, "y0": 0.5547785547785548, "x1": 0.7824175824175824, "y1": 0.567987567987568}, {"text": "construction of a literary world in part (a)? 10", "x0": 0.1813186813186813, "y0": 0.5625485625485626, "x1": 0.8824175824175824, "y1": 0.5889665889665889}, {"text": "In your response you should refer to your use of the extract to inform", "x0": 0.1824175824175824, "y0": 0.6021756021756022, "x1": 0.7384615384615385, "y1": 0.6153846153846154}, {"text": "your choices.", "x0": 0.1813186813186813, "y0": 0.6091686091686092, "x1": 0.2868131868131868, "y1": 0.6355866355866356}, {"text": "End of Section I", "x0": 0.45054945054945056, "y0": 0.8010878010878011, "x1": 0.5868131868131868, "y1": 0.8111888111888111}], [{"text": "Section II \u2014 Electives", "x0": 0.13406593406593406, "y0": 0.0644910644910645, "x1": 0.34175824175824177, "y1": 0.07614607614607614}, {"text": "25 marks", "x0": 0.13406593406593406, "y0": 0.09867909867909867, "x1": 0.21318681318681318, "y1": 0.108003108003108}, {"text": "Attempt ONE question from Questions 2 - 6", "x0": 0.13406593406593406, "y0": 0.11344211344211344, "x1": 0.510989010989011, "y1": 0.12665112665112666}, {"text": "Allow about 1 hour for this section", "x0": 0.13406593406593406, "y0": 0.13053613053613053, "x1": 0.42967032967032964, "y1": 0.13986013986013987}, {"text": "Answer the question in the English Extension 1 Writing Booklet. Extra writing booklets are", "x0": 0.12967032967032968, "y0": 0.15773115773115773, "x1": 0.8725274725274725, "y1": 0.17715617715617715}, {"text": "available if required.", "x0": 0.13406593406593406, "y0": 0.17715617715617715, "x1": 0.2989010989010989, "y1": 0.19036519036519037}, {"text": "Your answer will be assessed on how well you:", "x0": 0.13406593406593406, "y0": 0.21367521367521367, "x1": 0.5142857142857142, "y1": 0.22688422688422688}, {"text": "= demonstrate understanding of the ideas and values of Literary Worlds and how they are", "x0": 0.13406593406593406, "y0": 0.22843822843822845, "x1": 0.8857142857142857, "y1": 0.25485625485625485}, {"text": "shaped and reflected in texts", "x0": 0.1824175824175824, "y0": 0.25252525252525254, "x1": 0.4098901098901099, "y1": 0.26573426573426573}, {"text": "= craft a sustained composition appropriate to the question, demonstrating control of the", "x0": 0.13406593406593406, "y0": 0.26728826728826727, "x1": 0.8758241758241758, "y1": 0.2937062937062937}, {"text": "of language.", "x0": 0.21318681318681318, "y0": 0.2913752913752914, "x1": 0.310989010989011, "y1": 0.3045843045843046}, {"text": "Question 2 \u2014 Elective 1: Literary Homelands (25 marks)", "x0": 0.13406593406593406, "y0": 0.34887334887334887, "x1": 0.6186813186813187, "y1": 0.3620823620823621}, {"text": "Literary homelands are not black and white.", "x0": 0.13406593406593406, "y0": 0.37995337995337997, "x1": 0.4868131868131868, "y1": 0.39316239316239315}, {"text": "To what extent does this reflect your understanding of the elective?", "x0": 0.13406593406593406, "y0": 0.40559440559440557, "x1": 0.6747252747252748, "y1": 0.4188034188034188}, {"text": "In your response, refer to TWO of your prescribed texts and at least ONE text of your own", "x0": 0.13406593406593406, "y0": 0.43123543123543123, "x1": 0.8626373626373627, "y1": 0.4444444444444444}, {"text": "choosing.", "x0": 0.13406593406593406, "y0": 0.4491064491064491, "x1": 0.2098901098901099, "y1": 0.46231546231546233}, {"text": "The prescribed texts are:", "x0": 0.16373626373626374, "y0": 0.4902874902874903, "x1": 0.36043956043956044, "y1": 0.5034965034965035}, {"text": "+ Prose Fiction Aravind Adiga, The White Tiger", "x0": 0.16373626373626374, "y0": 0.5151515151515151, "x1": 0.6329670329670329, "y1": 0.5283605283605284}, {"text": "\u2014 EM Forster, A Passage to India", "x0": 0.34725274725274724, "y0": 0.5345765345765345, "x1": 0.6307692307692307, "y1": 0.5477855477855478}, {"text": "\u2014 Colm T\u00e9ibin, Brooklyn", "x0": 0.34505494505494505, "y0": 0.5563325563325563, "x1": 0.5582417582417583, "y1": 0.5695415695415695}, {"text": "+ Poetry \u2014 Eileen Chong, BurningRice", "x0": 0.16373626373626374, "y0": 0.6076146076146076, "x1": 0.5934065934065934, "y1": 0.6208236208236209}, {"text": "* Burning Rice", "x0": 0.3945054945054945, "y0": 0.6301476301476302, "x1": 0.5252747252747253, "y1": 0.6433566433566433}, {"text": "* Mid-autumn Mooncakes", "x0": 0.3945054945054945, "y0": 0.6511266511266511, "x1": 0.6142857142857143, "y1": 0.6612276612276612}, {"text": "* My Hakka Grandmother", "x0": 0.3934065934065934, "y0": 0.6728826728826729, "x1": 0.6153846153846154, "y1": 0.6860916860916861}, {"text": "* Shophouse, Victoria Street", "x0": 0.3934065934065934, "y0": 0.6938616938616938, "x1": 0.6329670329670329, "y1": 0.7070707070707071}, {"text": "* Chinese Ginseng", "x0": 0.3934065934065934, "y0": 0.7156177156177156, "x1": 0.5560439560439561, "y1": 0.7288267288267288}, {"text": "* Winter Meeting", "x0": 0.3934065934065934, "y0": 0.7365967365967366, "x1": 0.545054945054945, "y1": 0.7498057498057498}, {"text": "* Singapore", "x0": 0.3945054945054945, "y0": 0.7583527583527584, "x1": 0.5010989010989011, "y1": 0.7715617715617715}, {"text": "*Drama \u2014 Andrew Bovell, The Secret River [by Kate Grenville \u2014 An", "x0": 0.16373626373626374, "y0": 0.797979797979798, "x1": 0.8373626373626374, "y1": 0.8111888111888111}, {"text": "adaptation for the stage by Andrew Bovell]", "x0": 0.37142857142857144, "y0": 0.8166278166278166, "x1": 0.7197802197802198, "y1": 0.8298368298368298}, {"text": "+ Film \u2014 Sarah Gavron, Brick Lane", "x0": 0.16373626373626374, "y0": 0.8547008547008547, "x1": 0.5813186813186814, "y1": 0.8663558663558664}], [{"text": "Question 3 \u2014 Elective 2: Worlds of Upheaval (25 marks)", "x0": 0.13406593406593406, "y0": 0.07692307692307693, "x1": 0.6153846153846154, "y1": 0.09013209013209013}, {"text": "Worlds of upheaval are not black and white.", "x0": 0.13406593406593406, "y0": 0.12121212121212122, "x1": 0.489010989010989, "y1": 0.13442113442113443}, {"text": "To what extent does this reflect your understanding of the elective?", "x0": 0.13406593406593406, "y0": 0.14685314685314685, "x1": 0.6747252747252748, "y1": 0.16006216006216006}, {"text": "In your response, refer to TWO of your prescribed texts and at least ONE text of your own", "x0": 0.13406593406593406, "y0": 0.1717171717171717, "x1": 0.8626373626373627, "y1": 0.18492618492618493}, {"text": "choosing.", "x0": 0.13406593406593406, "y0": 0.19036519036519037, "x1": 0.2098901098901099, "y1": 0.20357420357420358}, {"text": "The prescribed texts are:", "x0": 0.16373626373626374, "y0": 0.2400932400932401, "x1": 0.36043956043956044, "y1": 0.2533022533022533}, {"text": "+ Prose Fiction \u2014 Elizabeth Gaskell, North and South", "x0": 0.16373626373626374, "y0": 0.2680652680652681, "x1": 0.656043956043956, "y1": 0.2804972804972805}, {"text": "\u2014 Mary Shelley, Frankenstein", "x0": 0.34395604395604396, "y0": 0.289044289044289, "x1": 0.5956043956043956, "y1": 0.30225330225330227}, {"text": "\u2014 Madeleine Thien, Do Not Say We Have Nothing", "x0": 0.34395604395604396, "y0": 0.3108003108003108, "x1": 0.7593406593406593, "y1": 0.32400932400932403}, {"text": "+ Poetry \u2014 Seamus Heaney, Opened Ground: Poems 1966-1996", "x0": 0.16373626373626374, "y0": 0.35353535353535354, "x1": 0.7978021978021979, "y1": 0.3667443667443667}, {"text": "* Digging", "x0": 0.37142857142857144, "y0": 0.3745143745143745, "x1": 0.45164835164835165, "y1": 0.3877233877233877}, {"text": "* The Strand at Lough Beg", "x0": 0.37252747252747254, "y0": 0.3962703962703963, "x1": 0.5879120879120879, "y1": 0.4094794094794095}, {"text": "* Casualty", "x0": 0.37252747252747254, "y0": 0.4172494172494173, "x1": 0.45604395604395603, "y1": 0.43045843045843046}, {"text": "* Funeral Rights", "x0": 0.37252747252747254, "y0": 0.439005439005439, "x1": 0.5054945054945055, "y1": 0.4522144522144522}, {"text": "* from Whatever You Say Say Nothing", "x0": 0.37142857142857144, "y0": 0.45998445998445997, "x1": 0.6802197802197802, "y1": 0.4731934731934732}, {"text": "* Tryptich", "x0": 0.37252747252747254, "y0": 0.48174048174048173, "x1": 0.45274725274725275, "y1": 0.494949494949495}, {"text": "~ Samuel Beckett, Waiting for Godot", "x0": 0.34175824175824177, "y0": 0.5244755244755245, "x1": 0.6417582417582418, "y1": 0.5376845376845377}, {"text": "+ Film ~ Fritz Lang, Metropolis", "x0": 0.16373626373626374, "y0": 0.5672105672105672, "x1": 0.5395604395604395, "y1": 0.5804195804195804}], [{"text": "Question 4 \u2014 Elective 3: Reimagined Worlds (25 marks)", "x0": 0.13406593406593406, "y0": 0.07381507381507381, "x1": 0.6153846153846154, "y1": 0.08702408702408702}, {"text": "Reimagined worlds are not black and white.", "x0": 0.13406593406593406, "y0": 0.11965811965811966, "x1": 0.4868131868131868, "y1": 0.13286713286713286}, {"text": "To what extent does this reflect your understanding of the elective?", "x0": 0.13406593406593406, "y0": 0.1452991452991453, "x1": 0.6747252747252748, "y1": 0.1585081585081585}, {"text": "In your response, refer to TWO of your prescribed texts and at least ONE text of your own", "x0": 0.13406593406593406, "y0": 0.17016317016317017, "x1": 0.8626373626373627, "y1": 0.18337218337218336}, {"text": "choosing.", "x0": 0.13406593406593406, "y0": 0.18803418803418803, "x1": 0.2098901098901099, "y1": 0.20124320124320125}, {"text": "The prescribed texts are:", "x0": 0.16373626373626374, "y0": 0.23620823620823622, "x1": 0.36043956043956044, "y1": 0.2494172494172494}, {"text": "+ Prose Fiction \u2014 Italo Calvino, [fon a Night a Traveller", "x0": 0.16373626373626374, "y0": 0.2634032634032634, "x1": 0.7593406593406593, "y1": 0.2766122766122766}, {"text": "\u2014 Ursula Le Guin, Left Hand of Darkness", "x0": 0.34725274725274724, "y0": 0.2851592851592852, "x1": 0.689010989010989, "y1": 0.29836829836829837}, {"text": "\u2014 Jonathan Swift, Travels", "x0": 0.34945054945054943, "y0": 0.3061383061383061, "x1": 0.6483516483516484, "y1": 0.3185703185703186}, {"text": "* Poetry \u2014 Samuel Taylor Coleridge, Samuel Taylor Coleridge: The", "x0": 0.16373626373626374, "y0": 0.34887334887334887, "x1": 0.8307692307692308, "y1": 0.3620823620823621}, {"text": "Complete Poems", "x0": 0.3758241758241758, "y0": 0.3706293706293706, "x1": 0.5098901098901099, "y1": 0.3838383838383838}, {"text": "* The Eolian Harp", "x0": 0.37142857142857144