 "x0": 0.12197802197802197, "y0": 0.36363636363636365, "x1": 0.3054945054945055, "y1": 0.37684537684537683}, {"text": "\u2018An exploration of the human experience offers new insights into the world.", "x0": 0.12087912087912088, "y0": 0.3986013986013986, "x1": 0.7263736263736263, "y1": 0.41181041181041184}, {"text": "Discuss how the composer of your prescribed text represents the statement above.", "x0": 0.12197802197802197, "y0": 0.43434343434343436, "x1": 0.7802197802197802, "y1": 0.44755244755244755}, {"text": "The prescribed texts are listed on pages 9-10.", "x0": 0.12087912087912088, "y0": 0.48717948717948717, "x1": 0.4846153846153846, "y1": 0.5003885003885004}], [{"text": "Question 6 (continued)", "x0": 0.12197802197802197, "y0": 0.08857808857808858, "x1": 0.3054945054945055, "y1": 0.10178710178710179}, {"text": "The prescribed texts are:", "x0": 0.12087912087912088, "y0": 0.12432012432012432, "x1": 0.31758241758241756, "y1": 0.13752913752913754}, {"text": "+ Prose Fiction", "x0": 0.12197802197802197, "y0": 0.16006216006216006, "x1": 0.24505494505494504, "y1": 0.16938616938616938}, {"text": "\u2014 Anthony Doerr, All the Light We Cannot See", "x0": 0.12087912087912088, "y0": 0.1864801864801865, "x1": 0.4967032967032967, "y1": 0.19968919968919968}, {"text": "~ Amanda Lohrey, Vertigo", "x0": 0.12087912087912088, "y0": 0.21367521367521367, "x1": 0.3373626373626374, "y1": 0.22688422688422688}, {"text": "\u2014 George Orwell, Nineteen Eighty-Four", "x0": 0.12087912087912088, "y0": 0.24087024087024086, "x1": 0.44285714285714284, "y1": 0.2540792540792541}, {"text": "\u2014Favel Parrett, Past the Shallows", "x0": 0.12087912087912088, "y0": 0.2680652680652681, "x1": 0.3923076923076923, "y1": 0.2804972804972805}, {"text": "+ Poetry", "x0": 0.12197802197802197, "y0": 0.32323232323232326, "x1": 0.189010989010989, "y1": 0.3356643356643357}, {"text": "\u2014 Rosemary Dobson, Rosemary Dobson Collected", "x0": 0.12527472527472527, "y0": 0.34965034965034963, "x1": 0.5318681318