824, "y0": 0.6744366744366744, "x1": 0.2989010989010989, "y1": 0.6845376845376845}, {"text": "Beach Burial", "x0": 0.1824175824175824, "y0": 0.6930846930846931, "x1": 0.2857142857142857, "y1": 0.7031857031857032}, {"text": "+ Drama", "x0": 0.12197802197802197, "y0": 0.7482517482517482, "x1": 0.19230769230769232, "y1": 0.7575757575757576}, {"text": "\u2014 Jane Harrison, Rainbow's End, from Vivienne Cleven et al., Contemporary Indigenous", "x0": 0.12527472527472527, "y0": 0.7746697746697747, "x1": 0.8373626373626374, "y1": 0.7878787878787878}, {"text": "Plays", "x0": 0.12087912087912088, "y0": 0.7925407925407926, "x1": 0.16483516483516483, "y1": 0.8057498057498057}, {"text": "\u2014 Arthur Miller, The Crucible", "x0": 0.12087912087912088, "y0": 0.8197358197358198, "x1": 0.36043956043956044, "y1": 0.8321678321678322}], [{"text": "+ Shakespearean Drama", "x0": 0.12197802197802197, "y0": 0.08935508935508936, "x1": 0.3274725274725275, "y1": 0.10178710178710179}, {"text": "\u2014 William Shakespeare, The Merchant of Venice", "x0": 0.12087912087912088, "y0": 0.11577311577311578, "x1": 0.512087912087912, "y1": 0.128982128982129}, {"text": "+ Nonfiction", "x0": 0.12197802197802197, "y0": 0.17094017094017094, "x1": 0.2230769230769231, "y1": 0.18026418026418026}, {"text": "\u2014Tim Winton, The Boy Behind the Curtain", "x0": 0.12087912087912088, "y0": 0.19735819735819735, "x1": 0.4703296703296703, "y1": 0.21056721056721056}, {"text": "\u00a9 Havoc: A Life in Accidents", "x0": 0.15164835164835164, "y0": 0.22533022533022534, "x1": 0.4032967032967033, "y1": 0.23543123543123542}, {"text": "Betsy", "x0": 0.1824175824175824, "y0": 0.24475524475524477, "x1": 0.22637362637362637, "y1": 0.2571872571872572}, {"text": "\u00a9 Twice on Sundays", "x0": 0.15164835164835164, "y0": 0.26262626262626265, "x1": 0.32967032967032966, "y1": 0.27583527583527584}, {"text": "\u00a9 The Wait and the Flow", "x0": 0.15164835164835164, "y0": 0.28205128205128205, "x1": 0.3659340659340659, "y1": 0.29215229215229216}, {"text": "In the Shadow of the Hospital", "x0": 0.1824175824175824, "y0": 0.29215229215229216, "x1": 0.4208791208791209, "y1": 0.3185703185703186}, {"text": "\u00a9 The Demon Shark", "x0": 0.15164835164835164, "y0": 0.31934731934731936, "x1": 0.32857142857142857, "y1": 0.32944832944832947}, {"text": "\u00a9 Barefoot in the Temple of Art", "x0": 0.15164835164835164, "y0": 0.337995337995338, "x1": 0.421978021978022, "y1": 0.35120435120435123}, {"text": "\u2014Malala Yousafzai and Christina Lamb, J am Malala", "x0": 0.12087912087912088, "y0": 0.3822843822843823, "x1": 0.5527472527472528, "y1": 0.3947163947163947}, {"text": "+ Film", "x0": 0.12197802197802197, "y0": 0.43745143745143744, "x1": 0.17252747252747253, "y1": 0.4467754467754468}, {"text": "\u2014 Stephen Daldry, Billy Elliot", "x0": 0.12527472527472527, "y0": 0.46386946386946387, "x1": 0.3648351648351648, "y1": 0.47707847707847706}, {"text": "+ Media", "x0": 0.12197802197802197, "y0": 0.519036519036519, "x1": 0.18681318681318682, "y1": 0.5283605283605284}, {"text": "\u2014 Ivan", "x0": 0.12087912087912088, "y0": 0.5462315462315462, "x1": 0.17142857142857143, "y1": 0.5555555555555556}, {"text": "* Go Back to Where You Came From", "x0": 0.15164835164835164, "y0": 0.5742035742035742, "x1": 0.46593406593406594, "y1": 0.5843045843045843}, {"text": "~ Series 1: Episodes 1, 2 and 3", "x0": 0.1813186813186813, "y0": 0.6006216006216006, "x1": 0.42637362637362636, "y1": 0.6138306138306139}, {"text": "and", "x0": 0.1824175824175824, "y0": 0.6285936285936286, "x1": 0.2098901098901099, "y1": 0.6386946386946387}, {"text": "\u00a9 The Response", "x0": 0.15164835164835164, "y0": 0.6565656565656566, "x1": 0.2923076923076923, "y1": 0.6697746697746698}, {"text": "\u2014 Lucy Walker, Waste Land", "x0": 0.1813186813186813, "y0": 0.6837606837606838, "x1": 0.4087912087912088, "y1": 0.696969696969697}, {"text": "10", "x0": 0.49230769230769234, "y0": 0.9292929292929293, "x1": 0.5087912087912088, "y1": 0.9378399378399378}], [{"text": "STUDENT NUMBER", "x0": 0.6054945054945055, "y0": 0.11965811965811966, "x1": 0.8175824175824176, "y1": 0.13131313131313133}, {"text": "ABBOTSLEIGH", "x0": 0.12197802197802197, "y0": 0.2400932400932401, "x1": 0.2923076923076923, "y1": 0.2517482517482518}, {"text": "2024 HSC TRIAL EXAMINATION", "x0": 0.12197802197802197, "y0": 0.3006993006993007, "x1": 0.5340659340659341, "y1": 0.3139083139083139}, {"text": "English Advanced", "x0": 0.12197802197802197, "y0": 0.3356643356643357, "x1": 0.4054945054945055, "y1": 0.358974358974359}, {"text": "Paper 1 \u2014 Texts and Human Experiences", "x0": 0.12197802197802197, "y0": 0.40714840714840717, "x1": 0.7032967032967034, "y1": 0.4289044289044289}, {"text": "STIMULUS BOOKLET", "x0": 0.12307692307692308, "y0": 0.4763014763014763, "x1": 0.4714285714285714, "y1": 0.4933954933954934}, {"text": "Section I", "x0": 0.12197802197802197, "y0": 0.5135975135975136, "x1": 0.21978021978021978, "y1": 0.5268065268065268}, {"text": "Text One \u2014 Poem", "x0": 0.1824175824175824, "y0": 0.5804195804195804, "x1": 0.3263736263736264, "y1": 0.5897435897435898}, {"text": "Text Two \u2014 Letter.", "x0": 0.1824175824175824, "y0": 0.5990675990675991, "x1": 0.33186813186813185, "y1": 0.6083916083916084}, {"text": "Text Three \u2014 Non-fiction po:", "x0": 0.1824175824175824, "y0": 0.616938616938617, "x1": 0.4153846153846154, "y1": 0.6301476301476302}, {"text": "Text Four \u2014 Prose fiction extract.", "x0": 0.1824175824175824, "y0": 0.6355866355866356, "x1": 0.44945054945054946, "y1": 0.6456876456876457}, {"text": "Text Five \u2014 Discursive", "x0": 0.1824175824175824, "y0": 0.655011655011655, "x1": 0.36813186813186816, "y1": 0.6651126651126651}], [{"text": "Text 1\u2014 Poem", "x0": 0.12197802197802197, "y0": 0.08935508935508936, "x1": 0.24175824175824176, "y1": 0.09867909867909867}, {"text": "Descending the Extreme South Mountain", "x0": 0.12087912087912088, "y0": 0.11655011655011654, "x1": 0.46593406593406594, "y1": 0.128982128982129}, {"text": "We come down the green-grey jade hill,", "x0": 0.12197802197802197, "y0": 0.14296814296814297, "x1": 0.44395604395604393, "y1": 0.1561771561771562}, {"text": "The mountain moon accompanies us home.", "x0": 0.12087912087912088, "y0": 0.17016317016317017, "x1": 0.46923076923076923, "y1": 0.18337218337218336}, {"text": "We turn and look back up the path:", "x0": 0.12197802197802197, "y0": 0.19735819735819735, "x1": 0.4032967032967033, "y1": 0.21056721056721056}, {"text": "Green, green, the sky; the horizontal, kingfisher-green line", "x0": 0.12197802197802197, "y0": 0.22455322455322455, "x1": 0.5923076923076923, "y1": 0.23776223776223776}, {"text": "of the hills is fading.", "x0": 0.11758241758241758, "y0": 0.24864024864024864, "x1": 0.2857142857142857, "y1": 0.26884226884226886}, {"text": "Holding each other\u2019s hands we reach the house in", "x0": 0.12197802197802197, "y0": 0.2789432789432789, "x1": 0.5208791208791209, "y1": 0.29215229215229216}, {"text": "the fields.", "x0": 0.12197802197802197, "y0": 0.3061383061383061, "x1": 0.1989010989010989, "y1": 0.3162393162393162}, {"text": "Little boys thrown open the gate of thorn branches,", "x0": 0.12197802197802197, "y0": 0.3333333333333333, "x1": 0.5318681318681319, "y1": 0.34654234654234656}, {"text": "The quiet path winds among dark bamboos,", "x0": 0.12087912087912088, "y0": 0.3605283605283605, "x1": 0.4725274725274725, "y1": 0.37373737373737376}, {"text": "Creepers, bright with new green, brush our garments.", "x0": 0.12197802197802197, "y0": 0.3877233877233877, "x1": 0.5494505494505495, "y1": 0.40093240093240096}, {"text": "Our words are happy, rest is in them.", "x0": 0.12197802197802197, "y0": 0.4149184149184149, "x1": 0.4175824175824176, "y1": 0.4281274281274281}, {"text": "Of an excellent flavour, the wine! We scatter the dregs of", "x0": 0.12197802197802197, "y0": 0.439005439005439, "x1": 0.5857142857142857, "y1": 0.45843045843045843}, {"text": "it contentedly.", "x0": 0.12197802197802197, "y0": 0.4693084693084693, "x1": 0.23516483516483516, "y1": 0.4825174825174825}, {"text": "We sing songs for a long time; we chant them to the wind", "x0": 0.12197802197802197, "y0": 0.4965034965034965, "x1": 0.5857142857142857, "y1": 0.5097125097125097}, {"text": "in the pine-trees.", "x0": 0.12197802197802197, "y0": 0.5236985236985237, "x1": 0.25384615384615383, "y1": 0.5369075369075369}, {"text": "By the time the songs are finished, the stars in Heaven\u2019s", "x0": 0.12197802197802197, "y0": 0.5508935508935509, "x1": 0.5725274725274725, "y1": 0.5641025641025641}, {"text": "River are few.", "x0": 0.12197802197802197, "y0": 0.578088578088578, "x1": 0.23406593406593407, "y1": 0.5881895881895882}, {"text": "lam tipsy. My friend is continuously merry.", "x0": 0.12197802197802197, "y0": 0.6045066045066045, "x1": 0.47692307692307695, "y1": 0.6177156177156177}, {"text": "In fact, we are so exhilarated that we both forget this", "x0": 0.12197802197802197, "y0": 0.6317016317016317, "x1": 0.545054945054945, "y1": 0.6449106449106449}, {"text": "complicated machine, the world.", "x0": 0.12197802197802197, "y0": 0.6588966588966589, "x1": 0.3824175824175824, "y1": 0.6721056721056721}, {"text": "LIPO (701-762)", "x0": 0.7263736263736263, "y0": 0.714063714063714, "x1": 0.8593406593406593, "y1": 0.7264957264957265}, {"text": "Translated by", "x0": 0.7252747252747253, "y0": 0.7397047397047397, "x1": 0.8076923076923077, "y1": 0.7498057498057498}, {"text": "Amy Lowell", "x0": 0.7263736263736263, "y0": 0.7855477855477856, "x1": 0.8010989010989011, "y1": 0.7956487956487956}], [{"text": "Text 2 \u2014 Letter", "x0": 0.12197802197802197, "y0": 0.08935508935508936, "x1": 0.24835164835164836, "y1": 0.09867909867909867}, {"text": "Author John Steinbeck received a letter from his 14-year-old son, Thom from boarding", "x0": 0.12087912087912088, "y0": 0.10722610722610723, "x1": 0.8219780219780219, "y1": 0.13364413364413363}, {"text": "school who told of Susan, a young girl he had fallen in love with, This is his father\u2019s reply.", "x0": 0.12087912087912088, "y0": 0.13364413364413363, "x1": 0.8461538461538461, "y1": 0.14685314685314685}, {"text": "November 10, 1958", "x0": 0.12197802197802197, "y0": 0.18803418803418803, "x1": 0.2802197802197802, "y1": 0.20046620046620048}, {"text": "Dear Thom:", "x0": 0.12197802197802197, "y0": 0.21522921522921523, "x1": 0.2164835164835165, "y1": 0.22533022533022534}, {"text": "We had your letter this morning, I will answer it from my point of view.", "x0": 0.12197802197802197, "y0": 0.2338772338772339, "x1": 0.701098901098901, "y1": 0.2602952602952603}, {"text": "First \u2014 if you are in love - that\u2019s a good thing \u2014 that\u2019s about the best thing that can happen to", "x0": 0.12197802197802197, "y0": 0.26961926961926963, "x1": 0.8626373626373627, "y1": 0.2828282828282828}, {"text": "anyone. Don\u2019t let anyone make it small or light to you.", "x0": 0.12197802197802197, "y0": 0.2867132867132867, "x1": 0.5615384615384615, "y1": 0.2999222999222999}, {"text": "Second \u2014 There are several kinds of love. One is a selfish, mean, grasping, egotistical thing", "x0": 0.12197802197802197, "y0": 0.30536130536130535, "x1": 0.8549450549450549, "y1": 0.3317793317793318}, {"text": "which uses love for self-importance. This is the ugly and crippling kind. The other is an", "x0": 0.12197802197802197, "y0": 0.3317793317793318, "x1": 0.8263736263736263, "y1": 0.34498834498834496}, {"text": "outpouring of everything good in you \u2014 of kindness and consideration and respect \u2014 not only", "x0": 0.12197802197802197, "y0": 0.34965034965034963, "x1": 0.865934065934066, "y1": 0.3628593628593629}, {"text": "the social respect of manners but the greater respect which is recognition of another person as", "x0": 0.12197802197802197, "y0": 0.358974358974359, "x1": 0.8747252747252747, "y1": 0.3853923853923854}, {"text": "unique and valuable. The first kind can make you sick and small and weak but the second can", "x0": 0.12197802197802197, "y0": 0.38461538461538464, "x1": 0.8758241758241758, "y1": 0.3978243978243978}, {"text": "release in you strength, and courage and goodness and even wisdom you didn\u2019t know you", "x0": 0.12197802197802197, "y0": 0.4024864024864025, "x1": 0.843956043956044, "y1": 0.4156954156954157}, {"text": "had.", "x0": 0.12197802197802197, "y0": 0.42035742035742035, "x1": 0.15384615384615385, "y1": 0.43045843045843046}, {"text": "You say this is not puppy love. If you feel so deeply \u2014 of course it isn\u2019t puppy love.", "x0": 0.12197802197802197, "y0": 0.44755244755244755, "x1": 0.7923076923076923, "y1": 0.46076146076146074}, {"text": "But I don\u2019t think you were asking me what you feel. You know better than anyone. What you", "x0": 0.12197802197802197, "y0": 0.47474747474747475, "x1": 0.8736263736263736, "y1": 0.48795648795648794}, {"text": "wanted me to help you with is what to do about it \u2014 and that I can tell you.", "x0": 0.12197802197802197, "y0": 0.4926184926184926, "x1": 0.7186813186813187, "y1": 0.5058275058275058}, {"text": "Glory in it for one thing and be very glad and grateful for it.", "x0": 0.12197802197802197, "y0": 0.519036519036519, "x1": 0.6032967032967033, "y1": 0.5322455322455323}, {"text": "The object of love is the best and most beautiful. Try to live up to it.", "x0": 0.12087912087912088, "y0": 0.5376845376845377, "x1": 0.6692307692307692, "y1": 0.5641025641025641}, {"text": "If you love someone \u2014 there is no possible harm in saying so \u2014 only you must remember that", "x0": 0.12197802197802197, "y0": 0.5734265734265734, "x1": 0.865934065934066, "y1": 0.5866355866355867}, {"text": "some people are very shy and sometimes the saying must take the shyness into consideration.", "x0": 0.12197802197802197, "y0": 0.5912975912975913, "x1": 0.8714285714285714, "y1": 0.6045066045066045}, {"text": "Girls have a way of knowing or feeling what you feel, but they usually like to hear it also.", "x0": 0.12197802197802197, "y0": 0.6184926184926185, "x1": 0.8428571428571429, "y1": 0.6317016317016317}, {"text": "It sometimes happens that what you feel is not returned for one reason or another \u2014 but that", "x0": 0.12197802197802197, "y0": 0.6456876456876457, "x1": 0.8549450549450549, "y1": 0.6588966588966589}, {"text": "does not make your feeling less valuable and good.", "x0": 0.12197802197802197, "y0": 0.6635586635586636, "x1": 0.5318681318681319, "y1": 0.6767676767676768}, {"text": "Lastly, I know your feeling because I have it and I\u2019m glad you have it.", "x0": 0.12197802197802197, "y0": 0.6907536907536908, "x1": 0.6868131868131868, "y1": 0.703962703962704}, {"text": "And don\u2019t worry about losing. If it is right, it happens \u2014 The main thing is not to hurry.", "x0": 0.12087912087912088, "y0": 0.717948717948718, "x1": 0.8197802197802198, "y1": 0.7311577311577312}, {"text": "Nothing good gets away.", "x0": 0.12197802197802197, "y0": 0.7358197358197358, "x1": 0.3208791208791209, "y1": 0.749028749028749}, {"text": "Love,", "x0": 0.12197802197802197, "y0": 0.790986790986791, "x1": 0.16593406593406593, "y1": 0.8026418026418026}, {"text": "Fa", "x0": 0.12197802197802197, "y0": 0.8181818181818182, "x1": 0.14065934065934066, "y1": 0.8275058275058275}, {"text": "JOHN STEINBECK", "x0": 0.710989010989011, "y0": 0.8445998445998446, "x1": 0.8769230769230769, "y1": 0.853923853923854}], [{"text": "Text 3 \u2014 Non-fiction postscript from The Tattooist of Auschwitz", "x0": 0.12197802197802197, "y0": 0.08935508935508936, "x1": 0.654945054945055, "y1": 0.10178710178710179}, {"text": "I'm in the lounge of the home of an elderly man. I don\u2019t know him well yet, but I\u2019ve quickly", "x0": 0.12197802197802197, "y0": 0.11655011655011654, "x1": 0.878021978021978, "y1": 0.14063714063714064}, {"text": "come to know his dogs, Tootsie and Bam Bam \u2014 one the size of a pony and the other smaller", "x0": 0.12197802197802197, "y0": 0.13364413364413363, "x1": 0.8791208791208791, "y1": 0.1585081585081585}, {"text": "than my cat. Thankfully I\u2019ve won them over and right now they are asleep.", "x0": 0.12197802197802197, "y0": 0.1592851592851593, "x1": 0.7230769230769231, "y1": 0.17249417249417248}, {"text": "I look away for a moment. I must tell him.", "x0": 0.12197802197802197, "y0": 0.19502719502719504, "x1": 0.46153846153846156, "y1": 0.20823620823620823}, {"text": "\u201cYou do know I\u2019m not Jewish?\u201d", "x0": 0.12307692307692308, "y0": 0.22999222999222999, "x1": 0.3758241758241758, "y1": 0.2400932400932401}, {"text": "An hour has passed since we met. The elderly man in the chair opposite me gives an impatient", "x0": 0.12087912087912088, "y0": 0.257964257964258, "x1": 0.878021978021978, "y1": 0.28205128205128205}, {"text": "but not unfriendly snort. He looks away, folds his fingers. His legs are crossed and the free foot", "x0": 0.12087912087912088, "y0": 0.2828282828282828, "x1": 0.878021978021978, "y1": 0.29603729603729606}, {"text": "raps a silent beat. His eyes look towards the window and the open space.", "x0": 0.12197802197802197, "y0": 0.2975912975912976, "x1": 0.7054945054945055, "y1": 0.317016317016317}, {"text": "he says finally, turning to me with a smile. \u2018That\u2019s why I want you.\u2019", "x0": 0.17582417582417584, "y0": 0.33644133644133645, "x1": 0.7230769230769231, "y1": 0.34965034965034963}, {"text": "Trelax a little. Maybe I am in the right place after all.", "x0": 0.12197802197802197, "y0": 0.3714063714063714, "x1": 0.5483516483516484, "y1": 0.38461538461538464}, {"text": "\u2018Do you know any Jews?\u201d", "x0": 0.12307692307692308, "y0": 0.40714840714840717, "x1": 0.32967032967032966, "y1": 0.42035742035742035}, {"text": "T come up with one. \u2018I work with a girl named Bella. She\u2019s Jewish, I think.\u201d", "x0": 0.12197802197802197, "y0": 0.4421134421134421, "x1": 0.7285714285714285, "y1": 0.4553224553224553}, {"text": "m. \u2018Good! he says. \u2018You will have no", "x0": 0.5263736263736264, "y0": 0.47785547785547783, "x1": 0.878021978021978, "y1": 0.48795648795648794}, {"text": "I expect disdain but instead receive enthu:", "x0": 0.12197802197802197, "y0": 0.47785547785547783, "x1": 0.4956043956043956, "y1": 0.49106449106449107}, {"text": "preconceptions about what I tell you.\u2019 He paus", "x0": 0.12087912087912088, "y0": 0.4864024864024864, "x1": 0.4945054945054945, "y1": 0.5128205128205128}, {"text": "though searching for words. \u2018I don\u2019t want", "x0": 0.5439560439560439, "y0": 0.494949494949495, "x1": 0.878021978021978, "y1": 0.5081585081585082}, {"text": "any personal baggage bought to my story.\u201d", "x0": 0.12197802197802197, "y0": 0.5128205128205128, "x1": 0.46373626373626375, "y1": 0.526029526029526}, {"text": "He sits back. \u2018How quickly can you write?\u201d he asks.", "x0": 0.12197802197802197, "y0": 0.5477855477855478, "x1": 0.5384615384615384, "y1": 0.560994560994561}, {"text": "I'm confused. \u201cDo you have to be somewhere soon?\u201d", "x0": 0.12197802197802197, "y0": 0.5835275835275835, "x1": 0.5461538461538461, "y1": 0.5967365967365967}, {"text": "\u201cYes,\u201d he says, his gaze again returning to the open window. \u2018I need to be with Gita.\u201d", "x0": 0.12307692307692308, "y0": 0.6192696192696193, "x1": 0.8043956043956044, "y1": 0.6324786324786325}, {"text": "I never met Gita. It was her death, and Lale\u2019s need to join her, that pushed him to tell his story.", "x0": 0.12197802197802197, "y0": 0.6542346542346542, "x1": 0.8769230769230769, "y1": 0.6674436674436675}, {"text": "He wanted it to be recorded so, in his words, \u2018It would never happen again.\u201d", "x0": 0.12197802197802197, "y0": 0.6721056721056721, "x1": 0.7318681318681318, "y1": 0.6853146853146853}, {"text": "After that first meeting, I visited Lale two or three times a week. The story took three years to", "x0": 0.12087912087912088, "y0": 0.7070707070707071, "x1": 0.878021978021978, "y1": 0.7202797202797203}, {"text": "untangle. I had to earn his trust, and it took time before he was willing to embark on the deep", "x0": 0.12197802197802197, "y0": 0.7249417249417249, "x1": 0.878021978021978, "y1": 0.7381507381507382}, {"text": "self-scrutiny that parts of his story required. We had become friends \u2014 no, more than friends;", "x0": 0.12197802197802197, "y0": 0.7428127428127428, "x1": 0.8769230769230769, "y1": 0.756021756021756}, {"text": "our lives became entwined as he shed the burden of guilt he had carried for over 50 years, the", "x0": 0.12197802197802197, "y0": 0.7606837606837606, "x1": 0.878021978021978, "y1": 0.7738927738927739}, {"text": "fear that he and Gita might be seen as collaborators of the Nazis. Part of Lale\u2019s burden passed", "x0": 0.12197802197802197, "y0": 0.7777777777777778, "x1": 0.878021978021978, "y1": 0.790986790986791}, {"text": "to me as I sat with him at his kitchen table, this dear man with trembling hands, his quivering", "x0": 0.12197802197802197, "y0": 0.7956487956487956, "x1": 0.878021978021978, "y1": 0.8088578088578089}, {"text": "voice, his eyes that still moistened 60 years after experiencing these most horrifying events in", "x0": 0.12197802197802197, "y0": 0.8135198135198135, "x1": 0.878021978021978, "y1": 0.8267288267288267}, {"text": "human history. It was spellbinding to sit with him. As the teller of Lale\u2019s story, it became", "x0": 0.12197802197802197, "y0": 0.8313908313908314, "x1": 0.878021978021978, "y1": 0.8445998445998446}, {"text": "important for me to identify how memory and history sometimes waltz in step to present a", "x0": 0.12197802197802197, "y0": 0.8484848484848485, "x1": 0.878021978021978, "y1": 0.8616938616938616}, {"text": "unique lesson in humanity.", "x0": 0.12197802197802197, "y0": 0.8663558663558664, "x1": 0.3362637362637363, "y1": 0.8795648795648796}, {"text": "HEATHER MORRIS", "x0": 0.701098901098901, "y0": 0.885003885003885, "x1": 0.8758241758241758, "y1": 0.8943278943278943}], [{"text": "Text 4 \u2014 Prose fiction extract", "x0": 0.12197802197802197, "y0": 0.08935508935508936, "x1": 0.36813186813186816, "y1": 0.09867909867909867}, {"text": "The Unlikely Pilgrimage of Harold Fry", "x0": 0.12307692307692308, "y0": 0.1250971250971251, "x1": 0.4472527472527473, "y1": 0.13752913752913754}, {"text": "Contrary to David's predictions, Queenie Hennessy had not turned out to be a socialist, feminist", "x0": 0.12197802197802197, "y0": 0.1592851592851593, "x1": 0.878021978021978, "y1": 0.17249417249417248}, {"text": "or lesbian. She was a stout, plain-looking woman with no waist and a handbag tucked over her", "x0": 0.12197802197802197, "y0": 0.17715617715617715, "x1": 0.8791208791208791, "y1": 0.19036519036519037}, {"text": "forearm. It was well known that Mr Napier considered women to be little more than ticking", "x0": 0.12197802197802197, "y0": 0.19502719502719504, "x1": 0.878021978021978, "y1": 0.20823620823620823}, {"text": "hormone bombs. So Queenie marked a new departure at the brewery, and one that Mr Napier", "x0": 0.12197802197802197, "y0": 0.21212121212121213, "x1": 0.8791208791208791, "y1": 0.22533022533022534}, {"text": "would not have made, had anyone other than her applied for the job.", "x0": 0.12197802197802197, "y0": 0.22999222999222999, "x1": 0.6703296703296703, "y1": 0.2432012432012432}, {"text": "Her manner was quiet and unassuming. Harold over-heard a young chap saying, \u201cYou forget", "x0": 0.12197802197802197, "y0": 0.26573426573426573, "x1": 0.878021978021978, "y1": 0.2789432789432789}, {"text": "she\u2019s a woman really.\u201d Within a matter of days there were reports that she had brought an", "x0": 0.12197802197802197, "y0": 0.2828282828282828, "x1": 0.878021978021978, "y1": 0.29603729603729606}, {"text": "unprecedented order to the financial department. But this did not seem to stop the", "x0": 0.12197802197802197, "y0": 0.3006993006993007, "x1": 0.878021978021978, "y1": 0.3139083139083139}, {"text": "impersonations and laughter that now filled the corridors. Harold hoped she didn\u2019t hear. He", "x0": 0.12197802197802197, "y0": 0.3185703185703186, "x1": 0.878021978021978, "y1": 0.3317793317793318}, {"text": "watched her sometimes in the canteen with her sandwiches wrapped in greaseproof paper. She", "x0": 0.12197802197802197, "y0": 0.32867132867132864, "x1": 0.878021978021978, "y1": 0.35275835275835277}, {"text": "had a way of sitting with the young secretaries and listening, as if she, or they, were not there", "x0": 0.12197802197802197, "y0": 0.3457653457653458, "x1": 0.878021978021978, "y1": 0.36985236985236986}, {"text": "at all.", "x0": 0.12197802197802197, "y0": 0.3714063714063714, "x1": 0.16373626373626374, "y1": 0.3815073815073815}, {"text": "It was when he picked up his briefcase to go home one evening that Harold heard a snuffling", "x0": 0.12197802197802197, "y0": 0.40714840714840717, "x1": 0.878021978021978, "y1": 0.42035742035742035}, {"text": "sound from behind a cupboard door. He tried to walk past, but the noise didn\u2019t stop. He turned", "x0": 0.12197802197802197, "y0": 0.42424242424242425, "x1": 0.878021978021978, "y1": 0.43745143745143744}, {"text": "back. The sound had come again, more like a sob, and he had discovered a squat figure, pressed", "x0": 0.12087912087912088, "y0": 0.4421134421134421, "x1": 0.878021978021978, "y1": 0.4553224553224553}, {"text": "against the wall, with her back to him,", "x0": 0.12197802197802197, "y0": 0.45998445998445997, "x1": 0.42747252747252745, "y1": 0.4731934731934732}, {"text": "\u201cIdo beg your pardon,\u201d Harold said.", "x0": 0.12307692307692308, "y0": 0.494949494949495, "x1": 0.4098901098901099, "y1": 0.5081585081585082}, {"text": "sorry. I\u2019m sorry.\u201d", "x0": 0.16263736263736264, "y0": 0.5314685314685315, "x1": 0.2989010989010989, "y1": 0.5439005439005439}, {"text": "\u2018It\u2019s me who should apologize.\u2019 Now Harold was standing half in the cupboard and half outside", "x0": 0.12307692307692308, "y0": 0.5571095571095571, "x1": 0.878021978021978, "y1": 0.5835275835275835}, {"text": "it, with a woman he didn\u2019t know crying into manila envelopes.", "x0": 0.12197802197802197, "y0": 0.5835275835275835, "x1": 0.6252747252747253, "y1": 0.5967365967365967}, {"text": "\u2018I\u2019m good at my job,\u201d she said.", "x0": 0.12307692307692308, "y0": 0.6192696192696193, "x1": 0.36813186813186816, "y1": 0.6324786324786325}, {"text": "\u201cOf course.\u201d", "x0": 0.12307692307692308, "y0": 0.6542346542346542, "x1": 0.2164835164835165, "y1": 0.6643356643356644}, {"text": "\u2018I\u2019ve got a degree. I\u2019m not stupid.\u201d", "x0": 0.12307692307692308, "y0": 0.6899766899766899, "x1": 0.3978021978021978, "y1": 0.7031857031857032}, {"text": "\u2018I know,\u2019 he said, although, of course, this was not strictly true; he knew almost nothing about", "x0": 0.12307692307692308, "y0": 0.7249417249417249, "x1": 0.878021978021978, "y1": 0.7381507381507382}, {"text": "her.", "x0": 0.12197802197802197, "y0": 0.7428127428127428, "x1": 0.15054945054945054, "y1": 0.752913752913753}, {"text": "\u201cThen why is Mr Napier always watching? As if he\u2019s waiting for me to make a mistake? Why", "x0": 0.12307692307692308, "y0": 0.7777777777777778, "x1": 0.878021978021978, "y1": 0.790986790986791}, {"text": "must they all laugh?\u2019 Their boss was a mystery to Harold, He didn\u2019t know if the rumours were", "x0": 0.12197802197802197, "y0": 0.7956487956487956, "x1": 0.878021978021978, "y1": 0.8088578088578089}, {"text": "true but only the previous week, Mr Napier fired a secretary for touching his desk. \u2018I\u2019m sure", "x0": 0.12197802197802197, "y0": 0.8135198135198135, "x1": 0.878021978021978, "y1": 0.8267288267288267}, {"text": "he thinks you are a very good accountant.\u2019 He held out his palm for her.", "x0": 0.12197802197802197, "y0": 0.8313908313908314, "x1": 0.6989010989010989, "y1": 0.8445998445998446}, {"text": "\u201cWould you like to come out of the stationery cupboard now?\u201d", "x0": 0.12307692307692308, "y0": 0.8578088578088578, "x1": 0.6230769230769231, "y1": 0.8842268842268842}, {"text": "RACHEL JOYCE", "x0": 0.7263736263736263, "y0": 0.885003885003885, "x1": 0.8725274725274725, "y1": 0.8943278943278943}], [{"text": "Text 5 \u2014 Discursive article", "x0": 0.12197802197802197, "y0": 0.08935508935508936, "x1": 0.34395604395604396, "y1": 0.09867909867909867}, {"text": "How the steady click of knitting needles and crochet hooks is bringing comfort,", "x0": 0.12087912087912088, "y0": 0.1250971250971251, "x1": 0.7758241758241758, "y1": 0.13752913752913754}, {"text": "mindfulness and healing", "x0": 0.12087912087912088, "y0": 0.14219114219114218, "x1": 0.3274725274725275, "y1": 0.15462315462315462}, {"text": "Sarah Lulu Faith refuses to use conventional terms like sick or ill, when she is feeling unwell.", "x0": 0.12197802197802197, "y0": 0.17560217560217561, "x1": 0.8769230769230769, "y1": 0.1888111888111888}, {"text": "She prefers the term \u201creduced fabulousness.\u201d", "x0": 0.12197802197802197, "y0": 0.1926961926961927, "x1": 0.4835164835164835, "y1": 0.20590520590520592}, {"text": "When you meet her, as I did recently in Newcastle, you quickly understand \u2014 she wears a riot", "x0": 0.12197802197802197, "y0": 0.22533022533022534, "x1": 0.878021978021978, "y1": 0.23853923853923853}, {"text": "of colours with bright lipstick, has a big, open grin, and the air of someone with an innate", "x0": 0.12197802197802197, "y0": 0.24164724164724163, "x1": 0.878021978021978, "y1": 0.25485625485625485}, {"text": "capacity to see and emit joy.", "x0": 0.12197802197802197, "y0": 0.257964257964258, "x1": 0.34945054945054943, "y1": 0.27117327117327117}, {"text": "When she was in her mid-60s she experienced \u201cseverely reduced fabulousness.\u201d After decades", "x0": 0.12197802197802197, "y0": 0.2913752913752914, "x1": 0.878021978021978, "y1": 0.3045843045843046}, {"text": "working in welfare, she had been made redundant because of her health, in and out of hospital", "x0": 0.12197802197802197, "y0": 0.3076923076923077, "x1": 0.878021978021978, "y1": 0.3209013209013209}, {"text": "and then isolated in her home on the mid-north coast of NSW during the pandemic.", "x0": 0.12197802197802197, "y0": 0.32400932400932403, "x1": 0.7912087912087912, "y1": 0.3372183372183372}, {"text": "In response, she began to crochet, and found she gained a curious strength from it.", "x0": 0.12197802197802197, "y0": 0.35664335664335667, "x1": 0.7824175824175824, "y1": 0.36985236985236986}, {"text": "\u201cThe repetitive, mindful nature of working the stitches, watching the project grow, however", "x0": 0.12197802197802197, "y0": 0.3900543900543901, "x1": 0.8791208791208791, "y1": 0.40326340326340326}, {"text": "haltingly, kept me largely sane. More than sane, it provided comfort, expression and soothed", "x0": 0.12197802197802197, "y0": 0.4063714063714064, "x1": 0.878021978021978, "y1": 0.4195804195804196}, {"text": "my bruised soul.\u201d Faith decided her practice was even helping her breath stabilise. Due to a", "x0": 0.12197802197802197, "y0": 0.4226884226884227, "x1": 0.878021978021978, "y1": 0.4358974358974359}, {"text": "lung condition and brittle asthma, breathing can be a source of huge difficulty for Faith, but", "x0": 0.12197802197802197, "y0": 0.439005439005439, "x1": 0.878021978021978, "y1": 0.4522144522144522}, {"text": "she became aware that her, \u201cbreathing regulated itself with the tempo of the crocheting,\u201d which", "x0": 0.12197802197802197, "y0": 0.4553224553224553, "x1": 0.878021978021978, "y1": 0.46853146853146854}, {"text": "she describes as: \u201cMagic. Really.\u201d", "x0": 0.12197802197802197, "y0": 0.4630924630924631, "x1": 0.3967032967032967, "y1": 0.48951048951048953}, {"text": "Faith \u2014 who has reached the age she now broadly calls \u201cQueenager\u201d \u2014 started a \u201cyarners", "x0": 0.12197802197802197, "y0": 0.5050505050505051, "x1": 0.878021978021978, "y1": 0.5182595182595182}, {"text": "group\u201d for women to talk. And talk they do, about everything and nothing, from trauma to tea,", "x0": 0.12197802197802197, "y0": 0.5213675213675214, "x1": 0.8769230769230769, "y1": 0.5345765345765345}, {"text": "while they knit or crochet.", "x0": 0.12197802197802197, "y0": 0.5376845376845377, "x1": 0.33186813186813185, "y1": 0.5508935508935509}, {"text": "Funny isn't it, how long we've adhered to the stereotype of knitters as doddery, sweet", "x0": 0.12197802197802197, "y0": 0.5703185703185704, "x1": 0.878021978021978, "y1": 0.5835275835275835}, {"text": "grandmothers, as though the activity itself was a sign of ageing, dismissed as useless frippery", "x0": 0.12197802197802197, "y0": 0.5788655788655789, "x1": 0.878021978021978, "y1": 0.602952602952603}, {"text": "and distraction \u2014 not what it actually is, which is useful and mindful.", "x0": 0.12197802197802197, "y0": 0.602952602952603, "x1": 0.6725274725274726, "y1": 0.6161616161616161}, {"text": "While breath experts and \u201cwellness warriors\u201d throng on social media, posing on yoga mats, in", "x0": 0.12197802197802197, "y0": 0.6363636363636364, "x1": 0.878021978021978, "y1": 0.6495726495726496}, {"text": "ice baths and on headlands, often charging small fortunes to tell people how to fill and empty", "x0": 0.12197802197802197, "y0": 0.6526806526806527, "x1": 0.878021978021978, "y1": 0.6658896658896659}, {"text": "their lungs, how to lear to be present and focused, the steady click of needles on the couches", "x0": 0.12197802197802197, "y0": 0.668997668997669, "x1": 0.878021978021978, "y1": 0.6822066822066822}, {"text": "of Australia might serve as a reminder that knitters have been on to this stuff for a very long", "x0": 0.12197802197802197, "y0": 0.6853146853146853, "x1": 0.878021978021978, "y1": 0.6985236985236986}, {"text": "time.", "x0": 0.12197802197802197, "y0": 0.7016317016317016, "x1": 0.16043956043956045, "y1": 0.7117327117327117}, {"text": "JULIA BAIRD", "x0": 0.7505494505494505, "y0": 0.7707847707847708, "x1": 0.8736263736263736, "y1": 0.7801087801087802}, {"text": "End of texts for Section I", "x0": 0.3934065934065934, "y0": 0.8772338772338772, "x1": 0.6054945054945055, "y1": 0.8865578865578866}]]