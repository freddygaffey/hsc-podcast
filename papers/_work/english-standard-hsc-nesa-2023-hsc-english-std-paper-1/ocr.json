 0.7978021978021979, "y1": 0.5742035742035742}, {"text": "Contemporary Indigenous Plays", "x0": 0.3098901098901099, "y0": 0.5788655788655789, "x1": 0.5714285714285714, "y1": 0.5920745920745921}, {"text": "Arthur Miller, The Crucible", "x0": 0.3098901098901099, "y0": 0.6021756021756022, "x1": 0.5351648351648352, "y1": 0.6122766122766122}, {"text": "\u2014 William Shakespeare, The Merchant of Venice", "x0": 0.2857142857142857, "y0": 0.6262626262626263, "x1": 0.6868131868131868, "y1": 0.6394716394716394}, {"text": "Section II prescribed texts continue on page 11", "x0": 0.2978021978021978, "y0": 0.6930846930846931, "x1": 0.7, "y1": 0.7062937062937062}], [{"text": "Section II prescribed texts (continued)", "x0": 0.11978021978021978, "y0": 0.08158508158508158, "x1": 0.42857142857142855, "y1": 0.0947940947940948}, {"text": "+ \u2014 Tim Winton, The Boy Behind the Curtain", "x0": 0.11978021978021978, "y0": 0.11499611499611499, "x1": 0.6461538461538462, "y1": 0.1282051282051282}, {"text": "The prescribed chapters are:", "x0": 0.3087912087912088, "y0": 0.13908313908313907, "x1": 0.5362637362637362, "y1": 0.15151515151515152}, {"text": "* Havoc: A Life in Accidents", "x0": 0.310989010989011, "y0": 0.16161616161616163, "x1": 0.5516483516483517, "y1": 0.17482517482517482}, {"text": "* Betsy", "x0": 0.310989010989011, "y0": 0.1794871794871795, "x1": 0.3758241758241758, "y1": 0.1919191919191919}, {"text": "* Twice on Sundays", "x0": 0.310989010989011, "y0": 0.1958041958041958, "x1": 0.47912087912087914, "y1": 0.20590520590520592}, {"text": "* The Wait and the Flow", "x0": 0.310989010989011, "y0": 0.21134421134421136, "x1": 0.5186813186813187, "y1": 0.22144522144522144}, {"text": "* In the Shadow of the Hospital", "x0": 0.310989010989011, "y0": 0.22921522921522922, "x1": 0.5758241758241758, "y1": 0.24164724164724163}, {"text": "* The Demon Shark", "x0": 0.310989010989011, "y0": 0.24553224553224554, "x1": 0.47912087912087914, "y1": 0.25485625485625485}, {"text": "* Barefoot in the Temple of Art", "x0": 0.310989010989011, "y0": 0.2618492618492618, "x1": 0.5725274725274725, "y1": 0.27505827505827507}, {"text": "\u2014 Malala Yousafzai and Christina Lamb, J am Malala", "x0": 0.2857142857142857, "y0": 0.29526029526029524, "x1": 0.7296703296703296, "y1": 0.30691530691530694}, {"text": "+ Film \u2014 Stephen Daldry, Billy Elliot", "x0": 0.11978021978021978, "y0": 0.32867132867132864, "x1": 0.5340659340659341, "y1": 0.3418803418803419}, {"text": "* Media \u2014 Ivan O'Mahoney, Go Back to Where You Came From", "x0": 0.11978021978021978, "y0": 0.3620823620823621, "x1": 0.7472527472527473, "y1": 0.3752913752913753}, {"text": "The prescribed episodes are:", "x0": 0.3087912087912088, "y0": 0.3861693861693862, "x1": 0.5384615384615384, "y1": 0.3986013986013986}, {"text": "* Series 1: Episodes 1,2 and 3", "x0": 0.310989010989011, "y0": 0.4094794094794095, "x1": 0.5703296703296703, "y1": 0.4219114219114219}, {"text": "and", "x0": 0.33406593406593404, "y0": 0.4296814296814297, "x1": 0.36153846153846153, "y1": 0.439005439005439}, {"text": "* The Response", "x0": 0.310989010989011, "y0": 0.44988344988344986, "x1": 0.44395604395604393, "y1": 0.46231546231546233}, {"text": "\u2014 Lucy Walker, Waste Land", "x0": 0.2857142857142857, "y0": 0.4825174825174825, "x1": 0.5230769230769231, "y1": 0.49572649572649574}, {"text": "End of paper", "x0": 0.44285714285714284, "y0": 0.5493395493395493, "x1": 0.5560439560439561, "y1": 0.5625485625485626}], [{"text": "BLANK PAGE", "x0": 0.43626373626373627, "y0": 0.3550893550893551, "x1": 0.5626373626373626, "y1": 0.3644133644133644}, {"text": "(\u00a9 2023 NSW Edueation Standards Authority", "x0": 0.3824175824175824, "y0": 0.9673659673659674, "x1": 0.6164835164835165, "y1": 0.9751359751359752}], [{"text": "GOVERNMENT", "x0": 0.12197802197802197, "y0": 0.1592851592851593, "x1": 0.22527472527472528, "y1": 0.16705516705516704}, {"text": "NSW Education Standards Authority", "x0": 0.11978021978021978, "y0": 0.19114219114219114, "x1": 0.4725274725274725, "y1": 0.20512820512820512}, {"text": "2023 | HIGHER SCHOOL CERTIFICATE EXAMINATION", "x0": 0.12747252747252746, "y0": 0.30691530691530694, "x1": 0.5868131868131868, "y1": 0.331002331002331}, {"text": "English Standard", "x0": 0.12307692307692308, "y0": 0.38694638694638694, "x1": 0.5263736263736264, "y1": 0.4226884226884227}, {"text": "Paper 1 \u2014 Texts and Human Experiences", "x0": 0.12197802197802197, "y0": 0.45376845376845376, "x1": 0.8252747252747252, "y1": 0.48484848484848486}, {"text": "Stimulus Booklet", "x0": 0.11978021978021978, "y0": 0.5182595182595182, "x1": 0.3901098901098901, "y1": 0.5384615384615384}, {"text": "Section! + Text 1 - Poem", "x0": 0.11868131868131868, "y0": 0.60994560994561, "x1": 0.41318681318681316, "y1": 0.6363636363636364}, {"text": "+ Text 2 \u2014 Feature article extract 3", "x0": 0.2681318681318681, "y0": 0.6534576534576535, "x1": 0.8791208791208791, "y1": 0.6635586635586636}, {"text": "+ Text 3 \u2014 Prose @xtract 4", "x0": 0.2681318681318681, "y0": 0.6876456876456877, "x1": 0.8791208791208791, "y1": 0.6977466977466977}, {"text": "+ Text 4 \u2014 Memoir extract 5", "x0": 0.2681318681318681, "y0": 0.7226107226107226, "x1": 0.8791208791208791, "y1": 0.7327117327117327}, {"text": "+ Text 5 \u2014 Feature article extract 6", "x0": 0.2681318681318681, "y0": 0.7567987567987567, "x1": 0.8791208791208791, "y1": 0.7668997668997669}, {"text": "1043", "x0": 0.08241758241758242, "y0": 0.9463869463869464, "x1": 0.11758241758241758, "y1": 0.9549339549339549}], [{"text": "Text 1 \u2014 Poem", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.25164835164835164, "y1": 0.09168609168609168}, {"text": "Time Capsule", "x0": 0.43956043956043955, "y0": 0.13131313131313133, "x1": 0.5582417582417583, "y1": 0.1445221445221445}, {"text": "Sitting on the kitchen shelf", "x0": 0.35714285714285715, "y0": 0.16472416472416473, "x1": 0.5769230769230769, "y1": 0.17793317793317792}, {"text": "the tea leaves tin", "x0": 0.35714285714285715, "y0": 0.18181818181818182, "x1": 0.49230769230769234, "y1": 0.19114219114219114}, {"text": "held pride of place", "x0": 0.35714285714285715, "y0": 0.19813519813519814, "x1": 0.5076923076923077, "y1": 0.21134421134421136}, {"text": "in the running of the house", "x0": 0.35824175824175825, "y0": 0.21445221445221446, "x1": 0.5747252747252747, "y1": 0.22766122766122765}, {"text": "from breakfast through to dinner.", "x0": 0.35824175824175825, "y0": 0.23154623154623155, "x1": 0.6263736263736264, "y1": 0.24475524475524477}, {"text": "\u2018Would you like a cup of tea?\u201d", "x0": 0.35824175824175825, "y0": 0.26495726495726496, "x1": 0.6043956043956044, "y1": 0.27816627816627815}, {"text": "my mother would question", "x0": 0.35714285714285715, "y0": 0.28205128205128205, "x1": 0.5736263736263736, "y1": 0.29448329448329447}, {"text": "one and all as a welcome", "x0": 0.35714285714285715, "y0": 0.29836829836829837, "x1": 0.5604395604395604, "y1": 0.3084693084693085}, {"text": "and a kind of mental setting", "x0": 0.35714285714285715, "y0": 0.3146853146853147, "x1": 0.5835164835164836, "y1": 0.3278943278943279}, {"text": "for family and guests.", "x0": 0.35824175824175825, "y0": 0.3317793317793318, "x1": 0.532967032967033, "y1": 0.34498834498834496}, {"text": "Many lives and times have", "x0": 0.35714285714285715, "y0": 0.3651903651903652, "x1": 0.5736263736263736, "y1": 0.3776223776223776}, {"text": "passed through that tin,", "x0": 0.35714285714285715, "y0": 0.3815073815073815, "x1": 0.5461538461538461, "y1": 0.3947163947163947}, {"text": "the ritual of \u2018one for each", "x0": 0.35714285714285715, "y0": 0.3978243978243978, "x1": 0.5637362637362637, "y1": 0.40792540792540793}, {"text": "person and one for the pot\u2019", "x0": 0.35714285714285715, "y0": 0.4149184149184149, "x1": 0.5747252747252747, "y1": 0.4281274281274281}, {"text": "almost counting out our years", "x0": 0.35714285714285715, "y0": 0.43123543123543123, "x1": 0.5978021978021978, "y1": 0.4444444444444444}, {"text": "as a family of four children", "x0": 0.35714285714285715, "y0": 0.4483294483294483, "x1": 0.578021978021978, "y1": 0.46153846153846156}, {"text": "was suddenly one at home", "x0": 0.35714285714285715, "y0": 0.4654234654234654, "x1": 0.5703296703296703, "y1": 0.47785547785547783}, {"text": "and I can still see them all", "x0": 0.35714285714285715, "y0": 0.49805749805749805, "x1": 0.5692307692307692, "y1": 0.5081585081585082}, {"text": "waiting round the table", "x0": 0.35714285714285715, "y0": 0.5143745143745144, "x1": 0.5439560439560439, "y1": 0.5275835275835276}, {"text": "for the tea to brew", "x0": 0.35824175824175825, "y0": 0.5314685314685315, "x1": 0.5054945054945055, "y1": 0.5415695415695416}, {"text": "until my father would pour", "x0": 0.35824175824175825, "y0": 0.5477855477855478, "x1": 0.5758241758241758, "y1": 0.560994560994561}, {"text": "each cup carefully,", "x0": 0.35714285714285715, "y0": 0.5648795648795649, "x1": 0.510989010989011, "y1": 0.578088578088578}, {"text": "not one drop would he spill.", "x0": 0.35714285714285715, "y0": 0.5811965811965812, "x1": 0.5846153846153846, "y1": 0.5944055944055944}, {"text": "Into the seventies", "x0": 0.35714285714285715, "y0": 0.6153846153846154, "x1": 0.4978021978021978, "y1": 0.6247086247086248}, {"text": "the teapot reigned supreme", "x0": 0.35714285714285715, "y0": 0.6317016317016317, "x1": 0.5758241758241758, "y1": 0.6449106449106449}, {"text": "until suddenly the tea bag", "x0": 0.35824175824175825, "y0": 0.6480186480186481, "x1": 0.5648351648351648, "y1": 0.6612276612276612}, {"text": "had slipped in like a sniper,", "x0": 0.35714285714285715, "y0": 0.6651126651126651, "x1": 0.5813186813186814, "y1": 0.6783216783216783}, {"text": "picking off the minutes", "x0": 0.35714285714285715, "y0": 0.6814296814296814, "x1": 0.545054945054945, "y1": 0.6946386946386947}, {"text": "of conversation, as if", "x0": 0.35714285714285715, "y0": 0.6977466977466977, "x1": 0.5285714285714286, "y1": 0.7078477078477079}, {"text": "there was no time to lose.", "x0": 0.35714285714285715, "y0": 0.7156177156177156, "x1": 0.5648351648351648, "y1": 0.7249417249417249}, {"text": "Now we sift through our parents", "x0": 0.35714285714285715, "y0": 0.7482517482517482, "x1": 0.6197802197802198, "y1": 0.7614607614607615}, {"text": "belongings to share what can", "x0": 0.35714285714285715, "y0": 0.7653457653457654, "x1": 0.5912087912087912, "y1": 0.7777777777777778}, {"text": "be sold or used and I grab", "x0": 0.35714285714285715, "y0": 0.7824397824397824, "x1": 0.5714285714285714, "y1": 0.7948717948717948}, {"text": "the tea leaves tin, thinking this,", "x0": 0.35714285714285715, "y0": 0.797979797979798, "x1": 0.610989010989011, "y1": 0.8111888111888111}, {"text": "of all things drew our family", "x0": 0.35714285714285715, "y0": 0.815073815073815, "x1": 0.589010989010989, "y1": 0.8282828282828283}, {"text": "together, by cup, by spoon.", "x0": 0.35714285714285715, "y0": 0.8321678321678322, "x1": 0.5769230769230769, "y1": 0.8445998445998446}, {"text": "MIKE GREENACRE", "x0": 0.5, "y0": 0.8655788655788655, "x1": 0.6417582417582418, "y1": 0.8749028749028749}, {"text": "Courtesy of Mike Greenacre", "x0": 0.4747252747252747, "y0": 0.8834498834498834, "x1": 0.6417582417582418, "y1": 0.8927738927738927}], [{"text": "Text 2 \u2014 Feature article extract", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.3978021978021978, "y1": 0.09246309246309246}], [{"text": "Text 3 \u2014 Prose extract", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.31868131868131866, "y1": 0.09168609168609168}, {"text": "One extraordinary time, I felt the strangeness of an unfamiliar terrain . . .", "x0": 0.21428571428571427, "y0": 0.1282051282051282, "x1": 0.7846153846153846, "y1": 0.14763014763014762}, {"text": "A strange new pressure of wet pebbles and the tickle of moist sand", "x0": 0.21428571428571427, "y0": 0.14840714840714841, "x1": 0.7846153846153846, "y1": 0.16161616161616163}, {"text": "pushing itself between toes that until then had walked only in dry, dusty", "x0": 0.21428571428571427, "y0": 0.16472416472416473, "x1": 0.7835164835164835, "y1": 0.17793317793317792}, {"text": "earth. As I pushed my feet into that new gritty dampness, the sensation", "x0": 0.21428571428571427, "y0": 0.18104118104118105, "x1": 0.7846153846153846, "y1": 0.19425019425019424}, {"text": "grew upwards and soaked my body in its rough, but velvety, texture.", "x0": 0.21428571428571427, "y0": 0.19813519813519814, "x1": 0.7846153846153846, "y1": 0.21134421134421136}, {"text": "The rubbing of those grains of sand made dry, almost-humming noises", "x0": 0.21428571428571427, "y0": 0.21445221445221446, "x1": 0.7846153846153846, "y1": 0.22766122766122765}, {"text": "that were strange in my ears. I hear that uneasy teeming still, and how", "x0": 0.21428571428571427, "y0": 0.23154623154623155, "x1": 0.7846153846153846, "y1": 0.24475524475524477}, {"text": "its noise became grinding reverberations, discordant* with the rhythm", "x0": 0.2153846153846154, "y0": 0.24786324786324787, "x1": 0.7846153846153846, "y1": 0.26107226107226106}, {"text": "of my goodalu** and of my kujiga.***", "x0": 0.21428571428571427, "y0": 0.26495726495726496, "x1": 0.5307692307692308, "y1": 0.27816627816627815}, {"text": "Iwas a child and I'd travelled a long way from my home. I was visiting", "x0": 0.2153846153846154, "y0": 0.29836829836829837, "x1": 0.7846153846153846, "y1": 0.31157731157731156}, {"text": "the ocean. They said:", "x0": 0.21428571428571427, "y0": 0.31546231546231546, "x1": 0.38461538461538464, "y1": 0.3278943278943279}, {"text": "go walk on the beach,", "x0": 0.26153846153846155, "y0": 0.3317793317793318, "x1": 0.43846153846153846, "y1": 0.34498834498834496}, {"text": "go swim in the ocean", "x0": 0.26153846153846155, "y0": 0.34887334887334887, "x1": 0.432967032967033, "y1": 0.3613053613053613}, {"text": "and the sand I found there was such a foreign thing. It wasn\u2019t anything", "x0": 0.21428571428571427, "y0": 0.3815073815073815, "x1": 0.7846153846153846, "y1": 0.3947163947163947}, {"text": "like the hot dust and gravel of my place ...", "x0": 0.2153846153846154, "y0": 0.3986013986013986, "x1": 0.5615384615384615, "y1": 0.41181041181041184}, {"text": "The sand on that beach created a million minuscule pressure points", "x0": 0.21428571428571427, "y0": 0.432012432012432, "x1": 0.7846153846153846, "y1": 0.44522144522144524}, {"text": "under my soles. It tried to swallow my feet and the salt water rushed to", "x0": 0.2153846153846154, "y0": 0.4483294483294483, "x1": 0.7846153846153846, "y1": 0.46153846153846156}, {"text": "carry off small shells and seaweed that caught in my toes. For me, then,", "x0": 0.21428571428571427, "y0": 0.4654234654234654, "x1": 0.7846153846153846, "y1": 0.47863247863247865}, {"text": "sand and shells and seaweed remained just what they were. I struggled", "x0": 0.2153846153846154, "y0": 0.48174048174048173, "x1": 0.7846153846153846, "y1": 0.494949494949495}, {"text": "to listen or think or feel or see or believe their indecipherable story.", "x0": 0.21428571428571427, "y0": 0.4988344988344988, "x1": 0.7846153846153846, "y1": 0.5120435120435121}, {"text": "There was no story talking to my bones, into my soul ...", "x0": 0.21428571428571427, "y0": 0.5151515151515151, "x1": 0.6736263736263737, "y1": 0.5283605283605284}, {"text": "At home now, the sharp edges of the gravel biting into my feet remind", "x0": 0.21428571428571427, "y0": 0.5485625485625486, "x1": 0.7846153846153846, "y1": 0.5617715617715617}, {"text": "me to tread wisely and the dust between those hard edges softens and", "x0": 0.21428571428571427, "y0": 0.5656565656565656, "x1": 0.7846153846153846, "y1": 0.5788655788655789}, {"text": "gentles the way into new stories. On that long-ago day, standing on the", "x0": 0.21428571428571427, "y0": 0.581973581973582, "x1": 0.7846153846153846, "y1": 0.5951825951825952}, {"text": "edge of the ocean, I struggled to take that salty air inside my body and", "x0": 0.21428571428571427, "y0": 0.5990675990675991, "x1": 0.7846153846153846, "y1": 0.6122766122766122}, {"text": "though during the course of my life I have built a friendship with the", "x0": 0.21428571428571427, "y0": 0.6153846153846154, "x1": 0.7846153846153846, "y1": 0.6285936285936286}, {"text": "ocean sand, it is the gravel and dust that are home for me. And, like", "x0": 0.21428571428571427, "y0": 0.6317016317016317, "x1": 0.7846153846153846, "y1": 0.6449106449106449}, {"text": "the becoming of good friendships, I crave that gravel and dust comfort,", "x0": 0.21428571428571427, "y0": 0.6487956487956488, "x1": 0.7846153846153846, "y1": 0.662004662004662}, {"text": "away from that other place, the place of sand, that makes odd noises", "x0": 0.21428571428571427, "y0": 0.6651126651126651, "x1": 0.7846153846153846, "y1": 0.6783216783216783}, {"text": "in my ears.", "x0": 0.2153846153846154, "y0": 0.6853146853146853, "x1": 0.3032967032967033, "y1": 0.6954156954156954}, {"text": "Desra DANK", "x0": 0.6780219780219781, "y0": 0.7163947163947164, "x1": 0.7846153846153846, "y1": 0.7257187257187258}, {"text": "from We Come With This Place", "x0": 0.5285714285714286, "y0": 0.7319347319347319, "x1": 0.7846153846153846, "y1": 0.7420357420357421}, {"text": "Debra Dank, We Come With This Place, Echo Publishing", "x0": 0.43956043956043955, "y0": 0.7552447552447552, "x1": 0.778021978021978, "y1": 0.7645687645687645}, {"text": "* discordant (of sounds) harsh and jarring", "x0": 0.22857142857142856, "y0": 0.7878787878787878, "x1": 0.6285714285714286, "y1": 0.797979797979798}, {"text": "** goodalu and *** kujiga words from the language that indicate", "x0": 0.21978021978021978, "y0": 0.804972804972805, "x1": 0.7472527472527473, "y1": 0.815073815073815}, {"text": "concepts about the heart and soul", "x0": 0.42967032967032964, "y0": 0.818958818958819, "x1": 0.6582417582417582, "y1": 0.8290598290598291}], [{"text": "Text 4 \u2014 Memoir extract", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.3395604395604396, "y1": 0.09168609168609168}, {"text": "It is no great revelation that certain countries or cities can become", "x0": 0.2153846153846154, "y0": 0.13131313131313133, "x1": 0.7846153846153846, "y1": 0.1445221445221445}, {"text": "shorthand for a feeling; that their very name becomes one with an ethos", "x0": 0.2153846153846154, "y0": 0.14840714840714841, "x1": 0.7846153846153846, "y1": 0.16161616161616163}, {"text": "or experience. Hawaii. Thailand. New York. The name of the place", "x0": 0.21428571428571427, "y0": 0.16472416472416473, "x1": 0.7846153846153846, "y1": 0.17793317793317792}, {"text": "automatically conjures a mental picture. So much so that when you say", "x0": 0.21428571428571427, "y0": 0.18104118104118105, "x1": 0.7835164835164835, "y1": 0.19425019425019424}, {"text": "you are going there others immediately intuit what sort of holiday or", "x0": 0.21428571428571427, "y0": 0.19813519813519814, "x1": 0.7846153846153846, "y1": 0.21134421134421136}, {"text": "experience you will have.", "x0": 0.21428571428571427, "y0": 0.21445221445221446, "x1": 0.421978021978022, "y1": 0.22766122766122765}, {"text": "Of course, this is not necessarily the case ... Just as we don\u2019t", "x0": 0.26153846153846155, "y0": 0.24786324786324787, "x1": 0.7846153846153846, "y1": 0.26107226107226106}, {"text": "know the inner workings of each other\u2019s lives, so it is with a foreign", "x0": 0.21428571428571427, "y0": 0.26495726495726496, "x1": 0.7846153846153846, "y1": 0.27816627816627815}, {"text": "country. We have no idea of the way in which it will open up to us, and", "x0": 0.21428571428571427, "y0": 0.2812742812742813, "x1": 0.7846153846153846, "y1": 0.29448329448329447}, {"text": "us to it. And yet we think we do.", "x0": 0.2153846153846154, "y0": 0.29836829836829837, "x1": 0.48021978021978023, "y1": 0.31157731157731156}, {"text": "Few places on earth, it seems, conjure up more of an emotional", "x0": 0.26263736263736265, "y0": 0.3317793317793318, "x1": 0.7835164835164835, "y1": 0.34498834498834496}, {"text": "response than Italy. It is a land that transcends clich\u00e9 by simply piling", "x0": 0.21428571428571427, "y0": 0.3480963480963481, "x1": 0.7846153846153846, "y1": 0.3613053613053613}, {"text": "on more of them: afternoon slumbers and wine, church bells and", "x0": 0.21428571428571427, "y0": 0.3651903651903652, "x1": 0.7846153846153846, "y1": 0.3752913752913753}, {"text": "saints, terracotta-coloured villas and washing hanging over balconies,", "x0": 0.2153846153846154, "y0": 0.3815073815073815, "x1": 0.7846153846153846, "y1": 0.3947163947163947}, {"text": "grapevines and pasta, and glittering seas and venerated* old people.", "x0": 0.21428571428571427, "y0": 0.3986013986013986, "x1": 0.7846153846153846, "y1": 0.41181041181041184}, {"text": "It is cobbled thoroughfares and picture-book villages, Pinocchio and", "x0": 0.2153846153846154, "y0": 0.4149184149184149, "x1": 0.7846153846153846, "y1": 0.4281274281274281}, {"text": "families in the piazza, sliced meats and summer fruits, and music on the", "x0": 0.2153846153846154, "y0": 0.432012432012432, "x1": 0.7846153846153846, "y1": 0.44522144522144524}, {"text": "streets and romance. It is golden light caressing \u2014 not just the ancient", "x0": 0.2153846153846154, "y0": 0.4483294483294483, "x1": 0.7846153846153846, "y1": 0.46153846153846156}, {"text": "stone buildings upon which it alights but also those blessed to bask", "x0": 0.2153846153846154, "y0": 0.4654234654234654, "x1": 0.7846153846153846, "y1": 0.47863247863247865}, {"text": "in its rays. Falling in love with a country is like falling in love with a", "x0": 0.2153846153846154, "y0": 0.48174048174048173, "x1": 0.7846153846153846, "y1": 0.494949494949495}, {"text": "person. You are initially tentative. You start off with a few dates. With", "x0": 0.21428571428571427, "y0": 0.49805749805749805, "x1": 0.7846153846153846, "y1": 0.5112665112665112}, {"text": "a country drive; with dinner. If that goes well, you return for more.", "x0": 0.21428571428571427, "y0": 0.5151515151515151, "x1": 0.7846153846153846, "y1": 0.5283605283605284}, {"text": "Magical outings in which it feels everything is brushed with possibility.", "x0": 0.21428571428571427, "y0": 0.5314685314685315, "x1": 0.7846153846153846, "y1": 0.5446775446775447}, {"text": "Suddenly, your heart is singing. You have never looked better. You", "x0": 0.2153846153846154, "y0": 0.5485625485625486, "x1": 0.7846153846153846, "y1": 0.5617715617715617}, {"text": "feel alive \u2014 like your true, unfettered** self. You are open and happy", "x0": 0.2153846153846154, "y0": 0.5648795648795649, "x1": 0.7835164835164835, "y1": 0.578088578088578}, {"text": "and free. You laugh. You see things differently.", "x0": 0.21428571428571427, "y0": 0.581973581973582, "x1": 0.6021978021978022, "y1": 0.5951825951825952}, {"text": "Mostly, falling in love is not so much about the reality of the", "x0": 0.26263736263736265, "y0": 0.6153846153846154, "x1": 0.7846153846153846, "y1": 0.6285936285936286}, {"text": "other person as it is about how they make you feel about yourself.", "x0": 0.21428571428571427, "y0": 0.6317016317016317, "x1": 0.7505494505494505, "y1": 0.6449106449106449}, {"text": "I wasn\u2019t looking to fall in love with Italy. I wasn\u2019t expecting it.", "x0": 0.26263736263736265, "y0": 0.6651126651126651, "x1": 0.7846153846153846, "y1": 0.6783216783216783}, {"text": "It just happened.", "x0": 0.2153846153846154, "y0": 0.682983682983683, "x1": 0.34835164835164834, "y1": 0.6954156954156954}, {"text": "KATE LANGBROEK", "x0": 0.6406593406593407, "y0": 0.7163947163947164, "x1": 0.7846153846153846, "y1": 0.7257187257187258}, {"text": "Ciao Bella!", "x0": 0.6923076923076923, "y0": 0.7319347319347319, "x1": 0.7846153846153846, "y1": 0.7420357420357421}, {"text": "With kind permission of Kate Langbroek (Author)", "x0": 0.4978021978021978, "y0": 0.752913752913753, "x1": 0.7857142857142857, "y1": 0.7622377622377622}, {"text": "* venerated respected", "x0": 0.23186813186813188, "y0": 0.7995337995337995, "x1": 0.44505494505494503, "y1": 0.8096348096348096}, {"text": "unfettered unrestricted", "x0": 0.24395604395604395, "y0": 0.8174048174048174, "x1": 0.46153846153846156, "y1": 0.8251748251748252}], [{"text": "Text 5 \u2014 Feature article extract", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.3978021978021978, "y1": 0.09168609168609168}, {"text": "Buy Experiences, Not Things", "x0": 0.11978021978021978, "y0": 0.13908313908313907, "x1": 0.5967032967032967, "y1": 0.16472416472416473}, {"text": "Live in anticipation, gathering stories and memories.", "x0": 0.11978021978021978, "y0": 0.18337218337218336, "x1": 0.6527472527472528, "y1": 0.19968919968919968}, {"text": "By James Hamblin", "x0": 0.11978021978021978, "y0": 0.2191142191142191, "x1": 0.2725274725274725, "y1": 0.23232323232323232}, {"text": "In the journal Psychological Science last month, Gilovich and Killingsworth, along with", "x0": 0.11978021978021978, "y0": 0.26961926961926963, "x1": 0.8791208791208791, "y1": 0.2828282828282828}, {"text": "Cornell doctoral candidate Amit Kumar, expanded on the current understanding that spending", "x0": 0.11868131868131868, "y0": 0.28593628593628595, "x1": 0.8791208791208791, "y1": 0.29914529914529914}, {"text": "money on experiences \u201cprovide[s] more enduring happines:", "x0": 0.11978021978021978, "y0": 0.30303030303030304, "x1": 0.5978021978021978, "y1": 0.3162393162393162}, {"text": "Essentially, when you can\u2019t live in a moment, they say, it\u2019s best to live in anticipation of an", "x0": 0.11978021978021978, "y0": 0.33644133644133645, "x1": 0.8791208791208791, "y1": 0.34965034965034963}, {"text": "experience. Experiential purchases like trips, concerts, movies, et cetera, tend to material", "x0": 0.11868131868131868, "y0": 0.35275835275835277, "x1": 0.8791208791208791, "y1": 0.36596736596736595}, {"text": "purchases ...", "x0": 0.11978021978021978, "y0": 0.3706293706293706, "x1": 0.2230769230769231, "y1": 0.38306138306138304}, {"text": "Experiential purchases are also more associated with identity, connection, and social behavior.", "x0": 0.11978021978021978, "y0": 0.40326340326340326, "x1": 0.8802197802197802, "y1": 0.41647241647241645}, {"text": "Looking back on purchases made, experiences make people happier than do possessions. It\u2019s", "x0": 0.11978021978021978, "y0": 0.4195804195804196, "x1": 0.8791208791208791, "y1": 0.43278943278943277}, {"text": "kind of counter to the logic that if you pay for an experience, like a vacation, it will be over and", "x0": 0.11978021978021978, "y0": 0.4366744366744367, "x1": 0.8791208791208791, "y1": 0.44988344988344986}, {"text": "gone; but if you buy a tangible thing, a couch, at least you'll have it for a long time. Actually", "x0": 0.11978021978021978, "y0": 0.452991452991453, "x1": 0.8791208791208791, "y1": 0.4662004662004662}, {"text": "most of us have a pretty intense capacity for tolerance, or hedonic adaptation*, where we stop", "x0": 0.11978021978021978, "y0": 0.4700854700854701, "x1": 0.8791208791208791, "y1": 0.48329448329448327}, {"text": "appreciating things to which we're constantly exposed. Phones, clothes, couches, et cetera, just", "x0": 0.11978021978021978, "y0": 0.48329448329448327, "x1": 0.8802197802197802, "y1": 0.5027195027195027}, {"text": "become background. They deteriorate or become obsolete. It\u2019s the fleetingness of experiential", "x0": 0.11868131868131868, "y0": 0.5034965034965035, "x1": 0.8791208791208791, "y1": 0.5167055167055167}, {"text": "purchases that endears us to them. Either they\u2019re not around long enough to become imperfect,", "x0": 0.11978021978021978, "y0": 0.5198135198135199, "x1": 0.8802197802197802, "y1": 0.533022533022533}, {"text": "or they are imperfect, but our memories and stories of them get sweet with time. Even a bad", "x0": 0.11868131868131868, "y0": 0.5361305361305362, "x1": 0.8791208791208791, "y1": 0.5493395493395493}, {"text": "experience becomes a good story.", "x0": 0.11868131868131868, "y0": 0.554001554001554, "x1": 0.3923076923076923, "y1": 0.5664335664335665}, {"text": "When it rains through a beach vacation, as Kumar put it, \u201cPeople will say, well, you know,", "x0": 0.11978021978021978, "y0": 0.5866355866355867, "x1": 0.8802197802197802, "y1": 0.5998445998445998}, {"text": "we stayed in and we played board games and it was a great family bonding experience or", "x0": 0.11978021978021978, "y0": 0.602952602952603, "x1": 0.8802197802197802, "y1": 0.6161616161616161}, {"text": "something.\u201d Even if it was negative in the moment, it becomes positive after the fact. That\u2019s a", "x0": 0.11978021978021978, "y0": 0.62004662004662, "x1": 0.8802197802197802, "y1": 0.6332556332556333}, {"text": "lot harder to do with material purchases because right there in front of you.", "x0": 0.11978021978021978, "y0": 0.6363636363636364, "x1": 0.7912087912087912, "y1": 0.6495726495726496}, {"text": "* hedonic adaptation returning to a stable emotional state after a high or low", "x0": 0.13626373626373625, "y0": 0.6923076923076923, "x1": 0.7120879120879121, "y1": 0.7024087024087025}, {"text": "From The New York Times. \u00a9 The Atlantic 07 October 2014,", "x0": 0.5153846153846153, "y0": 0.7187257187257188, "x1": 0.8736263736263736, "y1": 0.7404817404817405}, {"text": "Buy Experiences, Not Things, by James Hamblin, The New York Times, April 18, 1989.", "x0": 0.35714285714285715, "y0": 0.7365967365967366, "x1": 0.8703296703296703, "y1": 0.745920745920746}, {"text": "\u2018The New York Times Company. All rights reserved. Used under license.", "x0": 0.4472527472527473, "y0": 0.7482517482517482, "x1": 0.8703296703296703, "y1": 0.7575757575757576}], [{"text": "BLANK PAGE", "x0": 0.43626373626373627, "y0": 0.3550893550893551, "x1": 0.5626373626373626, "y1": 0.3644133644133644}], [{"text": "BLANK PAGE", "x0": 0.43626373626373627, "y0": 0.3550893550893551, "x1": 0.5626373626373626, "y1": 0.3644133644133644}, {"text": "(\u00a9 2023 NSW Edueation Standards Authority", "x0": 0.3824175824175824, "y0": 0.9673659673659674, "x1": 0.6164835164835165, "y1": 0.9751359751359752}]]