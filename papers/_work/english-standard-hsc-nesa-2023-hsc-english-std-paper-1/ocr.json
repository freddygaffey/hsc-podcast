78021978021978, "y0": 0.5477855477855478, "x1": 0.6285714285714286, "y1": 0.560994560994561}, {"text": "The prescribed texts are listed on pages 10 and 11.", "x0": 0.11868131868131868, "y0": 0.5975135975135976, "x1": 0.5296703296703297, "y1": 0.6107226107226107}, {"text": "1042 -9-", "x0": 0.08241758241758242, "y0": 0.9432789432789432, "x1": 0.5197802197802198, "y1": 0.9549339549339549}], [{"text": "The prescribed texts for Section II are:", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.4307692307692308, "y1": 0.0947940947940948}, {"text": "Prose Fiction", "x0": 0.14285714285714285, "y0": 0.11499611499611499, "x1": 0.256043956043956, "y1": 0.1250971250971251}, {"text": "Anthony Doerr, All the Light We Cannot See", "x0": 0.3098901098901099, "y0": 0.11499611499611499, "x1": 0.6736263736263737, "y1": 0.1282051282051282}, {"text": "Amanda Lohrey, Vertigo", "x0": 0.3098901098901099, "y0": 0.13908313908313907, "x1": 0.510989010989011, "y1": 0.15151515151515152}, {"text": "George Orwell, Nineteen Eighty-Four", "x0": 0.3098901098901099, "y0": 0.1623931623931624, "x1": 0.6175824175824176, "y1": 0.17482517482517482}, {"text": "Favel Parrett, Past the Shallows", "x0": 0.3098901098901099, "y0": 0.1857031857031857, "x1": 0.567032967032967, "y1": 0.19502719502719504}, {"text": "Poetry", "x0": 0.14285714285714285, "y0": 0.21833721833721834, "x1": 0.1989010989010989, "y1": 0.23154623154623155}, {"text": "Rosemary Dobson, Rosemary Dobson Collected", "x0": 0.3098901098901099, "y0": 0.21833721833721834, "x1": 0.7021978021978021, "y1": 0.23154623154623155}, {"text": "The prescribed poems are:", "x0": 0.3087912087912088, "y0": 0.24242424242424243, "x1": 0.521978021978022, "y1": 0.25485625485625485}, {"text": "* Young Girl at a Window", "x0": 0.310989010989011, "y0": 0.257964257964258, "x1": 0.5318681318681319, "y1": 0.2828282828282828}, {"text": "* Over the Hill", "x0": 0.310989010989011, "y0": 0.27505827505827507, "x1": 0.43956043956043955, "y1": 0.2999222999222999}, {"