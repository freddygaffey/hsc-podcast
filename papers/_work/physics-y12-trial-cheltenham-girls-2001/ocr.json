[[{"text": "Cheltenham Girls High School", "x0": 0.27692307692307694, "y0": 0.06371406371406371, "x1": 0.7615384615384615, "y1": 0.09013209013209013}, {"text": "Physics", "x0": 0.32857142857142857, "y0": 0.16705516705516704, "x1": 0.7065934065934066, "y1": 0.24553224553224554}, {"text": "HSC", "x0": 0.45604395604395603, "y0": 0.35275835275835277, "x1": 0.578021978021978, "y1": 0.38461538461538464}, {"text": "Trial Exam", "x0": 0.36923076923076925, "y0": 0.40326340326340326, "x1": 0.667032967032967, "y1": 0.43356643356643354}, {"text": "206l", "x0": 0.47912087912087914, "y0": 0.4483294483294483, "x1": 0.5769230769230769, "y1": 0.48484848484848486}, {"text": "Time allowed: 3 hours", "x0": 0.34945054945054943, "y0": 0.4996114996114996, "x1": 0.6868131868131868, "y1": 0.5213675213675214}, {"text": "Student Number:", "x0": 0.2714285714285714, "y0": 0.5804195804195804, "x1": 0.45384615384615384, "y1": 0.5959595959595959}, {"text": "This task is worth 35% of the total HSC Course assessment.", "x0": 0.31758241758241756, "y0": 0.6247086247086248, "x1": 0.8076923076923077, "y1": 0.6402486402486403}, {"text": "General Instructions Section I~ Pages 2-13", "x0": 0.14285714285714285, "y0": 0.6752136752136753, "x1": 0.7164835164835165, "y1": 0.6954156954156954}, {"text": "Total marks (75) ~", "x0": 0.5263736263736264, "y0": 0.6915306915306916, "x1": 0.676923076923077, "y1": 0.7055167055167055}, {"text": "A This section has two parts, Part A and part Br", "x0": 0.3032967032967033, "y0": 0.7070707070707071, "x1": 0.8989010989010989, "y1": 0.7249417249417249}, {"text": "Reading time \u2014 5 minutes", "x0": 0.14175824175824175, "y0": 0.7202797202797203, "x1": 0.3505494505494505, "y1": 0.7412587412587412}, {"text": "Working time \u2014 3 hours PartA", "x0": 0.14175824175824175, "y0": 0.7358197358197358, "x1": 0.5791208791208792, "y1": 0.7575757575757576}, {"text": "Board approved calculators may be used, Total marks (15) Attempt questions 1-15", "x0": 0.14175824175824175, "y0": 0.7536907536907537, "x1": 0.8835164835164835, "y1": 0.7808857808857809}, {"text": "Write using black or blue pen Alfow about 30 minutes for this part,", "x0": 0.14175824175824175, "y0": 0.7723387723387724, "x1": 0.8296703296703297, "y1": 0.7948717948717948}, {"text": "Draw diagrams using pencil 4", "x0": 0.14065934065934066, "y0": 0.7847707847707848, "x1": 0.8692307692307693, "y1": 0.8065268065268065}, {"text": "A Data Aheet, Formulae Sheets and", "x0": 0.14065934065934066, "y0": 0.8065268065268065, "x1": 0.4340659340659341, "y1": 0.822066822066822}, {"text": "Perlodic Table are provided at the backof \u2018Total marks (60) Attempt questions -", "x0": 0.14065934065934066, "y0": 0.8228438228438228, "x1": 0.9263736263736264, "y1": 0.8484848484848485}, {"text": "this paper. Allow about I hour and 45 minutes for this part.", "x0": 0.14065934065934066, "y0": 0.8430458430458431, "x1": 0.9252747252747253, "y1": 0.8578088578088578}, {"text": "\u2018Wtire your student name on the top of every", "x0": 0.14065934065934066, "y0": 0.857031857031857, "x1": 0.5032967032967033, "y1": 0.8741258741258742}, {"text": "Page. Section I \u2014 Page 14 \u201c", "x0": 0.13626373626373625, "y0": 0.8741258741258742, "x1": 0.8901098901098901, "y1": 0.9028749028749029}, {"text": "Total marks (25)", "x0": 0.5252747252747253, "y0": 0.8951048951048951, "x1": 0.6648351648351648, "y1": 0.9098679098679099}, {"text": "Attempt all parts of this question,", "x0": 0.5274725274725275, "y0": 0.9114219114219114, "x1": 0.8032967032967033, "y1": 0.9269619269619269}, {"text": "Allow about 45 minutes for this section.", "x0": 0.5285714285714286, "y0": 0.9277389277389277, "x1": 0.8582417582417582, "y1": 0.9401709401709402}], [{"text": "Section 1", "x0": 0.07362637362637363, "y0": 0.006216006216006216, "x1": 0.16483516483516483, "y1": 0.016317016317016316}, {"text": "Total marks (75)", "x0": 0.07252747252747253, "y0": 0.021756021756021756, "x1": 0.22197802197802197, "y1": 0.03651903651903652}, {"text": "Part A", "x0": 0.07252747252747253, "y0": 0.057498057498057496, "x1": 0.14175824175824175, "y1": 0.0707070707070707}, {"text": "Total marks (15)", "x0": 0.07142857142857142, "y0": 0.07614607614607614, "x1": 0.22087912087912087, "y1": 0.09013209013209013}, {"text": "Attempt", "x0": 0.07142857142857142, "y0": 0.0947940947940948, "x1": 0.14615384615384616, "y1": 0.10722610722610723}, {"text": "Allow about 30 minutes for this part", "x0": 0.07032967032967033, "y0": 0.10955710955710955, "x1": 0.45604395604395603, "y1": 0.12432012432012432}, {"text": "Use the multiple-choice answer sheet provided", "x0": 0.07362637362637363, "y0": 0.15073815073815075, "x1": 0.5032967032967033, "y1": 0.16783216783216784}, {"text": "\u2018The reason why the acceleration due to gravity on Mars is different to that on Earth is", "x0": 0.1010989010989011, "y0": 0.18181818181818182, "x1": 0.8010989010989011, "y1": 0.20124320124320125}, {"text": "1", "x0": 0.07252747252747253, "y0": 0.1888111888111888, "x1": 0.08461538461538462, "y1": 0.19968919968919968}, {"text": "Mars has a different atmosphere,", "x0": 0.15274725274725276, "y0": 0.2191142191142191, "x1": 0.4197802197802198, "y1": 0.2338772338772339}, {"text": "(6) Mars has a different mass and radius.", "x0": 0.1010989010989011, "y0": 0.23620823620823622, "x1": 0.45604395604395603, "y1": 0.25252525252525254}, {"text": "Mars is further from the Sun than the Earth.", "x0": 0.15274725274725276, "y0": 0.24864024864024864, "x1": 0.5087912087912088, "y1": 0.26884226884226886}, {"text": "(@) has a different period of rotation.", "x0": 0.1010989010989011, "y0": 0.26884226884226886, "x1": 0.46813186813186813, "y1": 0.2867132867132867}, {"text": "A satellite was placed in orbit around the Earth in the 1980s to \u2018spy\u2019 on Russian military facilities.", "x0": 0.0945054945054945, "y0": 0.31546231546231546, "x1": 0.9032967032967033, "y1": 0.3395493395493395}, {"text": "\u2018The satellite passed over Russia three times a day. This satellite", "x0": 0.0989010989010989, "y0": 0.3356643356643357, "x1": 0.6197802197802198, "y1": 0.35353535353535354}, {"text": "Moved in a low orbit from pole to pole.", "x0": 0.15054945054945054, "y0": 0.3706293706293706, "x1": 0.4736263736263736, "y1": 0.3853923853923854}, {"text": "(b) Moved in a high orbit from pole to pole.", "x0": 0.0989010989010989, "y0": 0.38694638694638694, "x1": 0.47802197802197804, "y1": 0.4048174048174048}, {"text": "(c) Moved in a Jow orbit parallel to the equator.", "x0": 0.0989010989010989, "y0": 0.40404040404040403, "x1": 0.5098901098901099, "y1": 0.4211344211344211}, {"text": "(@ Moved in a high orbit parallel to the equator.", "x0": 0.0989010989010989, "y0": 0.4211344211344211, "x1": 0.5153846153846153, "y1": 0.43745143745143744}, {"text": "The reason why satellites gradually decrease their altitude above the Earth is because", "x0": 0.0967032967032967, "y0": 0.4700854700854701, "x1": 0.7934065934065934, "y1": 0.48795648795648794}, {"text": "(a) The atmosphere slows the satellite down.", "x0": 0.0956043956043956, "y0": 0.5050505050505051, "x1": 0.4835164835164835, "y1": 0.5221445221445221}, {"text": "(b) Of collisions with meteorites.", "x0": 0.0956043956043956, "y0": 0.5167055167055167, "x1": 0.3868131868131868, "y1": 0.5423465423465423}, {"text": "(0) Their power source gradually fails.", "x0": 0.0956043956043956, "y0": 0.5384615384615384, "x1": 0.4318681318681319, "y1": 0.5555555555555556}, {"text": "(@ They interact with the van Allen Radiation Belts,", "x0": 0.0945054945054945, "y0": 0.5547785547785548, "x1": 0.5483516483516484, "y1": 0.5718725718725719}, {"text": ". The aether", "x0": 0.07362637362637363, "y0": 0.5912975912975913, "x1": 0.1813186813186813, "y1": 0.6037296037296037}, {"text": "(a) _ Is necessary for the transmission of light in space.", "x0": 0.09340659340659341, "y0": 0.62004662004662, "x1": 0.5527472527472528, "y1": 0.6425796425796426}, {"text": "(b) Does not exist.", "x0": 0.09340659340659341, "y0": 0.6410256410256411, "x1": 0.26373626373626374, "y1": 0.6565656565656566}, {"text": "(\u00a9) Was discovered by Michelson-Morley.", "x0": 0.09230769230769231, "y0": 0.6565656565656566, "x1": 0.46153846153846156, "y1": 0.6728826728826729}, {"text": "(@ Is everywhere around the Earth.", "x0": 0.09230769230769231, "y0": 0.6736596736596736, "x1": 0.4032967032967033, "y1": 0.6899766899766899}, {"text": ". According to relativity theory, for an object moving close to the speed of light relative to an observer", "x0": 0.07142857142857142, "y0": 0.7218337218337219, "x1": 0.9241758241758242, "y1": 0.7404817404817405}, {"text": "(a) _ length contraction and time dilation would be apparent. \u2018", "x0": 0.0912087912087912, "y0": 0.7536907536907537, "x1": 0.8494505494505494, "y1": 0.7793317793317793}, {"text": "(b) _ length contraction and mass decrease would be apparent.", "x0": 0.0912087912087912, "y0": 0.7731157731157731, "x1": 0.6087912087912087, "y1": 0.7964257964257965}, {"text": "(\u00a9) would stand still.", "x0": 0.09010989010989011, "y0": 0.7940947940947941, "x1": 0.3208791208791209, "y1": 0.8104118104118104}, {"text": "(@__ there would be relativity of simultaneity.", "x0": 0.09010989010989011, "y0": 0.8111888111888111, "x1": 0.4758241758241758, "y1": 0.8275058275058275}, {"text": "HSC Physics Trial Examination", "x0": 0.04945054945054945, "y0": 0.9627039627039627, "x1": 0.25824175824175827, "y1": 0.9735819735819736}], [{"text": "(a) aconductor moves in a inagnetic field.", "x0": 0.1021978021978022, "y0": 0.02097902097902098, "x1": 0.46923076923076923, "y1": 0.03885003885003885}, {"text": "(b) moves parallel to a magnetic field.", "x0": 0.1010989010989011, "y0": 0.03885003885003885, "x1": 0.5362637362637362, "y1": 0.055944055944055944}, {"text": "(c) aconductor moves at right angles to a magnetic field.", "x0": 0.1010989010989011, "y0": 0.055944055944055944, "x1": 0.5912087912087912, "y1": 0.07303807303807304}, {"text": "(d) of the above,", "x0": 0.1010989010989011, "y0": 0.07459207459207459, "x1": 0.2857142857142857, "y1": 0.09090909090909091}, {"text": "7. Astep-down transformer", "x0": 0.07032967032967033, "y0": 0.1250971250971251, "x1": 0.3098901098901099, "y1": 0.13986013986013987}, {"text": "(a) the voltage in the secondary circuit", "x0": 0.1021978021978022, "y0": 0.15773115773115773, "x1": 0.5208791208791209, "y1": 0.17327117327117328}, {"text": "(b) _ increases the power in the secondary circuit.", "x0": 0.1021978021978022, "y0": 0.17094017094017094, "x1": 0.5153846153846153, "y1": 0.19347319347319347}, {"text": "(c) _ increases the current in the secondary circuit.", "x0": 0.1021978021978022, "y0": 0.18803418803418803, "x1": 0.521978021978022, "y1": 0.21056721056721056}, {"text": "_ increases the resistance in the secondary circuit.", "x0": 0.13406593406593406, "y0": 0.20435120435120435, "x1": 0.545054945054945, "y1": 0.22688422688422688}, {"text": "8, Which of the following combinations correctly describes the component necessary for the working of", "x0": 0.07142857142857142, "y0": 0.2501942501942502, "x1": 0.9406593406593406, "y1": 0.27505827505827507}, {"text": "an AC generatot' and a DC generator?", "x0": 0.1021978021978022, "y0": 0.2742812742812743, "x1": 0.41208791208791207, "y1": 0.2898212898212898}, {"text": "AC Generator DC Generator", "x0": 0.23406593406593407, "y0": 0.3084693084693085, "x1": 0.554945054945055, "y1": 0.3209013209013209}, {"text": "@). | Split-ring commutator | Split-ring commutator", "x0": 0.1824175824175824, "y0": 0.33022533022533024, "x1": 0.621978021978022, "y1": 0.351981351981352}, {"text": "(b) | Slip-ring commutator | Slip-ring commutator", "x0": 0.1824175824175824, "y0": 0.35586635586635584, "x1": 0.6164835164835165, "y1": 0.37684537684537683}, {"text": "(c) | Split-ring commutator | Slip-ring commutator", "x0": 0.1824175824175824, "y0": 0.38073038073038074, "x1": 0.6164835164835165, "y1": 0.4024864024864025}, {"text": "(4) | Slip-ring commutator | Split-ring commutator", "x0": 0.1824175824175824, "y0": 0.4063714063714064, "x1": 0.621978021978022, "y1": 0.4281274281274281}, {"text": "-9. You are a transformer with an input voltage of 11 kV AC and an output of 240 V. The", "x0": 0.06593406593406594, "y0": 0.466977466977467, "x1": 0.8956043956043956, "y1": 0.48329448329448327}, {"text": "number of turns in the primary coil is $000, The number of turns that you would have to provide in", "x0": 0.1010989010989011, "y0": 0.48329448329448327, "x1": 0.9164835164835164, "y1": 0.5003885003885004}, {"text": "the secondary coil is", "x0": 0.1010989010989011, "y0": 0.5027195027195027, "x1": 0.2681318681318681, "y1": 0.5174825174825175}, {"text": "(@) 5000", "x0": 0.1, "y0": 0.5369075369075369, "x1": 0.1813186813186813, "y1": 0.5516705516705517}, {"text": "1100", "x0": 0.14175824175824175, "y0": 0.5532245532245532, "x1": 0.18021978021978022, "y1": 0.5648795648795649}, {"text": "(\u00a9 110", "x0": 0.0978021978021978, "y0": 0.5695415695415695, "x1": 0.16923076923076924, "y1": 0.5843045843045843}, {"text": "@ ti", "x0": 0.0978021978021978, "y0": 0.5843045843045843, "x1": 0.15604395604395604, "y1": 0.6006216006216006}, {"text": "10, Eddy currents", "x0": 0.06593406593406594, "y0": 0.6363636363636364, "x1": 0.2087912087912088, "y1": 0.6526806526806527}, {"text": "(a) Have been utilised in switching devices and in electromagnetic braking.", "x0": 0.0956043956043956, "y0": 0.6674436674436675, "x1": 0.7285714285714285, "y1": 0.6845376845376845}, {"text": "(b) Occur only in iron and steel.", "x0": 0.0945054945054945, "y0": 0.6853146853146853, "x1": 0.36813186813186816, "y1": 0.7008547008547008}, {"text": "(\u00a9) Are an example of Faraday\u2019s Law.", "x0": 0.0945054945054945, "y0": 0.7024087024087025, "x1": 0.4186813186813187, "y1": 0.717948717948718}, {"text": "Are necessary to produce electromagnetic interference in transmission devices.", "x0": 0.13406593406593406, "y0": 0.7171717171717171, "x1": 0.7857142857142857, "y1": 0.7334887334887334}, {"text": "4", "x0": 0.8472527472527472, "y0": 0.74203