054945054, "y0": 0.6006216006216006, "x1": 0.1835164835164835, "y1": 0.60994560994561}, {"text": "(iii) The line joining P(x1, yi) to Q(x2, yz) passes through S. Show that 4(y2\u2014y1) =", "x0": 0.15164835164835164, "y0": 0.6184926184926185, "x1": 0.8802197802197802, "y1": 0.6425796425796426}, {"text": "(iv) It is also known that yz) lies on \u20ac. Show that the tangents at P and Q", "x0": 0.15164835164835164, "y0": 0.6666666666666666, "x1": 0.8802197802197802, "y1": 0.6806526806526807}, {"text": "on the ellipse intersect on the directrix corresponding to S.", "x0": 0.15054945054945054, "y0": 0.6845376845376845, "x1": 0.6681318681318681, "y1": 0.6977466977466977}, {"text": "(v) Find the equation of the normal to \u20ac at P and decide under what circumstances,", "x0": 0.15164835164835164, "y0": 0.7094017094017094, "x1": 0.8791208791208791, "y1": 0.7241647241647242}, {"text": "if any, it passes through S or", "x0": 0.15054945054945054, "y0": 0.7272727272727273, "x1": 0.4043956043956044, "y1": 0.7404817404817405}, {"text": "(b) A public opinion survey of a certain parliamentary proposition finds 47% of the", "x0": 0.15164835164835164, "y0": 0.7521367521367521, "x1": 0.8802197802197802, "y1": 0.7661227661227661}, {"text": "population in favour, 38% opposed and 15% undecided. Three persons are selected", "x0": 0.15054945054945054, "y0": 0.7692307692307693, "x1": 0.8802197802197802, "y1": 0.7832167832167832}, {"text": "at random. Using the expansion", "x0": 0.15054945054945054, "y0": 0.7871017871017871, "x1": 0.432967032967033, "y1": 0.8003108003108003}, {"text": "+g) +r + 3p2q + 3q?r + 3pq? + 3qr? + 3rp? + 3r2p + Gpgr", "x0": 0.33076923076923076, "y0": 0.8158508158508159, "x1": 0.8538461538461538, "y1": 0.8313908313908314}, {"text": "or otherwise, find the probability that:", "x0": 0.15054945054945054, "y0": 0.85003885003885, "x1": 0.4879120879120879, "y1": 0.8632478632478633}, {"text": "(i) one person is in favour, one opposed and one is undecided;", "x0": 0.15164835164835164, "y0": 0.8749028749028749, "x1": 0.6956043956043956, "y1": 0.8888888888888888}], [{"text": "29", "x0": 0.8648351648351649, "y0": 0.08469308469308469, "x1": 0.8802197802197802, "y1": 0.09246309246309246}, {"text": "(ii) exactly two persons are opposed;", "x0": 0.15164835164835164, "y0": 0.11655011655011654, "x1": 0.4747252747252747, "y1": 0.12975912975912976}, {"text": "(iii) at least two persons are of the same opinion, either in favour, or opposed or", "x0": 0.15164835164835164, "y0": 0.1414141414141414, "x1": 0.8802197802197802, "y1": 0.1554001554001554}, {"text": "undecided.", "x0": 0.15054945054945054, "y0": 0.1592851592851593, "x1": 0.24175824175824176, "y1": 0.16938616938616938}, {"text": "4. (a) (i) Write an expression for sin(a +), cos(a+ 8) in terms of sin a, sin 3, cos a", "x0": 0.15054945054945054, "y0": 0.1926961926961927, "x1": 0.8802197802197802, "y1": 0.2066822066822067}, {"text": "and cos 3.", "x0": 0.15054945054945054, "y0": 0.21056721056721056, "x1": 0.23516483516483516, "y1": 0.222999222999223}, {"text": "(ii) Show that tan(a + 3) =", "x0": 0.15164835164835164, "y0": 0.23543123543123542, "x1": 0.3978021978021978, "y1": 0.2494172494172494}, {"text": "(iii) Hence find tan (a + %) in terms of tana\u2019", "x0": 0.15164835164835164, "y0": 0.26262626262626265, "x1": 0.5494505494505495, "y1": 0.27972027972027974}, {"text": "(b)", "x0": 0.15164835164835164, "y0": 0.29914529914529914, "x1": 0.17912087912087912, "y1": 0.3123543123543124}, {"text": "The lines AB and BC in the diagram above have equations 3y = \u20144x + 20 and", "x0": 0.15054945054945054, "y0": 0.5314685314685315, "x1": 0.8802197802197802, "y1": 0.5446775446775447}, {"text": "dy = 3a \u2014 15 respectively and meet at B(5,0). BC makes an angle a with the \u00ab", "x0": 0.15054945054945054, "y0": 0.5477855477855478, "x1": 0.8802197802197802, "y1": 0.5617715617715617}, {"text": "axis. The line PQ has equation x = 1 and meets the line AB in Q. BR is the", "x0": 0.15054945054945054, "y0": 0.5656565656565656, "x1": 0.8802197802197802, "y1": 0.5788655788655789}, {"text": "bisector of ZABC.", "x0": 0.15054945054945054, "y0": 0.5827505827505828, "x1": 0.3131868131868132, "y1": 0.5936285936285937}, {"text": "(i) Show that AB is perpendicular to BC and then copy the diagram.", "x0": 0.15164835164835164, "y0": 0.6076146076146076, "x1": 0.7637362637362637, "y1": 0.6216006216006216}, {"text": "(ii) Use (a) to show that BR has equation y = 7 \u2014 35.", "x0": 0.15164835164835164, "y0": 0.6324786324786325, "x1": 0.6428571428571429, "y1": 0.6464646464646465}, {"text": "(iii) The bisector of ZPQB has slope 1/3 and meets BR at S. Calculate the co-", "x0": 0.15164835164835164, "y0": 0.6581196581196581, "x1": 0.8791208791208791, "y1": 0.6721056721056721}, {"text": "ordinates of S.", "x0": 0.15054945054945054, "y0": 0.675990675990676, "x1": 0.27692307692307694, "y1": 0.6860916860916861}, {"text": "(iv) Draw SM and SN perpendicular to AB and BC, meeting AB at M and BC", "x0": 0.15164835164835164, "y0": 0.7008547008547008, "x1": 0.8802197802197802, "y1": 0.7148407148407149}, {"text": "at N, respectively. Prove that SM = SN.", "x0": 0.15054945054945054, "y0": 0.7187257187257188, "x1": 0.5131868131868131, "y1": 0.7319347319347319}, {"text": "(v) Show that $' is the centre of a circle tangential to PQ, AB and BC and write", "x0": 0.15164835164835164, "y0": 0.7435897435897436, "x1": 0.8802197802197802, "y1": 0.7583527583527584}, {"text": "down the equation of the circle.", "x0": 0.15054945054945054, "y0": 0.7614607614607615, "x1": 0.42637362637362636, "y1": 0.7746697746697747}], [{"text": "30", "x0": 0.15054945054945054, "y0": 0.08469308469308469, "x1": 0.16703296703296702, "y1": 0.09246309246309246}, {"text": "5. (a)", "x0": 0.15054945054945054, "y0": 0.15151515151515152, "x1": 0.20549450549450549, "y1": 0.16627816627816627}, {"text": "> quadrilateral; AB and DC produced meet at P; DA and", "x0": 0.35274725274725277, "y0": 0.47785547785547783, "x1": 0.88021978021978