837606, "x1": 0.16483516483516483, "y1": 0.3877233877233877}, {"text": "The circle +y? with centre Q(r,0) and radius r, lies inside the", "x0": 0.1879120879120879, "y0": 0.6223776223776224, "x1": 0.8032967032967033, "y1": 0.6371406371406372}, {"text": "circle x? + y? = 1, with centre O and radius 1. The point P(r +rcos@,", "x0": 0.1879120879120879, "y0": 0.6386946386946387, "x1": 0.7450549450549451, "y1": 0.655011655011655}, {"text": "lies on the inner circle, and P and O do not coincide. The tangent to the inner", "x0": 0.189010989010989, "y0": 0.6596736596736597, "x1": 0.8032967032967033, "y1": 0.6721056721056721}, {"text": "circle at P meets the outer circle at R and S, and the tangents to the outer circle", "x0": 0.1879120879120879, "y0": 0.6783216783216783, "x1": 0.8032967032967033, "y1": 0.6907536907536908}, {"text": "at R and S$ meet at T. The lines OT and RS meet at U, and are", "x0": 0.189010989010989, "y0": 0.6961926961926962, "x1": 0.8032967032967033, "y1": 0.7070707070707071}, {"text": "perpendicular.", "x0": 0.189010989010989, "y0": 0.7148407148407149, "x1": 0.2945054945054945, "y1": 0.7272727272727273}, {"text": "@", "x0": 0.2076923076923077, "y0": 0.7466977466977467, "x1": 0.22417582417582418, "y1": 0.7575757575757576}, {"text": "Show that OT is parallel to QP.", "x0": 0.24505494505494504, "y0": 0.7466977466977467, "x1": 0.4945054945054945, "y1": 0.7591297591297591}, {"text": "\u2018Show that the equation of RS is xcos@+ ysin@ = r(1+cos@).", "x0": 0.24505494505494504, "y0": 0.7762237762237763, "x1": 0.7274725274725274, "y1": 0.7902097902097902}, {"text": "Gi)", "x0": 0.2032967032967033, "y0": 0.7777777777777778, "x1": 0.22417582417582418, "y1": 0.7894327894327894}, {"text": "ii)", "x0": 0.1978021978021978, "y0": 0.8080808080808081, "x1": 0.22417582417582418, "y1": 0.8197358197358198}, {"text": "Find the length of OU.", "x0": 0.24505494505494504, "y0": 0.8080808080808081, "x1": 0.4197802197802198, "y1": 0.8205128205128205}, {"text": "(iv)", "x0": 0.1978021978021978, "y0": 0.8414918414918415, "x1": 0.22417582417582418, "y1": 0.8531468531468531}, {"text": "By using the result of part (a), show that T lies on the curve", "x0": 0.24505494505494504, "y0": 0.8414918414918415, "x1": 0.8032967032967033, "y1": 0.853923853923854}, {"text": "Py?", "x0": 0.24835164835164836, "y0": 0.857031857031857, "x1": 0.2802197802197802, "y1": 0.8733488733488733}], [{"text": "QUESTION 7. (Continued)", "x0": 0.14285714285714285, "y0": 0.0979020979020979, "x1": 0.3626373626373626, "y1": 0.10955710955710955}, {"text": "Marks", "x0": 0.8153846153846154, "y0": 0.10644910644910645, "x1": 0.8703296703296703, "y1": 0.11577311577311578}, {"text": "\u00a9", "x0": 0.14395604395604394, "y0": 0.14918414918414918, "x1": 0.16263736263736264, "y1": 0.16083916083916083}, {"text": "6", "x0": 0.8615384615384616, "y0": 0.14918414918414918, "x1": 0.8703296703296703, "y1": 0.1585081585081585}, {"text": "The parabola x? =4ay touches the circle x? +y?+2gx+2fy+ce=0 at J,", "x0": 0.1879120879120879, "y0": 0.4506604506604507, "x1": 0.8021978021978022, "y1": 0.4662004662004662}, {"text": "and cuts it at K and L. The midpoint of KL is M, and the line JM cuts the", "x0": 0.189010989010989, "y0": 0.4700854700854701, "x1": 0.8032967032967033, "y1": 0.4825174825174825}, {"text": "yaxis at N, as shown on the diagram.", "x0": 0.1879120879120879, "y0": 0.48562548562548563, "x1": 0.4747252747252747, "y1": 0.49805749805749805}, {"text": "Find a quartic equation whose roots are the x coordinates of J, K, and L.", "x0": 0.24505494505494504, "y0": 0.5167055167055167, "x1": 0.789010989010989, "y1": 0.5291375291375291}, {"text": "(ii) Show that JN = NM.", "x0": 0.2032967032967033, "y0": 0.5439005439005439, "x1": 0.41208791208791207, "y1": 0.5625485625485626}, {"text": "(iii) Hence show that the area of AJKN is one-quarter of the area of AJKL.", "x0": 0.1978021978021978, "y0": 0.578088578088578, "x1": 0.798901098901099, "y1": 0.5905205905205905}], [{"text": "10", "x0": 0.5, "y0": 0.057498057498057496, "x1": 0.5164835164835165, "y1": 0.06682206682206682}, {"text": "QUESTION 8. Use a separate Writing Booklet. Marks", "x0": 0.14395604395604394, "y0": 0.0979020979020979, "x1": 0.8703296703296703, "y1": 0.11577311577311578}, {"text": "(a) F 10", "x0": 0.14395604395604394, "y0": 0.14685314685314685, "x1": 0.8703296703296703, "y1": 0.16083916083916083}, {"text": "Triangle ABC is scalene. External equilateral triangles ABF, BCD, and CAE", "x0": 0.1879120879120879, "y0": 0.41025641025641024, "x1": 0.8043956043956044, "y1": 0.4226884226884227}, {"text": "are constructed on the sides of triangle ABC as shown.", "x0": 0.189010989010989, "y0": 0.42657342657342656, "x1": 0.6087912087912087, "y1": 0.439005439005439}, {"text": "Lines AD and BE meetat X.", "x0": 0.189010989010989, "y0": 0.452991452991453, "x1": 0.4186813186813187, "y1": 0.46231546231546233}, {"text": "Copy or trace this diagram into your Writing Booklet.", "x0": 0.1879120879120879, "y0": 0.4902874902874903, "x1": 0.5978021978021978, "y1": 0.5027195027195027}, {"text": "(Show that ZBCE = ZDCA.", "x0": 0.2076923076923077, "y0": 0.5244755244755245, "x1": 0.46373626373626375, "y1": 0.5353535353535354}, {"text": "(ii) Show that ABCE = ADCA.", "x0": 0.2032967032967033, "y0": 0.5594405594405595, "x1": 0.4593406593406593, "y1": 0.5710955710955711}, {"text": "(iii) Show that BDCX is a cyclic quadrilateral.", "x0": 0.1978021978021978, "y0": 0.5951825951825952, "x1": 0.5659340659340659, "y1": 0.6076146076146076}, {"text": "(iv) Show that ZBXD = ZDXC = ZCXE = ZEXA", "x0": 0.1978021978021978, "y0": 0.6324786324786325, "x1": 0.6010989010989011, "y1": 0.6511266511266511}, {"text": "(v) Show that CF passes through X.", "x0": 0.2032967032967033, "y0": 0.6783216783216783, "x1": 0.5010989010989011, "y1": 0.6907536907536908}, {"text": "(vi) Show that AD=", "x0": 0.1978021978021978, "y0": 0.7125097125097125, "x1": 0.3747252747252747, "y1": 0.7241647241647242}], [{"text": "QUESTION 8. (Continued) Marks", "x0": 0.14395604395604394, "y0": 0.0979020979020979, "x1": 0.8703296703296703, "y1": 0.11577311577311578}, {"text": "(b)", "x0": 0.14395604395604394, "y0": 0.14918414918414918, "x1": 0.16483516483516483, "y1": 0.16083916083916083}, {"text": "The diagram shows points O, R, S, T, and U in the complex plane. These points", "x0": 0.1879120879120879, "y0": 0.41647241647241645, "x1": 0.8032967032967033, "y1": 0.4289044289044289}, {"text": "correspond to the complex numbers 0, r, s, f, and w respectively. The", "x0": 0.1879120879120879, "y0": 0.4366744366744367, "x1": 0.8032967032967033, "y1": 0.4491064491064491}, {"text": "triangles ORS and OTU are equilateral. Let +i sing.", "x0": 0.189010989010989, "y0": 0.4483294483294483, "x1": 0.6978021978021978, "y1": 0.4763014763014763}, {"text": "@ Explain why", "x0": 0.2076923076923077, "y0": 0.49106449106449107, "x1": 0.34175824175824177, "y1": 0.5034965034965035}, {"text": "(ii) Find the complex number r in terms of s.", "x0": 0.2032967032967033, "y0": 0.5268065268065268, "x1": 0.5703296703296703, "y1": 0.5392385392385393}, {"text": "(iii) Using complex numbers, show that the lengths of RT and SU are", "x0": 0.1978021978021978, "y0": 0.560994560994561, "x1": 0.8032967032967033, "y1": 0.5734265734265734}, {"text": "equal.", "x0": 0.24505494505494504, "y0": 0.578088578088578, "x1": 0.2879120879120879, "y1": 0.5905205905205905}], [{"text": "12", "x0": 0.5, "y0": 0.057498057498057496, "x1": 0.5153846153846153, "y1": 0.06682206682206682}, {"text": "STANDARD INTEGRALS", "x0": 0.3901098901098901, "y0": 0.0979020979020979, "x1": 0.621978021978022, "y1": 0.10722610722610723}, {"text": "1", "x0": 0.4725274725274725, "y0": 0.13286713286713286, "x1": 0.4758241758241758, "y1": 0.14219114219114218}, {"text": "nl", "x0": 0.5065934065934066, "y0": 0.1383061383061383, "x1": 0.5274725274725275, "y1": 0.1452991452991453}, {"text": "x\" de x#0,ifn<0", "x0": 0.3054945054945055, "y0": 0.14063714063714064, "x1": 0.7274725274725274, "y1": 0.15151515151515152}