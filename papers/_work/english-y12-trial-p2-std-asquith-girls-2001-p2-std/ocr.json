648351645, "y0": 0.3992217898832685, "x1": 0.2967032967032967, "y1": 0.41167315175097274}, {"text": "What do you think is the dramatic function of Bear in this play?", "x0": 0.04725274725274725, "y0": 0.4132295719844358, "x1": 0.45604395604395603, "y1": 0.4365758754863813}, {"text": "OR", "x0": 0.4582417582417582, "y0": 0.4622568093385214, "x1": 0.4868131868131868, "y1": 0.4723735408560311}, {"text": "John Misto, The Shoehorn Sonata", "x0": 0.051648351648351645, "y0": 0.4840466926070039, "x1": 0.3098901098901099, "y1": 0.4964980544747082}, {"text": "Examine the roles played by the two women in Shoehorn Sonata. To what extent do they achieve peace by", "x0": 0.051648351648351645, "y0": 0.5260700389105059, "x1": 0.8648351648351649, "y1": 0.5408560311284046}, {"text": "the play\u2019s conclusion?", "x0": 0.051648351648351645, "y0": 0.5431906614785992, "x1": 0.22087912087912087, "y1": 0.556420233463035}, {"text": "OR", "x0": 0.4593406593406593, "y0": 0.5649805447470817, "x1": 0.4879120879120879, "y1": 0.5750972762645914}, {"text": "William Shakespeare, Macbeth", "x0": 0.051648351648351645, "y0": 0.5867704280155642, "x1": 0.289010989010989, "y1": 0.6}, {"text": "Choose THREE key scenes from the play and discuss their dramatic impact on the play as a whole.", "x0": 0.051648351648351645, "y0": 0.6038910505836576, "x1": 0.6813186813186813, "y1": 0.622568093385214}, {"text": "OR", "x0": 0.4593406593406593, "y0": 0.6474708171206226, "x1": 0.4879120879120879, "y1": 0.6575875486381323}, {"text": "Question 5 - Prose Fiction", "x0": 0.05274725274725275, "y0": 0.670817120622568, "x1": 0.2967032967032967, "y1": 0.6848249027237354}, {"text": "Robert Cormier, We All Fall Down", "x0": 0.05274725274725275, "y0": 0.6933852140077821, "x1": 0.31758241758241756, "y1": 0.7058365758754864}, {"text": "How does the novel, We Ail Fall Down demonstrate many of the weaknesses in modern Western societies?", "x0": 0.05274725274725275, "y0": 0.709727626459144, "x1": 0.7329670329670329, "y1": 0.7315175097276264}, {"text": "OR", "x0": 0.4604395604395604, "y0": 0.754863813229572, "x1": 0.489010989010989, "y1": 0.7642023346303501}, {"text": "Jane Yolen, Briar Rose", "x0": 0.051648351648351645, "y0": 0.7704280155642024, "x1": 0.22857142857142856, "y1": 0.7828793774319066}, {"text": "\u201cHappy ever after isa fairy tale notion, not history.\u201d", "x0": 0.04835164835164835, "y0": 0.7945525291828793, "x1": 0.38351648351648354, "y1": 0.8194552529182879}, {"text": "Examine the role that fairy tales and myth making play in the composition of this text,", "x0": 0.11648351648351649, "y0": 0.8070038910505837, "x1": 0.6626373626373626, "y1": 0.8311284046692607}, {"text": "& Question 6 - Nonfiction, Film, Media or Multimedia", "x0": 0.09340659340659341, "y0": 0.842023346303502, "x1": 0.6120879120879121, "y1": 0.8575875486381322}, {"text": "Film \u2014 Peter Weir, Witness", "x0": 0.051648351648351645, "y0": 0.867704280155642, "x1": 0.26593406593406593, "y1": 0.8793774319066148}, {"text": "\u2018Explore the significance of these three images from the film both in terms of narrative development and cinematic techniques.", "x0": 0.05054945054945055, "y0": 0.8793774319066148, "x1": 0.8516483516483516, "y1": 0.9035019455252918}], [{"text": "Images are from Witness, directed by Peter Weir, 1985. Paramount Studios", "x0": 0.08131868131868132, "y0": 0.10272373540856031, "x1": 0.5230769230769231, "y1": 0.1245136186770428}, {"text": "OR", "x0": 0.4604395604395604, "y0": 0.7424124513618677, "x1": 0.489010989010989, "y1": 0.7533073929961089}], [{"text": "6", "x0": 0.46153846153846156, "y0": 0.10272373540856031, "x1": 0.4824175824175824, "y1": 0.11284046692607004}, {"text": "Non-fiction \u2014 Gordon Matthews, An Australian Son", "x0": 0.05054945054945055, "y0": 0.1245136186770428, "x1": 0.4604395604395604, "y1": 0.13618677042801555}, {"text": "\u2018What does the reader learn from this text about self-discovery? In your response evaluate what use Matthews makes of the", "x0": 0.05054945054945055, "y0": 0.13852140077821012, "x1": 0.8274725274725274, "y1": 0.16264591439688716}, {"text": "techniques of autobiography.", "x0": 0.05054945054945055, "y0": 0.1517509727626459, "x1": 0.23516483516483516, "y1": 0.17587548638132297}, {"text": "OR", "x0": 0.4582417582417582, "y0": 0.19221789883268484, "x1": 0.4868131868131868, "y1": 0.20233463035019456}, {"text": "Multimedia \u2014 Australian War Memorial Website", "x0": 0.051648351648351645, "y0": 0.22957198443579765, "x1": 0.42857142857142855, "y1": 0.24046692607003892}, {"text": "The section of this site set for study is:", "x0": 0.04725274725274725, "y0": 0.24591439688715952, "x1": 0.2989010989010989, "y1": 0.267704280155642}, {"text": "Information is available in the July issue of the BOS Bulletin", "x0": 0.051648351648351645, "y0": 0.26536964980544747, "x1": 0.43846153846153846, "y1": 0.28715953307392994}, {"text": "How does the Australian War Memorial Site offer the viewer both information and understanding of Australians at war in France in", "x0": 0.05274725274725275, "y0": 0.3042801556420233, "x1": 0.8868131868131868, "y1": 0.32607003891050584}, {"text": "1918?", "x0": 0.05384615384615385, "y0": 0.3237354085603113, "x1": 0.09010989010989011, "y1": 0.33229571984435796}, {"text": "OR", "x0": 0.4593406593406593, "y0": 0.3431906614785992, "x1": 0.4879120879120879, "y1": 0.35330739299610897}, {"text": "Question 7 \u2014-Poetry", "x0": 0.05274725274725275, "y0": 0.3665369649805447, "x1": 0.24615384615384617, "y1": 0.38132295719844356}, {"text": "Debbie Westbury, Mouth to Mouth", "x0": 0.05274725274725275, "y0": 0.38910505836575876, "x1": 0.31978021978021975, "y1": 0.4031128404669261}, {"text": "\u2018The prescribed poems are: \u2018The Scribe\u2019s Daughter\u2019, \u201cThe Prince\u2019, \u2018shells\u2019, \u201cTV News\u2019, \u2018Somewhere else\u2019, Mouth to Mouth\u2019,", "x0": 0.05274725274725275, "y0": 0.40778210116731517, "x1": 0.843956043956044, "y1": 0.42568093385214006}, {"text": "\u201cDapto Dressing Up\u2019.", "x0": 0.05384615384615385, "y0": 0.42412451361867703, "x1": 0.1879120879120879, "y1": 0.4350194552529183}, {"text": "\u2018Comment on the use of structure and form in \u2018Mouth to Mouth\u2019 and one other of Westbury\u2019s prescribed poems.", "x0": 0.04835164835164835, "y0": 0.4357976653696498, "x1": 0.7593406593406593, "y1": 0.4591439688715953}, {"text": "OR", "x0": 0.4593406593406593, "y0": 0.4856031128404669, "x1": 0.4879120879120879, "y1": 0.49494163424124515}, {"text": "Wilfred Owen, War Poems and Others", "x0": 0.05274725274725275, "y0": 0.5284046692607004, "x1": 0.34945054945054943, "y1": 0.5408560311284046}, {"text": "\u2018The prescribed poems are: \u2018The \u2018Anthem for Doomed Youth\u2019, \u2018Dulce et Decorum Est\u2019, \u2018Miners\u2019, \u2018Spring Offensive\u2019", "x0": 0.05274725274725275, "y0": 0.5494163424124514, "x1": 0.8648351648351649, "y1": 0.5610894941634241}, {"text": "and \u2018Futil", "x0": 0.05274725274725275, "y0": 0.5634241245136187, "x1": 0.1087912087912088, "y1": 0.5712062256809338}, {"text": "Examine what use Owen makes of form in \u2018Anthem for Doomed Youth\u2019 and one other of his prescribed poems.", "x0": 0.05274725274725275, "y0": 0.5758754863813229, "x1": 0.7604395604395604, "y1": 0.5976653696498054}], [{"text": "-7-", "x0": 0.46483516483516485, "y0": 0.09727626459143969, "x1": 0.4879120879120879, "y1": 0.10739299610894941}, {"text": "SECTION III", "x0": 0.421978021978022, "y0": 0.11828793774319066, "x1": 0.5296703296703297, "y1": 0.12996108949416343}, {"text": "Module C: Text and Society (20 marks)", "x0": 0.3, "y0": 0.14007782101167315, "x1": 0.6516483516483517, "y1": 0.154863813229572}, {"text": "Attempt ONE question from Questions 8 - 10", "x0": 0.051648351648351645, "y0": 0.16186770428015565, "x1": 0.4582417582417582, "y1": 0.17509727626459143}, {"text": "Allow about 40 minutes for this section", "x0": 0.05274725274725275, "y0": 0.18365758754863815, "x1": 0.4098901098901099, "y1": 0.1953307392996109}, {"text": "Answer the question on your examination pad. Write your name on the back of each sheet of", "x0": 0.051648351648351645, "y0": 0.20622568093385213, "x1": 0.8516483516483516, "y1": 0.22101167315175096}, {"text": "paper on which you write.", "x0": 0.05274725274725275, "y0": 0.22178988326848248, "x1": 0.2692307692307692, "y1": 0.23501945525291829}, {"text": "In this section you will be assessed on how well you:", "x0": 0.05274725274725275, "y0": 0.25836575875486384, "x1": 0.4186813186813187, "y1": 0.28249027237354085}, {"text": "+ demonstrate analysis of the ways texts shape meaning", "x0": 0.05274725274725275, "y0": 0.2848249027237354, "x1": 0.44835164835164837, "y1": 0.2972762645914397}, {"text": "+ organise, develop and express ideas using language appropriate to audience, purpose and form", "x0": 0.05274725274725275, "y0": 0.3042801556420233, "x1": 0.7384615384615385, "y1": 0.3175097276264591}, {"text": "Question 8 The Institution and Personal Experience", "x0": 0.05274725274725275, "y0": 0.34474708171206225, "x1": 0.5505494505494506, "y1": 0.3603112840466926}, {"text": "Write a magazine article exploring individual and social responsibility. Base this article on your prescribed text and other related", "x0": 0.051648351648351645, "y0": 0.377431906614786, "x1": 0.8736263736263736, "y1": 0.40077821011673154}, {"text": "texts of your own choosing.", "x0": 0.05054945054945055, "y0": 0.3961089494163424, "x1": 0.22857142857142856, "y1": 0.40700389105058365}, {"text": "\u2018The prescribed texts are:", "x0": 0.051648351648351645, "y0": 0.4217898832684825, "x1": 0.2087912087912088, "y1": 0.43268482490272375}, {"text": "* Prose fiction \u2018Scott Monk, Raw", "x0": 0.051648351648351645, "y0": 0.4350194552529183, "x1": 0.33516483516483514, "y1": 0.445136186770428}, {"text": "+ Drama Tony Strachan, State of Shock", "x0": 0.051648351648351645, "y0": 0.4404669260700389, "x1": 0.35934065934065934, "y1": 0.46459143968871597}, {"text": "+ Film Bill Couturie, Dear America", "x0": 0.051648351648351645, "y0": 0.4521400778210117, "x1": 0.4065934065934066, "y1": 0.47704280155642026}, {"text": "OR", "x0": 0.4604395604395604, "y0": 0.4910505836575875, "x1": 0.489010989010989, "y1": 0.5011673151750973}, {"text": "Question 9. Exploration and Travel", "x0": 0.051648351648351645, "y0": 0.5198443579766537, "x1": 0.3912087912087912, "y1": 0.535408560311284}, {"text": "Use the image included for you below as a starting point to compose a text dealing with exploration and travel. In this text you must", "x0": 0.05054945054945055, "y0": 0.5377431906614786, "x1": 0.8956043956043956, "y1": 0.5610894941634241}, {"text": "make references to your prescribed text and other related texts of your own choosing,", "x0": 0.046153846153846156, "y0": 0.5486381322957199, "x1": 0.6, "y1": 0.5727626459143969}, {"text": "\u2018What insights have you discovered whilst exploring a variety of texts dealing with exploration and travel?", "x0": 0.04835164835164835, "y0": 0.7105058365758755, "x1": 0.7241758241758242, "y1": 0.7346303501945526}, {"text": "Base your response on your prescribed text and other related texts of your own choosing.", "x0": 0.1010989010989011, "y0": 0.7237354085603113, "x1": 0.6780219780219781, "y1": 0.7478599221789883}, {"text": "*NOTE: Getaway is a television program where various presenters go to and present travel destinations for viewers, giving", "x0": 0.04835164835164835, "y0": 0.7494163424124514, "x1": 0.8351648351648352, "y1": 0.7735408560311284}, {"text": "information about how to get there, prices, activities and value for money.", "x0": 0.04835164835164835, "y0": 0.7610894941634241, "x1": 0.5208791208791209, "y1": 0.7852140077821012}, {"text": "\u2018The prescribed texts are:", "x0": 0.04725274725274725, "y0": 0.7945525291828793, "x1": 0.2043956043956044, "y1": 0.8054474708171206}, {"text": "+ Prose Fiction Douglas Adams, A Guide to the Galaxy", "x0": 0.04285714285714286, "y0": 0.8, "x1": 0.5604395604395604, "y1": 0.82568093385214}, {"text": "+ Media Les Hiddins, The Bush Tucker Man: Stories of Survival (\u2018Gold Fever\u2019, \u2018The", "x0": 0.04725274725274725, "y0": 0.8147859922178988, "x1": 0.7065934065934066, "y1": 0.8389105058365759}, {"text": "Passionate Prussian\u2019, \u2018The Great Misadventure\u2019, \u2018Into the Vilest Country\u201d)", "x0": 0.22087912087912087, "y0": 0.8334630350194553, "x1": 0.6978021978021978, "y1": 0.846692607003891}, {"text": "+ Nonfiction Robyn Davidson, Tracks", "x0": 0.04725274725274725, "y0": 0.8459143968871595, "x1": 0.3791208791208791, "y1": 0.8599221789883269}, {"text": "OR", "x0": 0.45604395604395603, "y0": 0.8933852140077821, "x1": 0.4857142857142857, "y1": 0.9035019455252918}], [{"text": "8", "x0": 0.45714285714285713, "y0": 0.10116731517509728, "x1": 0.4824175824175824, "y1": 0.11206225680933853}, {"text": "\u00a5 Question 10. Consumerism", "x0": 0.03296703296703297, "y0": 0.17509727626459143, "x1": 0.3054945054945055, "y1": 0.18910505836575875}, {"text": "Compose a magazine article on consumerism that deals with aspects of consumerism in society. The title for", "x0": 0.04945054945054945, "y0": 0.21167315175097276, "x1": 0.878021978021978, "y1": 0.2264591439688716}, {"text": "your article is: \u201cConsumerism is a Modern Disease\u201d, In your article refer to your prescribed text and your", "x0": 0.04945054945054945, "y0": 0.2272373540856031, "x1": 0.8670329670329671, "y1": 0.24202334630350195}, {"text": "Wide reading.", "x0": 0.04945054945054945, "y0": 0.2443579766536965, "x1": 0.15274725274725276, "y1": 0.25758754863813227}, {"text": "The prescribed texts are:", "x0": 0.05054945054945055, "y0": 0.29105058365758757, "x1": 0.23736263736263735, "y1": 0.3042801556420233}, {"text": "+ Poetry Bruce Dawe, Sometimes Gladness (\u2018Enter Without So Much as", "x0": 0.05054945054945055, "y0": 0.3050583657587549, "x1": 0.7065934065934066, "y1": 0.31906614785992216}, {"text": "Knocking\u2019, \u2018Americanized\u2019, \u2018Abandonment of Autos,\u2019", "x0": 0.2230769230769231, "y0": 0.32062256809338524, "x1": 0.6384615384615384, "y1": 0.333852140077821}, {"text": "\u2018The Not-so-good Earth\u2019 and \u2018Televistas\u2019)", "x0": 0.3505494505494505, "y0": 0.3361867704280156, "x1": 0.6725274725274726, "y1": 0.34941634241245134}, {"text": "+ Multimedia Real Wild Child Consortium, Real Wild Child", "x0": 0.051648351648351645, "y0": 0.35175097276264594, "x1": 0.578021978021978, "y1": 0.3642023346303502}]]