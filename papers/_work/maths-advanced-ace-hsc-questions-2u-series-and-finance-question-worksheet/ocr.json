815073815073}, {"text": "of the first eight terms is 20.", "x0": 0.06813186813186813, "y0": 0.5081585081585082, "x1": 0.3010989010989011, "y1": 0.533022533022533}, {"text": "Example 7", "x0": 0.07252747252747253, "y0": 0.5493395493395493, "x1": 0.15494505494505495, "y1": 0.5625485625485626}, {"text": "If T; = 12 and T, = 96 are two terms of a geometric sequence, find the values of a and", "x0": 0.07252747252747253, "y0": 0.5672105672105672, "x1": 0.7901098901098901, "y1": 0.5804195804195804}, {"text": "r and use them", "x0": 0.7956043956043956, "y0": 0.5672105672105672, "x1": 0.9208791208791208, "y1": 0.5773115773115773}, {"text": "to write down the first three terms of the sequence.", "x0": 0.07142857142857142, "y0": 0.5843045843045843, "x1": 0.4967032967032967, "y1": 0.5967365967365967}, {"text": "Example 8", "x0": 0.07252747252747253, "y0": 0.6192696192696193, "x1": 0.15494505494505495, "y1": 0.6324786324786325}, {"text": "The population of a colony of wading birds is decreasing by 15% each year. The initial population", "x0": 0.07142857142857142, "y0": 0.6371406371406372, "x1": 0.8604395604395605, "y1": 0.6495726495726496}, {"text": "is 30 000", "x0": 0.8681318681318682, "y0": 0.6379176379176379, "x1": 0.9384615384615385, "y1": 0.6472416472416472}, {"text": "birds.", "x0": 0.07252747252747253, "y0": 0.655011655011655, "x1": 0.11648351648351649, "y1": 0.6643356643356644}, {"text": "a) Find how many birds remain after 5 years (to the nearest thousand).", "x0": 0.1021978021978022, "y0": 0.6713286713286714, "x1": 0.6901098901098901, "y1": 0.6837606837606838}, {"text": "b) Find when the population is equal to 9000.", "x0": 0.10329670329670329, "y0": 0.6891996891996892, "x1": 0.48131868131868133, "y1": 0.7016317016317016}, {"text": "c) Sketch the graph of the population as a function of time.", "x0": 0.1021978021978022, "y0": 0.6985236985236986, "x1": 0.5934065934065934, "y1": 0.7241647241647242}, {"text": "Example 9", "x0": 0.07252747252747253, "y0": 0.74125874125874