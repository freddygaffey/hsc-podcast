[[{"text": "GOVERNMENT", "x0": 0.12197802197802197, "y0": 0.1592851592851593, "x1": 0.22527472527472528, "y1": 0.16705516705516704}, {"text": "NSW Education Standards Authority", "x0": 0.11978021978021978, "y0": 0.19114219114219114, "x1": 0.4725274725274725, "y1": 0.20512820512820512}, {"text": "2022 | HIGHER SCHOOL CERTIFICATE EXAMINATION", "x0": 0.12747252747252746, "y0": 0.30691530691530694, "x1": 0.5857142857142857, "y1": 0.331002331002331}, {"text": "English Extension 1", "x0": 0.12307692307692308, "y0": 0.351981351981352, "x1": 0.5813186813186814, "y1": 0.38694638694638694}, {"text": "General + Reading time 10 minutes", "x0": 0.11978021978021978, "y0": 0.4289044289044289, "x1": 0.5241758241758242, "y1": 0.4483294483294483}, {"text": "Instructions Working time \u2014 2 hours", "x0": 0.11978021978021978, "y0": 0.44988344988344986, "x1": 0.49230769230769234, "y1": 0.4662004662004662}, {"text": "+ Write using black pen", "x0": 0.2681318681318681, "y0": 0.473970473970474, "x1": 0.47802197802197804, "y1": 0.48717948717948717}, {"text": "Total marks: Section | - 25 marks (pages 3-5)", "x0": 0.11868131868131868, "y0": 0.5283605283605284, "x1": 0.5714285714285714, "y1": 0.5415695415695416}, {"text": "50 + Attempt Question 1", "x0": 0.11868131868131868, "y0": 0.5454545454545454, "x1": 0.45604395604395603, "y1": 0.5656565656565656}, {"text": "+ Allow about 1 hour for this section", "x0": 0.2681318681318681, "y0": 0.5734265734265734, "x1": 0.5934065934065934, "y1": 0.5835275835275835}, {"text": "Section II - 25 marks (pages 6-11)", "x0": 0.26703296703296703, "y0": 0.6068376068376068, "x1": 0.589010989010989, "y1": 0.62004662004662}, {"text": "+ Attempt Question 2", "x0": 0.2681318681318681, "y0": 0.6309246309246309, "x1": 0.4582417582417582, "y1": 0.6441336441336442}, {"text": "+ Allow about 1 hour for this section", "x0": 0.2681318681318681, "y0": 0.6526806526806527, "x1": 0.5934065934065934, "y1": 0.6627816627816627}, {"text": "2250", "x0": 0.08131868131868132, "y0": 0.9463869463869464, "x1": 0.11758241758241758, "y1": 0.9549339549339549}], [{"text": "BLANK PAGE", "x0": 0.43626373626373627, "y0": 0.3550893550893551, "x1": 0.5626373626373626, "y1": 0.3644133644133644}], [{"text": "Section I \u2014 Common Module: Literary Worlds", "x0": 0.11978021978021978, "y0": 0.08236208236208237, "x1": 0.5989010989010989, "y1": 0.09712509712509712}, {"text": "25 marks", "x0": 0.11868131868131868, "y0": 0.11732711732711733, "x1": 0.1989010989010989, "y1": 0.12742812742812742}, {"text": "Attempt Question 1", "x0": 0.11868131868131868, "y0": 0.13364413364413363, "x1": 0.2868131868131868, "y1": 0.14685314685314685}, {"text": "Allow about 1 hour for this section", "x0": 0.11868131868131868, "y0": 0.15073815073815075, "x1": 0.4186813186813187, "y1": 0.16083916083916083}, {"text": "Answer the question on pages 2~12 of the English Extension 1 Writing Booklet. Extra writing", "x0": 0.11978021978021978, "y0": 0.18337218337218336, "x1": 0.8791208791208791, "y1": 0.19658119658119658}, {"text": "booklets are available.", "x0": 0.11868131868131868, "y0": 0.20046620046620048, "x1": 0.2989010989010989, "y1": 0.21056721056721056}, {"text": "Your answer will be assessed on how well you:", "x0": 0.14395604395604394, "y0": 0.23154623154623155, "x1": 0.5274725274725275, "y1": 0.24397824397824397}, {"text": "e demonstrate an understanding of the ideas and values of Literary Worlds and how", "x0": 0.14285714285714285, "y0": 0.2501942501942502, "x1": 0.8538461538461538, "y1": 0.2634032634032634}, {"text": "they are shaped and reflected in texts", "x0": 0.16703296703296702, "y0": 0.26728826728826727, "x1": 0.46703296703296704, "y1": 0.2804972804972805}, {"text": "\u00a9 craft a sustained composition appropriate to the question, demonstrating control of the", "x0": 0.14285714285714285, "y0": 0.2874902874902875, "x1": 0.856043956043956, "y1": 0.3006993006993007}, {"text": "use of language", "x0": 0.16703296703296702, "y0": 0.3038073038073038, "x1": 0.2934065934065934, "y1": 0.317016317016317}, {"text": "Question 1 (25 marks)", "x0": 0.11978021978021978, "y0": 0.34965034965034963, "x1": 0.30439560439560437, "y1": 0.3620823620823621}, {"text": "Read Texts 1, 2 and 3 on pages 4-5.", "x0": 0.11978021978021978, "y0": 0.38306138306138304, "x1": 0.41318681318681316, "y1": 0.3954933954933955}, {"text": "Consider the ideas about Literary Worlds that are common to Texts 1, 2 and 3.", "x0": 0.11868131868131868, "y0": 0.41647241647241645, "x1": 0.7582417582417582, "y1": 0.4289044289044289}, {"text": "Use these ideas as the basis of an imaginative response where you create a world with characters", "x0": 0.11978021978021978, "y0": 0.4491064491064491, "x1": 0.8791208791208791, "y1": 0.46231546231546233}, {"text": "who represent divergent points of view.", "x0": 0.11978021978021978, "y0": 0.4662004662004662, "x1": 0.43956043956043955, "y1": 0.4794094794094794}, {"text": "Question 1 continues on page 4", "x0": 0.3659340659340659, "y0": 0.533022533022533, "x1": 0.6329670329670329, "y1": 0.5462315462315462}], [{"text": "Question | (continued)", "x0": 0.11978021978021978, "y0": 0.08158508158508158, "x1": 0.30439560439560437, "y1": 0.09401709401709402}, {"text": "Text 1", "x0": 0.14285714285714285, "y0": 0.128982128982129, "x1": 0.1956043956043956, "y1": 0.13908313908313907}, {"text": "Literary writers, unless they are writing fairy tales, learn early never to have characters", "x0": 0.14285714285714285, "y0": 0.1623931623931624, "x1": 0.856043956043956, "y1": 0.17560217560217561}, {"text": "who are polar opposites, one \u2018good\u2019, the other \u2018evil\u2019. That\u2019s not believable. People are", "x0": 0.14395604395604394, "y0": 0.1794871794871795, "x1": 0.856043956043956, "y1": 0.1926961926961927}, {"text": "more than just good and evil. Intelligent readers will demand that you not reduce people", "x0": 0.14285714285714285, "y0": 0.1926961926961927, "x1": 0.856043956043956, "y1": 0.21212121212121213}, {"text": "to such simplistic terms, or resolve situations with \u2018Good always conquers evil\u2019, \u2018Might", "x0": 0.14395604395604394, "y0": 0.2128982128982129, "x1": 0.856043956043956, "y1": 0.22533022533022534}, {"text": "is always right\u2019, and so forth. And while such resolutions are common ... they are feeble", "x0": 0.14395604395604394, "y0": 0.22921522921522922, "x1": 0.856043956043956, "y1": 0.24242424242424243}, {"text": "in literary fiction, which is supposed to reflect subtle truths about the world. Better to be", "x0": 0.14395604395604394, "y0": 0.24553224553224554, "x1": 0.856043956043956, "y1": 0.25874125874125875}, {"text": "subtle rather than overbearing, subversive rather than didactic.", "x0": 0.14395604395604394, "y0": 0.26262626262626265, "x1": 0.6472527472527473, "y1": 0.27583527583527584}, {"text": "... Your own voice is one that seeks a personal truth, one that only you can obtain. That", "x0": 0.14395604395604394, "y0": 0.29603729603729606, "x1": 0.856043956043956, "y1": 0.30924630924630925}, {"text": "truth comes from your own experiences, your own observations, and when you find it,", "x0": 0.14395604395604394, "y0": 0.3123543123543124, "x1": 0.8384615384615385, "y1": 0.32556332556332557}, {"text": "it really is true and specific to you, you may be surprised that others find it to be true as", "x0": 0.14395604395604394, "y0": 0.32944832944832947, "x1": 0.856043956043956, "y1": 0.34265734265734266}, {"text": "well. In searching for your own voice, be aware of the difference between emulation and", "x0": 0.14395604395604394, "y0": 0.3457653457653458, "x1": 0.856043956043956, "y1": 0.358974358974359}, {"text": "imitation, inspiration and intimidation.", "x0": 0.14395604395604394, "y0": 0.3628593628593629, "x1": 0.45494505494505494, "y1": 0.37606837606837606}, {"text": "... A successful story is one in which the narrator can treat human foibles, even serious", "x0": 0.14395604395604394, "y0": 0.3962703962703963, "x1": 0.856043956043956, "y1": 0.4094794094794095}, {"text": "flaws, with depth and hence compassion. Imagination brings you close to compassion.", "x0": 0.14395604395604394, "y0": 0.4125874125874126, "x1": 0.8549450549450549, "y1": 0.4257964257964258}, {"text": "Practice imagining yourself living the life of someone whose situation differs entirely", "x0": 0.14285714285714285, "y0": 0.4296814296814297, "x1": 0.8549450549450549, "y1": 0.4428904428904429}, {"text": "from yours \u2014 living in another country, having another religion \u2014 and the more deeply", "x0": 0.14395604395604394, "y0": 0.445998445998446, "x1": 0.8549450549450549, "y1": 0.4592074592074592}, {"text": "you can do so, the more you become that character as you write. You cannot help being", "x0": 0.14285714285714285, "y0": 0.46386946386946387, "x1": 0.856043956043956, "y1": 0.4763014763014763}, {"text": "compassionate.", "x0": 0.14285714285714285, "y0": 0.48174048174048173, "x1": 0.26483516483516484, "y1": 0.4926184926184926}, {"text": "What makes a story worthwhile is the question or questions it poses. The questions", "x0": 0.14285714285714285, "y0": 0.5128205128205128, "x1": 0.856043956043956, "y1": 0.526029526029526}, {"text": "might be: What is love? What is loss? What is hope? Those three could take a lifetime to", "x0": 0.14285714285714285, "y0": 0.5299145299145299, "x1": 0.856043956043956, "y1": 0.5431235431235432}, {"text": "answer. My story is one answer. Your story is another.", "x0": 0.14285714285714285, "y0": 0.5462315462315462, "x1": 0.5868131868131868, "y1": 0.5594405594405595}, {"text": "Amy TAN", "x0": 0.778021978021978, "y0": 0.5804195804195804, "x1": 0.856043956043956, "y1": 0.5897435897435898}, {"text": "The Opposite of Fate", "x0": 0.6857142857142857, "y0": 0.5975135975135976, "x1": 0.856043956043956, "y1": 0.60994560994561}, {"text": "Reprinted by permission of HaperCollins Publishers Lid", "x0": 0.5274725274725275, "y0": 0.6278166278166278, "x1": 0.8549450549450549, "y1": 0.6371406371406372}, {"text": "\u2018\u00a9 Amy Tan", "x0": 0.7879120879120879, "y0": 0.6386946386946387, "x1": 0.8549450549450549, "y1": 0.6480186480186481}, {"text": "Question 1 continues on page 5", "x0": 0.3659340659340659, "y0": 0.7412587412587412, "x1": 0.6329670329670329, "y1": 0.7544677544677545}], [{"text": "Question | (continued)", "x0": 0.11978021978021978, "y0": 0.08158508158508158, "x1": 0.30439560439560437, "y1": 0.09401709401709402}, {"text": "Text 2", "x0": 0.14285714285714285, "y0": 0.128982128982129, "x1": 0.1967032967032967, "y1": 0.13908313908313907}, {"text": "Margaret Atwood asked novelists what it felt like when they first began writing a novel.", "x0": 0.14285714285714285, "y0": 0.1623931623931624, "x1": 0.8527472527472527, "y1": 0.17560217560217561}, {"text": "One said [writing] was like walking into a labyrinth, without knowing what monster", "x0": 0.14285714285714285, "y0": 0.1958041958041958, "x1": 0.856043956043956, "y1": 0.20901320901320902}, {"text": "might be inside; another said it was like groping through a tunnel; another said it wa", "x0": 0.14285714285714285, "y0": 0.2128982128982129, "x1": 0.8428571428571429, "y1": 0.2261072261072261}, {"text": "like being in a cave \u2014 she could see daylight through the opening, but she herself was in", "x0": 0.14285714285714285, "y0": 0.22921522921522922, "x1": 0.856043956043956, "y1": 0.24242424242424243}, {"text": "darkness. Another said it was like being under water, in a lake or ocean. Another said", "x0": 0.14285714285714285, "y0": 0.2463092463092463, "x1": 0.856043956043956, "y1": 0.2595182595182595}, {"text": "it was like being in a completely dark room, feeling her way: she had to rearrange the", "x0": 0.14395604395604394, "y0": 0.26262626262626265, "x1": 0.856043956043956, "y1": 0.27583527583527584}, {"text": "furniture in the dark, and then when it was all arranged the light would come on. Another", "x0": 0.14395604395604394, "y0": 0.2789432789432789, "x1": 0.856043956043956, "y1": 0.29215229215229216}, {"text": "said it was like wading through a deep river, at dawn or twilight; another said it was like", "x0": 0.14395604395604394, "y0": 0.29603729603729606, "x1": 0.856043956043956, "y1": 0.30924630924630925}, {"text": "being in an empty room which was nevertheless filled with unspoken words, with a sort", "x0": 0.14285714285714285, "y0": 0.3123543123543124, "x1": 0.856043956043956, "y1": 0.32556332556332557}, {"text": "of whispering; another said it was like grappling with an unseen being or entity; another", "x0": 0.14285714285714285, "y0": 0.32944832944832947, "x1": 0.856043956043956, "y1": 0.34265734265734266}, {"text": "said it was like sitting in an empty theatre before any play or film had started, waiting", "x0": 0.14395604395604394, "y0": 0.3457653457653458, "x1": 0.856043956043956, "y1": 0.358974358974359}, {"text": "for the characters to appear.", "x0": 0.14395604395604394, "y0": 0.3628593628593629, "x1": 0.367032967032967, "y1": 0.37606837606837606}, {"text": "MARGARET ATWOOD:", "x0": 0.6912087912087912, "y0": 0.39704739704739705, "x1": 0.856043956043956, "y1": 0.4063714063714064}, {"text": "Negotiating with the Dead: A Writer on Writing", "x0": 0.46593406593406594, "y0": 0.4125874125874126, "x1": 0.856043956043956, "y1": 0.4257964257964258}, {"text": "Negotiating With the Dead: A Writer On Writing by Margaret Atwood,", "x0": 0.44395604395604393, "y0": 0.4366744366744367, "x1": 0.8494505494505494, "y1": 0.445998445998446}, {"text": "\"Reproduced with permission of the Licensor through PLSclear.\u201d", "x0": 0.46923076923076923, "y0": 0.4483294483294483, "x1": 0.8505494505494505, "y1": 0.45765345765345766}, {"text": "Text 3", "x0": 0.14285714285714285, "y0": 0.48951048951048953, "x1": 0.1967032967032967, "y1": 0.4996114996114996}, {"text": "Words! We all have a world of things inside ourselves and each one of us has his own", "x0": 0.14285714285714285, "y0": 0.5229215229215229, "x1": 0.856043956043956, "y1": 0.5361305361305362}, {"text": "private world. How can we understand each other if the words I use have the sense and", "x0": 0.14285714285714285, "y0": 0.5392385392385393, "x1": 0.856043956043956, "y1": 0.5524475524475524}, {"text": "the value that I expect them to have, but whoever is listening to me inevitably thinks that", "x0": 0.14395604395604394, "y0": 0.5563325563325563, "x1": 0.856043956043956, "y1": 0.5695415695415695}, {"text": "those same words have a different sense and value, because of the private world he has", "x0": 0.14395604395604394, "y0": 0.5726495726495726, "x1": 0.856043956043956, "y1": 0.5858585858585859}, {"text": "inside himself too. We think we understand each other: but we never do.", "x0": 0.14395604395604394, "y0": 0.5897435897435898, "x1": 0.7318681318681318, "y1": 0.5998445998445998}, {"text": "PIRANDELLO", "x0": 0.7593406593406593, "y0": 0.6239316239316239, "x1": 0.856043956043956, "y1": 0.6332556332556333}, {"text": "Six Characters in Search of an Author", "x0": 0.545054945054945, "y0": 0.6394716394716394, "x1": 0.8571428571428571, "y1": 0.6526806526806527}, {"text": "Luigi Pirandello, translated by John Linstrum, 1921,", "x0": 0.5472527472527473, "y0": 0.6635586635586636, "x1": 0.8505494505494505, "y1": 0.6728826728826729}, {"text": "Six characters in search of an Author Methuen Drama,", "x0": 0.5285714285714286, "y0": 0.6744366744366744, "x1": 0.8505494505494505, "y1": 0.682983682983683}, {"text": "London Ltd, an imprint of Bloomsbury Publishing Plc.", "x0": 0.5373626373626373, "y0": 0.6860916860916861, "x1": 0.8472527472527472, "y1": 0.6954156954156954}, {"text": "End of Question 1", "x0": 0.421978021978022, "y0": 0.7412587412587412, "x1": 0.5758241758241758, "y1": 0.7536907536907537}], [{"text": "Section II \u2014 Electives", "x0": 0.11978021978021978, "y0": 0.08236208236208237, "x1": 0.34065934065934067, "y1": 0.09401709401709402}, {"text": "25 marks", "x0": 0.11868131868131868, "y0": 0.11732711732711733, "x1": 0.1989010989010989, "y1": 0.12742812742812742}, {"text": "Attempt Question 2", "x0": 0.11868131868131868, "y0": 0.13364413364413363, "x1": 0.2879120879120879, "y1": 0.14685314685314685}, {"text": "Allow about 1 hour for this section", "x0": 0.11868131868131868, "y0": 0.15073815073815075, "x1": 0.4186813186813187, "y1": 0.16083916083916083}, {"text": "Answer the question on pages 14-24 of the English Extension | Writing Booklet. Extra writing", "x0": 0.11978021978021978, "y0": 0.18337218337218336, "x1": 0.8791208791208791, "y1": 0.19658119658119658}, {"text": "booklets are available.", "x0": 0.11868131868131868, "y0": 0.20124320124320125, "x1": 0.2989010989010989, "y1": 0.21056721056721056}, {"text": "Your answer will be assessed on how well you:", "x0": 0.14395604395604394, "y0": 0.23076923076923078, "x1": 0.5274725274725275, "y1": 0.24397824397824397}, {"text": "demonstrate an understanding of the ideas and values of Literary Worlds and how", "x0": 0.16703296703296702, "y0": 0.2501942501942502, "x1": 0.8538461538461538, "y1": 0.2634032634032634}, {"text": "they are shaped and reflected in texts", "x0": 0.16703296703296702, "y0": 0.26728826728826727, "x1": 0.46703296703296704, "y1": 0.2804972804972805}, {"text": "\u00a9 craft a sustained composition appropriate to the question, demonstrating control of the", "x0": 0.14285714285714285, "y0": 0.2874902874902875, "x1": 0.856043956043956, "y1": 0.3006993006993007}, {"text": "use of language", "x0": 0.16703296703296702, "y0": 0.3038073038073038, "x1": 0.2934065934065934, "y1": 0.317016317016317}, {"text": "Question 2 (25 marks)", "x0": 0.11978021978021978, "y0": 0.34965034965034963, "x1": 0.30439560439560437, "y1": 0.3620823620823621}, {"text": "Voices in literary texts are constructs through which competing points of view are reflected,", "x0": 0.11978021978021978, "y0": 0.3822843822843823, "x1": 0.8791208791208791, "y1": 0.3954933954933955}, {"text": "reconciled or left unresolved.", "x0": 0.11978021978021978, "y0": 0.39937839937839936, "x1": 0.35494505494505496, "y1": 0.4094794094794095}, {"text": "Evaluate how this idea is realised in the texts you have studied in your elective.", "x0": 0.11978021978021978, "y0": 0.43278943278943277, "x1": 0.7637362637362637, "y1": 0.445998445998446}, {"text": "In your response, refer to TWO of your prescribed texts and at least ONE related text of your", "x0": 0.11978021978021978, "y0": 0.4662004662004662, "x1": 0.8802197802197802, "y1": 0.4794094794094794}, {"text": "\u2018own choosing.", "x0": 0.11868131868131868, "y0": 0.48329448329448327, "x1": 0.23516483516483516, "y1": 0.49572649572649574}, {"text": "The prescribed texts for Section II are listed on pages 7-11.", "x0": 0.11868131868131868, "y0": 0.515928515928516, "x1": 0.6032967032967033, "y1": 0.5291375291375291}, {"text": "Section II continues on page 7", "x0": 0.37032967032967035, "y0": 0.5827505827505828, "x1": 0.6285714285714286, "y1": 0.5959595959595959}], [{"text": "The prescribed texts for Section II are:", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.4307692307692308, "y1": 0.0947940947940948}, {"text": "+ Elective 1: Literary Homelands", "x0": 0.11978021978021978, "y0": 0.11499611499611499, "x1": 0.4142857142857143, "y1": 0.1282051282051282}, {"text": "The prescribed texts are:", "x0": 0.14285714285714285, "y0": 0.14840714840714841, "x1": 0.34065934065934067, "y1": 0.16161616161616163}, {"text": "Prose Fiction", "x0": 0.16703296703296702, "y0": 0.18181818181818182, "x1": 0.2802197802197802, "y1": 0.1919191919191919}, {"text": "\u2014 Aravind Adiga, The White Tiger", "x0": 0.3087912087912088, "y0": 0.18181818181818182, "x1": 0.5967032967032967, "y1": 0.19502719502719504}, {"text": "\u2014 EM Forster, A Passage to India", "x0": 0.3087912087912088, "y0": 0.20590520590520592, "x1": 0.5956043956043956, "y1": 0.21833721833721834}, {"text": "\u2014 Colm T\u00e9ibin, Brooklyn", "x0": 0.3087912087912088, "y0": 0.22843822843822845, "x1": 0.5208791208791209, "y1": 0.24164724164724163}, {"text": "Poetry", "x0": 0.16703296703296702, "y0": 0.26262626262626265, "x1": 0.2219