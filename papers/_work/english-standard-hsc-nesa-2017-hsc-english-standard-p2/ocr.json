08791208791, "y1": 0.47086247086247085}, {"text": "Australian War Memorial website moving.", "x0": 0.11758241758241758, "y0": 0.473970473970474, "x1": 0.46703296703296704, "y1": 0.48717948717948717}, {"text": "Discuss this statement making detailed reference to your prescribed text.", "x0": 0.11978021978021978, "y0": 0.5027195027195027, "x1": 0.7076923076923077, "y1": 0.515928515928516}], [{"text": "Section [fl \u2014 Module C: Texts and Society", "x0": 0.11978021978021978, "y0": 0.08236208236208237, "x1": 0.5527472527472528, "y1": 0.09712509712509712}, {"text": "20 marks", "x0": 0.11868131868131868, "y0": 0.11732711732711733, "x1": 0.1989010989010989, "y1": 0.12742812742812742}, {"text": "Attempt either Question 9 or Question 10", "x0": 0.11868131868131868, "y0": 0.13364413364413363, "x1": 0.47692307692307695, "y1": 0.14685314685314685}, {"text": "Allow about 40 minutes for this section", "x0": 0.11868131868131868, "y0": 0.15073815073815075, "x1": 0.45604395604395603, "y1": 0.16083916083916083}, {"text": "Answer the question in a SEPARATE writing booklet. Extra writing booklets are available.", "x0": 0.11978021978021978, "y0": 0.18337218337218336, "x1": 0.8615384615384616, "y1": 0.19658119658119658}, {"text": "Your answer will be assessed on how well you:", "x0": 0.14395604395604394, "y0": 0.21367521367521367, "x1": 0.5274725274725275, "y1": 0.22688422688422688}, {"text": "demonstrate understanding of the ways texts and meaning are shaped by context", "x0": 0.16703296703296702, "y0": 0.2338772338772339, "x1": 0.8186813186813187, "y1": 0.24708624708624707}, {"text": "\u00a9 organise, develop and express ideas using language appropriate to audience, purpose,", "x0": 0.14285714285714285, "y0": 0.2540792540792541, "x1": 0.8549450549450549, "y1": 0.26728826728826727}, {"text": "context and form", "x0": 0.16703296703296702, "y0": 0.2703962703962704, "x1": 0.30439560439560437, "y1": 0.2804972804972805}, {"text": "Question 9 \u2014 Elective 1: Exploring Interactions (20 marks)", "x0": 0.11978021978021978, "y0": 0.3162393162393162, "x1": 0.6274725274725275, "y1": 0.32944832944832947}, {"text": "The significance of personal interactions lies in individuals gaining new perceptions of", "x0": 0.11868131868131868, "y0": 0.34965034965034963, "x1": 0.8813186813186813, "y1": 0.3628593628593629}, {"text": "themselves and others.", "x0": 0.11978021978021978, "y0": 0.3667443667443667, "x1": 0.3010989010989011, "y1": 0.37606837606837606}, {"text": "To what extent do the texts you have studied in this elective support this view?", "x0": 0.11868131868131868, "y0": 0.39937839937839936, "x1": 0.7604395604395604, "y1": 0.4125874125874126}, {"text": "In your response, make close reference to your prescribed text and at least ONE other related", "x0": 0.11978021978021978, "y0": 0.43278943278943277, "x1": 0.8791208791208791, "y1": 0.445998445998446}, {"text": "text of your own choosing.", "x0": 0.11978021978021978, "y0": 0.4491064491064491, "x1": 0.3362637362637363, "y1": 0.46231546231546233}, {"text": "The prescribed texts are:", "x0": 0.11868131868131868, "y0": 0.5003885003885004, "x1": 0.31758241758241756, "y1": 0.5128205128205128}, {"text": "+ Prose M T Anderson, Feed", "x0": 0.11978021978021978, "y0": 0.5291375291375291, "x1": 0.45604395604395603, "y1": 0.54001554001554}, {"text": "+ Drama \u2014 Nick Enright, A Man with Five Children", "x0": 0.11978021978021978, "y0": 0.5594405594405595, "x1": 0.6131868131868132, "y1": 0.5726495726495726}, {"text": "\u2014 Arthur Miller, All My Sons", "x0": 0.26153846153846155, "y0": 0.5905205905205905, "x1": 0.5032967032967033, "y1": 0.6013986013986014}, {"text": "+ Poetry \u2014 Ken Watson (ed.), The Round Earth\u2019s Imagined Corners", "x0": 0.11978021978021978, "y0": 0.62004662004662, "x1": 0.7461538461538462, "y1": 0.6332556332556333}, {"text": "The prescribed poems are:", "x0": 0.2857142857142857, "y0": 0.6433566433566433, "x1": 0.4978021978021978, "y1": 0.6565656565656566}, {"text": "Sujata Bhatt, The Stare", "x0": 0.3098901098901099, "y0": 0.6674436674436675, "x1": 0.4967032967032967, "y1": 0.6798756798756799}, {"text": "Carol Ann Duffy, Head of English", "x0": 0.3098901098901099, "y0": 0.682983682983683, "x1": 0.589010989010989, "y1": 0.6961926961926962}, {"text": "Carol Ann Duffy, Yes, Officer", "x0": 0.3098901098901099, "y0": 0.7000777000777001, "x1": 0.554945054945055, "y1": 0.7132867132867133}, {"text": "U A Fanthorpe, Reports", "x0": 0.3098901098901099, "y0": 0.7171717171717171, "x1": 0.5032967032967033, "y1": 0.7296037296037297}, {"text": "U A Fanthorpe, Not My Best Side", "x0": 0.3098901098901099, "y0": 0.7334887334887334, "x1": 0.5813186813186814, "y1": 0.7466977466977467}, {"text": "Gwyneth Lewis, Peripheral Vision", "x0": 0.3098901098901099, "y0": 0.7498057498057498, "x1": 0.5912087912087912, "y1": 0.763014763014763}, {"text": "Gwyneth Lewis, Good Dog!", "x0": 0.3098901098901099, "y0": 0.7668997668997669, "x1": 0.5395604395604395, "y1": 0.7801087801087802}, {"text": "* Nonfiction -\u2014 Raimond Gaita, Romulus, My Father", "x0": 0.11978021978021978, "y0": 0.7964257964257965, "x1": 0.5868131868131868, "y1": 0.8096348096348096}, {"text": "+ Film Elissa Down, The Black Balloon", "x0": 0.11978021978021978, "y0": 0.8267288267288267, "x1": 0.5483516483516484, "y1": 0.8383838383838383}, {"text": "stp", "x0": 0.08461538461538462, "y0": 0.9471639471639471, "x1": 0.1054945054945055, "y1": 0.9526029526029526}], [{"text": "Question 10 \u2014 Elective 2: Exploring Transitions (20 marks)", "x0": 0.11978021978021978, "y0": 0.08158508158508158, "x1": 0.6318681318681318, "y1": 0.0947940947940948}, {"text": "The significance of the experience of transition lies in individuals gaining a deeper", "x0": 0.11868131868131868, "y0": 0.11499611499611499, "x1": 0.8802197802197802, "y1": 0.1282051282051282}, {"text": "understanding of themselves and others.", "x0": 0.11978021978021978, "y0": 0.1320901320901321, "x1": 0.44285714285714284, "y1": 0.1452991452991453}, {"text": "To what extent do the texts you have studied in this elective support this view?", "x0": 0.11868131868131868, "y0": 0.1655011655011655, "x1": 0.7604395604395604, "y1": 0.17871017871017872}, {"text": "In your response, make close reference to your prescribed text and at least ONE other related", "x0": 0.11978021978021978, "y0": 0.1989121989121989, "x1": 0.8791208791208791, "y1": 0.21212121212121213}, {"text": "text of your own choosing.", "x0": 0.11978021978021978, "y0": 0.21522921522921523, "x1": 0.3362637362637363, "y1": 0.22843822843822845}, {"text": "The prescribed texts are:", "x0": 0.11868131868131868, "y0": 0.26573426573426573, "x1": 0.31758241758241756, "y1": 0.27816627816627815}, {"text": "Prose Fiction \u2014", "x0": 0.14285714285714285, "y0": 0.29526029526029524, "x1": 0.2714285714285714, "y1": 0.30536130536130535}, {"text": "J.C Burke, The Story of Tom Brennan", "x0": 0.2857142857142857, "y0": 0.29603729603729606, "x1": 0.5923076923076923, "y1": 0.3084693084693085}, {"text": "Drama", "x0": 0.14285714285714285, "y0": 0.32556332556332557, "x1": 0.2021978021978022, "y1": 0.3356643356643357}, {"text": "Willy Russell, Educating Rita", "x0": 0.2857142857142857, "y0": 0.32556332556332557, "x1": 0.5274725274725275, "y1": 0.33877233877233875}, {"text": "Alana Valentine, Shafana and Aunt Sarrinah", "x0": 0.2857142857142857, "y0": 0.35586635586635584, "x1": 0.6494505494505495, "y1": 0.3690753690753691}, {"text": "Poetry", "x0": 0.14285714285714285, "y0": 0.3853923853923854, "x1": 0.1989010989010989, "y1": 0.3986013986013986}, {"text": "Steven Herrick, The Simple Gift", "x0": 0.2857142857142857, "y0": 0.3853923853923854, "x1": 0.545054945054945, "y1": 0.3986013986013986}, {"text": "Nonfiction", "x0": 0.14285714285714285, "y0": 0.4156954156954157, "x1": 0.23296703296703297, "y1": 0.4257964257964258}, {"text": "Alice Pung, Unpolished Gem", "x0": 0.2857142857142857, "y0": 0.4156954156954157, "x1": 0.521978021978022, "y1": 0.4289044289044289}, {"text": "Film", "x0": 0.142857142