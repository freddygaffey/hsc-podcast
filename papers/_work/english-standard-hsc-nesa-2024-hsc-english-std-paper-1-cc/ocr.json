, {"text": "The prescribed texts are listed on pages 10-11.", "x0": 0.11868131868131868, "y0": 0.5811965811965812, "x1": 0.5010989010989011, "y1": 0.5944055944055944}, {"text": "1042 -9-", "x0": 0.08241758241758242, "y0": 0.9432789432789432, "x1": 0.5197802197802198, "y1": 0.9549339549339549}], [{"text": "The prescribed texts for Section II are:", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.4307692307692308, "y1": 0.0947940947940948}, {"text": "Anthony Doerr, All the Light We Cannot See", "x0": 0.3098901098901099, "y0": 0.108003108003108, "x1": 0.6736263736263737, "y1": 0.13286713286713286}, {"text": "Prose Fiction", "x0": 0.14285714285714285, "y0": 0.11499611499611499, "x1": 0.256043956043956, "y1": 0.1250971250971251}, {"text": "Amanda Lohrey, Vertigo", "x0": 0.3098901098901099, "y0": 0.13908313908313907, "x1": 0.510989010989011, "y1": 0.15151515151515152}, {"text": "George Orwell, Nineteen Eighty-Four", "x0": 0.3098901098901099, "y0": 0.1623931623931624, "x1": 0.6175824175824176, "y1": 0.17482517482517482}, {"text": "Favel Parrett, Past the Shallows", "x0": 0.3098901098901099, "y0": 0.1857031857031857, "x1": 0.567032967032967, "y1": 0.19502719502719504}, {"text": "Poetry", "x0": 0.14285714285714285, "y0": 0.21833721833721834, "x1": 0.1989010989010989, "y1": 0.23154623154623155}, {"text": "Rosemary Dobson, Rosemary Dobson Collected", "x0": 0.3098901098901099, "y0": 0.21833721833721834, "x1": 0.7021978021978021, "y1": 0.23154623154623155}, {"text": "The prescribed poems are:", "x0": 0.3087912087912088, "y0": 0.24242424242424243, "x1": 0.521978021978022, "y1": 0.25485625485625485}, {"text": "* Young Girl at a Window", "x0": 0.310989010989011, "y0": 0.257964257964258, "x1": 0.5318681318681319, "y1": 0.2828282828282828}, {"text": "* Over the Hill", "x0": 0.310989010989011, "y0": 0.27505827505827507, "x1": 0.43956043956043955, "y1": 0.2999222999222999}, {"text": "* Summer's End", "x0": 0.310989010989011, "y0": 0.2913752913752914, "x1": 0.45604395604395603, "y1": 0.3162393162393162}, {"text": "* The Conversation", "x0": 0.310989010989011, "y0": 0.3162393162393162, "x1": 0.47692307692307695, "y1": 0.32556332556332557}, {"text": "* Cock Crow", "x0": 0.310989010989011, "y0": 0.33255633255633255, "x1": 0.42417582417582417, "y1": 0.3418803418803419}, {"text": "* Amy Caroline", "x0": 0.310989010989011, "y0": 0.34965034965034963, "x1": 0.44505494505494503, "y1": 0.3620823620823621}, {"text": "* Canberra Morning", "x0": 0.310989010989011, "y0": 0.3651903651903652, "x1": 0.4868131868131868, "y1": 0.37839937839937837}, {"text": "Kenneth Slessor, Selected Poems", "x0": 0.3098901098901099, "y0": 0.3986013986013986, "x1": 0.578021978021978, "y1": 0.4094794094794095}, {"text": "The prescribed poems are:", "x0": 0.3087912087912088, "y0": 0.4226884226884227, "x1": 0.521978021978022, "y1": 0.43512043512043513}, {"text": "* Wild Grapes", "x0": 0.310989010989011, "y0": 0.445998445998446, "x1": 0.4351648351648352, "y1": 0.4592074592074592}, {"text": "* Gulliver", "x0": 0.310989010989011, "y0": 0.4630924630924631, "x1": 0.4, "y1": 0.47241647241647244}, {"text": "* Out of Time", "x0": 0.310989010989011, "y0": 0.4794094794094794, "x1": 0.42967032967032964, "y1": 0.49184149184149184}, {"text": "* Vesper-Song of the Reverend Samuel Marsden", "x0": 0.310989010989011, "y0": 0.49572649572649574, "x1": 0.7098901098901099, "y1": 0.508935508935509}, {"text": "* William Street", "x0": 0.310989010989011, "y0": 0.5128205128205128, "x1": 0.44945054945054946, "y1": 0.5221445221445221}, {"text": "* Beach Burial", "x0": 0.310989010989011, "y0": 0.5299145299145299, "x1": 0.43956043956043955, "y1": 0.5392385392385393}, {"text": "Drama", "x0": 0.14285714285714285, "y0": 0.5625485625485626, "x1": 0.2021978021978022, "y1": 0.5726495726495726}, {"text": "Jane Harrison, Rainbow's End", "x0": 0.3087912087912088, "y0": 0.5625485625485626, "x1": 0.5560439560439561, "y1": 0.5726495726495726}, {"text": "from Vivienne Cleven et al., Contemporary Indigenous Plays", "x0": 0.3098901098901099, "y0": 0.5788655788655789, "x1": 0.8087912087912088, "y1": 0.5920745920745921}, {"text": "Arthur Miller, The Crucible", "x0": 0.3098901098901099, "y0": 0.6021756021756022, "x1": 0.5351648351648352, "y1": 0.6122766122766122}, {"text": "\u2014 William Shakespeare, The Merchant of Venice", "x0": 0.2857142857142857, "y0": 0.6262626262626263, "x1": 0.6868131868131868, "y1": 0.6394716394716394}, {"text": "Section II prescribed texts continue on page 11", "x0": 0.2978021978021978, "y0": 0.6930846930846931, "x1": 0.7, "y1": 0.7062937062937062}], [{"text": "Section II prescribed texts (continued)", "x0": 0.11978021978021978, "y0": 0.08158508158508158, "x1": 0.42857142857142855, "y1": 0.0947940947940948}, {"text": "+ \u2014 Tim Winton, The Boy Behind the Curtain", "x0": 0.11978021978021978, "y0": 0.11499611499611499, "x1": 0.6461538461538462, "y1": 0.1282051282051282}, {"text": "The prescribed chapters are:", "x0": 0.3087912087912088, "y0": 0.13908313908313907, "x1": 0.5362637362637362, "y1": 0.15151515151515152}, {"text": "* Havoc: A Life in Accidents", "x0": 0.310989010989011, "y0": 0.16161616161616163, "x1": 0.5516483516483517, "y1": 0.17482517482517482}, {"text": "* Betsy", "x0": 0.310989010989011, "y0": 0.1794871794871795, "x1": 0.3758241758241758, "y1": 0.1919191919191919}, {"text": "* Twice on Sundays", "x0": 0.310989010989011, "y0": 0.1958041958041958, "x1": 0.47912087912087914, "y1": 0.20590520590520592}, {"text": "* The Wait and the Flow", "x0": 0.310989010989011, "y0": 0.21134421134421136, "x1": 0.5186813186813187, "y1": 0.22144522144522144}, {"text": "* In the Shadow of the Hospital", "x0": 0.310989010989011, "y0": 0.22921522921522922, "x1": 0.5747252747252747, "y1": 0.24164724164724163}, {"text": "* The Demon Shark", "x0": 0.310989010989011, "y0": 0.24553224553224554, "x1": 0.47912087912087914, "y1": 0.25485625485625485}, {"text": "* Barefoot in the Temple of Art", "x0": 0.310989010989011, "y0": 0.2618492618492618, "x1": 0.5725274725274725, "y1": 0.27505827505827507}, {"text": "\u2014 Malala Yousafzai and Christina Lamb, J am Malala", "x0": 0.2857142857142857, "y0": 0.29526029526029524, "x1": 0.7296703296703296, "y1": 0.30691530691530694}, {"text": "+ Film \u2014 Stephen Daldry, Billy Elliot", "x0": 0.11978021978021978, "y0": 0.32867132867132864, "x1": 0.5340659340659341, "y1": 0.3418803418803419}, {"text": "* Media \u2014 Ivan O'Mahoney, Go Back to Where You Came From", "x0": 0.11978021978021978, "y0": 0.3620823620823621, "x1": 0.7472527472527473, "y1": 0.3752913752913753}, {"text": "The prescribed episodes are:", "x0": 0.3087912087912088, "y0": 0.3861693861693862, "x1": 0.5384615384615384, "y1": 0.3986013986013986}, {"text": "* Series 1: Episodes 1, 2 and 3", "x0": 0.310989010989011, "y0": 0.4094794094794095, "x1": 0.5703296703296703, "y1": 0.4219114219114219}, {"text": "and", "x0": 0.33406593406593404, "y0": 0.4296814296814297, "x1": 0.36153846153846153, "y1": 0.439005439005439}, {"text": "* The Response", "x0": 0.310989010989011, "y0": 0.44988344988344986, "x1": 0.44395604395604393, "y1": 0.46231546231546233}, {"text": "\u2014 Lucy Walker, Waste Land", "x0": 0.2857142857142857, "y0": 0.4825174825174825, "x1": 0.5230769230769231, "y1": 0.49572649572649574}, {"text": "End of paper", "x0": 0.44285714285714284, "y0": 0.5493395493395493, "x1": 0.5560439560439561, "y1": 0.5625485625485626}], [{"text": "BLANK PAGE", "x0": 0.43626373626373627, "y0": 0.3550893550893551, "x1": 0.5626373626373626, "y1": 0.3644133644133644}, {"text": "(\u00a9 2024 NSW Edueation Standards Authority", "x0": 0.3824175824175824, "y0": 0.9673659673659674, "x1": 0.6164835164835165, "y1": 0.9751359751359752}], [{"text": "GOVERNMENT", "x0": 0.12197802197802197, "y0": 0.1592851592851593, "x1": 0.22527472527472528, "y1": 0.16705516705516704}, {"text": "NSW Education Standards Authority", "x0": 0.11978021978021978, "y0": 0.19114219114219114, "x1": 0.4725274725274725, "y1": 0.20512820512820512}, {"text": "2024 | HIGHER SCHOOL CERTIFICATE EXAMINATION", "x0": 0.12747252747252746, "y0": 0.30691530691530694, "x1": 0.5868131868131868, "y1": 0.331002331002331}, {"text": "English Standard", "x0": 0.12307692307692308, "y0": 0.38694638694638694, "x1": 0.5263736263736264, "y1": 0.4226884226884227}, {"text": "Paper 1 \u2014 Texts and Human Experiences", "x0": 0.12197802197802197, "y0": 0.45376845376845376, "x1": 0.8252747252747252, "y1": 0.48484848484848486}, {"text": "Stimulus Booklet", "x0": 0.11978021978021978, "y0": 0.5182595182595182, "x1": 0.3901098901098901, "y1": 0.5384615384615384}, {"text": "Page", "x0": 0.8351648351648352, "y0": 0.5843045843045843, "x1": 0.8802197802197802, "y1": 0.5975135975135976}, {"text": "Section] Text 1 \u2014 2", "x0": 0.11868131868131868, "y0": 0.60994560994561, "x1": 0.8791208791208791, "y1": 0.6363636363636364}, {"text": "+ Text 2 \u2014 Prose fiction extract 3", "x0": 0.2681318681318681, "y0": 0.6534576534576535, "x1": 0.8791208791208791, "y1": 0.6635586635586636}, {"text": "+ Text 3 \u2014 Nonfiction extract 4", "x0": 0.2681318681318681, "y0": 0.6876456876456877, "x1": 0.8791208791208791, "y1": 0.6977466977466977}, {"text": "+ Text 4 \u2014 Nonfiction extract 5", "x0": 0.2681318681318681, "y0": 0.7226107226107226, "x1": 0.8791208791208791, "y1": 0.7327117327117327}, {"text": "+ Text 5 \u2014 Prose fiction extract 6", "x0": 0.2681318681318681, "y0": 0.7567987567987567, "x1": 0.8791208791208791, "y1": 0.7668997668997669}, {"text": "* Text 6 \u2014 Photograph 6", "x0": 0.2681318681318681, "y0": 0.7917637917637917, "x1": 0.8791208791208791, "y1": 0.804972804972805}, {"text": "1043", "x0": 0.08241758241758242, "y0": 0.9463869463869464, "x1": 0.11758241758241758, "y1": 0.9549339549339549}], [{"text": "Text 1 \u2014 Poem", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.25164835164835164, "y1": 0.09168609168609168}, {"text": "of glass and wood and water", "x0": 0.2857142857142857, "y0": 0.13286713286713286, "x1": 0.5714285714285714, "y1": 0.14840714840714841}, {"text": "I am trying to tell you about Venice,", "x0": 0.2868131868131868, "y0": 0.16783216783216784, "x1": 0.5824175824175825, "y1": 0.18104118104118105}, {"text": "how I felt", "x0": 0.2857142857142857, "y0": 0.18104118104118105, "x1": 0.3637362637362637, "y1": 0.20124320124320125}, {"text": "waking in a crisp white room", "x0": 0.2868131868131868, "y0": 0.20046620046620048, "x1": 0.5230769230769231, "y1": 0.21367521367521367}, {"text": "to rain falling softly", "x0": 0.2868131868131868, "y0": 0.21756021756021757, "x1": 0.4461538461538462, "y1": 0.23076923076923078}, {"text": "in the courtyard", "x0": 0.2868131868131868, "y0": 0.23465423465423466, "x1": 0.41318681318681316, "y1": 0.24708624708624707}, {"text": "outside my window.", "x0": 0.2857142857142857, "y0": 0.25097125097125095, "x1": 0.44945054945054946, "y1": 0.2641802641802642}, {"text": "I want to tell you about the light in that room,", "x0": 0.2868131868131868, "y0": 0.28438228438228436, "x1": 0.6582417582417582, "y1": 0.2975912975912976}, {"text": "about the houseplants and the glass", "x0": 0.2857142857142857, "y0": 0.3006993006993007, "x1": 0.5703296703296703, "y1": 0.3139083139083139}, {"text": "and the books", "x0": 0.2857142857142857, "y0": 0.3185703185703186, "x1": 0.3978021978021978, "y1": 0.3278943278943279}, {"text": "in languages I couldn\u2019t read", "x0": 0.2868131868131868, "y0": 0.3348873348873349, "x1": 0.510989010989011, "y1": 0.3473193473193473}, {"text": "and the bath that didn\u2019t work,", "x0": 0.2857142857142857, "y0": 0.35120435120435123, "x1": 0.5263736263736264, "y1": 0.3628593628593629}, {"text": "how happy I was.", "x0": 0.2857142857142857, "y0": 0.3682983682983683, "x1": 0.42857142857142855, "y1": 0.38073038073038074}, {"text": "I want to tell you about the colour of Venetian water", "x0": 0.2868131868131868, "y0": 0.40093240093240096, "x1": 0.7131868131868132, "y1": 0.41414141414141414}, {"text": "and the way the sky and sea", "x0": 0.2857142857142857, "y0": 0.41802641802641805, "x1": 0.5131868131868131, "y1": 0.43045843045843046}, {"text": "makes everything soft and old,", "x0": 0.2857142857142857, "y0": 0.43434343434343436, "x1": 0.5351648351648352, "y1": 0.44755244755244755}, {"text": "how the wood groans\u2014", "x0": 0.2857142857142857, "y0": 0.45143745143745145, "x1": 0.47692307692307695, "y1": 0.46386946386946387}, {"text": "the way nothing is spoken", "x0": 0.2868131868131868, "y0": 0.4677544677544678, "x1": 0.4967032967032967, "y1": 0.48096348096348096}, {"text": "and everything", "x0": 0.2857142857142857, "y0": 0.4840714840714841, "x1": 0.4054945054945055, "y1": 0.4972804972804973}, {"text": "ng.", "x0": 0.44945054945054946, "y0": 0.48717948717948717, "x1": 0.4736263736263736, "y1": 0.4972804972804973}, {"text": "In Venice I walked on wet stone", "x0": 0.2868131868131868, "y0": 0.5182595182595182, "x1": 0.5483516483516484, "y1": 0.5275835275835276}, {"text": "through a floating cloud.", "x0": 0.2868131868131868, "y0": 0.5306915306915307, "x1": 0.4857142857142857, "y1": 0.5501165501165501}, {"text": "You weren\u2019t there,", "x0": 0.2868131868131868, "y0": 0.5516705516705517, "x1": 0.43846153846153846, "y1": 0.560994560994561}, {"text": "so the mist kissed the back of my neck", "x0": 0.2868131868131868, "y0": 0.5672105672105672, "x1": 0.6, "y1": 0.5804195804195804}, {"text": "where you would have.", "x0": 0.2868131868131868, "y0": 0.585081585081585, "x1": 0.4747252747252747, "y1": 0.5975135975135976}, {"text": "Emma", "x0": 0.6010989010989011, "y0": 0.6184926184926185, "x1": 0.6494505494505495, "y1": 0.6278166278166278}, {"text": "\u00a9 With the kind permission of Emma Brazil (Author)", "x0": 0.4065934065934066, "y0": 0.6456876456876457, "x1": 0.7131868131868132, "y1": 0.655011655011655}], [{"text": "Text 2 \u2014 Prose fiction extract", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.3791208791208791, "y1": 0.09168609168609168}, {"text": "The flight back to Australia departed late at night, and Jess had left", "x0": 0.2043956043956044, "y0": 0.13131313131313133, "x1": 0.7945054945054945, "y1": 0.1445221445221445}, {"text": "[the house] with hours to spare; partly because she was catching the train", "x0": 0.20549450549450549, "y0": 0.14840714840714841, "x1": 0.7934065934065934, "y1": 0.16161616161616163}, {"text": "[to the airport] and you never know what might happen, but also because,", "x0": 0.20549450549450549, "y0": 0.16472416472416473, "x1": 0.7945054945054945, "y1": 0.17793317793317792}, {"text": "having packed and readied the house for her absence, she'd started to feel", "x0": 0.20549450549450549, "y0": 0.18104118104118105, "x1": 0.7934065934065934, "y1": 0.19425019425019424}, {"text": "like a guest who'd overstayed her welcome and was now being tolerated", "x0": 0.20549450549450549, "y0": 0.19813519813519814, "x1": 0.7934065934065934, "y1": 0.21134421134421136}, {"text": "by a well-mannered host. The train ride had been smooth, and she\u2019d", "x0": 0.2043956043956044, "y0": 0.21445221445221446, "x1": 0.7934065934065934, "y1": 0.22766122766122765}, {"text": "arrived well ahead of time, setting herself up in [a caf\u00e9] near security", "x0": 0.20549450549450549, "y0": 0.23154623154623155, "x1": 0.7934065934065934, "y1": 0.24475524475524477}, {"text": "so she could have a bite to eat before going through the rigmarole!!!,", "x0": 0.20549450549450549, "y0": 0.24553224553224554, "x1": 0.7945054945054945, "y1": 0.26107226107226106}, {"text": "She preferred it on this side, where travellers and their families were", "x0": 0.20549450549450549, "y0": 0.26495726495726496, "x1": 0.7945054945054945, "y1": 0.27816627816627815}, {"text": "still together. She liked to guess at their relationships and the purpose of", "x0": 0.20549450549450549, "y0": 0.2812742812742813, "x1": 0.7956043956043956, "y1": 0.29448329448329447}, {"text": "travel, the destinations, and the length of time they\u2019d be away.", "x0": 0.20549450549450549, "y0": 0.29836829836829837, "x1": 0.710989010989011, "y1": 0.31157731157731156}, {"text": "She had been observing a group of three at a table beside her own and", "x0": 0.20549450549450549, "y0": 0.3317793317793318, "x1": 0.7934065934065934, "y1": 0.34498834498834496}, {"text": "continued to watch them now as they made their way towards the security", "x0": 0.2043956043956044, "y0": 0.34887334887334887, "x1": 0.7934065934065934, "y1": 0.3613053613053613}, {"text": "area. The young woman carrying a backpack was clearly the one leaving,", "x0": 0.20549450549450549, "y0": 0.3651903651903652, "x1": 0.7945054945054945, "y1": 0.37839937839937837}, {"text": "walking faster than the older couple, with an eagerness and energy to her", "x0": 0.20549450549450549, "y0": 0.3815073815073815, "x1": 0.7945054945054945, "y1": 0.3947163947163947}, {"text": "A few metres out from the door she stopped and they all embraced;", "x0": 0.26263736263736265, "y0": 0.3986013986013986, "x1": 0.7934065934065934, "y1": 0.41181041181041184}, {"text": "some further words were exchanged, the backpack was referenced, and", "x0": 0.20549450549450549, "y0": 0.4149184149184149, "x1": 0.7934065934065934, "y1": 0.4281274281274281}, {"text": "a laugh was shared. Another round of hugs and the girl continued to the", "x0": 0.20549450549450549, "y0": 0.43123543123543123, "x1": 0.7945054945054945, "y1": 0.4444444444444444}, {"text": "door alone. She gave her parents (presumably) a quick wave, flashed", "x0": 0.2043956043956044, "y0": 0.4483294483294483, "x1": 0.7934065934065934, "y1": 0.46153846153846156}, {"text": "them a bright smile, and didn\u2019t look back again.", "x0": 0.20549450549450549, "y0": 0.46464646464646464, "x1": 0.5945054945054945, "y1": 0.47785547785547783}, {"text": "Jess had been that young girl once, twenty years before. She knew about", "x0": 0.2043956043956044, "y0": 0.49805749805749805, "x1": 0.7945054945054945, "y1": 0.5112665112665112}, {"text": "the excitement on the other side of the gate: the first taste of real freedom,", "x0": 0.20549450549450549, "y0": 0.5151515151515151, "x1": 0.7945054945054945, "y1": 0.5283605283605284}, {"text": "the thrilling sense of being, at last, in control of one\u2019s own destiny.", "x0": 0.20549450549450549, "y0": 0.5314685314685315, "x1": 0.7483516483516484, "y1": 0.5446775446775447}, {"text": "Kate Morton", "x0": 0.6758241758241759, "y0": 0.5656565656565656, "x1": 0.7934065934065934, "y1": 0.574980574980575}, {"text": "Homecoming", "x0": 0.6868131868131868, "y0": 0.5827505827505828, "x1": 0.7945054945054945, "y1": 0.5951825951825952}, {"text": "\u00a9 Kate Morton", "x0": 0.7076923076923077, "y0": 0.6068376068376068, "x1": 0.7945054945054945, "y1": 0.6138306138306139}, {"text": "{1 rigmarole complicated process", "x0": 0.20549450549450549, "y0": 0.6355866355866356, "x1": 0.4846153846153846, "y1": 0.6480186480186481}, {"text": "Pl gait walking style", "x0": 0.20549450549450549, "y0": 0.6526806526806527, "x1": 0.4351648351648352, "y1": 0.6651126651126651}], [{"text": "Text 3 \u2014 Nonfiction extract", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.36153846153846153, "y1": 0.09246309246309246}], [{"text": "Text 4 \u2014 Nonfiction extract", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.36153846153846153, "y1": 0.09168609168609168}, {"text": "The very first measurement, like the first word or first melody, is lost to", "x0": 0.1901098901098901, "y0": 0.13131313131313133, "x1": 0.8087912087912088, "y1": 0.1445221445221445}, {"text": "time: impossible to localise and difficult even to imagine. Yet it was a hugely", "x0": 0.1912087912087912, "y0": 0.14840714840714841, "x1": 0.8076923076923077, "y1": 0.16161616161616163}, {"text": "significant act: another addition to that nest of primeval!!! consciousness", "x0": 0.1912087912087912, "y0": 0.16161616161616163, "x1": 0.8076923076923077, "y1": 0.17793317793317792}, {"text": "that grew in the brains of our ancestors hundreds of thousands of years ago,", "x0": 0.1912087912087912, "y0": 0.18104118104118105, "x1": 0.8087912087912088, "y1": 0.19425019425019424}, {"text": "and that would eventually set us apart from the other animals of the plain.", "x0": 0.1912087912087912, "y0": 0.19813519813519814, "x1": 0.8087912087912088, "y1": 0.21134421134421136}, {"text": "For measurement, like speech and play, is the cornerstone of", "x0": 0.1912087912087912, "y0": 0.21445221445221446, "x1": 0.7032967032967034, "y1": 0.22766122766122765}, {"text": "It encourages us to pay attention to the boundaries of the world, to notice", "x0": 0.1912087912087912, "y0": 0.23154623154623155, "x1": 0.8087912087912088, "y1": 0.24475524475524477}, {"text": "where the line ends and the scales tip. It requires that we compare one", "x0": 0.1912087912087912, "y0": 0.24786324786324787, "x1": 0.8087912087912088, "y1": 0.26107226107226106}, {"text": "portion of reality to another and describe the differences, creating a scaffold", "x0": 0.1912087912087912, "y0": 0.26495726495726496, "x1": 0.8076923076923077, "y1": 0.27816627816627815}, {"text": "for knowledge ... If we could not measure, then we could not observe the", "x0": 0.1912087912087912, "y0": 0.2812742812742813, "x1": 0.8087912087912088, "y1": 0.29448329448329447}, {"text": "world around us; could not experiment and learn. Measurement allows us", "x0": 0.1912087912087912, "y0": 0.29914529914529914, "x1": 0.8076923076923077, "y1": 0.31157731157731156}, {"text": "to record the past and by doing so uncover patterns that help predict the", "x0": 0.1912087912087912, "y0": 0.3146853146853147, "x1": 0.8087912087912088, "y1": 0.3278943278943279}, {"text": "future. And finally, it is a tool of social cohesion and control, letting us", "x0": 0.1912087912087912, "y0": 0.3317793317793318, "x1": 0.8076923076923077, "y1": 0.34498834498834496}, {"text": "coordinate individual effort into something greater than the sum of its parts.", "x0": 0.1901098901098901, "y0": 0.3480963480963481, "x1": 0.8087912087912088, "y1": 0.3613053613053613}, {"text": "Measurement has not only made the world we live in, it has made us too.", "x0": 0.1912087912087912, "y0": 0.3644133644133644, "x1": 0.7857142857142857, "y1": 0.3776223776223776}, {"text": "I first began to realise the importance of measurement when writing about", "x0": 0.2153846153846154, "y0": 0.3986013986013986, "x1": 0.8087912087912088, "y1": 0.41181041181041184}, {"text": "the redefinition of the kilogram as a journalist in 2018. I had travelled to Paris", "x0": 0.1912087912087912, "y0": 0.4149184149184149, "x1": 0.8076923076923077, "y1": 0.4281274281274281}, {"text": "for the assignment, and there interviewed scientists who had been working", "x0": 0.1912087912087912, "y0": 0.43123543123543123, "x1": 0.8087912087912088, "y1": 0.4444444444444444}, {"text": "on the project for decades as part of the International Bureau of Weights and", "x0": 0.1901098901098901, "y0": 0.4483294483294483, "x1": 0.8076923076923077, "y1": 0.46153846153846156}, {"text": "Measures, the organisation that oversees the metric system. They explained", "x0": 0.1912087912087912, "y0": 0.46464646464646464, "x1": 0.8076923076923077, "y1": 0.47785547785547783}, {"text": "how, since the eighteenth century, the kilogram had been defined as the", "x0": 0.1912087912087912, "y0": 0.48174048174048173, "x1": 0.8087912087912088, "y1": 0.494949494949495}, {"text": "weight of a particular lump of metal: an actual physical artefact, kept under", "x0": 0.1912087912087912, "y0": 0.49805749805749805, "x1": 0.8087912087912088, "y1": 0.5112665112665112}, {"text": "lock and key in an underground vault in France. Every weight in the world", "x0": 0.1912087912087912, "y0": 0.5151515151515151, "x1": 0.8076923076923077, "y1": 0.5283605283605284}, {"text": "(even the non-metric ones) could be traced back to this single standard, to", "x0": 0.1912087912087912, "y0": 0.5314685314685315, "x1": 0.8087912087912088, "y1": 0.5446775446775447}, {"text": "the kilogram ...", "x0": 0.1912087912087912, "y0": 0.5485625485625486, "x1": 0.31758241758241756, "y1": 0.5617715617715617}, {"text": "The existence of this hidden world was a revelation. I felt like I had opened", "x0": 0.21428571428571427, "y0": 0.581973581973582, "x1": 0.8076923076923077, "y1": 0.5951825951825952}, {"text": "the door of my flat one morning only to step out on to the surface of an alien", "x0": 0.1912087912087912, "y0": 0.5982905982905983, "x1": 0.8076923076923077, "y1": 0.6114996114996115}, {"text": "planet, surrounded suddenly by strange trees and the cries of unfamiliar", "x0": 0.1912087912087912, "y0": 0.6153846153846154, "x1": 0.8087912087912088, "y1": 0.6285936285936286}, {"text": "animals. The idea that something as fundamental and commonplace as a unit", "x0": 0.1912087912087912, "y0": 0.6317016317016317, "x1": 0.8087912087912088, "y1": 0.6449106449106449}, {"text": "of measurement was even capable of change was thrilling, and the more I", "x0": 0.1901098901098901, "y0": 0.6480186480186481, "x1": 0.8076923076923077, "y1": 0.6612276612276612}, {"text": "learned, the more questions I had. Why is a kilogram a kilogram, anyway?", "x0": 0.1912087912087912, "y0": 0.6651126651126651, "x1": 0.8087912087912088, "y1": 0.6783216783216783}, {"text": "Why an inch an inch? Who first decided these values and who maintains", "x0": 0.1912087912087912, "y0": 0.6814296814296814, "x1": 0.8076923076923077, "y1": 0.6946386946386947}, {"text": "them now?", "x0": 0.1912087912087912, "y0": 0.6993006993006993, "x1": 0.27912087912087913, "y1": 0.7086247086247086}, {"text": "As I followed these breadcrumbs, I began to understand what an", "x0": 0.21428571428571427, "y0": 0.7319347319347319, "x1": 0.8076923076923077, "y1": 0.7451437451437452}, {"text": "intellectual feast measurement truly is, what a banquet of historical, scientific,", "x0": 0.1912087912087912, "y0": 0.7482517482517482, "x1": 0.8087912087912088, "y1": 0.7614607614607615}, {"text": "and sociological wonder.", "x0": 0.1912087912087912, "y0": 0.7653457653457654, "x1": 0.3923076923076923, "y1": 0.7785547785547785}, {"text": "JAMES VINCENT", "x0": 0.6835164835164835, "y0": 0.7995337995337995, "x1": 0.8087912087912088, "y1": 0.8088578088578089}, {"text": "Beyond Measure", "x0": 0.6725274725274726, "y0": 0.815073815073815, "x1": 0.8087912087912088, "y1": 0.8282828282828283}, {"text": "Beyond Measure: The Hidden History of Measurement by James Vincent, Faber and Faber Ltd", "x0": 0.24835164835164836, "y0": 0.8414918414918415, "x1": 0.8120879120879121, "y1": 0.8508158508158508}, {"text": "1 primeval ancient", "x0": 0.1912087912087912, "y0": 0.8694638694638694, "x1": 0.3824175824175824, "y1": 0.8811188811188811}, {"text": "1 cognition the mental processing of information", "x0": 0.1912087912087912, "y0": 0.8865578865578866, "x1": 0.5813186813186814, "y1": 0.8982128982128982}], [{"text": "Text 5 \u2014 Prose fiction extract", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.3791208791208791, "y1": 0.09168609168609168}, {"text": "A times these days I think of the way the sun would set on the farmland around", "x0": 0.16703296703296702, "y0": 0.11577311577311578, "x1": 0.8318681318681319, "y1": 0.1383061383061383}, {"text": "our small house in the autumn. A view of the horizon, the whole entire circle of it,", "x0": 0.16703296703296702, "y0": 0.14219114219114218, "x1": 0.832967032967033, "y1": 0.15384615384615385}, {"text": "if you turned, the sun setting behind you, the sky in front becoming pink and soft,", "x0": 0.16703296703296702, "y0": 0.1585081585081585, "x1": 0.832967032967033, "y1": 0.1717171717171717}, {"text": "then slightly blue again, as though it could not stop going on in its beauty, then the", "x0": 0.16703296703296702, "y0": 0.17560217560217561, "x1": 0.8318681318681319, "y1": 0.1888111888111888}, {"text": "land closest to the setting sun would get dark, almost black against the orange line", "x0": 0.16703296703296702, "y0": 0.1919191919191919, "x1": 0.8318681318681319, "y1": 0.20512820512820512}, {"text": "of horizon, but if you turn around, the land is still available to the eye with such", "x0": 0.16703296703296702, "y0": 0.20901320901320902, "x1": 0.8318681318681319, "y1": 0.2222222222222222}, {"text": "softness, the few trees, the quiet field of cover crops already turned, and the sky", "x0": 0.16703296703296702, "y0": 0.22533022533022534, "x1": 0.8318681318681319, "y1": 0.23853923853923853}, {"text": "lingering, lingering, then finally dark. As though the soul can be quiet for those", "x0": 0.16703296703296702, "y0": 0.24242424242424243, "x1": 0.8318681318681319, "y1": 0.2556332556332556}, {"text": "moments.", "x0": 0.16703296703296702, "y0": 0.26107226107226106, "x1": 0.24505494505494504, "y1": 0.26884226884226886}, {"text": "All life amazes me.", "x0": 0.1912087912087912, "y0": 0.27583527583527584, "x1": 0.34725274725274724, "y1": 0.28593628593628595}, {"text": "ELIZABETH STROUT", "x0": 0.6802197802197802, "y0": 0.30225330225330227, "x1": 0.8318681318681319, "y1": 0.31157731157731156}, {"text": "My Name is Lucy Barton", "x0": 0.6296703296703297, "y0": 0.31934731934731936, "x1": 0.8318681318681319, "y1": 0.3317793317793318}, {"text": "\u2018An excerpt from My name is Lucy Barton \u00a9 Elizabeth Strout (2016)", "x0": 0.43626373626373627, "y0": 0.34265734265734266, "x1": 0.832967032967033, "y1": 0.351981351981352}, {"text": "Used by permission of Random House - an imprint and division of Penguin Random House LLC", "x0": 0.26483516483516484, "y0": 0.35353535353535354, "x1": 0.832967032967033, "y1": 0.3628593628593629}, {"text": "All rights reserved", "x0": 0.7252747252747253, "y0": 0.3651903651903652, "x1": 0.8318681318681319, "y1": 0.3745143745143745}, {"text": "Text 6 \u2014 Photograph", "x0": 0.11978021978021978, "y0": 0.4125874125874126, "x1": 0.3054945054945055, "y1": 0.425019425019425}, {"text": "Courtesy of Florian Schroeder", "x0": 0.6505494505494506, "y0": 0.9246309246309247, "x1": 0.8285714285714286, "y1": 0.933954933954934}], [{"text": "BLANK PAGE", "x0": 0.43626373626373627, "y0": 0.3550893550893551, "x1": 0.5626373626373626, "y1": 0.3644133644133644}], [{"text": "BLANK PAGE", "x0": 0.43626373626373627, "y0": 0.3550893550893551, "x1": 0.5626373626373626, "y1": 0.3644133644133644}, {"text": "(\u00a9 2024 NSW Edueation Standards Authority", "x0": 0.3824175824175824, "y0": 0.9673659673659674, "x1": 0.6164835164835165, "y1": 0.9751359751359752}]]