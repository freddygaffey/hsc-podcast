[[{"text": "BOARD OF STUDIES", "x0": 0.2802197802197802, "y0": 0.09712509712509712, "x1": 0.43626373626373627, "y1": 0.10334110334110334}, {"text": "TEACHING &", "x0": 0.2802197802197802, "y0": 0.10722610722610723, "x1": 0.3769230769230769, "y1": 0.11266511266511267}, {"text": "BOSTES", "x0": 0.12087912087912088, "y0": 0.11421911421911422, "x1": 0.26373626373626374, "y1": 0.13364413364413363}, {"text": "EDUCATIONAL", "x0": 0.2802197802197802, "y0": 0.11732711732711733, "x1": 0.3923076923076923, "y1": 0.12276612276612277}, {"text": "STANDARDS NSW", "x0": 0.2802197802197802, "y0": 0.12742812742812742, "x1": 0.4153846153846154, "y1": 0.13286713286713286}, {"text": "20 l HIGHER SCHOOL CERTIFICATE", "x0": 0.11978021978021978, "y0": 0.1717171717171717, "x1": 0.43736263736263736, "y1": 0.19502719502719504}, {"text": "EXAMINATION", "x0": 0.22417582417582418, "y0": 0.1864801864801865, "x1": 0.3230769230769231, "y1": 0.19502719502719504}, {"text": "IMPORTANT:", "x0": 0.12637362637362637, "y0": 0.22921522921522922, "x1": 0.22747252747252747, "y1": 0.23776223776223776}, {"text": "This resource was developed to support a previous version of the syllabus.", "x0": 0.12417582417582418, "y0": 0.24553224553224554, "x1": 0.6780219780219781, "y1": 0.2564102564102564}, {"text": "It may contain content that differs from the current syllabus.", "x0": 0.12637362637362637, "y0": 0.26107226107226106, "x1": 0.5637362637362637, "y1": 0.27195027195027194}, {"text": "English (Standard)", "x0": 0.12417582417582418, "y0": 0.30924630924630925, "x1": 0.6241758241758242, "y1": 0.35586635586635584}, {"text": "and English (Advanced)", "x0": 0.12087912087912088, "y0": 0.36596736596736595, "x1": 0.7703296703296704, "y1": 0.4125874125874126}, {"text": "Paper 1 \u2014 Area of Study", "x0": 0.12197802197802197, "y0": 0.4428904428904429, "x1": 0.6153846153846154, "y1": 0.47474747474747475}, {"text": "Total marks - 45", "x0": 0.47692307692307695, "y0": 0.5734265734265734, "x1": 0.6230769230769231, "y1": 0.5835275835275835}, {"text": "Section Pages 2-7", "x0": 0.4857142857142857, "y0": 0.6006216006216006, "x1": 0.6912087912087912, "y1": 0.6184926184926185}, {"text": "15 marks", "x0": 0.47802197802197804, "y0": 0.6324786324786325, "x1": 0.5560439560439561, "y1": 0.6425796425796426}, {"text": "+ Attempt Question I", "x0": 0.47692307692307695, "y0": 0.6542346542346542, "x1": 0.643956043956044, "y1": 0.6666666666666666}, {"text": "General Instructions * Allow about 40 minutes for this section", "x0": 0.11978021978021978, "y0": 0.6752136752136753, "x1": 0.8087912087912088, "y1": 0.6891996891996892}, {"text": "* Reading time ~ 10 minutes (Section II) Pages 8-9", "x0": 0.11978021978021978, "y0": 0.6930846930846931, "x1": 0.6912087912087912, "y1": 0.7233877233877234}, {"text": "+ Working time ~ 2 hours 15 mark.", "x0": 0.11978021978021978, "y0": 0.7226107226107226, "x1": 0.5483516483516484, "y1": 0.7435897435897436}, {"text": "marks", "x0": 0.5021978021978022, "y0": 0.7365967365967366, "x1": 0.5560439560439561, "y1": 0.7435897435897436}, {"text": "* Write using black pen", "x0": 0.11978021978021978, "y0": 0.7435897435897436, "x1": 0.3087912087912088, "y1": 0.756021756021756}, {"text": "* Attempt Question 2", "x0": 0.47692307692307695, "y0": 0.756021756021756, "x1": 0.6472527472527473, "y1": 0.7684537684537684}, {"text": "+ Allow about 40 minutes for this section", "x0": 0.47692307692307695, "y0": 0.777000777000777, "x1": 0.8087912087912088, "y1": 0.7863247863247863}, {"text": "Section Pages 10-11", "x0": 0.4857142857142857, "y0": 0.8065268065268065, "x1": 0.7087912087912088, "y1": 0.818958818958819}, {"text": "15 marks", "x0": 0.47802197802197804, "y0": 0.8352758352758353, "x1": 0.5560439560439561, "y1": 0.8453768453768454}, {"text": "+ Attempt Question 3", "x0": 0.47692307692307695, "y0": 0.857031857031857, "x1": 0.6461538461538462, "y1": 0.8694638694638694}, {"text": "+ Allow about 40 minutes for this section", "x0": 0.47692307692307695, "y0": 0.878010878010878, "x1": 0.8087912087912088, "y1": 0.8873348873348873}, {"text": "1050", "x0": 0.08351648351648351, "y0": 0.9456099456099456, "x1": 0.11428571428571428, "y1": 0.9533799533799534}], [{"text": "Section I", "x0": 0.11978021978021978, "y0": 0.08236208236208237, "x1": 0.20659340659340658, "y1": 0.09401709401709402}, {"text": "15 marks", "x0": 0.12087912087912088, "y0": 0.11810411810411811, "x1": 0.1989010989010989, "y1": 0.12742812742812742}, {"text": "Attempt Question 1", "x0": 0.11978021978021978, "y0": 0.13364413364413363, "x1": 0.2879120879120879, "y1": 0.14685314685314685}, {"text": "Allow about 40 minutes for this section", "x0": 0.11978021978021978, "y0": 0.14996114996114995, "x1": 0.45604395604395603, "y1": 0.16006216006216006}, {"text": "Answer the question on pages 2-7 of the Paper 1 Writing Booklet. Extra writing booklets are", "x0": 0.11978021978021978, "y0": 0.18337218337218336, "x1": 0.8802197802197802, "y1": 0.19658119658119658}, {"text": "available.", "x0": 0.11978021978021978, "y0": 0.20124320124320125, "x1": 0.1956043956043956, "y1": 0.21056721056721056}, {"text": "Your answers will be assessed on how well you:", "x0": 0.14395604395604394, "y0": 0.23076923076923078, "x1": 0.5362637362637362, "y1": 0.24397824397824397}, {"text": "m= demonstrate understanding of the way perceptions of discovery are shaped in and", "x0": 0.14285714285714285, "y0": 0.2501942501942502, "x1": 0.856043956043956, "y1": 0.2634032634032634}, {"text": "through texts", "x0": 0.16703296703296702, "y0": 0.2680652680652681, "x1": 0.2725274725274725, "y1": 0.2804972804972805}, {"text": "describe, explain and analyse the relationship between language, text and context", "x0": 0.16703296703296702, "y0": 0.2874902874902875, "x1": 0.8252747252747252, "y1": 0.3006993006993007}, {"text": "Question 1 (15 marks)", "x0": 0.11978021978021978, "y0": 0.33255633255633255, "x1": 0.30439560439560437, "y1": 0.34498834498834496}, {"text": "Examine Texts 1, 2, 3 and 4 carefully and then answer the questions on page 7.", "x0": 0.11978021978021978, "y0": 0.358974358974359, "x1": 0.7648351648351648, "y1": 0.3838383838383838}, {"text": "Text 1 \u2014 Short story extract", "x0": 0.11978021978021978, "y0": 0.4156954156954157, "x1": 0.36813186813186816, "y1": 0.4289044289044289}, {"text": "FRIDAY MORNING. GREENWICH VILLAGE.", "x0": 0.11978021978021978, "y0": 0.4662004662004662, "x1": 0.5241758241758242, "y1": 0.4755244755244755}, {"text": "The industrial dumbwaiter*, jam-packed with a two-day accumulation of tenants\u2019 rubbish,", "x0": 0.11868131868131868, "y0": 0.49417249417249415, "x1": 0.8791208791208791, "y1": 0.5073815073815073}, {"text": "made three trips from the basement of the elegant apartment block to the street.", "x0": 0.11978021978021978, "y0": 0.5104895104895105, "x1": 0.7626373626373626, "y1": 0.5236985236985237}, {"text": "A team of janitors removed a pile of dark plastic rubbish bags to a corner wall of a raised", "x0": 0.11538461538461539, "y0": 0.5314685314685315, "x1": 0.8802197802197802, "y1": 0.5547785547785548}, {"text": "garden bed that ran along the north face of the building and shaped a mound from them there.", "x0": 0.11978021978021978, "y0": 0.5555555555555556, "x1": 0.8791208791208791, "y1": 0.5687645687645687}, {"text": "The plastic glinted in the pale winter sun.", "x0": 0.11868131868131868, "y0": 0.5718725718725719, "x1": 0.45494505494505494, "y1": 0.585081585081585}, {"text": "On the fourth trip, a different type of rubbish: a battered wooden wardrobe tied around the", "x0": 0.11978021978021978, "y0": 0.6006216006216006, "x1": 0.8802197802197802, "y1": 0.6138306138306139}, {"text": "middle with thick yellow string, a stroller, a child\u2019s car seat, a wooden chest of drawers covered", "x0": 0.11978021978021978, "y0": 0.616938616938617, "x1": 0.8802197802197802, "y1": 0.6301476301476302}, {"text": "with plaited white plastic and topped with a bright-blue lid, one double and two single bed", "x0": 0.11978021978021978, "y0": 0.634032634032634, "x1": 0.8802197802197802, "y1": 0.6472416472416472}, {"text": "bases, a single mattress, three crocheted cushions in perfect condition ...", "x0": 0.11978021978021978, "y0": 0.6503496503496503, "x1": 0.7076923076923077, "y1": 0.6635586635586636}, {"text": "Minutes after the rubbish was placed on the street, a young couple who had been walking by", "x0": 0.11978021978021978, "y0": 0.6783216783216783, "x1": 0.8791208791208791, "y1": 0.6915306915306916}, {"text": "lunged at it. What treasures might they find here? How much of it might be worth selling?", "x0": 0.11978021978021978, "y0": 0.6954156954156954, "x1": 0.8538461538461538, "y1": 0.7086247086247086}, {"text": "\u201cOh, man, look at this!\u201d", "x0": 0.12087912087912088, "y0": 0.7241647241647242, "x1": 0.3076923076923077, "y1": 0.7350427350427351}, {"text": "\u201cDon\u2019t take those trunks,\u2019 the woman called to him. \u2018Leave them.\u2019", "x0": 0.12087912087912088, "y0": 0.752913752913753, "x1": 0.656043956043956, "y1": 0.7637917637917638}, {"text": "He tried to argue with her, but she was resolute, so he filled his arms with books. When he", "x0": 0.11978021978021978, "y0": 0.7808857808857809, "x1": 0.8802197802197802, "y1": 0.7940947940947941}, {"text": "could hold no more, he placed them in piles on the footpath. He looked around. How to carry", "x0": 0.11978021978021978, "y0": 0.7972027972027972, "x1": 0.8791208791208791, "y1": 0.8104118104118104}, {"text": "all this? ...", "x0": 0.11978021978021978, "y0": 0.8135198135198135, "x1": 0.20659340659340658, "y1": 0.8236208236208237}, {"text": "Frenzied, he dumped the books into drawers, then moved to examine the next trunk.", "x0": 0.11978021978021978, "y0": 0.8422688422688422, "x1": 0.8021978021978022, "y1": 0.8554778554778555}, {"text": "Text 1 continues on page 3", "x0": 0.38461538461538464, "y0": 0.9013209013209014, "x1": 0.6142857142857143, "y1": 0.9145299145299145}], [{"text": "Text 1 (continued)", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.2692307692307692, "y1": 0.09401709401709402}, {"text": "In the meantime, his girlfriend kicked and prodded, then rummaged through the fabric-tied", "x0": 0.11978021978021978, "y0": 0.1258741258741259, "x1": 0.8802197802197802, "y1": 0.13908313908313907}, {"text": "bags.", "x0": 0.11978021978021978, "y0": 0.14296814296814297, "x1": 0.15934065934065933, "y1": 0.1554001554001554}, {"text": "\u201cBooks here!\u2019 she cried out.", "x0": 0.12087912087912088, "y0": 0.17094017094017094, "x1": 0.34395604395604396, "y1": 0.18104118104118105}, {"text": "\u201cWhoa! Look at this,\u2019 she whooped as she displayed a voluminous pair of white rayon bloomers", "x0": 0.12087912087912088, "y0": 0.1989121989121989, "x1": 0.8791208791208791, "y1": 0.21212121212121213}, {"text": "against her chest. He was too preoccupied to look up but that didn\u2019t dampen her delight.", "x0": 0.11978021978021978, "y0": 0.21522921522921523, "x1": 0.8351648351648352, "y1": 0.22843822843822845}, {"text": "Next, she found a multicoloured raffia beach bag with long red leather straps.", "x0": 0.11978021978021978, "y0": 0.24397824397824397, "x1": 0.7483516483516484, "y1": 0.2571872571872572}, {"text": "\u2018This!\u2019 She waved the bag in circles, las:", "x0": 0.12087912087912088, "y0": 0.2727272727272727, "x1": 0.44505494505494503, "y1": 0.28593628593628595}, {"text": "high in the air.", "x0": 0.5197802197802198, "y0": 0.2727272727272727, "x1": 0.6373626373626373, "y1": 0.28593628593628595}, {"text": "Into the beach bag she stuffed a many-coloured skirt, a pair of shoes, two rayon singlets", "x0": 0.11978021978021978, "y0": 0.3006993006993007, "x1": 0.8802197802197802, "y1": 0.3139083139083139}, {"text": "(dresses for her), two scarves, more bloomers. Discarded clothes lay scattered wherever she", "x0": 0.11978021978021978, "y0": 0.317016317016317, "x1": 0.8802197802197802, "y1": 0.33022533022533024}, {"text": "threw them, their colours gaudy against the dark rubbish bags ...", "x0": 0.11978021978021978, "y0": 0.3341103341103341, "x1": 0.6450549450549451, "y1": 0.3473193473193473}, {"text": "Now the couple approached the wardrobe. Unable to break the yellow string, they carried the", "x0": 0.11978021978021978, "y0": 0.3620823620823621, "x1": 0.8802197802197802, "y1": 0.3752913752913753}, {"text": "wardrobe \u2014 from the ease with which they hoisted it, it seemed empty \u2014 to the footpath, stood it", "x0": 0.11978021978021978, "y0": 0.3791763791763792, "x1": 0.8802197802197802, "y1": 0.3923853923853924}, {"text": "upright and rolled down the string. As the door swung open, a hibachi** tumbled out. It looked", "x0": 0.11978021978021978, "y0": 0.3954933954933955, "x1": 0.8802197802197802, "y1": 0.4087024087024087}, {"text": "new. He went to claim it.", "x0": 0.11978021978021978, "y0": 0.4125874125874126, "x1": 0.3230769230769231, "y1": 0.4226884226884227}, {"text": "\u2018No,\u2019 she shouted. \u2018No! I don\u2019t want that. I don\u2019t want any junk in the apartment.\u201d", "x0": 0.12087912087912088, "y0": 0.4405594405594406, "x1": 0.7846153846153846, "y1": 0.45376845376845376}, {"text": "He hesitated, but only for an instant; defiant, he claimed it.", "x0": 0.11978021978021978, "y0": 0.4693084693084693, "x1": 0.5967032967032967, "y1": 0.4825174825174825}, {"text": "There was a bonus for the couple: the chest of drawers was furnished with a set of wheels.", "x0": 0.11868131868131868, "y0": 0.4972804972804973, "x1": 0.8791208791208791, "y1": 0.5104895104895105}, {"text": "That would take some weight off. She closed the book-filled drawers; he secured them with the", "x0": 0.11868131868131868, "y0": 0.5143745143745144, "x1": 0.8802197802197802, "y1": 0.5275835275835276}, {"text": "yellow string. They stacked bags filled with clothes and books on top of the chest. Each slung", "x0": 0.11978021978021978, "y0": 0.5306915306915307, "x1": 0.8802197802197802, "y1": 0.5439005439005439}, {"text": "a bag over one shoulder, hoisted another under their arms, clutched others in their fingers.", "x0": 0.11978021978021978, "y0": 0.5470085470085471, "x1": 0.8791208791208791, "y1": 0.5602175602175602}, {"text": "Packed to the gills, they departed briskly, the sound of metal wheels on concrete \u2018king in", "x0": 0.11978021978021978, "y0": 0.5641025641025641, "x1": 0.8802197802197802, "y1": 0.5773115773115773}, {"text": "their wake.", "x0": 0.11978021978021978, "y0": 0.5811965811965812, "x1": 0.2076923076923077, "y1": 0.5905205905205905}, {"text": "Two English tourists, who had been watching, disgusted, turned to each other.", "x0": 0.11868131868131868, "y0": 0.6091686091686092, "x1": 0.7538461538461538, "y1": 0.6223776223776224}, {"text": "\u201cWhat do you think they do with it?\u201d", "x0": 0.12087912087912088, "y0": 0.6371406371406372, "x1": 0.4153846153846154, "y1": 0.6503496503496503}, {"text": "imagine.\u2019", "x0": 0.18461538461538463, "y0": 0.6658896658896659, "x1": 0.25824175824175827, "y1": 0.679098679098679}, {"text": "He shuddered, offered his companion his arm and they walked off in the direction of 5th", "x0": 0.11978021978021978, "y0": 0.6938616938616938, "x1": 0.8802197802197802, "y1": 0.7070707070707071}, {"text": "Avenue, heads shaking in wonder at the likes of what goes on in New York.", "x0": 0.11978021978021978, "y0": 0.710955710955711, "x1": 0.7384615384615385, "y1": 0.7241647241647242}, {"text": "On the street, the pile of dark plastic bags glinted in the pale winter sun.", "x0": 0.11978021978021978, "y0": 0.7389277389277389, "x1": 0.7043956043956044, "y1": 0.7521367521367521}, {"text": "SANDRA GOLDBLOOM ZURBO", "x0": 0.6505494505494506, "y0": 0.7661227661227661, "x1": 0.8802197802197802, "y1": 0.7754467754467754}, {"text": "Adapted from \u201cScene from a Window\u2019", "x0": 0.567032967032967, "y0": 0.7816627816627817, "x1": 0.878021978021978, "y1": 0.7948717948717948}, {"text": "Sandra Goldbloom Zurbo is a Melbourne author, editor and proofreader. Her novel, The Book of Rachel, was published by Allen &", "x0": 0.11318681318681319, "y0": 0.8127428127428128, "x1": 0.8835164835164835, "y1": 0.822066822066822}, {"text": "Unwin. Her short stories and poems, several of which can be found online, have been published in literary journals and anthologies", "x0": 0.11318681318681319, "y0": 0.8243978243978244, "x1": 0.889010989010989, "y1": 0.8337218337218337}, {"text": "* dumbwaiter lift, elevator", "x0": 0.13076923076923078, "y0": 0.8593628593628594, "x1": 0.33516483516483514, "y1": 0.8686868686868687}, {"text": "** hibachi small Japanese cooking stove", "x0": 0.12197802197802197, "y0": 0.8733488733488733, "x1": 0.45164835164835165, "y1": 0.8834498834498834}, {"text": "End of Text 1", "x0": 0.44065934065934065, "y0": 0.9036519036519036, "x1": 0.5571428571428572, "y1": 0.9137529137529138}], [{"text": "Text 2 \u2014 Image", "x0": 0.11978021978021978, "y0": 0.08158508158508158, "x1": 0.25824175824175827, "y1": 0.0947940947940948}, {"text": "Painting of Albertus Seba", "x0": 0.6725274725274726, "y0": 0.8205128205128205, "x1": 0.8802197802197802, "y1": 0.8337218337218337}, {"text": "by Jacob Houbraken, 1730", "x0": 0.6637362637362637, "y0": 0.8376068376068376, "x1": 0.8802197802197802, "y1": 0.85003885003885}], [{"text": "Text 3 \u2014 Poem", "x0": 0.11978021978021978, "y0": 0.08158508158508158, "x1": 0.25274725274725274, "y1": 0.09168609168609168}, {"text": "Butterfly", "x0": 0.3098901098901099, "y0": 0.1258741258741259, "x1": 0.3868131868131868, "y1": 0.13908313908313907}, {"text": "My father, ninety years ago,", "x0": 0.3098901098901099, "y0": 0.16006216006216006, "x1": 0.5373626373626373, "y1": 0.17327117327117328}, {"text": "at the age of \u2014 my guess \u2014 ten,", "x0": 0.3098901098901099, "y0": 0.17482517482517482, "x1": 0.5571428571428572, "y1": 0.19425019425019424}, {"text": "walked three miles through the forest", "x0": 0.3098901098901099, "y0": 0.1958041958041958, "x1": 0.6120879120879121, "y1": 0.20901320901320902}, {"text": "on his way to school", "x0": 0.3098901098901099, "y0": 0.21367521367521367, "x1": 0.4758241758241758, "y1": 0.22688422688422688}, {"text": "along the sedgy wetfoot shore", "x0": 0.3098901098901099, "y0": 0.2494172494172494, "x1": 0.5527472527472528, "y1": 0.26262626262626265}, {"text": "of the brimming eel-filled rush-fringed", "x0": 0.3098901098901099, "y0": 0.2665112665112665, "x1": 0.6241758241758242, "y1": 0.27972027972027974}, {"text": "peat-brown river,", "x0": 0.3098901098901099, "y0": 0.28438228438228436, "x1": 0.44835164835164837, "y1": 0.2975912975912976}, {"text": "leaving a trail of jittering blackflies,", "x0": 0.3098901098901099, "y0": 0.30225330225330227, "x1": 0.6010989010989011, "y1": 0.31546231546231546}, {"text": "his hands already broad and deft", "x0": 0.3098901098901099, "y0": 0.3201243201243201, "x1": 0.5725274725274725, "y1": 0.3333333333333333}, {"text": "at the ends of his fraying sleeves.", "x0": 0.3098901098901099, "y0": 0.337995337995338, "x1": 0.5791208791208792, "y1": 0.35120435120435123}, {"text": "Along this path he noticed", "x0": 0.3098901098901099, "y0": 0.37373737373737376, "x1": 0.5230769230769231, "y1": 0.38694638694638694}, {"text": "everything: mushroom and scat, wildbloom,", "x0": 0.3098901098901099, "y0": 0.3923853923853924, "x1": 0.6659340659340659, "y1": 0.4048174048174048}, {"text": "snail and iris, clubmoss, fern and cone.", "x0": 0.3098901098901099, "y0": 0.4094794094794095, "x1": 0.6252747252747253, "y1": 0.4211344211344211}, {"text": "It must have been an endless", "x0": 0.3098901098901099, "y0": 0.445998445998446, "x1": 0.5417582417582417, "y1": 0.4553224553224553}, {"text": "breathing in: between", "x0": 0.3098901098901099, "y0": 0.4630924630924631, "x1": 0.4846153846153846, "y1": 0.4763014763014763}, {"text": "the wish to know and the need to praise", "x0": 0.3098901098901099, "y0": 0.4801864801864802, "x1": 0.6318681318681318, "y1": 0.4933954933954934}, {"text": "there was no seam.", "x0": 0.3098901098901099, "y0": 0.4988344988344988, "x1": 0.46263736263736266, "y1": 0.5081585081585082}, {"text": "One day he saw a drenched log floating", "x0": 0.3098901098901099, "y0": 0.5337995337995338, "x1": 0.6318681318681318, "y1": 0.5470085470085471}, {"text": "heavily downstream,", "x0": 0.3098901098901099, "y0": 0.5516705516705517, "x1": 0.47692307692307695, "y1": 0.5648795648795649}, {"text": "and on it a butterfly, blue as eyes.", "x0": 0.3098901098901099, "y0": 0.5695415695415695, "x1": 0.5824175824175825, "y1": 0.5827505827505828}, {"text": "This was the moment (I later heard)", "x0": 0.3098901098901099, "y0": 0.5881895881895882, "x1": 0.6, "y1": 0.5998445998445998}, {"text": "that shot him off on his tangent", "x0": 0.3098901098901099, "y0": 0.6052836052836053, "x1": 0.5637362637362637, "y1": 0.6184926184926185}, {"text": "into the abstruse* world", "x0": 0.3098901098901099, "y0": 0.6418026418026418, "x1": 0.5043956043956044, "y1": 0.6511266511266511}, {"text": "of microscopes and numbers,", "x0": 0.3098901098901099, "y0": 0.6588966588966589, "x1": 0.5461538461538461, "y1": 0.6721056721056721}, {"text": "lapel pins, cars, and wanderings,", "x0": 0.3098901098901099, "y0": 0.6767676767676768, "x1": 0.5725274725274725, "y1": 0.6899766899766899}, {"text": "away from the ten square miles", "x0": 0.3098901098901099, "y0": 0.7117327117327117, "x1": 0.5637362637362637, "y1": 0.7249417249417249}, {"text": "of logged-out bushlots", "x0": 0.3098901098901099, "y0": 0.7296037296037297, "x1": 0.4912087912087912, "y1": 0.7428127428127428}, {"text": "he never named as poverty,", "x0": 0.3098901098901099, "y0": 0.7474747474747475, "x1": 0.5307692307692308, "y1": 0.7606837606837606}, {"text": "and the brown meandering river", "x0": 0.3098901098901099, "y0": 0.7653457653457654, "x1": 0.5703296703296703, "y1": 0.7785547785547785}, {"text": "he was always in some way after that", "x0": 0.3098901098901099, "y0": 0.7832167832167832, "x1": 0.6131868131868132, "y1": 0.7964257964257965}, {"text": "trying in vain to get back to.", "x0": 0.3098901098901099, "y0": 0.8010878010878011, "x1": 0.5384615384615384, "y1": 0.8142968142968143}, {"text": "MARGARET ATWOOD", "x0": 0.5252747252747253, "y0": 0.8306138306138307, "x1": 0.689010989010989, "y1": 0.83993783993784}, {"text": "From THE DOOR, by Margaret Atwood, Virago Press, 2007. Copyright \u00a9 Margaret Atwood 2007.", "x0": 0.3054945054945055, "y0": 0.8492618492618492, "x1": 0.878021978021978, "y1": 0.8585858585858586}, {"text": "Used with permission of the author.", "x0": 0.3054945054945055, "y0": 0.8609168609168609, "x1": 0.510989010989011, "y1": 0.8702408702408703}, {"text": "* abstruse: hard to understand, obscure", "x0": 0.310989010989011, "y0": 0.8982128982128982, "x1": 0.634065934065934, "y1": 0.9067599067599068}], [{"text": "Text 4 \u2014 Nonfiction extract", "x0": 0.11978021978021978, "y0": 0.08158508158508158, "x1": 0.36153846153846153, "y1": 0.09168609168609168}, {"text": "First came her stories like webs across the world. They crisscrossed the Atlantic on steamers and.", "x0": 0.11978021978021978, "y0": 0.1258741258741259, "x1": 0.8802197802197802, "y1": 0.13908313908313907}, {"text": "the Rockies by train. They made their way down dirt tracks where the scrub met overhead. They", "x0": 0.11978021978021978, "y0": 0.14219114219114218, "x1": 0.8791208791208791, "y1": 0.1554001554001554}, {"text": "flew from Ben Lomond in the Tasmanian Highlands, which we could see from her verandah, to", "x0": 0.11978021978021978, "y0": 0.1585081585081585, "x1": 0.8802197802197802, "y1": 0.1717171717171717}, {"text": "Welsh farmhouses of dark stone. The air would shiver slightly each time she began.", "x0": 0.11978021978021978, "y0": 0.17560217560217561, "x1": 0.7967032967032966, "y1": 0.1888111888111888}, {"text": "Once upon a time, when pigs were swine and monkeys chewed tobacco, there was a little girl", "x0": 0.11978021978021978, "y0": 0.20202020202020202, "x1": 0.8802197802197802, "y1": 0.21522921522921523}, {"text": "who lived at the foot of the mountains in the centre of the universe at the bottom of the world ...", "x0": 0.11978021978021978, "y0": 0.2191142191142191, "x1": 0.8791208791208791, "y1": 0.23232323232323232}, {"text": "The story-teller was my grandmother and the child was me. We came to her for stories ... Her", "x0": 0.11868131868131868, "y0": 0.24553224553224554, "x1": 0.8802197802197802, "y1": 0.25874125874125875}, {"text": "stories were vivid and shapely and we heard them again and again. In the night under the pine", "x0": 0.11978021978021978, "y0": 0.2618492618492618, "x1": 0.8802197802197802, "y1": 0.27505827505827507}, {"text": "trees, her house creaked and her stories invaded our dreams. Later I would catch something", "x0": 0.11978021978021978, "y0": 0.2789432789432789, "x1": 0.8802197802197802, "y1": 0.29215229215229216}, {"text": "of their rhythms and word play in ballads and sagas and know what a talented story-teller she", "x0": 0.11978021978021978, "y0": 0.29526029526029524, "x1": 0.8802197802197802, "y1": 0.3084693084693085}, {"text": "was. Then we took her for granted ...", "x0": 0.11978021978021978, "y0": 0.31157731157731156, "x1": 0.4230769230769231, "y1": 0.3247863247863248}, {"text": "She was born in 1894, a beloved only child in a family with a little money or the myth of", "x0": 0.11978021978021978, "y0": 0.3317793317793318, "x1": 0.8813186813186813, "y1": 0.3550893550893551}, {"text": "money from her great-great-grandfather, a clergyman, who had invested during the early", "x0": 0.11978021978021978, "y0": 0.3550893550893551, "x1": 0.8791208791208791, "y1": 0.3682983682983683}, {"text": "nineteenth century, surely somewhat dubiously, in Welsh coalmines. Family portraits survive", "x0": 0.11978021978021978, "y0": 0.37218337218337216, "x1": 0.8802197802197802, "y1": 0.3853923853923854}, {"text": "and hang in a Tasmanian dining-room.", "x0": 0.11978021978021978, "y0": 0.3885003885003885, "x1": 0.4318681318681319, "y1": 0.4017094017094017}, {"text": "I know I should check the facts. There is evidence to be weighed, archives to be searched,", "x0": 0.11978021978021978, "y0": 0.41181041181041184, "x1": 0.8791208791208791, "y1": 0.432012432012432}, {"text": "family members still alive who knew her differently. There will be shipping lists and parish", "x0": 0.11978021978021978, "y0": 0.432012432012432, "x1": 0.8802197802197802, "y1": 0.44522144522144524}, {"text": "records, deeds and wills lodged in three countries. The men I will find easily, labelled by their", "x0": 0.11978021978021978, "y0": 0.44522144522144524, "x1": 0.8802197802197802, "y1": 0.4654234654234654}, {"text": "work and their bank balances, the buying and selling of land, and of houses returned to at night.", "x0": 0.11978021978021978, "y0": 0.4654234654234654, "x1": 0.8791208791208791, "y1": 0.47863247863247865}, {"text": "The women will have left less clear a mark on the record but more of a mark on me, perhaps,", "x0": 0.11868131868131868, "y0": 0.48174048174048173, "x1": 0.8791208791208791, "y1": 0.494949494949495}, {"text": "and on all the children in between. There are some family papers, recipes, photographs and a", "x0": 0.11978021978021978, "y0": 0.49805749805749805, "x1": 0.8802197802197802, "y1": 0.5112665112665112}, {"text": "sampler in black cross-stitch done, my grandmother told me, by a child, my great-great-great-", "x0": 0.11978021978021978, "y0": 0.5151515151515151, "x1": 0.8791208791208791, "y1": 0.5283605283605284}, {"text": "great-grandmother, during the Napoleonic wars when children were forbidden to use coloured", "x0": 0.11978021978021978, "y0": 0.5314685314685315, "x1": 0.8802197802197802, "y1": 0.5446775446775447}, {"text": "silks. Or so she said.", "x0": 0.11978021978021978, "y0": 0.5477855477855478, "x1": 0.2857142857142857, "y1": 0.5578865578865578}, {"text": "There were stories of unfeeling trustees and money withheld and unsuitable marriages when", "x0": 0.11868131868131868, "y0": 0.574980574980575, "x1": 0.8802197802197802, "y1": 0.5881895881895882}, {"text": "good-looking rogues took advantage of well-to-do widows \u2014 one of whom was my great-", "x0": 0.11978021978021978, "y0": 0.5912975912975913, "x1": 0.8791208791208791, "y1": 0.6045066045066045}, {"text": "grandmother. She seems to have married an American twenty years her junior after my great-", "x0": 0.11978021978021978, "y0": 0.6083916083916084, "x1": 0.8791208791208791, "y1": 0.6216006216006216}, {"text": "grandfather died. This young man went into the city of London every morning at ten but never", "x0": 0.11978021978021978, "y0": 0.6247086247086248, "x1": 0.8813186813186813, "y1": 0.6379176379176379}, {"text": "told his wife what he did there. Perhaps she never asked. When it was discovered that he'd been", "x0": 0.11978021978021978, "y0": 0.6410256410256411, "x1": 0.8802197802197802, "y1": 0.6542346542346542}, {"text": "through all her money, he returned to America, never to be seen again. Or so the story goes", "x0": 0.11978021978021978, "y0": 0.6581196581196581, "x1": 0.8505494505494505, "y1": 0.6713286713286714}, {"text": "The historian at the back of my brain says I should discover what is true and what is false,", "x0": 0.11868131868131868, "y0": 0.6845376845376845, "x1": 0.8791208791208791, "y1": 0.6977466977466977}, {"text": "make a properly considered account before it\u2019s too late. The rest of me, the part that was", "x0": 0.11978021978021978, "y0": 0.7016317016317016, "x1": 0.8153846153846154, "y1": 0.7148407148407149}, {"text": "by the sense of myself at the centre of the universe at the bottom of the world, still sees, as if", "x0": 0.11978021978021978, "y0": 0.717948717948718, "x1": 0.8813186813186813, "y1": 0.7311577311577312}, {"text": "through certain cloud formations above paddocks pale with tussocks, the shapes and shadows", "x0": 0.11978021978021978, "y0": 0.7342657342657343, "x1": 0.8791208791208791, "y1": 0.7474747474747475}, {"text": "of other places she made my own.", "x0": 0.11978021978021978, "y0": 0.7443667443667443, "x1": 0.3956043956043956, "y1": 0.7676767676767676}, {"text": "I want to leave her and her stories be.", "x0": 0.11978021978021978, "y0": 0.7777777777777778, "x1": 0.4230769230769231, "y1": 0.7878787878787878}, {"text": "McPHEE", "x0": 0.8120879120879121, "y0": 0.8080808080808081, "x1": 0.8802197802197802, "y1": 0.8174048174048174}, {"text": "Adapted from Other People\u2019s Words", "x0": 0.5813186813186814, "y0": 0.8236208236208237, "x1": 0.8802197802197802, "y1": 0.8368298368298368}, {"text": "Other's People's Words by Hilary McPhee (Picador 2001)", "x0": 0.12637362637362637, "y0": 0.8554778554778555, "x1": 0.46703296703296704, "y1": 0.8648018648018648}], [{"text": "Question | (continued)", "x0": 0.11978021978021978, "y0": 0.08158508158508158, "x1": 0.3054945054945055, "y1": 0.09401709401709402}, {"text": "Text 1 \u2014 Short story extract", "x0": 0.11978021978021978, "y0": 0.11499611499611499, "x1": 0.36813186813186816, "y1": 0.1282051282051282}, {"text": "(a) In what ways is dialogue used to capture the young reactions to the", "x0": 0.11978021978021978, "y0": 0.14840714840714841, "x1": 0.8087912087912088, "y1": 0.16161616161616163}, {"text": "items they find?", "x0": 0.16703296703296702, "y0": 0.1655011655011655, "x1": 0.2967032967032967, "y1": 0.17871017871017872}, {"text": "Text 2\u2014 Image", "x0": 0.11978021978021978, "y0": 0.21522921522921523, "x1": 0.25824175824175827, "y1": 0.22843822843822845}, {"text": "(b) How does the image represent an individual who values discovered objects?", "x0": 0.11978021978021978, "y0": 0.24864024864024864, "x1": 0.7857142857142857, "y1": 0.2618492618492618}, {"text": "Text 3 \u2014 Poem", "x0": 0.11978021978021978, "y0": 0.29836829836829837, "x1": 0.25274725274725274, "y1": 0.3084693084693085}, {"text": "(c) Explain how the poem conveys the personal response of the father to his", "x0": 0.11978021978021978, "y0": 0.3317793317793318, "x1": 0.8076923076923077, "y1": 0.34498834498834496}, {"text": "discoveries.", "x0": 0.16703296703296702, "y0": 0.34887334887334887, "x1": 0.26043956043956046, "y1": 0.3581973581973582}, {"text": "Text 4 \u2014 Nonfiction extract", "x0": 0.11978021978021978, "y0": 0.3986013986013986, "x1": 0.36153846153846153, "y1": 0.4087024087024087}, {"text": "(d) Analyse how the text portrays the difficulties of discovering \u2018what is true and", "x0": 0.11978021978021978, "y0": 0.432012432012432, "x1": 0.8087912087912088, "y1": 0.44522144522144524}, {"text": "what is false\u2019.", "x0": 0.16703296703296702, "y0": 0.4483294483294483, "x1": 0.27912087912087913, "y1": 0.45843045843045843}, {"text": "Text 1, Text 2, Text 3 and Text 4 \u2014 Short story extract, Image, Poem and", "x0": 0.11978021978021978, "y0": 0.4988344988344988, "x1": 0.7505494505494505, "y1": 0.5120435120435121}, {"text": "Nonfiction extract", "x0": 0.4318681318681319, "y0": 0.5151515151515151, "x1": 0.5868131868131868, "y1": 0.5252525252525253}, {"text": "(e) Compare how TWO of the texts represent the significance of curiosity in the", "x0": 0.11978021978021978, "y0": 0.5454545454545454, "x1": 0.8087912087912088, "y1": 0.5656565656565656}, {"text": "process of discovering.", "x0": 0.16703296703296702, "y0": 0.5648795648795649, "x1": 0.35274725274725277, "y1": 0.578088578088578}, {"text": "End of Question 1", "x0": 0.421978021978022, "y0": 0.6324786324786325, "x1": 0.5769230769230769, "y1": 0.6449106449106449}], [{"text": "Section II", "x0": 0.11978021978021978, "y0": 0.08236208236208237, "x1": 0.2164835164835165, "y1": 0.09401709401709402}, {"text": "15 marks", "x0": 0.12087912087912088, "y0": 0.11810411810411811, "x1": 0.1989010989010989, "y1": 0.12742812742812742}, {"text": "Attempt Question 2", "x0": 0.11978021978021978, "y0": 0.13364413364413363, "x1": 0.2879120879120879, "y1": 0.14685314685314685}, {"text": "Allow about 40 minutes for this section", "x0": 0.11978021978021978, "y0": 0.14996114996114995, "x1": 0.45604395604395603, "y1": 0.16006216006216006}, {"text": "Answer the question on pages 8-15 of the Paper 1 Writing Booklet. Extra writing booklets are", "x0": 0.11978021978021978, "y0": 0.18337218337218336, "x1": 0.8802197802197802, "y1": 0.19658119658119658}, {"text": "available.", "x0": 0.11978021978021978, "y0": 0.20124320124320125, "x1": 0.1956043956043956, "y1": 0.21056721056721056}, {"text": "Your answer will be assessed on how well you:", "x0": 0.14395604395604394, "y0": 0.23154623154623155, "x1": 0.5274725274725275, "y1": 0.24397824397824397}, {"text": "\u2122 express understanding of discovery in the context of your studies", "x0": 0.14285714285714285, "y0": 0.2501942501942502, "x1": 0.6945054945054945, "y1": 0.2634032634032634}, {"text": "organise, develop and express ideas using language appropriate to audience, purpose", "x0": 0.16703296703296702, "y0": 0.27117327117327117, "x1": 0.856043956043956, "y1": 0.2836052836052836}, {"text": "and context", "x0": 0.16703296703296702, "y0": 0.28826728826728826, "x1": 0.26043956043956046, "y1": 0.2975912975912976}, {"text": "Question 2 (15 marks)", "x0": 0.11978021978021978, "y0": 0.33255633255633255, "x1": 0.30439560439560437, "y1": 0.34498834498834496}, {"text": "Compose a piece of imaginative writing which explores the unexpected impact of discovery.", "x0": 0.11978021978021978, "y0": 0.3628593628593629, "x1": 0.8703296703296703, "y1": 0.3822843822843823}, {"text": "Use ONE of the images on the next page as the central element of your writing.", "x0": 0.11978021978021978, "y0": 0.39937839937839936, "x1": 0.765934065934066, "y1": 0.4125874125874126}, {"text": "Question 2 continues on page 9", "x0": 0.3659340659340659, "y0": 0.48329448329448327, "x1": 0.6329670329670329, "y1": 0.4965034965034965}], [{"text": "Question 2 (continued)", "x0": 0.11978021978021978, "y0": 0.07536907536907538, "x1": 0.3054945054945055, "y1": 0.08702408702408702}, {"text": "\u00a9 Dynamic Duo Studio, Worried Man- Image: 48370", "x0": 0.5208791208791209, "y0": 0.09867909867909867, "x1": 0.8307692307692308, "y1"