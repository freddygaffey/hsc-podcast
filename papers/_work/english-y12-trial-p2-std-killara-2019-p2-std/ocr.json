[[{"text": "Killara", "x0": 0.24285714285714285, "y0": 0.03496503496503497, "x1": 0.4472527472527473, "y1": 0.07303807303807304}, {"text": "HIGH SCHOOL LT]", "x0": 0.24505494505494504, "y0": 0.06682206682206682, "x1": 0.7395604395604396, "y1": 0.10256410256410256}, {"text": "2019", "x0": 0.0967032967032967, "y0": 0.20901320901320902, "x1": 0.16483516483516483, "y1": 0.2261072261072261}, {"text": "TRIAL HIGHER SCHOOL CERTIFICATE", "x0": 0.0956043956043956, "y0": 0.23853923853923853, "x1": 0.46373626373626375, "y1": 0.24864024864024864}, {"text": "EXAMINATION PAPER", "x0": 0.0956043956043956, "y0": 0.2564102564102564, "x1": 0.3054945054945055, "y1": 0.2665112665112665}, {"text": "English (Standard)", "x0": 0.0956043956043956, "y0": 0.35275835275835277, "x1": 0.5241758241758242, "y1": 0.3900543900543901}, {"text": "Paper 2 \u2014 Modules", "x0": 0.0956043956043956, "y0": 0.4172494172494173, "x1": 0.5241758241758242, "y1": 0.45376845376845376}, {"text": "General Instructions Total Marks \u2014 60", "x0": 0.10329670329670329, "y0": 0.6045066045066045, "x1": 0.6472527472527473, "y1": 0.62004662004662}, {"text": "Reading time ~ 5 minutes \u2018* Attempt Questions J, 2AND 3", "x0": 0.1087912087912088, "y0": 0.6332556332556333, "x1": 0.7549450549450549, "y1": 0.6581196581196581}, {"text": "\u00a9 Working time \u2014 2 hours \u2018\u00a9 All questions are of equal value", "x0": 0.1087912087912088, "y0": 0.6526806526806527, "x1": 0.7582417582417582, "y1": 0.668997668997669}, {"text": "\u00a9 Write using black or blue pen Allow about 40 minutes for each", "x0": 0.1087912087912088, "y0": 0.668997668997669, "x1": 0.765934065934066, "y1": 0.6860916860916861}, {"text": "\u00a2 Write your Student Number at the top section", "x0": 0.1087912087912088, "y0": 0.6860916860916861, "x1": 0.5692307692307692, "y1": 0.7024087024087025}, {"text": "of each booklet", "x0": 0.13736263736263737, "y0": 0.7047397047397047, "x1": 0.25384615384615383, "y1": 0.7148407148407149}], [{"text": "Section I - Module A: Language, Identity and Culture", "x0": 0.0989010989010989, "y0": 0.037296037296037296, "x1": 0.6813186813186813, "y1": 0.05439005439005439}, {"text": "20 marks", "x0": 0.0978021978021978, "y0": 0.0707070707070707, "x1": 0.17252747252747253, "y1": 0.08158508158508158}, {"text": "Attempt Question 1", "x0": 0.0978021978021978, "y0": 0.0979020979020979, "x1": 0.2549450549450549, "y1": 0.11033411033411034}, {"text": "Allow about 40 minutes for this section", "x0": 0.0978021978021978, "y0": 0.12432012432012432, "x1": 0.4142857142857143, "y1": 0.13442113442113443}, {"text": "Answer the question in a writing booklet.", "x0": 0.0978021978021978, "y0": 0.15073815073815075, "x1": 0.41318681318681316, "y1": 0.16394716394716394}, {"text": "Your answer will be assessed on how well you:", "x0": 0.0978021978021978, "y0": 0.1794871794871795, "x1": 0.4593406593406593, "y1": 0.1926961926961927}, {"text": "\u00a9 Demonstrate understanding of how ideas about language, identity and culture are expressed", "x0": 0.14285714285714285, "y0": 0.20745920745920746, "x1": 0.8692307692307693, "y1": 0.22066822066822067}, {"text": "through texts", "x0": 0.17032967032967034, "y0": 0.222999222999223, "x1": 0.2692307692307692, "y1": 0.23620823620823622}, {"text": "* Demonstrate understanding of how language is used to shape meaning about individuals and/or", "x0": 0.14285714285714285, "y0": 0.23931623931623933, "x1": 0.8978021978021978, "y1": 0.2533022533022533}, {"text": "cultural groups", "x0": 0.17032967032967034, "y0": 0.25485625485625485, "x1": 0.2835164835164835, "y1": 0.2680652680652681}, {"text": "Organise, develop and express your ideas using language appropriate to audience, purpose and", "x0": 0.17032967032967034, "y0": 0.27117327117327117, "x1": 0.8912087912087913, "y1": 0.28438228438228436}, {"text": "form", "x0": 0.17032967032967034, "y0": 0.2874902874902875, "x1": 0.20549450549450549, "y1": 0.2975912975912976}, {"text": "Question 1 (20 marks)", "x0": 0.0967032967032967, "y0": 0.3442113442113442, "x1": 0.3131868131868132, "y1": 0.358974358974359}, {"text": "Explain how sensory imagery is used to shape the representation of various cultural", "x0": 0.0967032967032967, "y0": 0.37606837606837606, "x1": 0.8395604395604396, "y1": 0.3916083916083916}, {"text": "perspectives in your prescribed text. In your response, make close reference to at least TWO", "x0": 0.0956043956043956, "y0": 0.3947163947163947, "x1": 0.9164835164835164, "y1": 0.41025641025641024}, {"text": "of the poems set for study.", "x0": 0.0967032967032967, "y0": 0.4094794094794095, "x1": 0.33076923076923076, "y1": 0.432012432012432}, {"text": "The prescribed texts are:", "x0": 0.0956043956043956, "y0": 0.4553224553224553, "x1": 0.2813186813186813, "y1": 0.4677544677544678}, {"text": "Poetry:", "x0": 0.12527472527472527, "y0": 0.4801864801864802, "x1": 0.17692307692307693, "y1": 0.49184149184149184}, {"text": "- Adam Aitken, Kim Cheng Boey and Michelle Cahill (eds). Contemporary Asian Australian Poets", "x0": 0.12527472527472527, "y0": 0.5027195027195027, "x1": 0.9, "y1": 0.515928515928516}, {"text": "The prescribed poems are:", "x0": 0.15274725274725276, "y0": 0.519036519036519, "x1": 0.35384615384615387, "y1": 0.5314685314685315}, {"text": "\u00a9 Merlinda Bobis, This is where it begins", "x0": 0.1813186813186813, "y0": 0.5337995337995338, "x1": 0.510989010989011, "y1": 0.5470085470085471}, {"text": "\u00a9 Miriam Wei Wei Lo, Home", "x0": 0.1813186813186813, "y0": 0.5493395493395493, "x1": 0.421978021978022, "y1": 0.5617715617715617}, {"text": "\u00a9 Ouyang Yu, New Accents", "x0": 0.1813186813186813, "y0": 0.5656565656565656, "x1": 0.4065934065934066, "y1": 0.578088578088578}, {"text": "\u00a9 Vuong Pham, Mother", "x0": 0.1813186813186813, "y0": 0.5804195804195804, "x1": 0.3769230769230769, "y1": 0.5928515928515928}, {"text": "\u00a9 Jaya Savige, Circular Breathing", "x0": 0.1813186813186813, "y0": 0.5959595959595959, "x1": 0.4582417582417582, "y1": 0.6091686091686092}, {"text": "\u00a9 Maureen Ten, Translucent Jade", "x0": 0.1813186813186813, "y0": 0.6114996114996115, "x1": 0.45494505494505494, "y1": 0.6239316239316239}], [{"text": "Section H - Module B: Close Study of Literature", "x0": 0.0989010989010989, "y0": 0.03807303807303807, "x1": 0.554945054945055, "y1": 0.052059052059052056}, {"text": "20 marks", "x0": 0.0978021978021978, "y0": 0.06682206682206682, "x1": 0.17142857142857143, "y1": 0.07614607614607614}, {"text": "Attempt Question 2", "x0": 0.09340659340659341, "y0": 0.08547008547008547, "x1": 0.2549450549450549, "y1": 0.11033411033411034}, {"text": "Allow about 40 minutes for this section", "x0": 0.0978021978021978, "y0": 0.11965811965811966, "x1": 0.41318681318681316, "y1": 0.12975912975912976}, {"text": "Answer Question 2 ina SEPARATE writing booklet.", "x0": 0.07472527472527472, "y0": 0.14607614607614608, "x1": 0.4857142857142857, "y1": 0.1585081585081585}, {"text": "Your answer will be assessed on how well you:", "x0": 0.0978021978021978, "y0": 0.17560217560217561, "x1": 0.4582417582417582, "y1": 0.18803418803418803}, {"text": "+ Demonstrate an understanding of a text\u2019s distinctive qualities and how these shape meaning", "x0": 0.07472527472527472, "y0": 0.19502719502719504, "x1": 0.7967032967032966, "y1": 0.22066822066822067}, {"text": "* Organise, develop and express ideas using language appropriate to audience, purpose and form", "x0": 0.07472527472527472, "y0": 0.21833721833721834, "x1": 0.8197802197802198, "y1": 0.23232323232323232}, {"text": "Question 2 (20 marks)", "x0": 0.0978021978021978, "y0": 0.28205128205128205, "x1": 0.3065934065934066, "y1": 0.29681429681429683}, {"text": "It was 7 minutes after midnight.", "x0": 0.15384615384615385, "y0": 0.31313131313131315, "x1": 0.43736263736263736, "y1": 0.3278943278943279}, {"text": "The dog was lying on the grass in the middle of the lawn in front of Mrs Shears'", "x0": 0.15384615384615385, "y0": 0.3480963480963481, "x1": 0.8626373626373627, "y1": 0.3644133644133644}, {"text": "house. Its eyes were closed. It looked as if it was running on its side, the way dogs run", "x0": 0.15384615384615385, "y0": 0.36596736596736595, "x1": 0.9197802197802197, "y1": 0.3822843822843823}, {"text": "when they think they are chasing a cat in a dream. But the dog was not running or", "x0": 0.15384615384615385, "y0": 0.3838383838383838, "x1": 0.8813186813186813, "y1": 0.40015540015540013}, {"text": "asleep. The dog was dead. There was a garden fork sticking out of the dog. The points", "x0": 0.15384615384615385, "y0": 0.4017094017094017, "x1": 0.9186813186813186, "y1": 0.4188034188034188}, {"text": "of the fork must have gone all the way through the dog and into the ground because", "x0": 0.15384615384615385, "y0": 0.42035742035742035, "x1": 0.8967032967032967, "y1": 0.4366744366744367}, {"text": "the fork had not fallen over. I decided that the dog was probably killed with the fork", "x0": 0.15384615384615385, "y0": 0.43745143745143744, "x1": 0.9010989010989011, "y1": 0.45376845376845376}, {"text": "because I could not see any other wounds in the dog and I do not think you would", "x0": 0.15384615384615385, "y0": 0.4522144522144522, "x1": 0.8802197802197802, "y1": 0.4763014763014763}, {"text": "stick a garden fork into a dog after it had died for some other reason, like cancer for", "x0": 0.15384615384615385, "y0": 0.4731934731934732, "x1": 0.8978021978021978, "y1": 0.4902874902874903}, {"text": "example, or a road accident. But I could not be certain about this.", "x0": 0.15384615384615385, "y0": 0.4926184926184926, "x1": 0.734065934065934, "y1": 0.508935508935509}, {"text": "How has the interplay between the ideas, form and language of \u2018The Curious Incident of the", "x0": 0.0967032967032967, "y0": 0.5275835275835276, "x1": 0.9164835164835164, "y1": 0.5446775446775447}, {"text": "Dog in the Night-time\u2019 led to a greater appreciation of the distinctive qualities of the text?", "x0": 0.0967032967032967, "y0": 0.5454545454545454, "x1": 0.8956043956043956, "y1": 0.5625485625485626}, {"text": "Make reference to the excerpt above in your discussion of the text.", "x0": 0.0978021978021978, "y0": 0.5648795648795649, "x1": 0.6879120879120879, "y1": 0.5804195804195804}, {"text": "The prescribed text is:", "x0": 0.0967032967032967, "y0": 0.6153846153846154, "x1": 0.2934065934065934, "y1": 0.6309246309246309}, {"text": "Prose Fiction: \u2014 Mark Haddon, The Curious Incident of the Dog in the Night-time", "x0": 0.0978021978021978, "y0": 0.6464646464646465, "x1": 0.8285714285714286, "y1": 0.662004662004662}], [{"text": "Section III - Module C: The Craft of Writing", "x0": 0.0978021978021978, "y0": 0.06604506604506605, "x1": 0.5230769230769231, "y1": 0.08158508158508158}, {"text": "20 marks", "x0": 0.0967032967032967, "y0": 0.09712509712509712, "x1": 0.17032967032967034, "y1": 0.10722610722610723}, {"text": "Attempt Question 3 Part A and Part B", "x0": 0.0967032967032967, "y0": 0.12432012432012432, "x1": 0.4098901098901099, "y1": 0.13675213675213677}, {"text": "Allow about 40 minutes for this section", "x0": 0.0967032967032967, "y0": 0.15073815073815075, "x1": 0.41208791208791207, "y1": 0.16161616161616163}, {"text": "Answer Question 3 in a SEPARATE writing booklet.", "x0": 0.0956043956043956, "y0": 0.17715617715617715, "x1": 0.5076923076923077, "y1": 0.19036519036519037}, {"text": "Your answer will be assessed on how well you:", "x0": 0.1076923076923077, "y0": 0.2066822066822067, "x1": 0.46813186813186813, "y1": 0.2198912198912199}, {"text": "* Craft language to address the demands of the question", "x0": 0.12417582417582418, "y0": 0.2261072261072261, "x1": 0.5648351648351648, "y1": 0.25252525252525254}, {"text": "* Use language appropriate to audience, purpose and context to deliberately shape meaning", "x0": 0.12417582417582418, "y0": 0.25097125097125095, "x1": 0.8351648351648352, "y1": 0.26495726495726496}, {"text": "Question 3 (20 marks)", "x0": 0.0956043956043956, "y0": 0.2836052836052836, "x1": 0.30439560439560437, "y1": 0.29836829836829837}, {"text": "\u201cThe fault is not in our stars but in ourselves.\u201d", "x0": 0.30439560439560437, "y0": 0.31546231546231546, "x1": 0.7164835164835165, "y1": 0.3271173271173271}, {"text": "Based on a quote by William Shakespeare", "x0": 0.3505494505494505, "y0": 0.3333333333333333, "x1": 0.6714285714285714, "y1": 0.3457653457653458}, {"text": "OR.", "x0": 0.4967032967032967, "y0": 0.36752136752136755, "x1": 0.5263736263736264, "y1": 0.37839937839937837}, {"text": "\u201cWe dream to give ourselves hope. To stop dreaming - well, that\u2019s like saying you can never", "x0": 0.0967032967032967, "y0": 0.40792540792540793, "x1": 0.9230769230769231, "y1": 0.4234654234654235}, {"text": "change your fate.\u201d", "x0": 0.42967032967032964, "y0": 0.4257964257964258, "x1": 0.5912087912087912, "y1": 0.44133644133644134}, {"text": "\u2018Amy Tan", "x0": 0.4747252747252747, "y0": 0.44366744366744365, "x1": 0.5461538461538461, "y1": 0.4560994560994561}, {"text": "Part A", "x0": 0.0945054945054945, "y0": 0.5003885003885004, "x1": 0.15604395604395604, "y1": 0.5120435120435121}, {"text": "Use ONE of the lines above as a stimulus for the opening of an imaginative, persuasive or", "x0": 0.09340659340659341, "y0": 0.5174825174825175, "x1": 0.8945054945054945, "y1": 0.533022533022533}, {"text": "discursive piece of writing. In your piece of writing use ONE literary technique or stylistic", "x0": 0.0945054945054945, "y0": 0.5361305361305362, "x1": 0.9, "y1": 0.5516705516705517}, {"text": "device that you have learnt about through your study of a prescribed text in Module C.", "x0": 0.09340659340659341, "y0": 0.554001554001554, "x1": 0.8626373626373627, "y1": 0.5695415695415695}, {"text": "(12 marks)", "x0": 0.7813186813186813, "y0": 0.5726495726495726, "x1": 0.8769230769230769, "y1": 0.5874125874125874}, {"text": "Part B", "x0": 0.09340659340659341, "y0": 0.6091686091686092, "x1": 0.15384615384615385, "y1": 0.62004662004662}, {"text": "Explain how at least ONE of your prescribed texts from Module C has influenced your", "x0": 0.09340659340659341, "y0": 0.6231546231546231, "x1": 0.8681318681318682, "y1": 0.6449106449106449}, {"text": "writing style in Part A. In your response, focus on ONE literary device or stylistic feature", "x0": 0.09340659340659341, "y0": 0.6441336441336442, "x1": 0.889010989010989, "y1": 0.6596736596736597}, {"text": "you have used in Part A.", "x0": 0.09340659340659341, "y0": 0.662004662004662, "x1": 0.310989010989011, "y1": 0.6775446775446775}, {"text": "(8 marks)", "x0": 0.7824175824175824, "y0": 0.6806526806526807, "x1": 0.865934065934066, "y1": 0.6954156954156954}, {"text": "The prescribed texts for Module C are:", "x0": 0.09340659340659341, "y0": 0.7125097125097125, "x1": 0.389010989010989, "y1": 0.7249417249417249}, {"text": "- Prose - Ray Bradbury, The Pedestrian", "x0": 0.12197802197802197, "y0": 0.7412587412587412, "x1": 0.567032967032967, "y1": 0.7544677544677545}, {"text": "- Non Fiction: - Helen Garner, Dear Mrs Dunkley", "x0": 0.12197802197802197, "y0": 0.7591297591297591, "x1": 0.5901098901098901, "y1": 0.7715617715617715}, {"text": "- Poetry: Robert Frost, Stopping by Woods on a Snowy Evening", "x0": 0.12197802197802197, "y0": 0.777000777000777, "x1": 0.7472527472527473, "y1": 0.7902097902097902}, {"text": "- Speeches: - Steve Jobs, How to live before you die", "x0": 0.12197802197802197, "y0": 0.7948717948717948, "x1": 0.6252747252747253, "y1": 0.8080808080808081}, {"text": "End of paper", "x0": 0.43736263736263736, "y0": 0.8251748251748252, "x1": 0.5351648351648352, "y1": 0.8360528360528361}]]