[[{"text": "GOVERNMENT", "x0": 0.12197802197802197, "y0": 0.1592851592851593, "x1": 0.22527472527472528, "y1": 0.16705516705516704}, {"text": "NSW Education Standards Authority", "x0": 0.11978021978021978, "y0": 0.19114219114219114, "x1": 0.4725274725274725, "y1": 0.20512820512820512}, {"text": "2021 | HIGHER SCHOOL CERTIFICATE EXAMINATION", "x0": 0.12747252747252746, "y0": 0.30691530691530694, "x1": 0.5857142857142857, "y1": 0.331002331002331}, {"text": "English Extension 1", "x0": 0.12307692307692308, "y0": 0.351981351981352, "x1": 0.5813186813186814, "y1": 0.38694638694638694}, {"text": "General + Reading time - 10 minutes", "x0": 0.11978021978021978, "y0": 0.4289044289044289, "x1": 0.5241758241758242, "y1": 0.4483294483294483}, {"text": "Instructions \u2014- Working time \u2014 2 hours", "x0": 0.11978021978021978, "y0": 0.44988344988344986, "x1": 0.49230769230769234, "y1": 0.4662004662004662}, {"text": "+ Write using black pen", "x0": 0.2681318681318681, "y0": 0.473970473970474, "x1": 0.47802197802197804, "y1": 0.48717948717948717}, {"text": "Total marks: Section | - 25 marks (pages 2-4)", "x0": 0.11868131868131868, "y0": 0.5283605283605284, "x1": 0.5714285714285714, "y1": 0.5415695415695416}, {"text": "50 + Attempt Question 1", "x0": 0.11868131868131868, "y0": 0.5454545454545454, "x1": 0.45604395604395603, "y1": 0.5656565656565656}, {"text": "+ Allow about 1 hour for this section", "x0": 0.2681318681318681, "y0": 0.5734265734265734, "x1": 0.5934065934065934, "y1": 0.5835275835275835}, {"text": "Section II - 25 marks (pages 5-10)", "x0": 0.26703296703296703, "y0": 0.6068376068376068, "x1": 0.589010989010989, "y1": 0.62004662004662}, {"text": "+ Attempt ONE question from Questions 2 (a)\u20142 (e)", "x0": 0.2681318681318681, "y0": 0.6309246309246309, "x1": 0.7241758241758242, "y1": 0.6441336441336442}, {"text": "+ Allow about 1 hour for this section", "x0": 0.2681318681318681, "y0": 0.6526806526806527, "x1": 0.5934065934065934, "y1": 0.6627816627816627}, {"text": "2280", "x0": 0.08131868131868132, "y0": 0.9463869463869464, "x1": 0.11758241758241758, "y1": 0.9549339549339549}], [{"text": "Section I \u2014 Common Module: Literary Worlds", "x0": 0.11978021978021978, "y0": 0.08236208236208237, "x1": 0.5989010989010989, "y1": 0.09712509712509712}, {"text": "25 marks", "x0": 0.11868131868131868, "y0": 0.11732711732711733, "x1": 0.1989010989010989, "y1": 0.12742812742812742}, {"text": "Attempt Question 1", "x0": 0.11868131868131868, "y0": 0.13364413364413363, "x1": 0.2868131868131868, "y1": 0.14685314685314685}, {"text": "Allow about 1 hour for this section", "x0": 0.11868131868131868, "y0": 0.15073815073815075, "x1": 0.4186813186813187, "y1": 0.16083916083916083}, {"text": "Answer the question on pages 2\u201412 of the English Extension 1 Writing Booklet. Extra writing", "x0": 0.11978021978021978, "y0": 0.18337218337218336, "x1": 0.8791208791208791, "y1": 0.19658119658119658}, {"text": "booklets are available.", "x0": 0.11868131868131868, "y0": 0.20046620046620048, "x1": 0.2989010989010989, "y1": 0.21056721056721056}, {"text": "Your answer will be assessed on how well you:", "x0": 0.14395604395604394, "y0": 0.23154623154623155, "x1": 0.5274725274725275, "y1": 0.24397824397824397}, {"text": "e demonstrate an understanding of the ideas and values of Literary Worlds and how", "x0": 0.14285714285714285, "y0": 0.2501942501942502, "x1": 0.8538461538461538, "y1": 0.2634032634032634}, {"text": "they are shaped and reflected in texts", "x0": 0.16703296703296702, "y0": 0.26728826728826727, "x1": 0.46703296703296704, "y1": 0.2804972804972805}, {"text": "\u00a9 craft a sustained composition appropriate to the question, demonstrating control of the", "x0": 0.14285714285714285, "y0": 0.2874902874902875, "x1": 0.856043956043956, "y1": 0.3006993006993007}, {"text": "use of language", "x0": 0.16703296703296702, "y0": 0.3038073038073038, "x1": 0.2934065934065934, "y1": 0.317016317016317}, {"text": "Question 1 (25 marks)", "x0": 0.11978021978021978, "y0": 0.34965034965034963, "x1": 0.30439560439560437, "y1": 0.3620823620823621}, {"text": "Read Text | on pages 3-4.", "x0": 0.11978021978021978, "y0": 0.38306138306138304, "x1": 0.33516483516483514, "y1": 0.3954933954933955}, {"text": "How does Hanya Yanagihara\u2019s closing address challenge your understanding of the nature of", "x0": 0.11978021978021978, "y0": 0.4156954156954157, "x1": 0.8813186813186813, "y1": 0.4289044289044289}, {"text": "literary worlds?", "x0": 0.11978021978021978, "y0": 0.43278943278943277, "x1": 0.24615384615384617, "y1": 0.445998445998446}, {"text": "Question 1 continues on page 3", "x0": 0.3659340659340659, "y0": 0.4996114996114996, "x1": 0.6329670329670329, "y1": 0.5128205128205128}], [{"text": "Question | (continued)", "x0": 0.11978021978021978, "y0": 0.08158508158508158, "x1": 0.30439560439560437, "y1": 0.09401709401709402}, {"text": "Text 1 \u2014 Extract from Hanya Yanagihara\u2019s Closing Address at the Sydney Writers\u2019", "x0": 0.11868131868131868, "y0": 0.12043512043512043, "x1": 0.8494505494505494, "y1": 0.13364413364413363}, {"text": "Festival 2016", "x0": 0.20549450549450549, "y0": 0.13752913752913754, "x1": 0.31758241758241756, "y1": 0.14763014763014762}, {"text": "In literature, the engagement between the reader\u2019s imagination and the", "x0": 0.17032967032967034, "y0": 0.1888111888111888, "x1": 0.7593406593406593, "y1": 0.20202020202020202}, {"text": "imagination is different, more intense and more participatory, than that between", "x0": 0.17032967032967034, "y0": 0.20590520590520592, "x1": 0.8296703296703297, "y1": 0.2191142191142191}, {"text": "the viewer and the painter. This is because with fiction, the reader is asked to", "x0": 0.17032967032967034, "y0": 0.2222222222222222, "x1": 0.8296703296703297, "y1": 0.23543123543123542}, {"text": "imagine, to see, what is being described, and so reading itself becomes an act", "x0": 0.17032967032967034, "y0": 0.23931623931623933, "x1": 0.8296703296703297, "y1": 0.25252525252525254}, {"text": "of psychological reckoning. We are asked as readers to become complicit in the", "x0": 0.17032967032967034, "y0": 0.2556332556332556, "x1": 0.8296703296703297, "y1": 0.26884226884226886}, {"text": "world we are encouraged to create for ourselves.", "x0": 0.17032967032967034, "y0": 0.2727272727272727, "x1": 0.5637362637362637, "y1": 0.28593628593628595}, {"text": "Fiction, and the lives we encounter in fiction, does not harden us to the lives of", "x0": 0.17032967032967034, "y0": 0.3247863247863248, "x1": 0.8307692307692308, "y1": 0.33644133644133645}, {"text": "others, but rather reminds us that the stories we know are only the stories we have", "x0": 0.17032967032967034, "y0": 0.3411033411033411, "x1": 0.8296703296703297, "y1": 0.3543123543123543}, {"text": "heard. The world is full of impossible lives. Fiction reminds us that they exist all", "x0": 0.17032967032967034, "y0": 0.3581973581973582, "x1": 0.8296703296703297, "y1": 0.3714063714063714}, {"text": "around us and that our obligation is to listen to their details when they are being told", "x0": 0.17032967032967034, "y0": 0.3745143745143745, "x1": 0.8296703296703297, "y1": 0.3877233877233877}, {"text": "to us. There are many reasons not to read a book, to not look at a piece of art, but", "x0": 0.17032967032967034, "y0": 0.3916083916083916, "x1": 0.8296703296703297, "y1": 0.4048174048174048}, {"text": "the fact that it is difficult cannot be one of them. Fiction allows us the opportunity", "x0": 0.17032967032967034, "y0": 0.40792540792540793, "x1": 0.8285714285714286, "y1": 0.4211344211344211}, {"text": "to practise our own humanity, to exercise our own compassion, to remain alive and", "x0": 0.17032967032967034, "y0": 0.425019425019425, "x1": 0.8296703296703297, "y1": 0.4382284382284382}, {"text": "alert to the indignities of all lives. Art should make us uncomfortable. To choose", "x0": 0.17032967032967034, "y0": 0.44133644133644134, "x1": 0.8296703296703297, "y1": 0.45454545454545453}, {"text": "not to see it because it does so is to start sacrificing that humanity, bit by bit.", "x0": 0.17032967032967034, "y0": 0.45843045843045843, "x1": 0.7934065934065934, "y1": 0.4716394716394716}, {"text": "To read fiction is ... to leave us with every nerve and sense exposed, to allow", "x0": 0.16923076923076924, "y0": 0.5104895104895105, "x1": 0.8296703296703297, "y1": 0.5236985236985237}, {"text": "ourselves to be vulnerable, horribly and wonderfully vulnerable, to all lives, and", "x0": 0.17032967032967034, "y0": 0.5268065268065268, "x1": 0.8296703296703297, "y1": 0.54001554001554}, {"text": "every life. We may not encounter them in person, in the flesh, but we can on the", "x0": 0.17032967032967034, "y0": 0.5439005439005439, "x1": 0.8296703296703297, "y1": 0.5571095571095571}, {"text": "page, no matter who we are, or where we live.", "x0": 0.17032967032967034, "y0": 0.560994560994561, "x1": 0.545054945054945, "y1": 0.5734265734265734}, {"text": "1 would argue that what makes fiction uniquely powerful is that I not only don\u2019t", "x0": 0.17032967032967034, "y0": 0.6122766122766122, "x1": 0.8296703296703297, "y1": 0.6254856254856255}, {"text": "have to \u2014 but ideally don\u2019t \u2014 think of you at all when I write. Thinking about", "x0": 0.17032967032967034, "y0": 0.6293706293706294, "x1": 0.8296703296703297, "y1": 0.6425796425796426}, {"text": "one\u2019s reader means that you are performing for your audience. You are choosing", "x0": 0.17032967032967034, "y0": 0.6456876456876457, "x1": 0.8296703296703297, "y1": 0.6588966588966589}, {"text": "to become an entertainer, and an entertainer is not always the same thing as a", "x0": 0.17032967032967034, "y0": 0.6627816627816627, "x1": 0.8296703296703297, "y1": 0.675990675990676}, {"text": "storyteller. And yet we have a relationship anyway, though not one defined by the", "x0": 0.17032967032967034, "y0": 0.675990675990676, "x1": 0.8296703296703297, "y1": 0.6954156954156954}, {"text": "typical rules of a relationship. If your job is to surrender, my job is to tell you a", "x0": 0.17032967032967034, "y0": 0.6930846930846931, "x1": 0.8296703296703297, "y1": 0.7125097125097125}, {"text": "story and to tell you that story without fear or compromise.", "x0": 0.17032967032967034, "y0": 0.7125097125097125, "x1": 0.6494505494505495, "y1": 0.7257187257187258}, {"text": "My vow to you is that I will create a complete universe for you to inhabit.", "x0": 0.17032967032967034, "y0": 0.745920745920746, "x1": 0.7714285714285715, "y1": 0.7591297591297591}, {"text": "My vow to you is that I will not think of the potential popularity of what I am", "x0": 0.17032967032967034, "y0": 0.7793317793317793, "x1": 0.8296703296703297, "y1": 0.7925407925407926}, {"text": "creating or how it might be critically received.", "x0": 0.17032967032967034, "y0": 0.7956487956487956, "x1": 0.545054945054945, "y1": 0.8088578088578089}, {"text": "My vow to you is that I will tell the story that I think needs to be told, not the story", "x0": 0.17032967032967034, "y0": 0.8290598290598291, "x1": 0.8285714285714286, "y1": 0.8422688422688422}, {"text": "I think will be liked.", "x0": 0.17032967032967034, "y0": 0.8461538461538461, "x1": 0.33406593406593404, "y1": 0.8562548562548562}, {"text": "Text 1 continues on page 4", "x0": 0.38461538461538464, "y0": 0.8997668997668997, "x1": 0.6142857142857143, "y1": 0.912975912975913}], [{"text": "Text 1 (continued)", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.2692307692307692, "y1": 0.09401709401709402}, {"text": "My vow to you is that I will treat all of my characters with respect and empathy.", "x0": 0.17032967032967034, "y0": 0.13986013986013987, "x1": 0.8241758241758241, "y1": 0.15306915306915306}, {"text": "My vow to you is that I will only write what feels urgent to me, what feels like a", "x0": 0.17032967032967034, "y0": 0.17327117327117328, "x1": 0.8296703296703297, "y1": 0.1864801864801865}, {"text": "story only I'can tell.", "x0": 0.17032967032967034, "y0": 0.19036519036519037, "x1": 0.33186813186813185, "y1": 0.20279720279720279}, {"text": "My vow to you is that I will not patronise you by treating you like a child from", "x0": 0.17032967032967034, "y0": 0.222999222999223, "x1": 0.8296703296703297, "y1": 0.23620823620823622}, {"text": "whom certain things must be withheld or censored.", "x0": 0.17032967032967034, "y0": 0.23931623931623933, "x1": 0.5835164835164836, "y1": 0.25252525252525254}, {"text": "My vow to you is that I will use a lie to tell the truth.", "x0": 0.17032967032967034, "y0": 0.26961926961926963, "x1": 0.6010989010989011, "y1": 0.289044289044289}, {"text": "My vow to you is that I will try, in everything I write, to look at the full range of the", "x0": 0.17032967032967034, "y0": 0.3061383061383061, "x1": 0.8296703296703297, "y1": 0.31934731934731936}, {"text": "human experience \u2014 the beauty and ugliness, the compassion and brutality \u2014 with", "x0": 0.17032967032967034, "y0": 0.32323232323232326, "x1": 0.8296703296703297, "y1": 0.33644133644133645}, {"text": "courage, and that I will present those worlds to you. This, too, is our communion*", "x0": 0.17032967032967034, "y0": 0.3395493395493395, "x1": 0.8285714285714286, "y1": 0.35275835275835277}, {"text": "and it is what has defined fiction for centuries, and will forever more.", "x0": 0.17032967032967034, "y0": 0.35664335664335667, "x1": 0.734065934065934, "y1": 0.3682983682983683}, {"text": "Ours is one of human history\u2019s elemental relationships \u2014 me, the storyteller; you,", "x0": 0.17032967032967034, "y0": 0.4226884226884227, "x1": 0.8296703296703297, "y1": 0.4358974358974359}, {"text": "the listener \u2014 that speaks to our desire, our need, to hear about other lives, lives", "x0": 0.17032967032967034, "y0": 0.4397824397824398, "x1": 0.8296703296703297, "y1": 0.452991452991453}, {"text": "that resemble our own of course, but also lives that don\u2019t.", "x0": 0.17032967032967034, "y0": 0.4560994560994561, "x1": 0.6362637362637362, "y1": 0.4677544677544678}, {"text": "Tonight we are together in this hall in Sydney and it is 2016, but we just as well", "x0": 0.16923076923076924, "y0": 0.48951048951048953, "x1": 0.8296703296703297, "y1": 0.5027195027195027}, {"text": "could have been in the palace of the Spanish royal family in 1779, with Goya**", "x0": 0.17032967032967034, "y0": 0.5066045066045066, "x1": 0.8285714285714286, "y1": 0.5198135198135199}, {"text": "painting behind us, or we could be somewhere even further back in history: in", "x0": 0.17032967032967034, "y0": 0.5229215229215229, "x1": 0.8296703296703297, "y1": 0.5361305361305362}, {"text": "America in the 1600s, or Germany in the 1400s, or Japan in the 800s. Or further", "x0": 0.17032967032967034, "y0": 0.54001554001554, "x1": 0.8307692307692308, "y1": 0.5532245532245532}, {"text": "and further back still: in China in the 600s, in Africa in the 200s, in South America", "x0": 0.17032967032967034, "y0": 0.5563325563325563, "x1": 0.8296703296703297, "y1": 0.567987567987568}, {"text": "long before Western civilisation began, huddled about a fire, while strange animals", "x0": 0.17032967032967034, "y0": 0.5726495726495726, "x1": 0.8296703296703297, "y1": 0.5858585858585859}, {"text": "coo and bark and keen in the jungles around us. And maybe in the light of that fire,", "x0": 0.17032967032967034, "y0": 0.5897435897435898, "x1": 0.8296703296703297, "y1": 0.602952602952603}, {"text": "something shifts, and we're no longer quite sure where exactly we are. We could", "x0": 0.17032967032967034, "y0": 0.6060606060606061, "x1": 0.8296703296703297, "y1": 0.6192696192696193}, {"text": "be not in this world at all, but in another.", "x0": 0.17032967032967034, "y0": 0.6231546231546231, "x1": 0.5010989010989011, "y1": 0.6348096348096348}, {"text": "We are waiting to willingly succumb to bewitchment, no matter what that", "x0": 0.17032967032967034, "y0": 0.6899766899766899, "x1": 0.8296703296703297, "y1": 0.7031857031857032}, {"text": "bewitchment might be. All I have to do is say the words, and we can begin. And", "x0": 0.17032967032967034, "y0": 0.7062937062937062, "x1": 0.8296703296703297, "y1": 0.7195027195027195}, {"text": "so I will.", "x0": 0.17032967032967034, "y0": 0.7226107226107226, "x1": 0.24065934065934066, "y1": 0.7327117327117327}, {"text": "Now | am going to tell you a story.", "x0": 0.17032967032967034, "y0": 0.756021756021756, "x1": 0.45494505494505494, "y1": 0.7692307692307693}, {"text": "Reprinted by kind approval of H. Yanaquihara", "x0": 0.5703296703296703, "y0": 0.7863247863247863, "x1": 0.8406593406593407, "y1": 0.7956487956487956}, {"text": "a connection due to the sharing of thoughts and feelings", "x0": 0.2978021978021978, "y0": 0.8197358197358198, "x1": 0.6780219780219781, "y1": 0.8298368298368298}, {"text": "** Goya Francisco Goya was a Spanish artist (1746-1828)", "x0": 0.16373626373626374, "y0": 0.8422688422688422, "x1": 0.6384615384615384, "y1": 0.8523698523698524}, {"text": "End of Question 1", "x0": 0.421978021978022, "y0": 0.8997668997668997, "x1": 0.5758241758241758, "y1": 0.9121989121989122}], [{"text": "Section II \u2014 Electives", "x0": 0.11978021978021978, "y0": 0.08236208236208237, "x1": 0.34065934065934067, "y1": 0.09401709401709402}, {"text": "25 marks", "x0": 0.11868131868131868, "y0": 0.11732711732711733, "x1": 0.1989010989010989, "y1": 0.12742812742812742}, {"text": "Attempt ONE question from Questions 2", "x0": 0.11868131868131868, "y0": 0.13364413364413363, "x1": 0.4714285714285714, "y1": 0.14685314685314685}, {"text": "Allow about 1 hour for this section", "x0": 0.11868131868131868, "y0": 0.15073815073815075, "x1": 0.4186813186813187, "y1": 0.16083916083916083}, {"text": "Answer the question on pages 14-24 of the English Extension | Writing Booklet. Extra writing", "x0": 0.11978021978021978, "y0": 0.18337218337218336, "x1": 0.8791208791208791, "y1": 0.19658119658119658}, {"text": "booklets are available.", "x0": 0.11868131868131868, "y0": 0.20046620046620048, "x1": 0.2989010989010989, "y1": 0.21056721056721056}, {"text": "Your answer will be assessed on how well you:", "x0": 0.14395604395604394, "y0": 0.23154623154623155, "x1": 0.5274725274725275, "y1": 0.24397824397824397}, {"text": "e demonstrate an understanding of the ideas and values of Literary Worlds and how", "x0": 0.14285714285714285, "y0": 0.2501942501942502, "x1": 0.8538461538461538, "y1": 0.2634032634032634}, {"text": "they are shaped and reflected in texts", "x0": 0.16703296703296702, "y0": 0.26728826728826727, "x1": 0.46703296703296704, "y1": 0.2804972804972805}, {"text": "\u00a9 craft a sustained composition appropriate to the question, demonstrating control of the", "x0": 0.14285714285714285, "y0": 0.2874902874902875, "x1": 0.856043956043956, "y1": 0.3006993006993007}, {"text": "use of language", "x0": 0.16703296703296702, "y0": 0.3038073038073038, "x1": 0.2934065934065934, "y1": 0.317016317016317}, {"text": "Please turn over", "x0": 0.42967032967032964, "y0": 0.44988344988344986, "x1": 0.5692307692307692, "y1": 0.45998445998445997}], [{"text": "Question 2 (a) \u2014 Elective 1: Literary Homelands (25 marks)", "x0": 0.11978021978021978, "y0": 0.08158508158508158, "x1": 0.6362637362637362, "y1": 0.0947940947940948}, {"text": "Through the unique ways they explore questions of difference, composers allow us \u2018to practise", "x0": 0.11868131868131868, "y0": 0.11499611499611499, "x1": 0.8791208791208791, "y1": 0.1282051282051282}, {"text": "our own humanity\u2019.", "x0": 0.11868131868131868, "y0": 0.1320901320901321, "x1": 0.27802197802197803, "y1": 0.1452991452991453}, {"text": "How does this statement reflect your experience of studying Literary Homelands?", "x0": 0.11978021978021978, "y0": 0.1655011655011655, "x1": 0.7835164835164835, "y1": 0.17871017871017872}, {"text": "In your response, refer to TWO of your prescribed texts and at least ONE related text of your", "x0": 0.11978021978021978, "y0": 0.1989121989121989, "x1