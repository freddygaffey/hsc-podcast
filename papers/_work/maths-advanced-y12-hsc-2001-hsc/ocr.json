70707071}, {"text": "x=\u2014\u2014~ f is measured in seconds.", "x0": 0.3241758241758242, "y0": 0.7070707070707071, "x1": 0.6780219780219781, "y1": 0.7163947163947164}, {"text": "t+2", "x0": 0.35714285714285715, "y0": 0.7163947163947164, "x1": 0.3923076923076923, "y1": 0.7264957264957265}, {"text": "(i) What is the displacement when 1=0? 1", "x0": 0.18681318681318682, "y0": 0.7505827505827506, "x1": 0.8791208791208791, "y1": 0.7637917637917638}, {"text": "(ii) Show that 4 3", "x0": 0.1813186813186813, "y0": 0.7863247863247863, "x1": 0.8802197802197802, "y1": 0.8073038073038074}, {"text": "ii w that x=1-\u2014\u2014.", "x0": 0.1835164835164835, "y0": 0.7894327894327894, "x1": 0.42637362637362636, "y1": 0.8127428127428128}, {"text": "t+2", "x0": 0.3791208791208791, "y0": 0.804972804972805, "x1": 0.41318681318681316, "y1": 0.815073815073815}, {"text": "Hence find expressions for the velocity and the acceleration in terms of t.", "x0": 0.22747252747252747, "y0": 0.8236208236208237, "x1": 0.8076923076923077, "y1": 0.8368298368298368}, {"text": "(iii) Is the particle ever at rest? Give reasons for your answer. 1", "x0": 0.17582417582417584, "y0": 0.857031857031857, "x1": 0.8791208791208791, "y1": 0.8702408702408703}, {"text": "(iv) What is the limiting velocity of the particle as f increases indefinitely? 1", "x0": 0.17692307692307693, "y0": 0.8904428904428905, "x1": 0.8791208791208791, "y1": 0.9036519036519036}], [{"text": "Marks", "x0": 0.8241758241758241, "y0": 0.08391608391608392, "x1": 0.8802197802197802, "y1": 0.09401709401709402}, {"text": "Question 8 (12 marks) Use a SEPARATE writing booklet.", "x0": 0.11978021978021978, "y0": 0.10101010101010101, "x1": 0.5934065934065934, "y1": 0.11421911421911422}, {"text": "In November 1923, 18 koalas were introduced on Kangaroo Island. 5", "x0": 0.16703296703296702, "y0": 0.15073815073815075, "x1": 0.8791208791208791, "y1": 0.16394716394716394}, {"text": "(a)", "x0": 0.11978021978021978, "y0": 0.15151515151515152, "x1": 0.14065934065934066, "y1": 0.1623931623931624}, {"text": "By November 1993, the number of koalas had increased to 5000.", "x0": 0.16703296703296702, "y0": 0.16783216783216784, "x1": 0.6945054945054945, "y1": 0.18104118104118105}, {"text": "Assume that the number N of koalas is increasing exponentially and satisfies an", "x0": 0.16703296703296702, "y0": 0.20124320124320125, "x1": 0.8087912087912088, "y1": 0.22066822066822067}, {"text": "equation of the form N=Nge\", where Ny and k are constants and f is measured", "x0": 0.16703296703296702, "y0": 0.22144522144522144, "x1": 0.8087912087912088, "y1": 0.23931623931623933}, {"text": "in years from November 1923.", "x0": 0.16703296703296702, "y0": 0.24475524475524477, "x1": 0.4142857142857143, "y1": 0.257964257964258}, {"text": "Find the values of and k, and predict the number of koalas that will be present", "x0": 0.16703296703296702, "y0": 0.27816627816627815, "x1": 0.8087912087912088, "y1": 0.2913752913752914}, {"text": "on Kangaroo Island in November 2001.", "x0": 0.16703296703296702, "y0": 0.29448329448329447, "x1": 0.4868131868131868, "y1": 0.3076923076923077}, {"text": "Five candidates, A, B, C, D and E, are standing for an election. Their names are", "x0": 0.16703296703296702, "y0": 0.3613053613053613, "x1": 0.8087912087912088, "y1": 0.3745143745143745}, {"text": "(b)", "x0": 0.11978021978021978, "y0": 0.3620823620823621, "x1": 0.14175824175824175, "y1": 0.372960372960373}, {"text": "written on pieces of cardboard that are placed in a barrel and are drawn out", "x0": 0.16703296703296702, "y0": 0.3776223776223776, "x1": 0.8087912087912088, "y1": 0.39083139083139085}, {"text": "randomly to determine their positions on the ballot paper.", "x0": 0.16703296703296702, "y0": 0.3947163947163947, "x1": 0.6318681318681318, "y1": 0.40792540792540793}, {"text": "(i) What is the probability that A is drawn first? 1", "x0": 0.18681318681318682, "y0": 0.4281274281274281, "x1": 0.8791208791208791, "y1": 0.44133644133644134}, {"text": "(ii) What is the probability that the order of the names on the ballot paper is 2", "x0": 0.1813186813186813, "y0": 0.46153846153846156, "x1": 0.8802197802197802, "y1": 0.47474747474747475}, {"text": "that shown below?", "x0": 0.22747252747252747, "y0": 0.47863247863247865, "x1": 0.3769230769230769, "y1": 0.48795648795648794}, {"text": "[5] [>", "x0": 0.4824175824175824, "y0": 0.515928515928516, "x1": 0.5175824175824176, "y1": 0.6130536130536131}, {"text": "Question 8 continues on page 11", "x0": 0.36153846153846153, "y0": 0.6961926961926962, "x1": 0.6373626373626373, "y1": 0.7094017094017094}, {"text": "\u201410-", "x0": 0.4736263736263736, "y0": 0.9425019425019425, "x1": 0.5252747252747253, "y1": 0.9518259518259519}], [{"text": "Marks", "x0": 0.8241758241758241, "y0": 0.08391608391608392, "x1": 0.8802197802197802, "y1": 0.09401709401709402}, {"text": "Question 8 (continued)", "x0": 0.11978021978021978, "y0": 0.10101010101010101, "x1": 0.30439560439560437, "y1": 0.11344211344211344}, {"text": "(c) Ya", "x0": 0.11978021978021978, "y0": 0.15151515151515152, "x1": 0.3505494505494505, "y1": 0.16705516705516704}, {"text": "The diagram shows a ten-centimetre high glass that is being filled with water at", "x0": 0.16703296703296702, "y0": 0.44366744366744365, "x1": 0.8087912087912088, "y1": 0.4568764568764569}, {"text": "a constant rate (by volume). Let y= be the depth of water in the glass as a", "x0": 0.16703296703296702, "y0": 0.45998445998445997, "x1": 0.8087912087912088, "y1": 0.4731934731934732}, {"text": "function of time t.", "x0": 0.16703296703296702, "y0": 0.47707847707847706, "x1": 0.3120879120879121, "y1": 0.48717948717948717}, {"text": "(i) Find the approximate depth y, at which is a maximum. 2", "x0": 0.18681318681318682, "y0": 0.519036519036519, "x1": 0.8802197802197802, "y1": 0.5345765345765345}, {"text": "Find the approximate depth y, at which 2 is a minimum.", "x0": 0.22637362637362637, "y0": 0.5625485625485626, "x1": 0.7021978021978021, "y1": 0.5920745920745921}, {"text": "It", "x0": 0.5692307692307692, "y0": 0.5843045843045843, "x1": 0.5747252747252747, "y1": 0.5920745920745921}, {"text": "(ii) Assume that the glass takes 5 seconds to fill. 2", "x0": 0.1813186813186813, "y0": 0.6285936285936286, "x1": 0.8802197802197802, "y1": 0.6418026418026418}, {"text": "Graph (t) and identify any points on your graph where the", "x0": 0.22637362637362637, "y0": 0.6588966588966589, "x1": 0.8087912087912088, "y1": 0.6783216783216783}, {"text": "concavity changes.", "x0": 0.22637362637362637, "y0": 0.679098679098679, "x1": 0.378021978021978, "y1": 0.6923076923076923}, {"text": "End of Question 8", "x0": 0.421978021978022, "y0": 0.745920745920746, "x1": 0.5769230769230769, "y1": 0.7583527583527584}], [{"text": "Marks", "x0": 0.8241758241758241, "y0": 0.08391608391608392, "x1": 0.8802197802197802, "y1": 0.09401709401709402}, {"text": "Question 9 (12 marks) Use a SEPARATE writing booklet.", "x0": 0.11978021978021978, "y0": 0.10101010101010101, "x1": 0.5934065934065934, "y1": 0.11421911421911422}, {"text": "(a) A", "x0": 0.11978021978021978, "y0": 0.15151515151515152, "x1": 0.43736263736263736, "y1": 0.16394716394716394}, {"text": "NOT TO", "x0": 0.5527472527472528, "y0": 0.18337218337218336, "x1": 0.6230769230769231, "y1": 0.1926961926961927}, {"text": "SCALE", "x0": 0.5527472527472528, "y0": 0.20046620046620048, "x1": 0.6153846153846154, "y1": 0.2097902097902098}, {"text": "3a", "x0": 0.7373626373626374, "y0": 0.31002331002331, "x1": 0.7582417582417582, "y1": 0.3201243201243201}, {"text": "In the diagram, ABC is an isosceles triangle where and", "x0": 0.16703296703296702, "y0": 0.3201243201243201, "x1": 0.8087912087912088, "y1": 0.33255633255633255}, {"text": "AB=AC=lI. The point D is chosen on BC such that CD", "x0": 0.16593406593406593, "y0": 0.34265734265734266, "x1": 0.6175824175824176, "y1": 0.35586635586635584}, {"text": "Let BC=x, and let ZABC= 6, and note that :", "x0": 0.16703296703296702, "y0": 0.3861693861693862, "x1": 0.6010989010989011, "y1": 0.3978243978243978}, {"text": "(i) Show that ZADC=26 and hence show that triangles DBA and ABC are 3", "x0": 0.18681318681318682, "y0": 0.4281274281274281, "x1": 0.8802197802197802, "y1": 0.44133644133644134}, {"text": "similar.", "x0": 0.22747252747252747, "y0": 0.4444444444444444, "x1": 0.2846153846153846, "y1": 0.45454545454545453}, {"text": "(ii) From part (i) deduce that x7 =0. 1", "x0": 0.1813186813186813, "y0": 0.4755244755244755, "x1": 0.8791208791208791, "y1": 0.49106449106449107}, {"text": "(iii) By using the cosine rule, deduce that 2", "x0": 0.17582417582417584, "y0": 0.5120435120435121, "x1": 0.8802197802197802, "y1": 0.5252525252525253}, {"text": "5 4\u00b0", "x0": 0.4703296703296703, "y0": 0.5656565656565656, "x1": 0.567032967032967, "y1": 0.5788655788655789}, {"text": "(b) When a valve is released, a chemical flows into a large tank that is initially", "x0": 0.11978021978021978, "y0": 0.634032634032634, "x1": 0.8076923076923077, "y1": 0.6542346542346542}, {"text": "empty. The volume, V litres, of chemical in the tank increases at the rate", "x0": 0.16703296703296702, "y0": 0.6503496503496503, "x1": 0.7538461538461538, "y1": 0.6705516705516705}, {"text": "dv", "x0": 0.4318681318681319, "y0": 0.6814296814296814, "x1": 0.45494505494505494, "y1": 0.6915306915306916}, {"text": "\u2014=2e!", "x0": 0.42967032967032964, "y0": 0.6915306915306916, "x1": 0.4868131868131868, "y1": 0.7008547008547008}, {"text": "ae", "x0": 0.4351648351648352, "y0": 0.7008547008547008, "x1": 0.45054945054945056, "y1": 0.710955710955711}, {"text": "where f is measured in hours from the time the valve is released.", "x0": 0.16703296703296702, "y0": 0.7327117327117327, "x1": 0.689010989010989, "y1": 0.7428127428127428}, {"text": "(i) At what rate does the chemical initially enter the tank? 1", "x0": 0.18681318681318682, "y0": 0.763014763014763, "x1": 0.8791208791208791, "y1": 0.7762237762237763}, {"text": "(ii) Use integration to find an expression for V in terms of t. 2", "x0": 0.1813186813186813, "y0": 0.7956487956487956, "x1": 0.8802197802197802, "y1": 0.8088578088578089}, {"text": "(iii) Show that when V=3. 1", "x0": 0.17582417582417584, "y0": 0.8290598290598291, "x1": 0.8791208791208791, "y1": 0.8414918414918415}, {"text": "(iv) Find \u00a2, to the nearest minute, when V=3. 2", "x0": 0.17692307692307693, "y0": 0.8632478632478633, "x1": 0.8802197802197802, "y1": 0.8756798756798757}], [{"text": "Marks", "x0": 0.8241758241758241, "y0": 0.08391608391608392, "x1": 0.8802197802197802, "y1": 0.09401709401709402}, {"text": "Question 10 (12 marks) Use a SEPARATE writing booklet.", "x0": 0.11978021978021978, "y0": 0.10101010101010101, "x1": 0.6032967032967033, "y1": 0.11421911421911422}, {"text": "Helen sets up a prize fund with a single investment of $1000 to provide her", "x0": 0.16703296703296702, "y0": 0.15073815073815075, "x1": 0.8087912087912088, "y1": 0.16394716394716394}, {"text": "(a)", "x0": 0.11978021978021978, "y0": 0.15151515151515152, "x1": 0.14065934065934066, "y1": 0.1623931623931624}, {"text": "school with an annual prize valued at $72. The fund accrues interest at a rate of", "x0": 0.16703296703296702, "y0": 0.16783216783216784, "x1": 0.8098901098901099, "y1": 0.18104118104118105}, {"text": "6% per annum, compounded annually. The first prize is awarded one year after", "x0": 0.16703296703296702, "y0": 0.18414918414918416, "x1": 0.8087912087912088, "y1": 0.19735819735819735}, {"text": "the investment is set up.", "x0": 0.16703296703296702, "y0": 0.20046620046620048, "x1": 0.36043956043956044, "y1": 0.21367521367521367}, {"text": "(i) Calculate the balance in the fund at the beginning of the second year.", "x0": 0.18681318681318682, "y0": 0.2338772338772339, "x1": 0.7857142857142857, "y1": 0.24708624708624707}, {"text": "(ii) Let $B, be the balance in the fund at the end of 7 years (and after", "x0": 0.1813186813186813, "y0": 0.2602952602952603, "x1": 0.8087912087912088, "y1": 0.2851592851592852}, {"text": "the nth prize has been awarded). Show that B,= 1200~200 x (1.06)\".", "x0": 0.22747252747252747, "y0": 0.2836052836052836, "x1": 0.7901098901098901, "y1": 0.2975912975912976}, {"text": "(iii) At the end of the tenth year (and after the tenth prize has been awarded)", "x0": 0.17582417582417584, "y0": 0.3177933177933178, "x1": 0.8076923076923077, "y1": 0.331002331002331}, {"text": "it is decided to increase the prize value to $90.", "x0": 0.22747252747252747, "y0": 0.3341103341103341, "x1": 0.6021978021978022, "y1": 0.3473193473193473}, {"text": "For how many more years can the prize fund be used to award the prize?", "x0": 0.22637362637362637, "y0": 0.36752136752136755, "x1": 0.8087912087912088, "y1": 0.38073038073038074}, {"text": "(b)", "x0": 0.11978021978021978, "y0": 0.43512043512043513, "x1": 0.14175824175824175, "y1": 0.445998445998446}, {"text": "Farmhouse", "x0": 0.5681318681318681, "y0": 0.439005439005439, "x1": 0.656043956043956, "y1": 0.4483294483294483}, {"text": "Claire\u2019s", "x0": 0.6802197802197802, "y0": 0.46076146076146074, "x1": 0.7417582417582418, "y1": 0.47086247086247085}, {"text": "path", "x0": 0.6945054945054945, "y0": 0.47863247863247865, "x1": 0.7274725274725274, "y1": 0.49106449106449107}, {"text": "NoT TO", "x0": 0.7241758241758242, "y0": 0.5236985236985237, "x1": 0.7945054945054945, "y1": 0.533022533022533}, {"text": "SCALE", "x0": 0.7285714285714285, "y0": 0.5407925407925408, "x1": 0.7912087912087912, "y1": 0.5501165501165501}, {"text": "Bus depot", "x0": 0.18681318681318682, "y0": 0.5586635586635587, "x1": 0.26593406593406593, "y1": 0.567987567987568}, {"text": "pe -", "x0": 0.16813186813186815, "y0": 0.5617715617715617, "x1": 0.7912087912087912, "y1": 0.5804195804195804}, {"text": "+ 2000 m", "x0": 0.1901098901098901, "y0": 0.5835275835275835, "x1": 0.41318681318681316, "y1": 0.5975135975135976}, {"text": "The diagram shows a farmhouse F that is located 250 m from a straight section", "x0": 0.16703296703296702, "y0": 0.6208236208236209, "x1": 0.8087912087912088, "y1": 0.6402486402486403}, {"text": "of road. The road begins at the bus depot D, which is situated 2000 m from the", "x0": 0.16703296703296702, "y0": 0.6379176379176379, "x1": 0.8087912087912088, "y1": 0.6581196581196581}, {"text": "front gate G of the farmhouse. The school bus leaves the depot at 8 am and", "x0": 0.16813186813186815, "y0": 0.6573426573426573, "x1": 0.8087912087912088, "y1": 0.6705516705516705}, {"text": "travels along the road at a speed of 15 Claire lives in the farmhouse, and", "x0": 0.16703296703296702, "y0": 0.6744366744366744, "x1": 0.8087912087912088, "y1": 0.6876456876456877}, {"text": "she can run across the open paddock between the house and the road at a speed", "x0": 0.16703296703296702, "y0": 0.6907536907536908, "x1": 0.8087912087912088, "y1": 0.703962703962704}, {"text": "of 4ms\"!. The bus will stop for Claire anywhere on the road, but will not wait", "x0": 0.16703296703296702, "y0": 0.7047397047397047, "x1": 0.8087912087912088, "y1": 0.721056721056721}, {"text": "for her.", "x0": 0.16813186813186815, "y0": 0.7241647241647242, "x1": 0.22417582417582418, "y1": 0.7342657342657343}, {"text": "Assume that Claire catches the bus at the point P on the road where ZGFP = 0.", "x0": 0.16703296703296702, "y0": 0.7544677544677545, "x1": 0.8076923076923077, "y1": 0.7738927738927739}, {"text": "(i) Find two expressions in terms of 6, one expression for the time taken for", "x0": 0.18681318681318682, "y0": 0.790986790986791, "x1": 0.8087912087912088, "y1": 0.8041958041958042}, {"text": "the bus to travel from D to P and the other expression for the time taken", "x0": 0.22747252747252747, "y0": 0.804972804972805, "x1": 0.8087912087912088, "y1": 0.8243978243978244}, {"text": "by Claire to run from F to P.", "x0": 0.22637362637362637, "y0": 0.8251748251748252, "x1": 0.4593406593406593, "y1": 0.8383838383838383}, {"text": "(ii) What is the latest time that Claire can leave home in order to catch the bus?", "x0": 0.181318