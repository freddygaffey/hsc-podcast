[[{"text": "Barker College", "x0": 0.09340659340659341, "y0": 0.1743190661478599, "x1": 0.310989010989011, "y1": 0.19221789883268484}, {"text": "2001", "x0": 0.4340659340659341, "y0": 0.20233463035019456, "x1": 0.554945054945055, "y1": 0.2272373540856031}, {"text": "TRIAL", "x0": 0.45384615384615384, "y0": 0.23813229571984434, "x1": 0.5439560439560439, "y1": 0.25214007782101167}, {"text": "HIGHER SCHOOL", "x0": 0.3747252747252747, "y0": 0.2614785992217899, "x1": 0.6252747252747253, "y1": 0.27626459143968873}, {"text": "CERTIFICATE", "x0": 0.4, "y0": 0.2848249027237354, "x1": 0.5978021978021978, "y1": 0.29961089494163423}, {"text": "Physics", "x0": 0.07362637362637363, "y0": 0.3416342412451362, "x1": 0.4098901098901099, "y1": 0.3968871595330739}, {"text": "General Instructions", "x0": 0.06813186813186813, "y0": 0.41089494163424123, "x1": 0.2813186813186813, "y1": 0.421011673151751}, {"text": "Part A Pages 2 6", "x0": 0.5593406593406594, "y0": 0.43891050583657587, "x1": 0.778021978021978, "y1": 0.45136186770428016}, {"text": "Total marks (15)", "x0": 0.5582417582417583, "y0": 0.45525291828793774, "x1": 0.7329670329670329, "y1": 0.4669260700389105}, {"text": "* Reading time \u20145 minutes", "x0": 0.12637362637362637, "y0": 0.45603112840466925, "x1": 0.4197802197802198, "y1": 0.46848249027237354}, {"text": "* Attempt Questions 1 15", "x0": 0.5582417582417583, "y0": 0.4715953307392996, "x1": 0.8384615384615385, "y1": 0.4840466926070039}, {"text": "* Allow about 25 minutes for this", "x0": 0.5582417582417583, "y0": 0.48793774319066147, "x1": 0.9153846153846154, "y1": 0.4972762645914397}, {"text": "Working time 3 hours", "x0": 0.15604395604395604, "y0": 0.488715953307393, "x1": 0.38461538461538464, "y1": 0.5011673151750973}, {"text": "part", "x0": 0.589010989010989, "y0": 0.5050583657587548, "x1": 0.6296703296703297, "y1": 0.5167315175097277}, {"text": "Write using blue or black pen", "x0": 0.15604395604395604, "y0": 0.5214007782101168, "x1": 0.4593406593406593, "y1": 0.5