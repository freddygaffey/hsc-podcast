[[{"text": "GOVERNMENT", "x0": 0.12197802197802197, "y0": 0.1592851592851593, "x1": 0.22527472527472528, "y1": 0.16705516705516704}, {"text": "NSW Education Standards Authority", "x0": 0.11978021978021978, "y0": 0.19114219114219114, "x1": 0.4725274725274725, "y1": 0.20512820512820512}, {"text": "2025 | HIGHER SCHOOL CERTIFICATE EXAMINATION", "x0": 0.12747252747252746, "y0": 0.30691530691530694, "x1": 0.5868131868131868, "y1": 0.331002331002331}, {"text": "English Extension 1", "x0": 0.12307692307692308, "y0": 0.351981351981352, "x1": 0.5813186813186814, "y1": 0.38694638694638694}, {"text": "General + Reading time - 10 minutes", "x0": 0.11978021978021978, "y0": 0.4289044289044289, "x1": 0.5241758241758242, "y1": 0.4483294483294483}, {"text": "Instructions \u2014- Working time \u2014 2 hours", "x0": 0.11978021978021978, "y0": 0.44988344988344986, "x1": 0.49230769230769234, "y1": 0.4662004662004662}, {"text": "+ Write using black pen", "x0": 0.2681318681318681, "y0": 0.473970473970474, "x1": 0.47802197802197804, "y1": 0.48717948717948717}, {"text": "Total marks: Section | - 25 marks (pages 2-3)", "x0": 0.11868131868131868, "y0": 0.5283605283605284, "x1": 0.5714285714285714, "y1": 0.5415695415695416}, {"text": "50 + Attempt Question 1", "x0": 0.11868131868131868, "y0": 0.5454545454545454, "x1": 0.45604395604395603, "y1": 0.5656565656565656}, {"text": "+ Allow about 1 hour for this section", "x0": 0.2681318681318681, "y0": 0.5734265734265734, "x1": 0.5934065934065934, "y1": 0.5835275835275835}, {"text": "Section II - 25 marks (pages 4-9)", "x0": 0.26703296703296703, "y0": 0.6068376068376068, "x1": 0.578021978021978, "y1": 0.62004662004662}, {"text": "+ Attempt Question 2", "x0": 0.2681318681318681, "y0": 0.6309246309246309, "x1": 0.4582417582417582, "y1": 0.6441336441336442}, {"text": "+ Allow about 1 hour for this section", "x0": 0.2681318681318681, "y0": 0.6526806526806527, "x1": 0.5934065934065934, "y1": 0.6627816627816627}, {"text": "2270", "x0": 0.08131868131868132, "y0": 0.9463869463869464, "x1": 0.11758241758241758, "y1": 0.9549339549339549}], [{"text": "Section I \u2014 Common Module: Literary Worlds", "x0": 0.11978021978021978, "y0": 0.08158508158508158, "x1": 0.6, "y1": 0.09634809634809635}, {"text": "25 marks", "x0": 0.11868131868131868, "y0": 0.11655011655011654, "x1": 0.1989010989010989, "y1": 0.12665112665112666}, {"text": "Attempt Question 1", "x0": 0.11978021978021978, "y0": 0.13286713286713286, "x1": 0.2868131868131868, "y1": 0.14607614607614608}, {"text": "Allow about 1 hour for this section", "x0": 0.11978021978021978, "y0": 0.14996114996114995, "x1": 0.4186813186813187, "y1": 0.16006216006216006}, {"text": "Answer the question on pages 2\u201412 of the English Extension 1 Writing Booklet. Extra writing", "x0": 0.11978021978021978, "y0": 0.18337218337218336, "x1": 0.8791208791208791, "y1": 0.19658119658119658}, {"text": "booklets are available.", "x0": 0.11868131868131868, "y0": 0.19968919968919968, "x1": 0.3, "y1": 0.2097902097902098}, {"text": "Your answer will be assessed on how well you:", "x0": 0.14395604395604394, "y0": 0.22999222999222999, "x1": 0.5274725274725275, "y1": 0.2432012432012432}, {"text": "\u00a9 demonstrate an understanding of the ideas and values of Literary Worlds and how they", "x0": 0.14285714285714285, "y0": 0.2501942501942502, "x1": 0.8549450549450549, "y1": 0.2634032634032634}, {"text": "are shaped and reflected in texts", "x0": 0.16703296703296702, "y0": 0.2665112665112665, "x1": 0.42747252747252745, "y1": 0.27972027972027974}, {"text": "\u00a9 craft a sustained composition appropriate to the question, demonstrating control of the", "x0": 0.14285714285714285, "y0": 0.2867132867132867, "x1": 0.856043956043956, "y1": 0.2999222999222999}, {"text": "use of language", "x0": 0.16703296703296702, "y0": 0.30303030303030304, "x1": 0.2934065934065934, "y1": 0.3162393162393162}, {"text": "Question 1 (25 marks)", "x0": 0.11978021978021978, "y0": 0.34887334887334887, "x1": 0.30439560439560437, "y1": 0.3613053613053613}, {"text": "Read Text | on page 3.", "x0": 0.11978021978021978, "y0": 0.38306138306138304, "x1": 0.3076923076923077, "y1": 0.3954933954933955}, {"text": "Compose a discursive response in which you extend the ideas in Text 1.", "x0": 0.11868131868131868, "y0": 0.4156954156954157, "x1": 0.7043956043956044, "y1": 0.4289044289044289}, {"text": "In your response, articulate your insights into how texts make meaning through the crafting of", "x0": 0.11978021978021978, "y0": 0.4491064491064491, "x1": 0.8813186813186813, "y1": 0.46231546231546233}, {"text": "literary worlds.", "x0": 0.11978021978021978, "y0": 0.4654234654234654, "x1": 0.24175824175824176, "y1": 0.47863247863247865}, {"text": "Question 1 continues on page 3", "x0": 0.3659340659340659, "y0": 0.5322455322455323, "x1": 0.6329670329670329, "y1": 0.5454545454545454}], [{"text": "Question 1 (continued)", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.30439560439560437, "y1": 0.09401709401709402}, {"text": "Text 1", "x0": 0.11868131868131868, "y0": 0.11499611499611499, "x1": 0.17252747252747253, "y1": 0.1250971250971251}, {"text": "For me, all fiction is about prizing the logic of metaphors which is the logic of narratives", "x0": 0.13406593406593406, "y0": 0.14763014763014762, "x1": 0.8648351648351649, "y1": 0.16083916083916083}, {"text": "in general ~ over reality, which is irreducibly random and senseless.", "x0": 0.13516483516483516, "y0": 0.16394716394716394, "x1": 0.6868131868131868, "y1": 0.17715617715617715}, {"text": "We spend our entire lives trying to tell stories about ourselves \u2014 the essence of", "x0": 0.13406593406593406, "y0": 0.1926961926961927, "x1": 0.865934065934066, "y1": 0.20590520590520592}, {"text": "memory. It is how we make living in this unfeeling, accidental universe tolerable. That we", "x0": 0.13406593406593406, "y0": 0.20901320901320902, "x1": 0.8648351648351649, "y1": 0.2222222222222222}, {"text": "call such a tendency \u201cthe narrative fallacy\u201d doesn\u2019t mean it doesn\u2019t also touch upon some", "x0": 0.13406593406593406, "y0": 0.2261072261072261, "x1": 0.8648351648351649, "y1": 0.23931623931623933}, {"text": "aspect of the truth.", "x0": 0.13406593406593406, "y0": 0.24242424242424243, "x1": 0.2846153846153846, "y1": 0.2556332556332556}, {"text": "Some stories simply literalise their metaphors a bit more explicitly.", "x0": 0.13516483516483516, "y0": 0.27117327117327117, "x1": 0.6791208791208792, "y1": 0.28438228438228436}, {"text": "a translator, and translation offers a natural metaphor for how I think about writing", "x0": 0.20549450549450549, "y0": 0.2999222999222999, "x1": 0.8648351648351649, "y1": 0.31313131313131315}, {"text": "in general.", "x0": 0.13516483516483516, "y0": 0.317016317016317, "x1": 0.21868131868131868, "y1": 0.32944832944832947}, {"text": "Every act of communication is a miracle of translation.", "x0": 0.13406593406593406, "y0": 0.34498834498834496, "x1": 0.5813186813186814, "y1": 0.3581973581973582}, {"text": "At this moment, in this place, the shifting action potentials in my neurons cascade into", "x0": 0.13406593406593406, "y0": 0.372960372960373, "x1": 0.8648351648351649, "y1": 0.3861693861693862}, {"text": "certain arrangements, patterns, thoughts; they flow down my spine, branch into my arms,", "x0": 0.13406593406593406, "y0": 0.3900543900543901, "x1": 0.8648351648351649, "y1": 0.40326340326340326}, {"text": "my fingers, until muscles twitch and thought is translated into motion; mechanical levers", "x0": 0.13406593406593406, "y0": 0.4063714063714064, "x1": 0.8648351648351649, "y1": 0.4195804195804196}, {"text": "are pressed; electrons are rearranged; marks are made on paper.", "x0": 0.13406593406593406, "y0": 0.4234654234654235, "x1": 0.6505494505494506, "y1": 0.4366744366744367}, {"text": "Atanother time, in another place, light strikes the marks, reflects into a pair of high-precision", "x0": 0.13406593406593406, "y0": 0.4483294483294483, "x1": 0.8648351648351649, "y1": 0.46853146853146854}, {"text": "optical instruments sculpted by nature after billions of years of random mutations; upside-", "x0": 0.13406593406593406, "y0": 0.46853146853146854, "x1": 0.8637362637362638, "y1": 0.48174048174048173}, {"text": "down images are formed against two screens made up of millions of light-sensitive cells,", "x0": 0.13406593406593406, "y0": 0.48484848484848486, "x1": 0.8648351648351649, "y1": 0.49805749805749805}, {"text": "which translate light into electrical pulses that go up the optic nerves, cross the chiasm!!),", "x0": 0.13516483516483516, "y0": 0.4988344988344988, "x1": 0.8648351648351649, "y1": 0.5151515151515151}, {"text": "down the optic tracts, and into the visual cortex, where the pulses are reassembled into", "x0": 0.13406593406593406, "y0": 0.5182595182595182, "x1": 0.8648351648351649, "y1": 0.5314685314685315}, {"text": "letters, punctuation marks, words, sentences . .. thoughts.", "x0": 0.13516483516483516, "y0": 0.5314685314685315, "x1": 0.5934065934065934, "y1": 0.5516705516705517}, {"text": "The entire system seems fragile, preposterous, science fictional.", "x0": 0.13406593406593406, "y0": 0.5633255633255633, "x1": 0.6516483516483517, "y1": 0.5765345765345765}, {"text": "Who can say if the thoughts you have in your mind as you read these words are the same", "x0": 0.13406593406593406, "y0": 0.5920745920745921, "x1": 0.8648351648351649, "y1": 0.6052836052836053}, {"text": "thoughts I had in my mind as I typed them? We are different, you and I, and the qualia of", "x0": 0.13406593406593406, "y0": 0.6083916083916084, "x1": 0.865934065934066, "y1": 0.6216006216006216}, {"text": "our consciousnesses'\u201d! are as divergent as two stars at the ends of the universe.", "x0": 0.13406593406593406, "y0": 0.6223776223776224, "x1": 0.7725274725274726, "y1": 0.6386946386946387}, {"text": "And yet, whatever has been lost in translation in the long journey of my thoughts through", "x0": 0.13406593406593406, "y0": 0.6534576534576535, "x1": 0.8637362637362638, "y1": 0.6666666666666666}, {"text": "the maze of civilisation to your mind, I think you do understand me, and you think you do", "x0": 0.13406593406593406, "y0": 0.6705516705516705, "x1": 0.8648351648351649, "y1": 0.6837606837606838}, {"text": "understand me. Our minds managed to touch, if but briefly and imperfectly.", "x0": 0.13516483516483516, "y0": 0.6868686868686869, "x1": 0.7494505494505495, "y1": 0.7000777000777001}, {"text": "Does the thought not make the universe seem just a bit kinder, a bit brighter, a bit warmer", "x0": 0.13406593406593406, "y0": 0.7156177156177156, "x1": 0.8648351648351649, "y1": 0.7288267288267288}, {"text": "and more human?", "x0": 0.13406593406593406, "y0": 0.7327117327117327, "x1": 0.27912087912087913, "y1": 0.7420357420357421}, {"text": "We live for such miracles.", "x0": 0.13406593406593406, "y0": 0.7606837606837606, "x1": 0.34725274725274724, "y1": 0.7707847707847708}, {"text": "Ken Lu", "x0": 0.7978021978021979, "y0": 0.7894327894327894, "x1": 0.8637362637362638, "y1": 0.7987567987567987}, {"text": "Extract from The Paper Menagerie and Other Stories", "x0": 0.42967032967032964, "y0": 0.8057498057498057, "x1": 0.8648351648351649, "y1": 0.818958818958819}, {"text": "1 chiasm intersection of pathways in the eye Reproduced by permission of Ken Liu, author", "x0": 0.11978021978021978, "y0": 0.8368298368298368, "x1": 0.8648351648351649, "y1": 0.8492618492618492}, {"text": "\u2018And the author's agents", "x0": 0.7230769230769231, "y0": 0.8492618492618492, "x1": 0.8648351648351649, "y1": 0.8585858585858586}, {"text": "1 qualia of our subjectivity of our thoughts Scovil Galen Ghosh Literary Agency, Ine", "x0": 0.11978021978021978, "y0": 0.8578088578088578, "x1": 0.8648351648351649, "y1": 0.8694638694638694}, {"text": "consciousnesses", "x0": 0.13846153846153847, "y0": 0.8756798756798757, "x1": 0.24615384615384617, "y1": 0.8811188811188811}, {"text": "End of Question 1", "x0": 0.421978021978022, "y0": 0.9052059052059052, "x1": 0.5758241758241758, "y1": 0.9176379176379177}], [{"text": "Section II \u2014 Electives", "x0": 0.11978021978021978, "y0": 0.08158508158508158, "x1": 0.34175824175824177, "y1": 0.09324009324009325}, {"text": "25 marks", "x0": 0.11868131868131868, "y0": 0.11421911421911422, "x1": 0.1989010989010989, "y1": 0.12432012432012432}, {"text": "Attempt Question 2", "x0": 0.11868131868131868, "y0": 0.13053613053613053, "x1": 0.2879120879120879, "y1": 0.14374514374514374}, {"text": "Allow about 1 hour for this section", "x0": 0.11868131868131868, "y0": 0.14763014763014762, "x1": 0.4186813186813187, "y1": 0.15773115773115773}, {"text": "Answer the question on pages 14-24 of the English Extension | Writing Booklet. Extra writing", "x0": 0.11978021978021978, "y0": 0.17871017871017872, "x1": 0.8802197802197802, "y1": 0.1919191919191919}, {"text": "booklets are available.", "x0": 0.11868131868131868, "y0": 0.19502719502719504, "x1": 0.3, "y1": 0.20512820512820512}, {"text": "Your answer will be assessed on how well you:", "x0": 0.14395604395604394, "y0": 0.22377622377622378, "x1": 0.5274725274725275, "y1": 0.236985236985237}, {"text": "demonstrate an understanding of the ideas and values of Literary Worlds and how they", "x0": 0.14285714285714285, "y0": 0.2432012432012432, "x1": 0.8549450549450549, "y1": 0.2564102564102564}, {"text": "are shaped and reflected in texts", "x0": 0.16703296703296702, "y0": 0.2602952602952603, "x1": 0.42747252747252745, "y1": 0.27350427350427353}, {"text": "\u00a9 craft a sustained composition appropriate to the question, demonstrating control of the", "x0": 0.14285714285714285, "y0": 0.2804972804972805, "x1": 0.856043956043956, "y1": 0.2937062937062937}, {"text": "use of language", "x0": 0.16703296703296702, "y0": 0.29681429681429683, "x1": 0.2934065934065934, "y1": 0.31002331002331}, {"text": "Question 2 (25 marks)", "x0": 0.11978021978021978, "y0": 0.3317793317793318, "x1": 0.30439560439560437, "y1": 0.3442113442113442}, {"text": "Read Text 2.", "x0": 0.11978021978021978, "y0": 0.3628593628593629, "x1": 0.2230769230769231, "y1": 0.37218337218337216}, {"text": "How does Text 2 shape your understanding of the ways your texts \u2018creatively break\u2019 dominant", "x0": 0.11978021978021978, "y0": 0.3916083916083916, "x1": 0.8802197802197802, "y1": 0.4048174048174048}, {"text": "assumptions in the elective you have studied?", "x0": 0.11978021978021978, "y0": 0.4087024087024087, "x1": 0.489010989010989, "y1": 0.4219114219114219}, {"text": "In your response, make close reference to TWO prescribed texts from your elective and ONE", "x0": 0.11978021978021978, "y0": 0.439005439005439, "x1": 0.8802197802197802, "y1": 0.4522144522144522}, {"text": "other text of your own choosing.", "x0": 0.11868131868131868, "y0": 0.4553224553224553, "x1": 0.38351648351648354, "y1": 0.46853146853146854}, {"text": "The prescribed texts for Section II are listed on pages 5-9.", "x0": 0.11868131868131868, "y0": 0.48562548562548563, "x1": 0.5956043956043956, "y1": 0.4988344988344988}, {"text": "Text 2", "x0": 0.11868131868131868, "y0": 0.519036519036519, "x1": 0.17252747252747253, "y1": 0.5291375291375291}, {"text": "Stories surround us like air; we breathe them in, we breathe them out. The art of being fully", "x0": 0.13516483516483516, "y0": 0.5493395493395493, "x1": 0.8637362637362638, "y1": 0.5625485625485626}, {"text": "conscious in personal life means seeing the stories and becoming their teller, rather than", "x0": 0.13406593406593406, "y0": 0.5656565656565656, "x1": 0.8648351648351649, "y1": 0.5788655788655789}, {"text": "letting them be the unseen forces that tell you what to do.", "x0": 0.13516483516483516, "y0": 0.5827505827505828, "x1": 0.6010989010989011, "y1": 0.5959595959595959}, {"text": "There are stories beneath the stories and around the stories. The recent event on the surface", "x0": 0.13406593406593406, "y0": 0.6394716394716394, "x1": 0.8648351648351649, "y1": 0.6495726495726496}, {"text": "is often merely the hood ornament on the mighty social engine that is a story driving the", "x0": 0.13516483516483516, "y0": 0.6557886557886557, "x1": 0.8648351648351649, "y1": 0.668997668997669}, {"text": "culture. We call those \u201cdominant narratives\u201d or \u201cparadigms\u201d or \u201cmemes\u201d!!! or \u201cmetaphors", "x0": 0.13406593406593406, "y0": 0.6697746697746698, "x1": 0.8637362637362638, "y1": 0.6860916860916861}, {"text": "we live by\u201d or \u201cframeworks\u201d. However we describe them, they are immensely powerful", "x0": 0.13516483516483516, "y0": 0.6891996891996892, "x1": 0.8637362637362638, "y1": 0.7024087024087025}, {"text": "forces. And the dominant culture mostly goes about reinforcing the stories that are the", "x0": 0.13516483516483516, "y0": 0.7062937062937062, "x1": 0.8648351648351649, "y1": 0.7195027195027195}, {"text": "pillars propping it up and that, too often, are also the bars of someone else\u2019s cage. They", "x0": 0.13406593406593406, "y0": 0.7226107226107226, "x1": 0.8637362637362638, "y1": 0.7358197358197358}, {"text": "are too often stories that should be broken, or are already broken and ruined and ruinous", "x0": 0.13406593406593406, "y0": 0.7397047397047397, "x1": 0.8648351648351649, "y1": 0.752913752913753}, {"text": "and way past their expiration date. They sit atop mountains of unexamined assumptions", "x0": 0.13406593406593406, "y0": 0.756021756021756, "x1": 0.8417582417582418, "y1": 0.7692307692307693}, {"text": "Part of the job of a great storyteller is to examine the stories that underlie the story... to", "x0": 0.13406593406593406, "y0": 0.7863247863247863, "x1": 0.8648351648351649, "y1": 0.7995337995337995}, {"text": "make them visible, and sometimes to break us free of them. Break the story. Breaking is a", "x0": 0.13406593406593406, "y0": 0.8026418026418026, "x1": 0.8648351648351649, "y1": 0.8158508158508159}, {"text": "creative act as much as making.", "x0": 0.13406593406593406, "y0": 0.8197358197358198, "x1": 0.3945054945054945, "y1": 0.8329448329448329}, {"text": "REBECCA SOLNIT", "x0": 0.7307692307692307, "y0": 0.846930846930847, "x1": 0.8648351648351649, "y1": 0.8562548562548562}, {"text": "Extract from Break the Story", "x0": 0.6307692307692307, "y0": 0.8624708624708625, "x1": 0.8648351648351649, "y1": 0.8733488733488733}, {"text": "ideas, behaviours or styles that are symbolic and easily transmitted", "x0": 0.22417582417582418, "y0": 0.8896658896658897, "x1": 0.6813186813186813, "y1": 0.9005439005439005}, {"text": "Cail Them by Their True Names: American Crises (and Essays) (specifically Break the Story)", "x0": 0.3241758241758242, "y0": 0.9090909090909091, "x1": 0.8802197802197802, "y1": 0.9184149184149184}, {"text": "by permission of Granta Books", "x0": 0.6978021978021978, "y0": 0.9199689199689199, "x1": 0.8802197802197802, "y1": 0.9292929292929293}], [{"text": "The prescribed texts for Section II are:", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.4307692307692308, "y1": 0.0947940947940948}, {"text": "+ Elective 1: Literary Homelands", "x0": 0.11978021978021978, "y0": 0.11499611499611499, "x1": 0.4142857142857143, "y1": 0.1282051282051282}, {"text": "The prescribed texts are:", "x0": 0.14285714285714285, "y0": 0.14840714840714841, "x1": 0.34065934065934067, "y1": 0.16161616161616163}, {"text": "Prose Fiction", "x0": 0.16703296703296702, "y0": 0.18181818181818182, "x1": 0.2802197802197802, "y1": 0.1919191919191919}, {"text": "Aravind Adiga, The White Tiger", "x0": 0.33406593406593404, "y0": 0.1825951825951826, "x1": 0.5967032967032967, "y1": 0.19502719502719504}, {"text": "EM Forster, A Passage to India", "x0": 0.33406593406593404, "y0": 0.20590520590520592, "x1": 0.5956043956043956, "y1": 0.21833721833721834}, {"text": "Colm Thin, Brooklyn", "x0": 0.33296703296703295, "y0": 0.22843822843822845, "x1": 0.5208791208791209, "y1": 0.24164724164724163}, {"text": "Poetry", "x0": 0.16703296703296702, "y0": 0.2618492618492618, "x1": 0.223076923076923