[[{"text": "BOARD OF sTUDIES", "x0": 0.2802197802197802, "y0": 0.09712509712509712, "x1": 0.43626373626373627, "y1": 0.10334110334110334}, {"text": "TEACHING &", "x0": 0.2802197802197802, "y0": 0.10722610722610723, "x1": 0.3769230769230769, "y1": 0.11266511266511267}, {"text": "BOSTES", "x0": 0.12087912087912088, "y0": 0.11421911421911422, "x1": 0.26373626373626374, "y1": 0.13364413364413363}, {"text": "EDUCATIONAL", "x0": 0.2802197802197802, "y0": 0.11732711732711733, "x1": 0.3923076923076923, "y1": 0.12276612276612277}, {"text": "STANDARDS NSW", "x0": 0.2802197802197802, "y0": 0.12742812742812742, "x1": 0.4153846153846154, "y1": 0.13286713286713286}, {"text": "20 l HIGHER SCHOOL CERTIFICATE", "x0": 0.11868131868131868, "y0": 0.1717171717171717, "x1": 0.43626373626373627, "y1": 0.19502719502719504}, {"text": "EXAMINATION", "x0": 0.22417582417582418, "y0": 0.1864801864801865, "x1": 0.3230769230769231, "y1": 0.19502719502719504}, {"text": "IMPORTANT:", "x0": 0.12307692307692308, "y0": 0.2222222222222222, "x1": 0.22087912087912087, "y1": 0.23076923076923078}, {"text": "This resource was developed to support a previous version of the syllabus.", "x0": 0.12197802197802197, "y0": 0.23853923853923853, "x1": 0.6758241758241759, "y1": 0.2494172494172494}, {"text": "It may contain content that differs from the current syllabus.", "x0": 0.12307692307692308, "y0": 0.2540792540792541, "x1": 0.5615384615384615, "y1": 0.26495726495726496}, {"text": "English (ESL)", "x0": 0.12417582417582418, "y0": 0.3177933177933178, "x1": 0.4747252747252747, "y1": 0.3644133644133644}, {"text": "Paper 1 \u2014 Language Study", "x0": 0.12197802197802197, "y0": 0.3954933954933955, "x1": 0.643956043956044, "y1": 0.42735042735042733}, {"text": "within an Area of Study", "x0": 0.34835164835164834, "y0": 0.43512043512043513, "x1": 0.8076923076923077, "y1": 0.4662004662004662}, {"text": "Total marks - 45", "x0": 0.4758241758241758, "y0": 0.5734265734265734, "x1": 0.621978021978022, "y1": 0.5835275835275835}, {"text": "(Section I) Pages 2-4", "x0": 0.4758241758241758, "y0": 0.6006216006216006, "x1": 0.6912087912087912, "y1": 0.6184926184926185}, {"text": "General Instructions 25 marks", "x0": 0.11978021978021978, "y0": 0.6324786324786325, "x1": 0.5560439560439561, "y1": 0.6441336441336442}, {"text": "* Reading time ~ 10 minutes + Attempt Question |", "x0": 0.11978021978021978, "y0": 0.6542346542346542, "x1": 0.643956043956044, "y1": 0.6682206682206682}, {"text": "* Working time ~ 14 hours + Allow about 50 minutes for this section", "x0": 0.11978021978021978, "y0": 0.6721056721056721, "x1": 0.8087912087912088, "y1": 0.6915306915306916}, {"text": "* Write using black pen (Seetion Pages 5-7", "x0": 0.11978021978021978, "y0": 0.6977466977466977, "x1": 0.6901098901098901, "y1": 0.7202797202797203}, {"text": "20 marks", "x0": 0.4758241758241758, "y0": 0.7334887334887334, "x1": 0.5560439560439561, "y1": 0.7435897435897436}, {"text": "+ Attempt Question 2", "x0": 0.4758241758241758, "y0": 0.756021756021756, "x1": 0.6461538461538462, "y1": 0.7684537684537684}, {"text": "+ Allow about 40 minutes for this section", "x0": 0.4758241758241758, "y0": 0.7762237762237763, "x1": 0.8087912087912088, "y1": 0.7863247863247863}, {"text": "2020", "x0": 0.08131868131868132, "y0": 0.9456099456099456, "x1": 0.11428571428571428, "y1": 0.9533799533799534}], [{"text": "Section I", "x0": 0.11868131868131868, "y0": 0.08236208236208237, "x1": 0.2076923076923077, "y1": 0.0947940947940948}, {"text": "25 marks", "x0": 0.11868131868131868, "y0": 0.11732711732711733, "x1": 0.1989010989010989, "y1": 0.1282051282051282}, {"text": "Attempt Question 1", "x0": 0.11868131868131868, "y0": 0.13364413364413363, "x1": 0.2879120879120879, "y1": 0.14685314685314685}, {"text": "Allow about 50 minutes for this section", "x0": 0.11868131868131868, "y0": 0.15073815073815075, "x1": 0.45604395604395603, "y1": 0.16083916083916083}, {"text": "Examine Texts 1, 2, and 3 carefully and then answer the questions in the Paper 1 Answer", "x0": 0.11868131868131868, "y0": 0.18337218337218336, "x1": 0.8802197802197802, "y1": 0.19658119658119658}, {"text": "Booklet.", "x0": 0.11868131868131868, "y0": 0.20046620046620048, "x1": 0.18571428571428572, "y1": 0.21056721056721056}, {"text": "Your answers will be assessed on how well you:", "x0": 0.14285714285714285, "y0": 0.23076923076923078, "x1": 0.5351648351648352, "y1": 0.24397824397824397}, {"text": "m= demonstrate understanding of the ways language shapes and expresses perceptions", "x0": 0.14285714285714285, "y0": 0.2501942501942502, "x1": 0.8362637362637363, "y1": 0.2634032634032634}, {"text": "Text 1 \u2014 Web advertisement", "x0": 0.11868131868131868, "y0": 0.3108003108003108, "x1": 0.37252747252747254, "y1": 0.32167832167832167}, {"text": "Heritage Travel - Discovering Your Roots", "x0": 0.15714285714285714, "y0": 0.3605283605283605, "x1": 0.521978021978022, "y1": 0.37373737373737376}], [{"text": "Text 2\u2014 Image", "x0": 0.05934065934065934, "y0": 0.06837606837606838, "x1": 0.1989010989010989, "y1": 0.08158508158508158}, {"text": "What Lies Beneath", "x0": 0.7626373626373626, "y0": 0.473970473970474, "x1": 0.9384615384615385, "y1": 0.4864024864024864}], [{"text": "Text 3 \u2014 Nonfiction extract", "x0": 0.11868131868131868, "y0": 0.05672105672105672, "x1": 0.36153846153846153, "y1": 0.06682206682206682}, {"text": "Helen Garner travelled as a tourist to the Antarctic by ship.", "x0": 0.11868131868131868, "y0": 0.09013209013209013, "x1": 0.6043956043956044, "y1": 0.10334110334110334}, {"text": "Out on deck the air is gaspingly cold but the evening sky is pretty, the water a steely, inky", "x0": 0.11978021978021978, "y0": 0.11577311577311578, "x1": 0.8791208791208791, "y1": 0.128982128982129}, {"text": "grey-blue. Suddenly there\u2019s a moon, riding tranquil between layers of bright cloud. Leaning", "x0": 0.11978021978021978, "y0": 0.1320901320901321, "x1": 0.8791208791208791, "y1": 0.1452991452991453}, {"text": "over the rail I see my first tiny chunk of ice go bobbing past, very close to the ship\u2019s side. At", "x0": 0.11868131868131868, "y0": 0.14840714840714841, "x1": 0.8791208791208791, "y1": 0.16161616161616163}, {"text": "once I\u2019m seized by an urge to compare it with something \u2014 with anything: it\u2019s the size of a", "x0": 0.11868131868131868, "y0": 0.1623931623931624, "x1": 0.8835164835164835, "y1": 0.18181818181818182}, {"text": "loosely flexed hand, palm up; like a Disney coronet\u201d with knobbed points; as hollow as a rotten", "x0": 0.11978021978021978, "y0": 0.1794871794871795, "x1": 0.8791208791208791, "y1": 0.19502719502719504}, {"text": "tooth. For some reason I am irritated by this urge, and make an effort to control it.", "x0": 0.11978021978021978, "y0": 0.1989121989121989, "x1": 0.7868131868131868, "y1": 0.21212121212121213}, {"text": "Inside ... is warm and dim. Thirty people stand about talking, but intent on the greying line that", "x0": 0.11978021978021978, "y0": 0.22377622377622378, "x1": 0.8802197802197802, "y1": 0.236985236985237}, {"text": "divides sea from sky. There it is ~ there\u2019s one. And another. The first iceberg is only a pale blip", "x0": 0.11868131868131868, "y0": 0.2400932400932401, "x1": 0.8791208791208791, "y1": 0.2533022533022533}, {"text": "on the horizon. The second is greyer, straighter-sided, more \u2018like a building\u2019. Night thickens", "x0": 0.11868131868131868, "y0": 0.2571872571872572, "x1": 0.8791208791208791, "y1": 0.2703962703962704}, {"text": "as we approach them. Iceberg no. | is unearthly, mother-of-pearl, glowing as if with its own", "x0": 0.11978021978021978, "y0": 0.2665112665112665, "x1": 0.8791208791208791, "y1": 0.2898212898212898}, {"text": "inner light source. People grow quiet, their social chatter stills. The only sounds are the buzz", "x0": 0.11978021978021978, "y0": 0.2898212898212898, "x1": 0.8791208791208791, "y1": 0.30303030303030304}, {"text": "and hum of the radar, the dull rumble of the engine, and out on deck the rushing of the wake.", "x0": 0.11978021978021978, "y0": 0.30691530691530694, "x1": 0.8758241758241758, "y1": 0.3201243201243201}, {"text": "Then somebody begins to liken the iceberg to a face. \u2018It\u2019s got a sad eye. See its nose?\u201d On and", "x0": 0.11868131868131868, "y0": 0.3317793317793318, "x1": 0.8791208791208791, "y1": 0.34498834498834496}, {"text": "\u2018on people go: it\u2019s like a sphinx, a Peke\u2019s\u201d face, an Indian head with its mouth open. Again Iam", "x0": 0.11868131868131868, "y0": 0.3457653457653458, "x1": 0.8791208791208791, "y1": 0.3613053613053613}, {"text": "secretly enraged by this, and by my own urgent desire to do the same. I stare at the iceberg as", "x0": 0.11978021978021978, "y0": 0.3651903651903652, "x1": 0.8791208791208791, "y1": 0.37839937839937837}, {"text": "it looms two hundred metres away on our port side. It gleams with a pearly purity. It\u2019s faceted:", "x0": 0.11978021978021978, "y0": 0.3815073815073815, "x1": 0.8791208791208791, "y1": 0.3947163947163947}, {"text": "creamy on the left, whiter on the right. It looks stable, like an island rather than something", "x0": 0.11868131868131868, "y0": 0.3986013986013986, "x1": 0.8791208791208791, "y1": 0.41181041181041184}, {"text": "floating. Water riffles around its foot. I strain and fail to see it only in abstract terms. I don\u2019t", "x0": 0.11978021978021978, "y0": 0.4149184149184149, "x1": 0.8802197802197802, "y1": 0.4281274281274281}, {"text": "want to keep going \u2018like, like, like\u2019. But I can\u2019t stop myself .", "x0": 0.11978021978021978, "y0": 0.42424242424242425, "x1": 0.6153846153846154, "y1": 0.44755244755244755}, {"text": "It\u2019s hopeless, trying to control the flood of metaphor. People cry out in wonder ... Exhausted", "x0": 0.11978021978021978, "y0": 0.4568764568764569, "x1": 0.8791208791208791, "y1": 0.4700854700854701}, {"text": "with the sy of it, you turn your eyes away for a moment, to rest \u2014 and the sun breaks", "x0": 0.11978021978021978, "y0": 0.4731934731934732, "x1": 0.8791208791208791, "y1": 0.4864024864024864}, {"text": "through the cloud cover to reveal a whole further field of icebergs \u2014 great flaring blocks of", "x0": 0.11978021978021978, "y0": 0.48951048951048953, "x1": 0.8813186813186813, "y1": 0.5027195027195027}, {"text": "perfect, piercing silver. The fog lifts further. There it is \u2014 the Antarctic Peninsula, a continent", "x0": 0.11978021978021978, "y0": 0.5066045066045066, "x1": 0.8791208791208791, "y1": 0.5198135198135199}, {"text": "of dark rocks, of ridged and bony snow. They want us to climb into an inflatable, flat-bottomed", "x0": 0.11868131868131868, "y0": 0.5229215229215229, "x1": 0.8791208791208791, "y1": 0.5361305361305362}, {"text": "zodiac\u201d and set foot on it? My stomach rolls with excitement and fear ...", "x0": 0.11978021978021978, "y0": 0.5369075369075369, "x1": 0.7098901098901099, "y1": 0.5524475524475524}, {"text": "Something funny happens to time, down here. The nights are so short and the light so foreign,", "x0": 0.11978021978021978, "y0": 0.5648795648795649, "x1": 0.8791208791208791, "y1": 0.578088578088578}, {"text": "we're so buffeted by weather, bombarded by new sights, wrung out with wonder, that the", "x0": 0.11978021978021978, "y0": 0.5811965811965812, "x1": 0.8791208791208791, "y1": 0.5944055944055944}, {"text": "memory starts to pack up. We lose our grip on the sequence of events ...", "x0": 0.11978021978021978, "y0": 0.5975135975135976, "x1": 0.7098901098901099, "y1": 0.6107226107226107}, {"text": "Where to find a language for these miraculous frozen forms? ...", "x0": 0.11868131868131868, "y0": 0.6231546231546231, "x1": 0.6384615384615384, "y1": 0.6363636363636364}, {"text": "The colour of an iceberg, or of a glacier wall, is impossible to name. You call it white, but", "x0": 0.11868131868131868, "y0": 0.6480186480186481, "x1": 0.8791208791208791, "y1": 0.6612276612276612}, {"text": "when you swing your eyes away and back, you see it\u2019s the most delicate, the palest and yet the", "x0": 0.11978021978021978, "y0": 0.6643356643356644, "x1": 0.8791208791208791, "y1": 0.6775446775446775}, {"text": "greyest green. Mint? The Nile? A no-colour. Water colour. Cloud colour. Again and again the", "x0": 0.11978021978021978, "y0": 0.6814296814296814, "x1": 0.8791208791208791, "y1": 0.6946386946386947}, {"text": "eye returns to feast on the crumpled mystery of ice ...", "x0": 0.11868131868131868, "y0": 0.6977466977466977, "x1": 0.5571428571428572, "y1": 0.710955710955711}, {"text": "People whisper helpless clich\u00e9s: \u2018magic\u2019, \u2018wonderland\u2019. Not good enough. The forms are", "x0": 0.11978021978021978, "y0": 0.7226107226107226, "x1": 0.8791208791208791, "y1": 0.7358197358197358}, {"text": "inhuman, but to name them we need the vocabulary of the body, of carpentry, dress making", "x0": 0.11978021978021978, "y0": 0.7397047397047397, "x1": 0.8791208791208791, "y1": 0.752913752913753}, {"text": "... all the beautiful crafts of people\u2019s hands. Pocked. Dimpled. Chiselled ... fringed, trimmed,", "x0": 0.11978021978021978, "y0": 0.756021756021756, "x1": 0.8791208791208791, "y1": 0.7692307692307693}, {"text": "carved, scrolled or simply folded and scratched ....", "x0": 0.11868131868131868, "y0": 0.7723387723387724, "x1": 0.5428571428571428, "y1": 0.7855477855477856}, {"text": "I can\u2019t believe the way my chest muscles are being squeezed by an emotion I don\u2019t have a", "x0": 0.11978021978021978, "y0": 0.797979797979798, "x1": 0.8802197802197802, "y1": 0.8111888111888111}, {"text": "name for.", "x0": 0.11978021978021978, "y0": 0.8142968142968143, "x1": 0.1956043956043956, "y1": 0.8243978243978244}, {"text": "HELEN GARNER", "x0": 0.7571428571428571, "y0": 0.8368298368298368, "x1": 0.8791208791208791, "y1": 0.8461538461538461}, {"text": "Adapted from Regions of Thick-ribbed Ice", "x0": 0.5362637362637362, "y0": 0.8523698523698524, "x1": 0.8791208791208791, "y1": 0.8655788655788655}, {"text": "\u00a9 Helen Garner, with kind permission of Barbara Mobbs.", "x0": 0.545054945054945, "y0": 0.871017871017871, "x1": 0.878021978021978, "y1": 0.8803418803418803}, {"text": "*1 coronet smal crown *2 Peke a type of dog *3 zodiac _a type of small boat", "x0": 0.11978021978021978, "y0": 0.8982128982128982, "x1": 0.7934065934065934, "y1": 0.9083139083139083}, {"text": "End of Question 1", "x0": 0.421978021978022, "y0": 0.9230769230769231, "x1": 0.5758241758241758, "y1": 0.9355089355089355}], [{"text": "Section II", "x0": 0.11978021978021978, "y0": 0.08236208236208237, "x1": 0.2164835164835165, "y1": 0.09401709401709402}, {"text": "20 marks", "x0": 0.11868131868131868, "y0": 0.11732711732711733, "x1": 0.1989010989010989, "y1": 0.12742812742812742}, {"text": "Attempt Question 2", "x0": 0.11868131868131868, "y0": 0.13364413364413363, "x1": 0.2879120879120879, "y1": 0.14685314685314685}, {"text": "Allow about 40 minutes for this section", "x0": 0.11868131868131868, "y0": 0.15073815073815075, "x1": 0.45604395604395603, "y1": 0.16083916083916083}, {"text": "Answer the question in the Paper | Answer Booklet. Extra writing booklets are available.", "x0": 0.11978021978021978, "y0": 0.18337218337218336, "x1": 0.845054945054945, "y1": 0.19658119658119658}, {"text": "Your answer will be assessed on how well you:", "x0": 0.14395604395604394, "y0": 0.21367521367521367, "x1": 0.5274725274725275, "y1": 0.22688422688422688}, {"text": "m= demonstrate understanding of the ways language shapes and expresses perceptions", "x0": 0.14285714285714285, "y0": 0.2338772338772339, "x1": 0.8362637362637363, "y1": 0.24708624708624707}, {"text": "\u2122 organise, develop and express ideas using language appropriate to audience, purpose", "x0": 0.14285714285714285, "y0": 0.2540792540792541, "x1": 0.856043956043956, "y1": 0.26728826728826727}, {"text": "and context", "x0": 0.16703296703296702, "y0": 0.27117327117327117, "x1": 0.25934065934065936, "y1": 0.2804972804972805}, {"text": "Question 2 (20 marks)", "x0": 0.11978021978021978, "y0": 0.3162393162393162, "x1": 0.30439560439560437, "y1": 0.32867132867132864}, {"text": "How do the texts you have studied demonstrate that discoveries can be intensely meaningful?", "x0": 0.11978021978021978, "y0": 0.34965034965034963, "x1": 0.878021978021978, "y1": 0.3628593628593629}, {"text": "In your response, refer to your TWO prescribed texts and ONE text of your own choosing.", "x0": 0.11978021978021978, "y0": 0.3822843822843823, "x1": 0.8549450549450549, "y1": 0.3954933954933955}, {"text": "The prescribed texts are:", "x0": 0.11868131868131868, "y0": 0.43356643356643354, "x1": 0.31758241758241756, "y1": 0.445998445998446}, {"text": "+ Prose Fiction \u2014 Allan Baillie, The China Coin", "x0": 0.11978021978021978, "y0": 0.4662004662004662, "x1": 0.5285714285714286, "y1": 0.47785547785547783}, {"text": "or", "x0": 0.4043956043956044, "y0": 0.4926184926184926, "x1": 0.4230769230769231, "y1": 0.4996114996114996}, {"text": "Ray Bradbury, Fahrenheit 451", "x0": 0.2857142857142857, "y0": 0.5128205128205128, "x1": 0.532967032967033, "y1": 0.526029526029526}, {"text": "or", "x0": 0.4043956043956044, "y0": 0.5392385392385393, "x1": 0.4230769230769231, "y1": 0.5462315462315462}, {"text": "Jhumpa Lahiri, The Namesake", "x0": 0.2857142857142857, "y0": 0.5594405594405595, "x1": 0.5318681318681319, "y1": 0.5726495726495726}, {"text": "or", "x0": 0.4043956043956044, "y0": 0.5858585858585859, "x1": 0.4230769230769231, "y1": 0.5928515928515928}, {"text": "\u2014 Tara June Winch, Swallow the Air", "x0": 0.26153846153846155, "y0": 0.6060606060606061, "x1": 0.5648351648351648, "y1": 0.6177156177156177}, {"text": "+ Drama \u2014 Jane Harrison, Rainbow's End", "x0": 0.11978021978021978, "y0": 0.6565656565656566, "x1": 0.532967032967033, "y1": 0.6674436674436675}, {"text": "from Vivienne Cleven et al., Contemporary Indigenous Plays", "x0": 0.2868131868131868, "y0": 0.6728826728826729, "x1": 0.7846153846153846, "y1":