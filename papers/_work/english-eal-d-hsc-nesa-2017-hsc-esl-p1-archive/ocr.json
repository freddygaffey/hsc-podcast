[[{"text": "NSW", "x0": 0.2098901098901099, "y0": 0.08857808857808858, "x1": 0.25054945054945055, "y1": 0.09712509712509712}, {"text": "EDUCATION", "x0": 0.2098901098901099, "y0": 0.10101010101010101, "x1": 0.3241758241758242, "y1": 0.10878010878010878}, {"text": "STANDARDS.", "x0": 0.2098901098901099, "y0": 0.11266511266511267, "x1": 0.3241758241758242, "y1": 0.12121212121212122}, {"text": "AUTHORITY", "x0": 0.2098901098901099, "y0": 0.1250971250971251, "x1": 0.3230769230769231, "y1": 0.13286713286713286}, {"text": "HIGHER", "x0": 0.2824175824175824, "y0": 0.17249417249417248, "x1": 0.33516483516483514, "y1": 0.1794871794871795}, {"text": "SCHOOL", "x0": 0.2813186813186813, "y0": 0.1857031857031857, "x1": 0.3395604395604396, "y1": 0.1926961926961927}, {"text": "CERTIFICATE", "x0": 0.2813186813186813, "y0": 0.1989121989121989, "x1": 0.3747252747252747, "y1": 0.20590520590520592}, {"text": "EXAMINATION", "x0": 0.2824175824175824, "y0": 0.21212121212121213, "x1": 0.3813186813186813, "y1": 0.2191142191142191}, {"text": "IMPORTANT: This resource was developed to support a previous version of the syllabus.", "x0": 0.12637362637362637, "y0": 0.2618492618492618, "x1": 0.9197802197802197, "y1": 0.27505827505827507}, {"text": "It may contain content that differs from the current syllabus.", "x0": 0.12637362637362637, "y0": 0.27583527583527584, "x1": 0.6516483516483517, "y1": 0.289044289044289}, {"text": "English (ESL)", "x0": 0.12307692307692308, "y0": 0.3247863247863248, "x1": 0.4307692307692308, "y1": 0.3605283605283605}, {"text": "Paper 1 \u2014 Language Study", "x0": 0.12197802197802197, "y0": 0.3947163947163947, "x1": 0.5868131868131868, "y1": 0.4195804195804196}, {"text": "within an Area of Study", "x0": 0.3120879120879121, "y0": 0.42657342657342656, "x1": 0.7032967032967034, "y1": 0.45143745143745145}, {"text": "General + Reading time - 10 minutes", "x0": 0.11978021978021978, "y0": 0.5221445221445221, "x1": 0.5241758241758242, "y1": 0.5415695415695416}, {"text": "Instructions Working time \u2014 1h hours", "x0": 0.11978021978021978, "y0": 0.5415695415695416, "x1": 0.5021978021978022, "y1": 0.5633255633255633}, {"text": "+ Write using black pen", "x0": 0.2681318681318681, "y0": 0.567987567987568, "x1": 0.47802197802197804, "y1": 0.5811965811965812}, {"text": "Total marks: Section | - 25 marks (pages 2-6)", "x0": 0.11868131868131868, "y0": 0.6216006216006216, "x1": 0.5714285714285714, "y1": 0.6348096348096348}, {"text": "a + Attempt Question 1", "x0": 0.11868131868131868, "y0": 0.6394716394716394, "x1": 0.45604395604395603, "y1": 0.6596736596736597}, {"text": "+ Allow about 50 minutes for this section", "x0": 0.2681318681318681, "y0": 0.6674436674436675, "x1": 0.6351648351648351, "y1": 0.6775446775446775}, {"text": "Section II - 20 marks (pages 7-9)", "x0": 0.26703296703296703, "y0": 0.7008547008547008, "x1": 0.578021978021978, "y1": 0.714063714063714}, {"text": "+ Attempt Question 2", "x0": 0.2681318681318681, "y0": 0.7249417249417249, "x1": 0.4582417582417582, "y1": 0.7381507381507382}, {"text": "+ Allow about 40 minutes for this section", "x0": 0.2681318681318681, "y0": 0.745920745920746, "x1": 0.6351648351648351, "y1": 0.756021756021756}, {"text": "2050", "x0": 0.08131868131868132, "y0": 0.9463869463869464, "x1": 0.11758241758241758, "y1": 0.9549339549339549}], [{"text": "Section I", "x0": 0.11978021978021978, "y0": 0.08236208236208237, "x1": 0.20659340659340658, "y1": 0.0947940947940948}, {"text": "25 marks", "x0": 0.11868131868131868, "y0": 0.11732711732711733, "x1": 0.1989010989010989, "y1": 0.12742812742812742}, {"text": "Attempt Question 1", "x0": 0.11868131868131868, "y0": 0.13364413364413363, "x1": 0.2868131868131868, "y1": 0.14685314685314685}, {"text": "Allow about 50 minutes for this section", "x0": 0.11868131868131868, "y0": 0.15073815073815075, "x1": 0.45604395604395603, "y1": 0.16083916083916083}, {"text": "Examine Texts 1, 2, 3 and 4 carefully and then answer the questions in the Paper | Answer", "x0": 0.11978021978021978, "y0": 0.18337218337218336, "x1": 0.8802197802197802, "y1": 0.19658119658119658}, {"text": "Booklet.", "x0": 0.11978021978021978, "y0": 0.20046620046620048, "x1": 0.18571428571428572, "y1": 0.21056721056721056}, {"text": "Your answers will be assessed on how well you:", "x0": 0.14395604395604394, "y0": 0.23076923076923078, "x1": 0.5351648351648352, "y1": 0.24397824397824397}, {"text": "demonstrate understanding of the ways language shapes and expresses perceptions", "x0": 0.16703296703296702, "y0": 0.2501942501942502, "x1": 0.8362637362637363, "y1": 0.2634032634032634}, {"text": "Text 1 \u2014 Film poster", "x0": 0.11868131868131868, "y0": 0.2913752913752914, "x1": 0.30439560439560437, "y1": 0.3045843045843046}, {"text": "\u201cCyber-Seniors i", "x0": 0.31758241758241756, "y0": 0.35586635586635584, "x1": 0.4164835164835165, "y1": 0.3651903651903652}, {"text": "beautifully done and hilarious.\u201d am", "x0": 0.2703296703296703, "y0": 0.3682983682983683, "x1": 0.5230769230769231, "y1": 0.3791763791763792}, {"text": "Sjostrom,CFUV", "x0": 0.321978021978022, "y0": 0.3815073815073815, "x1": 0.41208791208791207, "y1": 0.3900543900543901}, {"text": "a", "x0": 0.4747252747252747, "y0": 0.3900543900543901, "x1": 0.5175824175824176, "y1": 0.41025641025641024}, {"text": "Cyber-Seniors, a film directed by Saffron Cassaday, is a heartwarming and at times humorous", "x0": 0.11978021978021978, "y0": 0.8508158508158508, "x1": 0.8791208791208791, "y1": 0.864024864024864}, {"text": "documentary about the extraordinary journey of a group of senior citizens who take their first", "x0": 0.11868131868131868, "y0": 0.8671328671328671, "x1": 0.8791208791208791, "y1": 0.8803418803418803}, {"text": "steps into cyber-space under the guidance of a group of teenage mentors.", "x0": 0.11978021978021978, "y0": 0.8811188811188811, "x1": 0.7098901098901099, "y1": 0.9005439005439005}, {"text": "Reproduced with the kind permission of Cyber-Seniors: Connecting Generations Inc. www.cyberseniors.org", "x0": 0.16813186813186815, "y0": 0.9106449106449106, "x1": 0.8813186813186813, "y1": 0.9207459207459208}], [{"text": "Text 2\u2014 Poem", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.25274725274725274, "y1": 0.09246309246309246}, {"text": "MARGARET ATWOOD", "x0": 0.521978021978022, "y0": 0.519036519036519, "x1": 0.6868131868131868, "y1": 0.5299145299145299}], [{"text": "Text 3 \u2014 Extract from an anthology", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.4340659340659341, "y1": 0.0947940947940948}, {"text": "Preface", "x0": 0.17912087912087912, "y0": 0.13597513597513597, "x1": 0.24285714285714285, "y1": 0.14607614607614608}, {"text": "A good poem is a contribution to reality. The world is never the same once a", "x0": 0.17802197802197803, "y0": 0.16938616938616938, "x1": 0.8197802197802198, "y1": 0.1825951825951826}, {"text": "good poem has been added to it. A good poem helps to change the shape and", "x0": 0.17802197802197803, "y0": 0.1857031857031857, "x1": 0.8208791208791208, "y1": 0.1989121989121989}, {"text": "significance of the universe, helps to extend everyone\u2019s knowledge of himself", "x0": 0.17912087912087912, "y0": 0.20202020202020202, "x1": 0.8208791208791208, "y1": 0.21522921522921523}, {"text": "and the world around him. \u2014 Dylan Thomas (1913-1953)", "x0": 0.17912087912087912, "y0": 0.2191142191142191, "x1": 0.6516483516483517, "y1": 0.23232323232323232}, {"text": "From an early age, my mother would gather me and my brothers after school", "x0": 0.17912087912087912, "y0": 0.25252525252525254, "x1": 0.8197802197802198, "y1": 0.26573426573426573}, {"text": "for \u2018workshops\u2019 in music, visual art and writing. I grew to love the poems of", "x0": 0.17912087912087912, "y0": 0.26884226884226886, "x1": 0.8219780219780219, "y1": 0.28205128205128205}, {"text": "Shakespeare, Dylan Thomas, Rumi, Yeats and others that she read to us. She", "x0": 0.17912087912087912, "y0": 0.28593628593628595, "x1": 0.8197802197802198, "y1": 0.29914529914529914}, {"text": "read her own compositions, as well, and taught us to write our own. For me", "x0": 0.17912087912087912, "y0": 0.30303030303030304, "x1": 0.8197802197802198, "y1": 0.31546231546231546}, {"text": "poetry allowed word to be given to the things that otherwise had no voice, and I", "x0": 0.17912087912087912, "y0": 0.31934731934731936, "x1": 0.8197802197802198, "y1": 0.33255633255633255}, {"text": "discovered the strength and soul of poetry\u2014through it we come to know; we are", "x0": 0.17912087912087912, "y0": 0.3356643356643357, "x1": 0.8197802197802198, "y1": 0.34887334887334887}, {"text": "led to feel, sense and to expand our understanding beyond words.", "x0": 0.17912087912087912, "y0": 0.35275835275835277, "x1": 0.7087912087912088, "y1": 0.36596736596736595}, {"text": "Long before I wrote my first song, words formed as poems in my journals; and", "x0": 0.17912087912087912, "y0": 0.3822843822843823, "x1": 0.8197802197802198, "y1": 0.3954933954933955}, {"text": "poetry drives my song writing today.", "x0": 0.17912087912087912, "y0": 0.39937839937839936, "x1": 0.47692307692307695, "y1": 0.4125874125874126}, {"text": "I've learned that not all poetry lends itself to music\u2014some thoughts need to be", "x0": 0.17912087912087912, "y0": 0.4296814296814297, "x1": 0.8197802197802198, "y1": 0.4428904428904429}, {"text": "sung only against the silence. There are softer and less tangible parts of ourselves", "x0": 0.17912087912087912, "y0": 0.445998445998446, "x1": 0.8197802197802198, "y1": 0.4592074592074592}, {"text": "that are so essential to openheartedness, to peace, to unfolding the vision and", "x0": 0.17912087912087912, "y0": 0.46231546231546233, "x1": 0.8197802197802198, "y1": 0.4755244755244755}, {"text": "the spiritual realm of our lives, to exposing our souls. Poetry is a passage into", "x0": 0.17912087912087912, "y0": 0.4794094794094794, "x1": 0.8197802197802198, "y1": 0.4926184926184926}, {"text": "those parts of our being where we understand who we have been and where", "x0": 0.17912087912087912, "y0": 0.49572649572649574, "x1": 0.8197802197802198, "y1": 0.508935508935509}, {"text": "we discover and decide who and what we will be. It makes us intimate with", "x0": 0.17912087912087912, "y0": 0.5128205128205128, "x1": 0.8197802197802198, "y1": 0.5229215229215229}, {"text": "ourselves and others and with the human experience.", "x0": 0.17912087912087912, "y0": 0.5291375291375291, "x1": 0.6065934065934065, "y1": 0.5423465423465423}, {"text": "Poetry is the most honest and immediate art form that I have found, it is raw and", "x0": 0.17912087912087912, "y0": 0.5594405594405595, "x1": 0.8208791208791208, "y1": 0.5726495726495726}, {"text": "unfiltered. It is a vital, creative expression and deserves to find greater forums,", "x0": 0.17912087912087912, "y0": 0.5757575757575758, "x1": 0.8197802197802198, "y1": 0.5889665889665889}, {"text": "to be more highly valued, understood, and utilised in our culture and in our lives.", "x0": 0.17912087912087912, "y0": 0.5928515928515928, "x1": 0.8197802197802198, "y1": 0.6060606060606061}, {"text": "There is such wonderful poetry in the world that wants to be given voice. My", "x0": 0.17802197802197803, "y0": 0.6091686091686092, "x1": 0.8197802197802198, "y1": 0.6223776223776224}, {"text": "hope is to help inspire an appreciation and expression of that voice.", "x0": 0.17912087912087912, "y0": 0.6262626262626263, "x1": 0.7252747252747253, "y1": 0.6394716394716394}, {"text": "(singer/songwriter)", "x0": 0.667032967032967, "y0": 0.6565656565656566, "x1": 0.8197802197802198, "y1": 0.6697746697746698}, {"text": "Adapted from A Night Without Armour", "x0": 0.5021978021978022, "y0": 0.6728826728826729, "x1": 0.8208791208791208, "y1": 0.6860916860916861}, {"text": "Reproduced with permission of HarperCollins,", "x0": 0.5153846153846153, "y0": 0.7024087024087025, "x1": 0.8208791208791208, "y1": 0.7125097125097125}, {"text": "under section 107 \u201cFair Use\u201d of the Copyright Act", "x0": 0.4967032967032967, "y0": 0.7156177156177156, "x1": 0.8219780219780219, "y1": 0.7257187257187258}], [{"text": "Text 4 \u2014 Nonfiction extract", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.36153846153846153, "y1": 0.09168609168609168}, {"text": "Revelations* in the Dark", "x0": 0.3923076923076923, "y0": 0.13597513597513597, "x1": 0.6065934065934065, "y1": 0.14607614607614608}, {"text": "1 am standing on a rock in the middle of a river. Nighttime in the jungle pours", "x0": 0.17912087912087912, "y0": 0.1623931623931624, "x1": 0.8197802197802198, "y1": 0.18181818181818182}, {"text": "around me. Instinctively, I reach up and turn off my headlamp. The blackness", "x0": 0.17912087912087912, "y0": 0.1825951825951826, "x1": 0.8197802197802198, "y1": 0.1958041958041958}, {"text": "is complete now and I pause, waiting. I had missed the darkness. I breathe in.", "x0": 0.17912087912087912, "y0": 0.1989121989121989, "x1": 0.8186813186813187, "y1": 0.21212121212121213}, {"text": "The air is thick and abnormally hot, even for the Amazon. As my eyes adjust", "x0": 0.17802197802197803, "y0": 0.216006216006216, "x1": 0.8197802197802198, "y1": 0.22921522921522922}, {"text": "to the dark, the outline of the jungle slowly distinguishes itself from the night:", "x0": 0.17912087912087912, "y0": 0.23232323232323232, "x1": 0.8186813186813187, "y1": 0.24553224553224554}, {"text": "blacks, grays, dark blues, even silvery whites. It\u2019s amazing what we miss when", "x0": 0.17912087912087912, "y0": 0.2494172494172494, "x1": 0.8197802197802198, "y1": 0.26262626262626265}, {"text": "the lights are on. The moon is hardly a sliver, and innumerable stars dominate", "x0": 0.17912087912087912, "y0": 0.26573426573426573, "x1": 0.8197802197802198, "y1": 0.2789432789432789}, {"text": "the sky above, illuminating the vast jungle and bathing each leaf and rock with", "x0": 0.17912087912087912, "y0": 0.2828282828282828, "x1": 0.8197802197802198, "y1": 0.29603729603729606}, {"text": "their soft light. All around me, vapors rise like ghosts in the starlight. Some are", "x0": 0.17912087912087912, "y0": 0.29914529914529914, "x1": 0.8197802197802198, "y1": 0.3123543123543124}, {"text": "thin streams of mist; others are clouds so large that their billowing appears to", "x0": 0.17912087912087912, "y0": 0.31546231546231546, "x1": 0.8197802197802198, "y1": 0.32867132867132864}, {"text": "be in slow motion.", "x0": 0.17912087912087912, "y0": 0.33255633255633255, "x1": 0.32857142857142857, "y1": 0.34265734265734266}, {"text": "I lie down on the rock and am still, watching the steam rise into the night. When", "x0": 0.17912087912087912, "y0": 0.3628593628593629, "x1": 0.8197802197802198, "y1": 0.37606837606837606}, {"text": "a cool breeze blows, the mists thicken and roll, forming pale gray-blue eddies", "x0": 0.17912087912087912, "y0": 0.3791763791763792, "x1": 0.8197802197802198, "y1": 0.3923853923853924}, {"text": "against the sky. The rock beneath my body glows dimly white in the faint", "x0": 0.17912087912087912, "y0": 0.3962703962703963, "x1": 0.8197802197802198, "y1": 0.4094794094794095}, {"text": "light. Where my back and legs touch the rock\u2019s surface, I\u2019m sweating lightly.", "x0": 0.17912087912087912, "y0": 0.4125874125874126, "x1": 0.8197802197802198, "y1": 0.4257964257964258}, {"text": "A torrent of water, hot enough to kill me, wider than a two-lane road, surges", "x0": 0.17912087912087912, "y0": 0.4296814296814297, "x1": 0.8197802197802198, "y1": 0.4428904428904429}, {"text": "past my rock, emitting a roar that drowns out the jungle\u2019s nighttime chorus. My", "x0": 0.17912087912087912, "y0": 0.445998445998446, "x1": 0.8197802197802198, "y1": 0.4592074592074592}, {"text": "senses are sharp and every movement is keenly deliberate.", "x0": 0.17912087912087912, "y0": 0.4630924630924631, "x1": 0.6516483516483517, "y1": 0.4755244755244755}, {"text": "I'm in the heart of the Peruvian Amazon. The other members of my team are", "x0": 0.17912087912087912, "y0": 0.4926184926184926, "x1": 0.8197802197802198, "y1": 0.5058275058275058}, {"text": "in bed in the tiny community nearby, but there is no way I can sleep\u2014not with", "x0": 0.17912087912087912, "y0": 0.5097125097125097, "x1": 0.8197802197802198, "y1": 0.5229215229215229}, {"text": "what is before me here. My heart is beating hard, but I feel a complete calm.", "x0": 0.17912087912087912, "y0": 0.526029526029526, "x1": 0.8197802197802198, "y1": 0.5392385392385393}, {"text": "My eyes follow the river\u2019s vapors as they rise and melt into the firmament. The", "x0": 0.17912087912087912, "y0": 0.5431235431235432, "x1": 0.8197802197802198, "y1": 0.5563325563325563}, {"text": "Milky Way flows across the sky like a reflection of the river below. The Inca", "x0": 0.17912087912087912, "y0": 0.5594405594405595, "x1": 0.8208791208791208, "y1": 0.5726495726495726}, {"text": "referred to the Milky Way as the Celestial River, a path to another world, a place", "x0": 0.17912087912087912, "y0": 0.5757575757575758, "x1": 0.8208791208791208, "y1": 0.5889665889665889}, {"text": "inhabited by spirits. So the vapors join two great rivers here. It\u2019s clear why the", "x0": 0.17912087912087912, "y0": 0.5928515928515928, "x1": 0.8197802197802198, "y1": 0.6060606060606061}, {"text": "people who lived here regard this jungle as a place of such spiritual power. The", "x0": 0.17912087912087912, "y0": 0.6091686091686092, "x1": 0.8197802197802198, "y1": 0.6223776223776224}, {"text": "shaman\u2019s** words echo in my head: \u201cThe river shows us what we need to see.\u201d", "x0": 0.17912087912087912, "y0": 0.6262626262626263, "x1": 0.8197802197802198, "y1": 0.6394716394716394}, {"text": "This is becoming one of the greatest adventures of my life. This will be the", "x0": 0.17802197802197803, "y0": 0.6565656565656566, "x1": 0.8197802197802198, "y1": 0.6697746697746698}, {"text": "story I tell my children and grandchildren\u2014and every action I make in this", "x0": 0.17912087912087912, "y0": 0.6728826728826729, "x1": 0.8197802197802198, "y1": 0.6860916860916861}, {"text": "moment adds a new piece of the story. Every passing second now seems to hold", "x0": 0.17912087912087912, "y0": 0.6891996891996892, "x1": 0.8197802197802198, "y1": 0.7024087024087025}, {"text": "a greater significance. Burning-hot water splashes on my right arm. I sit up,", "x0": 0.17912087912087912, "y0": 0.7031857031857032, "x1": 0.8197802197802198, "y1": 0.7226107226107226}, {"text": "pulling my arm to my chest, no longer lost in thought. I recall my", "x0": 0.17912087912087912, "y0": 0.7233877233877234, "x1": 0.7230769230769231, "y1": 0.7358197358197358}, {"text": "words from volcanology field school: \u201cThe people who die on volcanoes are", "x0": 0.17912087912087912, "y0": 0.7397047397047397, "x1": 0.8197802197802198, "y1": 0.752913752913753}, {"text": "the inexperienced who are ignorant of the dangers and the experts who have", "x0": 0.17912087912087912, "y0": 0.756021756021756, "x1": 0.8197802197802198, "y1": 0.7692307692307693}, {"text": "forgotten they are dangerous.\u201d", "x0": 0.17912087912087912, "y0": 0.7731157731157731, "x1": 0.42417582417582417, "y1": 0.7863247863247863}, {"text": "I stand, make sure I have a firm footing, and jump back onto the nearest shore.", "x0": 0.17912087912087912, "y0": 0.8026418026418026, "x1": 0.8197802197802198, "y1": 0.8158508158508159}, {"text": "As I look back at the Boiling River I can\u2019t suppress an excited whisper: \u201cThis", "x0": 0.17912087912087912, "y0": 0.8197358197358198, "x1": 0.8197802197802198, "y1": 0.8329448329448329}, {"text": "Text 4 continues on page 5", "x0": 0.38461538461538464, "y0": 0.8997668997668997, "x1": 0.6131868131868132, "y1": 0.912975912975913}], [{"text": "Text 4 (continued)", "x0": 0.11868131868131868, "y0": 0.08158508158508158, "x1": 0.2692307692307692, "y1": 0.09401709401709402}, {"text": "place exists. This place actually exists.\u201d I remember the shaman saying the river", "x0": 0.17912087912087912, "y0": 0.13597513597513597, "x1": 0.8208791208791208, "y1": 0.14918414918414918}, {"text": "has called me here for a purpose, and I can feel a greater mission about to take", "x0": 0.17912087912087912, "y0": 0.1522921522921523, "x1": 0.8197802197802198, "y1": 0.1655011655011655}, {"text": "place. I won\u2019t get much sleep tonight.", "x0": 0.17912087912087912, "y0": 0.17016317016317017, "x1": 0.4846153846153846, "y1": 0.1825951825951826}, {"text": "The vapors dance in the starlight as I make my way back to my hut, my", "x0": 0.17802197802197803, "y0": 0.1989121989121989, "x1": 0.8197802197802198, "y1": 0.21212121212121213}, {"text": "mind filled with thoughts of the river, the dark jungle surrounding it, and the", "x0": 0.17912087912087912, "y0": 0.216006216006216, "x1": 0.8197802197802198, "y1": 0.22921522921522922}, {"text": "story that remains to be written. It\u2019s a story that began with a legend heard in", "x0": 0.17912087912087912, "y0": 0.23232323232323232, "x1": 0.8197802197802198, "y1": 0.24553224553224554}, {"text": "childhood\u2014a story of exploration and discovery, driven by a need to understand", "x0": 0.17912087912087912, "y0": 0.2494172494172494, "x1": 0.8197802197802198, "y1": 0.26262626262626265}, {"text": "what initially appeared unbelievable. It\u2019s a story where modern science and", "x0": 0.17912087912087912, "y0": 0.26573426573426573, "x1": 0.8197802197802198, "y1": 0.2789432789432789}, {"text": "traditional worldviews collide\u2014not violently but respectfully\u2014united in their", "x0": 0.17912087912087912, "y0": 0.2828282828282828, "x1": 0.8208791208791208, "y1": 0.29603729603729606}, {"text": "sense of awe for the natural world.", "x0": 0.17912087912087912, "y0": 0.29914529914529914, "x1": 0.4593406593406593, "y1": 0.30924630924630925}, {"text": "At a time when everything seems mapped, measured, and understood, this", "x0": 0.17912087912087912, "y0": 0.32944832944832947, "x1": 0.8197802197802198, "y1": 0.34265734265734266}, {"text": "river challenges what we think we know. It has forced me to question the line", "x0": 0.17912087912087912, "y0": 0.3457653457653458, "x1": 0.8197802197802198, "y1": 0.358974358974359}, {"text": "between known and unknown, ancient and modern, scientific and spiritual. It", "x0": 0.17912087912087912, "y0": 0.3628593628593629, "x1": 0.8197802197802198, "y1": 0.37606837606837606}, {"text": "is a reminder that there are still great wonders to be discovered. We find them", "x0": 0.17912087912087912, "y0": 0.3791763791763792, "x1": 0.8197802197802198, "y1": 0.3923853923853924}, {"text": "not just in the black void of the unknown but in the white noise of everyday", "x0": 0.17912087912087912, "y0": 0.3962703962703963, "x1": 0.8197802197802198, "y1": 0.4094794094794095}, {"text": "life\u2014in the things we barely notice, the things we almost forget, even in a detail", "x0": 0.17912087912087912, "y0": 0.4125874125874126, "x1": 0.8197802197802198, "y1": 0.4257964257964258}, {"text": "of a story.", "x0": 0.17912087912087912, "y0": 0.4296814296814297, "x1": 0.25934065934065936, "y1": 0.4428904428904429}, {"text": "RUZO", "x0": 0.7769230769230769, "y0": 0.4553224553224553, "x1": 0.8208791208791208, "y1": 0.46464646464646464}, {"text": "from The Boiling River", "x0": 0.6329670329670329, "y0": 0.47086247086247085, "x1": 0.8208791208791208, "y1": 0.4840714840714841}, {"text": "Reproduced with permission from Simon & Schuster UK", "x0": 0.4472527472527473, "y0": 0.49805749805749805, "x1": 0.8219780219780219, "y1": 0.5081585081585082}, {"text": "the act of making known", "x0": 0.2978021978021978, "y0": 0.5462315462315462, "x1": 0.46593406593406594, "y1": 0.5563325563325563}, {"text": "shaman a medicine man and priest who works with the supernatural", "x0": 0.2032967032967033, "y0": 0.5633255633255633, "x1": 0.701098901098901, "y1": 0.5734265734265734}, {"text": "End of Question 1", "x0": 0.421978021978022, "y0": 0.6449106449106449, "x1": 0.5758241758241758, "y1": 0.6573426573426573}], [{"text": "Section II", "x0": 0.11978021978021978, "y0": 0.08236208236208237, "x1": 0.2164835164835165, "y1": 0.09401709401709402}, {"text": "20 marks", "x0": 0.11868131868131868, "y0": 0.11732711732711733, "x1": 0.1989010989010989, "y1": 0.12742812742812742}, {"text": "Attempt Question 2", "x0": 0.11868131868131868, "y0": 0.13364413364413363, "x1": 0.2879120879120879, "y1": 0.14685314685314685}, {"text": "Allow about 40 minutes for this section", "x0": 0.11868131868131868, "y0": 0.15073815073815075, "x1": 0.45604395604395603, "y1": 0.16083916083916083}, {"text": "Answer the question in the Paper | Answer Booklet. Extra writing booklets are available.", "x0": 0.11978021978021978, "y0": 0.18337218337218336, "x1": 0.845054945054945, "y1": 0.19658119658119658}, {"text": "Your answer will be assessed on how well you:", "x0": 0.14395604395604394, "y0": 0.21367521367521367, "x1": 0.5274725274725275, "y1": 0.22688422688422688}, {"text": "\u00a9 demonstrate understanding of the ways language shapes and expresses perceptions", "x0": 0.14285714285714285, "y0": 0.2338772338772339, "x1": 0.8362637362637363, "y1": 0.24708624708624707}, {"text": "\u00a9 organise, develop and express ideas using language appropriate to audience, purpose", "x0": 0.14285714285714285, "y0": 0.2540792540792541, "x1": 0.856043956043956, "y1": 0.26728826728826727}, {"text": "and context", "x0": 0.16703296703296702, "y0": 0.27117327117327117, "x1": 0.25934065934065936, "y1": 0.2804972804972805}, {"text": "Question 2 (20 marks)", "x0": 0.11978021978021978, "y0": 0.3162393162393162, "x1": 0.30439560439560437, "y1": 0.32867132867132864}, {"text": "Discoveries have the power to transform.", "x0": 0.11978021978021978, "y0": 0.34965034965034963, "x1": 0.45274725274725275, "y1": 0.3628593628593629}, {"text": "To what extent is this view presented in the texts you have studied?", "x0": 0.11868131868131868, "y0": 0.3822843822843823, "x1": 0.6681318681318681, "y1": 0.3954933954933955}, {"text": "In your response, refer to your TWO prescribed texts and ONE text of your own choosing.", "x0": 0.11978021978021978, "y0": 0.4156954156954157, "x1": 0.8549450549450549, "y1": 0.4289044289044289}, {"text": "The prescribed texts are:", "x0": 0.11868131868131868, "y0": 0.466977466977467, "x1": 0.31758241758241756, "y1": 0.4794094794094794}, {"text": "+ Prose Fiction \u2014 Allan Baillie, The China Coin", "x0": 0.11978021978021978, "y0": 0.4996114996114996, "x1": 0.5285714285714286, "y1": 0.5112665112665112}, {"text": "or", "x0": 0.4043956043956044, "y0": 0.526029526029526, "x1": 0.4230769230769231, "y1": 0.533022533022533}, {"text": "Ray Bradbury, Fahrenheit 451", "x0": 0.2857142857142857, "y0": 0.5462315462315462, "x1": 0.532967032967033, "y1": 0.5594405594405595}, {"text": "or", "x0": 0.4043956043956044, "y0": 0.5726495726495726, "x1": 0.4230769230769231, "y1": 0.5796425796425796}, {"text": "\u2014 Jhumpa Lahiri, The Namesake", "x0": 0.26153846153846155, "y0": 0.5928515928515928, "x1": 0.5318681318681319, "y1": 0.6060606060606061}, {"text": "or", "x0": 0.4043956043956044, "y0": 0.6192696192696193, "x1": 0.4230769230769231, "y1": 0.6262626262626263}, {"text": "= Tara June Winch, Swallow the Air", "x0": 0.26153846153846155, "y0": 0.6394716394716394, "x1": 0.5648351648351648, "y1": 0.6511266511266511}, {"text": "+ Drama Jane Harrison, End", "x0": 0.11978021978021978, "y0": 0.6899766899766899, "x1": 0.5318681318681319, "y1": 0.7008547008547008}, {"text": "from Vivienne Cleven et al., Contemporary Indigenous Plays", "x0": 0.2868131868131868, "y0": 0.7062937062937062, "x1": 0.7846153846153846, "y1": 0.7195027195027195}, {"text": "or", "x0": 0.4043956043956044, "y0": 0.7327117327117327, "x1": 0.4230769230769231, "y1": 0.7397047397047397}, {"text": "Katherine Thomson, Navigating", "x0": 0.2868131868131868, "y0": 0.7536907536907537, "x1": 0.545054945054945, "y1": 0.7661227661227661}, {"text": "Question 2 continues on page 8", "x0": 0.3659340659340659, "y0": 0.8205128205128205, "x1": 0.6329670329670329, "y1": 0.8337218337218337}], [{"text": "Question 2 (continued)", "x0": 0.11978021978021978, "y0": 0.08158508158508158, "x1": 0.30439560439560437, "y1": 0.09401709401709402}, {"text": "+ Poetry", "x0": 0.11978021978021978, "y0": 0.11499611499611499, "x1": 0.1989010989010989, "y1": 0.1282051282051282}, {"text": "\u2014 Robert Frost, The Poetry of Robert Frost", "x0": 0.26153846153846155, "y0": 0.11499611499611499, "x1": 0.6175824175824176, "y1": 0.1282051282051282}, {"text": "The prescribed poems are:", "x0": 0.2857142857142857, "y0": 0.1383061383061383, "x1": 0.4978021978021978, "y1": 0.15151515151515152}, {"text": "* The Tuft of Flowers", "x0": 0.2868131868131868, "y0": 0.16161616161616163, "x1": 0.46923076923076923, "y1": 0.17482517482517482}, {"text": "* Mending Wall", "x0": 0.2868131868131868, "y0": 0.17871017871017872, "x1": 0.42417582417582417, "y1": 0.1919191919191919}, {"text": "* Home Burial", "x0": 0.2868131868131868, "y0": 0.1958041958041958, "x1": 0.4142857142857143, "y1": 0.20512820512820512}, {"text": "* After Apple-Picking", "x0": 0.2868131868131868, "y0": 0.21212121212121213, "x1": 0.46923076923076923, "y1": 0.22533022533022534}, {"text": "* The Road Not Taken", "x0": 0.2868131868131868, "y0": 0.22843822843822845, "x1": 0.4758241758241758, "y1": 0.23853923853923853}, {"text": "* Stopping by Woods on a Snowy Evening", "x0": 0.2868131868131868, "y0": 0.24553224553224554, "x1": 0.6362637362637362, "y1": 0.25874125874125875}, {"text": "* A Boundless Moment", "x0": 0.2868131868131868, "y0": 0.2618492618492618, "x1": 0.48131868131868133, "y1": 0.27195027195027194}, {"text": "or", "x0": 0.4043956043956044, "y0": 0.28826728826728826, "x1": 0.4230769230769231, "y1": 0.29526029526029524}, {"text": "Oodgeroo Noonuccal, My People", "x0": 0.2857142857142857, "y0": 0.3084693084693085, "x1": 0.5560439560439561, "y1": 0.32167832167832167}, {"text": "The prescribed poems are:", "x0": 0.2857142857142857, "y0": 0.3317793317793318, "x1": 0.4978021978021978, "y1": 0.34498834498834496}, {"text": "* Last of His Tribe", "x0": 0.2868131868131868, "y0": 0.35586635586635584, "x1": 0.4472527472527473, "y1": 0.3690753690753691}, {"text": "* Acacia Ridge", "x0": 0.2868131868131868, "y0": 0.37218337218337216, "x1": 0.4164835164835165, "y1": 0.3853923853923854}, {"text": "* Municipal Gum", "x0": 0.2868131868131868, "y0": 0.38927738927738925, "x1": 0.43626373626373627, "y1": 0.4017094017094017}, {"text": "* Son of Mine", "x0": 0.2868131868131868, "y0": 0.4063714063714064, "x1": 0.4065934065934066, "y1": 0.4188034188034188}, {"text": "* Understand, Old One", "x0": 0.2868131868131868, "y0": 0.4219114219114219, "x1": 0.4835164835164835, "y1": 0.43356643356643354}, {"text": "* We Are Going", "x0": 0.2868131868131868, "y0": 0.4397824397824398, "x1": 0.42417582417582417, "y1": 0.4522144522144522}, {"text": "* The Past", "x0": 0.2868131868131868, "y0": 0.4560994560994561, "x1": 0.3802197802197802, "y1": 0.4654234654234654}, {"text": "or", "x0": 0.4043956043956044, "y0": 0.48174048174048173, "x1": 0.4230769230769231, "y1": 0.4887334887334887}, {"text": "Ken Watson (ed.), The Round Earth\u2019s Imagined Corners", "x0": 0.2868131868131868, "y0": 0.5027195027195027, "x1": 0.7461538461538462, "y1": 0.515928515928516}, {"text": "The prescribed poems are:", "x0": 0.2857142857142857, "y0": 0.526029526029526, "x1": 0.4978021978021978, "y1": 0.5392385392385393}, {"text": "Sujata Bhatt, The Stare", "x0": 0.3098901098901099, "y0": 0.5501165501165501, "x1": 0.4967032967032967, "y1": 0.5625485625485626}, {"text": "Nina Cassian, Evolution", "x0": 0.3098901098901099, "y0": 0.5656565656565656, "x1": 0.5043956043956044, "y1": 0.5773115773115773}, {"text": "Carol Ann Duffy, Originally", "x0": 0.3098901098901099, "y0": 0.5827505827505828, "x1": 0.5417582417582417, "y1": 0.5959595959595959}, {"text": "Miroslav Holub, Brief Reflection on Ac", "x0": 0.3098901098901099, "y0": 0.599