[[{"text": ", Billara", "x0": 0.22637362637362637, "y0": 0.08547008547008547, "x1": 0.48131868131868133, "y1": 0.13752913752913754}, {"text": "HIGH SCHOOL", "x0": 0.22197802197802197, "y0": 0.13442113442113443, "x1": 0.48131868131868133, "y1": 0.14996114996114995}, {"text": "TRIAL HSC EXAMINATION 2020", "x0": 0.12087912087912088, "y0": 0.3045843045843046, "x1": 0.421978021978022, "y1": 0.31546231546231546}, {"text": "English Standard", "x0": 0.12637362637362637, "y0": 0.3418803418803419, "x1": 0.5703296703296703, "y1": 0.38306138306138304}, {"text": "Paper 2 \u2014 Modules", "x0": 0.12417582417582418, "y0": 0.4048174048174048, "x1": 0.43846153846153846, "y1": 0.43045843045843046}, {"text": "General Reading time \u2014 5 minutes", "x0": 0.13076923076923078, "y0": 0.4654234654234654, "x1": 0.49340659340659343, "y1": 0.48951048951048953}, {"text": "Working time \u2014 2 hours", "x0": 0.3032967032967033, "y0": 0.49184149184149184, "x1": 0.47802197802197804, "y1": 0.5027195027195027}, {"text": "Instructions", "x0": 0.13076923076923078, "y0": 0.49184149184149184, "x1": 0.21978021978021978, "y1": 0.5003885003885004}, {"text": "Write using black pen", "x0": 0.3032967032967033, "y0": 0.5097125097125097, "x1": 0.46373626373626375, "y1": 0.5213675213675214}, {"text": "Write your student number in all writing booklets used", "x0": 0.3032967032967033, "y0": 0.5275835275835276, "x1": 0.7131868131868132, "y1": 0.5392385392385393}, {"text": "Total Marks: Section |- 20 marks", "x0": 0.12967032967032968, "y0": 0.5928515928515928, "x1": 0.41318681318681316, "y1": 0.6021756021756022}, {"text": "60 \u00a9 Attempt Question 1", "x0": 0.13076923076923078, "y0": 0.6114996114996115, "x1": 0.45054945054945056, "y1": 0.6223776223776224}, {"text": "\u00a9 Allow about 40 minutes for this section", "x0": 0.27362637362637365, "y0": 0.6293706293706294, "x1": 0.5956043956043956, "y1": 0.6386946386946387}, {"text": "Section Il - 20 marks", "x0": 0.26043956043956046, "y0": 0.6658896658896659, "x1": 0.4175824175824176, "y1": 0.6752136752136753}, {"text": "\u00a9 Attempt Question 2", "x0": 0.27362637362637365, "y0": 0.6853146853146853, "x1": 0.45054945054945056, "y1": 0.6961926961926962}, {"text": "\u00a9 Allow about 40 minutes for this section", "x0": 0.27362637362637365, "y0": 0.7024087024087025, "x1": 0.5956043956043956, "y1": 0.7117327117327117}, {"text": "Section Ill = 20 marks", "x0": 0.26043956043956046, "y0": 0.7397047397047397, "x1": 0.4230769230769231, "y1": 0.749028749028749}, {"text": "\u00a9 Attempt Question 3", "x0": 0.27362637362637365, "y0": 0.7583527583527584, "x1": 0.45054945054945056, "y1": 0.7692307692307693}, {"text": "\u00a9 Allow about 40 minutes for this section", "x0": 0.27362637362637365, "y0": 0.7762237762237763, "x1": 0.5956043956043956, "y1": 0.7855477855477856}], [{"text": "Section I \u2014 Module A: Language, Identity and Culture", "x0": 0.06153846153846154, "y0": 0.06216006216006216, "x1": 0.7120879120879121, "y1": 0.07925407925407925}, {"text": "20 marks", "x0": 0.06153846153846154, "y0": 0.11033411033411034, "x1": 0.14725274725274726, "y1": 0.12043512043512043}, {"text": "Attempt Question 1", "x0": 0.06043956043956044, "y0": 0.12665112665112666, "x1": 0.23956043956043957, "y1": 0.13986013986013987}, {"text": "Allow about 40 minutes for this section", "x0": 0.06043956043956044, "y0": 0.14296814296814297, "x1": 0.421978021978022, "y1": 0.15306915306915306}, {"text": "Answer the question in the writing booklets provided. Extra writing booklets are available.", "x0": 0.06043956043956044, "y0": 0.17715617715617715, "x1": 0.8373626373626374, "y1": 0.19036519036519037}, {"text": "Your answer will be assessed on how well you:", "x0": 0.07032967032967033, "y0": 0.216006216006216, "x1": 0.46923076923076923, "y1": 0.22921522921522922}, {"text": "\u00a9 demonstrate understanding of how ideas about language, identity and culture are expressed", "x0": 0.1010989010989011, "y0": 0.2331002331002331, "x1": 0.9208791208791208, "y1": 0.2463092463092463}, {"text": "through texts", "x0": 0.13076923076923078, "y0": 0.2494172494172494, "x1": 0.24395604395604395, "y1": 0.26262626262626265}, {"text": "\u00a9 demonstrate understanding of how language is used to shape meaning about individuals", "x0": 0.1010989010989011, "y0": 0.2665112665112665, "x1": 0.8879120879120879, "y1": 0.27972027972027974}, {"text": "and/or cultural groups", "x0": 0.13076923076923078, "y0": 0.2828282828282828, "x1": 0.3263736263736264, "y1": 0.29603729603729606}, {"text": "\u00a9 organise, develop and express ideas using language appropriate to audience, purpose and", "x0": 0.1010989010989011, "y0": 0.2999222999222999, "x1": 0.8978021978021978, "y1": 0.31313131313131315}, {"text": "form", "x0": 0.13076923076923078, "y0": 0.3162393162393162, "x1": 0.17032967032967034, "y1": 0.32634032634032634}, {"text": "Question 1 (20 marks)", "x0": 0.06153846153846154, "y0": 0.3745143745143745, "x1": 0.2681318681318681, "y1": 0.3877233877233877}, {"text": "Poetry is by nature expressive and disruptive. How have the poets in this collection challenged", "x0": 0.06153846153846154, "y0": 0.42424242424242425, "x1": 0.8692307692307693, "y1": 0.43745143745143744}, {"text": "assumptions about culture to express their unique identities?", "x0": 0.06153846153846154, "y0": 0.44133644133644134, "x1": 0.5868131868131868, "y1": 0.45454545454545453}, {"text": "Respond to this question with detailed reference to your prescribed text for Module A.", "x0": 0.06153846153846154, "y0": 0.47474747474747475, "x1": 0.798901098901099, "y1": 0.48795648795648794}, {"text": "The prescribed poems are:", "x0": 0.06043956043956044, "y0": 0.5244755244755245, "x1": 0.2879120879120879, "y1": 0.5376845376845377}, {"text": "\u2014 Adam Aitken, Kim Cheng Boey and Michelle Cahill (eds), Contemporary Asian Australian Poets", "x0": 0.0912087912087912, "y0": 0.5508935508935509, "x1": 0.9208791208791208, "y1": 0.5757575757575758}, {"text": "* Merlinda Bobis, This is where it begins", "x0": 0.12197802197802197, "y0": 0.574980574980575, "x1": 0.4582417582417582, "y1": 0.5881895881895882}, {"text": "* Miriam Wei Wei Lo, Home", "x0": 0.12197802197802197, "y0": 0.5912975912975913, "x1": 0.35714285714285715, "y1": 0.602952602952603}, {"text": "* Ouyang Yu, New Accents", "x0": 0.12197802197802197, "y0": 0.6083916083916084, "x1": 0.34065934065934067, "y1": 0.6216006216006216}, {"text": "* Vuong Pham, Mother", "x0": 0.12197802197802197, "y0": 0.6247086247086248, "x1": 0.3131868131868132, "y1": 0.6379176379176379}, {"text": "* Jaya Savige, Circular Breathing", "x0": 0.12197802197802197, "y0": 0.6418026418026418, "x1": 0.3945054945054945, "y1": 0.655011655011655}, {"text": "* Maureen Ten (Ten Ch'in U), Translucent Jade", "x0": 0.12197802197802197, "y0": 0.6565656565656566, "x1": 0.5164835164835165, "y1": 0.6713286713286714}], [{"text": "Section II \u2014 Module B: Close Study of Literature", "x0": 0.06153846153846154, "y0": 0.06604506604506605, "x1": 0.6461538461538462, "y1": 0.08313908313908314}, {"text": "20 marks", "x0": 0.06153846153846154, "y0": 0.11344211344211344, "x1": 0.14725274725274726, "y1": 0.12354312354312354}, {"text": "Attempt Question 2", "x0": 0.06043956043956044, "y0": 0.12975912975912976, "x1": 0.23846153846153847, "y1": 0.14296814296814297}, {"text": "Allow about 40 minutes for this section", "x0": 0.06043956043956044, "y0": 0.14685314685314685, "x1": 0.421978021978022, "y1": 0.15695415695415696}, {"text": "Answer the question in the writing booklets provided. Extra writing booklets are available.", "x0": 0.06043956043956044, "y0": 0.18026418026418026, "x1": 0.8373626373626374, "y1": 0.19347319347319347}, {"text": "Your answer will be assessed on how well you:", "x0": 0.07032967032967033, "y0": 0.21134421134421136, "x1": 0.46923076923076923, "y1": 0.23776223776223776}, {"text": "\u00a9 demonstrate understanding of a text's distinctive qualities and how these shape meaning", "x0": 0.1010989010989011, "y0": 0.22766122766122765, "x1": 0.8934065934065935, "y1": 0.2540792540792541}, {"text": "\u00a9 organise, develop and express ideas using language appropriate to audience, purpose and", "x0": 0.1010989010989011, "y0": 0.2533022533022533, "x1": 0.8978021978021978, "y1": 0.2665112665112665}, {"text": "form", "x0": 0.13076923076923078, "y0": 0.26961926961926963, "x1": 0.17032967032967034, "y1": 0.27972027972027974}, {"text": "Question 2 (20 marks)", "x0": 0.06153846153846154, "y0": 0.3278943278943279, "x1": 0.2681318681318681, "y1": 0.3411033411033411}, {"text": "\u201cLots of things are mysteries. But that doesn't mean", "x0": 0.2868131868131868, "y0": 0.3776223776223776, "x1": 0.7131868131868132, "y1": 0.39083139083139085}, {"text": "there isn't an answer to them\u201d - Christopher", "x0": 0.3087912087912088, "y0": 0.4024864024864025, "x1": 0.6912087912087912, "y1": 0.4156954156954157}, {"text": "How are puzzles central to your understanding of ideas in Mark Haddon\u2019s novel, The Curious Incident", "x0": 0.06153846153846154, "y0": 0.452991452991453, "x1": 0.9252747252747253, "y1": 0.4662004662004662}, {"text": "of the Dog in the Night Time?", "x0": 0.06153846153846154, "y0": 0.47785547785547783, "x1": 0.30439560439560437, "y1": 0.49106449106449107}, {"text": "Respond to the above question with detailed reference to your prescribed text for Module B.", "x0": 0.06153846153846154, "y0": 0.5198135198135199, "x1": 0.8494505494505494, "y1": 0.533022533022533}], [{"text": "Section III \u2014 Module C: The Craft of Writing", "x0": 0.06153846153846154, "y0": 0.05516705516705517, "x1": 0.5956043956043956, "y1": 0.07226107226107226}, {"text": "20 marks", "x0": 0.06153846153846154, "y0": 0.10256410256410256, "x1": 0.14725274725274726, "y1": 0.11266511266511267}, {"text": "Attempt Question 3", "x0": 0.06043956043956044, "y0": 0.11965811965811966, "x1": 0.23846153846153847, "y1": 0.13286713286713286}, {"text": "Allow about 40 minutes for this section", "x0": 0.06043956043956044, "y0": 0.13597513597513597, "x1": 0.421978021978022, "y1": 0.14607614607614608}, {"text": "Answer the question in the writing booklets provided. Extra writing booklets are available.", "x0": 0.06043956043956044, "y0": 0.16938616938616938, "x1": 0.8373626373626374, "y1": 0.1825951825951826}, {"text": "Your answer will be assessed on how well you:", "x0": 0.07032967032967033, "y0": 0.20046620046620048, "x1": 0.46923076923076923, "y1": 0.22688422688422688}, {"text": "\u00a9 craft language to address the demands of the question", "x0": 0.1010989010989011, "y0": 0.21678321678321677, "x1": 0.5934065934065934, "y1": 0.2432012432012432}, {"text": "\u00a9 use language appropriate to audience, purpose and form to shape meaning", "x0": 0.1010989010989011, "y0": 0.24242424242424243, "x1": 0.7703296703296704, "y1": 0.2556332556332556}, {"text": "Question 3 (20 marks)", "x0": 0.06153846153846154, "y0": 0.2999222999222999, "x1": 0.2681318681318681, "y1": 0.31313131313131315}, {"text": "a) Construct a piece of imaginative, discursive or persuasive writing that explores an 12", "x0": 0.1, "y0": 0.3333333333333333, "x1": 0.9285714285714286, "y1": 0.34654234654234656}, {"text": "idea of patience.", "x0": 0.13076923076923078, "y0": 0.3434343434343434, "x1": 0.2681318681318681, "y1": 0.3682983682983683}, {"text": "b) Explain how your writing in Part A was influenced by what you have learned about 8", "x0": 0.1, "y0": 0.3916083916083916, "x1": 0.9296703296703297, "y1": 0.41802641802641805}, {"text": "writing through the study of at least one short prescribed text in Module C.", "x0": 0.13076923076923078, "y0": 0.4087024087024087, "x1": 0.7692307692307693, "y1": 0.43512043512043513}, {"text": "The prescribed texts are:", "x0": 0.06043956043956044, "y0": 0.4840714840714841, "x1": 0.2725274725274725, "y1": 0.4972804972804973}, {"text": "* Prose Bradbury, Ray, \u2018The Pedestrian\u2019", "x0": 0.06153846153846154, "y0": 0.5182595182595182, "x1": 0.5263736263736264, "y1": 0.5314685314685315}, {"text": "~ Carey, Peter, \u2018Report on the Shadow Industry\u2019", "x0": 0.24285714285714285, "y0": 0.5345765345765345, "x1": 0.6461538461538462, "y1": 0.5477855477855478}, {"text": "~ Cole, Catherine, \u2018Home\u2019", "x0": 0.24285714285714285, "y0": 0.5516705516705517, "x1": 0.45384615384615384, "y1": 0.5633255633255633}, {"text": "~ King, Stephen, \u2018Crouch End\u2019", "x0": 0.24285714285714285, "y0": 0.567987567987568, "x1": 0.4912087912087912, "y1": 0.5811965811965812}, {"text": "Lucashenko, Melissa, \u2018Dreamers\u2019", "x0": 0.25824175824175827, "y0": 0.585081585081585, "x1": 0.532967032967033, "y1": 0.5967365967365967}, {"text": "* Nonfiction Garner, Helen, \u2018Dear Mrs Dunkley\u2019", "x0": 0.06153846153846154, "y0": 0.6192696192696193, "x1": 0.5461538461538461, "y1": 0.6324786324786325}, {"text": "- Orwell, George, \u2018The Sporting Spirit\u2019", "x0": 0.24285714285714285, "y0": 0.6355866355866356, "x1": 0.5637362637362637, "y1": 0.6487956487956488}, {"text": "~ Plath, Sylvia, \u2018A Comparison\u2019", "x0": 0.24285714285714285, "y0": 0.6526806526806527, "x1": 0.4989010989010989, "y1": 0.6658896658896659}, {"text": "~ Vowell, Sarah, \u2018What He Said There\u2019", "x0": 0.24285714285714285, "y0": 0.668997668997669, "x1": 0.5604395604395604, "y1": 0.6806526806526807}, {"text": "* Speeches ~ Burney, Linda, \u2018First speech to the House of Representatives as Member for", "x0": 0.06153846153846154, "y0": 0.7031857031857032, "x1": 0.9, "y1": 0.7163947163947164}, {"text": "Barton\u2019", "x0": 0.26153846153846155, "y0": 0.7202797202797203, "x1": 0.321978021978022, "y1": 0.7303807303807304}, {"text": "\u2014 Jobs, Steve, \u2018How to Live Before You Die\u2019", "x0": 0.24285714285714285, "y0": 0.7365967365967366, "x1": 0.6, "y1": 0.749028749028749}, {"text": "~ Keating, Paul, \u2018Funeral Service of The Unknown Australian Soldier\u2019", "x0": 0.24285714285714285, "y0": 0.7536907536907537, "x1": 0.8252747252747252, "y1": 0.7668997668997669}, {"text": "~ Rowling, JK, \u2018The Fringe Benef