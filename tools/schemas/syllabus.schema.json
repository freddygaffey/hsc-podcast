{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hsc-podcast/syllabus.schema.json",
  "title": "Per-subject pipeline config (content/<subject>/syllabus.json)",
  "type": "object",
  "required": ["subject"],
  "properties": {
    "subject": {"type": "string", "minLength": 1},
    "syllabusName": {"type": "string"},
    "outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "description"],
        "properties": {
          "code": {"type": "string", "minLength": 2},
          "description": {"type": "string", "minLength": 1}
        }
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "anyOf": [
          {"type": "string"},
          {
            "type": "object",
            "required": ["code"],
            "properties": {
              "code": {"type": "string"},
              "module": {"type": "string"},
              "topics": {"type": "array"}
            }
          }
        ]
      }
    },
    "topics": {"type": "array", "items": {"type": "string"}},
    "types": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "style", "questions"],
        "properties": {
          "name": {"type": "string"},
          "style": {"type": "string"},
          "questions": {"type": "string"},
          "marks": {"type": "integer", "minimum": 0}
        }
      }
    },
    "notes": {"type": "string"}
  }
}
