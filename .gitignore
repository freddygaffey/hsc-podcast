# Legacy per-subject repos — kept locally as the audio source and for the migration
# banners, but they are their own git repos and NOT part of the unified one.
hsc-phy-podcast/
hsc-sdd-podcast/

# Dependencies / build / tooling state
node_modules/
.tts-venv/
.wrangler/
dist/
__pycache__/
*.pyc
tools/.upload-state.json

# Audio is served from R2, never committed (durations live in each episode's voices.json)
*.m4a
*.wav

# OS / editor cruft
.DS_Store

# === Textbook sources (copyright) ===
# Raw textbook PDFs and the extracted full-text index are LOCAL ONLY — the whole book must
# never be committed or downloadable from the repo. Only individual cited page images
# (content/*/sources/**) are exposed, and those are served login-gated. See
# content/_template-subject/sources/README.md.
content/*/textbook/**/*.pdf
content/*/textbook/**/*.PDF
content/*/textbook/**/pages.jsonl
content/*/textbook/**/*.txt

# Rendered textbook page images: served per-page by the deploy (from disk) but never committed,
# so the book is not reconstructable from the git repo. Regenerated by tools/ingest_textbook.py.
content/*/sources/**/*.jpg
content/*/sources/**/*.jpeg
content/*/sources/**/*.png
